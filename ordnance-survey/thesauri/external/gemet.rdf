    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12866">
    <skos:prefLabel xml:lang="en">preventive information</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Data communicated or received concerning the recommended means of averting risk of an accident, disaster or other undesirable and avoidable incident.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">information préventive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">información preventiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vorbeugende Information</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">preventieve informatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предупреждающая информация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Переданные или полученные данные, касающиеся рекомендованных средств предотвращения риска аварии, бедствия и иного нежелательного инцидента, наступление которого можно избежать.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معلومات وقائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4676">
    <skos:prefLabel xml:lang="en">land transportation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transport of persons and goods by a network of roads or railways.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überlandtransport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervoer over land</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сухопутный транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перевозка пассажиров и товаров по автомобильным и железным дорогам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل البري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8641" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6941" />
