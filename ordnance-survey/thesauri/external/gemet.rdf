    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1319">
    <skos:prefLabel xml:lang="en">chemical pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollution caused by substances of chemical nature, including chlorinated hydrocarbon pesticides, polychlorinated biphenyls, metals as mercury, lead, cadmium, arsenic, etc.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación química</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verunreinigung durch Chemikalien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemische vervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химическое загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение, причинами которого являются вещества химической природы, включая хлорсодержащие углеводородные пестициды, полихлорированные бифенилы, такие металлы, как ртуть, свинец, кадмий, мышьяк и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث كيميائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11645" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1318" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11676" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1320">
    <skos:prefLabel xml:lang="en">chemical process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The particular method of manufacturing or making a chemical usually involving a number of steps or operations.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">procédé chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesos químicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Chemischer Vorgang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemische processen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специфическая технология производства или изготовления химиката, обычно состоящая из нескольких этапов или операций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية كيميائية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2044" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5983" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7103" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7114" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7839" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1336" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/220">
    <skos:prefLabel xml:lang="en">agricultural product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The output of the cultivation of the soil.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos agrícolas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarprodukt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwproduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственная продукция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Результат культивации почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُنتَج زراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6660" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13167" />
