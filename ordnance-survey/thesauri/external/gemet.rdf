    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3986" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4072" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5080" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5404" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5953" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7715" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10721" />
