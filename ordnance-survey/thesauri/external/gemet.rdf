  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13275">
    <skos:prefLabel xml:lang="en">estate rental</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The service provided by an owner agreeing to grant the temporary possession of specific housing in return for the payment of rent from the tenant.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">location immobilière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arrendamiento immobiliario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Immobilienvermietung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verhuur van onroerend goed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сдача внаем недвижимости</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Услуга, предоставляемая владельцем, который соглашается предоставить конкретное жилье во временное владение арендатору за определенную плату.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تأجير عقار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10898" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4022" />
