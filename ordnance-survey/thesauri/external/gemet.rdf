    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1317">
    <skos:prefLabel xml:lang="en">chemical policy</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">politique en matière de produits chimiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política química</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Chemiepolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemisch beleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика в области химии</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">السياسة الكيميائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4255" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
