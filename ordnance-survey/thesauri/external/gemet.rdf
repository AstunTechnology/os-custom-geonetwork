    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8412">
    <skos:prefLabel xml:lang="en">testing method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode de test</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método de pruebas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Prüfverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">testmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод тестирования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسلوب الاختبار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8405" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1114" />
