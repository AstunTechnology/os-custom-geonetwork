  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3396">
    <skos:prefLabel xml:lang="en">forage contamination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Introduction of hazardous or poisonous substances such as arsenic or lead into, or onto, fodder for animals. The animals consume the contaminated feed and can become sick and may die.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contamination du fourrage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación de forraje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Futtermittelkontamination</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verontreiniging van (ruw)voer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заражение кормов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Занесение вредных, ядовитых веществ, таких как мышьяк или свинец, внутрь или на поверхность корма для животных. Животные, потребляя зараженный корм, могут заболеть и погибнуть.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث العلف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1752" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3365" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8758">
    <skos:prefLabel xml:lang="en">underground storage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Storage located underground designed to hold gasoline or other petroleum products or chemical solutions.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stockage souterrain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">depósito subterráneo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tieflagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ondergrondse opslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подземное хранилище</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Хранилище, расположенное под землей, предназначенное для хранения топлива, других нефтепродуктов или химических веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخزين تحت الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14976" />
