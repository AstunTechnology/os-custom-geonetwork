  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8020">
    <skos:prefLabel xml:lang="en">sprayed asbestos</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Asbestos emitted into the atmosphere in a spraying operation.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">poussière d'amiante</skos:prefLabel>
    <skos:prefLabel xml:lang="es">amianto rociado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Spritzasbest</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spuitasbest</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">распыленный асбест</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Асбест, попадающий в атмосферу в ходе распыления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اسبستوس مرشوش</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/263" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8025">
    <skos:prefLabel xml:lang="en">spring (hydrology, land)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place where ground water flows naturally from a rock or the soil onto the land surface or into a body of surface water.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source</skos:prefLabel>
    <skos:prefLabel xml:lang="es">manantiales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Quelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">родник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где грунтовая вода выходит на поверхность почвы или породы либо впадает в водоем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نبع ماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9161" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8028">
    <skos:prefLabel xml:lang="en">spring water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water obtained from an underground formation from which water flows naturally to the surface, or would flow naturally to the surface if it were not collected underground.
(Source: WQA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de source</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua de manatial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Quellwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bronwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вода из родника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, полученная из грунтового образования, из которого вода свободно выходит на поверхность либо могла выходить на поверхность в случае, если бы не собиралась под землей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء النبع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8029">
    <skos:prefLabel xml:lang="en">spurting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Supplying water or pesticides to crops with a spray.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arrosage par aspersion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">rociadura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Spritzen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spuiten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">распыление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нанесение воды или пестицидов на культурные растения в виде мелких брызг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الرش</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8031">
    <skos:prefLabel xml:lang="en">square</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An open area in a town, sometimes including the surrounding buildings.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">carré</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plazas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Quadrat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">площадь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Открытое пространство в городе, часто включающее окружающие дома и строения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مربع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8847" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8032">
    <skos:prefLabel xml:lang="en">squatter settlement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Settlement on land or property to which there is no legal title.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">occupation sauvage de logement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">asentamiento de 'squatters'</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Barackensiedlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onwettelijke vestiging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">скваттерное поселение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поселение на земле, не имеющей юридического статуса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استيطان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4062" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2704">
    <skos:prefLabel xml:lang="en">groundwater endangering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Threat to the quality and quantity of groundwater by activities related to the use of land. As some activities (e.g. landfill) present a particular risk of pollution, the closer an activity is to a well or borehole, the greater the risk of the pumped water being polluted. The type of soil, the geology, the rainfall and the amount of water pumped out of the ground must all be taken into consideration.
(Source: PORTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">risque pour les eaux souterraines</skos:prefLabel>
    <skos:prefLabel xml:lang="es">riesgo para aguas subterráneas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grundwassergefährdung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het in gevaar brengen van het grondwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">угроза состоянию подземных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Угроза качеству и количеству подземной воды, вызванная землепользованием. Поскольку некоторые виды такой деятельности, такие как рытье мусорных ям, несут особенный риск окружающей среде, близость подобных объектов к колодцу или скважине напрямую повышает риск загрязнения извлекаемой воды. Необходимо также учитывать тип почвы, геологические условия, количество выпавших осадков и количество извлекаемой воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تهديد المياه الجوفية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9166" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8036">
    <skos:prefLabel xml:lang="en">stabilisation lagoon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Ponds in which wastes are allowed to decompose over long periods of time and aeration is provided only by wind action. Sunlight is allowed to fall on sewage to purify it.
(Source: PARCOR /  PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étang de stabilisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lagunas de estabilización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stabilisierungsbecken</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bezinkingsvijver</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">хранилище жидких отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пруды, в которых отходы разлагаются в течение длительного времени, а аэрация осуществляется только под действием ветра. Под действием солнечных лучей сточные воды очищаются.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بحيرة استقرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6841" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8037">
    <skos:prefLabel xml:lang="en">stable</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A building or structure usually with stalls that is used to house and feed horses, cattle or other animals.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stabilitaet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">конюшня</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Здание или сооружение, оборудованное стойлами, предназначенное для содержания и кормления лошадей, крупного рогатого скота и других животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستقر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/186" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12476" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8039">
    <skos:prefLabel xml:lang="en">stack</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The portion of a chimney rising above the roof.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cheminées, conduites et gaines d'évacuation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">chimeneas y conductos de humo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rauchabzugsrohr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">buis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дымовая труба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть трубы, возвышающаяся над крышей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قمة المدخنة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10898">
    <skos:prefLabel xml:lang="en">lodging</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Provision of accommodation for rest or for residence in a room or rooms or in a dwelling place.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hébergement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alojamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Quartier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderdak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">услуги по проживанию</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предоставление услуг по проживанию в одной или нескольких комнатах, а также в отдельных домах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إيواء - توفير الإقامة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13275" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14082" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8047">
    <skos:prefLabel xml:lang="en">standard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Something considered by an authority or by general consent as a basis of comparison.
2) An object regarded as the most common size or form of its kind.
3) A rule or principle that is used as a basis for judgment.
4) An average or normal quality, quantity, or level.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">norme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">norma</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Standard</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">norm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандарт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Что-либо принятое органом власти или по общему согласию в качестве базы для сравнения. 2) Предмет, считающийся самым распространенным по своему размеру или форме среди своих аналогов. 3) Правило или принцип, используемые в качестве основы оценки. 4) Среднее или нормальное качество, количество или уровень.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معيار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11433" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2677" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6143" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6676" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7367" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8326" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11429" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11430" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11431" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8048">
    <skos:prefLabel xml:lang="en">standardisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of conforming to a rule.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">normalisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normalización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Standardisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">standaardisering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандартизация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс соответствия правилу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وضع المعايير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11433" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4442" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8051">
    <skos:prefLabel xml:lang="en">standard for building industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A norm or measure applicable in legal cases for any enterprise involved in the construction, remodeling or finishing of enclosed structures for habitation.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">normes et règles de l'industrie du bâtiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normas y códigos de la industria de la construcción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Baunorm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bouwnorm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандарты и нормы строительной промышленности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Норма или мера, применимые в судебных разбирательствах для предприятий, занятых в строительстве, модернизации или отделке закрытых помещений для проживания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معايير صناعة البناء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7367" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8056">
    <skos:prefLabel xml:lang="en">staple food</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The most commonly or regularly eaten food in a country or community and which forms the mainstay of the total calorie supply, especially in the poorer populations and at times of food shortage.
(Source: GUNN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aliments de base</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alimentos básicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hauptnahrungsmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">basisvoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">основные продукты питания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наиболее распространенные или регулярно употребляемые продукты питания в стране или обществе, обеспечивающие основным объемом калорий - в основном представителей беднейших слоев населения или в периоды нехватки продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الغذاء الرئيسي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5765" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3380" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3354" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8057">
    <skos:prefLabel xml:lang="en">starch</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A polysaccharide which is a combination of many monosaccharide molecules, made during photosynthesis and stored as starch grains in many plants.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">amidon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">almidón</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stärke (Kohlenhydrat)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zetmeel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">крахмал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Полисахарид, обычно представляющий собой комбинацию  моносахаридных молекул, полученный в результате фотосинтеза и отложенный в виде крахмальных зерен в тканях растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النشاء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1159" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8062">
    <skos:prefLabel xml:lang="en">state</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A people permanently occupying a fixed territory bound together by common law, habits and custom into one body politic exercising, through the medium of an organized government, independent sovereignty and control over all persons and things within its boundaries, unless or until authority is ceded to a federation or union of other states.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">état</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Staat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">staat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">государство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политическая организация общества, постоянно проживающего на конкретной территории, связанного воедино общим правом и обычаями, реализующая посредством организованного правительства независимый суверенитет и контроль над всеми людьми и объектами в ее границах, то того момента, когда власть будет передана федерации или союзу других государств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حالة - وضع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13292" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1837" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5431" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6760" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7059" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5440">
    <skos:prefLabel xml:lang="en">municipal water management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Municipal water management deals with aspects of water supply and water technology concerning planning, processing, building and producing. It also concerns the problems of waste water collection, sewage disposal, waste water treatment in rural areas, water economising measures, water body quality management.
(Source: TUBERL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion des eaux urbaines</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión del agua municipal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Siedlungswasserwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeentelijk waterbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городская система управления водоснабжением</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Городская система управления водоснабжением обеспечивает все аспекты подачи воды и применения технологий водоочистки, касающиеся планирования, строительства, производства. Также учитывает вопросы сбора сточных вод, утилизации канализационных стоков, обработки сточных вод в сельских районах, принимает меры по экономии воды и поддержанию качества воды в ее источнике.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإدارة البلدية للمياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9195" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9176">
    <skos:prefLabel xml:lang="en">water for agricultural use</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water used in agriculture for irrigation and livestock. Livestock watering is only 1 percent of the total water withdrawal for agricultural use. Of all functional water uses, irrigation is the largest agricultural use of water.
(Source: CORBIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau à usage agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua para uso agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Brauchwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вода для использования в сельском хозяйстве</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, используемая в сельском хозяйстве для нужд ирригации и животноводства. На нужды животноводства расходуется порядка 1% общего забора воды для сельскохозяйственных нужд. Самым большим потребителем воды в сельском хозяйстве является ирригация.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه للاستخدام الزراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4509" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8067">
    <skos:prefLabel xml:lang="en">state of the art</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Everything made available to the public by means of a written or oral description, by use or in any other way before the date of the patent application, or an application filed in a foreign country the priority of which is validly claimed.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">état de l'art</skos:prefLabel>
    <skos:prefLabel xml:lang="es">última tecnología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stand der Technik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">allernieuwst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внедрения (патент.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Все, что становится достоянием общества посредством письменного или устного описания, применения либо каким-либо другим образом до подачи заявки на патент; заявка на патент за рубежом, приоритет которого справедливо отстаивается.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أرقى مستوى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2775" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8068">
    <skos:prefLabel xml:lang="en">data on the state of the environment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">données sur l'état de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">datos sobre el estado del medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltzustandsdaten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevens over de toestand van het milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">данные о состоянии окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيانات حول حالة البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8069">
    <skos:prefLabel xml:lang="en">report on the state of the environment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A written account on the level of integrity and conditions of the ecosystem and natural resources in a given region, usually presented by an official person or body mandated to protect human health and the environment in that region.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rapport sur l'état de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">informe sobre el estado del medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltzustandsbericht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieurapport</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отчет о состоянии окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Письменный отчет об уровне целостности и условиях экосистемы и природных ресурсов в конкретном районе, обычно представленный официальным лицом или органом, уполномоченными охранять здоровье людей и окружающую среду в этом регионе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقرير حول حالة البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2917" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8070">
    <skos:prefLabel xml:lang="en">state of waste</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">état de déchet</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estado de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbeschaffenheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toestand waarin afval verkeert</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">состояние отходов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">حالة النفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8072">
    <skos:prefLabel xml:lang="en">state of matter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of the three fundamental conditions of matter: the solid, the liquid, and gaseous states.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">état de la matière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estado de la cuestión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aggregatzustand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toestand waarin stof verkeert</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">состояние вещества</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одно из трех основных состояний материи: твердое, жидкое или газообразное.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حالة المادة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/157" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1568" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3577" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4844" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7919" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8073">
    <skos:prefLabel xml:lang="en">station</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place along a route or line at which a bus, train, etc. stops for fuel or to pick up or let off passengers or goods, especially with ancillary buildings and services.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gare</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bahnhof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">station</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">станция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место вдоль маршрута следования автобуса, поезда и пр., где происходит остановка для дозаправки, входа и выхода пассажиров, особенно вместе со вспомогательными зданиями и сооружениями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11269" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11270" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8074">
    <skos:prefLabel xml:lang="en">statistical analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The body of techniques used in statistical inference concerning a population.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse statistique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis estadístico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Analyse (statistisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">statistische analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистический анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплекс приемов, используемый при статистическом учете населения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل إحصائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8076" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8075">
    <skos:prefLabel xml:lang="en">statistical data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">données statistiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">datos estadísticos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Statistische Daten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">statistische gegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистические данные</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيانات إحصائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6107" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10892" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10893" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11127" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8076" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8076">
    <skos:prefLabel xml:lang="en">statistics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of mathematics dealing with the collection, analysis, interpretation, and presentation of masses of numerical data.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">statistiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estadísticas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Statistik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">statistiek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Раздел математики, в рамках которого проходит сбор, анализ, интерпретация и предоставление массивов цифровой информации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الإحصاء</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2926" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4259" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7079" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8077" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9241" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1975" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8074" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8075" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8077">
    <skos:prefLabel xml:lang="en">waste statistics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Determination of the quantity and character of the wastes discarded by a community, by spot sampling procedure.
(Source: CORBIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">statistiques portant sur les déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estadísticas de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallstatistik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalstatistieken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистический учет отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Определение количества и типа отходов общества в результате отбора проб.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إحصائيات النفايات  (المخلفات)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8076" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9141" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8078">
    <skos:prefLabel xml:lang="en">status of development</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The extent to which a society promotes human well-being in all dimensions of existence by forming people's capabilities, expanding choices and increasing opportunities.
(Source: POP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau de développement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estado de desarrollo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entwicklungsstand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontwikkelingsgraad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень экономического развития</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Степень, до которой общество содействует благополучию во всех проявлениях человеческого существования, формируя способности людей, расширяя и повышая возможности для выбора.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وضع (مستوى) التنمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7832" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2147" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2152" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3815">
    <skos:prefLabel xml:lang="en">half-life</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The time required for one-half the atoms of a given amount of radioactive material to undergo radioactive decay.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">demi-vie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">media de vida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Halbwertszeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">halveringstijd</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">период полураспада</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Время, требуемое для того, чтобы половина числа атомов конкретного количества радиоактивного материала распалась в процессе ядерного разложения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نصف حياة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10904">
    <skos:prefLabel xml:lang="en">public</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The community or people in general or a part or section of the community grouped because of a common interest or activity.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">public</skos:prefLabel>
    <skos:prefLabel xml:lang="es">público</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öffentlichkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">openbaar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общественность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сообщество или люди в целом либо часть общества, выделенные по общему признаку или виду деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8299" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8082">
    <skos:prefLabel xml:lang="en">prescription statutory limitation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">restriction statutaire des prescriptions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">limitación estatutaria de prescripción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verjährung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorgeschreven verjaring(stermijn)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">срок давности</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تقييد قانوني للوصفات الطبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13284" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8083">
    <skos:prefLabel xml:lang="en">statutory public body</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An association, supported in whole or part by public funding, that is established to operate programs for the public, often with little interference from government in day-to-day business.
(Source: BLD / ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">entreprise publique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">órgano público estatutario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Staatsbetrieb</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">publiekrechtelijk bedrijfsorgaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">государственный орган</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ассоциация, частично или полностью поддерживаемая государственными средствами, созданная для реализации программ для общества, часто при минимальном или полном отсутствии государственного участия в ее повседневной деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيئة عامة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13292" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8084">
    <skos:prefLabel xml:lang="en">steady noise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Unceasing prolonged noise, without interruption.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bruit continu</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruido continuo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gleichmäßiger Lärm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aanhoudend geluid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">устойчивый звук</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Длительный звук без перерывов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضوضاء مستمرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5658" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8086">
    <skos:prefLabel xml:lang="en">steam generator</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pressurized system in which water is vaporized to steam by heat transferred from a source of higher temperature, usually the products of combustion from burning fuels. Also known as steam boiler.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">générateur de vapeur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">generador de vapor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dampferzeuger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stoomgenerator</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">паровой котел</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система под давлением, в которой вода переходит в пар под действием тепла, передаваемого от источника высокой температуры, получаемой обычно в результате сгорания топлива.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مولج بخار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13225" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2713">
    <skos:prefLabel xml:lang="en">energy balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The energetic state of a system at any given time.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bilan énergetique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">balance energético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energiebilanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiebalans</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергетический баланс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Энергетическое состояние системы в конкретный момент.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ميزان الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2406" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8088">
    <skos:prefLabel xml:lang="en">steel</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various alloys based on iron containing carbon (usually 0.1-0.7 per cent) and often small quantities of other elements such as phosphorus, sulphur, manganese, chromium, and nickel. Steels exhibit a variety of properties, such as strength, machinability, malleability, etc., depending on their composition and the way they have been treated.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stahl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">staal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сталь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные сплавы, основанные на железе, содержащем углерод (обычно 0,1 - 0,7 %), а также небольшие количества других элементов, такие как фосфор, сера, марганец, хром и никель. В зависимости от своего состава и метода обработки стали обладают различными свойствами, например, прочностью, ковкостью, способностью к обработке на станках и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فولاذ - صُلب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/340" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5180" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8089">
    <skos:prefLabel xml:lang="en">steel industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry that deals with the processing of iron.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie de l'acier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria siderúrgica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stahlindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">staalnijverheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство стали</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль промышленности, предприятия которой выплавляют сталь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الصُلب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13098" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2714">
    <skos:prefLabel xml:lang="en">energy conservation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The strategy for reducing energy requirements per unit of industrial output or individual well-being without affecting the progress of socio-economic development or causing disruption in life style. In temperate developed countries most energy is used in heating and lighting industrial and domestic buildings. Industrial processes, transport and agriculture are the other main users. During the 1970s it was demonstrated that substantial savings could be achieved through appropriate building technologies and the use of energy-efficient equipment for heating, air-conditioning and lighting. Most goods could and should be both manufactured and made to work more efficiently.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie d'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conservación de la energía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieeinsparung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiebehoud</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сохранение энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стратегия сокращения энергетических потребностей на единицу промышленного производства или личного благосостояния без ущерба для прогресса в области социально-экономического развития или нарушения жизненного цикла. В умеренно развитых странах значительная доля энергии расходуется на отопление и освещение промышленных и жилых зданий. Крупными потребителями энергии являются также промышленность, транспорт и сельское хозяйство. В течение 70-х годов ХХ века было доказано, что значительное сокращение потребления энергии может быть достигнуто в результате использования специальных энергосберегающих строительных технологий, а также технологий для кондиционирования воздуха, обогрева и освещения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحفاظ على الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2733" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8095">
    <skos:prefLabel xml:lang="en">sterilisation (process)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An act or process of destroying all forms of microbial life on and in an object.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stérilisation (processus)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">esterilización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sterilisation (Prozeß)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">steriliseren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стерилизация (процесс)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс по уничтожению всех форм микробной жизни на поверхности или внутри объекта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعقيم - تجديب (عملية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2238" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8096">
    <skos:prefLabel xml:lang="en">steroid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A compound composed of a series of four carbon rings joined together to form a structural unit called cyclopentanoperhydrophenanthrene.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stéroïde</skos:prefLabel>
    <skos:prefLabel xml:lang="es">esteroide</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steroid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">steroïde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стероид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение последовательности четырех углеродных колец, образующих структурную единицу, называемую циклопентанопергидрофенантрен.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الستيرويد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8098">
    <skos:prefLabel xml:lang="en">incentive fund</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Money or financial resources set aside to stimulate, encourage, or incite action towards greater productivity.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">budget d'encouragement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fondo de incentivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Finanzieller Anreiz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stimuleringsfonds</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фонд экономического стимулирования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деньги или финансовые ресурсы, приготовленные для того, чтобы стимулировать, поддерживать или поощрять действия, направленные на повышение производительности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صندوق حوافز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11044" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8099">
    <skos:prefLabel xml:lang="en">stock (biological)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of individuals of one species within a specified area.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">peuplement (biologique)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">existencias (biológicas)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bestockung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stam</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">племя (биол.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа особей одного вида в рамках одного ареала распространения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قطيع (أحياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3444" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8100">
    <skos:prefLabel xml:lang="en">stock management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The handling or controlling of accumulated materials or stored goods.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion des stocks</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de existencias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Materialwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beheer van aandelenkapitaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление запасами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обращение или контроль за накопленными материалами или складированными товарами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة المخزون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13159" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8102">
    <skos:prefLabel xml:lang="en">stocktaking</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The counting over of materials or goods on hand, as in a stockroom or store.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">inventaire (du stock)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inventario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bestandsaufnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inventarisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инвентаризация запасов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пересчет материалов, товаров, имеющихся в наличии, например, в магазине или на складе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجَرد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8563" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13182" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8104">
    <skos:prefLabel xml:lang="en">stone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A general term for rock that is used in construction, either crushed for use as aggregate or cut into shaped blocks as dimension stone.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pierre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">piedra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gestein</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">steen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">камень</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общий термин для камней, используемых в строительстве либо в качестве наполнителя в раздробленном виде, либо в качестве строительного материла в виде блоков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حجر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5529" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7298" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2900">
    <skos:prefLabel xml:lang="en">environmental protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures and controls to prevent damage and degradation of the environment, including the sustainability of its living resources.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieubescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры и средства контроля, направленные на предотвращение ущерба и разрушения окружающей среды, включая устойчивость ее живых ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية البيئة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1221" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1466" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2790" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2905" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5544" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9206" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10032" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8110">
    <skos:prefLabel xml:lang="en">storage dam</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A barrier of concrete, earth, etc., built across a river to create a body of water.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">barrage de retenue</skos:prefLabel>
    <skos:prefLabel xml:lang="es">represa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Staudamm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stuwdam</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дамба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бетонное, земляное и пр. заграждения, сооруженные поперек реки для образования запруды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سد تخزين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1955" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5180">
    <skos:prefLabel xml:lang="en">metal product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit métallique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto metálico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Metallwaren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">metaalproduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">металлический продукт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتج معدني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8088" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8115">
    <skos:prefLabel xml:lang="en">storm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An atmospheric disturbance involving perturbations of the prevailing pressure and wind fields on scales ranging from tornadoes to extratropical cyclones; also the associated weather and the like.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tempête</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tormentas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sturm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">storm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гроза</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Атмосферное нарушение, характеризуемое резким изменением преобладающего давления и силой ветра в диапазоне от торнадо до экстратропических циклонов; также включает связанные погодные условия и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عاصفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5196" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8117">
    <skos:prefLabel xml:lang="en">storm damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Storms may cause flooding and damage to crops; uproot trees; damage roofs and chimneys; break windows, leading to rain damage; overturn trucks; affect transportation, communication and energy supplies; delay building construction and destroy traditional landmarks. In their more violent form, storms may cause severe damage and loss of life.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dégât des tempêtes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">daño por tormenta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sturmschaden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stormschade</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ущерб, нанесенный грозой, штормом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Шторм может нанести ущерб в виде наводнения или потери урожая, выкорчевать деревья, разрушить крыши и трубы, разбить окна, перевернуть автомобили, нарушить транспортное движение, системы связи и электроснабжения, нарушить ход строительства и уничтожить исторические места. В более сильной форме грозы и шторма могут нанести еще больший ущерб и привести к человеческим жертвам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأضرار الناجمة عن عاصفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2802" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5193" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4084">
    <skos:prefLabel xml:lang="en">hydraulic engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of civil engineering concerned with the design, erection, and construction of sewage disposal plants, waterworks, dams, water-operated power plants and such.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">génie hydraulique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería hidráulica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">строительство гидросооружений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль гражданского строительства, в рамках которой осуществляется проектирование, монтаж и строительство очистных сооружений, водоочистительных станций, дамб, гидроэлектростанций и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هندسة السوائل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12586" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/517" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1955" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4082" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8110" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12231" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8122">
    <skos:prefLabel xml:lang="en">stove</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chamber within which a fuel-air mixture is burned to provide heat, the heat itself being radiated outward from the chamber; used for space heating, process-fluid heating, and steel blast furnaces.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étuve</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estufa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ofen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kachel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">печь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Камера, в которой воздушно-топливная смесь сгорает с выделением тепла, которое излучается из камеры. Существуют печи бытового назначения (обогрев помещений, нагревание воздуха) и для обработки материалов при помощи нагревания (доменная, мартеновская печи и пр.).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موقد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13225" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8125">
    <skos:prefLabel xml:lang="en">stratification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The arrangement of a body of water, as a lake, into two or more horizontal layers of different characteristics, especially densities.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stratification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estratificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gelaagdheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стратификация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Распределение слоев воды в водоеме, например, озере, на двух и более уровнях с различными характеристиками, например, плотностью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترتيب الطبقات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4085">
    <skos:prefLabel xml:lang="en">hydraulics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of science and technology concerned with the mechanics of fluids, especially liquids.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydraulique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidráulica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydraulik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydraulica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидравлика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль науки и техники, изучающая механику жидких сред, особенно жидкостей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ميكانيكا الموائع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6230" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8128">
    <skos:prefLabel xml:lang="en">stratosphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The layer of the atmosphere which is sandwiched between the troposphere and mesosphere. Of the energy that reaches the Earth from the sun, only 3% is absorbed in the stratosphere, but that includes the vitally important process of absorption of ultraviolet radiation by the stratospheric ozone layer. The stratosphere is cloudless and dust free, and almost unaffected by the turbulent conditions of the underlying level of the atmosphere.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stratosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estratosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stratosphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stratosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стратосфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Слой атмосферы, находящийся между тропосферой и мезосферой. Из всей солнечной энергии, которая достигает поверхности Земли, только 3% поглощается стратосферой, однако это включает жизненно важное поглощение ультрафиолетовых лучей стратосферным слоем озона. В стратосфере отсутствуют облака и пыль, на нее практически не оказывают влияния турбуленции, происходящие в нижних слоях атмосферы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الطبقة العليا من الغلاف الجوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8129">
    <skos:prefLabel xml:lang="en">stratospheric ozone depletion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Damage of the ozone shield by chemicals released on Earth. The main chemicals that are depleting stratospheric ozone are chlorofluorocarbons (CFCs), which are used in refrigerators, aerosols, and as cleaners in many industries, and halons which are used in fire extinguishers. The damage is caused when these chemicals release highly reactive forms of chlorine and bromine.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">appauvrissement de l'ozone stratosphérique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agotamiento de ozono estratosférico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stratosphärischer Ozonabbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afbraak van stratosferische ozon</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разрушение стратосферного озона</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разрушение озонового слоя химическими веществами, производимыми на Земле. Основные химикаты, разрушающие озоновый слой, являются хлорфторуглероды (CFC), используемые в холодильниках, в составе аэрозолей, чистящих веществ во многих отраслях промышленности, а также галоны, входящие в состав огнетушительных смесей. Разрушение озона происходит в результате образования на базе этих веществ высокореактивных форм хлора и фтора.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تآكل الأوزون في طبقات الجو العليا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5994" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5993" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8133">
    <skos:prefLabel xml:lang="en">stream measurement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The quantitative determination of the rate and amount of flow or discharge from a natural body of running water, such as a small river or brook.
(Source: DOE / WWD / WRT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure du courant (dans un cours d'eau)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medición de flujo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strömungsmessung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">meting van de stroming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">измерение потока</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количественное определение скорости и объема потока или стока естественного движения воды по руслу, например, реки или ручья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قياس التيار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9196" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4908">
    <skos:prefLabel xml:lang="en">long-term experiment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Experiment lasting for a relatively long period of time.
2) Experiment whose results become effective after a long period of time.
(Source: SHOOXa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">expérience sur le long terme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">experimento a largo plazo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Langzeitversuch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">langetermijnexperiment</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">долгосрочный эксперимент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Эксперимент, продолжающийся относительно долгий срок. 2) Эксперимент, чьи результаты станут известны лишь спустя длительное время.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجربة طويلة الأجل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4571" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8136">
    <skos:prefLabel xml:lang="en">street cleaning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of removing dirt, litter or other unsightly materials from city or town streets.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nettoyage des rues</skos:prefLabel>
    <skos:prefLabel xml:lang="es">limpieza de calle</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strassenreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">straatreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уборка улиц</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс удаления грязи, мусора или других неприглядных материалов с улиц города или поселка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيف الشوارع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5428" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7050" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7283" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6660">
    <skos:prefLabel xml:lang="en">product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Something produced by human or mechanical effort or by a natural process.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Produkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">producten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">продукт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Что-либо произведенное человеком в ходе механического или природного процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتَج</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/220" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3505" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5305" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5756" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8140">
    <skos:prefLabel xml:lang="en">strength of materials</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">résistance des matériaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">resistencia de materiales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Festigkeitslehre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">materiaalsterkte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сопротивление материалов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقاومة المواد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6724" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10914">
    <skos:prefLabel xml:lang="en">touristic unit</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">unité touristique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">unidad turística</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Touristeneinheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toeristische eenheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">туристический объект</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وحدة سياحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8143">
    <skos:prefLabel xml:lang="en">strip mining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Superficial mining, in which the valuable rock is exposed by removal of overburden. Coal, numerous nonmetals and metalliferous ores (iron and copper) are worked in this way. Sinonym: strip mining, opencast mining, openpit mining.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploitation minière par couches à ciel ouvert</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación a cielo abierto por excavadoras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tagebau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dagbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вскрышные горные работы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разработка месторождения полезного ископаемого в результате удаления верхнего слоя покрывающей породы. Уголь, различные неметаллические и металлсодержащие руды (железо и медь) добываются такими методами. Синонимы: открытая добыча, добыча в разрезе, добыча в карьере.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعدين السطحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8144">
    <skos:prefLabel xml:lang="en">strontium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A soft silvery-white element of the alkaline earth group of metals, occurring chiefly as celestite and as strontianite. Its compounds burn with a crimson flame and are used in fire works.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">strontium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estroncio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strontium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">strontium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стронций</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мягкий серебристо-белый элемент алкалиновой земельной группы металлов, встречающийся чаще всего в составе целестина и стронцианита. Его соединения горят, образуя алое пламя, и используются в пиротехнических составах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السترونتيوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2637" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4088">
    <skos:prefLabel xml:lang="en">hydrobiology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study of organisms living in water.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrobiología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидробиология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение организмов, живущих в воде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الأحياء المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10915">
    <skos:prefLabel xml:lang="en">all-terrain vehicle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A land carriage so constructed that it can be used on any kind of road or rough terrain and can be operated for many purposes, such as carrying goods, transporting the injured, conveying passengers, etc.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">véhicule tout terrain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vehículo todo terreno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geländefahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">terreinwagen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внедорожник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сухопутное средство транспорта, конструкция которого позволяет передвигаться по любому виду поверхности дороги или земли и использовать его для различных целей, например, перевозки тяжелых предметов, перевозки пострадавших людей, обычной транспортировки пассажиров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سيارة لكل الأراضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8148">
    <skos:prefLabel xml:lang="en">structure-activity relationship</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The association between a chemical structure and carcinogenicity.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relation structure activité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relación estructura-actividad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Struktur-Wirkung-Beziehung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">structuur-activiteitsrelatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взаимосвязь "структура-активность"</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимосвязь между химической структурой и канцерогенностью вещества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العلاقة بين البنية والنشاط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1322" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8149">
    <skos:prefLabel xml:lang="en">structure-borne noise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sound that travels over at least part of its path by means of the vibration of a solid structure.
(Source: CONFER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bruit de structure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruido inducido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Körperschall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">contactgeluid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">звуковые колебания в твердой структуре</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Звук, который хотя бы частично распространяется посредством колебаний в твердой структуре.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضوضاء المباني المصمتة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5658" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8151">
    <skos:prefLabel xml:lang="en">structure plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Metropolitan structure and land use plan intended to outline the general lines along which development should proceed in an area.
(Source: ECHO1 /  GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">schéma directeur d'aménagement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan estructural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strukturplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">structuurplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">структурный план</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Городской план структуры и пользования землями, предназначенный обозначить основные направления, в соответствии с которыми должен идти процесс развития района.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة البناء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5727">
    <skos:prefLabel xml:lang="en">nuclear fuel element</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A piece of nuclear fuel which has been formed and coated, and is ready to be placed in a reactor fuel assembly.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élément de combustible nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento combustible nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brennelement</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">splijtstofelement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">элемент ядерного топлива</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть ядерного топлива, которой придали форму, покрыли специальным покрытием и приготовили для загрузки в ядерный реактор.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في الوقود النووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5724" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8158">
    <skos:prefLabel xml:lang="en">submarine morphology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That aspect of geological oceanography which deals with the relief features of the ocean floor and with the forces that modify them.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">morphologie sous-marine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">morfología submarina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterwassermorphologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">morfologie van de zeebodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морфология морского дна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Аспект геологической океанографии, изучающий черты рельефа дна океана и сил, воздействующих на него.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مورفولوجيا أعماق البحار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4629" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/772" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7497" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8159">
    <skos:prefLabel xml:lang="en">submarine</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">sous-marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">submarino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterseeboot</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderzees</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подводная лодка</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">أعماق البحر - ما تحت سطح البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8162">
    <skos:prefLabel xml:lang="en">subsequent order</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">commande ultérieure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">orden subsecuente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nachträgliche Anordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">volgende rangorde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">последующий приказ</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">أمر تالٍ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11494" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8163">
    <skos:prefLabel xml:lang="en">subsidence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) A sinking down of a part of the earth's crust, generally due to underground excavations.
2) The sudden sinking or gradual downward settling of the Earth's surface with little or no horizontal motion. The movement is not restricted in rate, magnitude, or area involved. Subsidence may be caused by natural geologic processes, such as solution, thawing, compaction, slow crustal warping, or withdrawal of fluid lava from beneath a solid crust; or by man's activity, such as subsurface mining or the pumping of oil or ground water.
(Source: MGH /  BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">affaissement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hundimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Absinken (geologisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(grond)verzakking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">проседание почвы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Понижение уровня земной коры, как правило, в результате подземных работ. 2) Резкое или постепенное оседание земной поверхности с небольшими горизонтальными движениями или при отсутствии таковых. Движение не имеет ограничений по скорости, масштабам, охвату площадей. Проседание почвы может быть результатом природных геологических процессов, например, растворения, плавления, уплотнения, медленного разрушения коры, оттока жидкой лавы из-под твердого участка коры, а также результатом деятельности человека, такой как подземные горные разработки, добыча нефти, откачка грунтовых вод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هبوط- انهيار أرضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7231" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7896" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8165">
    <skos:prefLabel xml:lang="en">subsidy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any monetary grant made by the government to a private industrial undertaking or charitable organization, but especially one given to consumers or producers in order to lower the market price of some service or product and make it readily affordable to the public.
(Source: MGHME / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">subvention</skos:prefLabel>
    <skos:prefLabel xml:lang="es">subsidio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Subvention</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">subsidie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">субсидия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выплата денег государством производственным или торговым предприятиям, предназначенная снизить розничные цены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعانة مالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3205" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8167">
    <skos:prefLabel xml:lang="en">subsoil</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Soil underlying surface soil, devoid of plant roots.
(Source: MGH /  ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sous-sol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">subsuelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Untergrund</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ondergrond</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">грунт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лишенная растительных корней земля, расположенная под поверхностным слоем почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحت الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8168">
    <skos:prefLabel xml:lang="en">subsoil drainage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removal of surplus water from within the soil by natural or artificial means, such as by drains placed below the surface to lower the water table below the root zone.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">drainage du sous-sol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">drenaje de subsuelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dränung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwatering van de ondergrond</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">грунтовой дренаж</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление избытка воды из почвы естественными или искусственными средствами, например, дренажными трубами, проложенными под землей для установления уровня воды ниже зоны распространения корней.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصرف تحت الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2319" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8171">
    <skos:prefLabel xml:lang="en">substitutability (chemistry)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The capability of a substance of being replaced by another, for example sweeteners used in place of sugar.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substituabilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustitutabilidad (química)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Substituierbarkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervangbaarheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">способность к замещению (хим.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность вещества замещаться другим, например, использование подсластителей вместо сахара.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قابلية الإبدال (كيمياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1322" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7114" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8173">
    <skos:prefLabel xml:lang="en">substitution of halogenated compounds</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Halogenated compounds, because of their toxical and persistent character, should be substituted by environmental friendly compounds, like water-based fat solvents in metal processing industry or water-based coating agents.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substitution de composés halogénés</skos:prefLabel>
    <skos:prefLabel xml:lang="es">substitución de compuestos halogenados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">HKW-Ersatz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervanging van halogeenverbindingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">замещение галогенизированных соединений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Галогенизированные соединения из-за своей токсичности и стойкости должны замещаться экологически безопасными соединениями, например, водоосновными растворителями жира в сталелитейной промышленности, водоосновными красками и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إبدال المركبات المهلجنة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7114" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8174">
    <skos:prefLabel xml:lang="en">substitution of phosphate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Replacement of phosphate in detergents by environmentally safer substances, such as zeolite. The substitute will not act as a nutrient, and so will not cause eutrophication as a result of the accelerated growth of plants and microorganisms if it is released into waterways.
(Source: WRIGHTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substitution des phosphates</skos:prefLabel>
    <skos:prefLabel xml:lang="es">substitución del fosfato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phosphatersatz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fosfaatvervanging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">замещение фосфата</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Замещение фосфата в составе стиральных порошков экологически безопасным веществом, например, цеолитом. Замещаемое вещество не будет являться питательным веществом и поэтому, попадая в реки и водоемы, не будет вызывать эвтрофикацию воды в результате ускоренного роста растений и микроорганизмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إبدال الفوسفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1336" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6192" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8175">
    <skos:prefLabel xml:lang="en">substrate cultivation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">culture sur substrat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultivo del sustrato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Substratkultur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">substraatteelt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">культивация субстрата</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">زراعة الطبقة السفلية من التربة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1902" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2924">
    <skos:prefLabel xml:lang="en">environmental specimen bank</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Places in which selected specimens (fish, mussels, milk, soil sample and human tissue, etc.) are stored without being allowed to decompose.
(Source: AZENP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">banque d'échantillons de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">banco de especímenes ambientales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltprobenbank</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieumonsterdepot</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">банк образцов природных элементов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где отобранные образцы (рыбы, моллюски, молоко, образцы почвы и человеческих тканей, пр.) хранятся в условиях, не допускающих разложения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بنك العينات البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8179">
    <skos:prefLabel xml:lang="en">subtropical ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interacting system of a biological community and its non-living environmental surroundings in regions bordering on the tropics or the regions between tropical and temperate zones.
(Source: TOE / DOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème subtropical</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema subtropical</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Subtropisches Ökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">subtropisch ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема субтропиков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимодействующая система биологических сообществ и их неживых окружающих условий, расположенных в регионах, находящихся между тропической и умеренной климатической зонами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للمناطق تحت الاستوائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8182">
    <skos:prefLabel xml:lang="en">suburb</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A residential district situated on the outskirts of a city or town.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">banlieue</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suburbios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vorort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">buitenwijk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пригород</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жилой район, расположенный на окраине города или поселка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضاحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8841" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2729">
    <skos:prefLabel xml:lang="en">energy legislation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">législation en matière d'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación sobre energía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energierecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiewetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство в области использования энергии</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تشريع (قانون) الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5713" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8185">
    <skos:prefLabel xml:lang="en">sugar (product)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sweet crystalline or powdered substance, white when pure, consisting of sucrose obtained mainly from sugar cane and sugar beets and used in many foods, drinks, and medicines to improve their taste.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sucre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">azúcar (producto)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zucker</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">suiker</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сахар</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сладкое кристаллическое или порошкообразное вещество, белого цвета в чистом состоянии; состоит из сахарозы, полученной из сахарного тростника или сахарной свеклы; используется для улучшения вкуса в составе многих продуктов питания, напитков, медикаментов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سكر (منتَج)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8255" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12287">
    <skos:prefLabel xml:lang="en">biological wastewater treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Types of wastewater treatment in which biochemical or bacterial action is intensified to oxidize and stabilize the unstable organic matter present. Examples of this type of treatment use intermittent sand filters, trickling filters, and activated sludge processes and sludge digestion.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">épuration biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento biológico de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Abwasserbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische afvalwaterverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая переработка жидких отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тип обработки стоков, в ходе которых используется биохимическое или бактериальное воздействие для окисления и стабилизации имеющихся в наличии нестабилизированных органических материалов. Примером такой обработки является последовательное применение песчаных фильтров, биофильтров и биологической переработки сточного ила.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المعالجة الحيوية للمياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8188">
    <skos:prefLabel xml:lang="en">sugar industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Establishments primarily engaged in processing raw cane sugar, sugar beets or starches to finished sucrose, glucose or fructose. By-products of this industry include beet pulp and inedible molasses.
(Source: PGE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie du sucre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria azucarera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zuckerindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">suikerindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство сахара</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предприятия, занятые переработкой сахарного тростника, сахарной свеклы или крахмалов и производством сахарозы, глюкозы или фруктозы. Попутными продуктами являются свекольный жом и несъедобная черная патока.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة السكر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3368" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2730">
    <skos:prefLabel xml:lang="en">energy management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The administration or handling of power derived from sources such as fossil fuel, electricity and solar radiation.
(Source: RHW / FFD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion de l'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energiewirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiebeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление в области производства энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление энергией, полученной из таких источников, как минеральное топливо, электричество и свет.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2877" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4985" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2718" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2740" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2733" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8190">
    <skos:prefLabel xml:lang="en">sulphate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A salt or ester of sulfuric acid, widely distributed in nature and often found in the atmosphere.
(Source: INP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sulphate</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sulfatos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sulfat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sulfaten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сульфат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соль или сложный эфир серной кислоты, широко распространенный в природе, в том числе в атмосфере.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كبريتات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5461">
    <skos:prefLabel xml:lang="en">mutated micro-organisms release</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The release of mutated micro-organisms creates the risk that they may exhibit some previously unknown pathogenicity, might take over from some naturally occurring bacteria (possibly having other positive functions which thus are lost) or pass on some unwanted trait to such indigenous bacteria. There is also concern that an uncontrolled genetic mutation could produce from such an engineered microorganism, a form with hazardous consequences for the environment.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dissémination de micro-organismes mutés</skos:prefLabel>
    <skos:prefLabel xml:lang="es">liberación transformada de microorganismos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freisetzung von mutierten Mikroorganismen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgifte gemuteerde micro-organismen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброс мутированных микроорганизмов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выброс мутировавших микроорганизмов создает риск возможности провоцирования какого-либо ранее неизвестного патогенного явления, уничтожения бактерий, встречающихся в природной среде (которые, возможно, обладают полезными функциями и которые в этом случае теряются), или передачи нежелательных свойств эндемическим видам бактерий. Также существует опасность того, что на базе этих микроорганизмов в результате неконтролируемой генетической мутации может образоваться форма, способная нанести ущерб окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إطلاق الكائنات العضوية المجهرية المطفرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7097" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12814" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
</rdf:RDF>

