    <dct:title xml:lang="en">Existing Land Use Grid</dct:title>
    <skos:prefLabel xml:lang="en">Existing Land Use Grid</skos:prefLabel>
    <dct:description xml:lang="en">An existing land use grid is a collection of pixels for which information on existing (present or past) land use is provided. The HILUCS system shall be used for classification.</dct:description>
    <skos:definition xml:lang="en">An existing land use grid is a collection of pixels for which information on existing (present or past) land use is provided. The HILUCS system shall be used for classification.</skos:definition>
