    <skos:prefLabel xml:lang="es">carnívoros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierfresser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vleeseters</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">плотоядный</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Животное, которое питается мясом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آكلات اللحوم</skos:prefLabel>
