    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:38 PM CEST</dct:created>
    <dct:title xml:lang="en">Contour Line</dct:title>
    <skos:prefLabel xml:lang="en">Contour Line</skos:prefLabel>
    <dct:description xml:lang="en">Linear spatial object composed of a set of adjoining locations characterized by having the same elevation property value. It describes, together with other contour lines present in the area, the local morphology of the Earth's surface.</dct:description>
    <skos:definition xml:lang="en">Linear spatial object composed of a set of adjoining locations characterized by having the same elevation property value. It describes, together with other contour lines present in the area, the local morphology of the Earth's surface.</skos:definition>
