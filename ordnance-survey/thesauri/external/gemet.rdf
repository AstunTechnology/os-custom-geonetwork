    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13188">
    <skos:prefLabel xml:lang="en">fodder plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plants used to feed livestock.

(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plante fourragère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planta forrajera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Futterpflanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedergewas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фуражная сельскохозяйственная культура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растения, используемые в качестве корма для сельскохозяйственных животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نبات علف</skos:prefLabel>
