    <skos:prefLabel xml:lang="en">flowing water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Moving waters like rivers and streams.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau courante</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua corriente</skos:prefLabel>
