  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4070">
    <skos:prefLabel xml:lang="en">humus</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The more or less decomposed organic matter in the soil. Besides being the source of most of the mineral salts needed by plants, humus improves the texture of the soil and holds water, so reducing the loss of nutrients by leaching.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">humus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">humus</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Humus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">humus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гумус</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Более или менее разложившееся в почве органическое вещество. Кроме того, что это является источником большинства минеральных солей, необходимых растениям, гумус улучшает структуру почвы, задерживает воду, уменьшая потерю питательных веществ в результате их просачивания через почву.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الدبال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7866" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12263">
    <skos:prefLabel xml:lang="en">storm water basin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Basin used to hold water which falls as rain during a storm.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bassin d'orage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cuenca de agua de tormenta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Regenwasserbecken</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spaarbekken voor overtollig regenwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">резервуар для дождевой воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бассейн, используемый для сбора воды, выпадающей во время дождя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستجمع مياه الأعاصير</skos:prefLabel>
