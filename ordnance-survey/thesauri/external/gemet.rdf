  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7680">
    <skos:prefLabel xml:lang="en">shredder</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A size-reduction machine which tears or grinds materials to a smaller and more uniform particle size. Shredding process is also called size reduction, grinding, milling, comminution, pulverisation, hogging, granulating, breaking, chipping, crushing, cutting, rasping.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">broyeur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trituradora</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Shredder</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">strooiapparaat (v. stalmest of tuinafval)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дезинтегратор, дробилка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машина для измельчения материалов в результате разрезания, измельчения и пр. и образования более мелких частиц относительно единой формы. К таким процессам относят также перемалывание, дробление, пульверизацию, грануляцию, крошение, тесание, гранение и строгание.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آلة تقطيع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7681">
    <skos:prefLabel xml:lang="en">refuse shredder</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A machine used to break up refuse material into smaller pieces by tearing and/or impact.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">détritus de déchiquetage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">basura de desfibradora</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Shreddermüll</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afval van strooiapparaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дезинтегратор отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машина, используемая для измельчения отходов в процессе резки или дробления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آلة تقطيع المهملات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7683">
    <skos:prefLabel xml:lang="en">shrub</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A woody perennial plant, smaller than a tree, with several major branches arising from near the base of the main stem.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arbuste</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arbustos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">heester(gewas)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кустарник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Древесное многолетнее растение, меньшее по размерам, чем дерево, с несколькими крупными сучьями, отходящими от основания ствола.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جَنَبة - شجيرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1020" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7684">
    <skos:prefLabel xml:lang="en">shunting yard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area where a car or a train can be shoven or turned off or moved from one track to another.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gare de triage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estación de maniobras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rangierbahnhof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rangeerterrein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сортировочная станция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок, где вагоны или состав могут перегоняться или перемещаться с одной колеи на другую.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ساحة تحويل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11269" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7686">
    <skos:prefLabel xml:lang="en">sick building syndrome</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A set of symptoms, including headaches, fatigue, eye irritation, and dizziness, typically affecting workers in modern airtight office buildings and thought to be caused by indoor pollutants, such as formaldehyde fumes, particulate matter, microorganisms, etc.
(Source: MED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">syndrome de l'immeuble insalubre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">síndrome del edificio enfermo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sick-Building-Syndrom</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ziekteverschijnselen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">синдром вредного помещения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Набор симптомов, включающий головную боль, усталость, раздражение глаз, головокружение, проявляющиеся у лиц, работающих в современных, плохо проветриваемых офисных помещениях, причинами которых могут быть загрязняющие вещества, такие, как формальдегидные смолы, частицы, микроорганизмы и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">متلازمة المبنى غير الصحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4211" />
