  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2294">
    <skos:prefLabel xml:lang="en">domestic fuel oil</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Liquid petroleum product used in domestic heaters.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mazout de chauffage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fueloil para uso doméstico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Heizöl (leicht)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huisbrandolie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бытовое жидкое топливо</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкий нефтепродукт, используемый в бытовых нагревательных приборах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زيت الوقود (المازوت) المنزلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3512" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2298">
    <skos:prefLabel xml:lang="en">domestic noise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Noise caused by domestic facilities and activities.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bruit domestique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruido doméstico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hauslärm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huishoudelijk lawaai</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бытовой шум</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Шум, производимый в результате работы бытовых приборов и бытовой деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضوضاء منزلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2300">
    <skos:prefLabel xml:lang="en">domestic trade</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Trade wholly carried on at home; as distinguished from foreign commerce.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">commerce intérieur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comercio interior</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Binnenhandel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">binnenlandse handel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внутренняя торговля</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Торговля, осуществляемая исключительно внутри страны в отличие от внешней торговли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجارة داخلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8563" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2301">
    <skos:prefLabel xml:lang="en">domestic waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste generated by residential households and comprised of any material no longer wanted or needed.
(Source: EED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ordures ménagères</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuos domésticos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Haushaltsabfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huishoudelijk afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бытовой мусор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы домашнего хозяйства, состоящие из материалов, в которых нет нужды или потребности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات منزلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12377" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2304" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4015" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10495">
    <skos:prefLabel xml:lang="en">shelter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cover or protection, as from weather or danger; place of refuge.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abri</skos:prefLabel>
    <skos:prefLabel xml:lang="es">refugio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterschlupf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schuilplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">укрытие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Защитное средство или убежище, например, от непогоды или опасности; место убежища.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملجأ - سقيفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10496">
    <skos:prefLabel xml:lang="en">nesting area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place where birds gather to lay eggs.

(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aire de nidification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de jerarquización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nistgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nestgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">район гнездования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где собираются птицы для откладывания яиц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة تعشيش (بناء أعشاش)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/544" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2305">
    <skos:prefLabel xml:lang="en">domestic waste water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Wastewater principally derived from households, business buildings, institutions, etc., which may or may not contain surface runoff, groundwater or storm water.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau usée domestique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua de residuos domésticos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Haushaltsabwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huishoudelijk afvalwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бытовые жидкие отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкие стоки, полученные в результате бытовой деятельности, работы офисных зданий, учреждений и пр., которые могут содержать или не содержать поверхностную, подземную или дождевую воду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه الصرف المنزلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2307">
    <skos:prefLabel xml:lang="en">dosage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of a substance required to produce an effect.
(Source: CONFER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dosage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dosificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dosierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dosering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дозировка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество вещества, необходимое для произведения эффекта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جُرعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2308" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2308">
    <skos:prefLabel xml:lang="en">dose</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of test substance administered. Dose is expressed as weight of test substance (g, mg) per unit weight of test animal (e.g., mg/kg), or as weight of food or drinking water.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dosis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dosis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dosis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доза</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество примененного контрольного вещества. Доза выражается в весе контрольного вещества (в г или мг) на единицу веса опытного животного (например, мг/кг), веса пищевых продуктов или воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كمية - جرعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2307" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2309" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2958" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6888" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2309">
    <skos:prefLabel xml:lang="en">dose-effect relationship</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The relation between the quantity of a given substance and a measurable or observable effect.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relation dose-effet</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relación dosis-efecto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dosis-Wirkung-Beziehung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dosis-effectrelatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взаимоотношение дозы и эффекта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Зависимость между количеством примененного вещества и измеряемым или наблюдаемым эффектом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العلاقة بين الجرعة والتأثير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2308" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2315">
    <skos:prefLabel xml:lang="en">draft legislation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An initial unsigned agreement, treaty, or piece of legislation which is not yet in force.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">projet d'acte législatif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proyecto de legislación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzentwurf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontwerpwetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">проект законодательного документа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Проект неподписанного документа, договора или законодательного акта, который еще не вступил в силу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسودة وثيقة قانونية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2316">
    <skos:prefLabel xml:lang="en">dragonfly</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the insects composing six families of the suborder Anisoptera and having four large, membranous wings and compound eyes that provide keen vision.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">libellule</skos:prefLabel>
    <skos:prefLabel xml:lang="es">libélula</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Libelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">libellen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стрекоза</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель шести семейств, составляющих подотряд Anisoptera, характеризуемые наличием четырех больших мембранных крыльев и сложных глаз, обеспечивающих острое зрение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اليعسوب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5802" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10510">
    <skos:prefLabel xml:lang="en">animal corridor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Line corridors (roads, paths, and hedgerows) which lack interior habitat but may serve as movement groups for organisms. Corridors may also provide an efficient migratory pathway for animals. The presence or absence of breaks in a corridor may be a very important factor in determining the effectiveness of its conduit and barrier functions.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">couloir d'animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pasillo animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierkorridor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dieren(door)gang</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">"коридор" для животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Естественные коридоры (дороги, тропы, кустарники), которые не имеют внутренних ареалов распространения животных, но могут служить для их перемещения. Коридоры могут также обеспечивать миграционные пути для животных. Наличие или отсутствие прерываний в таких коридорах может быть важным фактором в определении его эффективной пропускной или ограждающей способности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ممر للحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2319">
    <skos:prefLabel xml:lang="en">drainage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Removal of groundwater or surface water, or of water from structures, by gravity or pumping.
2) The discharge of water from a soil by percolation (the process by which surface water moves downwards through cracks, joints and pores in soil and rocks).
(Source: MGH /  WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">drainage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">drenaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entwässerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwatering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дренаж</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Удаление подземной или поверхностной воды, а также воды из конструкций посредством откачивания или под действием силы тяжести. 2) Уход воды из почвы вследствие просачивания (процесс, в ходе которого поверхностная вода проникает вниз через щели и поры в почве, камнях).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صرف صحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7340" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8168" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11231" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1061" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10512">
    <skos:prefLabel xml:lang="en">animal displacement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The habit of many animal species of moving inside their habitats or of travelling, during migrations, to different biotopes, often considerable distances apart; in aquatic environments displacements can occur horizontally or vertically while in terrestrial environments animal populations that breed in the alpine or subalpine zones in summer, move to lower levels in winter; animal displacements usually follow circadian rhythms and are related to the necessity of finding breeding, resting and feeding areas.
(Source: RAMADE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déplacement d'animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desplazamiento de animales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierartenvertreibung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verdringing van dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">перемещение животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Привычка многих видов животных перемещаться внутри своих ареалов или при миграции переходить в другие биотопы, часто расположенные на достаточном удалении друг от друга; в водной среде перемещение может происходить как в вертикальном, так и в горизонтальном направлениях, а на суше популяции животных, выводящих потомство в альпийских и субальпийских зонах в летний период, могут переместиться на более низкий уровень в зимний период. Перемещение животных часто связано с годичным циклом, необходимостью искать места для размножения, питания и отдыха.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نزوح الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8579">
    <skos:prefLabel xml:lang="en">traditional culture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Learned, nonrandom, systematic behavior and knowledge transmitted over several generations, especially customs and beliefs originating before the advent of modern science and technology.
(Source: ANT / OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture traditionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultura tradicional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Traditionelle Kultur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">traditionele cultuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">традиционная культура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Приобретенные, неслучайные, систематизированные поведение и знания, передаваемые через поколения, особенно обычаи и верования, возникшие до прихода современной науки и технологий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثقافة تقليدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10078" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10891" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10964" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14845" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2324">
    <skos:prefLabel xml:lang="en">draught animal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">bête de trait</skos:prefLabel>
    <skos:prefLabel xml:lang="es">animal de tiro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zugtier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">trekdier</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рабочий скот</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">حيوان جر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3122" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6624">
    <skos:prefLabel xml:lang="en">principle of sustainability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Principle stated by the World Commission on Environment and Development (The Bruntland Commission) in 1987: development that meets the needs of the present without compromising the needs of future generations. Sustainable development is a process of integrating economic, social and ecological goals, and should not mean a trade-off between the environment and development. Sustainable development should imply balance rather than conflict.
(Source: GRAHAWa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">principe de durabilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">principio de continuidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nachhaltigkeitsprinzip</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">duurzaamheidsbeginsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">принцип устойчивости</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Принцип, утвержденный Всемирной комиссией по окружающей среде и развитию (Комиссия Брунтланд) в 1987 г.: развитие, которое отвечает требованиям текущего момента без ущерба интересам будущих поколений. Устойчивое развитие предполагает интеграцию экономических, социальных и экологических задач и не означает сделку между экономическими и экологическими интересами. Устойчивое развитие означает баланс, а не конфликт.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مبدأ الاستدامة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8247" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2326">
    <skos:prefLabel xml:lang="en">dredged material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Unconsolidated material removed from rivers, streams, and shallow seas with machines such as the bucket-ladder dredge, dragline dredge, or suction dredge.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériau dragué</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material dragado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Baggergut</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">baggermateriaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">осадок, полученный в результате землечерпательных работ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неконсолидированный материал, удаляемый из рек, ручьев и мелкого моря с помощью таких машин, как ковшовая драга, насосная драга или драглайн.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات تطهير المجاري المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2327">
    <skos:prefLabel xml:lang="en">dredging</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Removing solid matter from the bottom of a water area.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dragage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dragados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Baggerarbeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">baggeren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">землечерпательные работы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление твердого материала со дня водоема.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تطهير المجاري المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11807">
    <skos:prefLabel xml:lang="en">experimental study</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study based on experimentation.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étude expérimentale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estudio experimental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Experimentalstudie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">experimentele studie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспериментальное изучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение, основанное на экспериментах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراسة تجريبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11148" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10521">
    <skos:prefLabel xml:lang="en">spawning ground</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area of water where fish come each year to produce their eggs.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">frayère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tierra de freza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Laichplatz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">paaiplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нерестилище</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок водной среды, куда ежегодно приплывают рыбы для того, чтобы откладывать икру.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة بيض السمك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/501" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2330">
    <skos:prefLabel xml:lang="en">olive oil mill wastewater</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Aqueous residue deriving from the process of oil extraction from olives; it is composed of the olive-combined water and of the water used in the extraction and washing processes. It also contains a certain percentage of mineral compounds and of organic substances that are only partially biodegradable.
(Source: UIB /  FLGISAa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lies d'huile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alpechín (UP:agua residual de almazara)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölrückstände</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oliebezinksel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сточная вода маслобоен, производящих оливковое масло</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкие отходы процесса производства масла из маслин; состоит из смеси масла и воды, используемой для мытья и переработки исходного сырья. Также содержит определенный процент минеральных компонентов и органических веществ, которые разлагаются биологически лишь частично.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المخلفات المائية لمعصرة زيت زيتون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10523">
    <skos:prefLabel xml:lang="en">animal habitat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The locality in which an animal naturally grows or lives. It can be either the geographical area over which it extends, or the particular station in which an animal is found.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">habitat animal</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hábitat animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierhabitat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenhabitat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">природная среда обитания животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Местность, ареал, в которых животное обычно растет и живет. Ареал может распространяться на географический район либо на конкретное место, где животное обитает.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موطن الحيوان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3808" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2332">
    <skos:prefLabel xml:lang="en">drift net fishing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of fishing nets of great length and depth, aptly described as "walls of death" because of the huge numbers of marine mammals, birds, and turtles that became ensnared in them. The Tarawa Declaration of 1989 formulated at the 20th South Pacific Forum, aimed at banning drift netting in the South Pacific. In June 1992 the UN banned drift netting in all the world's oceans.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pêche aux filets dérivants</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pesca de red de deriva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Treibnetzfischerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drijfnetvisserij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дрифтерный лов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование рыболовных сетей очень больших размеров и длины, которые часто называют "стенами смерти" из-за гибели большого количества морских млекопитающих, птиц, черепах, в них попадающих. Таравская Декларация 1989 года, принятая на 20-м Форуме стран южной части Тихого океана, была направлена на запрет на использование дрифтерных сетей во всем южном регионе Тихого океана. В июне 1992 года ООН запретила лов рыбы с помощью дрифтерных сетей  во всех океанах планеты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصيد بالشباك العائمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5035" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2333">
    <skos:prefLabel xml:lang="en">drilling</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of boring holes in the earth for finding water or oil, for geologic surveys, etc.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">forage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">perforación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bohrung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">boren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бурение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сверление отверстий в земле в поисках воды, нефти или для проведения геологоразведочных работ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حفر الآبار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12488" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12677">
    <skos:prefLabel xml:lang="en">prevention of forest fires</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Precautionary actions, measures or installations implemented to avert the possibility of an unexpected conflagration of any large wooded area having a thick growth of trees and plants.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prévention des incendies de forêt</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prevención de fuegos forestales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Waldbrandverhütung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorkoming van bosbranden</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предотвращение лесных пожаров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Профилактические действия, меры и установки, реализованные для предотвращения возможного неожиданного возгорания на обширных площадях, покрытых густыми зарослями деревьев и растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الوقاية من حرائق الغابات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3218" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2336">
    <skos:prefLabel xml:lang="en">drilling installation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The structural base upon which the drill rig and associated equipment is mounted during the drilling operation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">installation de forage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">instalación de perforación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bohranlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">boorinstallatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">буровая установка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Конструкция, на которую монтируются бур и соответствующее оборудование для бурения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاعدة الحفار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3120">
    <skos:prefLabel xml:lang="en">famine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A severe shortage of food, as through crop failure or over population. It may be due to poor harvests following drought, floods, earthquake, war, social conflict, etc.
(Source: CED /  GUNN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">famine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hambre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hungersnot</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hongersnood</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">голод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Резкий дефицит продуктов питания в результате неурожая либо перенаселенности. Потери урожая могут быть результатом засухи, наводнения, землетрясения, войны, социального конфликта и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مجاعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2562" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6551" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2339">
    <skos:prefLabel xml:lang="en">drinking water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water that is agreeable to drink, does not present health hazards and whose quality is normally regulated by legislation.
(Source: GUNN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau potable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua potable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trinkwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drinkwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питьевая вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, пригодная для питья, не представляющая угрозы здоровью и качество которой обычно регулируется законодательным актом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه الشرب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2344" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3354" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3485" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2340">
    <skos:prefLabel xml:lang="en">drinking water protection area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area surrounding a water recovery plant in which certain forms of soil utilization are restricted or prohibited in order to protect the groundwater.
(Source: AZENP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone de captage d'eau potable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de protección de agua potable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trinkwasserschutzgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drinkwaterbeschermingsgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охраняемая территория вокруг источника питьевой воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Территория, окружающая завод по извлечению воды из скважины, на которой определенные виды земельных работ запрещены в целях охраны подземных вод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة حماية مياه الشرب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6747" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10535">
    <skos:prefLabel xml:lang="en">nesting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The building of nests for egg laying and rearing of offspring.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nidification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">jerarquización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nisten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nesten bouwen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гнездование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Строительство гнезд для откладывания яиц и высиживания птенцов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بناء العُش</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/415" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2344">
    <skos:prefLabel xml:lang="en">drinking water treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The Directive on the Quality of Surface Water Intended for Drinking Water defines three categories of water treatment (A1, A2, A3) from simple physical treatment and disinfection to intensive physical and chemical treatment. The treatment to be used depends on the quality of the water abstracted. The Directive uses imperative values for parameters known to have an adverse effect on health and also guide values for those which are less adverse. There is also a directive which complements the "surface water abstraction" Directive by indicating the methods of measurement and the frequency of sampling and analysis required.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement de l'eau potable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesos de potabilización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trinkwasserbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het behandelen van drinkwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обработка питьевой воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Директива по качеству поверхностной воды, предназначенной для питьевых целей, определяет три категории обработки воды (А1, А2 и А3) - от простой физической обработки и дезинфекции до интенсивной физико-химической обработки. Выбираемая категория обработки зависит от качестве исходной воды. В Директиве жестко определены значения параметров, известных своим отрицательным влиянием на здоровье, а также пределы значений для параметров, обладающих менее вредным воздействием на здоровье. Существует также дополнительная директива, регулирующая методы измерения, периодичность отбора проб воды и проведения их анализа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة مياه الشرب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9246" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3328" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2339" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2347">
    <skos:prefLabel xml:lang="en">drought</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A period of abnormally dry weather sufficiently prolonged so that the lack of water causes a serious hydrologic imbalance (such as crop damage, water supply shortage) in the affected area.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sécheresse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sequías</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dürre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">droogte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">засуха</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Период ненормально сухой погоды, достаточно длительный для того, чтобы дефицит воды вызвал серьезный гидрологический дисбаланс в зонах, охваченных этим явлением (проявляющийся, например, в потерях урожая, перебоях в снабжении питьевой водой и пр.).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جفاف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5196" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2105" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2350">
    <skos:prefLabel xml:lang="en">drought control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures taken to prevent, mitigate or eliminate damage caused to the ecosystem, especially crops, by a sustained period of dry weather.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lutte contre la sécheresse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de sequía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dürreschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">droogtebeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">борьба с засухой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, предпринимаемые для предотвращения, снижения или исключения ущерба, наносимого экосистеме, особенно урожаю, продолжительным периодом засушливой погоды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيطرة على الجفاف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2352">
    <skos:prefLabel xml:lang="en">drug abuse</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">toxicomanie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">abuso de fármacos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Drogenmißbrauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">misbruik van geneesmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">злоупотребление наркотиками</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">إساءة استعمال العقاقير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2564" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2354">
    <skos:prefLabel xml:lang="en">drug (medicine)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical substance used internally or externally as a medicine for the prevention, diagnosis, treatment or cure of disease, for the relief of pain or to control or enhance physical or mental well-being.
(Source: RHW, APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">médicament</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medicamentos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arzneimittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geneesmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лекарство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое вещество для наружного или внутреннего применения в качестве медикамента для лечения, излечения или профилактики какой-либо болезни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقار - دواء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/473" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3866" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5138" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7688" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10548">
    <skos:prefLabel xml:lang="en">animal reproduction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various processes, either sexual or asexual, by which an animal produces one or more individuals similar to itself.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">reproduction animale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reproducción animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierfortpflanzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierlijke voortplanting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">репродукция животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные процессы, половые или бесполые, в ходе которых животное воспроизводит себе подобных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التكاثر الحيواني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7120" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1014" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2358">
    <skos:prefLabel xml:lang="en">dry cleaning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To clean fabrics etc. with a solvent other than water.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nettoyage à sec</skos:prefLabel>
    <skos:prefLabel xml:lang="es">limpieza en seco</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Chemischreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemisch reinigen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химическая чистка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Очищение тканей и др. материалов каким-либо растворителем отличным от воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنظيف الجاف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4702" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8585">
    <skos:prefLabel xml:lang="en">traffic control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The organization of a more efficient movement of traffic within a given road network by rearranging the flows, controlling the intersections and regulating the times and places for parking.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contrôle de la circulation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control del tráfico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verkehrslenkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verkeerscontrole</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">регулирование движения дорожного транспорта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организация более эффективного движения транспорта в рамках конкретной сети дорог в результате перенаправления потоков, регулирования перекрестков, определения времени и мест для парковки автомобилей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيطرة على المرور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8586" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2360">
    <skos:prefLabel xml:lang="en">dry farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system of extensive agriculture allowing the production of crops without irrigation in areas of limited rainfall. Dry farming involves conserving soil moisture through mulching, frequent fallowing, maintenance of a fine tilth by cross-ploughing, repeated working of the soil after rainfall and removal of any weeds that would take up some of the moisture.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aridoculture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agricultura de secano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trockenfarmverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dry farming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">агротехнические приемы для засушливых районов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система экстенсивных сельскохозяйственных методов, позволяющая осуществлять выращивание сельскохозяйственных культур без ирригации в регионах с ограниченным количество осадков. Эти методы предусматривают удержание влаги в почве в результате таких приемов, как мульчирование, частое окучивание, поддержание мелкозернистого верхнего слоя земли, повторную обработку земли после дождя и удаление сорняков, которые способны потреблять почвенную влагу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الزراعة الجافة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2361">
    <skos:prefLabel xml:lang="en">drying</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of partially or totally removing water or other liquids from a solid.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">séchage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">secado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trocknung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drogen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сушка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс частичного или полного удаления воды или других жидкостей из твердого тела.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجفيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2363" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12444" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10554">
    <skos:prefLabel xml:lang="en">survival</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or fact of surviving or condition of having survived.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">survie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">supervivencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überleben</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overleving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выживание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или состояние выживания либо факт избежания гибели.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البقاء على قيد الحياة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/767" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1638" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2363">
    <skos:prefLabel xml:lang="en">drying out</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Removal of water from any substance.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dessèchement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desecación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Austrocknung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verdroging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">высыхание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление воды из любого вещества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجفيف - انتزاع المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2361" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2364">
    <skos:prefLabel xml:lang="en">dual economy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An economy based upon two separate/distinct economic systems which co-exist in the same geographical space. Dualism is characteristic of many developing countries in which some parts of a country resemble advanced economies while other parts resemble traditional economies, i.e. there are circuits of production and exchange.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie à deux vitesses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">economía dual</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dualwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tweeledige economie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">многоукладная экономика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экономика, основанная на двух отдельных экономических системах, сосуществующих на одной географической территории. Такое явление характерно для многих развивающихся стран, в которых часть регионов имеет черты промышленно развитой экономики, в то время как в других преобладают черты традиционного, более отсталого хозяйствования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اقتصاد مزدوج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2508" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2365" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8586">
    <skos:prefLabel xml:lang="en">traffic control measure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Means of controlling the number and speed of motorvehicles using a road.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure pour le contrôle de la circulation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medidas para control del tráfico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verkehrsüberwachungsmaßnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verkeersvoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">способ регулирования движения дорожного транспорта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средства контроля за числом и скоростью автомобилей на дорогах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إجراء للسيطرة على المرور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8585" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2367">
    <skos:prefLabel xml:lang="en">dumping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The discarding of waste in any manner, often without regard to environmental control.
(Source: RHW / ERG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge non réglementaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">descarga</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallablagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">storten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сброс мусора</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Утилизация мусора в любой форме, часто без учета экологических требований.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إلقاء المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1426" />
