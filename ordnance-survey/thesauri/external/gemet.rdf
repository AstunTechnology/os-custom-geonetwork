  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6035">
    <skos:prefLabel xml:lang="en">parasite</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Organism which lives and obtains food at the expense of another organism, the host.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parasite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">parásitos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Parasit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">parasiet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">паразит</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организм, который живет и получает питание за счет другого организма, его носителя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طفيل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6038">
    <skos:prefLabel xml:lang="en">parasitology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of biology which deals with those organisms, plant or animal, which have become dependent on other living creatures.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parasitologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">parasitología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Parazitologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">parasitologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">паразитология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль биологии, изучающая организмы растительного или животного происхождения, которые зависят от других живых существ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الطفيليات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7787">
    <skos:prefLabel xml:lang="en">social cost</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The price paid or the loss incurred to acquire, produce or maintain an objective or goal in a group, community or society.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">coût social</skos:prefLabel>
    <skos:prefLabel xml:lang="es">costo social</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Soziale Kosten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sociale kosten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">социальная цена</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Цена или понесенные расходы в связи с достижением, разработкой или поддержанием цели существования социальной группы, объединения или общества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكلفة اجتماعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7781" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9199">
    <skos:prefLabel xml:lang="en">water pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical or physical agent introduced to any body of water that may detrimentally alter the natural condition of that body of water and other associated bodies of water.
(Source: FFD / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserschadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">watervervuiler</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вещество, загрязняющее воду</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое или физическое вещество, которое при попадании в любой водоем может отрицательно изменить природные условия этого водоема и других, с ним связанных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوث للماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14236">
    <skos:prefLabel xml:lang="en">returnable container</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Container whose return from the consumer or final user is assured by specific means (separate collection, deposits, etc.), independently on its final destination, in order to be reused, recovered or subjected to specific waste management operations.
(Source: PORTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">emballage consigné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contenedor retornable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mehrwegpackung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">terugneembare verpakking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оборотный контейнер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Контейнер, возврат которого от потребителя или конечного пользователя обеспечивается специальными средствами (раздельный сбор, депонирование средств и пр.), независимо от его назначения, для многоразового использования или обработке в ходе специальных утилизационных процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حاوية قابلة للاسترداد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1746" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11930">
    <skos:prefLabel xml:lang="en">noise exposure plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A formulated or systematic method to prevent the effects of being subjected to loud or harsh sounds.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'exposition au bruit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan de exposición de ruido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lärmexpositionsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plan met betrekking tot blootstelling aan lawaai</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план мер борьбы с шумом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сформулированный или систематизированный метод предотвращения последствий воздействия громкого или грохочущего шума.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة التعرض للضوضاء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5631" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6046">
    <skos:prefLabel xml:lang="en">car park</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area of ground or a building where there is space for vehicles to be parked.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parc de stationnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aparcamientos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Parkplatz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(auto)parkeerplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">автомобильная стоянка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земли или здание, где предусмотрены места для стоянки автомобилей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ساحة انتظار سيارات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6047" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6047">
    <skos:prefLabel xml:lang="en">parking provision</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area where a vehicle can be left for a period of time. 

(Source: CAMBa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">place de stationnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de aparcamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Parkmöglichkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">parkeervoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предоставление услуг парковки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предоставление места, где автомобиль может быть оставлен на какое-то время.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توفير ساحة انتظار سيارات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6940" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6048">
    <skos:prefLabel xml:lang="en">Parliament</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An assembly of elected representatives, typically controlled by a political party and constituting the legislative and, in some cases, the executive power of a state.
(Source: CIV / APS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Parlement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Parlamento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Parlament</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">parlement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">парламент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Национальный репрезентативный орган, обладающий полномочиями верховного законодательного органа в рамках государства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البرلمان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13292" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4920" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8789" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9151">
    <skos:prefLabel xml:lang="en">water body</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any mass of water having definite hydrological, physical, chemical and biological characteristics and which can be employed for one or several purposes.
(Source: FLGISA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">entité hydrologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cuerpo acuoso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserkörper</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterlichaam</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водоем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Масса воды с определенными гидрологическими, физическими, химическими и биологическими свойствами и которая может быть использована для одной или нескольких целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كيان مائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4124" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/518" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9153" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6051">
    <skos:prefLabel xml:lang="en">participation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of sharing or taking part in a civic, community or public action.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">participation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">participación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Partizipation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">deelname</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">участие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Присоединение к какой-либо городской, общественной и пр. акции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المشاركة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6785" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7807" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6052">
    <skos:prefLabel xml:lang="en">particle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Any very small part of matter, such as a molecule, atom, or electron. 
2) Any relatively small subdivision of matter, ranging in diameter from a few angstroms to a few millimeters.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">particule</skos:prefLabel>
    <skos:prefLabel xml:lang="es">partículas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Partikel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">deeltje</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">частица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Любая очень маленькая частица материи, например, молекула, атом или электрон. 2) Любая относительно небольшая часть материи, диаметр которой находится в пределах от нескольких ангстрем до нескольких миллиметров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جزيء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7919" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11692" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14245">
    <skos:prefLabel xml:lang="en">intermediate product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Product that has undergone a partial processing and is used as raw material in a successive productive step.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit intermédiaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto intermedio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zwischenprodukt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tussenproduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полуфабрикат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продукт, прошедший частичную переработку и используемый в качестве сырьевого материала на следующем этапе производства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتج وسيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6724" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6055">
    <skos:prefLabel xml:lang="en">particle separator</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A device for segregation of solid particles by size range, as a screening.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">séparateur de particules</skos:prefLabel>
    <skos:prefLabel xml:lang="es">separador de partículas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Partikelabscheider</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">deeltjesscheider</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сепаратор частиц</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устройство для отделения твердых частиц в зависимости от их размера.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فاصل الجسيمات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7612" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6059">
    <skos:prefLabel xml:lang="en">passenger transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The conveyance of people over land, water or through air by automobile, bus, train, airplane or some other means of travel.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport de voyageurs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte de pasajeros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Personenverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">personenvervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пассажирский транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перевозка людей по земле, воде или воздуху на автомобилях, автобусах, поездах, самолетах и др. средствах транспорта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقل المسافرين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6061">
    <skos:prefLabel xml:lang="en">pasture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Land covered with grass or herbage and grazed by or suitable for grazing by livestock.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pâturage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pastos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Weide</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(graas)weide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пастбищное угодье</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Покрытая травой земля, на которой пасется скот или которая пригодна для этих целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرعى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7345" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/441" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6062">
    <skos:prefLabel xml:lang="en">paste-like waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste deriving from various activities having a pasty consistency.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet pâteux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo gomoso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pastenartiger Abfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pasta-achtig afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пастообразные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, полученные в ходе различных видов деятельности, имеющие вид пасты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات عجينية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6063">
    <skos:prefLabel xml:lang="en">pathogen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any disease-producing agent or microorganism.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agent pathogène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">patógeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Krankheitserreger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pathogeen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">патоген</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество или микроорганизм, вызывающий болезнь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل ممرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6064">
    <skos:prefLabel xml:lang="en">pathogenic organism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Agents producing or capable of producing disease.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisme pathogène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organismos patógenos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Krankheitserreger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pathogeen organisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">патогенный организм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, вызывающее или способное вызвать болезнь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كائن عضوي ممرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6065">
    <skos:prefLabel xml:lang="en">pathologic effect</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">effet pathologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto patológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pathologische Wirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pathologisch effect</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">патологический эффект</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">أثر مرضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3869" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8376" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/849" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6066">
    <skos:prefLabel xml:lang="en">pathology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of medicine concerned with the causes, origin, and nature of disease, including the changes occurring as a result of disease.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pathologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">patología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pathologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pathologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">патология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль медицины, изучающая причины, происхождение, природу заболевания, включая изменения, происходящие вследствие болезни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الأمراض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4054" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5107">
    <skos:prefLabel xml:lang="en">maximum admissible concentration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The maximum exposure to a physical or chemical agent allowed in an 8-hour work day to prevent disease or injury.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concentration maximale admissible</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concentración admisible máxima</skos:prefLabel>
    <skos:prefLabel xml:lang="de">MAK-Wert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toelaatbare maximumconcentratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">максимально допустимая концентрация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Максимальное разрешенное воздействие физического или химического реагента в течение 8-часового рабочего дня, не приводящее к болезни или ущербу для здоровья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أقصى تركيز مقبول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3869" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3872" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6068">
    <skos:prefLabel xml:lang="en">pattern of urban growth</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The combination of acts, tendencies and other observable characteristics that demonstrates a municipal area's progress or state of development, including its population trends.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">schéma d'urbanisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">modelo de crecimiento urbano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Städtisches Wachstumsschema</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stedelijk groeipatroon</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">модель роста города</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комбинация действий, тенденций и других обозримых характеристик, которые показывают состояние или развитие городского образования, включая тенденции, касающиеся его населения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نمط النمو الحضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8804" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5108">
    <skos:prefLabel xml:lang="en">maximum immission concentration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The maximum concentration of air polluting substances in the free environment whose impact when of specified duration and frequency is not objectionable to man, fauna and flora.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concentration maximale d'immission</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concentración máxima de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">MIK-Wert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toelaatbare maximumimmissie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">максимальная концентрация иммиссии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Максимальная концентрация веществ, загрязняющих воздух, в свободной среде, чье отрицательное воздействие в течение конкретного периода времени или с конкретной периодичностью не вредно для человека, фауны или флоры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التركيز الأقصى للاستقبال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3869" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3872" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/475">
    <skos:prefLabel xml:lang="en">anticipation of danger</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of foreseeing, expecting and taking measures against possible future exposure to harm, death or a thing that causes these.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">anticipation d'un danger</skos:prefLabel>
    <skos:prefLabel xml:lang="es">anticipación del peligro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gefahrenvorsorge</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het voorkomen van gevaar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ожидание опасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прогнозирование, ожидание и осуществление предупредительных мер против возможного ущерба,  смерти или наступления вызывающих их причин.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توقع الخطر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7236" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6081">
    <skos:prefLabel xml:lang="en">peat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Unconsolidated soil material consisting largely of undecomposed or slightly decomposed organic matter accumulated under conditions of excessive moisture.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tourbe</skos:prefLabel>
    <skos:prefLabel xml:lang="es">turba</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Torf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">turf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">торф</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рыхлый почвенный материал, состоящий, в основном, из неразложившихся или частично разложившихся органических материалов, образовавшийся в условиях повышенной влажности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الخُث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3462" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6084">
    <skos:prefLabel xml:lang="en">peat extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Peat is obtained from peat bogs by cutting it from the earth; it is then formed into briquettes, which can be used as fuel. Peat may be found in layers several metres thick. In some countries peat-fired generating stations for electricity are in use. Peat is also used as a soil conditioner.
(Source: PHC /  PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction de tourbe</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción de turba</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Torfabbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">turfwinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча торфа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Торф добывают из торфяных болот, выкапывая его из почвы; затем из торфа делают брикеты, которые можно использовать в качестве топлива. Торф может залегать слоями в несколько метров толщиной. Во многих странах электростанции работают на торфе. Торф также используют для улучшения структуры почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج الخُث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6081" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5110">
    <skos:prefLabel xml:lang="en">meadow</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Strictly a term for a field of permanent grass used for hay, but also applied to rich, waterside grazing areas that are not suitable for arable cultivation.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pré</skos:prefLabel>
    <skos:prefLabel xml:lang="es">praderas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wiese</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">weide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">луг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В строгом понимании, термин применяется к постоянно покрытому травой полю, которое используется для сенокоса, однако может также применяться в отношении богатых, расположенных по берегам водоемов пастбищных участков, которые непригодны для пахотного возделывания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3733" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7397" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9207">
    <skos:prefLabel xml:lang="en">water protection directive</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">directive relative à la protection de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">directiva de protección de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewässerschutzrichtlinie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">richtlijn voor de waterbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">директива ЕС по вопросу охраны водных ресурсов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">توجيه حماية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2212" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6092">
    <skos:prefLabel xml:lang="en">pedestrian zone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area where vehicles are not allowed.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone piétonnière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zonas peatonales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fußgängerzone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voetgangerszone</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пешеходная зона</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Район, где не разрешено движение автомобильного транспорта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة مشاة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8847" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6094">
    <skos:prefLabel xml:lang="en">pedosphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That shell or layer of the Earth in which soil-forming processes occur.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pédosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pedosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pedosphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pedosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">педосфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оболочка Земли, в которой происходят почвообразующие процессы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قشرة التربة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7843" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6102">
    <skos:prefLabel xml:lang="en">penalty for environmental damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Punishment, varying from fines to withdrawal of government funds to economic sanctions, which is imposed for the harm or injury done to natural resources.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sanctions pour atteinte à l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanciones por daños ambientales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strafe für Umweltschäden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">boete voor schade aan het milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">штраф за ущерб, нанесенный окружающей среде</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наказание, варьирующееся от штрафа до прекращения государственного финансирования и экономических санкций, которое накладывается за вред или ущерб, нанесенный природным ресурсам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقوبة للإضرار بالبيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7411" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6103">
    <skos:prefLabel xml:lang="en">penalty</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) A punishment for a crime.
2) A sum specified in a contract as payable on its breach but not constituting a genuine estimate of the likely loss.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pénalité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanciones penales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strafe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dwangmaatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">штраф</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Наказание за преступление. 2) Сумма, оговоренная в контракте, подлежащая к выплате в случае нарушения одного из его условий, однако не соответствующая оценке вероятного ущерба.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقوبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1862" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3207" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6106">
    <skos:prefLabel xml:lang="en">pentachlorophenol</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of the universally toxic phenolic compounds, is a general purpose agent that is used as a fungicide, herbicide and molluscicide, particularly in Egypt where it is used to control snails that carry the larval human blood flukes that cause schistosomiasis. It is also used in wood preservatives and is very poisonous.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pentachlorophénol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pentaclorofenol</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pentachlorphenol</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pentachloorfenol</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пентахлорофенол</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одно из токсичных фенольных соединений, используется в составе фунгицидов, пестицидов; в Египте широко используется как средство для борьбы со слизнями и улитками, переносящими личинки паразитов, вызывающих шистосомоз. Используется также для обработки древесины. Очень ядовито.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خماسي الكلوروفينول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1389" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6107">
    <skos:prefLabel xml:lang="en">per capita data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">données par individu</skos:prefLabel>
    <skos:prefLabel xml:lang="es">datos per cápita</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pro-Kopf-Daten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevens per hoofd (van de bevolking)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистические данные на душу населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيانات عن كل فرد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8075" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6109">
    <skos:prefLabel xml:lang="en">perchloroethylene</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Stable, colorless liquid, nonflammable and nonexplosive, with low toxicity; used as a dry-cleaning and industrial solvent, in pharmaceuticals and medicines, and for metal cleaning.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">perchloroéthylène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">percloroetileno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Perchlorethylen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">perchooretheen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">перхлорэтилен</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стабильная, бесцветная жидкость, негорюча, невзрывоопасна, низкой токсичности; используется как средство сухой чистки, в качестве промышленного растворителя, в фармацевтике и медицине, а также для очистки металлов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيركلوروإيثلين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1378" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6111">
    <skos:prefLabel xml:lang="en">percolating water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Subsurface water that passes, under the force of gravity, through rocks or soil along the line of least resistance.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau d'infiltration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua de percolación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sickerwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">percolatiewater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фильтруемая вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подповерхностная вода, которая под действием силы тяжести, проникает через камни и почву по линии наименьшего сопротивления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء الترشيح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6115">
    <skos:prefLabel xml:lang="en">periphyton</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A plant or animal organism which is attached or clings to surfaces of leaves or stems of rooted plants above the bottom stratum.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">périphyton</skos:prefLabel>
    <skos:prefLabel xml:lang="es">periphyton</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aufwuchs</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">periphyton</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">перифитон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растительный или животный организм, который прикрепляется к поверхности листьев или стеблей корневых растений, располагающихся выше нижнего уровня экосистемы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الملتصقات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6138" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6118">
    <skos:prefLabel xml:lang="en">permafrost ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interacting system of the biological communities and their nonliving environmental surroundings in a climatic region where the subsoil is perennially frozen.
(Source: TOE / DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème du pergélisol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema de gelisuelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Permafrost-Ökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">permanente ijslaag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема вечной мерзлоты</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимодействующая система биологических сообществ и неживых их окружающих условий в климатическом регионе, в котором грунт заморожен в течение всего года.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للمتجمدات السرمدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1559" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6120">
    <skos:prefLabel xml:lang="en">permeability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability of a membrane or other material to permit a substance to pass through it.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">perméabilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">permeabilidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Permeabilität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">doorlatendheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водопроницаемость</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность мембраны или другого материала пропускать вещества через себя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النفاذية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5116">
    <skos:prefLabel xml:lang="en">transportation mean</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Vehicles used for transferring people or goods from one place to another.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">moyen de transport</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medios de transporte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verkehrsmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervoersmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортное средство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Автомобили, используемые для перевозки людей, грузов на расстояния.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وسيلة نقل</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6123">
    <skos:prefLabel xml:lang="en">permissible exposure limit</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An exposure limit that is set for exposure to an hazardous substance or harmful agent and enforced by OSHA (Occupational Safety and Health Act) as a legal standard. It is based on time-weighted average concentrations for a normal 8-hour work day and 40 hour work week.
(Source: CONFER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">limite acceptable d'exposition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">límite permitido de exposición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">BAT-Wert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toegestane blootstellingsgrens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">допустимый уровень воздействия (ПДК)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Уровень воздействия, установленный в отношении опасных или вредных веществ и принятый Законом о здоровье и профессиональных заболеваниях в качестве стандарта. Основан на средних концентрациях вещества для нормального 8-часового рабочего дня и 40-часовой рабочей недели.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حد التعرض المسموح به</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3067" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3869" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6124">
    <skos:prefLabel xml:lang="en">permission</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The license, formal consent or authorization to act on some matter, frequently validating the action as lawful or procedurally correct.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">autorisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">permiso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erlaubnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergunning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разрешение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лицензия, формальное разрешение, авторизация какого-либо действия, часто придающие действию законный или правильный процедурный характер.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إذن - تصريح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2242" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2866" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3064" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4169" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6292" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8564" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11502" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11504" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11506" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11521" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6128">
    <skos:prefLabel xml:lang="en">peroxyacetylnitrate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pollutant created by the action of sunlight on hydrocarbons and nitrogen oxides in the air. An ingredient of smog.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nitrate de peroxyacétyle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nitrato de peroxiacetilo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Peroxiacetylnitrat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">peroxyacetylnitraat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пероксилацетилнитрат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество, образованное в результате воздействия солнечного света на углеводороды и оксиды азота в воздухе. Составная часть смога.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نترات البيروكسي أسيتيل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5604" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6129">
    <skos:prefLabel xml:lang="en">persistence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The capacity of a substance to remain chemically stable. This is an important factor in estimating the environmental effects of substances discharged into the environment. Certain toxic substances (e.g., cyanides) have a low persistence, whereas other less immediately toxic substances (e.g., many organochlorines) have a high persistence and may therefore produce more serious effects.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">persistance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">persistencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Persistenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werkingsduur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химическая инерция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность вещества оставаться химически стабильным. Важный для учета фактор при оценке экологического воздействия веществ, попадающих в окружающую среду. Некоторые токсичные вещества (например, цианиды) имеют низкую стойкость, в то время как другие (например, многие органхлорины) при  меньшей непосредственной токсичности обладают более высокой стойкостью и поэтому могут иметь более серьезное экологическое воздействие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">درجة المقاومة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1322" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6131" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/766" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6131">
    <skos:prefLabel xml:lang="en">persistence of pesticides</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability of a chemical to retain its molecular integrity and hence its physical, chemical, and functional characteristics in the environment through which such a chemical may be transported and distributed for a considerable period of time.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">persistance des pesticides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">persistencia de plaguicidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pestizidpersistenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werkingsduur van bestrijdingsmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инерция пестицидов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность химиката сохранять свою молекулярную целостность и, таким образом, свои физические, химические и функциональные характеристики в окружающей среде, через которую этот химикат может распространяться и в которой он может находиться в течение длительного периода времени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقاومة المبيدات الحشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11061">
    <skos:prefLabel xml:lang="en">natural heritage assessment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Evaluation of the natural structures, resources and landscapes to ensure their careful management and preservation.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation du patrimoine naturel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación de herencia natural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewertung von Naturerben</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bepaling van natuurlijk erfgoed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка природного наследия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка природных структур, ресурсов, ландшафтов для обеспечения их правильного управления и сохранности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم التراث الطبيعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6133">
    <skos:prefLabel xml:lang="en">personal responsibility</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">responsabilité personnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">responsabilidad personal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eigenverantwortung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">persoonlijke verantwoordelijkheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">персональная ответственность</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">المسؤولية الشخصية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7184" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9206">
    <skos:prefLabel xml:lang="en">water protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures to conserve surface and groundwater; to ensure the continued availability of water for growing domestic, commercial and industrial uses and to ensure sufficient water for natural ecosystems.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охрана вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры по сохранению поверхностных и грунтовых вод, по обеспечению регулярного снабжения водой для растущих промышленных, коммерческих и бытовых нужд и достаточного количества воды для поддержания экосистем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2900" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3785" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7538" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12107" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6138">
    <skos:prefLabel xml:lang="en">pest</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any organism that damages crops, injures or irritates livestock or man, or reduces the fertility of land.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déprédateur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plagas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schädling</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pest</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вредитель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организм, наносящий ущерб сельскохозяйственным культурам, который вредит или раздражает животных и человека, а также снижает плодородие почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/212" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3426" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6115" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8944" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6139">
    <skos:prefLabel xml:lang="en">pest control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Keeping down the number of pests by killing them or preventing them from attacking.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lutte antiparasitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de plagas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schädlingsbekämpfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestrijding (van plagen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">контроль за вредителями</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сдерживание численности вредителей в результате их уничтожения или предотвращения их нападения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكافحة الآفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1874" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/864" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1314" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4383" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9281" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4296">
    <skos:prefLabel xml:lang="en">inflammable substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substance liable to catch fire.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance inflammable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancias inflamables</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brennbarer Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">brandgevaarlijke stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">легковоспламеняющееся вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, способное легко загореться.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة قابلة للاشتعال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6724" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3505" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6143">
    <skos:prefLabel xml:lang="en">pesticide control standard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A norm or measure applicable in legal cases pertaining to the production, dissemination or use of substances designed to mitigate or eliminate insects or small animals that harm vegetation.
(Source: BLD / TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">norme de contrôle des pesticides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normas de control de plaguicidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schädlingsbekämpfungsnorm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">controlenorm voor bestrijdingsmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандарты контроля за пестицидами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Норма или мера, применяемые в судебных разбирательствах, относящиеся к производству, распространению или использованию веществ, предназначенных ослабить или уничтожить насекомых или мелких животных, наносящих вред растениям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معايير السيطرة على المبيدات الحشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8047" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6144">
    <skos:prefLabel xml:lang="en">pesticide pathway</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The specific or known route or vector of any chemical substance released into the environment to prevent, destroy or mitigate any pest that is directly or indirectly detrimental to harvest crops and other human interests.
(Source: TOE / FAI / DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cheminement des pesticides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">rastro de pesticidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pestizidpfad</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">door bestrijdingsmiddelen gevolgde weg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">движение пестицидов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специфический или известный путь, вектор любого химического вещества, выпущенного в окружающую среду в целях предотвращения, уничтожения или ослабления любого вредителя, который прямо или косвенно наносит ущерб сельскохозяйственным культурам или иначе вредит человеку.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسار المبيدات الحشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6402" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9216">
    <skos:prefLabel xml:lang="en">water quality management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water quality management concerns four major elements: the use (recreation, drinking water, fish and wildlife propagation, industrial or agricultural) to be made of the water; criteria to protect those uses; implementation plans (for needed industrial-municipal waste treatment improvements) and enforcement plans, and an anti-degradation statement to protect existing high quality waters.
(Source: USC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion de la qualité de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de calidad del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wassergütewirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterkwaliteitsbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление качеством воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление качеством воды касается четырех компонентов: использование воды (для отдыха, для потребления человеком, разведения рыб и дикой природы, для потребления в промышленности и сельском хозяйстве); критерии для защиты использования воды в этих областях; планы по реализации конкретных мер (например, необходимое улучшение городских систем обработки отходов) и планы по контролю за их выполнением; меры по защите вод высокого качества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة نوعية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9195" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12215" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6146">
    <skos:prefLabel xml:lang="en">residual pesticide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pesticide remaining in the environment for a fairly long time, continuing to be effective for days, weeks, and months.
(Source: HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">résidu de pesticide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo de plaguicida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pestizidrückstand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">resten van bestrijdingsmiddellen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">остаточное количество пестицидов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пестицид, остающийся в окружающей среде достаточно долго, действие которого продолжается в течение дней, недель, месяцев.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بقايا المبيدات الحشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7156" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7851">
    <skos:prefLabel xml:lang="en">soil condition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Description of the character of the surface of the ground at the time of observation, especially in relation to the influence of rain and snow.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">état pédologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">condición de suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bodenzustand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bodemgesteldheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">состояние почвы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Описание характера земной поверхности в момент наблюдения, особенно по отношению к воздействию снега или дождя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حالة التربة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7899" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1751" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6149">
    <skos:prefLabel xml:lang="en">pest infestation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The occurrence of one or more pest species in an area or location where their numbers and impact are currently or potentially at intolerable levels. 
2) A sudden increase in destructiveness or population numbers of a pest species in a given area.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">infestation parasitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">infestación por plaga</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schädlingsbefall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plaag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инвазия вредителей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Распространение одного или нескольких видов вредителей в районе или местности, где их текущая или потенциальная численность и воздействие являются непереносимыми. 2) Резкое увеличение разрушительного воздействия или численности вредителей в данном районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الغزو الحشري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4163" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9217">
    <skos:prefLabel xml:lang="en">water quantity management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The administration or handling of the amount of available potable water.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion de la quantité d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de cantidad de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wassermengenwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beheer van de waterhoeveelheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление количеством воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление или использование количества доступной питьевой воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة كمية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9195" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6152">
    <skos:prefLabel xml:lang="en">pet</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An animal which is kept in the home as a companion and treated affectionately.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">animal domestique (tenu en appartement)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">animal doméstico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Haustier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huisdier</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">домашнее животное</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Животное, за которым ухаживают и которое содержится в доме в качестве компаньона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حيوان أليف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2291" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6154">
    <skos:prefLabel xml:lang="en">petrochemical industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The production of materials derived from petroleum or natural gas.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie pétrochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria petroquímica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Petrochemische Industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">petrochemische industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтехимическая промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Производство материалов, получаемых из нефти или природного газа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة البتروكيماويات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1310" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6156">
    <skos:prefLabel xml:lang="en">petrol</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fuel for internal combustion engines consisting essentially of volatile flammable liquid hydrocarbons; derived from crude petroleum by processes such as distillation reforming, polymerization, catalytic cracking, and alkilation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">essence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gasolina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Benzin</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">benzine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">моторное топливо</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Топливо для двигателей внутреннего сгорания, состоящее, в основном, из летучих горючих жидких углеводородов; получается из сырой нефти в ходе дистилляции, полимеризации, каталитического крекинга и алкилирования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البنزين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5388" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8780" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5122">
    <skos:prefLabel xml:lang="en">measuring method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode de mesure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método de medida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meßmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">meetmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод измерений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسلوب القياس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13088" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5123" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3757">
    <skos:prefLabel xml:lang="en">environmental tax</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An amount of money demanded by a government to finance clean-up, prevention, reduction, enforcement or educational efforts intended to promote ecological integrity and the conservation of natural resources.
(Source: ODE / TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écotaxe</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecotasas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltsteuer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuheffing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог на охрану окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сумма денег, собираемая государством для финансирования расходов по восстановлению, предотвращению и снижению экологического ущерба, исполнения законов, обучения, направленных на поддержание экологической целостности и сохранения природных ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضريبة البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2810" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/566" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1170" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1637" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5637" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9052" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9068" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9128" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11048" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13115" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2493" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6161">
    <skos:prefLabel xml:lang="en">petroleum</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A comparatively volatile liquid bitumen composed principally of hydrocarbon, with traces of sulphur, nitrogen or oxygen compounds; can be removed from the earth in a liquid state.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdöl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(ruwe) aardolie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Относительно летучий жидкий битум, состоящий в основном из углеводородов со следами серы, азота или соединений кислорода; добывается из земных недр в жидком состоянии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البترول - النفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6967" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1885" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5834" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9098" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12394" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12482" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6162">
    <skos:prefLabel xml:lang="en">petroleum consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Petroleum belongs to non-renewable energy sources; it is a complex substance derived from the carbonized remains of trees, ferns, mosses, and other types of vegetable matter. The principal chemical constituents of oil are carbon, hydrogen, and sulphur. The various fuels made from crude oil are jet fuel, gasoline, kerosine, diesel fuel, and heavy fuel oils. Major oil consumption is in the following areas: transportation, residential-commercial, industrial and for generating electric power.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">consommation de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consumo de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdölverbrauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aardolieverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребление нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нефть относится к невозобновляемым источникам энергии; это сложное вещество, образованное на основе карбонизированных остатков деревьев, папоротников, мхов и других типов растительности. Основными химическими составляющими нефти являются углерод, водород и сера. Из сырой нефти производят топливо для самолетов, автомобилей, керосин, дизельное топливо, а также тяжелые топливные масла. Основные области потребления нефтепродуктов: транспорт, промышленность, производство электричества, коммерческая и бытовая деятельность.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاستهلاك النفطي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6163">
    <skos:prefLabel xml:lang="en">petroleum geology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of economic geology that relates to the origin, migration and accumulation of oil and gas, and to the discovery of commercial deposits. Its practice involves the application of geochemistry, geophysics, paleontology, structural geology and stratigraphy to the problems of finding hydrocarbons.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">géologie des ressources pétrolières</skos:prefLabel>
    <skos:prefLabel xml:lang="es">geología del petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdölgeologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aardolie-geologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">геология нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль экономической геологии, изучающая происхождение, миграцию и накопление запасов нефти и газа, а также открытие новых коммерческих месторождений, для чего также применяют знания в области геохимии, геофизики, палеонтологии, структурной геологии, стратиграфии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جيولوجيا البترول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5288" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6164">
    <skos:prefLabel xml:lang="en">petroleum industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Manufacturing industry utilizing complex combination of interdependent operations engaged in the storage and transportation, separation of crude molecular constituents, molecular cracking, molecular rebuilding, and solvent finishing to produce petrochemical products.
(Source: PZ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie pétrolière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria petrolera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdölindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aardolie-industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтяная промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль промышленности, предприятия которой заняты в процессах хранения, транспортировки, сепарации компонентов, крекинга, молекулярного реконструирования и пр. для производства нефтепродуктов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصناعات البترولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5840" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12482" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9220">
    <skos:prefLabel xml:lang="en">water regulatory authority</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The power of a government agency or its administrators to administer and implement regulations, laws and government policies relating to the preservation and protection of water resources.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">syndicat des eaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autoridad competente en aguas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserbehörde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полномочия на деятельность, связанную с управлением водным хозяйством</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Власть государственного органа или его руководителей применять и исполнять решения, законы и государственную политику, относящиеся к сохранению и защите водных ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيئة تنظيم المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/751">
    <skos:prefLabel xml:lang="en">beach</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The unconsolidated material that covers a gently sloping zone, typically with a concave profile, extending landward from the low-water line to the place where there is a definite change in material or physiographic from (such as a cliff), or to the line of permanent vegetation (usually the effective limit of the highest storm waves); a shore of body of water, formed and washed by waves or tides, usually covered by sand or gravel, and lacking a bare rocky surface.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">playas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">strand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пляж</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сыпучий материал, покрывающий поверхность слегка наклоненного участка земной поверхности, чаще всего с извилистым профилем, протянувшимся от мелководья к такому месту на суше, где различается четкая граница между материалами поверхностного слоя, происходит изменение физиографической формы (например, находится скала) или начинается полоса постоянной растительности (чаще всего действительный предел самых высоких волн при шторме); берег водоема, формируемый и находящийся под воздействием волн и приливов, обычно покрытый песком и галькой и не имеющий каменистой поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شاطئ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7528" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10149" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6176">
    <skos:prefLabel xml:lang="en">phanerogam</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plants that produce seeds. The group comprises the Gymnospermae and the Angiospermae.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phanérogame</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fanerógamas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phanerogame</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zichtbaar bloeiende planten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">явнобрачное растение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растения, которые дают семена. К таким растениям относятся  представители Gymnospermae и Angiospermae.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البزريات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1890" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/411" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3805" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6177">
    <skos:prefLabel xml:lang="en">pharmaceutical industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concerted activity concerned with manufacturing pharmaceutical goods.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie pharmaceutique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria farmacéutica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pharmazeutische Industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">farmaceutische industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фармацевтическая промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, связанная с производством фармацевтических товаров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصناعات الدوائية - الصناعات الصيدلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1310" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6179">
    <skos:prefLabel xml:lang="en">pharmaceutical waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discarded medicinal drugs and related products from pharmacies, hospitals, clinics, pharmaceutical manufacturers, etc.
(Source: APD / EPW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet pharmaceutique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo farmaceútico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Apothekenabfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">apotheekafval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фармацевтические отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Медицинские препараты и аналогичные продукты, выброшенные из аптек, больниц, клиник, в ходе производства фармацевтических товаров и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المخلفات الصيدلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12379" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5137" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6180">
    <skos:prefLabel xml:lang="en">pharmacokinetics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the rates of absorption, tissue distribution, biotransformation, and excretion.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pharmacocinétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">farmacocinética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pharmakokinetik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">farmacokinetica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фармакокинетика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение скорости абсорбции, распределения в тканях, биотрансформации, выделения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حركية الدواء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6181">
    <skos:prefLabel xml:lang="en">pharmacology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science dealing with the nature and properties of drugs, particularly their actions.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pharmacologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">farmacología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pharmakologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">farmacologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фармакология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая природу и свойства препаратов, особенно их действие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الصيدلة - الفارماكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6183">
    <skos:prefLabel xml:lang="en">phenol</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A white crystalline soluble poisonous acidic derivative of benzene, used as an antiseptic and disinfectant and in the manufacture of resins, nylon, dyes, explosives and pharmaceuticals.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phénol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fenoles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phenol</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fenol</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фенол</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Белое кристаллическое, растворимое в воде, кислотное производное бензина, используемое в качестве антисептического и дезинфицирующего средства в производстве смол, нейлона, красок, взрывчатых веществ и медицинских препаратов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفينول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5929" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3821" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6184">
    <skos:prefLabel xml:lang="en">pheromone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any substance secreted by an animal which influences the behaviour of other individuals of the same species.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phérormone</skos:prefLabel>
    <skos:prefLabel xml:lang="es">feromona</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pheromone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">feromoon</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">феромон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, выделяемое животным, влияющее на поведение других особей этого же вида.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفيرومون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/895" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5097">
    <skos:prefLabel xml:lang="en">mathematical analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of mathematics most explicitly concerned with the limit process or the concept of convergence; includes the theories of differentiation, integration and measure, infinite series, and analytic functions.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse mathématique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis matemático</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mathematische Analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wiskundige analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">математический анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль математики, в рамках которой происходит изучение конечных процессов или концепции конвергенции; включает теории дифференциалов, интегралов, измерения, бесконечных рядов и аналитических функций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحليل الرياضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8278" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1113" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6187">
    <skos:prefLabel xml:lang="en">philosophy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The academic discipline concerned with making explicit the nature and significance of ordinary and scientific beliefs and investigating the intelligibility of concepts by means of rational argument concerning their presuppositions, implications, and interrelationships; in particular, the rational investigation of the nature and structure of reality (metaphysics), the resources and limits of knowledge (epistemology), the principles and import of moral judgment (ethics), and the relationship between language and reality (semantics).
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">philosophie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">filosofía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Philosophie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">filosofie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">философия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Научная дисциплина, изучающая природу и значение обычных и научных представлений, анализирующая различные концепции посредством логического рассуждения; например, рациональное изучение природы и структуры бытия (метафизика), ресурсы и ограничения знаний (гносеология), принципы морали (этика), взаимоотношения между языком и реальностью (семантика).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفلسفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10019" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/163" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2980" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6189">
    <skos:prefLabel xml:lang="en">phosphate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Generic term for any compound containing a phosphate group.
2) Any salt or ester of any phosphoric acid, especially a salt of orthophosphoric acid.
(Source: MGH /  CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phosphate</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fosfato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phosphat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fosfaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фосфат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Общий термин, относящийся к любому соединению группы фосфатов. 2) Соль или сложный эфир фосфорной кислоты, особенно соль ортофосфорной кислоты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفوسفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6190">
    <skos:prefLabel xml:lang="en">phosphate removal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Replacement of phosphate in detergents by environmentally safer substances, such as zeolite. The substitute will not act as a nutrient, and so will not cause eutrophication as a result of the accelerated growth of plants and microorganisms if it is released into waterways.
(Source: WRIGHTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déphosphatation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">eliminación de fosfato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phosphatelimination</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fosfaatverwijdering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">замещение фосфатов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Замена фосфатов в составе стиральных порошков на другие, экологичные вещества, например, цеолит. Заменитель не обладает питательными свойствам, поэтому в случае попадания в водоемы не будет способствовать явлению эвтрофикации, которое выражается в усиленном росте растений и микроорганизмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إزالة الفوسفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6192">
    <skos:prefLabel xml:lang="en">phosphate substitute</skos:prefLabel>
    <skos:scopeNote xml:lang="en">All substances that are able to substitute phosphate compounds in detergents; they must have the same chemical and physical properties and must be less polluting for the environment.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substitut du phosphate</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustituto del fosfato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phosphatersatzstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fosfaatvervangingsmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заменитель фосфатов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, способные заменить фосфаты в составе стиральных порошков; должны обладать сходными химическими и физическими свойствами, но должны в меньшей степени вредить окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بدائل الفوسفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8174" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5128">
    <skos:prefLabel xml:lang="en">mechanical engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of engineering concerned with the design, construction, and operation of machines.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">génie mécanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería mecánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Maschinenbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">procestechnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">машиностроение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль промышленности, в рамках которой осуществляется проектирование, создание и эксплуатация машин.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهندسة الميكانيكية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12586" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6196">
    <skos:prefLabel xml:lang="en">phosphorus</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A nonmetallic element used to manufacture phosphoric acid, in phosphor bronzes, incendiaries, pyrotechnics, matches, and rat poisons; the white or yellow allotrope is a soft waxy solid, soluble in carbon disulfide, insoluble in water and alcohol, and is poisonous and self-igniting in air; the red allotrope is an amorphous powder, insoluble in all solvents and is nonpoisonous; the black allotrope comprises lustrous crystals similar to graphite, and is insoluble in most solvents.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phosphore</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fósforo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phosphor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fosfor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фосфор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неметаллический элемент, используемый для производства фосфорной кислоты, бронзовых красок, боевых зажигательных средств, пиротехники, спичек, крысиной отравы; белый или желтый аллотроп представляет собой воскообразный твердый материал, растворимый в дисульфиде углерода и нерастворимый в воде или спирту, ядовитый и воспламеняющийся на воздухе; красный аллотроп представляет собой аморфный порошок, нерастворимый в любых растворителях и неядовитый; черный аллотроп представлен блестящими кристаллами, похожими на графит, нерастворимыми во всех  видах растворителей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفوسفور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2640" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6197">
    <skos:prefLabel xml:lang="en">photochemical agent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Agents which trigger off photochemical reactions.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réactif photochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efectos y agentes fotoquímicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photochemische Mittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotochemisch middel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотохимический агент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Реагенты, запускающие фотохимические реакции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل كيميائي ضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6201" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6199" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6198">
    <skos:prefLabel xml:lang="en">photochemical effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The result or consequence of a chemical reaction caused by light or ultraviolet radiation.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet photochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto fotoquímico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photochemische Wirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotochemisch effect</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотохимический эффект</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Результат или следствие химической реакции, вызванной действием света или ультрафиолетового излучения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تأثير كيميائي ضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6201" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6199">
    <skos:prefLabel xml:lang="en">photochemical oxidant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the chemicals which enter into oxidation reactions in the presence of light or other radiant energy.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oxydant photochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oxidante fotoquímico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photooxidantien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotochemische oxidant</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотохимический окислитель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химические вещества, вступающие в реакцию окисления на свету или под действием другого вида лучевой энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مؤكسد كيميائي ضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6197" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5980" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6202" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6200">
    <skos:prefLabel xml:lang="en">photochemical product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Degradation products that are produced by the action of light radiation.
(Source: FLGISAa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit photochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos fotoquímicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photochemisches Produkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotochemische product</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотохимический продукт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продукты разложения, полученные в результате действия светового излучения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتج كيميائي ضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13123" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6201">
    <skos:prefLabel xml:lang="en">photochemical reaction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical reaction which is initiated by light of a specific wavelength. In an environmental context an example is the potential action of ultraviolet light on CFCs which may bring about the detrimental degradation of the ozone layer. Photochemical reactions initiate the process of photosynthesis in which plants convert carbon dioxide into sugars, which are incorporated into cell materials.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réaction photochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reacciones fotoquímicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photochemische Reaktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotochemische reactie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотохимическая реакция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическая реакция, которая начинается под действием света с определенной длинной волны. В экологическом контексте примером может служить потенциальное действие ультрафиолетовых лучей на газы CFC, способствующие разрушению озонового слоя. Фотохимическая реакция начинает процесс фотосинтеза, в ходе которого растения преобразуют углекислый газ в сахар, идущий на строительство клеток.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تفاعل كيميائي ضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6197" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6198" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11789" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6211" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6202">
    <skos:prefLabel xml:lang="en">photochemical smog</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A combination of fog and chemicals that come from automobile and factory emissions and is acted upon by the action of the sun. Nitrogen dioxide, in the presence of the sun and some hydrocarbons, is turned into nitric oxide and atomic oxygen. The atomic oxygen reacts with the oxygen molecules and other constituents of automobile exhaust fumes to form a variety of products including ozone. The ozone is harmful in itself and is also implicated in a highly complex series of continuing reactions. As long as there is ozone or nitrogen dioxide and sunlight present, other undesirable reactions will occur.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">smog photochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">niebla fotoquímica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photochemischer Smog</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotochemische smog</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотохимический смог</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение тумана и химикатов, попавших в атмосферу вместе с автомобильными выхлопами и промышленными выбросами и подвергшихся действию солнечных лучей. Диоксид азота в присутствии солнечного света и некоторых углеводородов преобразуется в азотную кислоту и атомный кислород. Атомарный кислород вступает в реакцию с молекулярным кислородом и другими компонентами автомобильных выхлопов, образуя различные продукты, включая озон. Озон вреден сам по себе, кроме того, он становится участником сложной серии продолжающихся реакций. Наличие озона и диоксида азота при солнечном свете всегда гарантирует образование нежелательных реакций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضباب كيميائي ضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7759" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6199" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6204">
    <skos:prefLabel xml:lang="en">photogrammetry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of making measurements from photographs, used especially in the construction of maps from aerial photographs and also in military intelligence, medical and industrial research, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">photogrammétrie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fotogrametría</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photogrammetrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotogrammetrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотограмметрия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс осуществления измерений с применением фотографий; часто используется при составлении карт на основе аэрофотосъемки, а также для военной разведки, медицинских и промышленных исследований и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التصوير المساحي الضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5354" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6205">
    <skos:prefLabel xml:lang="en">photograph</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An image captured by a camera or some other device and reproduced as a picture, usually on a sensitized surface and formed by the chemical action of light or of radiant energy.
(Source: MHD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">photo</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fotografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photo</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">foto</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изображение, особенно позитивный отпечаток, зафиксированный фотокамерой и воспроизведенной на фоточувствительной поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صورة فوتوغرافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2284" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/135" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6253" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14906" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5887">
    <skos:prefLabel xml:lang="en">ore</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mineral or mineral aggregate, more or less mixed with gangue, that can be worked and treated at a profit.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">minerai</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mineral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">erts</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">руда</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Минерал или минеральный сросток, более или менее связанные жильной породой, которые могут быть переработаны и реализованы с прибылью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6967" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/352" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7298" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6211">
    <skos:prefLabel xml:lang="en">photosynthesis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process by which plants transform carbon dioxide and water into carbohydrates and other compounds, using energy from the sun captured by chlorophyll in the plant. Oxygen is a by-product of the process. Photosynthesis is the essence of all plant life (autotrophic production) and hence of all animal life (heterotrophic production) on the planet Earth. The rate of photosynthesis depends on climate, intensity and duration of sunlight, available leaf area, soil nutrient availability, temperature, carbon dioxide concentration, and soil moisture regimes.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">photosynthèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fotosíntesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photosynthese</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotosynthese</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотосинтез</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого растения преобразуют углекислый газ и воду в углеводы и другие соединения, используя энергию солнечного света в хлорофилле. Кислород является попутным продуктом этого процесса. Фотосинтез является основой растительной жизни (автотрофное производство) и, таким образом, всей животной жизни (гетеротрофного производства) на Земле. Скорость фотосинтеза зависит от климата, интенсивности и продолжительности солнечного света, площади поверхности листьев, количества питательных веществ в почве, температуры, концентрации углекислого газа, а также режима влажности почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التمثيل الضوئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10043" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/605" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1391" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6201" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11118">
    <skos:prefLabel xml:lang="en">spatial distribution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A distribution or set of geographic observations representing the values of behaviour of a particular phenomenon or characteristic across many locations on the surface of the Earth.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">distribution spatiale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">distribución espacial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Räumliche Verteilung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruimtelijke verdeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пространственное распределение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Распределение или комплекс географических наблюдений, отражающих параметры поведения конкретного явления или свойства в разных точках поверхности Земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوزيع المساحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8663">
    <skos:prefLabel xml:lang="en">treaty</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An international agreement in writing between two states or a number of states. Treaties are binding in international law; some treaties create law only for those states that are parties to them.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vertrag</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verdrag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международный договор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Международное соглашение, заключенное в письменном виде между двумя или более государствами. По международному праву международные договоры являются обязательными для выполнения; некоторые международные договоры создают правовые условия только для участвующих стран.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاقية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13279" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1762" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9043">
    <skos:prefLabel xml:lang="en">waste air purification (gas)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">traitement des effluents gazeux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">purificación de aire de residuos (gas)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abluftreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuivering van rookgassen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистка отработанного воздуха (газа)</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تنقية الهواء المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6838" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/878" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2072" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9077" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6221">
    <skos:prefLabel xml:lang="en">physical conditions</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">condition physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">condición física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesundheitszustand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lichamelijke toestand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физические условия</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الظروف المادية - الظروف الفيزيقية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3865" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6222">
    <skos:prefLabel xml:lang="en">physical geography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the spatial and temporal characteristics and relationships of all phenomena within the Earth's physical environment.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">géographie physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">geografía física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physische Geographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysische geografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физическая география</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение пространственных и температурных характеристик, взаимоотношений всех явлений физической среды на Земле.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجغرافيا الفيزيائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3646" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6224">
    <skos:prefLabel xml:lang="en">physical oceanography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the physical aspects of the ocean, the movements of the sea, and the variability of these factors in relationship to the atmosphere and the ocean bottom.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">océanographie physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oceanografía física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physische Ozeanographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysische oceanografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физическая океанография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение физических аспектов океанов, движения моря, изменения этих факторов в зависимости от состояния атмосферы и дна океана.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيزياء المحيطات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5797" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6225">
    <skos:prefLabel xml:lang="en">physical planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A form of urban land use planning which attempts to achieve an optimal spatial coordination of different human activities for the enhancement of the quality of life.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">planification de l'espace physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Raumplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruimtelijke ordening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">планирование окружающей физической среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Форма планирования городского землепользования, которая стремится достичь оптимальной пространственной координации различных видов человеческой деятельности в целях улучшения качества жизни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخطيط الفيزيائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4635" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4659" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8648" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7075" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14418">
    <skos:prefLabel xml:lang="en">municipal heating network</skos:prefLabel>
    <skos:scopeNote xml:lang="en">System of heating all houses in a urban district from a central source (as from hot springs in Iceland or by cooling water from a power station).
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau de chauffage urbain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">red de calefacción municipal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtwerke (Wärmeversorgung)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeentelijk verwarmingsnetwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городская система теплоснабжения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, обеспечивающая теплом все жилые дома в городском районе из центрального источника (например, из горячих подземных источников в Исландии или охлаждающей водой, поступающей с электростанции).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبكة تدفئة بلدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6227">
    <skos:prefLabel xml:lang="en">physical pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The introduction or presence of harmful substances or forces in the environment that cause damage to the environment and its processes due to their material actions, as through vibration, thermal alteration or electromagnetic radiation.
(Source: TOE / APD / LES)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physikalische Verunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysische verontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физическое загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Попадание или присутствие вредных веществ или сил, наносящих ущерб окружающей среде и ее процессам вследствие своего материального действия, как, например, вибрации, электромагнитного излучения и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث فيزيائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5651" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8442" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6226" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6228">
    <skos:prefLabel xml:lang="en">physical process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A continuous action or series of changes which alters the material form of matter.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesos físicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physikalischer Vorgang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysische processen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продолженное действие или серия изменений, которые видоизменяют форму материи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية فيزيائية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/132" />
