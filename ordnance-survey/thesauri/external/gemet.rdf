    <skos:prefLabel xml:lang="nl">brandstofsamenstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">состав топлива</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تركيب الوقود</skos:prefLabel>
