    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5734">
    <skos:prefLabel xml:lang="en">nuclear debate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ongoing, public discussion and dispute over the uses of energy.
(Source: ISEP /  MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">débat sur le nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">polémica nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Atomdebatte</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overleg over kernenergie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дебаты по вопросам использования ядерной энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продолжающаяся, открытая дискуссия по вопросам использования ядерной энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جدل حول النشاط النووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5880" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5736">
    <skos:prefLabel xml:lang="en">nuclear power plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A power plant in which nuclear energy is converted into heat for use in producing steam for turbines, which in turn drive generators that produce electric power.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">centrale nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">central nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernkraftwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kerncentrale</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">атомная электростанция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Электростанция, в которой ядерная энергия превращается в тепло для производство пара для турбин, которые в свою очередь вращают генераторы, производящие электрический ток.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة طاقة نووية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2606" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5746" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5052">
    <skos:prefLabel xml:lang="en">maritime navigation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Travelling on the sea by means of boats, ships, etc.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">navigation maritime</skos:prefLabel>
    <skos:prefLabel xml:lang="es">navegación marítima</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Seeschiffahrt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeenavigatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морская навигация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Путешествие по морю на лодках, судах и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الملاحة البحرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3687">
    <skos:prefLabel xml:lang="en">global convention</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A worldwide assembly of national, political party or organizational delegates, or the pact or the agreement that arises from such an assembly that forms, often, the preliminary to an international treaty.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">convention internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">convenio global</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Globale Konvention</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wereldconventie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">глобальная конвенция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Международное собрание представителей государств, политических партий, организаций, либо соглашение, ставшее результатом такого собрания, создающее условия для заключения международного договора.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اجتماع عالمي - اتفاقية عالمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4420" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8920">
    <skos:prefLabel xml:lang="en">vegetable</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various herbaceous plants having parts that are used as food.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">légume</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hortalizas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemüse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">groente</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">овощ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные травянистые растения, плоды которых употребляются в качестве продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خضراوات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3771" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8909" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5741">
    <skos:prefLabel xml:lang="en">nuclear reaction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A reaction involving a change in an atomic nucleus, such as fission, fusion, neutron capture, or radioactive decay, as distinct from a chemical reaction, which is limited to changes in the electron structure surrounding the nucleus.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réaction nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reacción nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernreaktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kernreactie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерная реакция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Реакция, связанная с изменениями атомного ядра, например, расщепление, синтез, присоединение электрона, ядерный распад, в отличие от химической реакции, при которой происходят изменения лишь в структуре электронов, окружающих ядро.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تفاعل نووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5722" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5728" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4491" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5712" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5718" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5742">
    <skos:prefLabel xml:lang="en">nuclear reactor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Device which creates heat and energy by starting and controlling atomic fission.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réacteur nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reactores nucleares</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernreaktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kernreactor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерный реактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устройство, которое производит тепло и энергию в результате запуска и контролированного проведения реакции ядерного расщепления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مفاعل نووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6977" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12006" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5724" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6978" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12816" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13937">
    <skos:prefLabel xml:lang="en">penal sanction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Punishment for the commission of a specific crime, such as fines, restitution, probation and imprisonment.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sanction pénale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanción penal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strafsanktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">straf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">карательная санкция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наказание за совершение какого-либо правонарушения, например, штраф, реституция, условное осуждение или тюремное заключение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقوبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7411" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5746">
    <skos:prefLabel xml:lang="en">nuclear safety</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures and techniques implemented to reduce the possibility of incidence and the potential harm posed by radioactive substances used as an energy source, a test material or in weaponry.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sécurité nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">seguridad nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nukleare Sicherheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nucleaire veiligheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерная безопасность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры и приемы, реализуемые в целях снижения вероятности нанесения ущерба, потенциалом нанесения которого обладают радиоактивные вещества, используемые в качестве источника энергии, экспериментального материала или оружия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأمان النووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5736" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2323">
    <skos:prefLabel xml:lang="en">drainage water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Incidental surface waters from diverse sources such as rainfall, snow melt or permafrost melt.
(Source: JJK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de drainage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua de drenaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dränwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwatering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поверхностная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода на поверхности, полученная в ходе таких процессов, как выпадение дождя, таяние снега или вечной мерзлоты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه الصرف الصحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5750">
    <skos:prefLabel xml:lang="en">nuclear weapon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any bomb, warhead, or projectile using active nuclear material to cause a chain reaction upon detonation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arme nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">armas nucleares</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernwaffen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kernwapen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерное оружие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бомба, боеголовка или реактивный снаряд, в которых при детонации начинается цепная реакция активного ядерного материала.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلاح نووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9267" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5751">
    <skos:prefLabel xml:lang="en">nucleic acid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of several organic acids combined with proteins (DNA or RNA) which exist in the nucleus and protoplasm of all cells.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acide nucléïque</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ácido nucléico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nukleinsäure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nucleïnezuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нуклеиновая кислота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Несколько органических кислот, связанных с белками (ДНК или РНК) и находящихся в ядрах и протоплазме клетки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمض نووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5752">
    <skos:prefLabel xml:lang="en">nuisance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Anything that affects or prejudices health.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nuisance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">molestia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Belästigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hinder</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">раздражитель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Что-либо отрицательно воздействующее на здоровье или предопределяющее болезнь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إزعاج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5755">
    <skos:prefLabel xml:lang="en">nursery (plant breeding)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Place where plants are grown until they are large enough to be planted in their final positions.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pépinière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">criadero (fitogenética)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenzuchtbetrieb</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(planten)kwekerij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">теплица (разведение растений)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объект, где выращиваются растения до того, как будут высажены в место постоянного произрастания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مشتل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5756">
    <skos:prefLabel xml:lang="en">nutrient medium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A medium providing or contributing to nourishment.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">milieu de culture (microbiologie)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medio nutritivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährmedium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedingsbodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">средство питания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство, способствующее или содействующее питанию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وسيط تغذية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6660" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5757">
    <skos:prefLabel xml:lang="en">nutrient balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Condition in which there is equilibrium between intake and excretion of nutrients.
(Source: STEDMA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bilan nutritif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio nutritivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährstoffhaushalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedingsbalans</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питательный баланс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние равновесия между потреблением и выделением питательных веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوازن الغذائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5088" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5758">
    <skos:prefLabel xml:lang="en">nutrient content</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of proteins, carbohydrates, fats, inorganic salts (e.g. nitrates, phosphates), minerals (e.g. calcium, iron), and water.
(Source: PORTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">teneur en nutriments</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contenido nutritivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährstoffgehalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedingswaarde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питательный состав</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество белков, углеводов, жиров, неорганических солей (например, нитратов, фосфатов), минеральных веществ (например, кальция, железа) и воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المحتوى الغذائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1673" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5759">
    <skos:prefLabel xml:lang="en">nutrient cycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A biogeochemical cycle, in which inorganic nutrients move through the soil, living organisms, air and water or through some of these.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cycle des substances nutritives</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclo nutritivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährstoffzyklus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nutriëntenkringloop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питательный цикл</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Биогеохимический цикл, в рамках которого питательные вещества проходят через почву, живые организмы, воздух и воду или лишь через некоторых из них.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دورة التغذية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/833" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5761">
    <skos:prefLabel xml:lang="en">nutrient removal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Elimination of nutrients as, for example, from sewage in order to prevent eutrophication of water in reservoirs.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction des nutriments</skos:prefLabel>
    <skos:prefLabel xml:lang="es">traslado nutritivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährstoffelimination</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onttrekking van voedingsstoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">удаление питательных веществ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление питательных веществ, как, например, из канализационных стоков в целях предотвращения эвтрофикации воды в отстойниках.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إزالة المغذيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5763">
    <skos:prefLabel xml:lang="en">nutrient</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical elements which are involved in the construction of living tissue and which are needed by both plant and animal. The most important in terms of bulk are carbon, hydrogen and oxygen, with other essential ones including nitrogen, potassium, calcium, sulphur and phosphorus.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nutriment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nutrientes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nutriënt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питательное вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химические элементы, участвующие в построении живой ткани, которые необходимы как растениям, так и животным. Самыми важными в плане массы являются углерод, водород, кислород, а также другие - азот, калий, фосфор, кальций и сера.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة مغذية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8648">
    <skos:prefLabel xml:lang="en">transport planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A programme of action to provide for present and future demands for movement of people and goods. Such a programme is preceded by a transport study and necessarily includes consideration of the various modes of transport.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">planification des transports</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación del transporte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Transportsystemplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervoersplanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортное планирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Программа действий, предусматривающая обеспечение текущих и будущих потребностей в перевозках людей и грузов. Такой программе предшествует проведение транспортного анализа, а сама программа обязательно должна содержать уточнение по видам транспортировки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخطيط النقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6225" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/279" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7320" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5765">
    <skos:prefLabel xml:lang="en">nutrition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process in animals and plants involving the intake of nutrient materials and their subsequent assimilation into the tissues.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nutrition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alimentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ernährung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процессы, проходящие в животных и растениях, включающие потребление питательного материала и его последующую ассимиляцию в тканях организма.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التغذية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/435" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/495" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3953" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8056" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9153">
    <skos:prefLabel xml:lang="en">water bottom</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The floor upon which any body of water rests.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fond de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fondo de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewässersohle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дно водоема</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дно, над которым располагаются воды любого водоема.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاع الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9151" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5769">
    <skos:prefLabel xml:lang="en">nutritive value of food</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The measure of the quantity or availability of nutrients found in materials ingested and utilized by humans or animals as a source of nutrition and energy.
(Source: RHW / MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">valeur nutritive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">valor nutritivo de los alimentos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährwert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedingswaarde van voedsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питательная ценность продуктов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество или доступность питательных веществ, находящихся в продуктах, потребляемых и перевариваемых человеком и животными в качестве источника энергии и питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القيمة الغذائية للطعام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3380" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8921">
    <skos:prefLabel xml:lang="en">vegetable waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste, comprised mainly of vegetable matter, which is capable of being decomposed by microorganisms.
(Source: BHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet végétal</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzlicher Abfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantaardig afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растительные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, состоящие из растительного материала, который обладает способностью к разложению микроорганизмами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات الخضراوات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1651" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6423">
    <skos:prefLabel xml:lang="en">pollutant mobilisation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">mobilisation des polluants</skos:prefLabel>
    <skos:prefLabel xml:lang="es">movilización contaminante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schadstoffmobilisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het vrijkomen van verontreinigende stoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мобилизация загрязняющих веществ</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تحريك الملوثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6412" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6430" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13250">
    <skos:prefLabel xml:lang="en">tax on consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sum of money demanded from businesses by a government, usually based on a percentage of total sales of select goods and services, and generally passed on to consumers with each individual purchase.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">impôt sur la consommation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">impuesto sobre el consumo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verbrauchssteuer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verbruiksbelasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог на потребителя</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Налог на расходы покупателя по приобретению товаров и услуг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضريبة على الاستهلاك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5774">
    <skos:prefLabel xml:lang="en">oak</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any tree of the genus Quercus in the order Fagales, characterized by simple, usually lobed leaves, scaly winter buds, a star-shaped pith, and its fruit, the acorn, which is a nut; the wood is tough, hard, and durable, generally having a distinct pattern.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chêne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">robles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eiche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eiken(bomen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дуб</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дерево рода Quercus подкласса Fagales, которое характеризуется наличием простых, обычно округлых листьев, звездообразной сердцевиной ствола на срезе, а также плода - желудя, который является орехом; древесина крепкая, твердая, износоустойчивая, обычно имеет характерный рисунок.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سنديان - بلوط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3313" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5776">
    <skos:prefLabel xml:lang="en">objection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of a party who objects to some matter or proceeding in the course of a trial or an argument or reason urged by him in support of his contention that the matter or proceeding objected to is improper or illegal.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">objection</skos:prefLabel>
    <skos:prefLabel xml:lang="es">objeción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Einwendung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bezwaar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">возражение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие стороны, не согласной с каким-либо вопросом или процедурой судебного заседания, аргумент или довод, выдвигаемые ею в поддержку своего мнения, что вопрос или процедура, с которыми она не согласна, являются неправильными или незаконными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اعتراض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5777">
    <skos:prefLabel xml:lang="en">obligation to inform</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">obligation d'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">obligación de informar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationspflicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inlichtingsplicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обязательство информировать</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التزام بالإعلام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4255" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5778">
    <skos:prefLabel xml:lang="en">obligation to label</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The legal responsibility or duty compelling manufacturers to affix certain marks or other written identification to their products, as is directed by laws, regulations or government standards.
(Source: BLD / FPL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">obligation d'étiquetage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">obligación de etiquetar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kennzeichnungspflicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">etiketteringsplicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обязательство маркировать</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязанность или долг, предписанные законом, правилом или государственным стандартом, в соответствии с которыми производитель должен прикрепить к своей продукции этикетки или другие письменные идентификационные наклейки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إلتزام بإلصاق بطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6663" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4284">
    <skos:prefLabel xml:lang="en">infant mortality</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The rate of deaths occurring in the first year of life for a given population.
(Source: MED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mortalité infantile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mortalidad infantil</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Säuglingssterblichkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kindersterfte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">детская смертность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество смертей, случающихся в течение первого года жизни младенцев конкретной группы населения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وفيات الأطفال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5371" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5781">
    <skos:prefLabel xml:lang="en">occupational disease</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A functional or organic disease caused by factors arising from the operations or materials of an individual's industry, trade, or occupation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">maladie professionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enfermedades ocupacionales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Berufskrankheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beroepsziekte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональное заболевание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Функциональное или органическое заболевание, вызванное причинами, связанными с операциями или материалами, составляющими профессиональное занятие лица.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرض مهني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11752" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9369" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5783">
    <skos:prefLabel xml:lang="en">occupational group</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A collection of people who earn their living by similar or identical means of work.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">association professionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">grupo profesional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Berufsgruppe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beroepsgroep</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональная группа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа лиц, обеспечивающих себе средства к существованию схожей или аналогичной работой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جماعة مهنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6594" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13976">
    <skos:prefLabel xml:lang="en">coniferous tree</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">conifère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conífera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nadelbaum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">naaldboom</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">хвойное дерево</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">شجرة صنوبر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5785">
    <skos:prefLabel xml:lang="en">occupational health care</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">service de médecine du travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salud ocupacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Betriebsgesundheitsvorsorge</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsgezondheidszorg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональное здравоохранение</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الرعاية الصحية المهنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5784" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7180" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5786">
    <skos:prefLabel xml:lang="en">occupational medicine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of medicine which deals with the relationship of humans to their occupations, for the purpose of the prevention of disease and injury and the promotion of optimal health, productivity, and social adjustment.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">médecine du travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medicina del trabajo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeitsmedizin</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsgeneeskunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональная медицина</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль медицины, изучающая взаимоотношения между людьми и условиями их труда в целях предотвращения болезней или ущерба здоровью, содействия оптимальному состоянию здоровья, производительности труда и социальной адаптации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طب العمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4250" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5787">
    <skos:prefLabel xml:lang="en">occupational safety</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An area of statutory duty imposed on employers and employees in most countries, for the protection of the workforce from occupational disease and stresses and physical hazards through appropriate measures.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sécurité du travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">seguridad en el trabajo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeitssicherheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsveiligheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональная техника  безопасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Во многих странах уставная обязанность работодателей и работников предприятия осуществлять защиту работников от профессиональных заболеваний, стрессов и физических рисков через реализацию соответствующих мер.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأمن الوظيفي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9366" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9375" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5788">
    <skos:prefLabel xml:lang="en">occupational safety regulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Law enacted to reduce the incidence among workers of personal injuries, illnesses, and deaths resulting from employment.
(Source: BLACKa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réglementation de sécurité au travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reglamento de seguridad profesional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeitsschutzvorschrift</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsveiligheidsvoorschrift</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нормативный документ в области техники безопасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Закон, установленный с целью снижения травматизма, заболеваемости и числа несчастных случаев среди персонала, вызванных обстоятельствами, связанными с условиями труда или местом работы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيم الأمن الوظيفي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11514" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5789">
    <skos:prefLabel xml:lang="en">ocean</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The mass of water occupying all of the Earth's surface not occupied by land, but excluding all lakes and inland seas.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">océan</skos:prefLabel>
    <skos:prefLabel xml:lang="es">océanos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ozean</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oceaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">океан</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воды, покрывающие всю поверхность Земли за исключением территории суши, а также площадей озер и внутренних морей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7495" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13253">
    <skos:prefLabel xml:lang="en">taxation policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of government tax and spending
policies to achieve desired macroeconomic goals. Accordingly, they involve discretionary efforts to adjust governmental tax and spending to induce changes in economic incentives and, hence, to stabilize fluctuations in aggregate demand.
(Source: INDEDU)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique fiscale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política fiscal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steuerpolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belastingbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика в области налогообложения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование государственных налогов и политики расходования государственных средств для достижения поставленных макроэкономических целей. Включает также отдельные меры по регулированию государственных налогов и расходов с целью вызвать определенные изменения в экономике и стабилизировать колебания коллективного спроса на финансы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة الضرائب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8308" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8309" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5792">
    <skos:prefLabel xml:lang="en">ocean current</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A net transport of ocean water along a definable path.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">courant océanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">corriente oceánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresströmung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oceaanstroming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">океаническое течение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перенос океанической воды в рамках конкретного направления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التيار المحيطي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5791" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5793">
    <skos:prefLabel xml:lang="en">ocean dumping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process by which pollutants, including sewage, industrial waste, consumer waste, and agricultural and urban runoff are discharged into the world's oceans. These pollutants arise from a myriad of sources.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rejet en mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertimiento de desechos en el océano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verklappung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">storten in de oceaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сброс мусора в море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого загрязняющие вещества, включая канализационные, сельскохозяйственные и городские стоки, промышленные и бытовые отходы сбрасываются в воды мирового океана. Эти загрязняющие вещества образуются в бесчисленном количестве источников.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من النفايات في المحيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12417" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5794">
    <skos:prefLabel xml:lang="en">Oceania</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The islands of the southern, western and central Pacific Ocean, including Melanesia, Micronesia, and Polynesia. The term is sometimes extended to encompass Australia, New Zealand, and the Malay Archipelago.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Océanie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Oceanía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ozeanien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Oceanië</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Океания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа островов в южной, западной и центральной части Тихого океана, включая Микронезию, Меланезию и Полинезию. Часто термин толкуют широко, включая в его состав Австралию, Новую Зеландию и Малайский архипелаг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أوقيانيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9380" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3739">
    <skos:prefLabel xml:lang="en">gravel extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Obtaining a mixture of coarse sand and small water- worn or pounded stones, (used for paths and roads and as an aggregate) from the earth.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction de gravier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción de grava</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kiesabbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grindwinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча гравия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Извлечение из-под земли смеси крупного песка, гальки или дробленого камня (используемые для покрытия пешеходных дорожек и автострад, а также в качестве наполнителя).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج الحصى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13254">
    <skos:prefLabel xml:lang="en">farm price</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of money or monetary rate at which agricultural goods and services can be bought or sold.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prix agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">precio agrario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarpreis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwprijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">закупочная цена</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество денег или валютный курс, по которому сельскохозяйственные продукты и услуги могут быть куплены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سعر المزرعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6602" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5799">
    <skos:prefLabel xml:lang="en">ocean temperature</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A measure, referenced to a standard value, of the heat or coldness in a body of oceanic water.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">température de l'océan</skos:prefLabel>
    <skos:prefLabel xml:lang="es">temperatura del océano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meerestemperatur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oceaantemperatuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">температура океана</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Измерение и сравнение со стандартным значением степени тепла или холода в водоеме, наполненном океанической водой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">درجة حرارة المحيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5791" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5802">
    <skos:prefLabel xml:lang="en">odonate</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">odonates</skos:prefLabel>
    <skos:prefLabel xml:lang="es">odonato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Libellen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">libellen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стрекозы и красотки</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الرعَّاشات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2316" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9159">
    <skos:prefLabel xml:lang="en">water conservation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The protection, development and efficient management of water resources for beneficial purposes.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">conservation de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conservación del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewässerschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbehoud</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сохранение водных ресурсов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Охрана, развитие и эффективное управление водными ресурсами для благих целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحفاظ على المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2790" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1704" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5804">
    <skos:prefLabel xml:lang="en">odour</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The property of a substance affecting the sense of smell; any smell; scent; perfume.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">odeur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">olor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geruch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reuk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">запах</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойство вещества, воздействующее на органы обоняния; любой запах, аромат, благоухание.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رائحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/265" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5806">
    <skos:prefLabel xml:lang="en">odour nuisance</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">puanteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">molestia producida por los olores</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geruchsbelästigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geurhinder</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">раздражающий запах</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">رائحة كريهة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5547" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2921">
    <skos:prefLabel xml:lang="en">environmental risk</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Likelihood, or probability, of injury, disease, or death resulting from exposure to a potential environmental hazard.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">risque pour l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">riesgo ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltrisiko</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieurisico</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологический риск</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вероятность ущерба, заболевания, смерти вследствие подверженности действию потенциальной экологической угрозы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطورة على البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13256">
    <skos:prefLabel xml:lang="en">transport cost</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The outlay or expenditure involved in moving goods from one place to another.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prix de transport</skos:prefLabel>
    <skos:prefLabel xml:lang="es">precio del tranporte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beförderungsentgelt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervoerskosten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортные расходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прямые расходы по перемещению товаров из одного места в другое.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكلفة النقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6602" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5810">
    <skos:prefLabel xml:lang="en">office</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any room, set of rooms or building used for the administration of government service, business transactions or other work related activities.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bureau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oficina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Büro</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kantoor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">офис</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одно или несколько помещений, здание, используемые для работы государственной службы, проведения коммерческих операций или другой аналогичной деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكتب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10851" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5811">
    <skos:prefLabel xml:lang="en">official duty</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">devoir officiel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">deber oficial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Amtspflicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ambtsbezigheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">официальная обязанность</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">واجب رسمي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5812">
    <skos:prefLabel xml:lang="en">official hearing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Proceedings of relative formality, with definite issues of fact or of law to be tried, in which witnesses are heard and parties proceeded against have right to be heard.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">audience officielle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">audiencia oficial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anhörung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">officiële hoorzitting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">официальное слушание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Относительно формальное разбирательство, в ходе которого заслушиваются конкретные факты или обсуждаются положения закона, заслушиваются свидетели и сторона, против которой выдвигаются обвинения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استماع رسمي (في جلسة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6799" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5814">
    <skos:prefLabel xml:lang="en">off-peak commuting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Traveling back and forth regularly over some distance, outside of the hours of maximum traffic frequency.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport quotidien en heures creuses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">abono fuera de hora punta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pendeln außerhalb der üblichen Bürozeiten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pendelen buiten de spits</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внепиковая маятниковая миграция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Регулярные поездки во встречных направлениях вне графика пиковой нагрузки на транспорте в конкретном районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السفر للعمل في غير ساعات الذروة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1623" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9161">
    <skos:prefLabel xml:lang="en">watercourse</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A natural stream arising in a given drainage basin but not wholly dependent for its flow on surface drainage in its immediate area, flowing in a channel with a well-defined bed between visible banks or through a definite depression in the land, having a definite and permanent or periodic supply of water, and usually, but not necessarily, having a perceptible current in a particular direction and discharging at a fixed point into another body of water.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cours d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">curso de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserlauf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterloop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водный путь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Естественный водный поток в конкретном водосборном бассейне, частично зависящий от поверхностного стока в данном районе, протекающий по четко проложенному руслу между видимыми берегами либо по впадине в земной поверхности, имеющий определенный постоянный или периодический приток воды, необязательно заметное течение в конкретном направлении и впадающий в установленном месте другой водоем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسار المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4124" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1015" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7244" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8025" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4448" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12145" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5816">
    <skos:prefLabel xml:lang="en">off-peak travelling</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Relating to travelling outside rush-hours to avoid overcrowding in public means of transport.
(Source: WPRa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">voyage en période creuse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trabajo y movilización fuera de horas críticas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fahren außerhalb der Stoßzeiten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reizen in de minder drukke periode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внепиковые поездки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поездки вне часа пик в целях снижения загруженности общественного транспорта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السفر في غير ساعات الذروة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5818">
    <skos:prefLabel xml:lang="en">off-peak working</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">travail en heure creuse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trabajo fuera de hora punta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeiten außerhalb der üblichen Bürozeiten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werken buiten de spits</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внепиковый режим работы</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">العمل في غير ساعات الذروة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13343" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8222">
    <skos:prefLabel xml:lang="en">surface-active agent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance that, when used in small quantities, modifies the surface properties of liquids or solids. A surface-active agent reduces surface tension in a fluid or the interfacial tension between two immiscible fluids, such as oil and water. Surfactants are particularly useful in accomplishing the wetting or penetration of solids by aqueous liquids and serve in the manner of detergent, emulsifying, or dispersing agents. They are more effective than soap in certain situations and are used by conservators for such purposes as cleaning, wetting, and dispersing.
(Source: PALIM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agent tensio-actif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos tensoactivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tensid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">agens dat inwerkt op de oppervlakte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поверхностно-активное вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, которое при использовании в небольших количествах, изменяет поверхностные свойства жидкостей или твердых тел.  Поверхностно-активное вещество снижает поверхностное напряжение жидкости или напряжение на границе между двумя несмешивающимися жидкостями, например, воды и масла. Эти вещества используются для увлажнения твердых тел жидкостями и выполняют функции стиральных порошков, эмульгаторов или диспергирующих реагентов. При некоторых условиях бывают более эффективными, чем мыло, и используются достаточно широко для чистки, увлажнения или дисперсии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل نشط  على السطح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2131" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5820">
    <skos:prefLabel xml:lang="en">offset policy (emissions trading)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Policy whereby emissions from a proposed new or modified stationary source are balanced by reductions from existing sources to stabilise total emissions.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique de compensation (commerce des permis d'émissions)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política compensatoria (negociación de emisiones)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Offset Policy</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beleid waarbij men wordt verplicht overschrijdingen van uitstootmaxima elde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика зачета уровней выбросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политика, при которой выбросы из предполагаемого к строительству или реконструированного источника уравновешиваются снижением выбросов из других существующих источников в целях сохранения общего приемлемого уровня выбросов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة التعويض (تبادل الانبعاثات)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5823">
    <skos:prefLabel xml:lang="en">offshore mining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Oil extraction from platforms situated a short distance from the coast.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction en mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">minería marina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Offshore Abbbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mijnbouw,gas- en oliewinning op zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шельфовое бурение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нефть, добываемая на платформах, расположенных в море недалеко от берега.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعدين في البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5824">
    <skos:prefLabel xml:lang="en">offshore oil drilling</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of extracting petroleum from deposits underlying the floor of the ocean or some other large body of water.
(Source: ENC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction pétrolière en mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sondeo petrolífero submarino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Offshore-Erdölbohrung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olieboringen op zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шельфовое бурение нефтяных скважин</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс добычи нефтепродуктов из месторождений, расположенных на дне океана или другого крупного водоема.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج النفط من البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12488" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5825">
    <skos:prefLabel xml:lang="en">off-site</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Activities taking place or located away from the site.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hors site</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuera de lugar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Off-Site</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elders</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вне площадки или объекта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действия, происходящие или сосредоточенные на расстоянии от конкретной площадки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خارج الموقع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14848" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/14980" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5827">
    <skos:prefLabel xml:lang="en">oil binding agent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Highly absorbent agents used for physically removing spilled oil in case of leakages and oil accidents occurring in water bodies, industry, work-shops, on roads, etc. Materials that have been found useful for this service vary from simple, naturally occurring materials such as straw, sawdust, and peat to synthetic agents, such as polyurethane foam and polystyrene powder.
(Source: FUNKE /  PZ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agglutinant du pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agente astringente de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölbindemittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oliebindende stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтесвязующее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества с высокими адсорбирующими свойствами, использующиеся для физического удаления разлитой нефти в случаях утечки нефти на производстве, в цехе, на дорогах, а также при авариях нефтяных танкеров в водоемах. Материалы, которые подходят для таких операций, варьируются от очень простых, как, например, солома, опилки, торф, до синтетических, как, например, пена полиуретана и порошкообразный полистирол.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل لاصق بترولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5829">
    <skos:prefLabel xml:lang="en">oil-based energy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Energy produced using oil as fuel.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">énergie à base de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">energía basada en el petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energie auf Ölbasis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">op olie gebaseerde energie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство энергии, базирующееся на переработке нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Энергия, производство которой основано на использовании нефти в качестве топлива.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طاقة معتمدة على النفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1777" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3510" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5830">
    <skos:prefLabel xml:lang="en">oil boom</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A floating device used to contain oil on a body of water. Once the boom has been inflated, it is towed downwind of the oil slick and formed into a U-shape; under the influence of wind, the oil becomes trapped within the boom. Skimming equipment travels into the boom enclosure and the oil is pumped into containers.
(Source: EPAGLO /  GILP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">barrière de confinement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">'boom' del petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölsperre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">periode van hoogconjunctuur in de olie-industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">боновое заграждение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Плавающее устройство, используемое для удерживания нефти на поверхности водоема. Заграждение, после того как оно надуто, размещается вокруг нефтяного пятна с подветренной стороны в форме буквы U. Под действием ветра нефть скапливается внутри заграждения. Специальное нефтесборное судно направляется внутрь заграждения, снимает нефть с поверхности воды и перекачивает ее в контейнеры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عوامة احتواء النفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6841" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5831" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5831">
    <skos:prefLabel xml:lang="en">oil disaster</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The disaster caused by the dumping and accidental spillage of oil into waterways from ships and land-based or offshore installations. Oil pollution may destroy or damage aquatic life and wildlife such as birds, contaminate water supplies and create fire hazards.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">désastre pétrolier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">catástrofe petrolera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölunfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aardolieramp</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">авария, связанная с разливом нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бедствие, вызванное сбросом в воду или непреднамеренным разливом нефти судами,  установками, расположенными на берегах или на платформах в море. Разлив нефти может уничтожить или нанести сильный ущерб водным формам жизни и дикой природе, к примеру, птицам, загрязнить запасы воды, привести к пожарам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كارثة نفطية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4052" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5830" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5837" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5839" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5852" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/194">
    <skos:prefLabel xml:lang="en">agricultural effluent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any solid, liquid or gas that enters the environment as a by-product of agricultural activities.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effluent agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efluente agricola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Abwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwafval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственные стоки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое твердое, жидкое или газообразное вещество, которое попадает в окружающую среду в качестве побочного продукта сельскохозяйственной деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدفقات زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2571" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13260">
    <skos:prefLabel xml:lang="en">financial management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The management of acquisitions and the use of long- and short-term capital by a business.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion financière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión financiera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Finanzgebaren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">financieel beheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление финансами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление покупкой ценных бумаг, использования долгосрочного и краткосрочного капитала в предпринимательской деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإدارة المالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3196" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9389" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5834">
    <skos:prefLabel xml:lang="en">oil extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Recovery of oil by surface mining, as in tar sands or oil shales, or from tunnels in a shallow reservoir.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdölförderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aardoliewinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Извлечение нефти из подземных недр через расположенные на поверхности земли скважины, из нефтяных сланцев, битуминозных песков и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج النفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3087" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5833" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5836" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6161" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12488" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5835">
    <skos:prefLabel xml:lang="en">oil and fat industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry for the production and processing of edible oils and fats.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie des huiles et graisses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de aceites y grasas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öle- und Fetteindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olie- en vettenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство пищевого масла и жиров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Промышленное производство и переработка пищевых масел и жиров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الزيوت والدهون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3368" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5836">
    <skos:prefLabel xml:lang="en">oil pipeline</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A line of pipe connected to valves and other control devices, for conducting oil.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oléoduc</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oleoducto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölfernleitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oliepijpleiding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтепровод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Труба, соединенная с клапанами и другими регулирующими устройствами, для перекачки нефти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنبوب زيت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6270" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5834" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5837">
    <skos:prefLabel xml:lang="en">oil pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Contamination of any ecosystem, but usually of freshwater or marine ecosystems, by oil or other petroleum products.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marée noire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölverschmutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olievervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтяное загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение экосистемы, обычно пресноводного или морского бассейна, нефтью и другими нефтепродуктами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث بالنفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5852" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8000" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5827" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5831" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5838">
    <skos:prefLabel xml:lang="en">oil pollution abatement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">There are various systems for the abatement of oil pollution at sea: the "Load-on-top" system involves passing the washing from tank cleaning operations and residue from discharge of the original ballast water to an empty cargo tank nominated as the "slop" tank. Fresh oil cargo is loaded on top of the final residue left after further discharges of water, the resulting mixture being acceptable to refineries despite some additional cost in removing the salt and water. Under the International Convention for the Prevention of Pollution from Ships, 1973, all oil-carrying ships will be required to be capable of operating with this method of retention, or alternatively to discharge to reception facilities. Another method consists in spraying on the oil dispersives and/or blasting straw and sawdust, functioning as "blotting paper", onto water, beaches, rocks and docks. The Vikoma System for the containment of oil spills at sea, developed by British Petroleum, a seaboom of about 500 metres in length, is inflated and towed downwind of the oil slick and formed into a U-shape; under the influence of wind, the oil becomes trapped within the boom. Skimming equipment travels into the boom enclosure and the oil is pumped into containers.
(Source: GILP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réduction de la pollution par le pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disminución de contaminación de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölpestbekämpfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vermindering van olievervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уменьшение нефтяного загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Существует несколько методов снижения нефтяного загрязнения в море. Один из них предполагает слив воды после промыва контейнера, а также остатка водяного  балласта в специальный контейнер. Свежая порция нефти загружается поверх материалов, оставшихся после дальнейшей откачки воды. Качество образовавшегося продукта вполне удовлетворяет нефтеперерабатывающие заводы,. несмотря на дополнительные затраты в связи с удалением соли и воды. В соответствии с Международной Конвенцией по предотвращению загрязнения моря судами от 1973 г. все нефтеперевозочные суда должны использовать либо такой метод, либо иметь возможность слить все остатки нефтепродуктов в специальные принимающие контейнеры. Другой метод связан с нанесением на поверхность нефти диспергирующих веществ самостоятельно или одновременно с такими материалами, как древесные опилки или солома, которые выступают в качестве "промокательной бумаги", удаляя нефть с поверхности воды, побережья, камней  и пр. Английская компания "Бритиш петролеум" разработала систему бонового заграждения "Викома", контролирующего пятно разлившейся нефти. Это заграждение около 500 м длиной после того, как оно надуто, размещается вокруг нефтяного пятна с подветренной стороны в форме буквы U. Под действием ветра нефть скапливается внутри заграждения. Специальное нефтесборное судно направляется внутрь заграждения, снимает нефть с поверхности воды и  перекачивает ее в контейнеры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقليص التلوث بالنفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6446" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5839">
    <skos:prefLabel xml:lang="en">oil recovery vessel</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Boats used for recovering oil spilled at sea from oil tankers. The recommended procedure is to contain and physically recover the spill with or without the use of adsorbents. This approach entails three processes: a) confinement of the spill by spill booms; b) recovery of the spill by sorbing agents; c) physical removal of the contained oil by oil pick-up devices.
(Source: JBFENV /  PZ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">navire dépollueur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nave de recuperación de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölauffangschiff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(olie)opruimingsschip</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтесборное судно</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Суда, используемые для сбора нефти, пролитой нефтяными танкерами. В соответствии с рекомендуемой процедурой желательно задержать разлившееся пятно и собрать нефть с применением адсорбентов или без них. Эту работу можно проделать в несколько этапов: a) задержать распространение пятна с помощью бонового заграждения, b) зафиксировать пятно, применив адсорбирующие реагенты, c) физически удалить нефть специальным нефтесборным оборудованием.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سفينة تطهير البقع النفطية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7654" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5831" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5840">
    <skos:prefLabel xml:lang="en">oil refinery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">System of process units used to convert crude petroleum into fuels, lubricants, and other petroleum-derived products.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">raffinerie de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">refinería de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölraffinerie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olieraffinaderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтеперерабатывающий завод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система технологических объектов, перерабатывающих сырую нефть в топливо, смазочные масла и другие производные нефти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معمل تكرير نفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7035" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6164" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5841">
    <skos:prefLabel xml:lang="en">oil refining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The separation of petroleum mixtures into their component parts.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">raffinage de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">refinado de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdölraffination</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olieraffinage</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтепереработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разделение нефтяных смесей на компоненты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكرير النفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12605" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5843">
    <skos:prefLabel xml:lang="en">oil residue recuperation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The recovery of oil that is leftover or left behind, usually following the primary containment operations for an oil spill.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">récupération des résidus de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recuperación de residuos de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölrückstandswiederaufarbeitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">terugwinning van olieresten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рекуперация нефтяных остатков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Утилизация остатков нефти, как правило, после проведения первоначальных операций по сдерживанию нефтяного разлива.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استعادة بقايا البترول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4990">
    <skos:prefLabel xml:lang="en">management plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A program of action designed to reach a given set of objectives.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan de gestion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planes de gestión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beheersplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план управления</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Программа действий, направленных на достижение поставленных целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة إدارة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/740">
    <skos:prefLabel xml:lang="en">bathing water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">All waters, inland or coastal, except those intended for therapeutic purposes or used in swimming pools, an area either in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de baignade</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas de baño</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Badegewässer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwemwater (algemeen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водоемы для купания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Все воды, внутренние и прибрежные, кроме предназначенных для терапевтических целей или использующихся в качестве плавательных бассейнов, в которых открыто разрешено купание, либо не запрещено и длительное время практикуется большим количеством купальщиков. Такая вода должна соответствовать определенным стандартам качества по ряду химических, микробиологических и физических показателей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء الاستحمام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6291" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12151" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12166" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5847">
    <skos:prefLabel xml:lang="en">oil shale</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A kerogen-bearing, finely laminated brown or black sedimentary rock that will yield liquid or gaseous hydrocarbons on distillation.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">schiste bitumineux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pizarra bituminosa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölschiefer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olie in kleilagen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтяной сланец</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Керогенсодержащая, мелкослоистая черная или коричневая осадочная порода, из которой при дистилляции можно получить жидкие или газообразные углеводороды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نضيد قارِي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5264" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5848">
    <skos:prefLabel xml:lang="en">oil slick</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The mass of oil that floats on a surface of water, which is discharged accidentally, naturally or by design, and can be moved by currents, tides and the wind.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nappe de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">masa flotante de petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölteppich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drijvende olielaag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтяная пленка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Гладкий участок на поверхности воды, образовавшийся в результате присутствия нефти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طبقة نفطية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/30" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9202" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9267">
    <skos:prefLabel xml:lang="en">weapon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An instrument of attack or defense in combat, as a gun, missile, or sword.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arma</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Waffe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wapen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оружие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство защиты или нападения во время боя, например, автомат, ракета или холодное оружие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلاح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/880" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1343" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5750" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/556" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5852">
    <skos:prefLabel xml:lang="en">oil spill</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The accidental release of oil, or other petroleum products usually into freshwater or marine ecosystems, and usually in large quantities. It can be controlled by chemical dispersion, combustion, mechanical containment, and absorption.
(Source: RRDA /  LANDYa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déversement de pétrole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marea negra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ölunfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olielozing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разлив нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Непреднамеренный выброс нефти или других нефтепродуктов, как правило, в пресноводные или морские экосистемы и, как правило, в значительном количестве. Разлив можно устранить с помощью химической дисперсии, сжигания, механического задержания и абсорбции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تسرب بترولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5837" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5831" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5854">
    <skos:prefLabel xml:lang="en">oil tanker</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A very large ship which carries crude oil or other petroleum products in big tanks.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pétrolier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">buques petroleros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öltanker</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olietanker</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтяной танкер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупное судно, перевозящее сырую нефть или другие нефтепродукты в больших контейнерах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ناقلة نفط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8285" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5856">
    <skos:prefLabel xml:lang="en">old landfill site</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Landfill that has been filled and covered with topsoil and seeded. The most common end use for landfills is open spaces with no active recreation taking place over the completed landfill. The obvious reason for this use is that the completed surface is steeply sloped to provide rapid runoff. Also, no irrigation of the cover grasses should be allowed. It is very unlikely to think that commercial or industrial buildings will be constructed on a completed landfill. If the end use is such that the public will be walking on the site, it is important that all manholes be properly secured, leachate lagoons fenced, and other potential hazards eliminated.
(Source: CORBITa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dépôt ancien</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertedero antiguo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altablagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oude afzetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заброшенная мусорная яма</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заполненная мусорная яма, которую засыпали землей и засадили сверху травой. Чаще всего на поверхности таких мусорных ям не предусмотрено строительство каких-либо объектов для отдыха или развлечений. Это объясняется тем, что поверхность засыпанных ям делается сильно покатой, чтобы обеспечить быстрый сток поверхностных вод. Маловероятно, что над засыпанной мусорной ямой будет реализовано строительство коммерческих или промышленных сооружений. В случае, если в конечном итоге предполагается, что по поверхности засыпанной ямы все-таки будут передвигаться люди, необходимо, чтобы все сточные люки были закрыты, стоки для отвода образующейся в яме жидкости надежно ограждены и были устранены другие потенциальные риски.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موقع طمر قديم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5857">
    <skos:prefLabel xml:lang="en">polluted site</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any place that has been made unclean or unsafe by the discharge of high concentrations of hazardous or detrimental substances into its water, soil or atmosphere.
(Source: DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">site pollué</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sitio contaminado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verunreinigter Standort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verontreinigde plaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязненный участок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок, ставший грязным или опасным вследствие выброса большого количества опасных или вредных веществ в его почву, воду или воздух.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موقع ملوَّث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4666" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/547" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7880" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5858">
    <skos:prefLabel xml:lang="en">antiquated plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Old installation that do not respond to new rules for the prevention of environmental pollution and whose redevelopment requires investments for adopting technologies related to the protection of waterways, waste management, noise reduction and emission control.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">installation ancienne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planta anticuada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oude installatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">завод с устаревшим оборудованием</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устаревшее заводское оборудование, не соответствующее экологическим нормам, усовершенствование которого требует инвестиций для внедрения технологий, связанных с защитой водоемов, утилизацией отходов, снижением шума, контролем за выбросами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منشأة قديمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4242" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5862">
    <skos:prefLabel xml:lang="en">olfactory pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollution produced by gaseous emissions in the atmosphere that, even in very small amounts, may cause injuries or a condition of general unease or sickness to persons living in the vicinity.
(Source: FLGISA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution olfactive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación olfativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geruchsbelastung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geurvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение, воздействующее на органы обоняния</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение, вызванное газообразными выбросами в атмосферу, которые даже в небольших количествах способны привести к ущербу здоровью, общему недомоганию или болезни лиц, живущих в непосредственной близости.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث شمِّي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5863">
    <skos:prefLabel xml:lang="en">olfactometry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The testing and measurement of the sensitivity of the sense of smell.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">olfactométrie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">olfatometría</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Olfaktometrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olfactometrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ольфактометрия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Испытание и измерение чувствительности обоняния.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قياس حساسية الشم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4574" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2343">
    <skos:prefLabel xml:lang="en">drinking water supply</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The provision and storage of potable water, or the amount of potable water stored, for the use of a municipality, or other potable water user.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">approvisionnement en eau potable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suministro de agua potable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trinkwasserversorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drinkwatervoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обеспечение питьевой водой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подача и хранение питьевой воды, а также количество запасов питьевой воды для нужд города или другого потребителя питьевой воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توفير مياه الشرب- الإمداد بمياه الشرب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5869">
    <skos:prefLabel xml:lang="en">onchocerciasis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Infection with the filaria Onchocerca volvulus; results in skin tumours, papular dermatitis, and ocular complications.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">onchocercose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oncocercosis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Onchozerkiasis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onchocerciasis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">онхоцеркоз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заболевание, вызванное филярным микробом Onchocerca volvulus; приводит к образованию кожных опухолей, узелкового дерматита, а также глазным заболеваниям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأنكوسركية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9426" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5870">
    <skos:prefLabel xml:lang="en">oncology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the causes, development, characteristics, and treatment of tumors.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oncologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oncología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Onkologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oncologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">онкология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение причин, развития, свойств и лечения опухолей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الأورام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13236">
    <skos:prefLabel xml:lang="en">degradation of the environment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process by which the environment is progressively contaminated, overexploited and destroyed.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dégradation de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">degradación del medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltzerstörung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verval van het milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вырождение окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого окружающая среда загрязняется, чрезмерно эксплуатируется и разрушается в возрастающей прогрессии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدهور البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2566" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2522" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3488" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7857" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12013" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5958" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5874">
    <skos:prefLabel xml:lang="en">opencast mining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Extracting metal ores and minerals that lie near the surface by removing the overlying material and breaking and loading the ore.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploitation à ciel ouvert</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación a cielo abierto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tagebau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dagbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">открытые горные разработки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Добыча металлической руды и других минералов, находящихся близко от поверхности земли, путем удаления верхнего слоя почвы, вскрывания породы и извлечения руды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعدين المكشوف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5875">
    <skos:prefLabel xml:lang="en">open sea fishing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fishing in the deepest parts of the sea.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pêche en haute mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pesca en alta mar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hochseefischerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeevisserij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рыбная ловля в открытом море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рыбная ловля в районах моря с наибольшей глубиной.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصيد في عرض البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5035" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5877">
    <skos:prefLabel xml:lang="en">operating data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Data referring to the practical carrying-out of a process.
(Source: ZINZANa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">données d'exploitation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">datos de funcionamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Betriebsdaten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">besturingsgegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">операционные данные или информация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Данные, относящиеся к практической реализации текущего процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيانات تشغيل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5880">
    <skos:prefLabel xml:lang="en">opinion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Judgement or belief not founded on certainty or proof.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">opinion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">opinión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meinung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка или представление, основанное на уверенности или доказательстве.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رأي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7793" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5734" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6790" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6804" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11522" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13333" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13268">
    <skos:prefLabel xml:lang="en">criminal liability</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">responsabilité pénale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">responsabilidad criminal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strafrechtliche Verantwortlichkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">strafrechtelijke aansprakelijkheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уголовная ответственность</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">المسؤولية الجنائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1862" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5885">
    <skos:prefLabel xml:lang="en">installation optimisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Adjustments made to a building or to a mechanical or electrical system or apparatus in order to maximize its functionality and efficiency.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">optimisation des installations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">optimización de instalaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anlagenoptimierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">optimalisering van installaties</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оптимизация установок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Корректировка конструкции, механической или электрической системы, прибора для достижения их максимального функционального и производительного уровня.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحسن المنشأة بقدر الإمكان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4040" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7185" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7295">
    <skos:prefLabel xml:lang="en">road traffic engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discipline which includes the design of highways and pedestrian ways, the study and application of traffic statistics, and the environmental aspects of the transportation of goods and people.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">génie de la circulation routière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería del tráfico de carreteras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Straßenverkehrstechnik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wegverkeerstechnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">организация дорожного движения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Научная дисциплина, включающая проектирование автострад и пешеходных дорог, изучение и применение статистических данных в области дорожного движения, экологические аспекты перевозки пассажиров и грузов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هندسة الحركة المرورية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8589" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12381">
    <skos:prefLabel xml:lang="en">special industrial waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discarded material produced in any industrial process for which there is no specified mode of disposal.
(Source: INW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet industriel spécial</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuos industriales especiales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sonderindustrieabfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bijzonder industrieel afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нестандартно утилизируемые промышленные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы промышленного процесса, для которых не установлен режим их утилизации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات صناعية خاصة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4273" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9169">
    <skos:prefLabel xml:lang="en">water extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pumping of water for different purposes (i.e. agriculture, land reclamation, domestic and industrial use, etc.).
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserentnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wateronttrekking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водозабор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Откачивание воды из источника для различных нужд, например, сельскохозяйственных, мелиоративных, промышленных, бытовых и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3087" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3781" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5890">
    <skos:prefLabel xml:lang="en">organ</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fully differentiated structural and functional unit, such as a kidney or a root, in an animal or plant.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organe</skos:prefLabel>
    <skos:prefLabel xml:lang="es">órgano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organ</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">orgaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">орган</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Полностью дифференцированная структурно и функционально часть организма, например, почка у животного или корень у растения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عضو</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/406" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6300" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7716" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10539">
    <skos:prefLabel xml:lang="en">animal population</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of animals inhabiting a given area.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">population animale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">población animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierbestand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenpopulatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">популяция животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа животных, обитающих на конкретной территории.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعداد الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6519" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5892">
    <skos:prefLabel xml:lang="en">organic carbon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Carbon which comes from an animal or plant. 

(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">carbone organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carbono orgánico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organischer Kohlenstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organisch gebonden koolstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органический углерод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Углерод, источником которого является растение или животное.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كربون عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2259" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11779" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5893">
    <skos:prefLabel xml:lang="en">organic chemistry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of chemistry dealing with the study of composition, reaction, properties, etc. of organic compounds.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chimie organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">química orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Chemie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische scheikunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органическая химия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль химии, изучающая строение, реакции, свойства и т.д. органических соединений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كيمياء عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1348" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5897">
    <skos:prefLabel xml:lang="en">organic farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Farming without the use of industrially made fertilizers or pesticides.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agriculture biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agricultura biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologischer Landbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische landbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">применение в сельскохозяйственной деятельности только органических удобрений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ведение сельского хозяйства без применения удобрений или пестицидов промышленного изготовления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13271">
    <skos:prefLabel xml:lang="en">family law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Branch of specialty of law, also denominated "domestic relations" law, concerned with such subjects as adoption, annulment, divorce, separation, paternity, custody, support and child care.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit de la famille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho de familia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Familienrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">familierecht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">семейное право</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль права, регулирующая такие вопросы, как усыновление, аннулирование, развод, сепарация (проживание супругов в раздельных домах без оформления развода), опека, права отца или матери, содержание и забота о детях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون الأسرة (الأحوال الشخصية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5902">
    <skos:prefLabel xml:lang="en">organic pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A plant- or animal-produced pollutant containing mainly carbon, hydrogen and oxygen.
(Source: ERG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes orgánicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organischer Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische vervuilende stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органическое загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество животного или растительного происхождения, содержащее в основном углерод, кислород и водород.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوث عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1318" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3822" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14849" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11644" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5080">
    <skos:prefLabel xml:lang="en">mass recreation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pastime, diversion, exercise or other means of enjoyment and relaxation that is shared with or performed by a large number of people.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loisir de masse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actividades recreativas multitudinarias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Massenerholung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">massavrijetijdsbesteding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">массовый отдых</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Развлечение, занятия спортом и другие способы получать удовольствие и расслабляться, которыми большое количество людей занимаются совместно.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترفيه جماعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4767" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7007" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14098">
    <skos:prefLabel xml:lang="en">sorting at source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The classification and separation of solid waste, according to type, at the location where it is generated.
(Source: EEN / FFD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tri sélectif à la source</skos:prefLabel>
    <skos:prefLabel xml:lang="es">separación en origen</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfalltrennung durch den Verursacher</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gescheiden ophaling aan de bron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сортировка мусора в местах его образования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Классификация и отделение твердых отходов по типу в месте их образования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفرز في المنبع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9116" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5910">
    <skos:prefLabel xml:lang="en">organic solvent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Organic materials, including diluents and thinners, which are liquids at standard conditions and which are used as dissolvers, viscosity reducers, or cleaning agents.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">solvant organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disolventes orgánicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organisches Lösungsmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organisch oplosmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органический растворитель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Органические,  при стандартных условиях жидкие материалы, которые используются в качестве растворителей, веществ, снижающих вязкость, а также чистящих средств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مذيب عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7925" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13273">
    <skos:prefLabel xml:lang="en">regulation of agricultural production</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A body of rules or orders prescribed by government, management or an international organization or treaty pertaining to the cultivation of land, raising crops, or feeding, breeding and raising livestock.
(Source: BLD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réglementation de la production agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">regulación de la producción agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lenkung der Agrarproduktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorschriften voor de landbouwproductie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">регулирование сельскохозяйственного производства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свод правил или приказов, установленных государством, руководством компании, международной организацией или условиями международного соглашения, относящихся к возделыванию земли, выращиванию сельскохозяйственных культур, кормлению, выращиванию или разведению скота.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيم الإنتاج الزراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11514" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5912">
    <skos:prefLabel xml:lang="en">organic substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical compounds, based on carbon chains or rings and also containing hydrogen with or without oxygen, nitrogen, or other elements.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">substancias orgánicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Stoffe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische stoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органическое вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химические соединения, основанные на углеродных цепочках или кольцах, содержащие также водород вместе с кислородом, азотом и др. элементами или без них.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/311" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/326" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/560" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1931" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3937" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4091" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5892" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5924" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5927" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5928" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5929" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5936" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6499" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4834">
    <skos:prefLabel xml:lang="en">liner material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A layer of synthetic or natural materials, on the sides of or beneath a landfill, landfill cell or surface impoundment, that restricts the downward or lateral escape of liquids carrying leachate into the surrounding environment.
(Source: ERG / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">revêtement d'étanchéité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material de trazador de líneas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dichtungsbahn</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bekledingsmateriaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидроизоляционный материал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Слой синтетического или природного материала, расположенного по стенкам или на дне ямы, углубления, препятствующий просачиванию вниз или вбок жидкости, содержащей загрязняющие вещества, и попаданию ее в окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة مبطنة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5914">
    <skos:prefLabel xml:lang="en">organism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An individual constituted to carry out all life functions.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organismos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organismen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organismen (taxonomie)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">организм</skos:prefLabel>
