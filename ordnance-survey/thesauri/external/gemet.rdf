    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14910">
    <skos:prefLabel xml:lang="en">image registration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of linking map coordinates to control points with known earth-surface coordinates. Related term: coordinate systems.
(Source: FORUMT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">enregistrement d'images</skos:prefLabel>
    <skos:prefLabel xml:lang="es">registro de imagen</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildüberlagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beeldopslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">регистрация изображений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс соединения координат на карте с контрольными точками известных координат земной поверхности. Родственный термин: "системы координат".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تسجيل الصورة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14924" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4080">
    <skos:prefLabel xml:lang="en">hybridisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of producing hybrids that is an animal or plant resulting from a cross between genetically unlike individuals. Hybrids between different species are usually sterile.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hybridation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hibridación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hybridisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kruising</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гибридизация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс производства гибридов животных или растений в результате скрещивания генетически разных особей. Гибриды между разными видами, как правило, бесплодны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تهجين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7120" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6298" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12273">
    <skos:prefLabel xml:lang="en">rain water sewer system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Channels for clearing away rain water.

(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système de canalisation des eaux de pluie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de alcantarillado de aguas pluviales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Regenwasserkanalisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvoerstelsel voor regenwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система для стока дождевой воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Каналы для удаления дождевой воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام تصريف مياه الأمطار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4082">
    <skos:prefLabel xml:lang="en">hydraulic construction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any structure built to route the flow of water, or to support the weight and pressure of a body of water.
(Source: ENC / LIV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">construction hydraulique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">construcciones hidráulicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbouwkundig bouwwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидравлическая конструкция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая конструкция, сооруженная с целью направлять поток воды, поддерживать вес или давление водоема.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منشأة مائية - منشأة هيدروليكية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9165" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/517" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1955" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2393" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6274" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8766" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12275">
    <skos:prefLabel xml:lang="en">separate sewer system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sewer system having distinct pipes for collecting superficial water and sewage water.
(Source: FLGISA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau de canalisation indépendant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de alcantarilla separado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trennkanalisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gescheiden rioolstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">раздельная сточная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сточная система, в которой канализационные стоки собираются через одни трубы, а поверхностные - через другие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام تصريف مستقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12276">
    <skos:prefLabel xml:lang="en">combined sewer system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sewer intended to serve as a sanitary sewer and a storm sewer, or as an industrial sewer and a storm sewer.
(Source: JJK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau de canalisation combiné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de desagüe colectivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mischkanalisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gecombineerd rioolsysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">комбинированная сточная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сточная система, предназначенная служить для удаления канализационных и дождевых стоков либо для промышленных и дождевых стоков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام تصريف مشترك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12277">
    <skos:prefLabel xml:lang="en">water aeration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Addition of air to sewage or water so as to raise its dissolved oxygen level.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aération de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aireación de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserbelüftung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbeluchting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэрация воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Добавление воздуха к стокам или воде для повышения уровня растворенного кислорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تهوية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/132" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9246" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12278">
    <skos:prefLabel xml:lang="en">individual wastewater treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of using a natural system or mechanical device to collect, treat and discharge or reclaim wastewater from an individual dwelling without the use of community-wide sewers or a centralised treatment facility.
(Source: DWT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">assainissement autonome</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento individual de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Einzelabwasserbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">individuele afvalwaterverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">индивидуальная система очистки стоков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование природной или механической системы для сбора, обработки, сброса или вторичного использования сточных вод, образованных в отдельном жилом доме без использования коммунальной канализационной или водоочистительной системы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة مستقلة للمياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12279">
    <skos:prefLabel xml:lang="en">sedimentation basin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A basin in which suspended matter is removed either by quiescent settlement or by continuous flow at high velocity and extended retention time to allow deposition.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bassin de décantation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cuenca de sedimentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sedimentationsbecken</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afzettingsbekken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">седиментационный бассейн</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бассейн, в котором взвешенные материалы удаляются из жидкости в процессе медленного оседания либо постоянного потока на большой скорости и длительного периода задержания, позволяющего взвесям осесть.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حوض ترسيب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12280">
    <skos:prefLabel xml:lang="en">trickling filter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system of secondary sewage treatment which is similar to self-purification action of streams; it is more accurately a biological oxidizing bed; the effluent is placed on the stones in the bed and microorganisms present consume the solids as a food supply.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biofiltre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biofiltro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biofilter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biofilter</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биофильтр</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система вторичной переработки стоков, основанная на принципах естественной очистки рек; более точным является использование термина "биологический окисляющий слой"; стоки наносятся поверх камней в таком слое, и присутствующие в биофильтре микроорганизмы перерабатывают твердые материалы в ходе их потребления в качестве источника питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرشح تقطيري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3184" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4091">
    <skos:prefLabel xml:lang="en">hydrocarbon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A very large group of chemical compounds composed only of carbon and hydrogen.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrocarbure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrocarburos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kohlenwasserstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">koolwaterstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">углеводород</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Большая группа химических соединений, состоящих только из углерода и водорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيدروكربون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/322" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6493" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12284">
    <skos:prefLabel xml:lang="en">urban wastewater</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The liquid wastes deriving from domestic, commercial and industrial activities of an urban settlement.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau usée urbaine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas residuales urbanas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Städtisches Abwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stedelijk afvalwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городские жидкие отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкие отходы, образовавшиеся в результате бытовой, коммерческой или промышленной деятельности в городе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه مستهلكة حضرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12285">
    <skos:prefLabel xml:lang="en">waste treatment effluent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Partially or completely treated water or waste water flowing out of a waste treatment plant.
(Source: DEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effluent issu du traitement de déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efluente de tratamiento de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbehandlungsabwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingseffluent</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жидкие отходы после обработки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Частично или полностью обработанная вода или стоки, сбрасываемые заводом по переработке сточных вод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فائض معالجة المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2571" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4094">
    <skos:prefLabel xml:lang="en">hydrochloric acid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A solution of hydrogen chloride gas in water; a poisonous, pungent liquid forming a constant-boiling mixture at 20% concentration in water; widely used as a reagent, in organic synthesis, in acidizing oil wells, ore reduction, food processing, and metal cleaning and pickling. Also known as muriatic acid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acide chlorhydrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acido clorhídrico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzsäure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoutzuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соляная кислота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Раствор газообразного хлорида водорода в воде; ядовитая жидкость с резким запахом, образующая постоянно кипящую жидкость при 20%-ной концентрации в воде; широко используется в качестве реагента, в органическом синтезе, при окислительных процессах в нефтяных скважинах, выделении металла из руды, переработке продуктов питания, очистке и травлении металлов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمض الهيدروكلوريك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/52" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4095">
    <skos:prefLabel xml:lang="en">hydroculture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Growing plants without soil but in sand or vermiculite or other granular material, using a liquid solution of nutrients to feed them.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture hors sol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agricultura de riego</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrokultur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrocultuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрокультура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выращивание растений не в почве, а в песке, вермикулите или другом гранулированном материале, используя жидкие растворы питательных веществ для подкормки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الزراعة بدون تربة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12289">
    <skos:prefLabel xml:lang="en">lagooning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process in which sunlight, bacterial action and oxygen cause self-purification in waste water, Usually taking place in a shallow pond, or system of such ponds.
(Source: TOEa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lagunage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estancamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlammteichverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bezinking van afvalwater in een bekken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система прудов для очистки сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого под действием солнечного света, действия бактерий и кислорода происходит самоочищение сточной воды. Обычно происходит в мелких прудах или системе таких прудов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التطهير الذاتي للبحيرات الضحلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4098">
    <skos:prefLabel xml:lang="en">hydroelectric power plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Power station which operates with the free renewable source of energy provided by falling water.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">centrale hydroélectrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">central hidroeléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserkraftwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterkrachtcentrale</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидроэлектростанция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Электростанция, работающая на бесплатном возобновляемом источнике энергии падающей воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة طاقة هيدروليكية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2606" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2735" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12293">
    <skos:prefLabel xml:lang="en">water regeneration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process in which naturally occurring microorganisms, plants, trees or geophysical processes break down, degrade or filter out hazardous substances or pollutants from a body of water, cleansing and treating contaminated water without human intervention.
(Source: OSW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">régénération d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">regeneración de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserregenerierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterregeneratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">регенерация воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого естественно присутствующие микроорганизмы, растения, деревья или геофизические процессы разрушают, разлагают или фильтруют вредные или загрязняющие вещества в водоеме, очищая и обрабатывая воду без участия человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجدد المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9246" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4103">
    <skos:prefLabel xml:lang="en">hydrogen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A flammable colourless gas that is the lightest and most abundant element in the universe. It occurs mainly in water and in most organic compounds and is used in the production of ammonia and other chemicals, in the hydrogenation of fats and oils, and in welding.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrogène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrógeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водород</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Горючий, бесцветный газ, самый легкий и самый распространенный из всех элементов во вселенной. В основном встречается в составе воды и большинстве органических соединений; используется для производства аммиака и других химикатов, в гидрогенировании жиров и масел, а также при сварке.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيدروجين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2636" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8680" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4107">
    <skos:prefLabel xml:lang="en">hydrogen sulphide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Flammable, poisonous gas with characteristic odour of rotten eggs, perceptible in air in a dilution of 0.002 mg/l. It is used as a reagent in chemical analysis; extremely hazardous; collapse, coma and death from respiratory failure may come within a few seconds after one or two inspirations; low concentrations produce irritation of conjunctiva and mucous membranes. Headache, dizziness, nausea, lassitude may appear after exposure.
(Source: MGH /  INDMER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sulfure d'hydrogène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acido sulfhídrico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwefelwasserstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwavelwaterstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сероводород</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Горючий, ядовитый газ с характерным запахом тухлых яиц, ощутим в воздухе при концентрации 0,002 мг/л. Используется в качестве реагента при химическом анализе; исключительно опасен; коллапс, кома и смерть от удушья могут наступить от нескольких вдохов паров этого газа. Низкая концентрация вызывает раздражение слизистых оболочек глаз и носа. Результатом воздействия этого газа могут стать головные боли, тошнота, головокружение и вялость.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كبريتيد الهيدروجين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8192" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4108">
    <skos:prefLabel xml:lang="en">hydrogeology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science dealing with the occurrence of surface and ground water, its utilization, and its functions in modifying the earth, primarily by erosion and deposition.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrogéologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrogeología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrogeologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrogeologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрогеология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая образование поверхностных и подземных вод, их использование и функции в изменении земной поверхности, особенно в процессах эрозии и осаждения пород.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهيدروجيولوجيا - جيولوجيا المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3650" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4109">
    <skos:prefLabel xml:lang="en">hydrography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Science which deals with the measurement and description of the physical features of the oceans, lakes, rivers, and their adjoining coastal areas, with particular reference to their control and utilization.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая измерение и описание физических характеристик океанов, озер, рек и  прилегающих к ним прибрежных территорий, с особым акцентом на контроль за их состоянием и использование.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهيدروجرافيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3646" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10240">
    <skos:prefLabel xml:lang="en">site rehabilitation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The restoration of the ecological quality of an area or location.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">restauration de site</skos:prefLabel>
    <skos:prefLabel xml:lang="es">rehabilitación de sitio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flächensanierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plaatsherstel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">восстановление окружающей среды конкретного района</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Восстановление качества окружающей среды конкретного района или местности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعادة تأهيل الموقع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7091" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/685">
    <skos:prefLabel xml:lang="en">aviation law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">International rules regulating air transportation.
(Source: NDGIUR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi fédérale de l'aviation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación relativa al tráfico aéreo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Luftfahrtrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">luchtvaartwetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">правила воздушных перевозок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Международные правила, регулирующие воздушные перевозки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون الطيران</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/285" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/282" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4115">
    <skos:prefLabel xml:lang="en">hydrologic balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An accounting of the inflow to, outflow from, and storage in a hydrologic unit such as a drainage basin, aquifer, soil zone, lake or reservoir; the relationship between evaporation, precipitation, runoff, and the change in water storage.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bilan hydrologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio hidrológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserbilanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbalans</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрологический баланс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Учет притока, оттока и запаса в гидрологической единице, например, водосборная площадь, водоносный пласт, участок почвы, озеро или водохранилище; взаимосвязь между испарением, осадками, оттоком и изменениями в запасах воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الموازنة الهيدرولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2227" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4291" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7340" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7566" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4116">
    <skos:prefLabel xml:lang="en">hydrologic cycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The movement of water between the oceans, ground surface and atmosphere by evaporation, precipitation and the activity of living organisms, as one of the mayor biogeochemical cycles. Each day water evaporates from the oceans and is carried in the air from the sea over the land, which receives it as precipitation, and finally returns from the land to the sea through rivers, thus completing the cycle.
(Source: ALLa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cycle de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclo hidrológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserkreislauf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterkringloop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрологический цикл</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение воды между океанами, сушей и атмосферой в результате испарения, выпадения осадков и активности живых организмов, один из главных биохимических циклов в природе. Ежедневно вода испаряется из океанов, возносится в атмосферу над поверхностью суши, куда она выпадает в виде осадков, которые в конечном итоге попадают с суши обратно в океан через реки, завершая таким образом цикл.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الدورة الهيدرولوجية - دورة المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4124" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3298" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4115" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4922" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5791" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5967" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7502" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7513" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9172" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9190" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9262" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4118">
    <skos:prefLabel xml:lang="en">hydrology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science that treats the occurrence, circulation, distribution, and properties of the waters of the earth, and their reaction with the environment.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая образование, циркуляцию, распределение и свойства вод на земле, их взаимодействие с окружающей средой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهيدرولوجيا - علم المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9231" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4119">
    <skos:prefLabel xml:lang="en">hydrolysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Decomposition or alteration of a chemical substance by water. 
2) In aqueous solutions of electrolytes, the reactions of cations with water to produce a weak base or of anions to produce a weak acid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrolisis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидролиз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Разложение или изменение химического вещества под действием воды. 2) В водяных растворах электролитов реакция катионов с водой с образованием слабого основания или анионов с образованием слабой кислоты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التميؤ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4120">
    <skos:prefLabel xml:lang="en">hydrometeorology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That part of meteorology of direct concern to hydrologic problems, particularly to flood control, hydroelectric power, irrigation, and similar fields of engineering and water resource.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrométéorologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrometeorología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrometeorologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrometeorologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидрометеорология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль метеорологии, напрямую занимающаяся гидрологическими проблемами, особенно вопросами контроля за паводком, производства гидроэлектроэнергии, ирригации и др.технических отраслей и областей водного хозяйства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقياس كثافة السوائل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5197" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2052">
    <skos:prefLabel xml:lang="en">delta</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A delta is a vast, fan-shaped creation of land, or low-lying plain, formed from successive layers of sediment washed from uplands to the mouth of some rivers, such as the Nile, the Mississippi and the Ganges. The nutrient-rich sediment is deposited by rivers at the point where, or before which, the river flows into the sea. Deltas are formed when rivers supply and deposit sediments more quickly that they can be removed by waves of ocean currents. The importance of deltas was first discovered by prehistoric man, who was attracted to them because of their abundant animal and plant life. Connecting waterways through the deltas later provided natural routes for navigation and trade, and opened up access to the interior. Deltas are highly fertile and often highly populated areas. They would be under serious threat of flooding from any sea-level rise.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">delta</skos:prefLabel>
    <skos:prefLabel xml:lang="es">delta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Delta</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">delta</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дельта реки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дельта представляет собой широкий, веерообразный участок земли или низкой равнины, образованный в результате последовательных отложений грунта, принесенного водами реки из ее верховья к устью. Примерами могут служить реки Нил, Миссисипи и Ганг. Отложения, богатые питательными веществами, аккумулируются в месте впадения реки в море или чуть выше по течению. Дельта образуется в тех случаях, когда воды моря или океана не успевают смыть осадок, принесенный речными водами. Важность дельт была оценена еще доисторическим человеком, которого эти участки земли привлекли обилием растений и животных. Позднее соединяющие водные пути способствовали развитию торговли и навигации, а также открыли путь к освоению внутренних территорий. Земли дельт исключительно плодородны и, как правило, густо заселены. Любое серьезное повышение уровня моря ставит эти участки земной поверхности под угрозу затопления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دلتا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4122">
    <skos:prefLabel xml:lang="en">water power</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Energy obtained from natural or artificial waterfalls, either directly by turning a water wheel or turbine, or indirectly by generating electricity in a dynamo driven by a turbine.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">énergie hydraulique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">energía hídrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserkraft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterkracht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергия воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Энергия, получаемая из природных или искусственных водопадов напрямую, путем вращения водяного колеса, или косвенно, в процессе генерации электричества в динамо-машине, вращаемой турбиной.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الطاقة المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1777" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11967" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4124">
    <skos:prefLabel xml:lang="en">hydrosphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The waters of the Earth, as distinguished from the rocks (lithosphere), living things (biosphere), and the air (atmosphere). Includes the waters of the ocean; rivers, lakes, and other bodies of surface water in liquid form on the continents; snow, ice, and glaciers; and liquid water, ice, and water vapour in both the unsaturated and saturated zones below the land surface. Included by some, but excluded by others, is water in the atmosphere , which includes water vapour, clouds, and all forms of precipitation while still in the atmosphere.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hydrosphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидросфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воды Земли в отличие от горных пород (литосферы), живых организмов (биосферы) и воздуха (атмосферы). Включает воды всех океанов, рек, озер и других единиц поверхностной воды на суше;  снега, лед и ледники; воду, лед и водяные пары как в насыщенных, так и в ненасыщенных зонах под землей. Некоторые ученые включают также в это понятие воду в атмосфере, в т.ч. водяные пары, облака и все виды находящихся в атмосфере осадков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المحيط المائي - الغلاف المائي للأرض</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4594" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7495" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9151" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9161" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12248" />
