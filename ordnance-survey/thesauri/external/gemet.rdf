    <skos:prefLabel xml:lang="nl">gasnetwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">газопроводная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система взаимосвязанных труб для распределения и подачи газа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبكة غاز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3591" />
