  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4132">
    <skos:prefLabel xml:lang="en">iceberg</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large mass of detached land ice floating in the sea or stranded in shallow water.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">iceberg</skos:prefLabel>
    <skos:prefLabel xml:lang="es">icebergs</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisberg</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijsberg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">айсберг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Большая масса льда, оторвавшаяся от берега, дрейфующая в море или неподвижно расположенная на мелководье.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جبل جليد (طافي)</skos:prefLabel>
