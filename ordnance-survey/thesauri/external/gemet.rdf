  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11639">
    <skos:prefLabel xml:lang="en">bacteriological pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Contamination of water, soil and air with pathogen bacteria.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution bactériologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación bacteriológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bakteriologische Verunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bacteriologische verontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бактериологическое загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заражение воды, почвы или воздуха патогенными бактериями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث بكتيري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11675" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4300">
    <skos:prefLabel xml:lang="en">inflow</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Water other than wastewater that enters a sewer system (including sewer service connections) from sources such as, but not limited to, roof leaders, cellars drains, yard drains, area drains, drains from springs and swampy areas, manhole covers, cross connections between storm sewers and sanitary sewers, catch basins, cooling towers, storm waters, surface runoff, street wash waters, or drainage. Inflow does not include, and is distinguished from, infiltration. 
2) Action of flowing in; an inflow of effluent into a river.
(Source: JJK /  PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">affluent</skos:prefLabel>
    <skos:prefLabel xml:lang="es">afluencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zufluss</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">instroom</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">приток воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Вода, кроме отработанной, которая попадает в сточную или канализационную систему (включая канализационные коллекторы) из таких источников (но не ограничиваясь ими), как водостоки на крышах, подвальные дренажные системы, дренажные системы во дворах и на отдельных заболоченных участках, колодцы, водосборы, канализация, охлаждающие башни, поверхностные стоки, вода с улиц или дренаж и пр. Данный вид воды не включает инфильтрат и противопоставляется ему. 2) Процесс притока, например, приток жидкого загрязняющего вещества в реку.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدفق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3311" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4301">
    <skos:prefLabel xml:lang="en">informal negotiation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">négociation informelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">negociación informal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informales Verwaltungshandeln</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informeel overleg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неформальные переговоры</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مفاوضات غير رسمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6373" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4302">
    <skos:prefLabel xml:lang="en">informatics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Science and technique of data elaboration and of automatic treatment of information.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">informatique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">informática</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informatik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информатика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука и техника производства данных и автоматической обработки информации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المعلوماتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7472" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1974" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1979" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1988" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2196" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2850" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7842" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13316" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4303">
    <skos:prefLabel xml:lang="en">information</skos:prefLabel>
    <skos:scopeNote xml:lang="en">All facts, ideas or imaginative works of the mind which have been communicated, published or distributed formally or informally in any format, or the knowledge that is  communicated or received.
(Source: CCL / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Information</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Акт информирования или состояние информирования. Знания, полученные в результате учебы, практического опыта или инструктирования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المعلومات</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1605" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2284" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2851" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4302" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4307" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4311" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6801" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7477" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8380" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13053" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13060" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14856" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14857" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14862" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14879" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14881" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14883" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14896" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2871">
    <skos:prefLabel xml:lang="en">environmentally friendly product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Product that is not harmful to the environment.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit propre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto respetuoso del medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltfreundliches Produkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuvriendelijk product</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологически чистый продукт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продукт, не наносящий ущерба окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتج صديق للبيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6724" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4307">
    <skos:prefLabel xml:lang="en">information processing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A systematic series of actions performed by a person or computer on data elements including classifying, sorting, calculating, summarizing, transmitting, retrieving and receiving.
(Source: JON)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de la información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationsverarbeitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatieverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обработка информации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Систематизированная последовательность действий, выполняемая лицом или компьютером, с элементами данных, включая классификацию, сортировку, расчеты, обобщение, передачу, извлечение и получение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشغيل المعلومات - معالجة المعلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5167" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1986" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4309">
    <skos:prefLabel xml:lang="en">information service</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An organized system of providing assistance or aid to individuals who are seeking information, such as by using databases and other information sources to communicate or supply knowledge or factual data.
(Source: RHW / OMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">service d'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">servicio de información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationsdienst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatiedienst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационная услуга</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организованная система оказания помощи и содействия отдельным лицам, которым требуется конкретная информация, например, посредством использования баз данных и других информационных источников, передающих знания или фактические данные.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خدمة معلوماتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1605" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4310">
    <skos:prefLabel xml:lang="en">information source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Generally, any resource initiating and substantiating the reception of knowledge or specifically, the origin of a data transmission.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source d'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuentes de información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationsquelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatiebron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">источник информации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Как правило, любой ресурс, инициирующий или поддерживающий получение знаний или источник происхождения передаваемых данных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر معلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1605" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14892" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4311">
    <skos:prefLabel xml:lang="en">information system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any coordinated assemblage of persons, devices and institutions used for communicating or exchanging knowledge or data, such as by simple verbal communication, or by completely computerized methods of storing, searching and retrieving information.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système d'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistemas de información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatiesysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любые средства передачи знаний, например, простой передачей голосом или с помощью полностью компьютеризированных методов хранения, поиска и получения информации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام معلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2853" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3645" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13312" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13314" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14878" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14880" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14882" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14893" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4313">
    <skos:prefLabel xml:lang="en">information technology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The systems, equipment, components and software required to ensure the retrieval, processing and storage of information in all centres of human activity (home, office, factory, etc.), the application of which generally requires the use of electronics or similar technology.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technologie de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tecnología de la información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationstechnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatietechnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационная технология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Системы, оборудование, компоненты и программные средства, необходимые для обеспечения получения, переработки и хранения информации в центрах человеческой деятельности (в быту, в офисе, на заводе и пр.), использование которых обычно требует применения электроники и сходных технологий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكنولوجيا المعلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8339" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14869" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/14896" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4315">
    <skos:prefLabel xml:lang="en">infraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A breach, violation, or infringement; as of a law, a contract, a right or duty.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">infraction</skos:prefLabel>
    <skos:prefLabel xml:lang="es">infracciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strafbare Handlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overtreding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нарушение (юридич.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нарушение положений закона, условий контракта, прав или обязанностей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انتهاك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11540" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4317">
    <skos:prefLabel xml:lang="en">infrared radiation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Electron magnetic radiation whose wavelengths lie in the range from 0.75 or 0.8 micrometer to 1000 micrometers.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rayonnement infrarouge</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radiación infrarroja</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Infrarotstrahlen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">infraroodstraling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инфракрасное излучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Электронное магнитное излучение, длина волн которого находится в пределах от 0,75 или 0,8 микрометров до 1000 микрометров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأشعة تحت الحمراء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5674" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10176">
    <skos:prefLabel xml:lang="en">relief (land)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The physical shape, configuration or general unevenness of a part of the Earth's surface, considered with reference to variation of height and slope or to irregularities of the land surface; the elevation or difference in elevation, considered collectively, of a land surface.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relief</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relieve (tierra)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Relief</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reliëf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рельеф земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Физическая форма, конфигурация или общая неровность участка земной поверхности, рассматриваемые в зависимости от изменения высоты, наклона или неровностей поверхности земли; возвышение или рассматриваемая совокупно разность в высотах участка земной поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تضاريس (الأرض)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5405" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12511">
    <skos:prefLabel xml:lang="en">aggregate extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Extraction of crushed rock or gravel screened to sizes for use in road surfaces, concretes, or bituminous mixes.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction de granulat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción granulada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesamtentnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aggregaatonttrekking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча щебня и других наполнителей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Добыча щебня или гравия определенных фракций для дорожного покрытия, использования в составе бетонных или битумных смесей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج الكُتَل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3087" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4320">
    <skos:prefLabel xml:lang="en">infrasound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Vibrations of the air at frequencies too low to be perceived as sound by the human ear, below about 15 hertz.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">infrason</skos:prefLabel>
    <skos:prefLabel xml:lang="es">infrasonido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Infraschall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">infrageluid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инфразвук</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вибрация воздуха на частоте настолько низкой, что невозможно ее восприятие человеческим слухом, обычно ниже 15 герц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الموجات تحت الصوتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7933" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4321">
    <skos:prefLabel xml:lang="en">infrastructure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The basic network or foundation of capital facilities or community investments which are necessary to support economic and community activities.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">infrastructure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">infraestructuras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Infrastruktur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">infrastructuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инфраструктура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Базовая система, основные объекты, инвестиции сообщества, необходимые для поддержания деятельности экономики и сообщества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البنية الأساسية - البنية التحتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1063" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1061" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2722" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3586" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3871" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6270" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7641" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8014" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8525" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9165" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10847" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10851" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14418" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12514">
    <skos:prefLabel xml:lang="en">mechanical industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of enterprises is engaged in the design, manufacture and marketing of mechanical apparatuses for commercial or industrial usage.
(Source: SIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie mécanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria mecánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Maschinenbauindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werktuigbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство механических приборов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сектор экономики, предприятия которого осуществляют проектирование, изготовление и продажу механических приборов для промышленного или коммерческого использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة ميكانيكية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4952" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4323">
    <skos:prefLabel xml:lang="en">inhabitant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A person occupying a region, town, house, country, etc.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">habitant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">habitantes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewohner</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bewoner</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">житель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лицо, проживающее в регионе, городе, доме, стране и т.д.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ساكن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7622" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4325">
    <skos:prefLabel xml:lang="en">injury</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A stress upon an organism that disrupts the structure or function and results in a pathological process.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">blessure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lesión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verletzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">letsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">повреждение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стресс, которому подвергается организм, нарушающий его структуру или функции, в результате которого образуется патологический процесс.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جرح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4326">
    <skos:prefLabel xml:lang="en">ink</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A dispersion of a pigment or a solution of a dye in a carrier vehicle, yielding a fluid, paste, or powder to be applied to and dried on a substrate; writing, marking, drawing, and printing inks are applied by several methods to paper, metal, plastic, wood, glass, fabric, or other substrate.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">encre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tintas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Druckfarbe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inkt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">чернила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дисперсия пигмента или раствора красителя в контейнере, испускающего жидкую, пастообразную или порошкообразную массу, которую наносят на какую-либо поверхность для последующего высыхания; разные виды чернил и красок для письма, маркировки, рисования и печати наносятся различными методами на бумагу, металл, пластмассу, дерево, стекло, ткань и др. виды поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حبر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8913">
    <skos:prefLabel xml:lang="en">vegetable oil</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An edible, mixed glyceride oil derived from plants (fruit, leaves, and seeds), including cottonseed, linseed, tung, and peanut; used in food oils, shortenings, soaps, and medicine, and as a paint drying oil.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">huile végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aceites vegetales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenöl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantaardige olie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растительное масло</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Съедобная масляная смесь, получаемая из растений (плодов, листьев или семян), включающих хлопковое семя, льняное семя, тунг, арахис; используется в приготовлении пищевых масел, мыла, медикаментов, а также красок.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زيت نباتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4329">
    <skos:prefLabel xml:lang="en">inland fishery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fishing grounds located in lakes, streams, etc.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pêche en eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pesca continental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Binnenfischerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">binnenvisserij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рыбная ловля на внутренних водоемах</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Места для рыбной ловли в озерах, ручьях и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصيد في المناطق الداخلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3237" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11540">
    <skos:prefLabel xml:lang="en">crime</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any act done in violation of those duties which an individual owes to the community, and for the breach of which the law has provided that the offender shall make satisfaction to the public.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">crime</skos:prefLabel>
    <skos:prefLabel xml:lang="es">delitos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verbrechen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">misdaad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">преступление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие, совершенное вразрез с обязательствами, которые несет физическое лицо перед обществом и за которое закон предусматривает возмещение нарушителем ущерба обществу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جريمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11583" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2797" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2881" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4315" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6737" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14967" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4331">
    <skos:prefLabel xml:lang="en">inland navigation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The navigation of inland waterways, i.e. navigable rivers, canals, sounds, lakes, inlets, etc.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">navigation fluviale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">navegación interior</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Binnenschiffahrt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">binnenvaart</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">навигация по внутренним водным путям</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Навигация по внутренним водным  путям, т.е. судоходным рекам, каналам, озерам и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الملاحة الداخلية - الإبحار الداخلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4333">
    <skos:prefLabel xml:lang="en">inland water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A lake, river, or other body of water wholly within the boundaries of a state.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eaux intérieures</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas continentales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Binnengewässer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">binnenwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внутренние водоемы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Озеро, река или другой водоем, полностью находящийся в пределах границ одного государства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المياه الداخلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12528">
    <skos:prefLabel xml:lang="en">packing industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie de l'emballage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de embalaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verpackungsindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verpakkingsindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оборудование и материалы для упаковки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة التغليف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8598">
    <skos:prefLabel xml:lang="en">traffic on water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The movement of boats and other vessels over any water route or area.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic fluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico en agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verkehr zu Wasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">движение на воде</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение катеров и других судов по воде или водному маршруту.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المرور المائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1888" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11289" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14615" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3834" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9245" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9254" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4340">
    <skos:prefLabel xml:lang="en">innovation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Something newly introduced, such as a new method or device.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">innovation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">innovación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Innovation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vernieuwing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инновация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нововведение, например, новый метод или новое устройство.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجديد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3050" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14894" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4342">
    <skos:prefLabel xml:lang="en">inorganic chemistry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of chemistry dealing with the chemical reactions and properties of all inorganic matter.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chimie minérale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">química inorgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anorganische Chemie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anorganische chemie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неорганическая химия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль химии, занимающаяся химическими реакциями и свойствами неорганических веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الكيمياء غير العضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1348" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4345">
    <skos:prefLabel xml:lang="en">inorganic fertiliser</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Inorganic chemical which promotes plant growth by enhancing the supply of essential nutrients such as ammonium sulphate or lime.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">engrais inorganique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fertilizante inorgánico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mineraldünger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anorganische meststof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неорганическое удобрение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неорганический химикат, содействующий росту растений путем обеспечения снабжения важными питательными веществами, к примеру, сульфат аммония или известь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سماد غير عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1307" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11209" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11211" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11212" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4347">
    <skos:prefLabel xml:lang="en">inorganic pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pollutant of mineral origin and not of basically carbon structure.
(Source: ERG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant inorganique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes inorgánicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anorganischer Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anorganische vervuiler</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неорганическое загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество минеральной природы и необязательно имеющее в своей структуре углерод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوث غير عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1318" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4350">
    <skos:prefLabel xml:lang="en">inorganic substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical compounds that do not contain carbon as the principal element (excepting carbonates, cyanides, and cyanates), that is, matter other than plant or animal.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance inorganique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustencias inorgánicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anorganische Substanzen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anorganische stoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неорганическое вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химические соединения, которые не содержат углерод в качестве основного элемента (кроме карбонатов, цианидов и цианатов), т.е. вещество, а не растение или животное.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادةغير عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/375" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/379" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1168" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1173" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1366" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1933" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4094" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4724" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5178" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5593" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5601" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5613" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6189" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8190" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8192" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8203" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8204" />
