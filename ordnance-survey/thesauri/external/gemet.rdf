    <skos:prefLabel xml:lang="en">music</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The artistic organization of sounds or tones that expresses ideas and emotions through the elements of rhythm, melody, harmony and tonal color.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">musique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">música</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Musik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">muziek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">музыка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Искусство организации различных тоновых уровней для построения звуковой последовательности, призванной вызвать эстетическую реакцию у слушателя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موسيقى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1912" />
