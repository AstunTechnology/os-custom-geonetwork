    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7366">
    <skos:prefLabel xml:lang="en">safety rule</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A principle or regulation governing actions, procedures or devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment.
(Source: OED / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">règle de sécurité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">regla de seguridad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sicherheitsvorschrift</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veiligheidsvoorschrift</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">правило безопасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Принцип или руководство, направляющие действия по снижению вероятности  ущерба, вреда или опасности отдельным лицам, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاعدة أمان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7362" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7367" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11433" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7367">
    <skos:prefLabel xml:lang="en">safety standard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A norm or measure applicable in legal cases for any action, procedure or contrivance designed to lower the occurrence or risk of injury, loss and danger to persons, property or the environment.
(Source: BLD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">norme de sécurité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normas de seguridad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sicherheitsstandard</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veiligheidsnorm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандарт безопасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Норма или мера, применимые в судебных делах в отношении любого действия, процедуры или приспособления, предназначенные для снижения вероятности ущерба, вреда или опасности отдельным лицам, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معيار أمان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8047" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7369" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7366" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7369">
    <skos:prefLabel xml:lang="en">safety standard for building</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A collection of rules and regulations adopted by authorities concerning structural and mechanical standards for safety.
(Source: HARRISa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">norme de sécurité des bâtiments</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normas de seguridad para edificios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sicherheitsstandard für Gebäude</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veiligheidsnorm voor de bouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">норма безопасности для здания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Собрание правил, принятых на уровне руководства, касающихся структурных и механических стандартов безопасности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معايير الأمان في المباني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7367" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7370">
    <skos:prefLabel xml:lang="en">safety study</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Research, detailed examination and usually a written report on the need for or efficacy of actions, procedures or devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment.
(Source: OED / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étude de sûreté</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estudio de seguridad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sicherheitsstudie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veiligheidsonderzoek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изучение безопасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение, подробное исследование и обычно письменный доклад о необходимости или эффективности действий, процедур или устройств, предназначенных на снижение вероятности  ущерба, вреда или опасности отдельным лицам, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراسة الأمان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7236" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3283">
    <skos:prefLabel xml:lang="en">rapid test</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Tests performed in the medical field whose results are available very quickly.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">test rapide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prueba rápida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schnelltest</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">snelle proef</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспресс-анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Анализы, проводимые в области медицины, результаты которых бывают готовы очень быстро.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار سريع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8412" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7373">
    <skos:prefLabel xml:lang="en">salamander</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various urodele amphibians, such as Salamandra salamandra of central and S Europe. They are typically terrestrial, have an elongated body, and only return to water to breed.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">salamandre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salamandras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salamander</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">salamanders</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">саламандра</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разнообразные хвостатые амфибии, например, Salamandra salamandra, обитающие в Центральной и Южной Европе. Как правило, сухопутны, обладают удлиненным телом, перемещаются в воду только для выведения потомства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السمندل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/387" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13339">
    <skos:prefLabel xml:lang="en">occupational status</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">statut professionnel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">categoría profesional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beruflicher Status</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beroepsstatus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональный статус</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">البنية المهنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3307">
    <skos:prefLabel xml:lang="en">flora restoration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of returning plant ecosystems and habitats to their original conditions.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">restauration de la flore</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recuperación de la flora</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Florenwiederherstellung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">floraherstel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">восстановление флоры</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс возвращения растительных экосистем и сред обитания к первоначальным условиям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترميم الفلورا - إعادة الفلورا إلى حالتها الأصلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6999" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7384">
    <skos:prefLabel xml:lang="en">salmonella</skos:prefLabel>
    <skos:scopeNote xml:lang="en">General name for a family of microorganisms, one of the largest groups of bacteria, that includes those most frequently implicated in food poisoning and gastroenteritis. Unhygienic handling and inadequate cooking of poultry and meat, improper storage of cold meats and, more recently, contamination of battery-reared hen eggs, are the most common sources of salmonella infections.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">salmonelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salmonela</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salmonellen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">salmonella</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сальмонелла</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общее название для семейства микроорганизмов, одного из самых крупных среди бактерий, которое включает возбудителей пищевых отравлений и гастроэнтерита. Несоблюдение правил гигиены обработки и приготовления мяса и птицы, неправильное хранение охлажденного мяса и заражение инкубаторных яиц являются наиболее распространенными причинами  сальмонеллезных инфекций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سالمونيلا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1561" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7390">
    <skos:prefLabel xml:lang="en">salt content</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Amount of salt contained in a solution.

(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">teneur en sels</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contenido salado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzgehalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoutgehalte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">содержание соли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество соли, содержащееся в растворе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المحتوى من الملح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1673" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12226" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7395" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1082">
    <skos:prefLabel xml:lang="en">bus</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large, long-bodied motor vehicle equipped with seating for passengers, usually operating as part of a scheduled service.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">autobus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autobus</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Omnibus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">autobus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">автобус</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупногабаритный автомобиль с длинным корпусом, оборудованный сиденьями для пассажиров, движение которого осуществляется, как правило, по расписанию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حافلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6821" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7395">
    <skos:prefLabel xml:lang="en">salt load</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">charge en sel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carga salada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzbelastung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoutlading</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение солью</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الحِمل من الملح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6465" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7390" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7396">
    <skos:prefLabel xml:lang="en">salt marsh</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Areas of brackish, shallow water usually found in coastal areas and in deltas. There are also inland marshes in arid areas where the water has a high salt level because of evaporation. They are environmentally delicate areas, extremely vulnerable to pollution by industrial or agricultural chemicals, or to thermal pollution, which often results when river water has been used as the coolant in power stations and industrial plants.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">schorre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pantano salado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzsumpf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoutmoeras</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">солончак</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участки соленого мелководья, обычно расположенные в прибрежных районах или в дельтах рек. В засушливых регионах встречаются также внутренние водоемы, где вода обладает очень высоким содержанием соли в результате выпаривания. Эти районы очень неустойчивы с экологической точки зрения, подвержены воздействию загрязнения промышленными или сельскохозяйственными химикатами, а также термальному загрязнению, являющемуся результатом использования речной воды в качестве охладителя на электростанциях и производствах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستنقع مالح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8252" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7397">
    <skos:prefLabel xml:lang="en">salt meadow</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A meadow subject to overflow by salt water.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pré salé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pradera salina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzwiese</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">met kweldergras begroeide kwelder</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">луг, затопляемый морской водой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Луг, периодически затопляемый соленой водой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مَرج مالح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5110" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7400">
    <skos:prefLabel xml:lang="en">salt plug</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mass of salt which is injected as a diapir (a dome in which the overlying rocks have been ruptured by the squeezing-out of plastic core material) into overlying sedimentary rocks, thereby piercing and deforming them. The mechanism is similar to that of an intrusive magma, with the salt deforming and behaving plastically under pressure. It is of great economic importance because it assists in the formation of a "trap" structure for oil accumulation, in addition to its associated deposits of anhydrite, gypsum and sulphur.
(Source: BJGEO /  WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dôme de sel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tapón salado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzstock</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoutkoepel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соляное ядро</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Масса соли, которая в качестве диапира проникает в лежащие сверху слои осадочных пород, разрывая и деформируя их. Механизм схож с механизмом интрузивной магмы, когда соль под действием давления деформируется и ведет себя как пластмасса. Имеет важное экономическое значение, потому что помогает в формировании "капканной" структуры для накопления нефти, а также потому что связана с месторождениями ангидрита, гипсового камня и серы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سدادة ملحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5264" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7401">
    <skos:prefLabel xml:lang="en">salt</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The reaction product when a metal displaces the hydrogen of an acid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sels</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sales químicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zouten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Результат реакции, в которой металл замещает водород в составе кислоты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1366" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7402">
    <skos:prefLabel xml:lang="en">salt water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water of the seas, distinguished by high salinity.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau salée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua salada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zout water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морская вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воды морей, отличающиеся высоким содержанием соли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه مالحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8229" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1526" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7535" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8478" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7404">
    <skos:prefLabel xml:lang="en">salvage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act, process, or business of rescuing vessels or their cargoes from loss at sea.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">valorisation de terres</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salvamento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bergung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">berging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спасение на море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие, процесс или деятельность по спасению судов и их грузов в море.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إنقاذ (سفينة من الغرق)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6822" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10106" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13340">
    <skos:prefLabel xml:lang="en">termination of employment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or instrument by which the binding force of a contract is terminated, irrespective of whether the contract is carried out to the full extent contemplated or is broken off before complete execution.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">résiliation de contrat de travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cese de empleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beendigung des Arbeitsverhältnisses</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beëindiging van een dienstverband</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">увольнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или инструмент, посредством которых обязательная сила трудового договора прекращается независимо от того, истек срок этого договора или нет.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إنهاء العمل (التوظيف)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7407">
    <skos:prefLabel xml:lang="en">sampling</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The obtaining of small representative quantities of material for the purpose of analysis.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">échantillonnage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">muestro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Probenahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">monstername</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отбор проб</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Получение небольшого репрезентативного количества материала с целью последующего анализа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أخذ عينات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5354" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7410" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7410">
    <skos:prefLabel xml:lang="en">sampling technique</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Method of selecting items at random from a set in such a manner that the sample will be representative of the whole.
(Source: MGHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technique d'échantillonnage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">técnica de muestreo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Probenahmemethode</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">monsternametechniek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод отбора проб</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Метод случайного выбора предметов из целой партии с таким расчетом, что отобранный предмет будет представлять всю партию в целом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقنية أخذ العينات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7407" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7411">
    <skos:prefLabel xml:lang="en">sanction</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">sanction</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sanktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">straf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">санкция</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">عقوبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/95" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/112" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1486" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6102" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7616" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13937" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7413">
    <skos:prefLabel xml:lang="en">sand</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A loose material consisting of small mineral particles, or rock and mineral particles, distinguishable by the naked eye; grains vary from almost spherical to angular, with a diameter range from 1/16 to 2 millimeters.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arenas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">песок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сыпучий материал, состоящий из мелких частиц минерала или породы. различаемых невооруженным глазом; частицы могут быть разнообразной формы - от почти сферической до граненой, с диаметром от 1/16 до 2 мм.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6967" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7423" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8703">
    <skos:prefLabel xml:lang="en">tumour</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any new and abnormal growth, specifically one in which cell multiplication is uncontrolled and progressive.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tumeur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tumor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tumor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tumor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">опухоль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Новое и ненормальное образование, особенно такое, в котором деление клеток не контролируется и прогрессирует.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ورم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7419">
    <skos:prefLabel xml:lang="en">sand dune fixation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Stabilization of dunes effected by the planting of marram grass (Ammophila arenaria), or rice grass, whose long roots bind the surface layers of sand and so hinder its removal by wind. A larger scale method of dealing with the same problem is by afforestation.
(Source: BLYFRE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fixation des dunes de sable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estabilización de dunas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sanddünenstabilisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vastleggen van de duinen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стабилизация песчаных дюн</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стабилизация песчаных дюн в результате высадки травы Ammophila arenaria, или рисовой травы, длинные корни которой скрепляют слои песка и затрудняют перемещение дюны под действием ветра. В крупных масштабах данную проблему решают методами облесения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تثبيت الكثبان الرملية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7420">
    <skos:prefLabel xml:lang="en">sand dune</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An accumulation of loose sand heaped up by the wind, commonly found along low-lying seashores above high-tide level, more rarely on the border of large lakes or river valleys, as well as in various desert regions, where there is abundant dry surface sand during some part of the year.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dune de sable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">duna de arena</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sanddüne</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(zand)duin</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">песчаная дюна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Скопление сыпучего песка в большой холм под действием ветра, обычно образуется вдоль низко расположенных морских побережий выше полосы прилива, реже - вдоль границы крупных озер или речных долин, а также в различных пустынных районах, где имеется в наличии огромное количество свободного песка на поверхности земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كثيب رملي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2377" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7423">
    <skos:prefLabel xml:lang="en">sand extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The extraction of sand by mining for building purposes and for the extraction of heavy minerals such as rutile and zircon.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction de sable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción de arena</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sandabbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zandwinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча песка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Добыча песка в карьерах для строительных целей, а также в ходе добычи тяжелых минералов, таких как рутил или цирконий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج الرمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3087" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7413" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6459">
    <skos:prefLabel xml:lang="en">pollution effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The main pollution effects concern human health and cover all aspects of the physical environment - air, water and land, including the effects of climate change. Human activities which are sources of pollution arise from domestic, commercial, industrial and military sectors and their effects are influenced by various issues, trends and public sector programmes, such as safe water and food, management of waste, increasing use of chemicals in agriculture, and urbanization. Types of pollutants which are negatively impacting health include litter, toxic chemicals, nuclear waste, lead, spoil from mining, food and water contaminants; and the polluting effects of over-population.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet de pollution</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efectos de la contaminación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auswirkung der Verunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gevolgen van milieuverontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">воздействие загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Основные виды воздействия загрязнения касаются состояния здоровья человека и затрагивают все физические аспекты окружающей среды - воздух, воду, землю, включая воздействие от изменения климата. Деятельность человека в быту, в коммерческой, промышленной, военной областях является источником загрязнения. Экологический эффект, производимый этой деятельностью, зависит от решения и реализации различных вопросов, программ, тенденций, например, кампания борьбы за экологически безопасную воду и продукты питания, проблема управления отходами, химизация сельского хозяйства, урбанизация. К загрязняющим веществам, отрицательно воздействующим на здоровье, относятся бытовой мусор, токсичные химикаты, ядерные отходы, свинец, отходы горно-шахтных разработок, а также загрязняющее воздействие урбанизации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أثر التلوث - تأثير التلوث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2562" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1199" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2035" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3007" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13839" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7425">
    <skos:prefLabel xml:lang="en">sand pit</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place where sand is extracted from the ground.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sablière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arenal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sandgrube</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zandgroeve</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">песчаный карьер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где песок добывают из-под земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المَرمَلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12379">
    <skos:prefLabel xml:lang="en">health-care activities waste</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">déchets sanitaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuos de actividades sanitarias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfälle aus dem Gesundheitswesen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afval afkomstig van de gezondheidssector</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходы учреждений здравоохранения</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مخلفات الرعاية الصحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4002" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6179" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/213">
    <skos:prefLabel xml:lang="en">agricultural planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The development of plans and measures to achieve greater and more efficient output from agriculture; a sound agricultural policy should be able to reconcile three basic needs: the production of food and agricultural products, the protection of the environment and the maintenance of the socio-economic structure of rural areas.
(Source: DOBRISa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">planification rurale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwplanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">планирование сельского хозяйства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разработка планов и мер для повышения количественных и качественных показателей сельскохозяйственного производства; разумная сельскохозяйственная политика должна увязывать решение трех основных задач: производство продуктов питания и другой сельскохозяйственной продукции, охрана окружающей среды и поддержание социально-экономической структуры в сельских районах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخطيط زراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11159" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11243" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7436">
    <skos:prefLabel xml:lang="en">sanitary fitting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The set of furnishings designed for personal hygiene and the disposal of organic waste.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équipement sanitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanitarios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sanitäre Einrichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sanitair</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">санитарно-техническое оборудование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Набор устройств, предназначенных для личной гигиены и утилизации органических отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أدوات صحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2290" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7438">
    <skos:prefLabel xml:lang="en">sanitary landfill</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An engineered method of disposing of solid waste on land in a manner that protects the environment, by spreading the waste in thin layers, compacting it to the smallest practical volume and covering it with compacted soil by the end of each working day or at more frequent intervals if necessary.
(Source: CORBIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge contrôlée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">rellenos sanitarios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geordnete Deponie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hygiënisch afgedekte vuilstortplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">свалка с санитарной обработкой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Инженерный метод утилизации твердых отходов, обеспечивающий охрану окружающей среды в результате распределения отходов тонким слоем, утрамбовки до практически осуществимого малого объема и покрытия сверху плотным слоем почвы в конце каждого рабочего дня или еще чаще.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الطمر الصحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7443">
    <skos:prefLabel xml:lang="en">sanitation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study and use of practical measures for the preservation of public health.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">santé publique et assainissement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">saneamiento y salud pública</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hygienisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevordering van de (volks)gezondheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">санитария и санитарные мероприятия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение и практическое применение мер по сохранению здоровья общества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدابير الصحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6798" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7444">
    <skos:prefLabel xml:lang="en">sanitation plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plans for the control of the physical factors in the human environment that can harm development, health, or survival.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'assainissement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planes de saneamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hygieneplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план санитарных мероприятий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Планы по контролю за физическими факторами окружающей человека среды, которые могут нанести ущерб развитию, здоровью или жизни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الخطة الصحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7449">
    <skos:prefLabel xml:lang="en">saprobic index</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Indication or measure of the level of organic pollution.
(Source: ALLa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">index saprobie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">índice sapróbico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Saprobienindex</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gehalte aan rottend organisch materiaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">индекс органического загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Индекс или мера уровня органического загрязнения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مؤشر العفونة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11124" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7450">
    <skos:prefLabel xml:lang="en">saprobe</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Referring to the classification of organisms according to the way in which they tolerate pollution.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">saprobie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">saprobios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Saprobien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">water rijk aan rottend organisch materiaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сапробионты</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Классификация живых организмов в зависимости от способности переносить органически загрязненную среду обитания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عفن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7452">
    <skos:prefLabel xml:lang="en">satellite</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An object that orbits around a larger one. Artificial satellites orbiting the Earth are used for communications, the gathering of military intelligence, the monitoring of weather and other environmental phenomena, etc.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">satellite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">satélite</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Satellit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">satelliet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спутник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объект, вращающийся по орбите другого, более крупного объекта. Искусственные спутники Земли используются для связи, сбора данных для военной разведки, мониторинга погоды и других явлений окружающей среды и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قمر، تابع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7962" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/587" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11706" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/36" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7956" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7457">
    <skos:prefLabel xml:lang="en">saving</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of current income which is not spent for survival or enjoyment.
(Source: MGHME)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">épargne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ahorro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ersparnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">besparing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сбережения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Доходы личных хозяйств и компаний, которые не расходуются ни на приобретение товаров и услуг, ни на немедленное потребление, ни на выплаты государству в виде налогов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ادخار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4187" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7458">
    <skos:prefLabel xml:lang="en">sawdust</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Wood fragments made by a saw in cutting.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sciure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">serrín</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sägemehl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zaagsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">древесные опилки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Частицы древесины, образовавшиеся в ходе ее распиловки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشارة الخشب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12166">
    <skos:prefLabel xml:lang="en">bathing seawater</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sea waters in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de baignade marine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mar de baño</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Badegewässer (Meerwasser)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwemwater (zout)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морская вода, пригодная для купания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Морские воды, в которых открыто разрешено или не запрещено купаться и в которых традиционно купается большое количество людей. Вода в таких районах должна соответствовать определенным качественным стандартам по химическим, микробиологическим и физическим параметрам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء استحمام بحري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2941">
    <skos:prefLabel xml:lang="en">environmental warfare</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The direct manipulation or destruction of ecological resources as either a political threat or for actual military advantage.
(Source: BAS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">guerre mésologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">guerra ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltkriegsführung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuoorlogsvoering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическая война</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прямое изменение или разрушение экологических ресурсов в качестве меры политической угрозы или достижения военного преимущества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحرب البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9028" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6705">
    <skos:prefLabel xml:lang="en">programme</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">programme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">programa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Programm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">programma</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">программа</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">برنامج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2897" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5474" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7592" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8145" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8794" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6287" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7464">
    <skos:prefLabel xml:lang="en">schistosomiasis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A disease in which humans are parasitized by any of three species of blood flukes: Schistosoma mansoni, S. haematobium, and S. japonicum; adult worms inhabit the blood vessels.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">schistosomiase</skos:prefLabel>
    <skos:prefLabel xml:lang="es">esquistosomiasis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schistosomiasis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">infectie met parasitaire zuigwormen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шистосомоз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Болезнь человека, причиной которой являются три вида кровяных трематодных паразитов: Schistosoma mansoni, S. haematobium и S. japonicum; взрослые особи обитают в кровеносных сосудах человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البلهاريسيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9426" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7465">
    <skos:prefLabel xml:lang="en">school</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An institution or building at which children and young people receive education.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">établissement scolaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">escuela</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schule</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">school</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">школа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Учреждение или здание, в котором дети и молодые люди получают образование.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مدرسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2547" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13342">
    <skos:prefLabel xml:lang="en">leave on social grounds</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">congé social</skos:prefLabel>
    <skos:prefLabel xml:lang="es">permiso social</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Urlaub aus sozialen Gründen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verlof om sociale redenen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отпуск по социальным причинам</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">إجازة اجتماعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7470">
    <skos:prefLabel xml:lang="en">school teaching</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Instruction or training received in any educational institution, but especially to persons under college age.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">enseignement scolaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enseñanza escolar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schulunterricht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schoolonderwijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">школьное обучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воспитание и обучение в образовательном учреждении, особенно лиц школьного возраста.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعليم المدرسي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7472">
    <skos:prefLabel xml:lang="en">science</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the physical universe and its contents by means of reproducible observations, measurements, and experiments to establish, verify, or modify general laws to explain its nature and behaviour.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">science</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">наука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение физической вселенной и ее содержания посредством воспроизводимых наблюдений, измерений, экспериментов в целях установления, подтверждения или изменения общих законов, объясняющих ее природу и поведение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عِلم</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/496" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1348" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2922" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3027" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3646" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4302" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4543" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4719" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5093" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5524" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6230" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10019" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13318" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7477">
    <skos:prefLabel xml:lang="en">scientific and technical information</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Knowledge communicated or received pertaining to the systematic study of the physical world or to the mechanical or industrial arts.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">information scientifique et technique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">información científica y técnica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaftliche und technische Information</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappelijke en technische informatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">научная и техническая информация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Переданные или полученные знания, относящиеся к систематическому изучению физического мира, к промышленно-технической сфере.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معلومات علمية وتقنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7478">
    <skos:prefLabel xml:lang="en">scientific co-operation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">coopération scientifique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cooperación científica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaftliche Zusammenarbeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappelijke samenwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">научное сотрудничество</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التعاون العلمي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7480" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7480">
    <skos:prefLabel xml:lang="en">scientific policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A course of action adopted and pursued by government, business or some other organization, which promotes or determines the direction for the systematic study, research and experimentation of a particular aspect of the physical or material world, which may lead to scholarly contributions in a branch of knowledge.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique scientifique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política científica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaftspolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappelijk beleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">научная политика</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">السياسة العلمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7478" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13296" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14900">
    <skos:prefLabel xml:lang="en">pixel</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A contraction of the words 'picture element'. The smallest unit of information in an image or raster map. Referred to as a resolution cell in an image or grid.
(Source: JEFF)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pixel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pixel</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pixel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beeldpunt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пиксел</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин произошел от слияния двух английских слов - "picture element" ("элемент изображения"). Наименьшая единица информации в изображении или растрированной карте. Является единицей разрешения изображения или координатной сетки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيكسل - نقطة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7482">
    <skos:prefLabel xml:lang="en">scoping procedure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The prescribed step or manner of proceeding in an environmental impact assessment, by which a public discussion is held to discuss the information that needs to be developed, the alternatives that need to be considered and other important environmental issues.
(Source: ERG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">procédure de définition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procedimiento de determinación de alcance</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Scoping-Verfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afbakeningsprocedure</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">процедура определения порядка проведения экологической экспертизы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Курс действий, принятый и реализуемый государством, деловой компанией или другой организацией, содействующий или определяющий направление систематического изучения, исследований и экспериментов в конкретной области физического или материального мира, которые могут привести к научному вкладу в данную отрасль знаний.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إجراء تعريف النطاق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2844" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7483">
    <skos:prefLabel xml:lang="en">scrap material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Recyclable material from any manufacturing process or discarded consumer products.
(Source: APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériau de rebut</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material de chatarra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altstoff (Abfall)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schroot</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">скрап</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, пригодный для вторичного использования, полученный в ходе любого обрабатывающего процесса или представляющий собой выброшенный бытовой мусор.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المهملات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2625" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7486" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7489" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8866" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7484" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7484">
    <skos:prefLabel xml:lang="en">scrap material market</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The trade or traffic in discarded or leftover materials that can be reused in some way.
(Source: RHW / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marché des matériaux de rebut</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mercado de materiales de chatarra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altstoffmarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schrootmarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рынок скрапа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Торговля выброшенными материалами или отходами производства, которые могут быть каким-либо образом использованы вторично.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سوق المهملات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5058" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7483" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7485">
    <skos:prefLabel xml:lang="en">scrap material price</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of money or the monetary rate at which materials discarded from manufacturing operations can be bought or sold.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prix des matériaux de rebut</skos:prefLabel>
    <skos:prefLabel xml:lang="es">precio de materiales de chatarra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altstoffpreis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schrootprijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цена на скрап</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сумма или валютный курс, по которому материальные остатки какого-либо обрабатывающего процесса могут быть проданы или куплены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سعر المهملات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6602" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7486">
    <skos:prefLabel xml:lang="en">scrap metal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any metal material discarded from manufacturing operations and usually suitable for reprocessing.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ferraille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fragmento de metal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schrott</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schroot</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">металлолом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Металлический материал, выброшенный в ходе какого-либо обрабатывающего процесса и обычно пригодный для вторичного использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نفايات معدنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7483" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13127" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12382" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14901">
    <skos:prefLabel xml:lang="en">spectral band</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Closely grouped bands of lines characteristic of molecular gases of chemical compounds (spectroscopy).
(Source: DICCHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bande spectrale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cinta espectral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Spektralband</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spectraalband</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спектральная полоса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Близко расположенные спектральные линии, характеризующие молекулярные газы химических компонентов (спектроскопия).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شريط طيفي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
