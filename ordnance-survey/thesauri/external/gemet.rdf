  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2517">
    <skos:prefLabel xml:lang="en">eco-paediatrics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Branch of medical science concerning the study and the therapy of children diseases caused by environmental factors.
(Source: CEDa /  RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écopédiatrie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecopediatría</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökopädiatrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eco-pediatrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экопедиатрия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль медицинской науки, посвященная изучению и лечению детских заболеваний, причинами которых являются экологические факторы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طب الأطفال البيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2518">
    <skos:prefLabel xml:lang="en">ecophysiology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of biophysical, biochemical and physiological processes used by animals to cope with factors of their physical environment, or employed during ecological interactions with other organisms.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écophysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecofisiología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökophysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eco-fysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экофизиология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение биофизических, биохимических и физиологических процессов, с помощью которых животные взаимодействуют с факторами физической среды обитания или используются в экологических взаимосвязях с другими организмами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفيسيولوجيا الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6240" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2519">
    <skos:prefLabel xml:lang="en">ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A community of organisms and their physical environment interacting as an ecological unit.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistemas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сообщество организмов и их физическая среда обитания, взаимодействующая как экологическая единица.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2520">
    <skos:prefLabel xml:lang="en">ecosystem analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Detailed study of an ecosystem carried out to ascertain its features from the point of view of its soil composition, energy flux, biogeochemical cycles, biomass, organisms and their relationship with the environment.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse de l'écosystème</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis de ecosistema</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystemanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecosysteem-analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ экосистем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Детальное изучение экосистемы, проводимое в целях установления ее свойств с точки зрения состава почв, энергетических потоков, биохимических циклов, биомассы, организмов и их взаимосвязей с окружающей средой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل النظام الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2463" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2523" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2522">
    <skos:prefLabel xml:lang="en">ecosystem degradation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Degradation or destruction of large natural environments. When one ecosystem is under attack as a result of natural or man-made disaster it is extremely difficult to calculate the ripple effects throughout nature. When two or more ecosystems are being degraded the probabilities of synergistic destructiveness multiply. Ecosystems in many regions are threatened, despite their biological richness and their promise of material benefits.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dégradation de l'écosystème</skos:prefLabel>
    <skos:prefLabel xml:lang="es">degradación de ecosistemas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystemabbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">achteruitgang van het ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">деградация экосистем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деградация или разрушение природной среды в больших масштабах. В случае, когда экосистема подвергается стрессу в результате природного или антропогенного катаклизма, представляется чрезвычайно сложным просчитать последствия этого для природы. Когда разрушаются две или более экосистемы, то вероятность синергетического разрушительного эффекта возрастает в несколько раз. Во многих районах экосистемы находятся под угрозой, несмотря на свое биологическое разнообразие и материальный потенциал.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدهور النظام الإيكولجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13236" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2523">
    <skos:prefLabel xml:lang="en">ecosystem research</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study of the ways in which plants, animals, and microbes interact with each other and with their physical environment and of the processes involving the circulation, transformation and accumulation of both matter, especially nutrient materials, and energy.
(Source: CULTER /  PARCORa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">recherche sur les écosystèmes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">investigación de ecosistema</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystemforschung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderzoek aan het ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">исследования экосистем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение способов, с которыми растения, животные и микробы взаимодействуют друг с другом и со своей физической средой, а также процессов циркуляции, трансформации и аккумуляции материи, особенно в виде питательных веществ, и энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بحث في النظام الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2918" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2520" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2525">
    <skos:prefLabel xml:lang="en">ecosystem type</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Ecosystems can be classified according to various criteria: from the point of view of energy source, two major types of ecosystems can be distinguished. Autotrophic ecosystems have primary producers as a principal component and sunlight has the major initial energy source; etherotrophic ecosystems depend upon preformed organic matter that is imported from autotrophic ecosystems elsewhere. Ecosystems can also be classified in terrestrial, marine and freshwater.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">type d'écosystème</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tipos de ecosistema</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystemtyp</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">soort ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тип экосистемы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экосистемы можно классифицировать в соответствии с разными критериями: с точки зрения энергетического ресурса можно выделить два основных типа экосистем. В автотрофных системах основной компонент составляют базовые производители питательных веществ, при том что солнечный свет является главным источником энергии; этеротрофные системы зависят от органических веществ, сформированных ранее в автотрофических системах и импортированных из них. Экосистемы могут также классифицироваться как сухопутные, морские или пресноводные.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوعية النظام الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2470" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/505" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4432" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2519" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2531" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2799">
    <skos:prefLabel xml:lang="en">environmental criterion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Standards of physical, chemical or biological (but sometimes including social, aesthetic, etc.) components that define a given quality of an environment.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">critères et données de surveillance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">criterio ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltkriterium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieucriterium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">критерий окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стандарты на физические, химические или биологические (иногда социальные, эстетические и пр.) компоненты, определяющие требуемое качество окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معيار بيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2773" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2775" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2779" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2786" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2913" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3686" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13576" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2527">
    <skos:prefLabel xml:lang="en">ecotourism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Excursions to relatively untouched lands, which for the tourist promise the chance to observe unusual wildlife and indigenous inhabitants. The travel industry, in an attempt to market adventure and authenticity to those travellers weary of "civilisation" promote travel to environments free of modern technology. Ecotourism's inherent contradiction is the promotion of untouched lands, which immediately become touched by the hands of tourism.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écotourisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">turismo ecológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökotourismus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecotoerisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экотуризм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экскурсии в относительно нетронутые цивилизацией территории, которые обещают туристам возможность наблюдать необычные формы дикой природы. Туристические компании, желающие удовлетворить спрос на приключения и первозданную природу у людей, уставших от цивилизации, рекламируют поездки в регионы, где отсутствуют современные технологии. Экотуризм несет в себе противоречие, состоящее в том, что неизведанные территории после посещения их туристами перестают быть таковыми.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السياحة الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8522" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7007" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2528">
    <skos:prefLabel xml:lang="en">ecotoxicity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Quality of some substances or preparations which present or may present immediate or delayed risks for one or more sectors of the environment.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écotoxicité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecotoxicidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökotoxizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieugiftige eigenschappen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экотоксичность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Качество некоторых веществ или препаратов, которое несет или может нести прямую или продолженную во времени угрозу одному или нескольким секторам окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السمية الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8538" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10721">
    <skos:prefLabel xml:lang="en">game (play)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An amusement or pastime; diversion.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">jeu</skos:prefLabel>
    <skos:prefLabel xml:lang="es">juego (juego)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Spiel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">игра</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Забава или времяпрепровождение; развлечение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">لعبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4767" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7007" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2530">
    <skos:prefLabel xml:lang="en">ecotoxicology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science dealing with the adverse effects of chemical, physical agents, and natural products on populations and communities of plants, animals and human beings.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écotoxicologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecotoxicología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökotoxikologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecotoxicologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экотоксикология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая отрицательное воздействие химических веществ, физических факторов, природных продуктов на популяции и сообщества растений, животных и человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم السمية الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8543" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2531">
    <skos:prefLabel xml:lang="en">ecotype</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Species that has special characteristics which allow it to live in a certain habitat.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écotype</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecotipo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökotyp</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecotype</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экотип</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Виды, которые характеризуются определенными чертами, позволяющими им обитать в конкретной среде обитания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النوع الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2438" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2533">
    <skos:prefLabel xml:lang="en">EC policy</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">politique communautaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política comunitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">EU-Politik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">EG-beleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика ЕС</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">سياسة المفوضية الأوروبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1600" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13294" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13295" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10726">
    <skos:prefLabel xml:lang="en">big game</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Large wild animals that weigh typically more than 30 lb when fully grown, hunted for food, sport or profit.
(Source: CORBIT /  AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">grand gibier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gamo grande</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Großwild</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">groot wild</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">крупное животное как объект охоты</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупные дикие животные, весом более 30 фунтов во взрослом состоянии, на которых охотятся для получения продуктов питания, ради спорта или для продажи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طريدة ضخمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3553" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2535">
    <skos:prefLabel xml:lang="en">EC regulation on eco-management and audit</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">règlement (CEE) en matière de management environnemental et d'audit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Reglamento comunitario sobre la gestión ecológica y la auditoría</skos:prefLabel>
    <skos:prefLabel xml:lang="de">EU-Umweltaudit-Verordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">EG-verordening betreffende milieubeheer en</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">постановление ЕС об экоменеджменте и аудите</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تنظيمات المفوضية الأوروبية حول الإدارة البيئية والتدقيق فيها</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2534" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2536">
    <skos:prefLabel xml:lang="en">EC regulation on existing chemicals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Regulation designed to identify and control of risks deriving from existing chemicals. According to this program the main goal is the collection of basic information about existing chemicals including their uses and characteristics, environmental fate and pathways, toxicity and ecotoxicity.
(Source: DOBRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">règlement (CEE) en matière de substances chimiques existantes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Reglamento comunitario sobre sustancias químicas existentes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">EU-Altstoffverordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">EG-verordening inzake bestaande chemicaliën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">постановление ЕС по известным химикатам</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постановление, предназначенное определить и контролировать риски, которые связаны с известными химикатами. Основная задача состоит в том, чтобы собрать базовую информацию о существующих химикатах, их использовании, характеристиках, сроке действия и кругообороте в природе, токсичности, экотоксичности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيمات المفوضية الأوروبية حول المواد الكيماوية الموجودة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2534" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3047" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2539">
    <skos:prefLabel xml:lang="en">edaphology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the relationships between soil and organisms, including the use made of land by mankind.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">édaphologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">edafología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Edaphologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bodemkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">почвоведение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение взаимоотношений между почвой и организмами, включая использование земли человеком.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدافولوجيا - علم التربة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7890" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14856">
    <skos:prefLabel xml:lang="en">information infrastructure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The basic, underlying framework and features of a communications system supporting the exchange of knowledge, including hardware, software and transmission media.
(Source: WIC / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">infrastructure de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">infraestructura de información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationsinfrastruktur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatieinfrastructuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационная инфраструктура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Основополагающая структура и свойства коммуникационной системы, поддерживающие обмен знаниями, включая соответствующее оборудование, программные средства и передающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البنية الأساسية للمعلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4967" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2542">
    <skos:prefLabel xml:lang="en">edible fat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An oil that can be eaten as a food or food accessory.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">graisse alimentaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">grasa comestible</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Speisefett</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eetbare vetten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пищевой жир</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жир, который может быть потреблен в качестве продукта питания или вместе с продуктами питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الدهون الغذائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3181">
    <skos:prefLabel xml:lang="en">filling material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any substance used to fill the holes and irregularities in planed or sanded surfaces so as to decrease the porosity of the surface for finish coatings.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériau de remplissage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material de terraplenado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Füllmaterial</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vulmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">наполнитель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, используемое для заполнение углублений и неровностей на строганных или шлифованных поверхностях в целях уменьшения пористости поверхности для отделки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة الحشو</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2547">
    <skos:prefLabel xml:lang="en">education</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of imparting or acquiring knowledge or skills.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éducation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">educación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderwijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс передачи и получения знаний.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعليم</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2175" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8607" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8785" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7465" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8608" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/903">
    <skos:prefLabel xml:lang="en">biotope protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures taken to ensure that the biological and physical components of a biotope are in equilibrium by maintaining constant their relative numbers and features.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection de biotope</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de los biotopos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotopschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biotoopbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита биотопов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, предпринимаемые для обеспечения равновесия между биологическими и физическими компонентами в результате поддержания постоянными их относительной численности и характерных свойств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية الموطن الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10032" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/901" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8541">
    <skos:prefLabel xml:lang="en">toxicological assessment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of characterizing and evaluating the inherent toxicity of a chemical substance, a poison, etc.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation toxicologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación toxicológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Toxikologische Bewertung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">giftigheidsboordeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">токсикологическая оценка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс описания и оценки природных токсичных свойств химического вещества, яда и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم السُمِّية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2529" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8538" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2551">
    <skos:prefLabel xml:lang="en">educational institution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An organization or establishment devoted to the act or process of imparting or acquiring knowledge or skills.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">établissement d'enseignement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">instituciones educativas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildungsanstalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderwijsinstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">образовательное учреждение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организация или учреждение, предназначенное для участия в процессе передачи и получения знаний.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مؤسسة تعليمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10744">
    <skos:prefLabel xml:lang="en">shellfish farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Raising of shellfish in inland waters, estuaries or coastal waters, for commercial purposes. All commercial shellfish beds producing bivalve molluscs must be monitored for microbial contamination. Samples of water and shellfish flesh must be tested for the presence of algal toxins. Periodic monitoring of fish and shellfish must be carried out to check for the presence of contaminants.
(Source: WRIGHTa /  MAFF)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">conchyliculture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">criadero de mariscos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Muschelkultur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schaal- en schelpdierencultuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение моллюсков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение моллюсков во внутренних водах, эстуариях и прибрежных водах в коммерчески целях. Все заводи, где двустворчатые моллюски разводятся в коммерческих масштабах, должны проверяться на заражение микробами. Берутся периодические пробы воды, проверяются отдельные моллюски, а также рыбы для установления наличия в них токсинов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تربية الصدفيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/501" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2554">
    <skos:prefLabel xml:lang="en">educational planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of making arrangements or preparations to facilitate the training, instruction or study that leads to the acquisition of skills or knowledge, or the development of reasoning and judgment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">planification de l'enseignement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación educativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildungsplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderwijsplanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">планирование в области образования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс подготовки, способствующий обучению, инструктированию, подготовке кадров, ведущий к приобретению знаний, навыков, развитию логических и мыслительных способностей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخطيط التعليم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6287" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2555">
    <skos:prefLabel xml:lang="en">education policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A course of action adopted and pursued by government or some other organization, which promotes or determines the goals, methods and programs to be used for training, instruction or study that leads to the acquisition of skills or knowledge, or the development of reasoning and judgment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique en matière d'éducation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política educativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildungspolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderwijsbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика в области образования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Курс, принятый государством в отношении процесса систематического обучения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة التعليم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2557">
    <skos:prefLabel xml:lang="en">educational system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any formulated, regular or special organization of instruction, training or knowledge disclosure, especially the institutional structures supporting that endeavor.
(Source: ISEP /  OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système éducatif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema educativo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildungswesen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderwijssysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система образования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сформулированная, постоянно действующая и специальная организационная структура, осуществляющая обучение, подготовку или передачу знаний, особенно институциональные образования, ее поддерживающие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام التعليم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2175" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10753">
    <skos:prefLabel xml:lang="en">oyster farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">There are two types of oyster farming: suspension culture, in which oysters are grown off bottom, in floating trays, is a labor-intensive form of cultivation that requires continuous tending and cleaning of both gear and shellfish, and bottom culture, which is similar to conventional crop farming on land; it involves selecting areas of the sea floor that provide a natural food supply, necessary currents, minimum exposure to predators, and proper temperature and then "seeding" the bottom with shellfish stock that are left to grow to market size. Then they are harvested with a bottom drag from a boat. Both suspension culture and bottom culture depend on natural food supplies for growing the shellfish being raised.
(Source: MSTF)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ostréiculture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ostricultura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Austernzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oestercultuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение устриц</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Существует два метода разведения устриц. Первый предполагает выращивание устриц на плавающих поддонах, что является трудоемким процессом, требующим постоянного контроля и очистки как оборудования, так и самих устриц. Второй предполагает разведение устриц на морском дне, что похоже на разведение сельскохозяйственных культур на суше: выбираются участки дна, обеспечивающие достаточное количество питания, учитываются течения, минимальное влияние хищников, необходимая температура; после этого морское дно "засевается" молодыми устрицами, которые растут на нем, достигая необходимых продажных кондиций. Затем происходит сбор устриц специальным тралом с борта судна. Оба применяемых метода зависят от наличия достаточного количества питательных веществ, необходимых для роста устриц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تربية المحار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5450" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2562">
    <skos:prefLabel xml:lang="en">effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Effects include: a) direct effects, which are caused by the action and occur at the same time and place, b) indirect effects, which are caused by the action and are later in time or farther removed in distance, that are still reasonably foreseeable.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efectos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">effecten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эффект (воздействие)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Эффект, воздействие включают: а) прямой эффект, вызванный действием и проявляющийся одновременно и в том же месте, b) косвенный эффект, который вызывается конкретным действием, но отдален во времени или пространстве, но все равно может быть спрогнозирован с какой-то вероятностью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أثر - تأثير</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/849" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1464" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1574" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2041" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2565" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2566" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2782" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2802" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3120" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4650" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4906" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6459" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7688" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8801" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2564">
    <skos:prefLabel xml:lang="en">effect on health</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">effet sur la santé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto en la salud</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirkung auf die Gesundheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het effect op de gezondheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">воздействие на здоровье</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التأثير على الصحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/849" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3869" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2352" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7689" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10017" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2565" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4149" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4979" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2565">
    <skos:prefLabel xml:lang="en">effect on man</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet sur l'homme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efectos sobre el hombre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirkung auf den Menschen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het effect op de mens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">воздействие на человека</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التأثير على الإنسان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2562" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2564" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10758">
    <skos:prefLabel xml:lang="en">commercial fishery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Such fisheries belong to one of two groups: one catching demersal (bottom-living) fish, e.g. cod, haddock, plaice, sole; the other catching pelagic (surface-living) fish, e.g. anchovy, tuna, herring.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pêche professionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pesca profesional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Handelsfischerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beroepsvisserij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">промышленная рыбная ловля</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В рамках промышленной рыбной ловли происходит отлов глубоководных пород рыб (треска, пикша, камбала, палтус) и рыб, обитающих ближе к поверхности (анчоусы, тунец, сельдь).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصيد التجاري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3237" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10760">
    <skos:prefLabel xml:lang="en">national fishing reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Limited portion of a water body belonging to the State where angling is allowed.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve nationale de pêche</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reserva nacional de la pesca</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nationales Fischereigebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nationaal visreservaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">национальный рыбный заказник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ограниченный участок водоема, принадлежащего государству, где разрешена рыбная ловля.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية صيد وطنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3263" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3256" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/12" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2569">
    <skos:prefLabel xml:lang="en">efficiency criterion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Parameter or rule for assessing the competency in performance of production relative to the input of resources.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">critère d'efficacité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">criterio de eficiencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Effizienzkriterium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">efficiëntiecriterium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">критерий эффективности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Параметр или правило оценки эффективности производства по отношению к израсходованному ресурсу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معيار الفعالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2478" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2570">
    <skos:prefLabel xml:lang="en">efficiency level</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ratio of output to input, usually given as a percentage.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau d'efficacité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel de eficiencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirkungsgrad</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">efficiëntieniveau</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень эффективности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отношение конечного результата к израсходованным ресурсам, обычно выражаемое в процентах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى الفعالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2571">
    <skos:prefLabel xml:lang="en">effluent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The waste liquid from domestic sewage, industrial sites or from agricultural processes. Effluents are harmful when they enter the environment, especially in freshwater, because of their polluting chemical composition.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effluent</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efluentes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausfluß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">effluent</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сточная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отработанная вода, полученная в ходе бытовых, промышленных или сельскохозяйственных процессов. Сточные воды несут экологическую угрозу, что объясняется наличием загрязняющих химических веществ в их составе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفيض- الفائض السائل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4229" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12285" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2573">
    <skos:prefLabel xml:lang="en">egg</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large, female sex cell enclosed in a porous, calcareous or leathery shell, produced by birds and reptiles.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oeuf</skos:prefLabel>
    <skos:prefLabel xml:lang="es">huevo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ei</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">яйцо</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупная, женская яйцеклетка, заключенная в пористую, содержащую известь, или кожистую оболочку, откладываемая птицами или рептилиями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيضة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10767">
    <skos:prefLabel xml:lang="en">socioeducational activity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Instruction or events designed to offer learning or cultural experiences to populations without access to traditional educational institutions due to social or economic barriers.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">action socio-éducative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actividad socioeducational</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sozialpädagogische Tätigkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sociaal-opvoedkundige activiteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общественно-просветительская деятельность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обучение или мероприятия, предлагаемые для получения образовательного или культурного опыта населению, не имеющего доступа к традиционным образовательным учреждениям в силу социальных или экономических препятствий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشاط اجتماعي - تعليمي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12183">
    <skos:prefLabel xml:lang="en">estuary pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Contamination of the generally broad portion of a stream near its outlet which is influenced by the tide of the water body into which it flows. Many estuaries have become badly contaminated by wastes that have been generated from heavily populated areas.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution d'estuaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación de estuario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ästuarverschmutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">estuariumvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение эстуария</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение широкого участка естественного водного потока около устья, находящегося под влиянием вод водоема, в который впадает данный поток. Множество эстуариев подверглось сильному загрязнению отходами, образованными в районах с высокой плотностью населения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث المصب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1523" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2578">
    <skos:prefLabel xml:lang="en">EIA directive</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Council Directive of 27 June 1985 on the assessment of the effects of certain public and private projects on the environment (85/337/EEC). The Directive applies to projects which are likely to have significant effects on the environment by virtue of their nature, size or location.
(Source: PENEL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">directive relative à l'EIE (Evaluation de l'impact sur l'environnement)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Directiva EIA</skos:prefLabel>
    <skos:prefLabel xml:lang="de">UVP-Richtlinie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">MER-richtlijn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">директива ЕС по экологической экспертизе</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Директива от 27 июня 1985 г., нацеленная на оценку результатов реализации конкретных государственных или частных проектов по отношению к окружающей среде (85/337EEC). Под действие директивы подпадают проекты, которые в силу своих масштабов, места реализации или содержания работ имеют вероятность оказать воздействие на окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توجيهات تقييم الأثر البيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2212" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2830" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2579">
    <skos:prefLabel xml:lang="en">EIA law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Law concerning the assessment of the effects of certain public and private projects on the environment, based on the EC Directive n. 85/337.
(Source: PENELa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi sur l'EIE (Evaluation de l'impact sur l'environnement)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ley EIA</skos:prefLabel>
    <skos:prefLabel xml:lang="de">UVP-Gesetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">MER-wet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законы, регулирующие экологическую экспертизу</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Законы, касающиеся оценки последствий реализации конкретных государственных или частных проектов по отношению к окружающей среде, основанные на директиве ЕС № 85/337.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون تقييم الأثر البيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2862" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2830" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2580">
    <skos:prefLabel xml:lang="en">EIA (local)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The identification, evaluation and appraisal of the ecological consequences of a proposed project or development in a city, town or region, and the measures needed to minimize adverse effects.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">EIE (Evaluation de l'impact sur l'environnement)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">EIA (local)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">UVP (kommunal)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">MER (lokaal)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическая экспертиза (местн.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выяснение и оценка экологических последствий реализации конкретного проекта для города, поселка или района, а также мер, необходимых для того, чтобы снизить их отрицательное воздействие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم الأثر البيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2830" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10773">
    <skos:prefLabel xml:lang="en">competitive examination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A test given to a candidate for a certificate or a position and concerned typically with problems to be solved, skills to be demonstrated, or tasks to be performed.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concours</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oposición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Leistungsprüfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergelijkend examen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">конкурсный отбор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экзамен, который должен пройти кандидат для получения сертификата или должности, касающийся проблем или задач, которые предстоит решать абитуриенту в будущем или для демонстрации своих навыков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسابقة اختبارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2582">
    <skos:prefLabel xml:lang="en">elasticity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Ability of a material to return to original dimensions after deformation.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élasticité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elasticidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elastizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elasticiteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эластичность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойство материала возвращаться к первоначальным размерам после деформации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرونة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2584">
    <skos:prefLabel xml:lang="en">elderly person</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Someone who has reached the later stage of life or who has attained a specified age within that stage.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">personne agée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">persona mayor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Seneszente</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bejaarde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пожилой человек</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лицо, достигшее поздней стадии своей жизни или достигшее конкретной возрастной категории в рамках такой стадии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شخص مسن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6527" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10778">
    <skos:prefLabel xml:lang="en">continuing education</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Various forms, methods, and processes of formal and informal education for the continued learning of all ages and categories of the general public. Oriented toward the continued learning/developmental processes of the individual throughout life.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">formation continue</skos:prefLabel>
    <skos:prefLabel xml:lang="es">formación permanente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Weiterbildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">doorlopende scholing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">непрерывное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные формы, методы и процессы формального и неформального обучения для непрерывного образования всех возрастных групп и категорий населения. Ориентирован на непрерывные образовательные процессы каждого лица в течение всей его жизни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعليم المستمر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2587">
    <skos:prefLabel xml:lang="en">electrical industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry for the production of electric energy.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektroindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrotechnische industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство электроэнергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Промышленные предприятия, занятые в производстве электроэнергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصناعة الكهربية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14959" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10780">
    <skos:prefLabel xml:lang="en">initial training</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any education, instruction or discipline occurring at the beginning of an activity, task, occupation or life span.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">formation initiale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">formación inicial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erstausbildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aanvangstraining</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">начальное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Образование, обучение, изучение какой-либо дисциплины, происходящее в начале какой-либо работы, выполнения задачи, трудового или жизненного пути.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدريب الأولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8607" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2592">
    <skos:prefLabel xml:lang="en">electricity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A general term used for all phenomena caused by electric charge whether static or in motion.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">électricité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">electricidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электричество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общий термин, применяемый ко всем явлениям, вызванным статическими или переменными электрическими изменениями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الكهرباء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2601" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2593">
    <skos:prefLabel xml:lang="en">electricity company</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Company which is responsible for the supply and distribution of electric energy to a given area.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compagnie d'électricité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">empresa de electricidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätsgesellschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteitsbedrijf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электроэнергетическая компания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Компания, ответственная за подачу и распределение электроэнергии в конкретный район.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شركة كهرباء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13213" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2594">
    <skos:prefLabel xml:lang="en">electricity consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Amount of electricity consumed by an apparatus.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">consommation d'électricité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consumo de electricidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätsverbrauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteitsverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребление электричества</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество электричества, потребляемое прибором.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استهلاك الكهرباء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2595">
    <skos:prefLabel xml:lang="en">electricity generation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of transforming other forms of energy into electric energy.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">production d'énergie électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producción eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätserzeugung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteitsopwekking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство электроэнергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс трансформации разных форм энергии в электрическую.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توليد الكهرباء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2735" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2596">
    <skos:prefLabel xml:lang="en">electricity generation cost</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The value or amount of money exchanged for the production and sustained supply of charged ion current used as a power source.
(Source: EFP / OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">coût de la production électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">coste de producción eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätserzeugungskosten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">de kosten van het opwekken van elektriciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стоимость производства электроэнергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стоимость или денежная сумма, обмениваемая на производство и устойчивую подачу заряженного потока частиц, используемого как источник энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكلفة توليد الكهرباء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1824" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2597">
    <skos:prefLabel xml:lang="en">electricity supply industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry for the supply and distribution of electric power.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion de l'électricité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">empresa eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätswirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteitsbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электроэнергетика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль промышленности, предприятия которой заняты в процессе производства и распределения электроэнергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الإمداد بالكهرباء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13213" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2599">
    <skos:prefLabel xml:lang="en">electric line</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Wires conducting electric power from one location to another; also known as electric power line.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ligne électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">líneas eléctricas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrische Leitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrische leiding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">линия электропередачи</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Провода, передающие электрический ток от одного пункта к другому.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خط كهربي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2722" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3960" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5963" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1098" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3087">
    <skos:prefLabel xml:lang="en">extraction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any process by which a pure metal is obtained from its ore.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extracción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Extraktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">winning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой процесс, в ходе которого чистый металл получается из руды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخراج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8879" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5505" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5834" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7423" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9169" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12511" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2601">
    <skos:prefLabel xml:lang="en">electric power</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The rate at which electric energy is converted to other forms of energy, equal to the product of the current and the voltage drop.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">énergie électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">energía eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrische stroom</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сила тока</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Скорость, с которой электроэнергия может быть преобразована в другие формы энергии, равные производимому току и величине напряжения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طاقة كهربية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1777" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2592" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/434">
    <skos:prefLabel xml:lang="en">animal noise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Noise caused by animals such as dogs kept in kennels or in private homes as pets.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bruit dû aux animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruido animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierlärm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierengeluid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шум, производимый животными</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Шум, причиной которого являются животные, как, например, собаки, содержащиеся в вольерах или в конуре при доме.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضوضاء بسبب  الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2606">
    <skos:prefLabel xml:lang="en">electric power plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A stationary plant containing apparatus for large-scale conversion of some form of energy (such as hydraulic, steam, chemical, or nuclear energy) into electrical energy.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">centrale électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">central electrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätswerk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteitscentrale</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электростанция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Завод, оборудованный средствами для крупномасштабного преобразования какой-либо формы энергии (например, гидравлической, энергии пара, химической или ядерной энергии) в электрическую энергию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة توليد طاقة كهربية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6561" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1503" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1575" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3593" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4098" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5736" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7910" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8443" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9336" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11958" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11974" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2608">
    <skos:prefLabel xml:lang="en">electric power supply</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">approvisionnement en électricité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suministro de energía eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrizitätsversorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektriciteitsvoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обеспечение электроэнергией</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الإمداد بالطاقة الكهربية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2746" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/435">
    <skos:prefLabel xml:lang="en">animal nutrition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Ingestion, digestion and/or assimilation of food by animals.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nutrition animale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nutrición animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierernährung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenvoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">питание животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Потребление, переваривание и/или ассимиляция корма животными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تغذية الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5765" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/437" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2612">
    <skos:prefLabel xml:lang="en">electric vehicle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Vehicle driven by an electric motor and characterized by being silent and less polluting.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">véhicule électrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vehículos eléctricos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrofahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrovoertuig</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электромобиль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Автомобиль, движимый электромотором, а также отличающийся бесшумностью и пониженным загрязнением окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركبة كهربائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2617">
    <skos:prefLabel xml:lang="en">electrokinetics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the motion of electric charges, especially of steady currents in electric circuits, and of the motion of electrified particles in electric or magnetic fields.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effets électrocinétiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">electrocinética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrokinetik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrokinetica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электрокинетика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение движения электрических зарядов, особенно постоянных течений в электроцепях, а также движения заряженных частиц в электрических или магнитных полях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الآثار الإلكترونية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6230" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2618">
    <skos:prefLabel xml:lang="en">electrolysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The production of a chemical reaction by passing an electric current through an electrolyte. In electrolysis, positive ions migrate to the cathode and negative ions to the anode.
(Source: DICCHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">électrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">electrólisis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электролиз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическая реакция, протекающая в процессе прохождения электрического тока через электролит. В ходе электролиза положительные ионы направляются к катоду, а отрицательные ионы - к аноду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحليل الكهربي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5081" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/437">
    <skos:prefLabel xml:lang="en">animal physiology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study of the normal processes and metabolic functions of animal organisms.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">physiologie animale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fisiología animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierphysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenfysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физиология животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение естественных процессов и метаболического обмена, происходящих в организмах животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيسيولوجيا الحيوان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6240" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/417" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/435" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13321" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2624">
    <skos:prefLabel xml:lang="en">electronics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study, control, and application of the conduction of electricity through gases or vacuum or through semiconducting or conducting materials.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">électronique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">electrónica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektronik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektronica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электроника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение, контроль и применение явления проходимости электричества через газы, вакуум, проводящие или полупроводниковые материалы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإلكترونيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6230" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5225" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2625">
    <skos:prefLabel xml:lang="en">electronic scrap</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any material from electronic devices and systems, generated as a waste stream in a processing operation or discarded after service.
(Source: APD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ferraille électronique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo electrónico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektronikschrott</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektronisch afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходы электронной промышленности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой материал электронных приборов или систем, который становится отходом в результате каких-либо обрабатывающих операций или выбрасывается после использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نفايات إلكترونية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7483" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7981" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2626">
    <skos:prefLabel xml:lang="en">electronic scrap regulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Government or management prescribed rule for the disposal and recycling of electric parts, circuits and systems, especially computer devices.
(Source: BLD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réglementation sur la ferraille électronique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reglamento sobre residuos electrónicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektronik-Schrott-Verordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verordening met betrekking tot elektronisch afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нормативный документ, регулирующий утилизацию отходов электронной промышленности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Правило, установленное на государственном уровне или уровне компании, предписывающее порядок утилизации или вторичного использования отдельных частей, микросхем и систем, особенно компьютерных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قواعد خاصة بالنفايات الإلكترونية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11514" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2628">
    <skos:prefLabel xml:lang="en">electrosmog</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollution caused by electric and magnetic fields generated by power lines, electrical equipment, mobile and cordless phones, radar, electrical household appliances, microwave ovens, radios, computers, electric clocks, etc.
(Source: NPLa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution électromagnétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">electrosmog</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrosmog</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrosmog</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электросмог</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение, вызванное электрическими и магнитными полями, производимыми вокруг линий электропередачи, электроустановок, мобильных телефонов, радаров, электробытовых приборов, микроволновых печей, радиоприемников, компьютеров, электрочасов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التلوث الكهرومغناطيسي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3209" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3960" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9362">
    <skos:prefLabel xml:lang="en">wood waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste which is left over after the processing of raw timber.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet de bois</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo de madera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Holzabfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">houtafval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">древесные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, образовавшиеся в ходе обработки сырой древесины.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نفايات خشبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3169">
    <skos:prefLabel xml:lang="en">fertiliser</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substance added to soil for the purpose of promoting plant life, usually containing nitrogen, potassium and phosphorus, e.g. manure, guano, rock phosphates.
(Source: BENNET)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">engrais</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fertilizantes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Düngemittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">meststof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">удобрение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, добавляемое в почву с целью поддержки жизни растений, обычно содержат азот, калий и фосфор, например, навоз, помет, фосфаты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سماد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5510" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5007" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5500" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11201" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14957" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7861" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2633">
    <skos:prefLabel xml:lang="en">electrotechnical equipment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">All the equipment connected with the technological use of electric power.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équipement électrotechnique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equipo electrotécnico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrotechnische Ausrüstung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrotechnische apparatuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электротехническое оборудование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Все оборудование, связанное с технологическим использованием электроэнергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معدة تكنولوجية كهربائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5222" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7045" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13221" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2634">
    <skos:prefLabel xml:lang="en">electrotechnical industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of commercial enterprises is engaged in the design, manufacture and marketing of machinery, apparatus and supplies for the generation, storage and utilization of electrical energy, such as household appliances, radio and television receiving equipment, and lighting and wiring equipment.
(Source: SIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie électrotechnique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria electrotécnica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektrotechnische Industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektrotechnische industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электротехническая промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сектор экономики, комплекс предприятий которого заняты проектированием, изготовлением и реализацией машин, приборов и запчастей, предназначенных для производства, накопления и использования электроэнергии, как, например, бытовые приборы, радио- и ТВ-приемники, оборудование для освещения и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة تكنولجية كهربائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2635">
    <skos:prefLabel xml:lang="en">element of group 0</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of monatomic gaseous elements forming group 18 (formerly group 0) of the periodic table: helium (He), neon (Ne), argon (Ar), krypton (Kr), xenon (Xe), and radon (Rn).
(Source: DICCHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élements du groupe 0</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo 0</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe 0</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep 0</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент нулевой группы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа одноатомных газообразных элементов, составляющих 18 группу (бывш. 0 группу) периодической таблицы: гелий (He), неон (Ne), аргон (Ar), криптон (Kr), ксенон (Xe) и радон (Rn).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة صفر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6935" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2636">
    <skos:prefLabel xml:lang="en">element of group I (alkaline)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the monovalent metals lithium, sodium, potassium, rubidium, caesium, and francium, belonging to group 1A of the periodic table. They are all very reactive and electropositive.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe I (alcalins)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo I (alcalinos)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe I (Alkalimetalle)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep I (alkalimetalen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы I</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель одновалентных металлов, таких как литий, натрий, калий, рубидий, цезий и франций, составляющих группу IА периодической таблицы. Все очень активны и положительно заряжены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في  المجموعة 1 (قاعدة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1103" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2637">
    <skos:prefLabel xml:lang="en">element of group II (alkaline earth metals)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the divalent electropositive metals beryllium, magnesium, calcium, strontium, barium, and radium, belonging to group 2A of the periodic table.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe II (métaux alcalino-terreux)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo II (metales alcalino-terrosos)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe II (Erdalkalimetalle)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep II (aardalkalimetalen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы II</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель двухвалентных положительно заряженных металлов, таких как бериллий, марганец, кальций, стронций, барий и радий, составляющих группу IIА периодической таблицы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة 2 (معادن أرضية قاعدية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/719" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/781" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1111" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8144" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2638">
    <skos:prefLabel xml:lang="en">element of group III</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Group III consists of two subgroups: group IIIb and group IIIa. Group IIIa consists of scandium, yttrium, and lanthanium, which is generally considered with the lanthanoids, and actinium, which is classified with the actinoids. Group IIIb, the main group, comprises boron, aluminium, gallium, indium, and thallium.
(Source: CHSK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe III</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo III</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe III</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep III</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы III</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Третья группа состоит из двух подгрупп: группа IIIb и группа IIIa. Группа  IIIa состоит из скандия, иттрия и лантана, который обычно рассматривается вместе с лантаноидами, и актиния вместе актиноидами. Группа  IIIb состоит из бора, алюминия, галлия, индия и таллия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة 3</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/353" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/965" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8428" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2639">
    <skos:prefLabel xml:lang="en">element of group IV</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Group IV consists of two subgroups: group IVb, main group, and group IVa. Group IVa consists of titanium, zirconium, and hafnium which are generally classified as transition metals. The main group consists of carbonium, silicium, germanium, tin, and lead. The main valency of the elements is IV, and the members of the group show a variation from nonmetallic to metallic behaviour in moving down the group. The reactivity of the elements increases down the group from carbon to lead. All react with oxygen on heating.
(Source: CHSK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe IV</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo IV</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe IV</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep IV</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы IV</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа IV состоит из двух подгрупп: подгруппа IVa и подгруппа IVb. Подгруппа IVa состоит из титана, циркония и гафния, которые обычно считаются переходными металлами. Основная подгруппа IVb состоит из углерода, кремния, германия, олова и свинца. Основная валентность этих элементов - 4, а их свойства варьируются от неметаллических до металлических при движении вниз по группе. Реактивность увеличивается при движении от углерода к свинцу. Все реагируют с кислородом при нагревании.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة 4</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1160" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4723" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7694" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8490" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2640">
    <skos:prefLabel xml:lang="en">element of group V</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Group V consists of two subgroups: group Vb, the main group, and group Va. Group Va consists of vanadium, niobium, and tantalum, which are generally considered with the transition elements. The main group consists of nitrogen, phosphorus, arsenic, antimony, and bismuth.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe V</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo V</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe V</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep V</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы V</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа V состоит из двух подгрупп - основная Vb и подгруппа Va. Подгруппа  Va состоит из ванадия, ниобия и тантала, которые, как правило, рассматриваются вместе с переходными элементами. Основная подгруппа состоит из азота, фосфора, мышьяка, сурьмы и висмута.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة 5</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/567" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5605" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6196" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10833">
    <skos:prefLabel xml:lang="en">public function</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Activity carried out for the benefit of the community.
(Source: NDGIUR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fonction publique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">función pública</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öffentliches Ereignis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nutsfunctie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общественная функция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, выполняемая на благо общества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وظيفة عامة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/95" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1075" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1261" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2003" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3705" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3717" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4764" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5479" />
