    <skos:prefLabel xml:lang="ru">охотничий заказник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земли, где разрешено преследовать, убивать или отлавливать диких животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية قنص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7003" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1772" />
