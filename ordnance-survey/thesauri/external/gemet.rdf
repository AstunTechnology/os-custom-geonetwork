  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5393">
    <skos:prefLabel xml:lang="en">motor vehicle industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie de véhicules à moteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de vehículo de motor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kfz-Industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">motorvoertuigenindustrie</skos:prefLabel>
