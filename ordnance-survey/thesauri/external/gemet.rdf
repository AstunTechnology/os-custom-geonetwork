  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/391">
    <skos:prefLabel xml:lang="en">anaerobic condition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mode of life carried on in the absence of molecular oxygen.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">anaerobiose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">condición anaeróbica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">anaerobe Bedingungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anaërobe voorwaarden</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анаэробные условия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жизнь, протекающая в отсутствии молекулярного кислорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ظرف لاهوائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
