    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/693">
    <skos:prefLabel xml:lang="en">background level</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Term used in a variety of situations, always as the constant or natural amount of a given substance, radiation, noise, etc.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution naturelle de fond</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel de base</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hintergrundwert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">achtergrondniveau</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фоновый уровень</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин, используемый при различных обстоятельствах, всегда как постоянная величина или количество вещества, излучения, шума и пр., встречающееся в природе при нормальных условиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى الخلفية - المستوى الطبيعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8886">
    <skos:prefLabel xml:lang="en">indefinite legal concept</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A condition or extent of time in a government enforced contract, instrument or agreement that lacks precision, distinguishing characteristics or fixed boundaries.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">notion juridique indéfinie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concepto legal indefinido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unbestimmter Rechtsbegriff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onbepaald rechtsbegrip</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неопределенная правовая концепция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مفهوم قانوني غير معرَّف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8887">
    <skos:prefLabel xml:lang="en">valley</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any low-lying land bordered by higher ground; especially an elongate, relatively large, gently sloping depression of the Earth's surface, commonly situated between two mountains or between ranges of hills or mountains, and often containing a stream with an outlet. It is usually developed by stream erosion, but may be formed by faulting.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vallée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">valles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tal</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">долина</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Низко расположенный участок земной поверхности, ограниченный возвышенностями; особенно длинная, относительно большая, слегка наклоненная впадина в земной поверхности, обычно расположенная между двумя горами либо между грядой холмов или гор и по которой часто протекает естественный водный поток с устьем. Как правило, является результатом действия почвенной эрозии, но может также быть результатом геологических процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وادي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4629" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2276" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/698">
    <skos:prefLabel xml:lang="en">bacterium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Group of single-cell micro-organisms, the smallest of the living organisms. Some are vital to sustain life, while others are responsible for causing highly dangerous human diseases, such as anthrax, tetanus and tuberculosis. Bacteria are found everywhere, in the soil, water and air.
(Source: MGH /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bactérie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bacteria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bakterien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bacteriën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бактерии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа одноклеточных микроорганизмов, самых маленьких из живых организмов. Некоторые являются жизненно необходимыми, в то время как другие являются причиной многих крайне опасных для человека заболеваний, как, например, сибирская язва, столбняк, туберкулез. Бактерии можно найти везде - в почве, воде и воздухе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البكتيريا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5228" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6646" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1561" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3106" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/865" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/699">
    <skos:prefLabel xml:lang="en">bacterial bed</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A device that removes some suspended solids from sewage. Air and bacteria decompose additional wastes filtering through the sand so that cleaner water drains from the bed.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lit bactérien</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lechos bacterianos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nährboden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oxydatiebed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бактериальный слой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство удаления взвешенных частиц из канализационных стоков. Воздух и бактерии разлагают отходы, проникающие через песок, позволяя отводить очищенную воду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مهاد بكتيري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3184" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8892">
    <skos:prefLabel xml:lang="en">valued ecosystem component</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An appraised, evaluated or estimated element or ingredient of a biological community and its non-living environmental surroundings.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composante valorisée d'un écosystème</skos:prefLabel>
    <skos:prefLabel xml:lang="es">componente valorado del  ecosistema</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geschätzte Ökosystemkomponente</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belangrijk bestanddeel van het ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ценный компонент экосистемы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оцененный элемент или ингредиент биологического сообщества и окружающих его неживых условий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكون إيكولوجي عالي القيمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2810" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8893">
    <skos:prefLabel xml:lang="en">vanadium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A silvery-white, ductile metal resistant to corrosion; used in alloy steels and as an x-ray target.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vanadium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vanadio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vanadium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vanadium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ванадий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Серебристо-белый, мягкий металл, стойкий к коррозии; используется в сплавах стали, а также в рентгеновских установках.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفاناديوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/702">
    <skos:prefLabel xml:lang="en">bacteriology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science and study of bacteria.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bactériologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bacteriología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bakteriologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bacteriologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бактериология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука и исследования бактерий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم البكتيريولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8895">
    <skos:prefLabel xml:lang="en">vanished species</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Species which have disappeared from an area because of adverse environmental conditions.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèce disparue</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies extintas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausgelöschte Arten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verdwenen soort</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">исчезнувшие виды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Виды, которые исчезли в данном районе из-за неблагоприятных экологических условий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنواع بائدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1221" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8898">
    <skos:prefLabel xml:lang="en">vapour pressure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The partial pressure of water vapour in the atmosphere. For a liquid or solid, the pressure of the vapour in equilibrium with the liquid or solid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tension de vapeur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">presión del vapor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dampfdruck</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dampspanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">давление пара</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Частичное давление водяных паров в атмосфере. Для жидкости или твердого тела давление пара в равновесии с жидкостью или твердым телом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضغط البخار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8899">
    <skos:prefLabel xml:lang="en">varnish</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A transparent surface coating which is applied as a liquid and then changes to a hard solid; all varnishes are solutions of resinous materials in a solvent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vernis</skos:prefLabel>
    <skos:prefLabel xml:lang="es">barnices</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Firnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лак</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прозрачное покрытие для различных поверхностей, наносимое в жидком виде и позже переходящее в твердое состояние; все лаки представляют собой растворы смол в растворителях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ورنيش</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6007" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/709">
    <skos:prefLabel xml:lang="en">balance (economic)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An equality between the sums total of the two sides of an account, or the excess on either side.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bilan</skos:prefLabel>
    <skos:prefLabel xml:lang="es">balance (economía)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bilanz (Betriebswirtschaft)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">balans [economisch]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">баланс (экономический)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Равновесие между итоговыми суммами с двух сторон счета либо сальдо с двух сторон счета.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ميزان (اقتصاد)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10002" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6678" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/710">
    <skos:prefLabel xml:lang="en">balancing of interests</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Considering, weighing or counterbalancing the competing political or financial concerns of different parts of society, including industries, consumers, trade unions and other groups or organizations.
(Source: OED / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équilibrage des intérêts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio de intereses</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Interessenausgleich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belangenafweging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">баланс интересов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">موازنة المصالح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12026">
    <skos:prefLabel xml:lang="en">atmospheric fallout</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The sedimentation of dust or fine particles from the atmosphere.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">retombée atmosphérique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">precipitación atmosférica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Atmosphärischer Fallout</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">atmosferische radioactieve neerslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выпадение осадков из атмосферы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оседание пыли или мелких частиц из атмосферы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترسبات الغلاف الجوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3110" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8906">
    <skos:prefLabel xml:lang="en">vector of human diseases</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An agent or organism that acts as a carrier or transmitter of a human illness.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vecteurs de maladies humaines</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vector de enfermedades humanas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vektoren von Krankheiten des Menschen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(mensen)ziekteoverbrengers</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">переносчик человеческих заболеваний</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество или организм, являющиеся переносчиком или передатчиком болезней человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حامل أمراض بشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2947" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8908">
    <skos:prefLabel xml:lang="en">vegetation cover</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Number of plants growing on a certain area of land.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">couverture végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cubierta vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vegetationsdecke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantendek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растительный покров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Число растений, растущих на конкретном участке земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الغطاء الأخضر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8922" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8909">
    <skos:prefLabel xml:lang="en">vegetable cultivation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cultivation of herbaceous plants that are used as food.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture maraîchère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultivo de verdura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemüsebau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">groenteteelt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растениеводство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выращивание травянистых растений, используемых в качестве продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة الخضراوات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8920" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/718">
    <skos:prefLabel xml:lang="en">sewage spreading prohibition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Prohibition of spreading sewage sludge on land to prevent accumulation of toxic heavy metals in excessive quantities.
(Source: PORTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">interdiction d'épandre les eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prohibición de extensión de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aufbringungsverbot</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verbod op de verspreiding van afvalwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">запрет на слив сточного ила в неустановленных местах</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Запрещение слива сточных вод для предотвращения накопления токсичных металлов в больших количествах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منع انتشار مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6709" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7629" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/719">
    <skos:prefLabel xml:lang="en">barium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A soft silvery-white metallic element of the alkaline earth group. It is used in bearing alloys and compounds are used as pigments.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">baryum</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Barium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">barium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">барий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мягкий, серебристо-белый элемент группы земельных металлов. Используется в сплавах, а его  соединения используются в качестве пигментов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الباريوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2637" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8912">
    <skos:prefLabel xml:lang="en">plant selection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The selection by man of particular genotypes in a plant population because they exhibit desired phenotypic characters.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">amélioration des plantes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fitomejoramiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenauswahl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantenselectie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">селекция растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Селекция человеком особенных генотипов в популяции растений благодаря их фенотипическим свойствам, необходимым человеку.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انتقاء النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8312">
    <skos:prefLabel xml:lang="en">tax law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government stipulating the sum of money and manner of collection it demands for governmental support, facilities and services, usually levied upon income, property, sales or other financial resources.
(Source: RHW / BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi fiscale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho fiscal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steuerrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belastingwet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">закон в области налогообложения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, принятых государством и предусматривающих конкретные суммы денег и форму их сбора в целях поддержки государства, его органов и служб, взимаемые, как правило, с дохода, имущества, продаж или иных финансовых ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون الضرائب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3200" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11043">
    <skos:prefLabel xml:lang="en">intervention fund</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Money or financial resources set aside to interpose or interfere in any business affair in order to affect an outcome.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fonds d'intervention</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fondo de intervención</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Interventionsfonds</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">interventiefonds</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фонд непредвиденных расходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деньги или финансовые ресурсы, предназначенные для использования при необходимости воздействовать на результат деловой операции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخصصات التدخل - صندوق التدخل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11044" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8918">
    <skos:prefLabel xml:lang="en">plant reproduction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various processes, either sexual or asexual, by which a plant produces one or more individuals similar to itself.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">reproduction végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reproducción vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenvermehrung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voortplanting van planten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">репродукция растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные процессы, в том числе половые и бесполые, в ходе которых растения воспроизводят одно или несколько растений, подобных себе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكاثر النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7120" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8313">
    <skos:prefLabel xml:lang="en">taxonomy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of biology concerned with the classification of organisms into groups based on similarities of structures, origin, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taxonomie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">taxonomía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Taxonomie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">taxonomie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">таксономия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль биологии, изучающая классификацию организмов по группам в зависимости от похожих структур, происхождения и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم التصنيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4805" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/728">
    <skos:prefLabel xml:lang="en">base (chemical)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any chemical species, ionic or molecular, capable of accepting or receiving a proton (hydrogen ion) from another substance; the other substance acts as an acid in giving of the proton; the other ion is a base.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">base (chimie)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bases</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Basen (chemisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">base [chemische stof]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">основа (хим.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое вещество, ионного или молекулярного состава, способное присоединить протон (ион водорода) от другого вещества; вещество, отдающее протон, выступает в качестве кислоты; другой ион представляет собой основу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاعدية (كيمياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11044">
    <skos:prefLabel xml:lang="en">financial fund</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Monetary resources set aside for some purpose.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fonds financier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fondo financiero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geldmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">financieel fonds</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">финансовый фонд</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Денежные средства, предназначенные для определенных целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخصصات مالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8098" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11043" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8922">
    <skos:prefLabel xml:lang="en">vegetation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The plants of an area considered in general or as communities, but not taxonomically; the total plant cover in a particular area or on the Earth as a whole. 2) The total mass of plant life that occupies a given area.
(Source: ALL /  MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">végétation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vegetación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vegetation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantegroei</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растительность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Растения конкретного района, рассматриваемые в качестве сообщества, но не в таксономическом отношении; весь растительный покров в конкретном районе или на поверхности Земли в целом. 2) Вся растительная жизнь, расположенная на конкретной территории.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المساحة المنزرعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6299" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8925" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10626" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10640" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8908" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/731">
    <skos:prefLabel xml:lang="en">basicity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The state of a solution of containing an excess of hydroxyl ions.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">basicité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carácter básico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Basizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">basiciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">основность (хим.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние раствора, содержащего излишние ионы гидроксила.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القاعدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/48" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/733">
    <skos:prefLabel xml:lang="en">basidiomycete</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">basidiomycète</skos:prefLabel>
    <skos:prefLabel xml:lang="es">basidiomiceto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Basidiomyceten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">basidiomycete</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">базидиомицеты</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الدِعاميات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3529" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5448" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8926">
    <skos:prefLabel xml:lang="en">vehicle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any conveyance in or by which people or objects are transported.

(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">véhicule</skos:prefLabel>
    <skos:prefLabel xml:lang="es">automóviles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voertuig</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортное средство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство, с помощью которого или находясь внутри которого перемещаются люди или предметы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عربة- سيارة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/253" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/788" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1595" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2612" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5322" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5390" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6939" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7654" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10915" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7489" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2853">
    <skos:prefLabel xml:lang="en">environmental information system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A coordinated assemblage of people, devices or other resources designed to exchange data or knowledge concerning any aspect of the ecosystem, the natural resources within or, more generally, the external factors surrounding and affecting human life.
(Source: TOE /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système d'information sur l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistemas de información ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltinformationssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieu-informatiesysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационная система по вопросам окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Координированное объединение людей, технических средств или других ресурсов с целью обмена данными и знаниями, касающихся любого аспекта экосистемы, природных ресурсов в ее рамках и, более широко, внешних факторов, окружающих и влияющих на жизнь человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام معلومات بيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4311" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/736">
    <skos:prefLabel xml:lang="en">batch process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process that is not in continuous or mass production; operations are carried out with discrete quantities of material or a limited number of items.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">procédé discontinu</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso por lotes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Diskontinuierliches Verfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ladingsgewijs proces</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">периодический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс с перерывами или не связанный с массовым производством; операции осуществляются с конкретным количеством материала или производится ограниченное количество изделий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية محدودة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8929">
    <skos:prefLabel xml:lang="en">vehicle exhaust gas</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An aeriform fluid of fine particles suspended in air, produced and vented as a byproduct of the operation of wheeled machines or conveyances self-propelled by internal combustion engines.
(Source: RHW / MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gaz d'échappement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gases del tubo de escape de vehículos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auspuffgase (KFZ)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitlaatgas voertuig</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выхлопной газ транспортных средств</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воздушный поток твердых частиц, производимый и выпускаемый в качестве попутного продукта работы колесных механизмов или транспортных средств, работающих от двигателя внутреннего сгорания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عادم السيارات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3045" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5392" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8931">
    <skos:prefLabel xml:lang="en">vehicle inspection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An official periodical examination of an automobile, truck, boat, airplane or other means of conveyance to determine compliance in design or operation with legal standards for safety or pollution emissions.
(Source: DAM / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">inspection des véhicules</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inspección de vehículos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fahzeuginspektion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voertuiginspectie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">техосмотр автомобилей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Периодический контроль и обслуживание транспортного средства, производимые для обеспечения его эффективной работы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفحص الفني للمركبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4360" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13127">
    <skos:prefLabel xml:lang="en">iron scrap</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste pieces or disused articles of wrought iron (wrought-iron scrap) suitable for reworking for rolling or forging.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ferraille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">chatarra de hierro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisenschrott</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijzerschroot</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">металлический скрап</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы или отработанные материалы из сварочной стали, пригодные для вторичного использования при прокатке или ковке.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نفايات حديد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7486" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8934">
    <skos:prefLabel xml:lang="en">vehicle manufacturing industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of commercial enterprises is engaged in the manufacture and sale of equipment that conveys people, goods or materials by land, air or water.
(Source: SIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie de véhicules</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de la fabricación de vehículos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fahrzeugindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">autoindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство транспортных средств</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль экономики, предприятия которой осуществляют производство и реализацию транспортных средств для перевозки людей, товаров и материалов по суше, воде или воздуху.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة المركبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5393" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7655" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/745">
    <skos:prefLabel xml:lang="en">battery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A series of cells, each containing the essentials for producing voltaic electricity, connected together.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">batterie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">baterías</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Batterie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">batterij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аккумулятор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплект из нескольких соединенных вместе контейнеров, содержащих исходные вещества для производства электрического тока.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بطارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2588" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1092" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1242" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12366" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12367" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/746">
    <skos:prefLabel xml:lang="en">battery disposal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">élimination des batteries</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desecho de baterias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Batterieentsorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">batterijverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">утилизация использованных аккумуляторов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التخلص من البطاريات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8940">
    <skos:prefLabel xml:lang="en">ventilation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of supplying or removing air, by natural or mechanical means, to or from any space; such air may or may not have been conditioned.
(Source: HARRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ventilation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ventilación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lüftung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">luchtverversing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вентиляция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс подачи или удаления воздуха при помощи естественных или искусственных средств внутрь помещений или из них; такой воздух может быть кондиционирован или нет.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تهوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/132" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/749">
    <skos:prefLabel xml:lang="en">bay</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An open, curving indentation made by the sea or a lake into a coastline.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">baie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bahías</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">baai</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бухта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Открытое углубление береговой линии, проделанное водами моря или озера.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خليج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3800" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2434">
    <skos:prefLabel xml:lang="en">ecodevelopment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Conservative development based on long term optimization of biosphere resources.
2)An approach to development through rational use of natural resources by means of appropriate technology and system of production which take into account and provide for the conservation of nature.
(Source: GREMES /  UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ecodéveloppement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desarrollo ecológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökoentwicklung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecologische ontwikkeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экоразвитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Устойчивое развитие, основанное на долгосрочной оптимизации биосферных ресурсов. 2) Концептуальный подход к проблеме развития, основанный на рациональном природопользовании с применением соответствующих технологий и системы производства, учитывающих и обеспечивающих сохранение природы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنمية الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2805" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3571">
    <skos:prefLabel xml:lang="en">gas engine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An internal combustion engine that uses gaseous fuel.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">moteur à gaz</skos:prefLabel>
    <skos:prefLabel xml:lang="es">motor de gas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gasmotor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gasmotor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">газовый двигатель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Двигатель внутреннего сгорания, который использует газообразное топливо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محرك يعمل بالغاز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3469" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8944">
    <skos:prefLabel xml:lang="en">vermin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Small animals and insects that can be harmful and which are difficult to control when they appear in large numbers.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vermine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bichos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ungeziefer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ongedierte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вредитель (биол.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мелкие животные и насекомые, которые могут наносить вред и которых трудно контролировать в силу их большой численности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهوام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/450" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6138" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11048">
    <skos:prefLabel xml:lang="en">incentive tax</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">incitation fiscale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">impuesto incentivado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steueranreiz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stimuleringsbelasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стимулирующий налог</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">حافز ضريبي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8946">
    <skos:prefLabel xml:lang="en">vertebrate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any chordate animal of the subphylum Vertebrata, characterized by a bony or cartilaginous skeleton and a well-developed brain: the group contains fishes, amphibians, reptiles, birds, and mammals.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vertébré</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertebrados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vertebraten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gewervelde dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">позвоночные</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Хордовое животное подкласса Vertebrata, характеризуемое костистым или хрящевым скелетом и хорошо развитым мозгом; к таким животным относятся рыбы, амфибии, рептилии, птицы и млекопитающие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفقَّاريات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1798" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/387" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3252" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4982" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5076" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6312" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7124" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/755">
    <skos:prefLabel xml:lang="en">beaching</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The washing ashore of whales or other cetaceans that have died for natural causes, or because of highly polluted sea water or after being trapped in drift nets.
(Source: WPRa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">échouage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ordenación playera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strandung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stranden</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброс на берег морских животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вымывание на берег китов и туш других китовых, погибших в результате естественных причин, загрязненности морской воды или в результате попадания в рыболовные сети.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الخروج إلى الشاطئ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/767" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8951">
    <skos:prefLabel xml:lang="en">veterinary medicine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of medical practice which treats of the diseases and injuries of animals.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">médecine vétérinaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medicina veterinaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tiermedizin</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">diergeneeskunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ветеринария</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль практической медицины, в рамках которой осуществляется изучение и лечение болезней и травм животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الطب البيطري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5144" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/417" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/760">
    <skos:prefLabel xml:lang="en">bee conservation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The care, preservation and husbandry of hymenopterous insects valued for their ability to pollinate crops and other flora or for their production of honey.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection des abeilles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conservación de las abejas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bienenschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bijenbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охрана пчел</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Забота, сохранение и разведение перепончатокрылых насекомых, ценных благодаря их способности опылять сельскохозяйственные культуры и другие растения, а также производить мед.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحفاظ على النحل - حماية النحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7983" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/761">
    <skos:prefLabel xml:lang="en">beef cattle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cattle bred for the production of meat.

(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bétail de boucherie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ganado vacuno para carne</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlachtrind</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slachtvee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мясной скот</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Скот, выращиваемый для производства мяса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماشية التسمين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1225" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/762">
    <skos:prefLabel xml:lang="en">bee</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the membranous-winged insects which compose the superfamily Apoidea in the order Hymenoptera characterized by a hairy body and by sucking and chewing mouthparts.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abeille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">abejas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biene</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bijen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пчела</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое крылатое насекомое из надсемейства Apoidea отряда перепончатокрылых, тело которых покрыто волосками, а также имеющие сосущие и жующие челюсти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4127" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/490" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8955">
    <skos:prefLabel xml:lang="en">viaduct</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A long high bridge, usually held up by many arches, which carries a railway or a road over a valley or other similar area at a lower level.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">viaduc</skos:prefLabel>
    <skos:prefLabel xml:lang="es">viaducto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Viadukt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">viaduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">виадук</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Длинный высокий мост, обычно поддерживаемый множеством арок, по которому проложена автомобильная или железная дорога над долиной или схожим участком более низкого уровня.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جسر سكة حديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/764">
    <skos:prefLabel xml:lang="en">beetle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any insect of the order Coleoptera, having biting mouthparts and forewings modified to form shell-like protective elytra.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">coléoptère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">coleópteros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Käfer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kevers</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жук</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое насекомое отряда Coleoptera, в строении которого есть кусающие челюсти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الخنفساء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/765">
    <skos:prefLabel xml:lang="en">behaviour</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any observable action or response of an organism, group or species to environmental factors.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">comportement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comportamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verhalten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gedrag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поведение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое заметное действие или реакция организма, группы или видов на факторы окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلوك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/415" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/767" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7781" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/766">
    <skos:prefLabel xml:lang="en">behaviour of substances</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Reactivity of a compound depending on the structure of the molecules.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">activité des substances</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comportamiento de las sustancias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stoffverhalten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stofgedrag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">свойства веществ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Реакционная способность вещества в зависимости от молекулярной структуры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشاط المواد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4395" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5163" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2039" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/767">
    <skos:prefLabel xml:lang="en">behaviour pattern</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A relatively uniform series of overt activities that can be observed with some regularity.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">modèle de comportement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">modelo de comportamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verhaltensmuster</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gedragspatroon</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">манера поведения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Серия относительно единообразных открыто проявляемых действий, которые наблюдаются с определенной периодичностью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نمط سلوكي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/765" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/755" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5237" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5968" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9322" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10554" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/768">
    <skos:prefLabel xml:lang="en">beneficial organism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any pollinating insect, or any pest predator, parasite, pathogen or other biological control agent which functions naturally or as part of an integrated pest management program to control another pest.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisme utile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organismo beneficioso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nützling</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nuttig organisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полезный организм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое опыляющее насекомое, хищник, поедающий вредителей, другой биологический организм, контролирующий паразитов и патогенные организмы, функционирующий в естественных условиях либо используемый в рамках специальной интегрированной программы борьбы с конкретным вредителем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كائنات عضوية مفيدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/864" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2859">
    <skos:prefLabel xml:lang="en">environmental law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A wide spectrum of options from binding "hard" laws, such as international treaties and national legislation, to "soft" laws, covering guiding principles, recommended practices and procedures, and standards. Environmental law also attempts to reconcile international considerations with concerns that focus on very specific problems such as soil degradation, marine pollution or the depletion of non-renewable resources.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltgesetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieurecht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">право в области охраны окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Широкий спектр правовых документов, от "жестких" обязательных законов, таких как международные договоры и национальные законодательные акты, до "мягких" документов, включающих правила, рекомендации, процедуры, стандарты. Право в области окружающей среды также нацелено на увязку международных проблем с решением конкретных экологических задач, например, деградация почв, загрязнение морской среды или истощение невозобновляемых энергоресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2862" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8964">
    <skos:prefLabel xml:lang="en">video</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A format or system used to record and transmit visual or audiovisual information by translating moving or still images into electrical signals.
(Source: MVG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vidéo</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vídeo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">video</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">video</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">видео</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Формат или система, используемые для записи и передачи визуальной или аудиовизуальной информации в процессе преобразования движущегося или неподвижного образа в электрический сигнал.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيديو</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2284" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/773">
    <skos:prefLabel xml:lang="en">benthic ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interacting system of the biological communities located at the bottom of bodies of freshwater and saltwater and their non-living environmental surroundings.
(Source: TOE / DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème benthique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema béntico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Benthisches Ökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecosysteem van de zeebodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема бентоса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимодействующая система биологических сообществ, расположенных на дне водоемов с морской и пресной водой, и их неживое окружение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي القاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5031" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/775">
    <skos:prefLabel xml:lang="en">benthos</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Those organisms attached to, living on, in or near the sea bed, river bed or lake floor.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">benthos</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bentos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Benthos</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeebodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бентос</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организмы, прикрепленные к  дну моря, реки или озера, живущие на поверхности дна, внутри или около него.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القاعيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/511" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/776">
    <skos:prefLabel xml:lang="en">benzene</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A colorless, liquid, flammable, aromatic hydrocarbon used to manufacture styrene and phenol. Also known as benzol.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">benzène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">benceno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Benzol</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">benzeen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бензин</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бесцветный, жидкий, горючий, ароматический углеводород, используемый для производства стиролов и фенолов. Также называется бензол.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بنزين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/562" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/777">
    <skos:prefLabel xml:lang="en">benzopyrene</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A five-ring aromatic hydrocarbon found in coal tar, in cigarette smoke, and as a product of incomplete combustion.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">benzopyrène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">benzopirenos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Benzpyren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">benzopyreen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бензопирен</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ароматический углеводород, в структуре которого есть пять колец; присутствует в коксовом дегте, сигаретном дыме, а также является продуктом неполного сгорания топлива.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بنزوبيرين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6492" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/496">
    <skos:prefLabel xml:lang="en">applied science</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Science whose results are employed in technical applications.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">science appliquée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciencias aplicadas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Angewandte Wissenschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toegepaste wetenschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">прикладная наука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, результаты исследований в рамках которой имеют техническое применение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العلوم التطبيقية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7472" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/611" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2501" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2960" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5093" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11152" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11165" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12586" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12301">
    <skos:prefLabel xml:lang="en">water resources management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures and activities concerning the supply of water, the improvement of efficiency in its use, the reduction of losses and waste, water-saving practices to reduce costs and to slow the depletion of the water supply to ensure future water availability.
(Source: EARTH1a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion des ressources en eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de recursos de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserbewirtschaftung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beheer van de waterbronnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление водными ресурсами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры и действия, касающиеся обеспеченности водой, улучшения эффективности ее использования, снижения потерь и отходов, экономии воды, снижения ее стоимости, продления срока эксплуатации источника воды для обеспечения потребностей в воде в будущем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة الموارد المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7175" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/781">
    <skos:prefLabel xml:lang="en">beryllium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A corrosion-resistant, toxic silvery-white metallic element that occurs chiefly in beryl and is used mainly in x-ray windows and in the manufacture of alloys.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">béryllium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">berilio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beryllium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beryllium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бериллий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стойкий к коррозии, токсичный серебристо-белый металл, встречается, главным образом, в виде берилла. Используется для производства специальных стекол в рентгеновских установках и производстве сплавов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بريليوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2637" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/782">
    <skos:prefLabel xml:lang="en">beta radiation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Name given to the ionizing radiation which is produced as a stream of high speed electrons emitted by certain types of radioactive substance when they decay. The intensity of radiation energy produced in human tissue by a beta particle is a hundred times less than that produced by an alpha radiation particle, but it travels slightly deeper into tissue.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rayonnement beta</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radiación beta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Betastrahlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bèta-straling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бета-излучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин, используемый по отношению к ионизирующему излучению, которое испускается определенными веществами во время своего распада в виде потока электронов, обладающих высокой скоростью. Интенсивность воздействия бета-частиц на ткань организма человека в сотни раз меньше по сравнению с воздействием альфа-частиц, но бета-частицы проникают в ткань глубже.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أشعة بيتا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4491" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/783">
    <skos:prefLabel xml:lang="en">beverage industry</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">industrie des boissons</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de las bebidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Getränkeindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drankenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство напитков</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">صناعة المشروبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3368" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/997" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2262" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8976">
    <skos:prefLabel xml:lang="en">virus</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Submicroscopic agents that infect plants, animals and bacteria, and are unable to reproduce outside the tissues of the host. A fully formed virus consists of nucleic acid (DNA or RNA) surrounded by a protein and lipid (fat) coat. The nucleic acid of the virus interferes with nucleic acid-synthesizing mechanism of the host cell, organizing it to produce more viral nucleic acid. Viruses cause many diseases (e.g., mosaic diseases of many cultivated plants, myxomatosis, foot and mouth disease, the common cold, influenza, measles, poliomyelitis). Many plant viruses are transmitted by insects, some by eelworms. Animal viruses are spread by contact, droplet infection or by insect vectors and some are spread by the exchange of body fluids.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">virus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">virus</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Virus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">virussen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вирус</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мельчайший организм, инфицирующий растения, животных и бактерии и неспособный к репродукции за пределами тканей организма хозяина. Полностью сформированный вирус состоит из нуклеиновой кислоты (ДНК или РНК), окруженной протеиновой и липидной (жировой) оболочкой. Нуклеиновая кислота вируса нарушает механизм синтеза нуклеиновых кислот в принимающей клетке и заставляет ее производить больше вирусных нуклеиновых кислот. Вирусы являются причинами многих заболеваний, например, мозаичных заболеваний многих культурных растений, ящура, миксоматоза, обычной простуды, гриппа, кори, полиомиелита. Многие вирусы растений переносятся насекомыми, некоторые червями. Животные вирусы передаются через физический контакт, воздушно-капельным путем, насекомыми-переносчиками, а некоторые в результате обмена внутренними жидкостями организма (половым путем, в результате переливания крови).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيروس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/892" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11852" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8977">
    <skos:prefLabel xml:lang="en">viscosity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Energy dissipation and generation of stresses in a fluid by the distortion of fluid elements; quantitatively, when otherwise qualified, the absolute viscosity. Also known as flow resistance.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">viscosité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">viscosidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Viskosität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">viscositeit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вязкость</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рассеивание энергии и образование напряжения в жидкости в результате нарушения элементов, составляющих жидкость; в количественном отношении - абсолютная вязкость. Также используется термин "сопротивление потоку".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اللزوجة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/786">
    <skos:prefLabel xml:lang="en">bibliography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A complete or selective listing of documents by a given subject, author or publisher, often including the description and identification of the editions, dates of issue, titles, authorship, publishers or other written materials.
(Source: RHW / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bibliographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bibliografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bibliographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bibliografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">библиография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Список публикаций конкретного автора, издательства или печатных источников информации по конкретной теме. 2) Описание и идентификация отдельных изданий, дат выпуска, авторства, оформления книг и других текстовых материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ببليوجرافيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4227">
    <skos:prefLabel xml:lang="en">industrial dumping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The disposal of any waste generated by a manufacturing or processing process by the agency or body which produced it.
(Source: RHW / ERG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge industrielle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertidos industriales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Industriehalde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">industriële stortplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сброс промышленного мусора</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Утилизация различных отходов, полученных в ходе производственных или обрабатывающих процессов, произведшей их организацией или предприятием.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من النفايات الصناعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2367" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4273" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/788">
    <skos:prefLabel xml:lang="en">bicycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A vehicle with two wheels in tandem, pedals connected to the rear wheel by a chain, handlebars for steering, and a saddlelike seat.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bicyclette</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bicicletas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zweirad</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fiets</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">велосипед</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство передвижения, состоящее из двух колес, рамы, педалей, соединенных с передним колесом цепью, рулем управления и сиденьем в виде седла.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراجة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/792">
    <skos:prefLabel xml:lang="en">bilateral convention</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An international agreement, especially one dealing with a specific matter, involving two or both sides, factions, or the like.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">convention bilaterale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">convenios bilaterales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bilaterale Konvention</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bilaterale overeenkomst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">двусторонняя конвенция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Международное соглашение, особенно такое соглашение, которое посвящено конкретной теме, в которой принимают участие две стороны, участника и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاقية ثنائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1776" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8986">
    <skos:prefLabel xml:lang="en">vitamin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An organic compound present in variable, minute quantities in natural foodstuffs and essential for the normal processes of growth and maintenance of the body.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vitamine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vitaminas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vitamin</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vitaminen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">витамин</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Органическое соединение, присутствующее в различных, но очень маленьких количествах в природных продуктах питания и являющееся очень важным для нормальных процессов роста и поддержания здоровья в организме.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيتامين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8987">
    <skos:prefLabel xml:lang="en">viticulture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That division of horticulture concerned with grape growing, studies of grape varieties, methods of culture, and insect and disease control.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">viticulture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">viticultura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Weinbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wijnbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">виноградарство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль растениеводства, в рамках которой осуществляется выращивание винограда, изучаются сорта винограда, методы их выращивания, а также изучаются методы контроля за болезнями и вредителями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة الكروم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7937">
    <skos:prefLabel xml:lang="en">sound immission</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The introduction in the environment of noise deriving from various sources that can be grouped in: transportation activities, industrial activities and daily normal activities.
(Source: DIFIDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">nuisance sonore</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inmisión de sonido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schallimmission</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidsimmissie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">иммиссия звука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Проникновение в окружающую среду звука, испускаемого из разных источников, которые могут быть сгруппированы по следующим категориям: транспортная деятельность, промышленная деятельность, бытовая деятельность.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استقبال الصوت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4146" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5640" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/57" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/798">
    <skos:prefLabel xml:lang="en">bioaccumulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The accumulation of pollutants in living organisms by direct adsorption or through food chains. 
2) Accumulation by an organism of materials that are not an essential component or nutrient of that organism. Usually it refers to the accumulation of metals, but it can apply to bioaccumulation of persistent synthetic substances such as organochlorine compounds. Many organisms, such as plants, fungi and bacteria, will accumulate metals when grown in solutions containing them. The process can be employed usefully as a purification process to remove toxic heavy metals from waste water and contaminated land.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bioaccumulation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bioacumulación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bioakkumulation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bio-accumulatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бионакопление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Накопление загрязняющих веществ в живых организмах в результате прямой адсорбции или через пищевые цепи. 2) Накопление организмом материалов, которые не являются необходимыми элементами или питательными веществами для этого организма. Обычно этот термин применяют в отношении накопления металлов, но может использоваться по отношению к накоплению стойких синтетических веществ, как, например, органо-хлорсодержащие соединения. Многие организмы, такие как растения, грибы или бактерии, могут накапливать металлы из воды, в которой они росли. Эти свойства могут быть использованы с пользой в процессе очистки и удаления токсичных металлов из сточных вод или с зараженных участков земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التراكم الأحيائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/833" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/800" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6397" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8992">
    <skos:prefLabel xml:lang="en">vocational training</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A special training for a regular occupation or profession, especially, one for which one is specially suited or qualified.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">formation professionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">formación profesional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Berufsausbildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beroepsopleiding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессионально-техническое обучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специальное обучение какой-либо профессии или техническим навыкам, особенно в случаях, когда лицо имеет к этому особую склонность.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدريب مهني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8607" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8993">
    <skos:prefLabel xml:lang="en">volatile organic compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Organic compound readily passing off by evaporation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organique volatil</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos orgánicos volátiles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flüchtige organische Verbindung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vluchtige organische verbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">летучее органическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Легко испаряющееся, органическое соединение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب عضوي متطاير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11794" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/802">
    <skos:prefLabel xml:lang="en">bio-availability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The extent to which a drug or other substance is taken up by a specific tissue or organ after administration.
(Source: ZINZAN /  CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biodisponibilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disponibilidad biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bioverfügbarkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biobeschikbaarheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биополезность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Степень, с которой лекарство или другое вещество поглощается конкретной тканью или другим органом после применения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوفر الأحيائي - التوفر البيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8995">
    <skos:prefLabel xml:lang="en">volatility</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The property of a substance or substances to convert into vapor or gas without chemical change.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">volatilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">volatilidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flüchtigkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vluchtigheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">летучесть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойство вещества или веществ переходить в пары или газообразное состояние без изменения своей химической структуры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التطاير - سرعة التبخر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11792" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11794" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8997">
    <skos:prefLabel xml:lang="en">volcanic area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">région volcanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área volcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vulkangebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vulkanisch gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вулканический район</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة بركانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8386" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2865">
    <skos:prefLabel xml:lang="en">environmental liability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The penalty to be paid by an organization for the damage caused by pollution and restoration necessary as a result of that damage, whether by accidental spillages from tankers, industrial waste discharges into waterways or land, or deliberate or accidental release of radioactive materials.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">responsabilité écologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">responsabilidad ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umwelthaftung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuaansprakelijkheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическая ответственность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Штраф, который необходимо уплатить организации за ущерб, нанесенный в результате загрязнения окружающей среды, а также восстановительные меры, которые необходимо  предпринять для компенсации этого ущерба, будь то аварийные разливы нефти из танкеров, выбросы промышленных отходов или намеренные/случайные выбросы радиоактивных материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المسؤولية البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4787" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2778" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9003">
    <skos:prefLabel xml:lang="en">volcanism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The processes by which magma and its associated gases rise into the crust and are extruded onto the Earth's surface and into the atmosphere.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">volcanisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vulcanismo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vulkanismus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vulkanisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вулканический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого магма и связанные с ней газы поднимаются к земное коре, извергаются на поверхность Земли и в атмосферу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بركانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3648" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8999" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9004" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/812">
    <skos:prefLabel xml:lang="en">biochemical process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical processes occurring in living organisms.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus biochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesos bioquímicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biochemischer Vorgang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biochemische processen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биохимический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химические процессы, протекающие в живых организмах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية  كيميائية حيوية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/146" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/394" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/826" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3159" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5611" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/895" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/813">
    <skos:prefLabel xml:lang="en">biochemical substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical substances that occur in animals, microorganisms, and plants.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance biochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancias bioquímicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biochemische Stoffe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biochemische stoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биохимическое вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое вещество, встречающееся в организмах животных, растений и микроорганизмах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة كيميائية حيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/373" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1159" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1391" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2945" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4838" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5751" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6755" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8096" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8986" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/473" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11211">
    <skos:prefLabel xml:lang="en">phosphatic fertiliser</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fertilizer compound or mixture containing available (soluble) phosphate; examples are phosphate rock (phosphorite), superphosphates or triple superphosphates, nitrophosphate, potassium phosphate, or N-P-K mixtures.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">engrais phosphate</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fertilizante fosfático</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phosphatdünger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fosforzuurhoudende meststof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фосфорное удобрение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удобрение из одного вещества или смеси, содержащее растворимый фосфор; например, фосфорит, суперфосфат или трисуперфосфат, нитрофосфат, фосфат калия или N-P-K смеси.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سماد فوسفاتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4345" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/815">
    <skos:prefLabel xml:lang="en">biochemistry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of chemical substances occurring in living organisms and the reactions and methods for identifying these substances.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biochimie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bioquímica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biochemie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biochemie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биохимия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение химических веществ, встречающихся в составе живых организмов, реакции и методы для обнаружения этих веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الكيمياء الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1348" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9008">
    <skos:prefLabel xml:lang="en">waste income</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The total amount of refuse or unusable material that enters a process or system.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">revenu issu des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">insumo de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallaufkommen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inkomsten uit afval(herwerking)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общее количество отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общее количество отработанных или неиспользуемых материалов, которое попадает в процесс или систему по их переработке, вторичному использованию и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دخل من المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9095" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9108" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9126" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14965" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/818">
    <skos:prefLabel xml:lang="en">bioclimatology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of climate in relation to fauna and flora.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bioclimatologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bioclimatología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bioklimatologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioclimatologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоклиматология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение климата по отношению к флоре и фауне.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم المناخ الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1479" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/819">
    <skos:prefLabel xml:lang="en">biocoenosis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A community or natural assemblage of organisms; often used as an alternative to ecosystem but strictly is the fauna/flora association excluding physical aspects of the environment.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biocénose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biocenosis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biozönose</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioc(o)enose</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоценоз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сообщество или природное собрание организмов; часто термин используется в качестве синонима экосистемы, однако, строго говоря, биоценоз, главным образом, подразумевает взаимодействие флоры и фауны и исключает физические факторы окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجماعة الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8259" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/820">
    <skos:prefLabel xml:lang="en">bioconcentration factor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The quotient of the concentration of a chemical in aquatic organisms at a specific time or during a discrete time period of exposure, divided by the concentration in the surrounding water at the same time or during the same period.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">facteur de bioconcentration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">factor de bioconcentración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biokonzentrationsfaktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioconcentratie factor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоконцентрирующий фактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Величина содержания химического вещества в водном организме в конкретный момент или за конкретный период времени, разделенная на показатель содержания этого вещества в окружающей воде в тот же момент или за тот же период времени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معامل التركيز الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/821">
    <skos:prefLabel xml:lang="en">biodegradability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The extent to which a substance can be decomposed - or rotted - by bacteria and fungi.
Implies that residues from degradation are nontoxic. One of the most misleading claims in business, because shoppers often assume a biodegradable product to be harmless. Some harmful compounds take much longer to degrade than others and the product can harm the environment while it is rotting. Biodegradation may also be incomplete, sometimes leaving
residues in the environment which are more harmful than the original substance. Accumulation in the environment of nonbiodegradable (or poorly biodegradable) substances, such as some biocides, can cause serious problems.
(Source: VCN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biodégradabilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biodegradabilidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Abbaubarkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurlijke afbreekbaarheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">способность к биодеградации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Степень, до которой вещество может разложиться (или сгнить) под действием бактерий или грибов при условии, что остатки разложения не являются токсичными. Одно из самых дезориентирующих понятий в коммерческой деятельности, потому что покупатели часто ошибочно считают, что продукт, способный к биодеградации, является безвредным. Один из компонентов продукта может разлагаться гораздо дольше других, в результате сам продукт будет загрязнять окружающую среду в процессе своего разложения. Биодеградация может быть неполной, ее остатки могут представлять больший вред, чем исходный продукт. Накопление в окружающей среде продуктов, не способных к биодеградации (или слабо биодеградирующих), может представлять серьезную проблему.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القابلية للتحلل الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2039" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/823" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1651" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/823">
    <skos:prefLabel xml:lang="en">biodegradable pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pollutant which can be converted by biological processes into simple inorganic molecules.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant biodégradable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes biodegradables</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologisch abbaubarer Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurlijk afbreekbare verontreinigende stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биодеградирующее загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество, которое в результате биологических процессов может быть разложено на простые неорганические молекулы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوثات التحلل الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/821" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/826">
    <skos:prefLabel xml:lang="en">biodegradation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Breaking down of a substance by microorganisms.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biodégradation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biodegradación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologischer Abbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurlijke afbraak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биодеградация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разложение веществ под действием микроорганизмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحلل الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/812" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2040" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/879" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5269" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/827">
    <skos:prefLabel xml:lang="en">biodiversity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Genetic diversity: the variation between individuals and between populations within a species; species diversity: the different types of plants, animals and other life forms within a region; community or ecosystem diversity: the variety of habitats found within an area (grassland, marsh, and woodland for instance.
2) An umbrella term to describe collectively the variety and variability of nature. It encompasses three basic levels of organisation in living systems: the genetic, species, and ecosystem levels. Plant and animal species are the most commonly recognized units of biological diversity, thus public concern has been mainly devoted to conserving species diversity.
(Source: WRES /  GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">diversité biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biodiversidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Artenvielfalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biodiversiteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоразнообразие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Генетическое разнообразие: различия между людьми и видовыми популяциями; видовое разнообразие: различные типы растений, животных и других форм жизни, характерные для конкретного региона; разнообразие природного сообщества или экосистемы: разнообразие среды обитания, характерное для конкретного района, например, луга, болота и леса. 2) Общий термин, используемый для описания разнообразия и изменчивости природы. Подразумевает три базовых уровня организации в живых системах: генетический, видовой и уровень экосистемы. Растительные и животные виды - наиболее распространенные единицы биологического разнообразия, поэтому внимание общественности сосредоточено именно на сохранении видового разнообразия природы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنوع الحيوي - التنوع البيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3620" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9022">
    <skos:prefLabel xml:lang="en">wage system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">System which compensates the employees with a fixed sum per piece, hour, day or another period of time, covering all compensations including salary.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système de salaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema salarial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lohnform</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loonstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система оплаты труда</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, в соответствии с которой работники получают оплату за труд из расчета за единицу продукции, а также за час, за день или другой период времени, включающую выплату всех компенсаций, в том числе и зарплаты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام المرتبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3149" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9023">
    <skos:prefLabel xml:lang="en">wall</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A vertical construction made of stone, brick, wood, etc., with a length and height much greater than its thickness, used to enclose, divide or support.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">muro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">muur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стена</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вертикальная конструкция из камня, кирпича, дерева и пр., длина и высота которой намного превышают ее толщину; используется для ограждения, разделения или опоры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جدار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/832">
    <skos:prefLabel xml:lang="en">biogas</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Gas, rich in methane, which is produced by the fermentation of animal dung, human sewage or crop residues in an air-tight container. It is used as a fuel, to heat stoves, lamps, run small machines and to generate electricity. The residues of biogas production are used as a low-grade organic fertilizer. Biogas fuels do not usually cause any pollution to the atmosphere, and because they come from renewable energy resources they have great potential for future use.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biogaz</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biogás</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biogas</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biogas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биогаз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газ, богатый метаном, который выделяется в результате ферментации животных экскрементов, канализационных стоков или гниения отходов сельскохозяйственных культур. Используется в качестве топлива в быту, в небольших двигателях, а также для производства электричества. Отходы производства биогаза используются в качестве низкосортного органического удобрения. Топливо на основе биогаза, как правило, не загрязняет атмосферу, поэтому с учетом того, что  биогаз производится из возобновляемых природных источников, его использование в будущем является очень перспективным.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غاز حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12011" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5199" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/833">
    <skos:prefLabel xml:lang="en">biogeochemical cycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Movement of chemical elements in a circular pathway, from organisms to physical environment, back to organisms. The process is termed a nutrient cycle if the elements concerned are trace elements, which are essential to life. A biogeochemical cycle occurs when vegetation decomposes and minerals are incorporated naturally in the humus for future plant growth.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cycle biogéochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclos biogeoquímicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biogeochemischer Kreislauf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biogeochemische cyclus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биохимический цикл</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение химических элементов по кругу, из организмов в физическую среду и обратно в организмы. Процесс называется кругооборотом питательных веществ в случае, когда происходит движение элементов, необходимых для поддержания жизни. В ходе биохимического цикла растения разлагаются, и минеральные вещества естественным образом формируют гумус, который является источником будущего роста растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الدورة البيولوجية الجغرافية الكيميائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/798" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1164" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5607" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5759" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/834">
    <skos:prefLabel xml:lang="en">biogeochemistry</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">biogéochimie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biogeoquímica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biogeochemie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biogeochemie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биогеохимия</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الكيمياء الحيوية الجغرافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1348" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/835">
    <skos:prefLabel xml:lang="en">biogeographical region</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area of the Earth's surface defined by the species of fauna and flora it contains.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">régions biogéographiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">regiones biogeográficas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biogeographische Regionen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biogeografische gebieden</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биогеографический регион</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земной поверхности, характеризуемый определенным набором видов флоры и фауны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة جغرافية حيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4599" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/836">
    <skos:prefLabel xml:lang="en">biogeography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science concerned with the geographical distribution of animal and plant life.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biogéographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biogeografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biogeographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biogeografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биогеография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая географическое распределение животной и растительной жизни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جغرافيا حيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3646" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8719">
    <skos:prefLabel xml:lang="en">tween-deck tanker</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sea-going vessel that includes space between two continuous floor-like surfaces or platforms, which is also designed for bulk shipments of liquids or gases.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pétrolier à réservoir d'entrepont</skos:prefLabel>
    <skos:prefLabel xml:lang="es">petrolero de cubierta de tween</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zwischendeck-Tanker</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tussendektanker</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">двухпалубный танкер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Морское судно, в конструкции которого предусмотрено свободное пространство между двумя горизонтальными поверхностями или платформами, предназначенное для массовой транспортировки жидкостей или газа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ناقلة بترول ذات خزانات بين السطحين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8285" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/839">
    <skos:prefLabel xml:lang="en">biological activity</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">activité biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actividad biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aktivitaet (biologisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische activiteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая активность</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">نشاط حيوي - نشاط بيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9032">
    <skos:prefLabel xml:lang="en">warm-blooded animal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Animal which has a body temperature that stays the same and does not change with the temperature of its surroundings.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">animal à sang chaud</skos:prefLabel>
    <skos:prefLabel xml:lang="es">animal de sangre caliente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Warmblüter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">warmbloedig dier</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">теплокровное животное</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Животное, температура тела которого сохраняется на одном уровне и не изменяется при изменении температуры окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحيوانات ذات الدم الساخن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/450" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/841">
    <skos:prefLabel xml:lang="en">biological analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The analysis of a substance in order to ascertain its influence on living organisms.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологический анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Анализ вещества с целью выявления его влияния на живые организмы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل حيوي - تحليل بيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5216" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/861" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/842">
    <skos:prefLabel xml:lang="en">biological attribute</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Properties or features belonging to living organisms.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">attribut biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">atributos biológicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eigenschaft (biologisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische eigenschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологические свойства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойства или черты, присущие живым организмам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صفة بيولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9035">
    <skos:prefLabel xml:lang="en">warning system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any series of procedures and devices designed to detect sudden or potential threats to persons, property or the environment, often utilizing radar technology.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système d'alerte</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistemas de alerta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Warnsystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">alarmsysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система оповещения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система устройств, предназначенных для предупреждения об опасности, пожаре, взломе и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام إنذار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10054" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/293" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2398" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7760" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/846">
    <skos:prefLabel xml:lang="en">biological development</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The action of growing of living organisms.

(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">développement biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desarrollo biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Entwicklung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische ontwikkeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое  развитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс роста живых организмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تطور بيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/173" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12429">
    <skos:prefLabel xml:lang="en">residue of grinding</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Dust or other residue left after reducing a material to very small particles.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">résidu de broyage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo de pulido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zerkleinerungsrückstände</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">maalrest</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шлифовально-мельничные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пыль или другие остатки, образовавшиеся в процессе измельчения материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بقايا الطحن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7156" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9040">
    <skos:prefLabel xml:lang="en">wastage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Extravagant or useless consumption or expenditures.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gaspillage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desperdicio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überreste</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verspilling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">убыток</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Потеря в результате использования, износа, разложения и пр., а также в результате расточительности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إهدار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1743" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9041">
    <skos:prefLabel xml:lang="en">waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Material, often unusable, left over from any manufacturing, industrial, agricultural or other human process; Material damaged or altered during a manufacturing process and subsequently left useless.
(Source: HMD /  OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">soorten afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, часто неиспользуемый, оставшийся от производственного, сельскохозяйственного или иного процесса с участием человека. Материал, поврежденный или измененный в ходе промышленного процесса и потому пришедший в негодность.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات - نفايات</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9106" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9042">
    <skos:prefLabel xml:lang="en">waste air</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Exhaust or gaseous air given off by any industrial, manufacturing or chemical process.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effluent gazeux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aire de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abluft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvoerlucht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отработанный воздух</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газообразные выбросы, получаемые в ходе производственного, обрабатывающего или химического процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهواء المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3572" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9077" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/851">
    <skos:prefLabel xml:lang="en">biological engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The application of engineering principles and techniques to living organisms. It is largely concerned with the design of replacement body parts, such as limbs, heart valves, etc.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">génie biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotechnik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biotechnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоинженерия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение методов и приемов инженерии к живым организмам. В основном, это касается разработки и проектирования протезов, как, например, отдельные конечности, сердечные клапаны и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهندسة الحيوية - الهندسة البيولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/898" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9044">
    <skos:prefLabel xml:lang="en">waste analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An investigation carried out to decide what arrangements are appropriate for dealing with different kinds of wastes.
(Source: PORTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfalluntersuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Исследование, проводимое с целью установить, как надлежит обращаться с разными видами отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9079" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9057" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9045">
    <skos:prefLabel xml:lang="en">waste assimilation capacity</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">capacité d'assimilation des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">capacidad de asimilación de desechos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallassimilationsfähigkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vermogen om afval te op te nemen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">способность к ассимиляции отходов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">القدرة على استيعاب النفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2873">
    <skos:prefLabel xml:lang="en">environmentally related disease</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">maladie liée au milieu environnant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enfermedad relacionada con el medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltbedingte Krankheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aandoening die met het milieu te maken heeft</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">болезни, обусловленные воздействием окружающей среды</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مرض مرتبط بالبيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/849" />
