    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/541">
    <skos:prefLabel xml:lang="en">Arctic ecosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">écosystème arctique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema ártico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystem der Arktis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Arctisch ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема Арктики</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">النظام البيئي لأركتيك (القطب الشمالي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6362" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/542">
    <skos:prefLabel xml:lang="en">Arctic Ocean</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The smallest and most poorly studied of the oceans on earth. It covers an area of 14 million square km that is divided by three submarine ridges, i.e. the Alpha Ridge, the Lomonosov Ridge, and an extension of the mid-Atlantic ridge. It is also nearly landlocked, covered
year-round by pack ice, and the third of its area is continental shelf.
(Source: OCEAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">océan arctique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Océano Ártico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nordpolarmeer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Arctische Oceaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Северный Ледовитый океан</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Самый маленький и самый малоизученный из океанов на Земле. Покрывает площадь в 14 миллионов квадратных км, разделенную тремя подводными кряжами - Альфа, Ломоносова и продолжение Средне-Атлантического кряжа. Почти со всех сторон окружен сушей, круглый год покрыт паковым льдом; треть его площади занимает континентальный шельф.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المحيط المتجمد الشمالي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9380" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/543">
    <skos:prefLabel xml:lang="en">Arctic region</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The northernmost area of the earth, centered on the North Pole, that includes the Arctic Ocean, the northern reaches of Canada, Alaska, Russia, Norway and most of Greenland, Iceland and Svalbard.
(Source: INP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">région arctique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">región Ártica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arktis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Arctisch gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Арктический регион</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Самая северная зона Земли, расположенная вокруг Северного полюса; включает Северный Ледовитый океан, северные области Канады, России, Норвегии, в т.ч. арх.Свальбард, Гренландии, Исландии, а также штат Аляска (США).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة القطب الشمالي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6364" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/544">
    <skos:prefLabel xml:lang="en">distribution area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The overall geographical distribution of a talon. 
2) The range occupied by a community or other group.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de distribución</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fläche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">1) географические рамки действия юридического документа, 2) ареал распространения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Географические рамки действия юридического документа. 2) Ареал распространения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10496" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/547">
    <skos:prefLabel xml:lang="en">area of potential pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area which is supposedly causing dangers to human health and environment.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone de pollution potentielle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de contaminación potencial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verdachtsfläche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mogelijk vervuild gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ареал потенциального загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок, который предположительно несет угрозу здоровью человека или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة تلوث محتمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12783" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5857" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8742">
    <skos:prefLabel xml:lang="en">ultraviolet radiation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The part of the electromagnetic spectrum with wavelengths shorter than light but longer than x-rays; in the range of 4-400 nm.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rayonnement ultraviolet</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radiación ultravioleta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">UV-Strahlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ultraviolette straling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ультрафиолетовое излучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть электромагнитного спектра, длина волн которого короче, чем свет, но длиннее, чем рентгеновские лучи в диапазоне 4-400 нм.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأشعة فوق البنفسجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4491" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5674" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/551">
    <skos:prefLabel xml:lang="en">arid land ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interacting system of a biological community and its non-living environmental surroundings in a climatic region where the annual precipitation averages less than 10 inches per year.
(Source: TOE / DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème des terres arides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema árido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystem eines Trockengebietes</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecosysteem van een onvruchtbaar gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема аридных (засушливых) земель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимодействующая система биологического сообщества и неживых элементов окружающей среды, находящаяся в климатических условиях, характеризуемых средним уровнем осадков менее 10 дюймов в год.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للأراضي القاحلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/552">
    <skos:prefLabel xml:lang="en">arid land</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Lands characterized by low annual rainfall of less than 250 mm, by evaporation exceeding precipitation and a sparse vegetation.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">terre aride</skos:prefLabel>
    <skos:prefLabel xml:lang="es">terreno árido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trockengebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onvruchtbaar gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аридные (засушливые) земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Земли, на которые выпадает осадков менее 250 мм в год. На этих землях испарение воды превышает количество выпадающих осадков, а растительность скудна.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أرض قاحلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8386" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8745">
    <skos:prefLabel xml:lang="en">UNCED</skos:prefLabel>
    <skos:scopeNote xml:lang="en">United Nations Conference on Environment and Development, Rio de Janeiro, Brazil, 1992.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Conférence des Nations-Unies sur l'environnement et le développement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">CNUMAD</skos:prefLabel>
    <skos:prefLabel xml:lang="de">UNCED</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">VN-Conferentie over Milieu en Ontwikkeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Конференция Организации Объединенных Наций по окружающей среде и развитию (г. Рио-де-Жанейро, Бразилия, 1992 г.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Конференция Организации Объединенных Наций по окружающей среде и развитию (г. Рио-де-Жанейро, Бразилия, 1992 г.)</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مؤتمر الأمم المتحدة حول البيئة والتنمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8776" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8747">
    <skos:prefLabel xml:lang="en">uncontrolled dump</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Place where waste is left on the ground and not buried in a hole.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge sauvage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertederos incontrolados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wilde Deponie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ongecontroleerde storting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">открытая свалка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где отходы размещаются по поверхности земли и не закапываются в грунт.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قمامة متروكة في العراء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/556">
    <skos:prefLabel xml:lang="en">armament</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The weapons, ammunition and equipment, or the total force held by a military unit or state.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">armement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">armamento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewaffnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wapens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вооружение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Вооружение на борту военного транспортного средства, судна или самолета. 2) Военная сила, готовая к войне.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التسليح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5243" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/557" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9267" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/557">
    <skos:prefLabel xml:lang="en">armament conversion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Change in character, form or function of the arms and equipment with which a military unit is supplied.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">conversion de l'armement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conversión de armamento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rüstungskonversion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wapenomschakeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">конверсия вооружений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изменение характера, формы или функций вооружений или военного оборудования, которым оснащена единица военной техники.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تغيير نوعية التسليح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4441" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/556" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2254" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/558">
    <skos:prefLabel xml:lang="en">armed forces</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The military units of a state, typically divided by their differing contexts of operations, such as the army, navy, air force and marines.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">forces armées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuerzas armadas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Militär</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">strijdkrachten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вооруженные силы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Военные силы страны, включая армию, флот, авиацию, морскую пехоту и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قوات مسلحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13292" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1528" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5243" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13220" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8285">
    <skos:prefLabel xml:lang="en">tanker (ship)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A ship designed for bulk shipment of liquids or gases.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">navire-citerne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">petrolero (nave)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tankschiff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tankschip</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">танкер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Судно, предназначенное для перевозки жидкостей или газов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سفينة شحن مواد سائلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7654" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5854" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8719" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/560">
    <skos:prefLabel xml:lang="en">aromatic compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Compounds characterized by the presence of at least one benzene ring.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé aromatique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos aromáticos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verbindung (aromatisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aromatische verbindingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ароматические соединения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединения, в состав которых входит по меньшей мере одно бензиновое кольцо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب أروماتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/562" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2824">
    <skos:prefLabel xml:lang="en">environmental health</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The art and science of the protection of good health, the prevention of disease and injury through the control of positive environmental factors, and the reduction of potential physical, biological, chemical and radiological hazards.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hygiène de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salud ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umelthygiene</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuhygiëne</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">санитарное состояние окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука и искусство сохранения хорошего здоровья, предотвращения болезней и увечий вследствие контроля за положительными факторами окружающей среды, снижения потенциальных физических, биологических, химических или радиологических угроз.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصحة البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3865" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2873" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/562">
    <skos:prefLabel xml:lang="en">aromatic hydrocarbon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Hydrocarbons having an unsaturated ring containing alternating double and single bonds, especially containing a benzene ring.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydrocarbure aromatique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hidrocarburos aromáticos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">aromatischer Kohlenwasserstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aromatische koolwaterstoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ароматический углеводород</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Углеводороды, в состав которых входит ненасыщенное кольцо, содержащее чередующиеся двойные и единичные связи, также часто включают бензиновое кольцо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيدروكربون أروماتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/560" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/776" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8755">
    <skos:prefLabel xml:lang="en">landfill base sealing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sealing of a landfill with a relatively impermeable barrier designed to keep leachate inside. Liner materials include plastic and dense clay.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étanchéité de base de décharge</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aislamiento de base de vertido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Deponiebasisabdichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afsluiting van de onderlaag van een afvalstortplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидроизоляция мусорной ямы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нанесение гидроизолирующего материала, препятствующего вытеканию образовавшейся жидкости из мусорной ямы. К таким материалам относятся пластмассы и глина.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غلق محكم لمقلب مخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7516" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/564">
    <skos:prefLabel xml:lang="en">aromatic substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substance having a distinctive, usually fragrant smell.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance aromatique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancia aromática</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geruchsstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geurstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ароматическое вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, обладающее отчетливым, часто приятным запахом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة أروماتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3356" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3287" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/566">
    <skos:prefLabel xml:lang="en">arrangement for a deposit on packaging</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Agreement to provide refunds or payments in exchange for used bottles or packaging materials.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure en faveur d'une consigne sur les emballages</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acuerdo sobre depósito en embalaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pfandregelung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">statiegeldregeling voor verpakking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">депозит за возвратную тару</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Договоренность, в рамках которой возмещаются расходы или выплачивается компенсация в обмен на использованные бутылки или другую упаковку.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترتيبات دفع رهن للفوارغ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/567">
    <skos:prefLabel xml:lang="en">arsenic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A toxic metalloid element, existing in several allotropic forms, that occurs principally in realgar and orpiment and as the free element. It is used in transistors, lead-based alloys, and high temperature brasses.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arsenic</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arsénico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arsen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">arseen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мышьяк</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ядовитый элемент группы металлоидов, существует в нескольких аллотропных формах, в природе встречается главным образом в виде реальгара или опермента, а также как свободный элемент. Используется в транзисторах, сплавах на основе свинца и высокотемпературном производстве латуни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زرنيخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2640" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/568">
    <skos:prefLabel xml:lang="en">art</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The creation of works of beauty or other special significance.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">art</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kunst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kunst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">искусство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Создание художественных или других творческих произведений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8761">
    <skos:prefLabel xml:lang="en">underprivileged people</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A segment of the population that does not have access to the rights or benefits granted to the rest of society, often because of low economic or social status.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">population sous-privilégiée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gente desprotegida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterprivilegierte Personen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kansarmen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неимущие слои населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Слои населения, не имеющие доступа к правам и привилегиям, которыми пользуется остальное население, часто в силу низкого экономического или социального статуса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السكان المحرومون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6861" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8762">
    <skos:prefLabel xml:lang="en">undertaking business</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any commercial activity, position or site associated with the preparation of the dead for burial and the management and arrangement of funerals.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">entreprise commerciale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">empresa funeraria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Leichenbestattung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderneming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">похоронная служба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Коммерческая деятельность или место, связанные с подготовкой умерших к захоронению, а также организацией и подготовкой процедуры похорон.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أعمال الدفن والجنائز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/571">
    <skos:prefLabel xml:lang="en">arthropod</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The largest phylum in the animal kingdom; adults typically have segmented body, a sclerotized integument, and many-jointed segmental limbs.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arthropodes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">artrópodos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arthropoden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geleedpotigen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">артроподы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупнейший тип в царстве зверей; взрослые особи, как правило, имеют сегментированное тело, склеротический наружный покров и членистые конечности с множеством суставов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المِفصليات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/572" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1296" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/572">
    <skos:prefLabel xml:lang="en">Articulata</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Animals characterized by the repetition of similar segments (metameres), exhibited especially by arthropods, annelids, and vertebrates in early embryonic stages and in certain specialized adult structures.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">articulata</skos:prefLabel>
    <skos:prefLabel xml:lang="es">articulados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gliedertier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Articulata</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">членистые</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Представители животного мира, в строении которых повторяются схожие сегменты (метамеры). Эти черты проявляются у артроподов, кольчатых червей, у позвоночных на ранних эмбриональных стадиях развития и у взрослых особей отдельных видов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأثل - الطرفاء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4475" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/456" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/571" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2826">
    <skos:prefLabel xml:lang="en">environmental health impact assessment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Assessment of impacts caused by an action on the health conditions of a population.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation de l'impact des conditions de vie sur la santé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Evaluación de impacto de salud ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umwelthygienische Verträglichkeitsprüfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderzoek effect op miliehygiëne</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка степени воздействия на здоровье населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка отрицательного влияния какого-либо действия на состояние здоровья населения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم الأثر على الصحة البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4159" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8766">
    <skos:prefLabel xml:lang="en">underwater outlet</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Point of water disposal located below the sea surface.
(Source: LANDYa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déversoir sous-marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">emisarios submarinos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterwasserabfluß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderwater uitlaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подводный сток</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сброс воды, осуществляемый ниже уровня моря.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منفذ تحت الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4082" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2474">
    <skos:prefLabel xml:lang="en">trophic ecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the feeding relationships of organisms in communities and ecosystems. Trophic links between populations represent flows of organisms, organic energy and nutrients. Trophic transfers are important in population dynamics, biogeochemistry, and ecosystem energetics.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écologie trophique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología trófica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Trophische Ökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">trofische ecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">трофическая экология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение пищевых взаимосвязей между живыми организмами и экосистемами. Трофические связи между популяциями отражают потоки организмов, органической энергии и питательных веществ. Трофический обмен важен для развития популяции, биохимических и энергетических процессов в экосистеме.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التغذية الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8768">
    <skos:prefLabel xml:lang="en">unemployment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The condition of being without remunerative employment.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chômage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desempleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeitslosigkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werkloosheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">безработица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пребывание человека без оплачиваемой работы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البطالة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8769">
    <skos:prefLabel xml:lang="en">ungulate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Hoofed mammals, including the Artiodactyla and Perissodactyla.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ongulé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ungulados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Huftiere</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hoefdieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">копытные</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Копытные млекопитающие, включая представителей Artiodactyla и Perissodactyla.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ذوات الحوافر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4982" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/977" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2029" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2955" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6645" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10444" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/579">
    <skos:prefLabel xml:lang="en">artificial lake</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Lakes created behind manmade barriers.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lac artificiel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lago artificial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Künstlicher See</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stuwmeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">искусственное озеро</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Озера, созданные внутри ограждений, возведенных человеком.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بحيرة صناعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7138" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8776">
    <skos:prefLabel xml:lang="en">United Nations</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A voluntary association of around 180 state signatory to the UN charter (1945), whose primary aim is to maintain international peace and security, solve economic, social, and political problems through international co-operation, and promote respect for human rights.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Nations Unies</skos:prefLabel>
    <skos:prefLabel xml:lang="es">naciones Unidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vereinte Nationen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Verenigde Naties</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Организация Объединенных Наций</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Добровольная организация, объединяющая около 180 государств, подписавших Устав ООН (1945 г.), основное назначение которой является поддержание международного мира и безопасности, решение экономических, социальных и политических проблем через международное сотрудничество, содействие в соблюдении прав человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأمم المتحدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4434" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8745" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9221">
    <skos:prefLabel xml:lang="en">water resource</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water in any of its forms, wherever located - atmosphere, surface or ground - which is or can be of value to man.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ressource en eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recursos hídricos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbronnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водный ресурс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода в любой из своих форм, в любом месте нахождения - в атмосфере или на поверхности земли, которая представляет или может представлять ценность для человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مورد مائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5521" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3494" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/587">
    <skos:prefLabel xml:lang="en">artificial satellite</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any man-made object placed in a near-periodic orbit in which it moves mainly under the gravitational influence of one celestial body, such as the earth, sun, another planet, or a planet's moon.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">satellite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">satélites artificiales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Künstlicher Satellit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kunstmaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">искусственный спутник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой объект, созданный руками человека и запущенный на орбиту, по которой он двигается под воздействием силы гравитации какого-либо небесного тела, как, например, Земля, Солнце, другая планета или ее спутник.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قمر صناعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11706" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6253" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7452" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/36" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8780">
    <skos:prefLabel xml:lang="en">unleaded petrol</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Petrol with a low octane rating, which has no lead additives in it and therefore creates less lead pollution in the atmosphere.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">carburant sans plomb</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gasolina sin plomo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bleifreies Benzin</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loodvrije benzine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">топливо с низким октановым числом (низким содержанием свинца)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Топливо с низким октановым числом не имеет примесей свинца и поэтому не загрязняет свинцом атмосферу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بنزين خالي من الرصاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6156" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8782">
    <skos:prefLabel xml:lang="en">clean air area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Areas where significant reductions in ozone forming pollutants have been achieved through
industrial initiatives to control and/or prevent pollution, through implementation of transportation improvement plans, national efforts to reduce automobile tailpipe emissions and lower the volatility (evaporation rate) of gasoline.
(Source: CIHUNT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone d'air pur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona de aire limpio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reinluftgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">niet verontreinigde deel van de atmosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">район чистого воздуха</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Районы, где достигнуто значительное сокращение выбросов озонобразующих загрязняющих веществ в результате реализации промышленных программ по контролю и/или предотвращению загрязнения, программ совершенствования транспорта, национальных программ по снижению загрязнения автомобильными выхлопами и понижению летучести (скорости испарения) бензина.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة نظيفة الهواء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/591">
    <skos:prefLabel xml:lang="en">asbestos</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Generic name for a group of fibrous mineral silicates. It includes blue asbestos (crocidolite), white asbestos (chrysotile) and brown asbestos (amosite). After they are mined the asbestos fibres are separated from the rock and are spun into a cloth. When inhaled the fibres penetrate the lungs and the tissues of the bronchial tubes, resulting in asbestosis, a crippling lung disease. Asbestos also causes cancer of the lung and the gastro-intestinal tract, and mesothelioma, a malignant cancer of the inner lining of the chest. However, because it is a poor conductor of electricity and highly resistant to heat it has been widely used over the years in fire-fighting suits, and building and insulating materials. The fibrous form of several silicate minerals, at one time widely used for electrical and thermal insulation; the use of all forms of asbestos is now either banned or strictly controlled in many countries since it causes cancer.
(Source: WRIGHT /  ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">amiante</skos:prefLabel>
    <skos:prefLabel xml:lang="es">amianto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Asbest</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">asbest</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">асбест</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общий термин, относящийся к группе минеральных волокнистых силикатов. Включает голубой асбест (крокидолит), белый асбест (хризотил) и коричневый асбест (амозит). После добычи минерального сырья, волокна асбеста отделяются от породы и идут на изготовление технических тканей. При вдыхании волокна асбеста проникают в легкие и ткани бронхов, вызывая такое тяжелое заболевание, как асбестоз. Асбестоз приводит к развитию рака легких и органов пищеварительного тракта, а также образованию мезателиомы, злокачественной опухоли внутренней поверхности грудной клетки. Тем не менее, благодаря высокой термостойкости и низкой электропроводимости, этот материал длительное время широко использовался в производстве одежды для пожарных, в строительстве и производстве изоляционных материалов. В настоящее время во многих странах использование асбеста в любой форме либо запрещено, либо находится под строгим контролем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسبستوس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5675" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5510" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8203">
    <skos:prefLabel xml:lang="en">sulphuric acid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A toxic, corrosive, strongly acid, colorless liquid that is miscible with water and dissolves most metals, and melts at 10C; used in industry in the manufacture of chemicals, fertilizers and explosives, and in petroleum refining.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acide sulfurique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ácido sulfúrico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwefelsäure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwavelzuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">серная кислота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Токсичная, коррозионная, сильно кислая, бесцветная жидкость, смешиваемая с водой; растворяет почти все металлы, кипит при температуре 10 градусов С; используется в промышленности для производства химикатов, минеральных удобрений, взрывчатых веществ, а также в ходе нефтепереработки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمض الكبريتيك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8785">
    <skos:prefLabel xml:lang="en">upbringing</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">éducation (formation)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">educación (formación)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aufzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">opvoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">воспитание</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تربية - تنشئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2547" />
