    <adms:last rdf:resource="http://inspire.ec.europa.eu/featureconcept/SpatialPlan" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <skos:topConceptOf rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:42 PM CEST</dct:created>
    <dct:title xml:lang="en">Spatial Plan</dct:title>
    <skos:prefLabel xml:lang="en">Spatial Plan</skos:prefLabel>
    <dct:description xml:lang="en">A set of documents that indicates a strategic direction for the development of a given geographic area, states the policies, priorities, programmes and land allocations that will implement the strategic direction and influences the distribution of people and activities in spaces of various scales. Spatial plans may be developed for urban planning, regional planning, environmental planning, landscape planning, national spatial plans, or spatial planning at the Union level.</dct:description>
    <skos:definition xml:lang="en">A set of documents that indicates a strategic direction for the development of a given geographic area, states the policies, priorities, programmes and land allocations that will implement the strategic direction and influences the distribution of people and activities in spaces of various scales. Spatial plans may be developed for urban planning, regional planning, environmental planning, landscape planning, national spatial plans, or spatial planning at the Union level.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/lu" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
