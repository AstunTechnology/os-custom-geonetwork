    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:42 PM CEST</dct:created>
    <dct:title xml:lang="en">Supplementary Regulation</dct:title>
    <skos:prefLabel xml:lang="en">Supplementary Regulation</skos:prefLabel>
    <dct:description xml:lang="en">A spatial object (point, line or polygon) of a spatial plan that provides supplementary information and/or limitation on the use of land/water,necessary for spatial planning reasons or to formalise external rules defined in legal text.</dct:description>
    <skos:definition xml:lang="en">A spatial object (point, line or polygon) of a spatial plan that provides supplementary information and/or limitation on the use of land/water,necessary for spatial planning reasons or to formalise external rules defined in legal text.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/lu" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
