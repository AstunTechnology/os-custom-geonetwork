  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3510">
    <skos:prefLabel xml:lang="en">fuel consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of fuel utilized.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">consommation de combustible</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consumo de combustible</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kraftstoffverbrauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">brandstofverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребление топлива</skos:prefLabel>
