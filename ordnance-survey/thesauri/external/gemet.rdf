    <skos:prefLabel xml:lang="en">mushroom</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A family of Basidiomycetes that are characterized by the production of spores on gills.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">champignon (comestible)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">setas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Großpilz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">paddestoel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гриб</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Семейство Basidiomycetes, представители которого производят споры, расположенные на гимениальных пластинах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عيش الغراب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/733" />
