    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11990">
    <skos:prefLabel xml:lang="en">power station derating</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process by which a power plant is finally taken out of operation.
(Source: ECHO1a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déclassement de centrale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reducción de potencia de central eléctrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steuerbefreiung von Kraftwerken</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderbelasting van een elektriciteitscentrale</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отключение электростанции</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого электростанция выводится из работы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إخراج محطة طاقة من الخدمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4040" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7185" />
