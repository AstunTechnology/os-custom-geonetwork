    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4095" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4391" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4509" />
