  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8829">
    <skos:prefLabel xml:lang="en">urban planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The activity of designing, organizing or preparing for the future lay-out and condition of a city or town.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">planification urbaine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación urbana</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stedelijke planning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городское планирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, связанная с проектированием, организацией и подготовкой будущего генерального плана и состояния города или поселка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخطيط الحضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4635" />
