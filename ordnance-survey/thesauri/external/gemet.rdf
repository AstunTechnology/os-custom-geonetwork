    <skos:prefLabel xml:lang="es">higiene</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hygiene</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hygiëne</skos:prefLabel>
