    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6842">
    <skos:prefLabel xml:lang="en">purification plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Installation where impurities are removed from waste water.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station d'épuration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planta de depuración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reinigungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuiveringsinstallatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистной завод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Завод, использующий технологические установки для удаления примесей из сточной воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة تنقية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9211" />
