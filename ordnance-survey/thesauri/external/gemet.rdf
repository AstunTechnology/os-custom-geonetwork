    <skos:prefLabel xml:lang="es">compuestos organometálicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Metallorganische Verbindung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische metaalverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">металлсодержащее органическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Молекулы, содержащие связь углерод-металл; соединение, состоящее из радикала алкила или арила, связанного с металлом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب عضوي فلزي - مركب معدني عضوي</skos:prefLabel>
