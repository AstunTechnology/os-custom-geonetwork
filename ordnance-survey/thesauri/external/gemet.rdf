  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10097">
    <skos:prefLabel xml:lang="en">cleanliness (hygiene)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The state of being clean and keeping healthy conditions.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">propreté</skos:prefLabel>
    <skos:prefLabel xml:lang="es">limpieza (higiene)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sauberkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zindelijkheid [hygiëne]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">чистота (гигиена)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние чистоты и здоровья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظافة (صحة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4126" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10099">
    <skos:prefLabel xml:lang="en">industrial environment (in general)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Environment where the manifold activities connected with the production of goods and services take place.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">environnement industriel (généralités)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medio ambiente industrial (en general)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Industrieumwelt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">industriële omgeving (in het algemeen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">промышленная среда (общий термин)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Среда, в которой происходит различная деятельность, связанная с производством товаров и услуг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البيئة الصناعية (بوجه عام)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4258" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12450" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13106">
    <skos:prefLabel xml:lang="en">groundwater quality</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Groundwater accounts for over 95% of the earth's useable fresh-water resources; over half the world's population depends on groundwater for drinking-water supplies. This invisible resource is vulnerable to pollution and over-exploitation. Effective conservation of groundwater supplies requires the integration of land-use and water management.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">qualité des eaux souterraines</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calidad de las aguas subterráneas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grundwasserqualität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondwaterkwaliteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">качество подземных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">На долю грунтовых вод приходится 95% всех пресноводных ресурсов Земли; более половины населения во всем мире получает питьевую воду из подземных источников. Этот невидимый ресурс очень чувствителен по отношению к загрязнению, а также избыточной эксплуатации. Эффективность сохранения запасов грунтовых вод во многом зависит от интеграции принципов землепользования и управления водными ресурсами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوعية المياه الجوفية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1909">
    <skos:prefLabel xml:lang="en">cultural development</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process whereby the capabilities or possibilities inherent in a people's beliefs, customs, artistic activity and knowledge are brought out or made more effective.
(Source: PPP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">développement culturel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desarrollo cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kulturelle Entwicklung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">culturele ontwikkeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">культурное развитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в рамках которого возможности или способности, содержащиеся в представлениях, верованиях, художественной деятельности отдельных людей становятся общенародным достоянием или совершенствуются.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنمية الثقافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2413">
    <skos:prefLabel xml:lang="en">Eastern Europe</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A geographic region of the European continent west of Asia and east of Germany and the Adriatic Sea, traditionally consisting of countries that were formerly part of the Soviet Union, such as Poland, the Czech Republic, Slovakia, Hungary, Romania, Serbia, Croatia and Bulgaria.
(Source: INP / CIA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Europe de l'Est</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Europa oriental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Osteuropa</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Oost-Europa</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Восточная Европа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Географический регион на европейской территории к западу от Азии и к востоку от Адриатического моря, включающий территории государств, в прошлом входивших в социалистический лагерь, таких как Польша, Румыния, Болгария, Венгрия, Словакия, Чехия, Сербия, Хорватия и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أوروبا الشرقية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2992" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14842" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1911">
    <skos:prefLabel xml:lang="en">cultural facility</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any building or structure used for programs or activities involving the arts or other endeavors that encourage refinement or development of the mind.
(Source: WCD / OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équipement culturel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equipamiento cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kulturelle Einrichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">culturele voorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">учреждение культуры</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مرفق ثقافي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/529" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/969" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2285" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3974" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3977" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4567" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4793" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5360" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5444" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7129" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7465" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8608" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9422" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10651" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10652" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13041" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1921" />
