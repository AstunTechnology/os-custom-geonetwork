  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6818">
    <skos:prefLabel xml:lang="en">public transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or the means of conveying people in mass as opposed to conveyance in private vehicles.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport en commun</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte público</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öffentlicher Verkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">openbaar vervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общественный транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или средства массового перемещения пассажиров в отличие от передвижения на частном транспорте.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل العام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8653" />
