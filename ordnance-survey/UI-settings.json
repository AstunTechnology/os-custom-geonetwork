    "admin": {
      "enabled": true,
      "appUrl": "../../{{node}}/{{lang}}/admin.console"
    },
    "signin": {
      "enabled": true,
      "appUrl": "../../{{node}}/{{lang}}/catalog.signin"
    },
    "signout": {
      "appUrl": "../../signout"
    },
    "page": {
      "enabled": true,
      "appUrl": "../../{{node}}/{{lang}}/catalog.search#/page"
