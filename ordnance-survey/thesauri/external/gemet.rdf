  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/527">
    <skos:prefLabel xml:lang="en">arboriculture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The planting and care of woody plants, especially trees.
(Source: AMHER)</skos:scopeNote>
