    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1888">
    <skos:prefLabel xml:lang="en">cruising</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Travelling by sea in a liner for pleasure, usually calling at a number of ports.
(Source: CED)</skos:scopeNote>
