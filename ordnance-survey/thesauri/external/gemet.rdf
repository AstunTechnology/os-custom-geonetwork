    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13336">
    <skos:prefLabel xml:lang="en">marital status</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The standing of an individual with regard to a legally recognized conjugal relationship, either in the present or past.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">situation de famille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">situación familiar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Familienstand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gezinstoestand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">семейное положение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние физического лица по отношению к брачным узам в прошлом или настоящем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحالة الاجتماعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7796" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6290">
    <skos:prefLabel xml:lang="en">planning law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to organize, designate and regulate land use within its domain through zoning laws, subdivision regulations, rent and sign controls, growth management and other measures designed to protect human health and ecological integrity.
(Source: PLA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation sur la planification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley de planificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Planungsrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetgeving inzake de ruimtelijke planning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законы в области планирования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, установленных государством в целях организации, распределения и использования земель через систему различных подзаконных актов, правил и других мер, направленных на защиту здоровья человека и сохранение экологической целостности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون التخطيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4715" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7089" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8805" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6291">
    <skos:prefLabel xml:lang="en">planning measure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A procedure or course of action taken to design, organize or prepare for the future.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure d'aménagement du territoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medidas de planificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Planungsmaßnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">planologische maatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мера планирования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процедура или действия, предпринятые для того, чтобы задумать, организовать и подготовиться к будущему.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدابير التخطيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/740" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7709" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8803" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8839" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8844" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9225" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9417" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12459" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6287" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6292">
    <skos:prefLabel xml:lang="en">planning permission</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An authorization, license or equivalent control document issued by a government agency that approves a step by step method and process of defining, developing and outlining various possible courses of action to meet existing or future needs, goals and objectives.
(Source: TOE / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">permis d'aménagement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">permiso de planificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Planfeststellung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bouwvergunning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разрешение на планирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разрешение, лицензия или аналогичный документ, выданный государственным органом, который одобряет поэтапный метод и процесс определения, развития и проектирования различных направлений действий в целях достижения текущих или будущих потребностей, целей и задач.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التصريح بالتخطيط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6124" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6293">
    <skos:prefLabel xml:lang="en">Planning-Programming-Budgeting System</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system to achieve long-term goals or objectives by means of analysis and evaluation of the alternatives. PPB is designed to solve problems by finding the most effective and most efficient solution on the basis of objective criteria.
(Source: GREENW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rationalisation des choix budgétaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de planificación-programación-presupuesto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Planning-Programming-Budgeting</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plannings- en begrotings systeem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система комплексного планирования и программирования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система достижения долгосрочных целей посредством анализа и оценки альтернатив. Предназначена для решения проблем в ходе установления наиболее эффективных и экономичных решений на основе анализа объективных данных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام وضع الخطة والبرنامج والميزانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2889" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9241">
    <skos:prefLabel xml:lang="en">water statistics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">statistiques portant sur l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estadísticas hidráulicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserstatistik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">watergegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистика водного хозяйства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إحصائيات مائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8076" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4906">
    <skos:prefLabel xml:lang="en">long-term effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Effects which will last long after the cause has ceased.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet à long terme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto a largo plazo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Langzeitwirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">langetermijneffect</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">долгосрочное воздействие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воздействие, которое будет продолжаться дольше срока существования его причины.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أثر بعيد المدى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2562" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4907" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6298">
    <skos:prefLabel xml:lang="en">plant breeding</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Raising a certain type of plant by crossing one variety with another to produce a new variety where the desired characteristics are strongest.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sélection des plantes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultivo de plantas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantenveredeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение определенных видов растений в результате селекции и выведения сорта, у которого желаемое свойство проявляется наиболее сильно.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تربية النباتات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7588" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4080" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6299">
    <skos:prefLabel xml:lang="en">plant community</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any group of plants belonging to a number of different species that co-occur in the same habitat or area and interact through trophic and spatial relationships; typically characterized by reference to one or more dominant species.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">communauté végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comunidad vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzengesellschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantengemeenschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">популяция растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа растений, принадлежащих к разным видам, обитающих в одних условиях или на одном участке, взаимодействующих в рамках трофических или пространственных взаимоотношений; обычно характеризуется выделением одного или нескольких доминирующих видов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المجتمع النباتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1613" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8922" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10574" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6300">
    <skos:prefLabel xml:lang="en">plant component</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The constituent parts of a plant.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">partie de la plante</skos:prefLabel>
    <skos:prefLabel xml:lang="es">partes de la planta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenteil</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantendeel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">часть растения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Элементы растения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكونات النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5890" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3312" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3350" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3498" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4730" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6392" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7312" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13576">
    <skos:prefLabel xml:lang="en">eco-balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An eco-balance refers to the consumption of energy and resources and the pollution caused by the production cycle of a given product. The product is followed throughout its entire life cycle, from the extraction of the raw materials, manufacturing and use, right through to recycling and final handling of waste.
(Source: DUNI)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écobilan</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio ecológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökobilanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecologisch evenwicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экобаланс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экобаланс имеет отношение к потреблению энергии и ресурсам, а также загрязнению, вызываемому производственным циклом конкретного продукта. Отслеживается весь жизненный цикл продукта - от момента добычи сырья, изготовления и использования до момента вторичного использования и окончательной утилизации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الميزان الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2799" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6304">
    <skos:prefLabel xml:lang="en">plant disease</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">pathologie végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enfermedades de las plantas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenkrankheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">planteziekte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">болезнь растения</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مرض نباتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1393" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1874" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6316" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6305">
    <skos:prefLabel xml:lang="en">plant equipment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The equipment, including machinery, tools, instruments, and fixtures necessary for an industrial or manufacturing operation.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équipement d'usine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equipo de planta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anlagenausrüstung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fabrieksuitrusting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заводское оборудование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оборудование, включая машины, приборы, инструменты и пр., необходимые для промышленного или обрабатывающего процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معدات المصنع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14499">
    <skos:prefLabel xml:lang="en">excise</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">accise</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arbitrios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verbrauchsteuer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verbruiksbelasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">акциз</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">ضريبة الإنتاج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6309">
    <skos:prefLabel xml:lang="en">plant health care</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">phytosanitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanidad vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Betriebsgesundheitsfürsorge</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">arbeidsveiligheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фитосанитария</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الرعاية الصحية للنبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3866" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6310">
    <skos:prefLabel xml:lang="en">plant protection product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any substance or mixture of substances which through physiological action protects the plants against parasites, fungi, virus, or other damaging factors.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit phytosanitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos fitosanitarios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenschutzmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gewasbeschermingsmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">продукт для защиты растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество или смесь веществ, которые в результате физиологического действия защищают растения от паразитов, грибов, вирусов или других угрожающих факторов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتج لحماية النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/237" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1874" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6312">
    <skos:prefLabel xml:lang="en">plantigrade</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pertaining to mammals walking with the whole sole of the foot touching the ground.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plantigrades</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plantígrado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sohlengänger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoolgangers</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стопоходящие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин относится к млекопитающим, у которых во время движения вся подошва стопы касается поверхности земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حيوان أُخمُصي السير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8946" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6313">
    <skos:prefLabel xml:lang="en">planting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The establishment of trees by planting seedlings, transplants, or cuttings.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plantation (d'arbres)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">establecimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bepflanzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">planten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">посадка деревьев</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Насаждение деревьев в результате высадки молодых растений, саженцев и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الزراعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14507">
    <skos:prefLabel xml:lang="en">dipteran</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">diptères</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dipteros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zweiflügler</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tweevleugeligen [insecten]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">двукрылый</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">ذو الجناحين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6316">
    <skos:prefLabel xml:lang="en">plant physiology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the function and chemical reactions within the various organs of plants.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">physiologie des plantes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fisiología vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenphysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantenfysiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физиология растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение функций и химических реакций в различных органах растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيسيولوجيا النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6240" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/605" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/971" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6244" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6304" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6318">
    <skos:prefLabel xml:lang="en">plant protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Conservation of plant species that may be rare or endangered, and of other plants of particular significance.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection des plantes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de las plantas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gewasbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Защита редких растительных видов, видов растений, существование которых находится под угрозой или других растений особой важности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10064" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6319">
    <skos:prefLabel xml:lang="en">testing of plant protection products</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Tests performed to establish the effectiveness of pesticides under a wide variety of climatic and other environmental conditions; to assess the possible side effects on animals, plants and humans and to determine the persistence of pesticide residues in the environment.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">essai de produits phytosanitaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prueba de productos de protección de las plantas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenschutzmittelprüfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">testen van plantenbeschermende producten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">испытание продуктов для защиты растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Опыты, проводимые для установления эффективности пестицидов для разных климатических и других экологических условий; устанавливают возможные отрицательные последствия для животных, растений, людей, а также экологическую стойкость остатков пестицидов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار منتجات حماية النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8412" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6323">
    <skos:prefLabel xml:lang="en">plant (biology)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any living organism that typically synthesizes its food from inorganic substances, possesses cellulose cell walls, responds slowly and often permanently to a stimulus, lacks specialized sense organs and nervous system, and has no powers of locomotion.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plante</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plantas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">planten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Живой организм, синтезирующий пищу из неорганических веществ, обладающий целлюлозными клеточными стенками, медленно и иногда необратимо реагирующий на раздражитель, не имеющий специализированных органов чувств и нервной системы и не способный передвигаться.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نبات (أحياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/514" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1481" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1890" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1898" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5138" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5465" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8664" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9323" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10575" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13188" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13189" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13190" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13191" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
