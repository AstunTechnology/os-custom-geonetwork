    <adms:last rdf:resource="http://inspire.ec.europa.eu/featureconcept/TransportLinkSequence" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <skos:topConceptOf rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:44 PM CEST</dct:created>
    <dct:title xml:lang="en">Transport Link Sequence</dct:title>
    <skos:prefLabel xml:lang="en">Transport Link Sequence</skos:prefLabel>
    <dct:description xml:lang="en">A linear spatial object, composed of an ordered collection of transport links, which represents a continuous path in the transport network without any branches. The element has a defined beginning and end and every position on the transport link sequence is identifiable with one single parameter such as length. It describes an element of the transport network, characterized by one or more thematical identifiers and/or properties.</dct:description>
    <skos:definition xml:lang="en">A linear spatial object, composed of an ordered collection of transport links, which represents a continuous path in the transport network without any branches. The element has a defined beginning and end and every position on the transport link sequence is identifiable with one single parameter such as length. It describes an element of the transport network, characterized by one or more thematical identifiers and/or properties.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/tn" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
