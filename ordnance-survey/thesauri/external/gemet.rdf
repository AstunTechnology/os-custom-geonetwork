    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8824">
    <skos:prefLabel xml:lang="en">urban landscape</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The traits, patterns and structure of a city's specific geographic area, including its biological composition, its physical environment and its social patterns.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">paysage urbain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">paisaje urbano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtlandschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadslandschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городской ландшафт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Черты, структура конкретного географического района, в котором находится город, включая биологический состав, физическую среду и социальные условия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المنظر الطبيعي الحضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4648" />
