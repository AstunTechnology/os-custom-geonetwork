  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4967">
    <skos:prefLabel xml:lang="en">mailing list</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A series of addresses or e-mail addresses to which solicited or unsolicited mass mailings can be sent.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">liste de diffusion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lista de envío</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Adressenliste</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verzendingslijst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">список для рассылки</skos:prefLabel>
