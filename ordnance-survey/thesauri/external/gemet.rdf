    <skos:prefLabel xml:lang="es">medio de producción agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Betriebsmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwproductiemiddelen</skos:prefLabel>
