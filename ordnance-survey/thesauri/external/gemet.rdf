    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3455">
    <skos:prefLabel xml:lang="en">form of government</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Form of authority in which an individual or group of individuals wield power over the majority.
(Source: WSU)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">forme de gouvernement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">formas de gobierno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Staatsform</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">regeringsvorm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">форма государственного правления</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Форма власти, в рамках которой одно лицо или группа лиц правят большинством.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شكل الحكومة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3715" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1259" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3144" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10985" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10992" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11648">
    <skos:prefLabel xml:lang="en">river disposal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discharge of solid, liquid or gaseous waste into a river.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rejet en cours d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertido al río</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entsorgung in Flüsse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rivierlozing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сброс отходов в реку</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сброс твердых, жидких или газообразных отходов в реку.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من النفايات في النهر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2367" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7266" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11649">
    <skos:prefLabel xml:lang="en">underground disposal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The discharge, dumping or emission of wastes below the surface of the soil.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rejet en sous sol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disposición subterránea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterirdische Entsorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ondergrondse lozing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">захоронение отходов в грунт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сброс, сваливание или слив отходов под землю.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من النفايات تحت سطح الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2372" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11651">
    <skos:prefLabel xml:lang="en">urban pollutant</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">polluant urbain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminante urbano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtbedingter Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadsvervuiler</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городское загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество, возникающее в результате жизнедеятельности города</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوث حضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3460">
    <skos:prefLabel xml:lang="en">fossil</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any remains, trace, or imprint of a plant or animal that has been preserved in the Earth's crust since some past geologic or prehistoric time.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fossile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fósiles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fossil</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fossiel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ископаемое</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любые остатки, следы, отпечатки растений или животных, сохраненные в земной коре со времен прошлых геологических или исторических эпох.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حفرية - أحفورة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3026" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9028">
    <skos:prefLabel xml:lang="en">war</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A conflict or a state of hostility between two or more parties, nations or states, in which armed forces or military operations are used.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">guerre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">guerra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Krieg</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oorlog</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">война</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Открытый военный конфликт между двумя партиями, народами или государствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حرب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5243" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2941" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13324" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3465">
    <skos:prefLabel xml:lang="en">fouling growth</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The adhesion of different marine organisms to the underwater parts of ships, causing the ships to loose speed.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">salissure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">crecimiento con suciedad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fouling</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aangroei</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обрастание ракушками и водорослями</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прикрепление различных морских организмов к подводным частям судов, что приводит к потере скорости судами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تزايد الأقذار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7976" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/478" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10135">
    <skos:prefLabel xml:lang="en">palaeoecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The application of ecological concepts to fossil and sedimentary evidence to study the interactions of Earth surface, atmosphere, and biosphere in former times.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">paléoécologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">paleoecología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Paläökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">paleo-ecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">палеоэкология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение экологических концепций к окаменелостям или материальным остаткам в осадочных породах в целях изучения взаимоотношений земной поверхности, атмосферы и биосферы в далеком прошлом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم البيئة القديمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3469">
    <skos:prefLabel xml:lang="en">four stroke engine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An internal combustion engine whose cycle is completed in four piston strokes; includes a suction stroke, compression stroke, expansion stroke, and exhaust stroke.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">moteur à quatre temps</skos:prefLabel>
    <skos:prefLabel xml:lang="es">motor de cuatro tiempos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Viertaktmotor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">viertaktmotor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">четырехтактный двигатель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Двигатель внутреннего сгорания, чей рабочий цикл совершается в процессе работы четырех поршней; первая фаза - всасывания топлива, вторая - компрессия, третья - расширение и четвертая - выхлоп.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محرك رباعي الأشواط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1582" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3571" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3589" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11662">
    <skos:prefLabel xml:lang="en">protective measure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any precautionary action, procedure or installation conceived or undertaken to guard or defend from harm persons, property or the environment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure de protection</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medida protectora</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schutzmaßnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beschermingsmaatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предохранительная мера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое предохранительное действие, процедура или установка, запланированные или реализованные для охраны или защиты от нанесения ущерба физическим лицам, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إجراء حمائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1436" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3220" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5653" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6896" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12687" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5311" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3474">
    <skos:prefLabel xml:lang="en">framework legislation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A body of rules prescribed by a government, often composed in a series of inter-related parts, to establish or lay the foundation for a new project, agency or organizational structure.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation cadre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación marco</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rahmengesetzgebung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kaderwetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рамочное законодательство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свод правил, установленных государством, часто состоящих из нескольких взаимосвязанных разделов, целью которых является установление или заложение основ нового проекта, агентства или организационной структуры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريع إطار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3477">
    <skos:prefLabel xml:lang="en">access to information</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability, right and permission to approach and use, or the general availability of resources that convey knowledge.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accès à l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acceso a la información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationsfreiheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toegankelijkheid van de informatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доступ к информации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность, право и разрешение обращаться и пользоваться, а также общая доступность ресурсов, передающих знания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النفاذ إلى المعلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/23" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6801" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11671">
    <skos:prefLabel xml:lang="en">strong acidity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">High degree of ionization of an acid in water solution.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acidité forte</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acidez fuerte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Starke Acidität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hoge zuurtegraad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">высокий уровень кислотности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высокая степень ионизации кислоты в водном растворе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمضية قوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/47" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11672">
    <skos:prefLabel xml:lang="en">biomarker</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A normal metabolite that, when present in abnormal concentrations in certain body fluids, can indicate the presence of a particular disease or toxicological condition.
(Source: DICCHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biomarqueur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marcador biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biomarker</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biomarker</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоиндикатор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обычный метаболит, который при концентрациях в некоторых жидкостях тела, отклоняющихся от нормы, может указать на наличие конкретного заболевания или токсикологического состояния.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُعَلِّم حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5056" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/856" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3481">
    <skos:prefLabel xml:lang="en">freight transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transportation of goods by ship, aircraft or other vehicles.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport de marchandises</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte de mercancías</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gütertransport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrachtvervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фрахтовый транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перевозка товаров судами, самолетами и другими видами транспорта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الشحن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8641" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3392" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3911" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4903" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9119" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12819" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3483">
    <skos:prefLabel xml:lang="en">freon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Trade name for a group of polyhalogenated hydrocarbons containing fluorine and chlorine; an example is trichlorofluoromethane.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fréon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">freón</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freon</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">freon</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фреон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Торговое название группы полигалогенированных углеводородов, содержащих фтор и хлор, например, трихлорфторметан.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفريون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1381" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11676">
    <skos:prefLabel xml:lang="en">chemical contamination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The addition or presence of chemicals to, or in, another substance to such a degree as to render it unfit for its intended purpose. Also refers to the result(s) of such an addition or presence.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contamination chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación química</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Chemische Verunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemische vervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химическое заражение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Внесение или присутствие химических веществ в составе другого вещества в такой степени, что оно становится непригодным для использования в предназначенных целях. Также относится к результатам такого привнесения или присутствия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث كيميائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1752" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1101" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4725" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5155" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1318" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1319" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3485">
    <skos:prefLabel xml:lang="en">freshwater</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water having a relatively low mineral content, generally less than 500 mg/l of dissolved solids.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пресная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, содержащая относительно низкий уровень минералов, обычно менее 500 мг/л растворенных твердых веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8229" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3316" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4131" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6951" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7269" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12104" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2339" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11678">
    <skos:prefLabel xml:lang="en">biological effect of pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Effects of pollution on living systems.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet biologique de la pollution</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto biológico de la contaminación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Schadstoffwirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologisch effect van vervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологический результат загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Влияние загрязнения на живые организмы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأثر البيولوجي للتلوث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/849" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/460" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8265" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2035" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3487">
    <skos:prefLabel xml:lang="en">freshwater biology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The scientific study or the characteristic life processes of living organisms found in a natural body of water that does not contain significant amounts of dissolved salts and minerals, such as a lake or river.
(Source: WOR / APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biologie de l'eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biología del agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasserbiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwaterbiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биология пресной воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука или характерные жизненные процессы организмов, обитающих в природном водоеме, который не содержит значительных объемов растворенных солей и минералов, как, например, река или озеро.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيولوجيا الماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3488">
    <skos:prefLabel xml:lang="en">freshwater degradation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollution immediately or eventually involves the hydrological cycle of the earth, because even pollutants emitted into the air and those present in the soil are washed out by precipitation. Water is considered polluted when it is altered in composition or condition so that it becomes less suitable for any or all of the functions and purposes for which it would be suitable in its natural state. This definition includes changes in the physical, chemical and biological properties of water, or such discharges of liquid, gaseous or solid substances into water as will or are likely to create nuisances or render such water harmful to public health, safety or welfare, or to domestic, commercial, industrial, agricultural, fish or other aquatic life. It also includes changes in temperatures, due to the discharge of hot water.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dégradation des ressources en eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">degradación de agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasserdegradation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwaterdegradatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ухудшение качества пресных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение окружающей среды напрямую или косвенно затрагивает гидрологический цикл Земли, потому что загрязняющие вещества, выбрасываемые в воздух или находящиеся в почве, вымываются с выпадающими осадками. Вода считается загрязненной, когда ее состав меняется или ее состояние изменяется настолько, что она становится непригодной для выполнения любой из своих природных функций или назначения. Данное определение включает изменения физических, химических, биологических свойств воды, а также выброс в воду жидких, газообразных или твердых веществ, которые создадут или могут создать причину для беспокойства, а также нанести ущерб здоровью, безопасности, благополучию общества, бытовой, промышленной, сельскохозяйственной деятельности, рыбам и другим формам водной жизни. Также включает температурные изменения вследствие выбросов теплой воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدهور الماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13236" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14850" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3489">
    <skos:prefLabel xml:lang="en">freshwater ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The living organisms and nonliving materials of an inland aquatic environment.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème d'eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema de agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasserökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwaterecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пресноводная экосистема</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Живые и неживые организмы внутренней водной среды обитания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/505" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3491">
    <skos:prefLabel xml:lang="en">freshwater monitoring</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">contrôle de l' eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control del agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasserüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwatermeting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мониторинг пресных вод</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مراقبة الماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9196" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3492">
    <skos:prefLabel xml:lang="en">freshwater organism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Organisms which live in freshwater.

(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisme d'eau douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organismo de agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasserorganismen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwaterorganisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пресноводный организм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организмы, которые живут в пресной воде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كائنات عضوية تعيش في الماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/511" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3493">
    <skos:prefLabel xml:lang="en">freshwater pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The direct or indirect human alteration of the biological, physical, chemical or radiological integrity of freshwater.
(Source: Landy)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution des eaux douces</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación de agua dulce</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Süßwasserverschmutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoetwatervervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение пресной воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прямое или опосредованное изменение человеком биологической, физической, химической или радиологической целостности пресной воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث الماء العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9202" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3784" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4593" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7266" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11686">
    <skos:prefLabel xml:lang="en">irreversibility of the phenomenon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That quality of a process that precludes a prior state from being attained again.
(Source: MICHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">irréversibilité du phénomène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">irreversibilidad del fenómeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Irreversibilität eines Phänomens</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onomkeerbaarheid van het verschijnsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">необратимость какого-либо явления</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Качество процесса, препятствующее возвращению к первоначальному состоянию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عدم قابلية الظاهرة للانعكاس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3495">
    <skos:prefLabel xml:lang="en">frog</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any insectivorous anuran amphibian of the family Ranidae, such as Rana temporaria of Europe, having a short squat tailless body with a moist smooth skin and very long hind legs specialized for hopping.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">grenouille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ranas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Frosch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kikkers</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лягушка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Насекомоядная бесхвостая земноводная амфибия семейства Ranidae, например Rana temporaria в Европе, у которой короткое широкое туловище, покрытое влажной и гладкой кожей, длинные задние ноги, приспособленные для прыжков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضفدعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/387" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3496">
    <skos:prefLabel xml:lang="en">frost</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A deposit of interlocking ice crystals formed by direct sublimation on objects.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">heladas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Frost</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vorst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">иней</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Расположение взаимосвязанных кристалликов льда, образовавшихся благодаря испарениям на охлаждающейся поверхности объектов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التجمُّد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5196" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3498">
    <skos:prefLabel xml:lang="en">fruit</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fully matured plant ovary with or without other floral or shoot parts united with it at maturity.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fruit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fruta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Obst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fruit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фрукт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Созревший плод вместе с плодоножкой или без нее.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثمرة - فاكهة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6300" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3499" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3499">
    <skos:prefLabel xml:lang="en">fruit cultivation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cultivation of fruit trees for home consumption or on a commercial basis.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture fruitière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultivo de fruta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Obstbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fruitteelt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выращивание фруктов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выращивание фруктовых деревьев для потребления их плодов или продажи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة الفاكهة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3378" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3498" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3502" />
