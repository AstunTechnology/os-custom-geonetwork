    <skos:prefLabel xml:lang="en">collective wastewater treatment</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">assainissement collectif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de aguas colectivas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sammelabwasserbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gezamenlijke afvalwaterverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистка объединенных стоков</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">المعالجة الجماعية للمياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
