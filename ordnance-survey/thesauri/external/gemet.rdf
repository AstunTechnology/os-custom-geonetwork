    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12913">
    <skos:prefLabel xml:lang="en">public institution of administrative nature</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Public institution for the management of administrative issues.
(Source: ZINZANa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">établissement public à caractère administratif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">institución pública de la naturaleza administrativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öffentliche Verwaltungseinrichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">openbare administratieve instelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">государственный орган для решения административных вопросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Государственный орган для решения административных вопросов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مؤسسة عامة ذات طبيعة إدارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5299" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4722">
    <skos:prefLabel xml:lang="en">leaching</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The process of separating a liquid from a solid (as in waste liquid by percolation into the surrounding soil. 
2) Extraction of soluble components of a solid mixture by percolating a solvent through it.
3) To lose or cause to lose soluble substances by the action of a percolating liquid.
(Source: HARRIS /  DICCHE /  CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lixiviation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lixivización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auswaschung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitloging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выщелачивание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Процесс сепарации жидкости и твердого вещества (в случае сточной воды в результате просачивания воды в почву). 2) Извлечение растворимых компонентов раствора твердого вещества в результате пропускания растворителя через него. 3) Процесс, в результате которого происходит потеря растворимых веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حلحلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4723">
    <skos:prefLabel xml:lang="en">lead</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A heavy toxic bluish-white metallic element that is highly malleable; occurs principally as galena and is used in alloys, accumulators, cable sheaths, paints, and as a radiation shield.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plomb</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plomo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Blei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lood</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">свинец</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тяжелый токсичный голубовато-белый металлический элемент, очень мягкий; чаще всего встречается в виде галенита и используется в сплавах, аккумуляторных батареях, производстве кабелей, красок, а также радиационных защитных укрытий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الرصاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2639" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3915" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4724">
    <skos:prefLabel xml:lang="en">lead compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Lead compounds are present as gasoline additives, in paint, ceramic products, roofing, caulking, electrical applications, tubes, or containers. Lead exposure may be due to air, water, food, or soil. Lead in the air is primarily due to lead-based fuels and the combustion of solid waste, coal, oils, and emissions from alkyl lead manufacturers, wind blown dust volcanoes, the burning of lead-painted surfaces, and cigarette smoke. Lead in drinking water comes from leaching from lead pipes, connectors, and solder in both the distribution system and household plumbing.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé de plomb</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuesto de plomo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bleiverbindung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loodverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соединение свинца</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединения свинца добавляются в состав бензина, красок, керамических изделий, покрытия для крыш, электротехнических приборов, труб или контейнеров. Свинец может находиться в воздухе, воде, почве или в продуктах питания. Содержание свинца в воздухе вызвано прежде всего сжиганием топлива, содержащего свинец, твердых отходов, угля и нефти, а также может объясняться выбросами в атмосферу отходов производства алкила свинца,  вулканической деятельностью, горением поверхностей с покрытием, содержащих свинец, сигаретным дымом. Свинец попадает в питьевую воду из свинцовых труб, соединительных муфт, припоя, как в коммунальной, так и бытовой системе водоснабжения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب رصاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4725">
    <skos:prefLabel xml:lang="en">lead contamination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The presence and release into the air, water and soil, of lead, a toxic metal used in plumbing, gasoline and lead-acid batteries.
(Source: FFD / EEN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contamination par le plomb</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación por plomo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bleiverseuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loodverontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение свинцом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Присутствие и выброс в воздух, воду или почву свинца, токсичного металла, используемого в составе труб, бензина и аккумуляторов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التلوث بالرصاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11676" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4727">
    <skos:prefLabel xml:lang="en">lead-in-petrol law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to reduce or eliminate the lead content in petroleum fuels used in vehicular and other engines that pollute the air with lead-carrying exhaust.
(Source: GAS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi sur l'essence chargée en plomb</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley de plomo en gasolina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Benzinbleigesetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wet op loodgehalte in benzine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">закон об уровне содержания свинца в автомобильном топливе</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод правил, установленных государством для снижения или исключения содержания свинца в жидком топливе, используемом в автомобильных и других двигателях, загрязняющих окружающую среду парами, содержащими свинец.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون خاص بالبنزين المحمل بالرصاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4247" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4728">
    <skos:prefLabel xml:lang="en">lead level in blood</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A measure of the amount of lead or lead salts absorbed by the body as a possible sign of acute or chronic lead poisoning, which can affect the nervous, digestive or muscular systems.
(Source: SMD / MED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taux de plomb dans le sang</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel de plomo en la sangre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Blutbleispiegel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loodgehalte in het bloed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень свинца в крови</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Величина поглощенного телом свинца или его солей как показатель возможной причины сильного или хронического отравления свинцом, способного оказать отрицательное воздействие на функции нервной, пищеварительной или мышечной системы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى الرصاص في الدم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6359" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4730">
    <skos:prefLabel xml:lang="en">leaf</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The main organ of photosynthesis and transpiration in higher plants, usually consisting of a flat green blade attached to the stem directly or by a stalk.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">feuille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hoja</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Blatt (Pflanze)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">blad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лист (бот.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Основной орган фотосинтеза и транспирации высших растений, обычно состоящий из плоской зеленой листовой пластины, прикрепленной к стеблю непосредственно или посредством черенка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ورقة  (نباتية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6300" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4731">
    <skos:prefLabel xml:lang="en">leakage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The accidental, uncontrolled discharge or seepage of liquids, gases and other substances to unintended and unwanted locations, frequently causing risks of damage or harm to persons, property or the environment.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fuite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fugas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Leckage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">протечка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Непреднамеренный разлив жидкостей, выброс газов и пр., потери тока в электропроводе в результате плохой изоляции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تسرُّب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2766" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13077">
    <skos:prefLabel xml:lang="en">assay</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Qualitative or quantitative determination of the components of a material, such as an ore or a drug.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ensayo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Untersuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">analyseren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">качественный и количественный анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Качественное или количественное определение состава материала, например, руды или лекарства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8405" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4156" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4738">
    <skos:prefLabel xml:lang="en">leather industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry for the production of leather goods such as garments, bags, etc.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie du cuir</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria del cuero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lederindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lederindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кожевенная промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Промышленность, предприятия которой заняты в производстве кожаных изделий, например, одежды, сумок и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الجلود</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4739">
    <skos:prefLabel xml:lang="en">legal basis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The fundamental law or judicial precedent that warrants or supports a subsequent decision or action by any governmental, corporate or private entity.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">base légale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">base jurídica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechtsgrundlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rechtsgrond(slag)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">юридическая основа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Основополагающий закон или юридический прецедент, гарантирующий или поддерживающий принятое решение или предпринятое действие государства, корпорации или частного лица.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أساس قانوني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13288" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4741">
    <skos:prefLabel xml:lang="en">legally protected right</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A justifiable claim to have or obtain something or to act in a certain way, which is supported by law and is covered or shielded from the danger of being revoked or repealed.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit légal</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho tutelado legalmente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechtsgut</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">door de wet beschermd recht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">право, охраняемое законом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Справедливая, поддерживаемая законом и защищенная от возможной отмены или отзыва претензия на обладание, получение чего-либо, а также на совершение определенных действий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حق قانوني - حق يحميه القانون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3521">
    <skos:prefLabel xml:lang="en">fumigation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of a chemical compound in a gaseous state to kill insects, nematodes, arachnids, rodents, weeds, and fungi in confined or inaccessible locations; also used to control weeds, nematodes, and insects in the field.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fumigation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fumigación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Begasung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontsmetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фумигация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование химического соединения в газообразном состоянии для уничтожения насекомых, нематод, грызунов, пауков, сорняков и грибов в ограниченных или недоступных участках; также используется для контроля за сорняками, нематодами и насекомыми на полях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدخين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12606" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4744">
    <skos:prefLabel xml:lang="en">legal remedy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The means by which a right is enforced or the violation of a right is prevented, redressed, or compensated.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">recours judiciaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">remedio legal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechtsbehelf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rechtsmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">юридическое средство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство, обеспечивающее право, меры, препятствующие его нарушению, либо обеспечивающие возмещение, компенсации в случае нарушения этого права.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علاج قانوني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13288" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4746">
    <skos:prefLabel xml:lang="en">legal text</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The exact wording or language of a law or other document in conformity with the law or having the authority of law.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">texte juridique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">textos legislativos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechtsdokument</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wettekst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">юридический текст</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Точный текст, язык закона либо другого документа, соответствующего закону либо имеющего силу закона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نص قانوني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13288" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11714">
    <skos:prefLabel xml:lang="en">organic nitrogen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Essential nutrient of the food supply of plants and the diets of animals. Animals obtain it in nitrogen-containing compounds, particularly aminoacids. Although the atmosphere is nearly 80% gaseous nitrogen, very few organisms have the ability to use it in this form. The higher plants normally obtain it from the soil after microorganisms have converted the nitrogen into ammonia or nitrates, which they can then absorb. This conversion of nitrogen, known as nitrogen fixation, is essential for the formation of amino acids which, in turn, are the building blocks of proteins.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">azote organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nitrógeno orgánico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organischer Stickstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organisch gebonden stikstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органический азот</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Важное питательное вещество для растений и животных. Животные получают его в составе азотосодержащих соединений, особенно аминокислот. Несмотря на то что атмосфера на 80% состоит их газообразного азота, очень немногие организмы способны использовать его в такой форме. Высшие растения обычно получают его через почву после того, как микроорганизмы переработали азот в аммиак или нитраты, которые растения могут поглотить. Это превращение азота, которое называется еще "фиксацией азота", исключительно важно для образования аминокислот, которые, в свою очередь, являются строительным материалом для белков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نيتروجين عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5928" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4752">
    <skos:prefLabel xml:lang="en">legislation on pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Rules concerning the limits of pollutant emissions.
(Source: DIZAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation en matière de pollution</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación sobre contaminación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltschutzrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetgeving inzake vervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство по вопросам загрязнения окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Правила, касающиеся предельных значений выброса загрязняющих веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريع حول التلوث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1619" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4148" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6443" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6451" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4758">
    <skos:prefLabel xml:lang="en">water resources legislation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to manage and protect an area's natural water supply and waterways.
(Source: DES / BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation en matière de ressources en eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación sobre recursos hídricos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserressourcenrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetgeving inzake water(voorraden)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство в области водных ресурсов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, принятых государством для управления и защиты запасов природной воды в конкретном регионе или водных путей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريع الموارد المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2862" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4759">
    <skos:prefLabel xml:lang="en">legislative authority</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The power of a deliberative assembly of persons or delegates to bring a bill, resolution or special act to an official, legally binding status.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">autorité législative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autoridad legislativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzgeber</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetgevende macht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полномочие на законодательную деятельность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Правомочия специального собрания лиц или делегатов приводить законопроект, резолюцию или специальное постановление к официальному, юридически обязательному статусу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلطة تشريعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4760">
    <skos:prefLabel xml:lang="en">legislative competence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The skill, knowledge, qualification, capacity or authority to make, give or enact rules with binding force upon a population or jurisdiction.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compétence législative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">competencia legislativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzgebungskompetenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetgevende bevoegdheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательная правоспособность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Полномочия суда участвовать в подготовке законов, участвовать в процессе приведения законов в исполнение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أهلية تشريعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4762">
    <skos:prefLabel xml:lang="en">legislative information</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Knowledge or a service providing knowledge concerning actual and proposed laws, including approval status, the history and content of deliberative proceedings and the specific language of those laws.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">information législative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">información legislativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzesinformation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatie over wetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информация о законодательстве</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Знания или передающая знания услуга, касающиеся действующих законов или предлагаемых к рассмотрению законопроектов, включая информацию о состоянии рассмотрения, содержания слушаний, а также текстов этих законов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معلومات تشريعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6801" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4764">
    <skos:prefLabel xml:lang="en">legislature</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The department, assembly, or body of persons that makes statutory laws for a state or nation.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">corps législatif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislatura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Legislative</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetgevende macht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательная власть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Орган, собрание или объединение лиц, издающие законы в государстве.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيئة تشريعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10833" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/794">
    <skos:prefLabel xml:lang="en">bilge oil</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste oil that accumulates, usually in small quantities, inside the lower spaces of a ship, just inside the shell plating, and usually mixed with larger quantities of water.
(Source: ERG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">huile de fond de cale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aceite de sentina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bilgenöl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruimolie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">трюмная нефть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нефтяные отходы, которые собираются, как правило, в небольших количествах внутри нижних отсеков судна, сразу за обшивкой, часто смешиваются с большим количеством воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زيت القاع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9098" />
