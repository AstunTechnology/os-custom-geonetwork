    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <skos:topConceptOf rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:38 PM CEST</dct:created>
    <dct:title xml:lang="en">Breakline</dct:title>
    <skos:prefLabel xml:lang="en">Breakline</skos:prefLabel>
    <dct:description xml:lang="en">A line of a critical nature which describes the shape of an elevation surface and indicates a discontinuity in the slope of the surface (i.e. an abrupt change in gradient). Triangles included within a TIN model must never cross it.</dct:description>
    <skos:definition xml:lang="en">A line of a critical nature which describes the shape of an elevation surface and indicates a discontinuity in the slope of the surface (i.e. an abrupt change in gradient). Triangles included within a TIN model must never cross it.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/el" />
