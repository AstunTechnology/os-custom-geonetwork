  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5348">
    <skos:prefLabel xml:lang="en">monitoring data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">données de mesure de surveillance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">datos de vigilancia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meßdaten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het controleren van gegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">данные мониторинга</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
