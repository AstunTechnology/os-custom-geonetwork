    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:39 PM CEST</dct:created>
    <dct:title xml:lang="en">SpatialDataSet</dct:title>
    <skos:prefLabel xml:lang="en">SpatialDataSet</skos:prefLabel>
    <dct:description xml:lang="en">Identifiable collection of spatial data.</dct:description>
    <skos:definition xml:lang="en">Identifiable collection of spatial data.</skos:definition>
    <vann:usageNote xml:lang="en">NOTE The type SpatialDataSet is offered as a pre-defined type for spatial data sets. The scope of this type is packaging pre-defined data sets for the non-direct access download service. It may be reused in thematic application schemas, but if it does not fit an application-schema-specific data set object should be modelled. This type may have the same name and definition like this type, but may have a different set of properties.This type specifies three properties: an external object identifier, a container for metadata (may be void), and an association to zero or more spatial objects.</vann:usageNote>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
