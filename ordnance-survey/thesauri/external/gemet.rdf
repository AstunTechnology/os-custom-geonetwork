    <skos:prefLabel xml:lang="nl">totaal aan organische koolstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общее содержание органического углерода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество углерода, ковалентно связанного в органических соединениях, содержащееся в образце воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كربون عضوي كلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5892" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
