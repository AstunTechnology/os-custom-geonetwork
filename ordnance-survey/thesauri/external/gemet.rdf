    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13191">
    <skos:prefLabel xml:lang="en">tropical plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plants growing in tropical areas in conditions of constant rain and high temperature.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plante tropicale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planta tropical</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tropische Pflanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tropisch gewas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тропическое растение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растения, растущие в тропических регионах в условиях постоянных дождей и высоких температур.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نباتات استوائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6323" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8687" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13192">
    <skos:prefLabel xml:lang="en">agricultural real estate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Property of agricultural land and anything permanently affixed to the land, such as buildings, fences, etc.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">propriété foncière agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">propriedad rústica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Grundeigentum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwgrondbezit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">объект недвижимости в сельском хозяйстве</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок сельскохозяйственной земли и другие прочно связанные с ней объекты, например, строения, изгороди и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقارات زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3130" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13193">
    <skos:prefLabel xml:lang="en">agricultural holding</skos:prefLabel>
    <skos:scopeNote xml:lang="en">As defined by the United Nations Food and Agriculture Organization, an agricultural holding is simply a basic unit for agricultural production.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploitation agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación agraria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Unternehmen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwonderneming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственная единица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">По определению Продовольственной и сельскохозяйственной организации ООН сельскохозяйственной единицей называется основное предприятие сельскохозяйственного производства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أرض زراعية مستأجرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13194" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13159" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13194">
    <skos:prefLabel xml:lang="en">type of tenure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The manner in which land is owned and possessed, i.e. of title to its use.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mode de faire-valoir</skos:prefLabel>
    <skos:prefLabel xml:lang="es">régimen de explotacíon</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Besitzart</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">soort aanstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тип землепользования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способ владения землей, относящийся к праву на ее использование.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوع الحيازة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13193" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5003">
    <skos:prefLabel xml:lang="en">man-nature relationship</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">relations homme-nature</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relación hombre-naturaleza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mensch-Natur-Verhältnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verhouding tussen de mens en de natuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взаимосвязь человека и природы</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">العلاقة بين الإنسان والطبيعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3788" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2857" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2874" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3768" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7197" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10255" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2778" />
