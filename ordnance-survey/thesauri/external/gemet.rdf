    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4702">
    <skos:prefLabel xml:lang="en">laundering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of washing and ironing clothes, linen, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">blanchissage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lavado y limpieza en seco</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wäsche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wassen en strijken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">прачечные</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Служба быта, занимающаяся стиркой и глажкой одежды, постельного белья и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الغسيل والكي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2358" />
