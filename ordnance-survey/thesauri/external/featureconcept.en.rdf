    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:40 PM CEST</dct:created>
    <dct:title xml:lang="en">Aquifer</dct:title>
    <skos:prefLabel xml:lang="en">Aquifer</skos:prefLabel>
    <dct:description xml:lang="en">A wet underground layer of water-bearing permeable rock or unconsolidated materials (gravel, sand, silt, or clay) from which groundwater can be usefully extracted using a water well.</dct:description>
    <skos:definition xml:lang="en">A wet underground layer of water-bearing permeable rock or unconsolidated materials (gravel, sand, silt, or clay) from which groundwater can be usefully extracted using a water well.</skos:definition>
