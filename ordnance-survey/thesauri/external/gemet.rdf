    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4855">
    <skos:prefLabel xml:lang="en">lithosphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The solid portion of the Earth, as compared with the atmosphere and the hydrosphere.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lithosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">litosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lithosphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lithosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">литосфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Твердая оболочка Земли в отличие от атмосферы или гидросферы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اليابسة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2400" />
