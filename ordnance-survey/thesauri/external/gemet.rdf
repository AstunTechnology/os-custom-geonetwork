    <skos:prefLabel xml:lang="es">producto de limpieza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reinigungsmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reinigingsproduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">чистящий продукт</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">منظف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2131" />
