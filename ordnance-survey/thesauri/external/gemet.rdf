    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6280">
    <skos:prefLabel xml:lang="en">plane source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollution which arises from various activities with no discrete source.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source plane (d'émissions)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuente de avión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flächenquelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fossiele bron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">неопределенный источник загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение, источником которого являются различные виды деятельности без выделения дискретного источника.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر مستوٍ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6474" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
