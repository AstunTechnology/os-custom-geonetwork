    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/394">
    <skos:prefLabel xml:lang="en">anaerobic process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process from which air or oxygen not in chemical combination is excluded.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pocessus anaérobie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso anaeróbico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anaerober Prozess</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anaërobe proces</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анаэробный процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, исключающий присутствие воздуха или кислорода вне химического соединения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية لاهوائية</skos:prefLabel>
