    <skos:prefLabel xml:lang="ru">опасность здоровью</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">خطورة على الصحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3869" />
