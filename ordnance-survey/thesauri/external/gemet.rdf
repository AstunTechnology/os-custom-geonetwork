  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3586">
    <skos:prefLabel xml:lang="en">gas network</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Interconnected system of pipes for the distribution and supply of gas.
(Source: PHC)</skos:scopeNote>
