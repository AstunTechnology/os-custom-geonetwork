  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2956">
    <skos:prefLabel xml:lang="en">equipment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any collection of materials, supplies or apparatuses stored, furnished or provided for an undertaking or activity.
