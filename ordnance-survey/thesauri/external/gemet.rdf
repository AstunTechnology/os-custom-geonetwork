  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/286">
    <skos:prefLabel xml:lang="en">air traffic regulation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">réglementation du trafic aérien</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reglamento del tráfico aéreo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Luftverkehrsüberwachung</skos:prefLabel>
