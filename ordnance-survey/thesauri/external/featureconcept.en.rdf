    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:38 PM CEST</dct:created>
    <dct:title xml:lang="en">WFD Coastal Water</dct:title>
    <skos:prefLabel xml:lang="en">WFD Coastal Water</skos:prefLabel>
    <dct:description xml:lang="en">Surface water on the landward side of a line, every point of which is at a distance of one nautical mile on the seaward side from the nearest point of the baseline from which the breadth of territorial waters is measured, extending where appropriate up to the outer limit of transitional waters.</dct:description>
    <skos:definition xml:lang="en">Surface water on the landward side of a line, every point of which is at a distance of one nautical mile on the seaward side from the nearest point of the baseline from which the breadth of territorial waters is measured, extending where appropriate up to the outer limit of transitional waters.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/am" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
