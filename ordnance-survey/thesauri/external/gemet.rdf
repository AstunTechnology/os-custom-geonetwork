    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13179">
    <skos:prefLabel xml:lang="en">industrial structure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">structure industrielle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estructura industrial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Industriestruktur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">industriële structuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">структура промышленности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
