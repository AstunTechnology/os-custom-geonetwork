    <skos:prefLabel xml:lang="nl">soort bedrijf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тип бизнеса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Класс либо категория предприятий или организаций, занятых экономической деятельностью.</skos:scopeNote>
