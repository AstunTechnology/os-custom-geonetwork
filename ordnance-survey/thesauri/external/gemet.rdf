  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/795">
    <skos:prefLabel xml:lang="en">bilge water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water that builds up in the bottom of a ship's bilge.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de fond de cale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua de sentina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bilgenwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruimwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">трюмная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, скапливающаяся на дне нижних отсеков судна.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء القاع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7497">
    <skos:prefLabel xml:lang="en">sea bed</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The bottom of the ocean. Also known as sea floor; sea bottom. The ocean floor is defined as the near-horizontal surface of the ocean basin.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fond marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fondo marino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresboden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeebodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морское дно</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дно океана. Также еще определяется как окологоризонтальная поверхность океанического бассейна.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاع البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8158" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7498">
    <skos:prefLabel xml:lang="en">sea bed exploitation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Marine mineral resources extend far beyond those presently exploited; minerals are derived from two separate types of marine sources: from sedimentary deposits underlying the continental shelves and from inshore deposits on the surface of the continental shelves. By far the most valuable of the mineral resources exploited from marine environments is petroleum. Offshore placer deposits on the surface of the continental shelves yield gold, platinum, and tin. On the floors of the world's oceans manganese nodules are found as a result of pelagic sedimentation or precipitation; they are small, irregular, black to brown, friable, laminated concretionary masses consisting primarily of manganese salts and manganese-oxide minerals.
(Source: PARCOR /  BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploitation des fonds marins</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación de fondos marinos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausbeutung des Meeresgrundes</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">exploitatie van de zeebodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">использование ресурсов морского дна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объем ресурсов, расположенных на морском дне, во многом превышает объем эксплуатируемых в настоящее время месторождений; полезные ископаемые добываются из двух различных типов месторождений: осадочных, лежащих в недрах континентального шельфа, и прибрежных, расположенных на поверхности континентального шельфа. Самым ценным минеральным видом сырья, получаемым из морской среды, является нефть. В прибрежных водах на поверхности континентального шельфа расположены запасы золота, платины, олова. На дне мирового океана находятся конкреции марганца, образованные в ходе пелагического отложения или осаждения; они представляют собой небольшие, неправильной формы, черного или коричневого цвета, крошащиеся, слоистые минеральные образования, состоящие главным образом из солей и оксидов марганца.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استغلال قاع البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12171" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7500">
    <skos:prefLabel xml:lang="en">sea bed mining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The activity or processes involving the extraction of mineral deposits from the surface, or below the surface, of the ocean floor.
(Source: MLM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extraction minière sur le fonds marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">minería en el fondo marino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meereslagerstättenabbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zandbankontginning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разработка ресурсов морского дна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность или процессы, связанные с разработкой минеральных ресурсов, расположенных на поверхности или под поверхностью морского дна.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعدين في قاع البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7502">
    <skos:prefLabel xml:lang="en">sea circulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Large-scale horizontal water motion within an ocean. The way energy from the sun, stored in the sea, is transported around the world. The currents explain, for example, why the UK has ice-free ports in winter, while St. Petersburg, at the same latitude as the Shetland Islands, needs ice breakers. Evidence is growing that the world's ocean circulation was very different during the last ice age and has changed several times in the distant past, with dramatic effects on climate. The oceans are vital as storehouses, as they absorb more than half the sun's heat reaching the earth. This heat, which is primarily absorbed near the equator is carried around the world and released elsewhere, creating currents which last up to 1.000 years. As the Earth rotates and the wind acts upon the surface, currents carry warm tropical water to the cooler parts of the world. The strength and direction of the currents are affected by landmasses, bottlenecks through narrow straits, and even the shape of the sea-bed. When the warm water reaches polar regions its heat evaporates into the atmosphere, reducing its temperature and increasing its density. When sea-water freezes it leaves salt behind in the unfrozen water and this cold water sinks into the ocean and begins to flow back to the tropics. Eventually it is heated and begins the cycle all over again.
(Source: MGH /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">circulation maritime</skos:prefLabel>
    <skos:prefLabel xml:lang="es">circulación marina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meereskreislauf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeestroming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">циркуляция морской воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупномасштабное горизонтальное движение воды в океане. Хранимая в океане солнечная энергия таким образом перемещается по всему миру. Течения объясняют, почему в Великобритании в зимний период не замерзает вода в морских портах, в то время, как в С.-Петербурге, расположенном на той же широте, что и Шетландские острова, необходимы ледоколы. Растет количество научных доказательств того, что в период последнего глобального похолодания на планете циркуляция воды в мировом океане была иной и она претерпела неоднократные изменения, повлияв самым драматическим образом на климат Земли. Мировой океан является важным хранилищем энергии, поглощая более половины поступающей от солнца энергии. Это тепло, которое поглощается в основном в районе экватора, переносится по всему миру и образует течения, которые циркулируют тысячелетиями. В связи с тем, что Земля вращается, под действием ветра морские течение переносят теплые тропические погодные условия в более прохладные регионы. На силу и направление течений влияют массы суши, ширина проливов и даже форма морского дна. Когда теплая вода достигает полярных областей, то тепло попадает в атмосферу, снижая ее температуру и увеличивая ее плотность. Когда морская вода замерзает, то оставшаяся в незамерзшей воде соль опускается в низкие слои океана и начинает обратный путь в тропики. Постепенно вода нагревается, и цикл повторяется.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الدورات المائية البحرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12174" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5347">
    <skos:prefLabel xml:lang="en">monitoring criterion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">critère de surveillance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">criterio de vigilancia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überwachungskriterium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">metingscriterium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">критерий мониторинга</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معيار المراقبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5354" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7513">
    <skos:prefLabel xml:lang="en">sea level</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The level of the surface of the ocean; especially, the mean level halfway between high and low tide, used as a standard in reckoning land elevation or sea depths.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau de la mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel del mar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresspiegel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeespiegel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень моря</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Уровень поверхности океана; особенно средний уровень между уровнем прилива и отлива, используемый в качества стандарта для измерения высоты суши или морских глубин.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى سطح البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8480" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7514">
    <skos:prefLabel xml:lang="en">sea level rise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sea-level rises are a possible consequence of global warming. As the amount of free water in the oceans increases, and as the water becomes warmer, global warming will increase. In addition, according to theory, the heating at the poles may reduce the amount of water trapped in glaciers and ice caps.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">elevation du niveau de la mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aumento del nivel del mar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresspiegelanstieg</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeespiegelstijging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">повышение уровня моря</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Повышение уровня моря является одним из проявлений глобального потепления. По мере того как будет возрастать объем воды в океане и будет повышаться ее температура, будет усиливаться эффект глобального потепления. Кроме того, теоретически повышение температуры на полюсах Земли может снизить количество воды, удерживаемой в составе ледников.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ارتفاع مستوى سطح البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3692" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7516">
    <skos:prefLabel xml:lang="en">sealing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Luting, making watertight, waterproofing.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étanchéification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sellado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abdichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">robbevangst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гидроизоляция (процесс)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс гидроизолирования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خَتم - الإغلاق بخاتم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7897" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8755" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7519">
    <skos:prefLabel xml:lang="en">seal (technical)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any device or system that creates a nonleaking union between two mechanical or process-system elements.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">appareil pour sceller</skos:prefLabel>
    <skos:prefLabel xml:lang="es">obturación (técnica)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dichting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">перемычка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устройство или система, создающая не пропускающее воду соединение между двумя механическими элементами либо элементами процесса или системы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الختم (أداة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7520">
    <skos:prefLabel xml:lang="en">sea outfall</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The point, location or structure where effluent discharges into a body of marine waters such as a sea, ocean, etc.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">embouchure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desague marino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresauslaß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvoerbuis in zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морской выводной коллектор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пункт, место или конструкция, через которые сточные воды выбрасываются в водоем с морской водой, как, например, море, океан и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصب بحري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5044" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4159">
    <skos:prefLabel xml:lang="en">impact assessment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Evaluation of the effect of a project upon the environment.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation de l'impact</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación de impactos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verträglichkeitsprüfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het inschatten van het effect van iets</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка воздействия, экологическая экспертиза</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка воздействия проекта на окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم الأثر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2826" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2830" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2841" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2844" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2566" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7525">
    <skos:prefLabel xml:lang="en">sea resource</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Marine resources include food, energy and minerals.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ressource marine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recursos del mar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeeschatten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морской ресурс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Морские ресурсы включают продукты питания, энергию и полезные ископаемые.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر بحري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5521" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3241" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4867" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7495" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7528">
    <skos:prefLabel xml:lang="en">seashore</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The zone of unconsolidated material that extends landward from the low water-line to where there is marked change in material or physiographic form or to the line of permanent vegetation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">littoral maritime</skos:prefLabel>
    <skos:prefLabel xml:lang="es">costa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresküste</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kust(strook)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морской берег</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сыпучий материал, покрывающий поверхность слегка наклоненного участка земной поверхности, протянувшегося от мелководья к такому месту на суше, где различается четкая граница между материалами поверхностного слоя, происходит изменение физиографической формы или начинается полоса постоянной растительности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شاطئ البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1512" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/751" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7529">
    <skos:prefLabel xml:lang="en">season</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of the four equal periods into which the year is divided by the equinoxes and solstices, resulting from the apparent movement of the sun north and south of the equator during the course of the earth's orbit around it. These periods (spring, summer, autumn and winter) have their characteristic weather conditions in different regions, and occur at opposite times of the year in the N and S hemispheres.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">saison</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estación del año</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Jahreszeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">jaargetijde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сезон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Один из четырех одинаковых по продолжительности периодов, на которые календарный год разделяется днями равноденствия и солнцестояния, являющихся результатом движения Солнца к северу и югу от экватора в течение вращения Земли вокруг него. Эти периоды (весна, лето, осень и зима) имеют свои отчетливые погодные условия в разных регионах мира и наступают в противоположное время в северном и южном полушариях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موسم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2406" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/14979" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7531">
    <skos:prefLabel xml:lang="en">seasonal migration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The periodic movement of a population from one region or climate to another in accordance with the yearly cycle of weather and temperature changes.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">migration saisonnière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">migración estacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Saisonwanderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">seizoensmigratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сезонная миграция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Периодическое движение населения из одного региона или климата в другой в соответствии с годовым циклом изменений температуры и погоды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهجرة الموسمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5236" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5662" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7535">
    <skos:prefLabel xml:lang="en">sea water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Aqueous solution of salts in more or less constant ratio, whose composition depends on several factors among which predominate living organisms, detrital sedimentation and the related chemical reactions. Sea-water accounts for more than 98% of the mass of the hydrosphere and covers just over 70% of the globe. Because of the composition and stability of the oceans, and the way they are controlled, they are of great importance to the climate, and great attention has been given to studying the effects of pollution. Man's activities are believed to be accelerating the change in the composition of sea-water.
(Source: DODERO /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas marinas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meerwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeewater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морская вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Водный раствор солей в более или менее постоянной пропорции, чей состав зависит от нескольких факторов, среди которых доминируют живые организмы, детритовые отложения и связанные с этим химические реакции. Морская вода занимает более 98% всей массы гидросферы и покрывает 70% поверхности земного шара. Морская вода играет важную роль в формировании климата, кроме того, большое внимание уделяется изучению последствий ее загрязнения. Считается, что деятельность человека в большой степени способствует изменению состава морской воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7402" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7536">
    <skos:prefLabel xml:lang="en">sea water desalination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Removing salt from ocean or brackish water.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dessalement de l'eau de mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desalación de agua marina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meerwasserentsalzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontzouting van zeewater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">опреснение морской воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление соли из морской или солоноватой воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحلية ماء البحر - إزالة ملوحة ماء البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12165" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7538">
    <skos:prefLabel xml:lang="en">sea water protection</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">protection de l'eau de mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de agua marina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresgewässerschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bescherming van zeewater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита морской воды</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">حماية ماء البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9206" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7541">
    <skos:prefLabel xml:lang="en">secondary biotope</skos:prefLabel>
    <skos:scopeNote xml:lang="en">In the case of disruption of an existing biotope, secondary biotope can be created as a compensation and substitute measure for the loss of the natural one.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biotope secondaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biotopo secundario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sekundärbiotop</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">secundaire biotoop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вторичный биотоп</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В случае прекращения существования биотопа вместо него может быть создан вторичный биотоп в качестве компенсирующей и замещающей меры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موطن حيوي ثانوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/901" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7542">
    <skos:prefLabel xml:lang="en">secondary education</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The years of instruction following elementary school and until the end of high school.
(Source: COE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">enseignement secondaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enseñanza media</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sekundarstufe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">midelbaar onderwijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">среднее образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Годы обучения после начальной школы до завершения средней школы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعليم الثانوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4909">
    <skos:prefLabel xml:lang="en">long-term forecasting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of predicting and calculating the likely conditions or occurrences for an extended and future point in time, often involving the study and analysis of pertinent data.
(Source: RHW / MHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prévision à long terme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pronóstico a largo plazo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Langzeitvorhersage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorspelling op lange termijn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">долгосрочное прогнозирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс предвидения и расчета вероятных условий, событий, наступление которых ожидается в отдаленном будущем, часто связано с изучением и анализом специальных данных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنبؤ طويل الأجل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3400" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2623">
    <skos:prefLabel xml:lang="en">electronic material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériel électronique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material electrónico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektronisches Material</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elektronisch materiaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">материал, используемый в электронике</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة إلكترونية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7597" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7548">
    <skos:prefLabel xml:lang="en">secondary sector</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The part of a country or region's economy that produces commodities without much direct use of natural resources.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">secteur secondaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sector secundario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sekundärer Sektor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">secundaire sector</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производственный сектор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сектор экономики, в рамках которого осуществляется промышленное производство и обработка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قطاع ثانوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7554" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7551">
    <skos:prefLabel xml:lang="en">second-hand goods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Goods or products that have been used previously.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marchandise d'occasion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mercancías de segunda mano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebrauchtwaren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tweedehandsgoederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">товары, бывшие в употреблении</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Товары или изделия, которые были в употреблении.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلع مستعملة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10930" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6720">
    <skos:prefLabel xml:lang="en">propellant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A gas used in aerosol preparations to expel the liquid contents through an atomizer.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gaz propulseur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">propulsor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Treibstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drijfgas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пропеллент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газ, используемый в составе аэрозолей для распыления жидкого содержания через пульверизатор.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غاز دافع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7554">
    <skos:prefLabel xml:lang="en">economic sector</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A part of a country's or region's commercial, industrial and financial activity, delimited either by public, corporate and private organization of expenditures or by agriculture, manufacturing and service product types.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">secteur économique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sectores económicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftssektor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">economische sector</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономический сектор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть промышленной, коммерческой и финансовой деятельности страны или региона, разделенная по форме собственности участвующих предприятий (государственные компании, корпорации и частные компании) или по типу хозяйственной деятельности (сельское хозяйство, обрабатывающая промышленность, услуги и пр.).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قطاع اقتصادي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13148" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6619" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7548" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8403" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7557">
    <skos:prefLabel xml:lang="en">security of installations</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures, techniques or designs implemented to protect from harm or restrict access to any apparatus, machinery or construction put in place or connected for use.
(Source: RHW / MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sécurité des installations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">seguridad de instalaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anlagensicherheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veiligheid van installaties</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">безопасность промышленных установок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, приемы или планы, реализуемые для защиты или ограничения доступа к установленным или подключенным аппаратам, машинам или сооружениям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أمن التجهيزات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4040" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12764" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7560">
    <skos:prefLabel xml:lang="en">sedimentary basin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A geomorphic feature of the earth in which the surface has subsided for a prolonged time, including deep ocean floors, intercontinental rifts and elevated and interior drainage basins.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bassin de sédimentation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cuenca sedimentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sedimentationsbecken</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afzettingsbekken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">седиментационный бассейн</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бассейн, в котором взвесь удаляется из жидкости в процессе неподвижного оседания либо в результате постоянного потока при высокой скорости и длинным периодом задержания, позволяющим взвеси осесть.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حوض ترسيب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2400" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1101">
    <skos:prefLabel xml:lang="en">cadmium contamination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The release and presence in the air, water and soil of cadmium, a toxic, metallic element, from sources such as the burning of coal and tobacco and improper disposal of cadmium-containing waste.
(Source: FFD / EEN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contamination par le cadmium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación por cadmio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Cadmiumverseuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cadmiumvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение кадмием</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выброс и присутствие в воздухе, воде или почве кадмия,  попавшего в эти среды в результате сжигания угля, курения табачных изделий, а также неправильной утилизации кадмиесодержащих отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التلوث بالكادميوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11676" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7562">
    <skos:prefLabel xml:lang="en">sedimentation (industrial process)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The separation of an insoluble solid from a liquid in which it is suspended by settling under the influence of gravity or centrifugation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sédimentation (décantation)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sedimentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sedimentation (industrieller Prozess)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bezinking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">седиментация (метод очистки)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отделение нерастворимой твердой примеси от жидкости, в которой она взвешена, в процессе оседания под действием силы тяжести или в ходе центрифугирования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترسيب (عملية صناعية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12606" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7563">
    <skos:prefLabel xml:lang="en">sedimentation (geology)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of forming or accumulating sediment in layers, including such processes as the separation of rock particles from the material from which the sediment is derived, the transportation of these particles to the site of deposition, the actual deposition or settling of the particles, the chemical and other changes occurring in the sediment, and the ultimate consolidation of the sediment into solid rock.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sédimentation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sedimentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sedimentation (geologisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afzetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">седиментация (геол.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс накопления слоев осадочных материалов, включая такие процессы, как отделение частиц породы от материала, из которого осадочная порода получена, перенос этих частиц и оседание, процессы химического и другого изменения внутри осадочного материала, окончательная консолидация осадочного материала с образованием породы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترسيب (جيولوجيا)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3648" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7565">
    <skos:prefLabel xml:lang="en">sediment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any material transported by water which will ultimately settle to the bottom after the water loses its transporting power.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sédiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sedimento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sediment</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afzetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">осадок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой материал, переносимый водой, который оседает на дне, когда вода теряет свою способность к его переносу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترسيبات - مواد مترسبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4855" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/341" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5049" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5417" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7698" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7733" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12220" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7566">
    <skos:prefLabel xml:lang="en">sediment transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The movement and carrying- away of sediment by natural agents; especially the conveyance of a stream load by suspension, saltation, solution or traction.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport de solides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte de sedimientos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Feststofftransport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sedimentvervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">перемещение осадков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Передвижение и перенос осадков природными факторами; особенно перемещение таких материалов в водном потоке в виде отдельных предметов, взвесей, растворов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقل الترسيبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4115" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7567">
    <skos:prefLabel xml:lang="en">seed (biology)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mature fertilized plant ovule, consisting of an embryo and its food store surrounded by a protective seed coat (testa).
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">graine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">semilla</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Samen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zaad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">семя (биол.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Зрелая оплодотворенная растительная семяпочка, состоящая из эмбриона с запасом питательных веществ, окруженных предохраняющей кожурой (тестой).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حب - بذر  (أحياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7568">
    <skos:prefLabel xml:lang="en">seed dressing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical applied before planting to protect seeds and seedlings from disease or insects.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">désinfection des semences</skos:prefLabel>
    <skos:prefLabel xml:lang="es">preparación de semilla</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Saatgutbeizmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">droogontsmetting van zaad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предпосевная обработка семян</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химикат, которым обрабатываются семена и рассада до сева или высаживания в целях предохранения от болезней либо вредителей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تطهير الحبوب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/237" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7571">
    <skos:prefLabel xml:lang="en">water seepage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The slow movement of water through small openings and spaces in the surface of unsaturated soil into or out of a body of surface or subsurface water.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">percolation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuga de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Versickerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kwel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">просачивание воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Медленное движение воды через маленькие отверстия и трещины на поверхности несатурированной почвы внутрь либо из поверхностного или подземного водоема.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انسياب الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7340" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7574">
    <skos:prefLabel xml:lang="en">seepage water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water that moves slowly through small openings of a porous material such as soil or the amount of water that has been involved in seepage.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">percolat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua de filtración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sickerwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kwelwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фильтрованная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, которая медленно проникает через маленькие отверстия пористого материала, например, почвы, либо количество воды, которая прошла фильтрование.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء الانسياب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7575">
    <skos:prefLabel xml:lang="en">seismic activity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The phenomenon of Earth movements.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">activité sismique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actividad sísmica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Seismische Aktivität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">seismiciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сейсмическая активность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Явление движения земной коры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشاط زلزالي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3648" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/986" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2402" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6724">
    <skos:prefLabel xml:lang="en">properties of materials</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The physical and chemical characteristics of the substances or parts of  which a thing or object is made.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">caractéristiques des matériaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">propiedades de materiales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stoffeigenschaften</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">materiaaleigenschappen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">свойства материалов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Физические и химические характеристики вещества, компонентов, из которых состоит вещь или предмет.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خصائص المواد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5086" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/349" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1094" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2042" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2871" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3854" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4296" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5090" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7009" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8140" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8546" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8556" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9395" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11787" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14245" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14254" />
