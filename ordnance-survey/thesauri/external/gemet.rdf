  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13104">
    <skos:prefLabel xml:lang="en">rural habitat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The biotopes located in areas where agriculture is practiced.
(Source: RAMADE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">habitat rural</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hábitat rural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ländlicher Lebensraum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">woongebied in het platteland</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельская среда</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Биотопы, расположенные в сельскохозяйственных районах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موطن ريفي</skos:prefLabel>
