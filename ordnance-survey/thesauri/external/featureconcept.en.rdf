    <dct:title xml:lang="en">Rapids</dct:title>
    <skos:prefLabel xml:lang="en">Rapids</skos:prefLabel>
    <dct:description xml:lang="en">Portions of a stream with accelerated current where it descends rapidly but without a break in the slope of the bed sufficient to form a waterfall.</dct:description>
    <skos:definition xml:lang="en">Portions of a stream with accelerated current where it descends rapidly but without a break in the slope of the bed sufficient to form a waterfall.</skos:definition>
