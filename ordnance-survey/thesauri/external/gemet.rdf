  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9160">
    <skos:prefLabel xml:lang="en">water consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The utilization patterns and quantities entailed in a community or human group's use of water for survival, comfort and enjoyment.
(Source: ODE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">consommation d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consumo de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserverbrauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребление воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Схема и количество потребляемой воды в сообществе или группе людей в целях поддержания жизнедеятельности, для комфорта и развлечений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استهلاك المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1745" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4505" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/969">
    <skos:prefLabel xml:lang="en">botanical garden</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place in which plants are grown, studied and exhibited.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">jardin botanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">jardines botánicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Botanischer Garten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">botanische tuin</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ботанический сад</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где выращивают, изучают и демонстрируют растения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حديقة نباتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5215">
    <skos:prefLabel xml:lang="en">microbial resource</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any available source of supply derived from microbes, which would be used for beneficial purposes, such as for the production of food substances and drugs.
(Source: APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ressource microbienne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recursos microbianos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikrobielle Ressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microbiële bronnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микробный ресурс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ресурс, обеспечиваемый микробами, который может использоваться для таких положительных целей, как производство медицинских препаратов или продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر ميكروبي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/873" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/971">
    <skos:prefLabel xml:lang="en">botany</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of the biological sciences which embraces the study of plants and plant life.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">botanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">botánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Botanik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ботаника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одна из биологических наук, изучающая растения и растительную жизнь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم النباتات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4805" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2069" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5463" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6248" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6316" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11869" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9034">
    <skos:prefLabel xml:lang="en">warning plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A scheme or method of acting developed in advance to notify as quickly as possible the affected population of any sudden, urgent and usually unexpected occurrence requiring immediate action.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'alerte</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan de advertencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Alarmplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waarschuwingsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план оповещения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разработанные заранее схема или метод действий, предназначенные как можно быстрее оповестить население о каком-либо внезапном, срочном и, как правило, неожиданном событии, требующем немедленных действий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة إنذار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2656" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9165">
    <skos:prefLabel xml:lang="en">water distribution system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The system of pipes supplying water to communities and industries.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau de distribution d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de distribución de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserverteilungssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterdistributiesysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система водоснабжения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система труб, по которой подается вода в жилые или промышленные районы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام توزيع الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4082" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5439" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9290" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12231" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12240" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9166">
    <skos:prefLabel xml:lang="en">water endangering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Can be caused by a variety of means, e.g. farm pollution from animal wastes and silage liquor (liquors from green leaf cattle food which has had molasses added to promote fermentation and preservation; they are highly polluting and can be a seasonal cause of fish deaths in small streams), leachate from landfill sites, and spoil heaps, solvent discharge to sewers or to land and inadequate sewage treatment works.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">risque sur la qualité de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">peligro para el agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wassergefährdung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedreiging van water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">угроза воде</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В качестве причины могут выступать разнообразные факторы, например, сельскохозяйственные животные отходы и забродивший силос (спиртосодержащая масса, образовавшаяся в результате добавления черной патоки к зеленым кормам для ферментации и консервации; сильно загрязняет окружающую среду и может привести к гибели рыб при попадании в небольшие ручьи), жидкость, образовавшаяся в мусорной яме или куче, выброс растворителей в водные стоки либо в землю, недостаточная переработка канализационных стоков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعريض الماء للخطر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2829" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2704" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9202" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/975">
    <skos:prefLabel xml:lang="en">boundary crossing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Crossing of a state border.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transfert transfrontalier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pasar el límite</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grenzüberschreitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grensoverschrijding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пересечение границы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пересечение государственной границы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عبور الحدود</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8641" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/963" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/976">
    <skos:prefLabel xml:lang="en">boundary layer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The layer of fluid adjacent to a physical boundary in which the fluid motion is significantly affected by the boundary and has a mean velocity less than the free stream value.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">couche limite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estrato límite</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grenzschicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grenslaag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пограничный слой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Слой жидкости, прилегающий к физической границе, которая оказывает существенное влияние на движение жидкости, а средняя скорость этого движения меньше, чем значение свободного потока.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الطبقة الحدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/627" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/963" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/977">
    <skos:prefLabel xml:lang="en">bovid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any animal belonging to the Bovidae family.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bovidé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bóvidos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bovidae</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">runderachtigen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бычий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое животное, принадлежащее к семейству Bovidae.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بقري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8769" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13639" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9170">
    <skos:prefLabel xml:lang="en">waterfall</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A perpendicular or steep descent of the water of a stream, as where it crosses an outcrop of resistant rock overhanging softer rock that has been eroded or flows over the edge of a plateau of cliffed coast.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cascade</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cascada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водопад</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Падение водного потока перпендикулярно вниз или под большим наклоном, например, с уступа, образованного твердой породой над более мягким слоем, размытым водой, либо через край плато или скалы на побережье.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شلال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9171">
    <skos:prefLabel xml:lang="en">water flea</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fresh-water branchiopod crustaceans characterized by a transparent bivalve shell.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">puce d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pulgas de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daphnien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">watervlooien</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водяная блоха</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пресноводное ракообразное, характеризуемое наличием прозрачной двустворчатой оболочки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">برغوث الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1889" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9172">
    <skos:prefLabel xml:lang="en">hydrologic flow</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The characteristic behaviour and the total quantity of water involved in a drainage basin, determined by measuring such quantities as rainfall, surface and subsurface storage and flow, and evapotranspiration.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">régime hydrologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">caudal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserfluß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hydrologische stroming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">расчет гидрологического потока</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Характерное поведение и общее количество воды в водосборном бассейне, определяемые в ходе измерения величины выпавших осадков, поверхностных и подповерхностных стоков и вод и эвапотранспирации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدفق المائي (الهيدرولوجي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3311" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7149" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/984">
    <skos:prefLabel xml:lang="en">brackish water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water, salty between the concentrations of fresh water and sea water; usually 5-10 parts x thousand.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau saumâtre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua salobre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brackwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">brakwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">солоноватая вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, показатель солености которой находится между показателем пресной и морской воды; как правило, составляет 5-10 частей на тысячу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه قليلة الملوحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/986">
    <skos:prefLabel xml:lang="en">bradyseism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A long-continued, extremely slow vertical instability of the crust, as in the volcanic district west of Naples, Italy, where the Phlegraean bradyseism has involved up-and-down movements between 6 m below sea level and 6 m above over a period of more than 2.000 years.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bradyséisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bradiseísmo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bradyseismus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(trage) bodemschommelingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">брадисейсмы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продолженная, чрезвычайно медленная вертикальная нестабильность земной коры, такая, как, например, в вулканическом районе к западу от Неаполя (Италия), где находится Флеграэнский брадисейсм. В течение периода свыше 2 тыс. лет в этом районе происходили колебания земной коры от 6 м ниже уровня моря до 6 метров выше уровня моря.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختلاجات أرضية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7575" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2895">
    <skos:prefLabel xml:lang="en">environmental pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The introduction by man into the environment of substances or energy liable to cause hazards to human health, harm to living resources and ecological systems, damage to structure or amenity, or interference with legitimate uses of the environment.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution de l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltverschmutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выброс человеком в окружающую среду веществ или энергии, способных нести угрозу здоровью людей, живым ресурсам и экологическим системам, природной структуре и красоте, а также в нарушение существующих законов по использованию природных ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6445" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/636" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4636" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8621" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8833" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9202" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9180">
    <skos:prefLabel xml:lang="en">water for industrial use</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water used by industries for purposes such as fabrication, processing, washing and cooling, which is obtained from a public supply or through self-supplied sources.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau industrielle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua para uso industrial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brauchwasser (Industrie)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">water voor industrieel gebruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вода для промышленного использования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, используемая в промышленности при таких операциях, как производство, обработка, промывка, охлаждение, получаемая из коммунальных или собственных источников.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه للاستخدامات الصناعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1786" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6655" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1530">
    <skos:prefLabel xml:lang="en">coating</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A material applied onto or impregnated into a substrate for protective, decorative, or functional purposes. Such materials include, but are not limited to, paints, varnishes, sealers, adhesives, thinners, diluents, and inks.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">revêtement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">revestimientos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beschichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">deklaag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">покрытие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, нанесенный на поверхность или которым пропитана поверхность другого материала в  защитных, декоративных или каких-либо функциональных целях. Перечень таких материалов включает краски, лаки, мастики, адгезивы, растворители, но не ограничивается ими.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكسية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9183">
    <skos:prefLabel xml:lang="en">waterfowl</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Aquatic birds which constitute the order Anseriformes, including the swans, ducks, geese, and screamers.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">avifaune aquatique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aves acuáticas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasservogel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">watervogels</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водоплавающие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Водоплавающие птицы, составляющие отряд Anseriformes, который включает в том числе лебедей, уток, гусей и паламедий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الطيور المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9184">
    <skos:prefLabel xml:lang="en">water hardness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of calcium and magnesium salts dissolved in water.
(Source: MGHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dureté de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dureza del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserhärte</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterhardheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жесткость воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество солей кальция и марганца, растворенных в воде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صلابة الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1673" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/994">
    <skos:prefLabel xml:lang="en">breeding</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The application of genetic principles to the improvement of farm animals and cultivated plants.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">amélioration génétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">crianza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Züchtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fokken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение растений и животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение принципов генетики в целях улучшения пород сельскохозяйственных животных и культивируемых растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحسين الجيني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/429" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3073" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3151" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4390" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4863" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4864" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11192" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11198" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11199" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/995">
    <skos:prefLabel xml:lang="en">breeding bird</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The individuals in a bird population that are involved in reproduction during a particular period in a given place.
(Source: ALL2a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oiseaux nicheurs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aves nidificantes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brutvogel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">broedvogel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">птица в период размножения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отдельные особи в популяции птиц, которые участвуют в процессе репродукции в течение определенного периода времени в конкретном районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طيور تفريخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/997">
    <skos:prefLabel xml:lang="en">brewing industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of commercial enterprises is engaged in the manufacture and marketing of beverages made from malt and hops by steeping, boiling and fermentation, such as beer, ale and other related beverages.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">secteur de brasserie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de la cerveza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brauerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">brouwerijnijverheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пивоваренная промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сектор экономики, предприятия которого осуществляют производство и торговлю напитков, изготавливаемых в процессе вымачивания, варки, ферментации из солода и хмеля. К таким напиткам относятся пиво, эль и др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة البيرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/783" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9190">
    <skos:prefLabel xml:lang="en">water level</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The level reached by the surface of a body of water.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserstand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterstand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Уровень воды в водоеме.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2897">
    <skos:prefLabel xml:lang="en">environmental programme</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An organized group of activities and procedures, often run by a government agency or a nonprofit organization, to protect natural or ecological resources and advocate for ecological progress.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">programme environnemental</skos:prefLabel>
    <skos:prefLabel xml:lang="es">programas ambientales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltprogramm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuprogramma</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическая программа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организованный комплекс мер и процедур, часто находящихся в ведении государственного или неправительственного органа, направленных на охрану природных, экологических ресурсов и защиту экологического прогресса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">برنامج بيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6705" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2756" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5539" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7984" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9193">
    <skos:prefLabel xml:lang="en">waterlogged land</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waterlogging is an effect of canal irrigation; it occurs when the water table rises to within 3 meters of a crop's roots, impeding their ability to absorb oxygen and ultimately compromising crop yields. Many factors contribute to waterlogging. These include inadequate drainage, improper balance in the use of groundwater and surface water, seepage and percolation from unlined channels, overwatering, planting crops not suited to specific soils, and inadequate preparation of land before irrigation.
(Source: WRES)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sol saturé (engorgé) d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tierras anegadas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vernäßter Boden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заболоченная земля</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заболачивание является следствием ирригации через каналы; проявляется, когда уровень воды поднимается к корням растений выше, чем на 3 м, нарушая их способность поглощать кислород и в конечном итоге отрицательно сказываясь на урожае. Заболачиванию способствуют многие факторы, среди которых недостаточный дренаж, дисбаланс в использовании грунтовых и поверхностных вод, протечки в ирригационных каналах без гидроизоляции, излишний полив, разведение сельскохозяйственных культур на не соответствующих им почвах, недостаточная подготовка земель перед ирригацией.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أرض مشبعة بالماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7345" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9195">
    <skos:prefLabel xml:lang="en">water management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures taken to ensure an adequate supply of water and a responsible utilization of water resources.
(Source: KORENa /  PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление водными ресурсами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, предпринимаемые для обеспечения достаточных запасов воды и ответственного использования водных ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2877" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5440" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9164" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9216" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9217" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9230" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10058" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9196">
    <skos:prefLabel xml:lang="en">water monitoring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Studies conducted to estimate the quantity and the quality of pollutants, nutrients and suspended solids contained in water bodies and to assess sources and factors associated with agricultural practices, industrial activities or other human activities.
(Source: DNRa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surveillance de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">supervisión de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">watertoezicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мониторинг воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Исследования, проводимые для оценки количества и качества загрязняющих веществ, питательных веществ и взвешенных твердых материалов в водоемах, оценки их источников и факторов, связанных с сельскохозяйственной практикой, промышленной деятельностью и другой деятельностью человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مراقبة المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5346" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3491" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5042" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8133" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1007">
    <skos:prefLabel xml:lang="en">bromine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pungent dark red volatile liquid element of the halogen series that occurs in brine and is used in the production of chemicals.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">brome</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bromo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brom</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">broom</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бром</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Едкий, темно-красный летучий жидкий элемент из группы галогенов, который встречается в соляных растворах и используется для производства химикатов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">برومين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2642" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14082">
    <skos:prefLabel xml:lang="en">emergency lodging</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Housing or dwelling space provided for victims of a sudden, urgent and usually unexpected occurrence, especially when harm has been done to human life, property or the environment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hébergement d'urgence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salida de emergencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Notunterkunft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schuilplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">временное жилье на случай чрезвычайной ситуации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жилье или жилое помещение, предоставленное жертвам внезапного, чрезвычайного и, как правило, неожиданного события, особенно в случае нанесения ущерба физическому здоровью людей, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إسكان طوارئ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10898" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9202">
    <skos:prefLabel xml:lang="en">water pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The manmade or man-induced alteration of the chemical, physical, biological and radiological integrity of water.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserverunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterverontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изменение химической, физической, биологической или радиологической целостности воды, вызванное человеком или являющееся следствием его деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2895" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1523" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3493" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5044" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2679" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3007" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3269" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5848" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9166" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9203">
    <skos:prefLabel xml:lang="en">water pollution prevention</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Precautionary measures, actions or installations implemented to avert or hinder human-made or human-induced alteration of the physical, biological, chemical and radiological integrity of water.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prévention de la pollution de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prevención de contaminación del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewässerschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorkomen van waterverontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предотвращение загрязнения воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Профилактические меры, действия или установки, реализуемые для предотвращения или пресечения изменения химической, физической, биологической или радиологической целостности воды, вызванного человеком или являющегося следствием его деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الوقاية من تلوث المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10049" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1014">
    <skos:prefLabel xml:lang="en">brooding</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To incubate eggs or cover the young for warmth.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">couvaison</skos:prefLabel>
    <skos:prefLabel xml:lang="es">incubación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brüten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">broeden</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">высиживание яиц</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высиживать яйца или накрывать птенцов для тепла.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحضن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10548" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1015">
    <skos:prefLabel xml:lang="en">brook</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A small stream or rivulet, commonly swiftly flowing in rugged terrain, of lesser length and volume than a creek; especially a stream that issues directly from the ground, as from a spring or seep, or that is produced by heavy rainfall or melting snow.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ruisseau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arroyo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bach</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ручей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Маленькая речка, обычно протекающая в сильно пересеченной местности, часто бьющая прямо из-под земли в виде ключа или подземного источника, иногда является следствием сильных дождей или процесса таяния снега.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جدول ماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9161" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10152" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9208">
    <skos:prefLabel xml:lang="en">water protection legislation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">législation en matière de protection de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación de protección de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewässerschutzrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbeschermingswetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство по вопросам охраны водных ресурсов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تشريع حماية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2862" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9209">
    <skos:prefLabel xml:lang="en">water pump</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A machine or apparatus used to lift water, usually from a well or borehole, which is powered manually or by engine, wind or some other source.
(Source: RHW / GLG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pompe à eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bomba de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserpumpe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterpomp</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водяной насос</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машина или прибор, предназначенные для подъема воды обычно из скважины или колодца,  приводимые в движение энергией человека, двигателя, ветра или другого источника.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مضخة مياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6831" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9210">
    <skos:prefLabel xml:lang="en">water purification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of several processes in which undesirable impurities in water are removed or neutralized.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">épuration de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">purificación de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterzuivering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистка воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные процессы, в ходе которых нежелательные примеси удаляются из воды или нейтрализуются.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنقية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9246" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9211">
    <skos:prefLabel xml:lang="en">water purification plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plant where water, through physical and chemical processes, is made suitable for human consumption and other purposes.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">usine de potabilisation de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plantas depuradoras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserreinigungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterzuiveringsinstallatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водоочистное производство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Завод, на котором в ходе физических и химических процессов вода становится пригодной для потребления человеком и для использования в иных целях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصنع لتنقية المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6842" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1020">
    <skos:prefLabel xml:lang="en">brushwood</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Woody vegetation including shrubs and scrub trees of non-commercial height and form, often seen in the initial stages of succession following a disturbance. Brush often grows in very dense thickets that are impenetrable to wild animals and serve to suppress the growth of more desirable crop trees. However, brush can also serve an important function as desirable habitat for a range or bird, animal, and invertebrate species, and often provides a good source of browse and cover for larger wildlife. It adds structural diversity within the forest and is important in riparian zones. It is also termed scrub.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">broussaille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">malezas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterholz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruigte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кустарниковые заросли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лесистая растительность, включая кустарники, в силу малой высоты и формы непригодные для промышленного использования, часто характеризуют начальную стадию процесса, последовавшего за нарушением природного баланса. Заросли часто бывают очень плотными и непроходимыми для диких животных и препятствуют росту более ценных древесных пород. Однако кустарниковые заросли могут выполнять и полезные функции, представляя удобную среду обитания для многих птиц, беспозвоночных, а также надежное укрытие для более крупных диких животных. Одновременно с лесом кустарниковые заросли добавляют разнообразие в ландшафт; а в прибрежной зоне представляются очень важными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دغل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8386" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7683" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10699" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8362">
    <skos:prefLabel xml:lang="en">temperate woodland</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Forest dominated by broad-leaved hardwoods, which occurs over large tracts in the mid-latitudes of Europe, N. America, and eastern Asia, but which is restricted in the southern hemisphere to Chilean Patagonia.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">région à forêt tempérée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bosques de zona templada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Temperater Wald</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">woudgebied in de gematigde klimaatzone</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">редколесье умеренной климатической зоны</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лес, где преобладают широколиственные деревья с твердой древесиной, встречающийся на больших территориях в средних широтах Европы, Северной Америки и Восточной Азии, а в южном полушарии встречающийся только в чилийской Патагонии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة غابات معتدلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9349" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8361" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9214">
    <skos:prefLabel xml:lang="en">water quality</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A graded value of the components (organic and inorganic, chemical or physical) which comprise the nature of water.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">qualité de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calidad del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wassergüte</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterkwaliteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">качество воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дифференцирование величины содержания компонентов (органических, неорганических, химических, физических) в воде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوعية الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9138" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13106" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/486" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/947" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1536" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5892" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5986" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9147" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9184" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9196" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12226" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1023">
    <skos:prefLabel xml:lang="en">bryophyte</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any plant of the division Bryophyta, having stems and leaves but lacking true vascular tissue and roots and reproducing by spores: includes the mosses and liverworts.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bryophites</skos:prefLabel>
    <skos:prefLabel xml:lang="es">briofitas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bryophyten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mossen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бриофиты (мхи и печеночники)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое растение из класса Bryophyta, у которого имеются ствол и листья, однако отсутствует сосудистая ткань и корни, а репродукция осуществляется посредством спор. К таким растениям относятся мхи и печеночники.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النباتات اللاوعائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1890" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5377" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1024">
    <skos:prefLabel xml:lang="en">bubble policy (emissions trading)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">EPA policy that allows a plant complex with several facilities to decrease pollution from some facilities while increasing it from others, so long as total results are equal to or better than previous limits. Facilities where this is done are treated as if they exist in a bubble in which total emissions are averaged out.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique de la "bulle" (permis d'émissions négociables)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política de burbuja (comercio de emisiones)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Glockenpolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">koepelbeleid (verhandelbare emissierechten)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика зачета уровней выброса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политика, позволяющая промышленному предприятию, располагающему несколькими производствами, снизить выброс загрязняющих веществ одними производствами и увеличить загрязнение за счет других производств при условии, что общий итог будет соответствовать или будет ниже установленного лимита.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة الفقاعة (تبادل الانبعاثات)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1025">
    <skos:prefLabel xml:lang="en">budget</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A balance sheet or statement of estimated receipts and expenditures. A plan for the coordination of resource and expenditures. The amount of money that is available for, required for, or assigned to a particular purpose.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">budget</skos:prefLabel>
    <skos:prefLabel xml:lang="es">presupuesto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Budget</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">begroting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бюджет</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Баланс или смета ожидаемых поступлений и платежей. План, координирующий имеющиеся ресурсы и предполагаемые расходы. Средства, которые имеются в наличии, требуются или ассигнуются для определенной цели.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ميزانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13137" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12459">
    <skos:prefLabel xml:lang="en">classified facility</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Facility that is forbidden to be disclosed outside a specified ring of secrecy for reasons of national security.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">installation classée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">instalación clasificada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nichtöffentliche Anlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geclassificeerde inrichting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">режимный объект</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объект, доступ к которому запрещен по соображениям национальной безопасности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجهيزات مصنفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6291" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1028">
    <skos:prefLabel xml:lang="en">bug</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the suborder Heteroctera, having piercing and sucking mouthparts, specialized as a beak.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">punaise</skos:prefLabel>
    <skos:prefLabel xml:lang="es">chinches</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wantsen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">клоп</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель подотряда Heteroctera, у которого есть кусающие и сосущие челюсти, обычно вытянутые в виде хоботка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حشرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1029">
    <skos:prefLabel xml:lang="en">building</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Something built with a roof and walls, such as a house or factory.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bâtiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">edificios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebäude</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gebouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">здание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Строение с крышей и стенами, например, дом или завод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بناء- تشييد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1063" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1033" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1064" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2661" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3755" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3954" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4267" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5686" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7144" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13136" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4211" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1031">
    <skos:prefLabel xml:lang="en">building area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Land and other places on, under, in or through which the temporary and permanent works are to be executed and any other lands or places needed for the purposes of construction.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone construite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área edificable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Baugebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bouwterrein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">строительные площади</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Земля и другие территории на которых, под которыми, внутри которых или через которые будут проводиться постоянные или временные работы, а также другие участки и места, необходимые для строительства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة بناء - منطقة مباني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1041" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1033">
    <skos:prefLabel xml:lang="en">building component</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A building element which uses industrial products that are manufactured as independent until capable of being joined with other elements.
(Source: HARRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composant préfabriqué (bâtiment)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">componentes de un edificio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bauelemente</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(ge)bouwonderdeel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">строительный элемент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть конструкции на основе промышленных изделий, произведенных как самостоятельные продукты, а затем соединенные вместе с другими.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُكَوِّن في البناء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1029" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1355" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8039" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9023" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10068" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9227">
    <skos:prefLabel xml:lang="en">water reuse</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use of process wastewater or treatment facility effluent in a different manufacturing process.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réutilisation de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reutilización del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserwiederverwendung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hergebruik van water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">повторное использование воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование отработанной воды или стоков водоочистного сооружения в различных производственных процессах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعادة استخدام المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9229">
    <skos:prefLabel xml:lang="en">water salination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Process by which water becomes more salty, found especially in hot countries where irrigation is practised.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">augmentation de la salinité de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salinización de aguas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserversalzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verzilting van water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">засоление воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого вода становится более соленой; характерен для стран с жарким климатом, широко применяющих ирригацию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تملح الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7376" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9230">
    <skos:prefLabel xml:lang="en">water saving</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Management of water resources aiming at ensuring the continued availability of water for human uses and natural ecosystems.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ahorro de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wassereinsparung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbesparing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономия воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление водными ресурсами для обеспечения регулярного снабжения водой для нужд человека или природных экосистем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدخار الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1745" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9195" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1039">
    <skos:prefLabel xml:lang="en">building industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The art and technique of building houses.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie du bâtiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de la construcción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bauwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">строительная индустрия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Искусство и технология возведения домов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة البناء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1728" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9232">
    <skos:prefLabel xml:lang="en">water (geographic)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The liquid that forms streams, lakes, and seas, and issues from the ground in springs.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eaux (géographie)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua (geografía)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewässer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wateren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">воды (геогр.)</skos:prefLabel>
