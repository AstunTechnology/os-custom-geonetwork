    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6282">
    <skos:prefLabel xml:lang="en">plankton</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Small organisms (animals, plants, or microbes) passively floating in water.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plancton</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plancton</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Plankton</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plankton</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">планктон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мелкие организмы (животные, растения или микробы), пассивно плавающие в воде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العوالق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/511" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6247" />
