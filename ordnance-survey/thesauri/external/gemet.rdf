    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10986" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10202">
    <skos:prefLabel xml:lang="en">state biological reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An area of land and/or of water designated as having protected status for purposes of preserving certain biological features. Reserves are managed primarily to safeguard these features and provide opportunities for research into the problems underlying the management of natural sites and of vegetation and animal populations. Regulations are normally imposed controlling public access and disturbance.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve biologique gouvernementale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reserva biológica estatal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Staatliches biologisches Schutzgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurreservaat van de staat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">государственный биологический заповедник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок суши и/или водной среды, обладающий статусом охраняемой территории с целью сохранения определенных биологических черт. Заповедники сохраняют эти черты и обеспечивают возможности для исследования проблем, относящихся к управлению такими районами, популяциями растений и животных. В таких заповедниках, как правило, существуют ограничения на пребывание людей и их деятельность.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية حيوية حكومية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7137" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/335">
    <skos:prefLabel xml:lang="en">allocation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The assignment or allotment of resources to various uses in accord with a stated goal or policy.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">affectation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">adjudicación, asignación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Allokation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestemming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">распределение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ассигнование или выделение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخصيص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2498" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2014">
    <skos:prefLabel xml:lang="en">decomposition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The more or less permanent breakdown of a molecule into simpler molecules or atoms.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décomposition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">descomposición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afbraak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разложение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Более или менее постоянное разложение молекулы вещества на более простые молекулы или атомы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحلل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5797">
    <skos:prefLabel xml:lang="en">oceanography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The scientific study and exploration of the oceans and seas in all their aspects.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">océanographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oceanografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ozeanographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oceanografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">океанография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение и исследование всех аспектов океанов и морей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم المحيطات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9231" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1312" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2973" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6224" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10208">
    <skos:prefLabel xml:lang="en">voluntary natural reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area of national interest which is protected under the responsibility of its owner in order to safeguard wildlife, archeological and geological sites.
(Source: UNIONa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve naturelle volontaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reserva natural voluntaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freiwilliges Naturreservat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrijwillig natuurreservaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">частный природный заповедник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Район, представляющий национальный интерес, охраняемый его владельцем в целях защиты дикой природы, археологических или геологических объектов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية طبيعية تطوعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5545" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10210">
    <skos:prefLabel xml:lang="en">central park area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The core area of a park or of a reserve where there can be no interference with the natural ecosystem.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone centrale de parc</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona central de parque</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zentraler Parkbereich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgesloten natuurgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">центральная часть природного парка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ядро национального парка или заповедника, где не может быть никакого нарушения природной экосистемы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المنطقة المركزية في حديقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5513" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10160">
    <skos:prefLabel xml:lang="en">coral reef lagoon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A coastal stretch of shallow saltwater virtually cut off from the open sea by a coral reef.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lagon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">laguna de arrecife de coral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lagune innerhalb von Korallenriffen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">koraalriflagune</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лагуна кораллового рифа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прибрежная полоса морского мелководья, практически отрезанная от открытого моря коралловым рифом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بحيرة شعاب مرجانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4589" />
