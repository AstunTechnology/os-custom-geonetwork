  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7781">
    <skos:prefLabel xml:lang="en">social behaviour</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A person or community's general treatment, manner of conduct or action toward others as individuals or as members of variously identified groups.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">comportement social</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comportamiento social</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sozialverhalten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sociaal gedrag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">социальное поведение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общее отношение, манера поведения или действие отдельного лица или сообщества по отношению к другим отдельным лицам или представителям конкретных социальных групп.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلوك اجتماعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7823" />
