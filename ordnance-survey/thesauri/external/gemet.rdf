    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3599">
    <skos:prefLabel xml:lang="en">gas supply</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The provision and storage of any fuel gas, or the amount of any fuel gas stored, for the use of a municipality, or other fuel gas user.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">alimentation en gaz</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suministro de gas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gasversorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gasvoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">запасы газа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Образование запасов и хранение любого топливного газа либо количество хранимого газа для нужд города или другого потребителя топливного газа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإمداد بالغاز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6817" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12587" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3570" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3586" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3596" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3604" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1594">
    <skos:prefLabel xml:lang="en">commercial traffic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The operations and movements related to the transportation and exchange of goods.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic commercial</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico comercial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Handelsverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zakelijk verkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">движение грузового транспорта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Операции и движение, связанные с транспортировкой и торговлей товарами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل التجاري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8563" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11294" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1595">
    <skos:prefLabel xml:lang="en">commercial vehicle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Vehicle designed and equipped for the transportation of goods.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">véhicule commercial</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vehículo comercial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nutzfahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsvoertuig</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">грузовое транспортное средство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспортное средство, предназначенное и оборудованное для транспортировки товаров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مَركَبة تجارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1596">
    <skos:prefLabel xml:lang="en">trade waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">All types of waste generated by offices, restaurants, shops, warehouses and other such non-manufacturing sources, and non-processing waste generated at manufacturing facilities such as office and packaging waste.
(Source: EED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchets issus de l'activité commerciale (déchets banals)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuos comerciales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Handelsmüll</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">industrie-afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходы торговых предприятий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Все виды отходов, производимые в офисах, ресторанах, магазинах, складах и других аналогичных непроизводственных организациях, а также отходы, не связанные с промышленной переработкой, как, например, отходы упаковки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات النشاط التجاري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1600">
    <skos:prefLabel xml:lang="en">common agricultural policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The set of regulations and practices adopted by member countries of the European Community that consolidates efforts in promoting or ensuring reasonable pricing, fair standards of living, stable markets, increased farm productivity and methods for dealing with food supply or surplus.
(Source: CNI)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique agricole commune</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política agrícola común</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemeinsame Agrarpolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeenschappelijk landbouwbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">"Единая сельскохозяйственная политика"</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Набор правил, принятых странами-членами Европейского Союза, способствующих установлению и поддержанию разумных цен, приемлемого уровня жизни, стабильности рынков, высокой производительности сельского хозяйства, а также применению методов решения вопросов дефицита или избытка продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة زراعية مشتركة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2533" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1601">
    <skos:prefLabel xml:lang="en">common agreement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system of law established by following earlier judicial decisions and customs, rather than statutory or legislatively enacted law.
(Source: BLD / WOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">règle générale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acuerdo común</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemeinsame Regeln</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeenschappelijke regeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общее соглашение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система права, установленная в результате применения ранее реализованных юридических решений или обычаев, а не законов, введенных в действие в законодательном порядке.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاقية مشتركة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1605">
    <skos:prefLabel xml:lang="en">communications</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The concept, science, technique and process of transmitting, receiving or otherwise exchanging information and data.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">communication</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comunicaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kommunikation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">communicatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">связь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Концепция, наука, технология и процесс передачи, получения или обмена информацией и данными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتصالات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1691" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4309" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4310" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8347" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13313" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1613">
    <skos:prefLabel xml:lang="en">ecological community</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) All of the plants and animals in an area or volume; a complex association usually containing both animals and plants. 
2) Any naturally occurring group of organisms that occupy a common environment.
(Source: LANDY /  ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">communauté écologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comunidad ecológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökologische Gesellschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecologische (levens)gemeenschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическое сообщество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Все растения и животные на конкретной территории или в объеме; сложная система, обычно содержащая как животных, так и растения. 2)  Любая группа организмов, встречающаяся в природных условиях и занимающая общую среду обитания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المجتمع الإيكولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6299" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1616">
    <skos:prefLabel xml:lang="en">Community law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The law of European Community (as opposed to the national laws of the member states.) It consists of the treaties establishing the EC (together with subsequent amending treaties) community legislation, and decisions of the court of justice of the European Communities. Any provision of the treaties or of community legislation that is directly applicable or directly effective in a member state forms part of the law of that state and prevails over its national law in the event of any inconsistency between the two.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit communautaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho comunitario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemeinschaftsrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wet van de Europese Gemeenschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законы Сообщества</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Законы Европейского Сообщества (в отличие от национальных законов отдельных стран-членов). Состоят из договоров по созданию ЕС (вместе с дополнившими их соглашениями, принятыми в более поздний период), законов Сообщества и решений Суда ЕС. Любое положение общеевропейского договора или закона, которое напрямую применимо или действует в отдельной стране, является неотъемлемой частью национального законодательства этой страны и имеет верховную силу в случае конфликта с положением национального закона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون الجماعة الأوروبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13281" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13282" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3006" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3000">
    <skos:prefLabel xml:lang="en">European nature reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve naturelle européenne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Reserva natural europea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Europareservat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">EuroPees natuurreservaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">европейский природный заповедник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية طبيعية أوروبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5545" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1618">
    <skos:prefLabel xml:lang="en">community participation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Involvement in public or private actions, as members or as a member of a particular ethnic, political or social group, with the purpose of exerting influence.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">participation communautaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">participación comunitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kommunale Beteiligung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inspraak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">участие общественности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участие в общественных или индивидуальных акциях одного или нескольких представителей конкретных этнических, социальных, политических группировок с целью оказать влияние на какие-либо процессы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المشاركة المجتمعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/77" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1619">
    <skos:prefLabel xml:lang="en">community-pays principle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tenet of environmental policy, according to which the costs of ecological challenges, environmental quality improvements and the removal of environmental hazards are allotted to community groups or local corporations and, thereby, to the general public.
(Source: GAB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">principe de paiement communautaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">principio de pago comunitario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemeinlastprinzip</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het vervuiler-betaalt-principe</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">принцип "сообщество платит"</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Принцип экологической политики, в соответствии с которым расходы, связанные с улучшением качества окружающей среды, устранением каких-то экологических угроз, относятся на счет общественных групп, местных корпораций, т.е. широкой общественности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مبدأ المجتمع يدفع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4752" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1622">
    <skos:prefLabel xml:lang="en">commuter traffic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Traffic caused by people travelling regularly over some distance, as between a suburb and a city and back, between their place of residence and their place of work.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">migration pendulaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico diario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pendelverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">woon-werkverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пригородный транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение, связанное с регулярными перевозками людей на конкретное расстояние, как, например, движение между пригородом и городом, между местом работы и проживания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انتقال المسافرين يوميًا للعمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1623">
    <skos:prefLabel xml:lang="en">commuting</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">déplacement journalier domicile-travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intercambiador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pendeln</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pendelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поездки из пригорода в город и обратно</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">السفر يوميًا للعمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13343" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5814" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1625">
    <skos:prefLabel xml:lang="en">compaction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Reduction of the bulk of solid waste by rolling and tamping.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compactage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compactación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verdichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">samendrukking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">прессовка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сокращение объема твердых отходов за счет сжатия и утрамбовки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الضغط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1659" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2793">
    <skos:prefLabel xml:lang="en">environmental contingency planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The production of an organized, programmatic and coordinated course of action to be followed in the case of some accident, disaster or occurrence threatening an ecosystem and the human health or natural resources within it.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'intervention en cas de catastrophe</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación para situaciones de urgencia ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltkontingenzplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieurampen(bestrijdings)plan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разработка планов действий при экологических авариях</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Формулирование организованных, программных и координированных мер на случай аварии, бедствия или события, угрожающих экосистеме, здоровью человека и природным ресурсам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخطيط التدخل في حالات الطوارئ البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2218" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1628">
    <skos:prefLabel xml:lang="en">company policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Official guidelines or set of guidelines adopted by a company for the management of its activity.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique d'entreprise</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política de empresa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unternehmenspolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ondernemingsbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика компании</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Официальные правила или свод таких правил, принятых в компании для управления ее деятельностью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة الشركة أو المؤسسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4255" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1630">
    <skos:prefLabel xml:lang="en">comparative law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the principles of legal science by the comparison of various systems of law.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit comparé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho comparado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechtsvergleichung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergelijkend recht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сравнительное право</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение принципов юридической науки методом сравнения различных систем права.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القانون المقارن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1631">
    <skos:prefLabel xml:lang="en">comparative test</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Tests conducted to determine whether one procedure is better than another.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">test comparatif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prueba comparativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vergleichsuntersuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergelijkend onderzoek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сравнительный тест</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тест, проводимый для того, чтобы определить, насколько одна процедура лучше другой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار مقارن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8405" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1632">
    <skos:prefLabel xml:lang="en">comparison</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The placing together or juxtaposing of two or more items to ascertain, bring into relief, or establish their similarities and dissimilarities.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">comparaison</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comparación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vergleiche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergelijking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сравнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Расположение двух или более предметов рядом или напротив друг друга для того, чтобы установить какие-то факты, выяснить контрастирующие, схожие или отличные свойства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقارنة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3011" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1633">
    <skos:prefLabel xml:lang="en">compensation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Equivalent in money for a loss sustained; equivalent given for property taken or for an injury done to another; recompense or reward for some loss, injury or service.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compensation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compensación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entschädigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(schade)vergoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компенсация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Денежный эквивалент нанесенного урона, эквивалент отнятой собственности или нанесенного ущерба; возмещение или выплата за конкретный убыток, ущерб или услугу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعويض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13291" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1636">
    <skos:prefLabel xml:lang="en">compensatory measure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any administrative or legislative action, procedure or enactment designed to redress disruptions of ecological integrity or damage to the supply of natural resources.
(Source: BLD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure compensatoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medida compensatoria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökologische Ausgleichsmaßnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">compenserende maatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компенсационная мера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, принятые для того, чтобы восстановить, контролировать или нейтрализовать воздействие какого-либо проекта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إجراء تعويضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6373" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1637">
    <skos:prefLabel xml:lang="en">compensatory tax</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Compulsory charge levied by a government for the purpose of redressing or countervailing economic disparity.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taxe compensatoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">impuesto compensatorio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausgleichsabgabe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">compenserende belasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компенсационный налог</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательная плата, установленная правительством, для того, чтобы уравновесить, выровнять экономический дисбаланс.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضريبة تعويضية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1638">
    <skos:prefLabel xml:lang="en">competition (biological)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The simultaneous demand by two or more organisms or species for an essential common resource that is actually or potentially in limited supply.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compétition (biologique)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">competencia (biológica)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Konkurrenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">concurrentie [biologisch]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая конкуренция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одновременный спрос со стороны двух и более организмов или видов на общий жизненно важный ресурс, наличие которого ограничено или есть такая вероятность.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنافس (أحياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2438" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10554" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1639">
    <skos:prefLabel xml:lang="en">economic competition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The market condition where an individual or firm that wants to buy or sell a commodity or service has a choice of possible suppliers or customers.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concurrence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">competencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Konkurrenz (ökonomisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">concurrentie (economisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономическая конкуренция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действия одного или нескольких соперников в достижении одной конкретной цели. В рыночном контексте такой специфической целью является либо продажа товаров покупателям, либо покупка товаров у продавцов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنافس اقتصادي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1084" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2263" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13263" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13277" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13148">
    <skos:prefLabel xml:lang="en">economic structure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The underlying framework, including transportation and communications systems, industrial facilities, education and technology, that enables a country or region to produce goods, services and other resources with exchange value.
(Source: MGHME / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">structure économique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estructura económica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftsstruktur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">economische structuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономическая структура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Инфраструктура, включая системы транспорта и связи, промышленные объекты, образование, технологии, позволяющие стране или региону производить товары, услуги и другие ресурсы, обладающие меновой стоимостью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بنية اقتصادية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2516" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4423" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7554" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1641">
    <skos:prefLabel xml:lang="en">competitiveness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability of a firm to strive in the market with rivals in the production and sale of commodities or services and, analogously, the ability of a country to maintain a relatively high standard of living for its citizens through trade in international markets.
(Source: http://www.indiana.edu/~ipe/glossry.html / OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compétitivité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">competitividad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wettbewerbsfähigkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">concurrentievermogen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">конкурентоспособность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность компании выдерживать соревнование с соперниками в производстве и продаже товаров или услуг, а также способность страны обеспечивать относительно высокий уровень жизни для своих граждан за счет торговли на мировых рынках.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنافسية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13262" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3175">
    <skos:prefLabel xml:lang="en">fibreglass</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A material made from small fibres of glass twisted together, which is used for keeping buildings warm, or a plastic strengthened by these fibres and used for making structures such as the outsides of cars and boats.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fibre de verre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fibra de vidrio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Glasfaser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">glasvezel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стекловолокно</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, изготавливаемый из тонких переплетенных волокон стекла; используется для термоизоляции зданий, укрепления пластмасс, из которых отливаются конструкции, как, например, корпуса автомобилей или катеров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فايبرجلاس - ألياف زجاجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5267" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12395">
    <skos:prefLabel xml:lang="en">whey</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The watery liquid that separates from the curd when the milk is clotted, as in making cheese.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lactosérum</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Molke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wei</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сыворотка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Водянистая жидкость, отделяемая от творожной массы в результате створаживания молока, например, при изготовлении сыра.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء الجبن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4845" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1645">
    <skos:prefLabel xml:lang="en">complex formation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Formation of a complex compound. Also known as complexing or complexation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">complexation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">formación compleja</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Komplexbildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">complexering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">формирование сложного соединения (хим.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Формирование сложного химического соединения. Может также использоваться термин "комплексообразование".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التركيب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1646">
    <skos:prefLabel xml:lang="en">complexing agent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance capable of forming a complex compound with another material in solution.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agent complexant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agente de complexión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Komplexbildner</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">complexvormer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соединяющий реагент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, способное формировать сложное соединение с другим веществом в растворе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل مُركِب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1647">
    <skos:prefLabel xml:lang="en">composite pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Emissions of ozone-degrading gases (CFCs, halons); emissions of greenhouse gases (carbon
dioxide, methane, CFCs, nitrous oxides, halons); emissions of acidifying gases (sulfur oxides, nitrogen oxides); emissions of substances that contribute to eutrophication (phosphate and nitrogen-containing materials); emissions of toxic materials (pesticides, radioactive substances, priority toxic substances); solid wastes returned to the environment.
(Source: UNEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution composite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación compuesta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mehrkomponentenverunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">samengestelde verontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">смешанное загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выбросы газов, способствующие разрушению озона (газы CFC, галоны); выбросы парниковых газов (углекислый газ, метан, CFC, азотистые оксиды, галоны); выбросы окисляющих газов (оксиды серы, оксиды азота); выбросы веществ, способствующие эвтрофикации (фосфаты и азотосодержащие материалы); выбросы токсичных материалов (пестициды, радиоактивные вещества, высокотоксичные вещества); твердые отходы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث مُرَكَّب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1649">
    <skos:prefLabel xml:lang="en">compost</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mixture of decaying organic matter used to fertilize and condition the soil.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compost</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compost</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kompost</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">compost</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компост</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Смесь разлагающегося органического материала, используемая для удобрения и улучшения структуры почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سماد عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5510" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7056" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5009" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1651">
    <skos:prefLabel xml:lang="en">compostable waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste consisting largely of biodegradable organic matter.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet fermentescible</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuo fertilizante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kompostierbarer Abfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">composteerbaar afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компостные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, состоящие главным образом из биодеградирующих органических материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3562" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5913" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/821" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8921" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1652">
    <skos:prefLabel xml:lang="en">composting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The natural biological decomposition of organic material in the presence of air to form a humus-like material. Controlled methods of composting include mechanical mixing and aerating, ventilating the materials by dropping them through a vertical series of aerated chambers, or placing the compost in piles out in the open air and mixing it or turning it periodically.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compostage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compostificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kompostierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">composteren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компостирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Природное биологическое разложение органического материала с доступом воздуха, образующее гумусоподобный продукт. Контролируемые методы компостирования включают механическое перемешивание, аэрацию, вентиляцию материалов путем их просеивания через вертикальные вентиляционные камеры или размещение компоста в куче на открытом воздухе с периодическим перемешиванием или переворачиванием разлагаемых материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصنيع السماد العضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1653" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3006">
    <skos:prefLabel xml:lang="en">European Union</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The 15 nations (Belgium, Denmark, France, Germany, Greece, Ireland, Italy, Luxembourg, the Netherlands, Portugal, Spain, the UK, Austria, Finland and Sweden) that have joined together to form an economic community with common monetary, political and social aspirations. The EU came into being on 1 November 1993 according to the terms of the Maastricht Treaty; it comprises the three European Communities, extended by the adoption of a common foreign and security policy which requires cooperation between member states in foreign policy and security and cooperation in justice and home affairs.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Union européenne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Unión Europea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Europäische Union</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Europese Unie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Европейский Союз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">15 стран (Бельгия, Дания, Франция, Германия, Греция, Ирландия, Италия, Люксембург, Нидерланды, Португалия, Испания, Великобритания, Австрия, Финляндия и Швеция), объединившихся в целях создания экономического сообщества с общей валютной, политической и социальной системой. ЕС появился 1 ноября 1993 года в соответствии с положениями Маастрихтского договора; объединяет три Европейских Сообщества, реализует единую внешнюю политику и политику безопасности, требующих совместных усилий всех стран-членов, а также взаимодействия в вопросах правосудия и внутренних дел.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاتحاد الأوروبي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4434" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1669" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2419" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2989" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2991" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2993" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2996" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2997" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2998" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3002" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11045" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11571" />
