  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4916">
    <skos:prefLabel xml:lang="en">loss of biotope</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Destruction of biotopes produced by environmental degradation which in turn is caused by air- or water-borne pollution.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">perte de biotope</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pérdida de biotopo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotopverlust</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het verloren gaan van biotopen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потеря биотопа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разрушение биотопов в результате экологической деградации, вызванной в свою очередь загрязнением воздуха или воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فقد الموطن الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2782" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4917">
    <skos:prefLabel xml:lang="en">loudness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The magnitude of the physiological sensation produced by a sound, which varies directly with the physical intensity of sound but also depends on frequency of sound and waveform.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sonorité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intensidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lautstärke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidssterkte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">громкость</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Размах физиологического ощущения, производимого звуком, зависимое напрямую от физической интенсивности звука,  а также зависящее от частоты звука и формы волны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">درجة اتفاع الصوت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/57" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4918">
    <skos:prefLabel xml:lang="en">low-cost housing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Residences built at minimal expense and designed to keep the rental rate or price of purchase affordable for persons with limited means, usually determined by an annual income level set below the local median.
(Source: NAH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">habitation à loyer modéré (HLM)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">viviendas económicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kostensparende Bauweise</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">betaalbare huisvesting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">низкозатратное жилищное строительство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жилище, построенное с минимальными затратами для обеспечения доступности цены или размера арендной платы для малоимущих слоев населения, чьи годовые доходы ниже установленного среднего уровня.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إسكان منخفض التكلفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7795" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13111">
    <skos:prefLabel xml:lang="en">ontogenesis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The entire sequence of events involved in the development of an individual organism.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ontogenèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ontogénesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ontogenese</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontogenese</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">онтогенез</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Совокупная последовательность событий, связанных с развитием отдельного организма.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التطور الفردي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7120" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4920">
    <skos:prefLabel xml:lang="en">Lower House</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The body of a bicameral legislature composed of representatives elected by the general populace and organized into electorates or districts, each comprising an equal number of citizens.
(Source: CIV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Chambre des Députés</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cámara Baja</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterhaus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Tweede Kamer (NL)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Нижняя Палата</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть двухпалатного законодательного органа, состоящая из представителей, избранных населением, организованных в избирательные округа с одинаковым количеством избирательных голосов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مجلس النواب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6048" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4921">
    <skos:prefLabel xml:lang="en">lower risk species  (IUCN)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Animals, birds, fish, plants or other living organisms that have been deemed as not being in danger of extinction.
(Source: OED /  TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèces à faible risque</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies de bajo riesgo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Weniger gefährdete Arten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">minder bedreigde soorten (IUCN)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">виды, не находящиеся под угрозой уничтожения (МСОП)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Животные, птицы, рыбы, растения и другие живые организмы, которые не считаются находящимися под угрозой уничтожения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنواع غير معرضة لمخاطر عالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1221" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4922">
    <skos:prefLabel xml:lang="en">low flow</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Phase of lowest level of a water course.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étiage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">flujo bajo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Niedrigwasserabfluß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">laag debiet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">минимальный речной сток</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Фаза минимального уровня водного потока.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحاريق - البُراض - أدنى مستوى للماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4116" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13115">
    <skos:prefLabel xml:lang="en">land tax</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Property tax. A tax laid upon the legal or beneficial owner of real property, and apportioned upon the assessed value of his land.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taxe foncière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contribución rústica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grundstückssteuer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondbelasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог на землю</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Налог на имущество. Налог, бремя уплаты которого ложится на юридического собственника или бенефициара недвижимости и подсчитывается на основе оценочной стоимости земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضريبة الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13117">
    <skos:prefLabel xml:lang="en">open lawn</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any relatively unobstructed field of cultivated and mown grass, especially near a house or in a park.
(Source: GWG / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pelouse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">césped abierto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Offene Rasenfläche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tra</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">газон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Открытое поле с культивированной и подстриженной травой, особенно возле дома или в парке.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرج مفتوح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8815" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10703" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13118">
    <skos:prefLabel xml:lang="en">biological cycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A series of transformations or biological events which follow one after the other one, reaching at the end of the cycle the initial conditions, as in the life cycle of many animal and plant organisms.
(Source: DELFIN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cycle biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclo biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologischer Kreislauf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische cyclus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологический цикл</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Последовательность превращений или биологических событий, которые сменяют друг друга и в конце цикла приводят к первоначальному состоянию, например, циклы жизни животных или растительных организмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الدورة الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4802" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9013">
    <skos:prefLabel xml:lang="en">vulcanisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical reaction of sulfur (or other vulcanizing agent) with rubber or plastic to cause cross-linking of the polymer chains; it increases strength and resiliency of the polymer.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vulcanisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vulcanización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vulkanisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vulcaniseren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вулканизация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическая реакция серы (или другого вулканизирующего вещества) с каучуком или пластмассой с образованием кросс-пересечений полимерных цепочек; увеличивает прочность и эластичность полимера.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقسية (المطاط او البلاستيك)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7324" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8731" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13120">
    <skos:prefLabel xml:lang="en">human habitat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the conditions in which people live. Also all human settlements in villages, towns or major cities, which require environmental management to provide water, public spaces, remove public wastes, etc.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">habitat humain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hábitat humano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Menschlicher Lebensraum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">menselijk habitat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">среда обитания человека</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Условия, в которых живут люди. Также все виды человеческого жилья в деревнях, поселках или крупных городах, которые требуют продуманной системы экологического управления при обеспечении водоснабжения, предоставлении свободных пространств, удалении отходов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موطن بشري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4062" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4022" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13121">
    <skos:prefLabel xml:lang="en">urban concentration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process in which an increasing proportion of a country's population is concentrated in urban areas.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concentration urbaine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concentración urbana</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ballung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stedelijke concentratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">концентрация городского населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого доля населения страны, сосредоточенного в городских районах, возрастает.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تركز حضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8804" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13122">
    <skos:prefLabel xml:lang="en">home garden</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A plot of cultivated ground adjacent to a dwelling and usually devoted in whole or in part to the growing of herbs, fruits, flowers, or vegetables for household use.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">jardin familial</skos:prefLabel>
    <skos:prefLabel xml:lang="es">jardín doméstico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hausgarten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">moestuin</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">личный огород</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок возделанной земли, примыкающий к жилому дому и обычно занятый полностью или частично под выращивание зелени, цветов, овощей или фруктов для личного потребления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حديقة منزلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3559" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4931">
    <skos:prefLabel xml:lang="en">low-level technology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any relatively unsophisticated technical equipment or method with an amplitude or functionality below what is available in a similar or comparable system.
(Source: RHW / APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technologie de base</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tecnología de bajo nivel</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grundtechnologien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lagere technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технология низкого уровня</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое относительно несложное технологическое оборудование или метод, чьи функции или масштабы ниже аналогов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكنولوجيا منخفضة المستوى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2932" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13124">
    <skos:prefLabel xml:lang="en">bottle cap</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bouchon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tapón de botella</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flaschenverschluß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">flessedop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">крышка для бутылки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غطاء زجاجة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5305" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4934">
    <skos:prefLabel xml:lang="en">lubricant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance used to reduce friction between parts or objects in relative motion.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lubrifiant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lubricante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schmierstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">smeermiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">смазка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, используемое для уменьшения трения между движущимися частями или предметами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مزلق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12394" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11745">
    <skos:prefLabel xml:lang="en">pyralene</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical compound belonging to the polychlorinated biphenyls family, used in the production of electrical equipment which requires dielectric fluid such as power transformers and capacitors, as well as in hydraulic machinery, vacuum pumps, compressors and heat-exchanger fluids.
(Source: PZ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pyralène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">piraleno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pyralene</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pyraleen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пирален</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое соединение группы полихлорированных бифенилов, используемое в производстве электрического оборудования, например, силовых трансформаторов и конденсаторов, а также гидравлических механизмов, вакуумных насосов, компрессоров и жидкостей для теплообменников.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البيرالين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6485" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4937">
    <skos:prefLabel xml:lang="en">luminosity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The functional relationship between stellar magnitude and the number and distribution of stars of each magnitude interval. Also known as relative luminosity factor.
(Source: UVAROV /  MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">luminosité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">luminosidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Helligkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">helderheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">освещенность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Функциональная зависимость между размерами звезд и численностью, а также распределением звезд каждого интервала величины. То же самое, что фактор относительной яркости.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السطوع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9015">
    <skos:prefLabel xml:lang="en">vulnerable species  (IUCN)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Species which is likely to become endangered unless protective measures are taken.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèce vulnérable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies vulnerables</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bedrohte Arten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kwetsbare soort</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нестабильный вид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вид, способный стать видом, существование которого находится под угрозой, в случае, если не будут предприняты охранные меры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنواع مهددة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1221" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3007">
    <skos:prefLabel xml:lang="en">eutrophication</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process of pollution that occurs when a lake or stream becomes over-rich in plant nutrient; as a consequence it becomes overgrown in algae and other aquatic plants. The plants die and decompose. In decomposing the plants rob the water of oxygen and the lake, river or stream becomes lifeless. Nitrate fertilizers which drain from the fields, nutrients from animal wastes and human sewage are the primary causes of eutrophication. They have high biological oxygen demand (BOD).
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eutrophisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">eutrofización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eutrophierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eutrofiëring</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эвтрофикация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение, которое проявляется в случае, когда в воде озера или ручья накапливается излишнее количество растительных питательных веществ; вследствие этого водоем зарастает водорослями и другими водными растениями. Растения умирают и разлагаются, потребляя растворенный в воде кислород, вследствие чего жизнь в воде этого водоема становится невозможной. Основной причиной эвтрофикации являются азотосодержащие удобрения, попадающие в воду с полей, питательные вещества в отходах животного происхождения, отходы человеческой деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ظاهرة الإخصاب العضوي الزائد - ظاهرة التخثر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6459" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/303" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9202" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4942">
    <skos:prefLabel xml:lang="en">lye</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The alkaline solution that is obtained from the leaching of wood ashes.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lessive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lejías</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lauge</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reinigingsmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">щелок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Щелочной раствор, получаемый в процессе выщелачивания древесной золы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غسول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13135">
    <skos:prefLabel xml:lang="en">voting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of formally expressing an opinion or choice in some matter or for some candidate, usually by voice or  ballot.
(Source: CIV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vote</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de votación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wahlverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stemming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">голосование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выражение физическим лицом своей воли, предпочтения или выбора.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصويت (في انتخابات)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6380" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13136">
    <skos:prefLabel xml:lang="en">agricultural structure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The buildings, machinery, facilities, related to agricultural production.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">structure agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estructuras agrarias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarstruktur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwstructuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">основные фонды сельского хозяйства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Строения, машины, объекты, связанные с сельскохозяйственным производством.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المنشآت الزراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1029" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/186" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3130" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4945">
    <skos:prefLabel xml:lang="en">lymphatic system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system of vessels and nodes conveying lymph in the vertebrate body, beginning with capillaries in tissue spaces and eventually forming the thoracic ducts which empty in the subclavian veins.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système lymphatique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema linfático</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lymphsystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lymfatisch systeem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лимфатическая система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система сосудов и узлов, передающих лимфу по телу позвоночного животного, начиная с капилляров в тканях и заканчивая торакальными железами, которые имеют выход в подключичные вены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجهاز اللمفاوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/406" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4948">
    <skos:prefLabel xml:lang="en">lysimetry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The measurement of the water percolating through soils and the determination of the materials dissolved by the water.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lysimétrie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lisimetría</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lysimetrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lysimetrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лизиметрия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Измерение воды, просачивающейся через почву, и определение материалов, растворимых водой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قياس ترشُّح الأمطار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4574" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7846" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13142">
    <skos:prefLabel xml:lang="en">co-operation policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Political course of action aiming at establishing trade agreements among the states.
(Source: NDGIUR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique de coopération</skos:prefLabel>
    <skos:prefLabel xml:lang="es">politíca de cooperación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kooperationspolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">samenwerkingsbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика сотрудничества</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политический курс, направленный на заключение торговых соглашений между государствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة التعاون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13143">
    <skos:prefLabel xml:lang="en">international balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system in which nations or blocs of nations strive to maintain an equilibrium of power to prevent dominance by any single nation or to reduce conflict or the possibility of war.
(Source: IPE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équilibre international</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationales Gleichgewicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationaal evenwicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международный баланс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, при которой государства и политические блоки стремятся к достижению баланса сил для предотвращения доминирования одного государства, решения конфликта или предотвращения войны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوازن الدولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4438" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13304" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13305" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4952">
    <skos:prefLabel xml:lang="en">machine manufacture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The making or production of mechanical apparatuses used for commercial or industrial purposes, such as engines and turbines, elevators and conveying equipment, computers and office equipment, and hoists, cranes and industrial trucks.
(Source: RHW / SIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie mécanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de la maquinaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Maschinenbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">machine-industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство машин и механизмов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Производство механических приборов коммерческого или производственного назначения, например, двигателей, турбин, конвейеров, компьютеров, офисного оборудования, кранов, грузовых автомобилей и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الآلات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12514" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13145">
    <skos:prefLabel xml:lang="en">Community finance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The financial resources or income of the European Community, a body of people organized into a political unity.
(Source: ISEP /  OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">finances communautaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">finanzas comunitarias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Finanzen der Gemeinschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeentelijke financiën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">финансы ЕС</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Финансовые ресурсы или доход Европейского Сообщества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مالية الجماعة الأوروبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2516" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13237" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3006" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13146">
    <skos:prefLabel xml:lang="en">organisation of the legal system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The specific manner, form and institutions by which a government's ability to make, enforce and interpret laws are brought together into a coordinated whole.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisation de la justice</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organización de la justicia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organisation des Rechtssystems</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organisatie van het rechtsstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">организация правовой системы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специфическая манера, форма и институты, посредством которых возможности государства издавать, приводить в исполнение и интерпретировать законы объединяются в единое, скоординированное целое.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيم النظام القضائي</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13287" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13288" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13147">
    <skos:prefLabel xml:lang="en">rights</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Title to or an interest in any property.
2) Any interest or privilege recognized and protected by law.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droits</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derechos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechte</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rechten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">права</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Право или доля в праве на собственность. 2) Любой интерес или привилегии, признанные и охраняемые законом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حقوق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7811" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4060" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7222" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11477" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13178" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13330" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4956">
    <skos:prefLabel xml:lang="en">macroeconomic goal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An aim or objective pertaining to the production, distribution and use of income, wealth and commodities in a country, region or other large area, typically concerned with governmental fiscal and monetary policy as it affects employment, consumption, investment and growth levels.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">objectif macroéconomique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">objetivo macroeconómico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesamtwirtschaftliches Ziel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">macro-economische doelstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">макроэкономическая цель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Три цели смешанной экономики, в наибольшей степени относящиеся к макроэкономике. Это - полная занятость, стабильность и экономический рост.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هدف الاقتصاد الكلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3698" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4957">
    <skos:prefLabel xml:lang="en">macroeconomics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Modern economic analysis that is concerned with data inaggregate as opposed to individual form such as national income, consumption and investment.
(Source: GREENW /  CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">macro-économie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">macroeconomía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Volkswirtschaftslehre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">macro-economie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">макроэкономика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Современный экономический анализ, учитывающий агрегированные данные, в не отдельные показатели, такие как национальный доход, потребление, инвестиции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاقتصاد الكلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2501" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13150">
    <skos:prefLabel xml:lang="en">monetary relations</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The different modes in which countries, nations, etc., are brought together by financial, currency, or pecuniary interests.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relation monétaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relaciones monetarias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Währungsbeziehungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">monetaire betrekkingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">валютно-финансовые отношения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные способы, с помощью которых страны, государства и пр. взаимодействуют в финансовых, валютных или денежных вопросах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علاقات نقدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13245" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13151">
    <skos:prefLabel xml:lang="en">monetary economics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study, policies or system of institutions and procedures by which a country or region's commerce is supplied with notes, coins, bank deposits or other equivalent mediums of exchange.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie monétaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">economía monetaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geldwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">monetaire economie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">монетарная экономика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экономическая система, в которой обмен основан на использовании денег.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اقتصاد نقدي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5343" />
