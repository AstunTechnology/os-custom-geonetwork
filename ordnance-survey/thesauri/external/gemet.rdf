    <skos:prefLabel xml:lang="es">arboricultura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Baumzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">boomkwekerij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">древоводство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высаживание и выращивание древовидных растений, в особенности, деревьев.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة الأشجار</skos:prefLabel>
