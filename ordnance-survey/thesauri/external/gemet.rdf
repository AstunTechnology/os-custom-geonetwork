    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9049">
    <skos:prefLabel xml:lang="en">waste bin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A container for litter, rubbish, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">poubelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contenedor de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbehälter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalbak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мусорный контейнер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Емкость для мусора, отходов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلة مهملات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2290" />
