    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10212">
    <skos:prefLabel xml:lang="en">protected marine zone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sea area where marine wildlife is protected.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone marine protégée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona marina protegida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meeresschutzgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beschermd marien gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охраняемая морская зона</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок моря, где охраняется дикая природа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة بحرية محمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10201" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5046" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10199" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7495" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2022">
    <skos:prefLabel xml:lang="en">deep sea</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Region of open ocean beyond the continental shelf.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">grand fond marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mar profundo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tiefsee</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">diepzee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">открытое море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Район моря за пределами континентального шельфа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عمق البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7495" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2023">
    <skos:prefLabel xml:lang="en">deep sea deposit</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">gisement minéral dans le fond marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">depósito en fosa marina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tiefseeablagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">diepzee-afzetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">запасы в открытом море</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">ترسيبات أعماق البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5264" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2024">
    <skos:prefLabel xml:lang="en">deep-sea disposal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The disposal of solid waste or sludge by carrying the wastes out to sea, usually in a barge, and dumping into deep water.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge en haute mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertido en fondo marino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tiefversenkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">diepzeestorting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сброс в открытое море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Утилизация твердых отходов или стоков путем их вывоза в море, обычно на барже, и выброса  в воду на большой глубине.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من المخلفات في عمق البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12417" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5044" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2025">
    <skos:prefLabel xml:lang="en">deep sea fishing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fishing in the deepest parts of the sea.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pêche en haute mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pesca marina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hochseefischerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(diep)zeevisserij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рыболовство в открытом море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отлов рыбы на участках моря с наибольшей глубиной.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصيد في عمق البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5035" />
