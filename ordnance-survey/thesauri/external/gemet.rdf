  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5986">
    <skos:prefLabel xml:lang="en">oxygen content</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Amount of oxygen contained in a solution.
(Source: MGHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">teneur en oxygène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contenido de oxígeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sauerstoffgehalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuurstofgehalte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">содержание кислорода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество кислорода, содержащееся в растворе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المحتوى من الأكسجين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1673" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5987" />
