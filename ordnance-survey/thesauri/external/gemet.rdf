    <skos:prefLabel xml:lang="de">Mediterraner Forst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Middellandse-zeebos</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">средиземноморский лес</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тип леса, характерный для средиземноморского региона, состоящий в основном из сухолюбивых вечнозеленых деревьев.</skos:scopeNote>
