    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6827">
    <skos:prefLabel xml:lang="en">pulmonary disease</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any disease pertaining to the lungs.
(Source: DELFIN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">maladie pulmonaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enfermedad pulmonar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lungenerkrankung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">longziekte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заболевание легких</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заболевание, затрагивающее легкие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرض صدري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7179" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6828">
    <skos:prefLabel xml:lang="en">pulp</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The cellulosic material produced by reducing wood mechanically or chemically and used in making paper and cellulose products. Also known as wood pulp.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pâte à papier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pasta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zellstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pulp</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">целлюлоза</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, образуемый в процессе механического или химического измельчения древесины; используется при производстве бумаги и других изделий. Называют еще "древесной массой".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اللباب - عجينة الورق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6830">
    <skos:prefLabel xml:lang="en">pulp industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of commercial enterprises is engaged in manufacturing and selling the soft, moist, slightly cohering mass deriving from wood that is used to produce paper sheets, cardboard and other paper products.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie de la cellulose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de la pasta papelera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zellstoffindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pulpindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство целлюлозы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сектор экономики, предприятия которого производят и реализуют мягкую, влажную, немного неоднородную массу, полученную из древесины, используемую для производства листовой бумаги, картона и других бумажных изделий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة اللباب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8486" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3869">
    <skos:prefLabel xml:lang="en">health-environment relationship</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Relationship between the quality of the environment and the health conditions of individuals.
(Source: DIZAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relation santé-environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relaciones salud-medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesundheit-Umweltbeziehung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verbanden tussen de gezondheid en de (natuurlijke en/of woon-)omgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взаимосвязь здоровья и окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимосвязь между качеством окружающей среды и состоянием здоровья отдельных лиц.</skos:scopeNote>
