    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4072">
    <skos:prefLabel xml:lang="en">hunting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The pursuit and killing or capture of wild animals, regarded as a sport.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chasse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">caza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Jagd</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">jacht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Преследование, убийство или отлов диких животных, что считается видом спорта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القنص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4767" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1772" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4073" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11502" />
