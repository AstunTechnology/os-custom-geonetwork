    <skos:prefLabel xml:lang="nl">bouwmaterialenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">промышленность стройматериалов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">صناعة مواد البناء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
