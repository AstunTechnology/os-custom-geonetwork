    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:38 PM CEST</dct:created>
    <dct:title xml:lang="en">Fossil Fuel Resource</dct:title>
    <skos:prefLabel xml:lang="en">Fossil Fuel Resource</skos:prefLabel>
    <dct:description xml:lang="en">A spatial object defining an inferred or observable spatial extent of a resource that can be or has been used as a source of fossil fuel energy. The most common fossil fuel types are coal, natural gas and crude oil.</dct:description>
    <skos:definition xml:lang="en">A spatial object defining an inferred or observable spatial extent of a resource that can be or has been used as a source of fossil fuel energy. The most common fossil fuel types are coal, natural gas and crude oil.</skos:definition>
