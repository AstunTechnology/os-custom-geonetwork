    <skos:prefLabel xml:lang="en">hunting reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area of land where the pursuit and killing or capture of game and wild animals is permitted.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve de chasse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reservas de caza</skos:prefLabel>
