  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2642">
    <skos:prefLabel xml:lang="en">element of group VII</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the elements of the halogen family, consisting of fluorine, chlorine, bromine, iodine, and astatine.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe VII</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo VII</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe VII</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep VII</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы VII</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой элемент из семейства галогенов - фтор, хлор, бром, йод и астат.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة 7</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1007" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1373" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3334" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4483" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2643">
    <skos:prefLabel xml:lang="en">chemical element</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance made up of atoms with the same atomic number; common examples are hydrogen, gold, and iron.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élément chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elementos químicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Chemisches Element</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemische elementen (en hun verbindingen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, составленное из атомов с одинаковым порядковым номером: например, водород, золото и железо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر كيميائي</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2635" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2636" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2637" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2638" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2639" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2640" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2641" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2642" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10837">
    <skos:prefLabel xml:lang="en">organisation of work</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The coordination or structuring of work practices and production processes in order to influence the way jobs are designed and performed in the workplace.
(Source: NIO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisation du travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organización del trabajo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeitsorganisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werkorganisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">организация работы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Координация или структурирование рабочих процедур и процессов, влияющие на распределение и выполнение работ на рабочих местах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيم العمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4577" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9371" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13342" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8633">
    <skos:prefLabel xml:lang="en">transportation business</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any commercial venture involved in the processes of conveying things or people from one place to another.
(Source: RHW /  OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">entreprise de transports</skos:prefLabel>
    <skos:prefLabel xml:lang="es">empresa de transporte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Transportunternehmen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervoersbedrijf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортные перевозки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Коммерческая перевозка грузов или людей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أعمال النقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6817" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/88">
    <skos:prefLabel xml:lang="en">additive</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substances mixed in small quantities with another product to modify its chemical or physical state. Additives are used to make food look visually more attractive, in the case of colouring agents, as well as to preserve and extend the life of the product.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">additif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aditivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zusatzstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">additief</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добавки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, добавляемые в малых количествах к другим продуктам в целях изменения их физического или химического состояния. Добавки, например, красители, используются для того, чтобы придать товарный вид продуктам питания, а также для сохранения или продления срока использования продукта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إضافات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3506" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2651">
    <skos:prefLabel xml:lang="en">emancipation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The state of being free from social or political restraint or from the inhibition of moral or social conventions.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">émancipation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">emancipación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emanzipation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emancipatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эмансипация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Освобождение от социальных, политических ограничений, сдерживающего влияния моральных или социальных постулатов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحرر - الانعتاق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7811" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3611" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6882" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8801">
    <skos:prefLabel xml:lang="en">urban decay</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Condition where part of a city or town becomes old or dirty or ruined, because businesses and wealthy families have moved away from it.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dégradation urbaine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">degradación de zonas urbanas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtverfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadsverval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заброшенный городской район</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние, при котором часть города или поселка стареет, разрушается в результате прекращения там деловой активности и переселения из них имущих слоев населения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدهور حضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2562" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2653">
    <skos:prefLabel xml:lang="en">embryo</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An early stage of development in multicellular organisms.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">embryon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">embrión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Embryo</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">embryo</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эмбрион</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ранняя стадия развития многоклеточных организмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جنين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2654">
    <skos:prefLabel xml:lang="en">embryogenesis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The formation and development of an embryo from an egg.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">embryogénèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">embriogénesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Embryonalentwicklung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">embryogenese</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эмбриогенез</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Образование и развитие эмбриона из яйцеклетки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخلُّق (مُضْغِيّ)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2573" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2653" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7567" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13111" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10847">
    <skos:prefLabel xml:lang="en">leisure centre</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A building containing a swimming pool and a large room or other places where you can play sports.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">base de loisirs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">centro de ocio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erholungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrijetijdscentrum</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">центр досуга и отдыха</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Здание, в котором находятся бассейн, другие помещения, например, для занятия спортом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركز ترويح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7668" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2656">
    <skos:prefLabel xml:lang="en">emergency plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Program of procedures to be undertaken in the event of a sudden, urgent and usually unexpected occurrence requiring immediate action, especially an incident of potential harm to human life, property or the environment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'urgence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planes de emergencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nofallplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">noodplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план на случай чрезвычайной ситуации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Программа мер, предпринимаемых в случае внезапного, неотложного и, как правило, неожиданного наступления обстоятельств, требующих немедленного реагирования, особенно событий, несущих потенциальную угрозу человеческой жизни, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة طوارئ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9034" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12872" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2657">
    <skos:prefLabel xml:lang="en">emergency relief</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Money, food or other assistance provided for those surviving a sudden and usually unexpected occurrence requiring immediate action, especially an incident of potential harm to human life, property or the environment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">secours d'urgence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ayuda de urgencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nothilfe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">noodhulp</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">помощь при чрезвычайной ситуации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Помощь, оказываемая людям, нуждающимся в ней в результате стихийного бедствия или любого другого неожиданного события, требующего немедленного реагирования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إغاثة عاجلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2658" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2658">
    <skos:prefLabel xml:lang="en">emergency relief measure</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">mesure de secours d'urgence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medida de socorro en emergencias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erste-Hilfe-Maßnahmen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">noodhulpmaatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">меры помощи при чрезвычайной ситуации</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تدابير الإغاثة العاجلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2657" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10851">
    <skos:prefLabel xml:lang="en">community facility</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Buildings, equipment and services provided for a community.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équipement collectif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equipamiento colectivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gemeinschaftseinrichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeenschappelijke voorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">общественное сооружение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Здания, оборудование, услуги, предоставляемые в пользование обществу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرفق مجتمعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/428" />
