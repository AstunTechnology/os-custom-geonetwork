    <skos:prefLabel xml:lang="es">hábitat urbano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Städtischer Lebensraum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stedelijke habitat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городская среда</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Результаты и взаимосвязи районов сосредоточения населения, а также возведенная среда и биофизические природные условия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موطن حضري</skos:prefLabel>
