  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4857">
    <skos:prefLabel xml:lang="en">litter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Straw, hay or similar material used as bedding by animals.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ordures</skos:prefLabel>
    <skos:prefLabel xml:lang="es">basura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unrat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afdekstro</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подстилка для скота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Солома, сено и им подобные материалы, используемые в качестве подстилки для скота.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاذورات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5437" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4858">
    <skos:prefLabel xml:lang="en">littoral</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The intertidal zone of the seashore.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">littoral</skos:prefLabel>
    <skos:prefLabel xml:lang="es">litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">litoraal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">литораль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок побережья, находящийся в зоне приливов и отливов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ساحلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1513" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13053">
    <skos:prefLabel xml:lang="en">technical information</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Factual data, knowledge or instructions relating to scientific research or the development, testing, evaluation, production, use or maintenance of equipment.
(Source: RHW / MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">information technique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">información técnica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technische Information</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technische informatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">техническая информация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Фактические данные, знания или инструкции, относящиеся к научным исследованиям, разработке, испытаниям, оценке, производству, использованию или эксплуатации оборудования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معلومات فنية - تقنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4862">
    <skos:prefLabel xml:lang="en">livestock</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cattle, horses, and similar animals kept for domestic use especially on a farm.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cheptel sur pied</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ganado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Viehbestand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">домашний скот</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупный рогатый скот, лошади и подобные животные, которых содержат для использования в домашнем хозяйстве, особенно на ферме.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الماشية  -الدواب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3122" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/448" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1225" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4864" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4863">
    <skos:prefLabel xml:lang="en">livestock breeding</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The raising of livestock by crossing different varieties to obtain new varieties with desired characteristics.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élevage de bétail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ganadería</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Viehzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veefokkerij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение домашнего скота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение скота в результате селекции для получения новых пород с необходимыми свойствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تربية الماشية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7726" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4864">
    <skos:prefLabel xml:lang="en">livestock farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Breeding of cattle, horses and similar animals.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élevage de bétail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cría de ganado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Viehwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veehouderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение домашнего скота на фермах</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение крупного рогатого скота, лошадей и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تربية الماشية والدواب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4862" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12476" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4866">
    <skos:prefLabel xml:lang="en">living condition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An element or characteristic of a habitation considered in light of its ability to sustain and promote the health and general well-being of occupants.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">condition de vie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">condiciones de vida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebensbedingung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">levende toestand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">условия жизни</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Элемент или характеристика среды обитания, рассматриваемая в свете ее способности поддерживать и способствовать здоровью и общему благополучию ее обитателей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ظروف الحياة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7784" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4867">
    <skos:prefLabel xml:lang="en">living marine resource</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">ressources marines biologiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recursos marinos vivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Meeresressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurlijke rijkdommen van de zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морские биоресурсы</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مصدر  بحري حي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13060">
    <skos:prefLabel xml:lang="en">information network</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system of interrelated persons and/or devices linked to permit the exchange of data or knowledge.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau d'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">red de información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationsnetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatienetwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационная сеть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система взаимосвязанных лиц и/или приборов, объединенных в целях обмена данными или знаниями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبكة معلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2852" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14860" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14861" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3542">
    <skos:prefLabel xml:lang="en">furriery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The business or trade of dressed furs and garments made from the coats of certain animals.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pelleterie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">peletería</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kürschnerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bonthandel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">торговля пушниной</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деловые и торговые операции с выделанным мехом или одеждой, изготовленной из шкур определенных видов животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجارة الفراء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8563" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4871">
    <skos:prefLabel xml:lang="en">lizard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any reptile of the suborder Lacertilia, especially those of the family Lacertidae, typically having an elongated body, four limbs, and a small tail: includes the gechos, iguanas, chameleons, monitors, and slow worms.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lézard</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lagartos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eidechse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hagedissen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ящерица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рептилия подотряда Lacertilia, особенно представители семейства Lacertidae, характеризуемые наличием удлиненного тела, четырех конечностей и маленького хвоста; к ним относятся гекконы, игуаны, хамелеоны, вараны и полозы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السحلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7124" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9004">
    <skos:prefLabel xml:lang="en">volcano</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A vent in the surface of the Earth through which magma and associated gases and ash erupt; also, the form or structure, usually conical, that is produced by the ejected material.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">volcan</skos:prefLabel>
    <skos:prefLabel xml:lang="es">volcanes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vulkan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vulkaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вулкан</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отверстие в поверхности Земли, через которое извергаются магма, связанные с нею газы и пепел; также форма или структура, обычно коническая, образуемая извергаемым веществом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بركان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5405" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9003" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2890">
    <skos:prefLabel xml:lang="en">environmental plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A formulated or systematic method for the protection of natural or ecological resources.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan écologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planes ambientales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план по охране окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сформулированный или системный метод защиты природных или  экологических ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة بيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4615">
    <skos:prefLabel xml:lang="en">land ecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study of the relationship between terrestrial organisms and their environment.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écologie des terres</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bodenökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экология земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение взаимоотношений между сухопутными организмами и окружающей их средой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إيكولوجيا الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4879">
    <skos:prefLabel xml:lang="en">local authority</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The power of a government agency or its administrators to administer and implement laws and government policies for a city, town or small district.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">municipalité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autoridad local</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kommunalbehörde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeente</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">местная власть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Полномочия государственного органа, а также его руководителей осуществлять применение, реализацию законов и государственной политики в городе, поселке или небольшом районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السلطة المحلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4884">
    <skos:prefLabel xml:lang="en">local finance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The theory and practice of all public money matters pertaining to city, town or small district governments.
(Source: ODE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">finances locales</skos:prefLabel>
    <skos:prefLabel xml:lang="es">haciendas locales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kommunalfinanzen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plaatselijke financiën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">финансирование на местном уровне</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Правила, касающиеся финансовой деятельности государственных учреждений и организаций на местном уровне.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المالية المحلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6793" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4885">
    <skos:prefLabel xml:lang="en">local government policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any course of action adopted and pursued by a ruling political authority or system, which determines the affairs for a city, town, county or regional area.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique des administrations locales</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política de Gobierno local</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kommunalpolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beleid van de plaatselijke overheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика местных властей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Направление действий, которое принято и которому следует правящая политическая власть или система в городе, поселке, графстве или маленьком районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة الحكومة المحلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3718" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4886">
    <skos:prefLabel xml:lang="en">teleheating</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The supply of heat, either in the form of steam or hot water, from a central source to a group of buildings.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chauffage à distance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calefacción a distancia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fernheizung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afstandsverwarming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">теплоснабжение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подача тепла в форме пара или горячей воды от центрального источника к группе зданий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التسخين عن بعد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14963" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4888">
    <skos:prefLabel xml:lang="en">local building material</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">matériau de construction local</skos:prefLabel>
    <skos:prefLabel xml:lang="es">materiales locales para la construcción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Örtliche Baustoffe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plaatselijke bouwmaterialen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">местный строительный материал</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">مواد بناء محلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4889">
    <skos:prefLabel xml:lang="en">local passenger service</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Passenger transport system for a limited local area.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic voyageurs à courte distance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">servicio local de pasajeros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Personennahverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plaatselijk openbaar vervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">местный пассажирский транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система пассажирского транспорта для данной местности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خدمة الركاب المحلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8653" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4891">
    <skos:prefLabel xml:lang="en">local traffic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Traffic moving within a city, town, or area and subject to frequent stops, as distinguished from long distance traffic.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic local</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico local</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nahverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plaatselijk verkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">местный транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспорт, перемещающийся в черте города, поселка или района с частыми остановками в отличие от транспорта дальнего следования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المرور الداخلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4893">
    <skos:prefLabel xml:lang="en">location of industries</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The particular place that seems apt for the installation of a new plant; the choice of the site depends on a number of economic and environmental factors.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">site industriel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">localización de industrias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Industriestandort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vestiging van industrieën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">размещение предприятий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Конкретное место, которое представляется подходящим для размещения нового завода; выбор такого участка зависит от ряда экономических и экологических факторов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موقع مصانع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7709" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13088">
    <skos:prefLabel xml:lang="en">method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A way of proceeding or doing something, especially a systematic or regular one.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Methode</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">methode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способ достижения какой-либо цели, решения конкретной задачи, особенно систематизированный и упорядоченный.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسلوب - منهج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5203" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/402" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/807" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1113" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2139" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5122" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4897">
    <skos:prefLabel xml:lang="en">locomotive</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A self -propelled engine driven by steam, electricity or diesel power and used for drawing trains along railway tracks.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">locomotive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">locomotora</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lokomotive</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">locomotief</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">локомотив</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Самоходная машина, движимая силой пара, электричества или энергией дизеля, используется для перемещения железнодорожных вагонов по рельсам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القاطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6939" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12711">
    <skos:prefLabel xml:lang="en">land restoration in mountain areas</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures adopted to control erosion and degradation phenomena in the mountain regions caused by the loss of forest cover due to acid rain, uncontrolled forest cutting, winter skiing resorts construction, etc.
(Source: DIZAMBa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">restauration de terrain en montagne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">restauración de tierra en áreas de montaña</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bodensanierung in Bergregionen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landherstel in bergstreken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">восстановление земли в горных районах</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, принимаемые для контроля за эрозией и явлениями экологического разрушения в горных районах, вызванными потерей лесного покрова в результате кислотных осадков, неконтролируемой вырубки леса, сооружением лыжных курортных объектов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استصلاح الأراضي في المناطق الجبلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4646" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4902">
    <skos:prefLabel xml:lang="en">long-distance traffic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Traffic moving over extended areas, great distances and usually not subject to frequent stops.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic à grande distance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico de larga distancia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fernverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">langeafstandsverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">движение транспорта дальнего следования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспорт, перемещающийся по большим территориям, на дальние расстояния обычно без частых остановок.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المرور لمسافات طويلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4903">
    <skos:prefLabel xml:lang="en">long-distance transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The conveyance of materials or commodities over land, water or through air in which a great distance is covered.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport long courrier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte de larga distancia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Weiträumiger Transport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">langeafstandsvervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспорт дальнего следования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перемещение материалов и товаров по земле, воде или воздуху, в процессе которого покрываются дальние расстояния.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل لمسافات طويلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3481" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13098">
    <skos:prefLabel xml:lang="en">iron and steel industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sector of the metallurgical industry dealing with the production of cast iron, steel and iron alloys. Emissions from these industries tend to settle quickly from the atmosphere and can lead to rising concentrations in the soil. The main raw material input to the production process is iron ore. Also recycled scrap is used.
(Source: FLGISA /  DOBRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie sidérurgique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria siderúrgica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisen- und Stahlindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijzer- en staalindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство чугуна и стали</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль металлургии, предприятия которой заняты в производстве чугуна, стали и сплавов. Выбросы от таких производств имеют тенденцию к быстрому осаждению из атмосферы и могут привести к их накоплению в почве. Основное сырье для этого производства - железная руда, также используется вторичный металл.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الحديد والصلب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5175" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4501" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8089" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4907">
    <skos:prefLabel xml:lang="en">long-term effect of pollutants</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">effet polluant à long terme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto a largo plazo de los contaminantes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Langzeitwirkung von Schadstoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">langetermijneffect van vervuilende stoffen</skos:prefLabel>
