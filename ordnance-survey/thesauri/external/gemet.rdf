  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8720">
    <skos:prefLabel xml:lang="en">twin-hull craft</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Oil tank vessels provided with a double-hull to meet the regulatory safety requirements in oil transportation. Requirements include minimum values for depths and breadth of double bottoms. Also called double-hull tank vessel.
(Source: PZa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">catamaran</skos:prefLabel>
    <skos:prefLabel xml:lang="es">barco de doble casco</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Doppelhüllenschiff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schip met dubbele romp</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">судно с двойным корпусом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нефтяные танкеры с двойным корпусом, построенные в соответствии с требованиями безопасности при транспортировке нефти. Требования включают минимальные размеры глубины и ширины двойного дна. Также называются "танкерами с двойным дном".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طَوف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
