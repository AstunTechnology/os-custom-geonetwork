    <skos:prefLabel xml:lang="ru">стандарт качества</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">معيار الجودة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8047" />
