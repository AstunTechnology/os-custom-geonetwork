  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8731">
    <skos:prefLabel xml:lang="en">tyre</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A rubber ring placed over the rim of a wheel of a road vehicle to provide traction and reduce road shocks.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pneu</skos:prefLabel>
    <skos:prefLabel xml:lang="es">neumático</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reifen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">band</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">автопокрышка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Резиновое покрытие, устанавливаемое на внешнем ободе колеса транспортного средства для обеспечения сцепления с поверхностью дороги и плавного движения по неровностям дороги.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إطار (سيارة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1201" />
