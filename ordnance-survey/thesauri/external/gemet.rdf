    <skos:prefLabel xml:lang="nl">afwateringsgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водораздел</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разделяющая линия между двумя прилегающими речными системами, например, горный кряж.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسقط ماء</skos:prefLabel>
