  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4260">
    <skos:prefLabel xml:lang="en">industrial product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit industriel</skos:prefLabel>
