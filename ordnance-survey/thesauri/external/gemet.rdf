  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11134">
    <skos:prefLabel xml:lang="en">scientific committee</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An organized group of persons elected or appointed to discuss scientific matters.
(Source: ZINZANa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">comité scientifique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comité científico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaftlicher Beirat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappelijk comité</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">научный комитет</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организованная группа лиц, избранных или назначенных для обсуждения научных вопросов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">لجنة علمية</skos:prefLabel>
