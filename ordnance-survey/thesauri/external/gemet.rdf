  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12872">
    <skos:prefLabel xml:lang="en">risk exposure plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A scheme or method of acting that takes effect if the probability of harm to an area or its population increases beyond a normal level.
(Source: ISEP /  HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'exposition aux risques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan de exposición de riesgo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Risikoexpositionsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rampenplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план на случай кризисной ситуации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Схема или метод действий, который вступает в силу, когда вероятность ущерба району или его населению превысит нормальный уровень.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة التعرض للمخاطر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2656" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3506">
    <skos:prefLabel xml:lang="en">fuel additive</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substance (such as tetraethyl lead) which is added to petrol to prevent knocking.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">additif pour carburants</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aditivo de combustible</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kraftstoffzusatz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">brandstofadditief</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">топливная добавка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, например, тетраэтил свинца, которое добавляется в бензин для предотвращения детонации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إضافات للوقود</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/88" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3507">
    <skos:prefLabel xml:lang="en">fuel alcohol</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Alternative source of energy for motor vehicles. It is produced by fermentation of sugar cane by the yeast Saccharomyces cerevisiae.
(Source: DICCHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">alcool-carburant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alcohol combustible</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Alkoholischer Brennstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">alcoholbrandstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">топливный спирт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Альтернативный источник энергии для автомобилей. Производится путем ферментации сахарного тростника дрожжами Saccharomyces cerevisiae.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الوقود الكحولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11700">
    <skos:prefLabel xml:lang="en">sensor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The generic name for a device that senses either the absolute value or a change in a physical quantity such as temperature, pressure, flow rate, or pH, or the intensity of light, sound, or ratio waves and converts that change into a useful input signal for an information-gathering system.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">capteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sensor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sensor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sensor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">датчик</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общий термин для устройства, указывающий либо на абсолютные значения, либо на изменения значения температуры, давления, скорости потока, уровня рН, интенсивности света, звука или превращающий эти изменения во входной сигнал для информационной системы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستشعر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5349" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3509">
    <skos:prefLabel xml:lang="en">fuel composition</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">composition des carburants</skos:prefLabel>
    <skos:prefLabel xml:lang="es">composición de combustible</skos:prefLabel>
