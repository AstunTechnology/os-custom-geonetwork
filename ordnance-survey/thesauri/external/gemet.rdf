    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1912">
    <skos:prefLabel xml:lang="en">cultural heritage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The inherited body of beliefs, customs, artistic activity and knowledge that has been transmitted by ancestors.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">patrimoine culturel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">patrimonio cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kulturerbe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cultureel erfgoed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">культурное наследие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общее число исторических памятников, музеев, научных, художественных, образовательных и культурных учреждений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تراث ثقافي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1921" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/568" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3971" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4850" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5449" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5478" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5507" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7188" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8579" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9382" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10106">
    <skos:prefLabel xml:lang="en">rescue system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any series of procedures and devices used by trained personnel to provide immediate assistance to persons who are in danger or injured.
(Source: GT2 / HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système de secours</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de rescate</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rettungssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reddingsstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система спасения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, предназначенная для оказания немедленной помощи пострадавшим или терпящим бедствие людям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام الإغاثة - نظام النجدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10054" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3226" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7126" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7404" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12607">
    <skos:prefLabel xml:lang="en">primary treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Removal of floating solids and suspended solids, both fine and coarse, from raw sewage.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement primaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento primario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mechanische Abwasserreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">primaire behandeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">первичная обработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление из необработанных стоков взвешенных или плавающих на поверхности твердых материалов, как мелких, так и крупных размеров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة أولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6650" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1917">
    <skos:prefLabel xml:lang="en">cultural policy</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">politique culturelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kulturpolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cultuurbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">политика в области культуры</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">سياسة ثقافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1921">
    <skos:prefLabel xml:lang="en">culture (society)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The body of customary beliefs, social forms, and material traits constituting a distinct complex of tradition of a racial or social group.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture (aspects sociaux)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kultur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beschaving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">культура (общество)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Собрание обычаев, верований, социальных форм и материальных черт, составляющее четкий комплекс традиций какой-либо расовой или социальной группы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثقافة (مجتمع)</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/23" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2801" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7679" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7823" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1926">
    <skos:prefLabel xml:lang="en">curriculum</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The aggregate of courses of study provided in a particular school, college, university, adult education program, technical institution or some other educational program.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">programme d'études</skos:prefLabel>
    <skos:prefLabel xml:lang="es">curriculum</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Curriculum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leerplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кадровая анкета</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Письменное изложение основных этапов получения образования и профессионального роста отдельного лица, которое готовится при подаче заявления о приеме на работу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منهج دراسي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12609">
    <skos:prefLabel xml:lang="en">tertiary treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process which remove pollutants not adequately removed by secondary treatment, particularly nitrogen and phosphorus; accomplished by means of sand filters, microstraining, or other methods (referring to wastewater treatment).
(Source: WQA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement tertiaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento terciario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Weitergehende Abwasserbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tertiaire behandeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">третичная обработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого удаляются загрязняющие вещества, оставшиеся после вторичной переработки стоков,  в частности, азот и фосфор. Осуществляется посредством применения песчаных фильтров, микрофильтрации или др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة ثالثية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6650" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10120">
    <skos:prefLabel xml:lang="en">tax system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A co-ordinated body of methods or plan of procedures for levying compulsory charges for the purpose of raising revenue.
(Source: ISEP /  EFP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fiscalité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema impositivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steuersystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belastingstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налоговая система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплекс методов или процедур для взимания обязательных сборов с целью получения доходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام الضرائب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8308" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1929">
    <skos:prefLabel xml:lang="en">customs</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Duties charged upon commodities on their importation into, or exportation out of, a country.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">douane</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aduana</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zollerhebung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">douane</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">таможенные сборы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Налоги, взимаемые при импорте или экспорте товаров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جمارك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1590" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1930">
    <skos:prefLabel xml:lang="en">cutting (forestry)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of felling or uprooting standing trees, in order to produce timber products.
(Source: TIM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abattage (foresterie)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cortado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Holzfällung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kappen [bosbouw]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рубка (лесное хозяйство)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или процесс вырубания, корчевания отдельных деревьев в целях производства древесины.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قطع الأشجار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3444" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1931">
    <skos:prefLabel xml:lang="en">cyanate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A salt or ester of cyanic acid containing the radical OCN.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cyanate</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cianato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Cyanat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cyanaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цианат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соль или сложный эфир цианистой кислоты, содержащий радикал OCN.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سيانيت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1933">
    <skos:prefLabel xml:lang="en">cyanide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of a group of compounds containing the CN group and derived from hydrogen cyanide, HCN.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cyanure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cianuro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Cyanid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cyanide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цианид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Представитель класса соединений, содержащих группу CN и полученных из цианида водорода HCN.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سيانيد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10126">
    <skos:prefLabel xml:lang="en">concept of environment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The development at any level of a general notion of the surrounding ecosystem, its foundational relationship to human life and the need to preserve its integrity.
(Source: TOE /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concept d'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concepto de medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltkonzept</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieubeeld</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическая концепция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разработка на любом уровне общего представления об окружающей экосистеме, ее основных связях с человеком и необходимости сохранения ее целостности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مفهوم البيئة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2778" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10128">
    <skos:prefLabel xml:lang="en">forest ecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science that deals with the relationship of forest trees to their environment, to one another, and to other plants and to animals in the forest.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écologie forestière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología forestal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Waldökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bosecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экология лесов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая взаимоотношения лесов с окружающей их средой, с другими лесами, с другими лесными растениями и животными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إيكولوجيا الغابات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5784">
    <skos:prefLabel xml:lang="en">occupational health</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An area of statutory duty imposed on employers and employees in most countries, for the protection of the workforce from occupational diseases and stresses and physical hazards through adequate planning, ventilation, lighting, safeguards, safety and emergency procedures, routine inspections, monitoring, personal protection, etc.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hygiène du travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salud ocupacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arbeitshygiene</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsgezondheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профессиональная гигиена</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Во многих странах уставная обязанность работодателей и работников, направленная на защиту персонала предприятия от профессиональных заболеваний, стрессов, физических рисков и заключающаяся в проведении соответствующего планирования, установлении вентиляции, освещения, страховочного оборудования, принятии мер на случай чрезвычайной ситуации, проведении регулярных инспекций, мониторинга и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صحة مهنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3866" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5785" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10130">
    <skos:prefLabel xml:lang="en">urban ecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concept derived from biology: the city is viewed as a total environment, as a life-supporting system for the large number of people concentrated there, and within this people organize themselves and adapt to a constantly changing environment. Regarded as the same as human ecology.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écologie urbaine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología urbana</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadsecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">городская экология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Биологическая концепция: город рассматривается в качестве целостной экологической системы, поддерживающей жизнедеятельность большого числа людей, проживающих в городе и постоянно адаптирующихся к изменяющимся условиях окружающей среды. Аналогична человеческой экологии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإيكولوجيا الحضرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12611">
    <skos:prefLabel xml:lang="en">vitrification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Formation of a glassy or noncrystalline material.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vitrification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vitrificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verglasung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verglazing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">витрификация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Образование стеклообразного или некристаллического материала.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التزجيج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1941">
    <skos:prefLabel xml:lang="en">cyclone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A storm characterized by the converging and rising giratory movement of the wind around a zone of low pressure (the eye) towards which it is violently pulled from a zone of high pressure. Its circulation is counterclockwise round the center in the northern hemisphere, clockwise in the southern hemisphere.
(Source: GUNN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cyclone</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zyklon</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wervelstorm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">циклон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ураган, характеризуемый конвергентным и восходящим вращающимся движением воздушных потоков вокруг зоны низкого давления ("глаз" циклона), к которой он стремится из зоны высокого давления. Циркуляция воздушных потоков происходит против часовой стрелки в северном полушарии, и по часовой стрелке в южном полушарии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعصار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5196" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5193" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1689">
    <skos:prefLabel xml:lang="en">conflict of aims</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">conflit d'objectifs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conflicto de objetivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zielkonflikt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tegenstrijdigheid van (streef)doelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">конфликт целей</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تناقض الأهداف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10136">
    <skos:prefLabel xml:lang="en">biological heritage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The inheritance and preservation of the earth's or a particular region's balanced, integrated functionality as a natural habitat, with special concern for the water resources necessary to maintain the ecosystem.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">patrimoine biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">patrimonio biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologisches Erbe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologisch erfgoed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое наследие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Получение по наследству от предыдущих поколений и сохранение сбалансированных, целостных функций Земли или отдельного региона в качестве природной среды обитания с особым вниманием по отношению к водным ресурсам, необходимым для поддержания экосистемы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التراث البيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5507" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1945">
    <skos:prefLabel xml:lang="en">cytology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of the biological sciences which deals with the structure, behaviour, growth, and reproduction of cells and the functions and chemistry of cell components.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cytologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">citología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zytologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cytologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цитология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль биологической науки, которая имеет дело со структурой, поведением, ростом и репродукцией клеток, их функциями и химическими процессами между клеточными компонентами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الخلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4805" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1946">
    <skos:prefLabel xml:lang="en">cytotoxicity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The degree to which an agent possesses a specific destructive action on certain cells or the possession of such action; used particularly in referring to the lysis of cells by immune phenomena and to antineoplastic drugs that selectively kill dividing cells.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cytotoxicité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">citotoxicidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zytotoxizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cytotoxiciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цитотоксичность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Степень, с которой вещество деструктивно действует на отдельные клетки, или обладание веществом такой способностью; используется, как правило, в отношении лизиса клеток в результате иммунного феномена и антиопухолевых препаратов, избирательно уничтожающих делящиеся клетки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سُمِّيَّة خلوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8538" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10140">
    <skos:prefLabel xml:lang="en">altitude</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) In general, a term used to describe a topographic eminence. 
2) A specific altitude or height above a given level. 
3) In surveying, the term refers to the angle between the horizontal and a point at a higher level.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">altitude</skos:prefLabel>
    <skos:prefLabel xml:lang="es">altitud</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Höhe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">hoogte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">высота (геогр.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Термин, употребляемый для описания топографической возвышенности. 2) Конкретная высота или уровень, превышающий заданный. 3) При геодезическом визировании термин означает угол между точкой на горизонте и точкой более высокого уровня.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ارتفاع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1950">
    <skos:prefLabel xml:lang="en">dairy farm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A commercial establishment for processing or selling milk and milk products.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">laiterie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">granja lechera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Milchviehhaltung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">melkveehouderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">молочная ферма</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Коммерческое предприятие, предназначенное для переработки или продажи молока и молочных продуктов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مزرعة ألبان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1951" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1951">
    <skos:prefLabel xml:lang="en">dairy industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Production of food made from milk or milk products.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie laitière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de la leche</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Milchwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuivelindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">молочная промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Производство продуктов питания из молока или молочных продуктов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الألبان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3368" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1950" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10144">
    <skos:prefLabel xml:lang="en">headland (geography)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A cape or promontory jutting seawards from a coastline, usually with a significant sea cliff.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cap</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cabo (geografía)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landspitze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landtong</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мыс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выдающийся в море выступ побережья обычно с высокой скалой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الرأس البحري (جغرافيا)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1512" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10146">
    <skos:prefLabel xml:lang="en">geographic circque</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A deep steep-walled half-bowl-like recess or hollow, variously described as horseshoe- or crescent-shaped or semi-circular in plan, situated high on the side of a mountain and commonly at the head of a glacial valley and produced by the erosive activity of a mountain glacier. It often contains a small round lake, and it may or may not be occupied by ice or snow.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cirque géographique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">circo geográfico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">geographisches Kar</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rond plein [geografie]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цирк</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Глубокая впадина с крутыми склонами, вид сверху которой напоминает подкову или полумесяц, расположенная высоко на горном склоне и часто в начале долины ледникового происхождения; является результатом эрозии горного ледника. Часто имеет небольшое озеро круглой формы, иногда может быть также покрыто снегом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دارة جغرافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4629" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1955">
    <skos:prefLabel xml:lang="en">dam</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Structure constructed across a watercourse or stream channel.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">barrage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">presas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Damm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dam</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дамба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Конструкция, возведенная поперек русла реки или канала.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4082" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8110" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13570" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4084" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1956">
    <skos:prefLabel xml:lang="en">damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An injury or harm impairing the function or condition of a person or thing.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dommage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">daños y perjuicios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schaden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schade</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ущерб</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вред или урон, ухудшающие функции или состояние человека или предмета.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضرر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1437" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10149">
    <skos:prefLabel xml:lang="en">barrier beach</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An elongated sand or shingle bank which lies parallel to the coastline and is not submerged by the tide. If it is high enough to permit dune growth it is termed a barrier island.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cordon littoral</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cordón litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strandwall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">strandwal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">песчаная коса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удлиненная полоса берега из песка или гальки, расположенная параллельно береговой линии и не закрываемая водами прилива. Если на ней располагаются дюны, то она называется барьерным островом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حاجز شاطئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/751" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1958">
    <skos:prefLabel xml:lang="en">damage from military manoeuvres</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Injury or harm resulting from the planned movement of armed forces or from the tactical exercises simulating war operations that is carried out for training and evaluation purposes.
(Source: GT2 / JSS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dommages dus à des manoeuvres militaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">daños por maniobras militares</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Manöverschaden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schade ten gevolg van militaire oefeningen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ущерб от военных маневров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вред или урон, нанесенные вследствие тактических учений или плановых передвижений вооруженных сил.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أضرار ناجمة عن العمليات العسكرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5243" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1959">
    <skos:prefLabel xml:lang="en">damage prevention</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The aggregate of approaches and measures to ensure that human action or natural phenomena do not cause damage. It implies the formulation and implementation of long-range policies and programmes to eliminate or prevent the damages caused by disasters.
(Source: GUNN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prévention des dommages</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prevención de daños</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schadensvermeidung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorkoming van schade</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предотвращение ущерба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплекс мер и методик, цель которых гарантировать, что действия человека или природное явление не нанесут ущерба. Предполагает формулирование и реализацию долгосрочной политики и программ, направленных на устранение или предотвращение ущерба, причиняемого стихийными бедствиями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الوقاية من الأضرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10152">
    <skos:prefLabel xml:lang="en">creek</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A narrow inlet or bay, especially of the sea.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">crique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ensenada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bach</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kreek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">небольшой залив</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Узкая бухта, особенно морская.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خليط صغير  - شرم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3800" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1015" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10154">
    <skos:prefLabel xml:lang="en">fault</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fracture or a zone of fractures along which there has been displacement of the sides relative to one another parallel to the fracture.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">faille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">falta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwerfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">breuk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разлом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Трещина или зона трещин, вдоль которых произошло параллельное трещине смещение склонов по отношению к друг другу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صدع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2400" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10155">
    <skos:prefLabel xml:lang="en">cliff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A steep coastal declivity which may or may not be precipitous, the slope angle being dependent partly on the jointing, bedding and hardness of the materials from which the cliff has been formed, and partly on the erosional processes at work. Where wave attack is dominant the cliff-foot will be rapidly eroded and cliff retreat will take place, especially in unconsolidated materials such as clays, sands, etc., frequently leaving behind an abrasion platform at the foot of the cliff.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">falaise</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acantilado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Klippe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">klif</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">скала</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высокий каменный утес на побережье, который может быть отвесным или нет, угол наклона которого зависит от соединения, твердости и напластования образующих его материалов, а также от процессов эрозии. Под воздействием морских волн подножие скалы будет быстро размываться, и скала будет отступать от берега, особенно если в ее состав входят сыпучие материалы, такие как песок, оставляя вместо себя абразивную платформу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جُرف - منحدر صخري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1512" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10158">
    <skos:prefLabel xml:lang="en">open sea</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The high seas lying outside the exclusive economic zones of states. All states have equal rights to navigate, to overfly, to lay submarine cables, to construct artificial islands, to fish, and to conduct scientific research within the high seas.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">haute mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alta mar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hochsee</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">open zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">открытое море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Море, расположенное за пределами экономических зон государств. В этом море все страны имеют равные права осуществлять навигацию, пролетать над морской поверхностью, прокладывать подземные кабели, создавать искусственные острова, ловить рыбу, вести научные исследования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عرض البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7495" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1968">
    <skos:prefLabel xml:lang="en">hazardous chemical export</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transporting substances capable of producing adverse health effects, fires or explosions to other countries or areas for the conduct of foreign trade.
(Source: TOE / MGHME)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exportation de produits chimiques dangereux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exportación química peligrosa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausfuhr von gefährlichen Chemikalien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitvoer van gevaarlijke chemicaliën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспорт опасных химических веществ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспортировка в другие страны и районы в рамках внешнеторговых операций веществ, способных иметь отрицательные последствия для здоровья, стать причиной пожара или взрыва.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصدير الكيماويات الخطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3063" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1969">
    <skos:prefLabel xml:lang="en">dangerous goods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Goods or products that are full of hazards or risks when used, transported, etc.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matières dangereuses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos peligrosos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gefährliche Güter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gevaarlijke goederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">опасные товары</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Товары или продукты, представляющие угрозу или несущие риск при использовании, транспортировке и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مواد خطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10930" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1970" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1971" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1970">
    <skos:prefLabel xml:lang="en">dangerous goods law</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">loi sur les matières dangereuses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación sobre mercancías peligrosas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gefahrgutgesetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wet inzake gevaarlijke goederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законы в области использования опасных товаров</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">قانون المواد الخطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2862" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1969" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1971">
    <skos:prefLabel xml:lang="en">dangerous goods regulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Rules on the handling of articles or substances capable of posing a significant risk to health, safety, or property, and that ordinarily require special attention when being transported.
(Source: TOLGARa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réglementation des matières dangereuses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reglamento sobre mercancías peligrosas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gefahrgutverordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verordening inzake gevaarlijke goederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">правила обращения с опасными товарами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Правила обращения с товарами или веществами, способными представлять серьезный риск для здоровья, безопасности или имущества и которые при обычных условиях требуют особого внимания при транспортировке.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيم المواد الخطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11514" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1969" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1974">
    <skos:prefLabel xml:lang="en">data acquisition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of collecting and gathering individual facts, statistics or other items of information.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acquisition des données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">obtención de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datensammlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevensverwerving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">получение данных</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الحصول على البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4302" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1975">
    <skos:prefLabel xml:lang="en">data analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The evaluation of digital data, i.e. data represented by a sequence of code characters.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse des données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevensanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Анализ цифровых данных, т.е. данных, представленных в виде последовательности знаков в определенной кодировке.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8076" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10170">
    <skos:prefLabel xml:lang="en">alluvial plain</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A level or gently sloping tract or a slightly undulating land surface produced by extensive deposition of alluvium, usually adjacent to a river that periodically overflows its banks; it may be situated on a flood plain, a delta, or an alluvial fan.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plaine alluviale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">llanura aluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flußmarsch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">alluviale vlakte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аллювиальная равнина</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ровная или слегка наклоненная поверхность земли, образованная масштабными аллювиальными отложениями, расположенная обычно рядом с рекой, воды которой периодически выходят из берегов; может также располагаться на затопляемой равнине, в дельте реки или в аллювиальном конусе выноса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سهل غريني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6276" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1979">
    <skos:prefLabel xml:lang="en">data base</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A computerized compilation of data, facts and records that is organized for convenient access, management and updating.
(Source: WIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">base de données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bases de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenbank</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevensbank</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">база данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Компьютеризированное собрание фактов, записей и данных, организованное с целью облегчения доступа к ним, управления ими и актуализации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قاعدة بيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4302" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14897" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4851" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1981">
    <skos:prefLabel xml:lang="en">data carrier</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A medium on which data can be recorded, and which is usually easily transportable, such as cards, tape, paper, or disks.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">support de données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">soporte informático</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenträger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevensdrager</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">носитель данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, на котором могут быть записаны данные и который обычно легко транспортировать, к примеру, карточки, пленки, бумага или диски.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حامل البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4964" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1984" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10175">
    <skos:prefLabel xml:lang="en">barrier reef</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An elongated accumulation of coral lying at low-tide level parallel to the coast but separated from it by a wide and deep lagoon or strait. The coral is thought to have formed initially on a flat surface: then as the sea-level rose in post-glacial times, thereby submerging the irregular wave-cut platform, the coral growth kept pace with the rising ocean level, so creating the great thickness witnessed today in such places as the Great Barrier Reef off the East coast of Queensland, Australia. This stretches for more than 1900 km and varies in width from about 30 km to 150 km.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">récif barrière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arrecife de coral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Barriereriff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">barrièrerif</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">барьерный риф</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удлиненное скопление кораллов, расположенных на уровне отлива параллельно берегу, но отделенное от него широкой и глубокой лагуной или проливом. Считается, что кораллы образовались на плоской поверхности суши, затем в результате подъема уровня моря в постледниковый период эти участки с коралловыми наростами оказались под водой. Ярким примером коралловой системы является Большой барьерный риф, расположенный вдоль восточного побережья штата Квинзленд в Австралии. Его длина превышает 1900 км, а ширина варьируется от 30 до 150 км.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حَشفة حاجزة - رصيف صخري حاجز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7034" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1984">
    <skos:prefLabel xml:lang="en">data exchange</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A reciprocal transfer of individual facts, statistics or items of information between two or more parties for the purpose of enhancing knowledge of the participants.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">échange de données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intercambio de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenaustausch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitwisseling van gegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обмен данными</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимная передача отдельных фактов, статистических данных или информационных продуктов, осуществляемая между двумя и более сторонами с целью пополнения и расширения знаний всех участников этого процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تبادل البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14896" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4398" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1981" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1986">
    <skos:prefLabel xml:lang="en">data processing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any operation or combination of operations on data, including everything that happens to data from the time they are observed or collected to the time they are destroyed.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement des données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesamiento de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenverarbeitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevensverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обработка данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая операция или комбинация операций с данными, включая все, что происходит с данными с момента, когда они получены, до момента их уничтожения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشغيل البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3011" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4140" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4307" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13316" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1988">
    <skos:prefLabel xml:lang="en">data protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Policies, procedures or devices designed to maintain the integrity or security of informational elements in storage or in transmission.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection des données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gegevensbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политика, процедуры или средства, предназначенные для поддержания целостности или сохранности элементов информации во время хранения, а также передачи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4302" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1989">
    <skos:prefLabel xml:lang="en">data recording technique</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The body of specialized procedures and methods used for the preservation, collocation or registration of individual elements of information.
(Source: RHW / APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technique d'enregistrement des données</skos:prefLabel>
    <skos:prefLabel xml:lang="es">técnicas de registro de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenerfassungsmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wijze waarop gegevens worden vastgelegd</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технология записи данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплекс специальных технологий и процедур, используемых для сохранения, расположения или регистрации отдельных элементов информации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقنية تسجيل البيانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5354" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/665" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1992">
    <skos:prefLabel xml:lang="en">dating</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of several techniques such as radioactive dating, dendrochronology, or varve dating, for establishing the age of rocks, palaeontological or archaeological specimens, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">datation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fechado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het dateren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">датирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование любой из известных методик, таких как радиоактивное датирование, дендрохронология, датирование по геологическим отложениям, для установления возраста камней, палеонтологических или археологических образцов и т.д.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تأريخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5203" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1993">
    <skos:prefLabel xml:lang="en">decay product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An isotope formed by the radioactive decay of some other isotope. This newly formed isotope possesses physical and chemical properties that are different from those of its parent isotope, and may also be radioactive.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">descendant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto de decantación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zerfallsprodukt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verrottingsproduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">продукт разложения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изотоп, образованный в результате радиоактивного разложения другого изотопа. Этот вновь образованный изотоп обладает физическими и химическими свойствами, которые отличаются от материнского изотопа, но может быть так же радиоактивным.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُنتَج التحلل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2042" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1996">
    <skos:prefLabel xml:lang="en">DDT</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A persistent organochlorine insecticide, also known as dichlorodiphenyltrichloroethane, that was introduced in the 1940s and used widely because of its persistence (meaning repeated applications were unnecessary), its low toxicity to mammals and its simplicity and cheapness of manufacture. It became dispersed all over the world and, with other organochlorines, had a disruptive effect on species high in food chains, especially on the breeding success of certain predatory birds. DDT is very stable, relatively insoluble in water, but highly soluble in fats. Health effects on humans are not clear, but it is less toxic than related compounds. It is poisonous to other vertebrates, especially fish, and is stored in the fatty tissue of animals as sublethal amounts of the less toxic DDE. Because of its effects on wildlife its use in most countries is now forbidden or strictly limited.
(Source: MGH /  ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">DDT</skos:prefLabel>
    <skos:prefLabel xml:lang="es">DDT</skos:prefLabel>
    <skos:prefLabel xml:lang="de">DDT</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">DDT</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ДДТ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стойкий органохлорсодержащий пестицид, известный также под названием дихлордифенилтрихлорэтан, который стал широко применяться в 40-е годы ХХ века именно благодаря своей стойкости (достаточно одноразовой обработки этим веществом), низкой токсичности по отношению к млекопитающим, простоте и дешевизне производства. Препарат получил широкое распространение по всему миру и, как и в случаях с другими органохлорсодержащими веществами, его применение имело разрушительные последствия для видов, находящихся на более высоких уровнях пищевых цепей, особенно хищных птиц. ДДТ очень стабилен, слабо растворим в воде, но отлично растворяется в жире. Его влияние на здоровье человека до сих пор не ясно окончательно, но представляется, что его токсичность ниже, чем у родственных химических соединений. Ядовит для других позвоночных, особенно рыб, откладывается в жировой ткани так же, как менее токсичный ДДТ. Вследствие такого разрушительного воздействия на природу применение ДДТ во всем мире либо запрещено, либо строго ограничено.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دي دي تي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1378" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4354" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10189">
    <skos:prefLabel xml:lang="en">biotope order</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An ordinance or decree regarding an area of ecological habitat that is characterized by a high degree of uniformity in its environmental conditions and in its distribution of plants and animals.
(Source: DOE /  OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ordonnance des  biotopes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ordenanza relativa al biotopo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotopordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biotooporde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательный акт по вопросам биотопа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Закон или декрет в отношении экологического района, признанного обладающим высокой степенью целостности своих природных условий и распределения растений и животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قرار خاص بالموطن الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2790" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/901" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10190">
    <skos:prefLabel xml:lang="en">sensitive natural area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Terrestrial or aquatic area or other fragile natural setting with unique or highly-valued environmental features.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espace naturel sensible</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área natural sensible</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Empfindliche Naturlandschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gevoelig natuurgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологически нестабильная природная зона</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок суши, водной или иной экологически слабой среды, обладающий уникальными или особо ценными природными условиями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة طبيعية حساسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7603" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3067">
    <skos:prefLabel xml:lang="en">exposure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The time for which a material is illuminated or irradiated.
(Source: PITT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exposition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exposición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Exposition</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">blootstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">время облучения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Время, в течение которого материал освещается или облучается.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعرُّض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6123" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2000">
    <skos:prefLabel xml:lang="en">debt</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Something owed to someone else.
(Source: SCRUZ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dette</skos:prefLabel>
    <skos:prefLabel xml:lang="es">deudas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schuld</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schuld</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">долг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Задолженность в чем-то перед кем-либо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13177" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2151" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13249" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2001">
    <skos:prefLabel xml:lang="en">debt service</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The fees or amount of money necessary to pay interest on an outstanding debt, the principal of maturing serial bonds, and the required contributions to an amortization or sinking fund for term bonds.
(Source: EFP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">service de la dette</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pago de la deuda</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kapitaldienst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rentebetaling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обслуживание долга (фин.-экон.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выплаты, которые необходимо уплатить в качестве процентов по невозвращенному долгу, капитальная сумма серийных облигаций, по которым наступает срок оплаты, и необходимые выплаты в амортизационный фонд или фонд погашения по срочным облигациям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خدمة الدَين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3205" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2002">
    <skos:prefLabel xml:lang="en">racking</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The mechanical dewatering of a wet solid by pouring off the liquid without disturbing the underlying sediment or precipitate.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décantation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trasvases</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dekantierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">klaring</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сцеживание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Механическое отделение воды от мокрого твердого материала в результате слива жидкости без возмущение осадочного нижнего слоя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إرساب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2003">
    <skos:prefLabel xml:lang="en">decentralisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Basic organizational leadership concept and process of shifting and delegating power and authority from a higher level to subordinate levels within the administrative/managerial hierarchy in order to promote independence, responsibility, and quicker decision-making in applying or interpreting policies and procedures to the needs of these levels.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décentralisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">descentralización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dezentralisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">decentralisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">децентрализация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Принцип организации руководства и процесс передачи власти и полномочий от более высокого уровня к более низким уровням в рамках административной/управленческой иерархии в целях стимулирования независимости, ответственности и ускорения процессов принятия решений при реализации политики и процедур, необходимых для этих уровней.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحول إلى اللامركزية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10833" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2004">
    <skos:prefLabel xml:lang="en">deciduous forest</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The temperate forests comprised of trees that seasonally shed their leaves, located in the east of the USA, in Western Europe from the Alps to Scandinavia, and in the eastern Asia. The hardwood of these forests have been exploited since the 16th century. The trees of deciduous forests usually produce nuts and winged seeds.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">forêt de feuillus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bosque caducifolio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Laubwald</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loofbos</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лиственный лес</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Леса умеренной полосы, состоящие из деревьев, которые периодически сбрасывают листву в соответствии с конкретным сезоном, расположенные в восточных районах США, на территории Западной Европы от Альп до Скандинавии и восточной Азии. Древесина этих пород используется с 16 века. Плодами деревьев лиственных лесов обычно бывают орехи и крылатые семена.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غابة متجددة الأوراق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3406" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2005">
    <skos:prefLabel xml:lang="en">deciduous tree</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Tree losing its leaves in autumn and growing new ones in the spring.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arbre à feuilles caduques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arbol de hoja perecedera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Laubbaum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loofboom</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лиственное дерево</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дерево, с которого осенью облетает листва, а весной вырастают новые листья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شجرة متجددة الأوراق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2006">
    <skos:prefLabel xml:lang="en">decision</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Means the exercise of agency authority at any stage of an undertaking where alterations might be made in the undertaking to modify its impact upon historic and cultural properties.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décision</skos:prefLabel>
    <skos:prefLabel xml:lang="es">decisiones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entscheidung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beslissing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">решение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Проявление полномочий организации на любой стадии какого-либо предприятия, когда внесение  изменений в это предприятие может изменить его воздействие на культурные или исторические свойства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10199">
    <skos:prefLabel xml:lang="en">marine park</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A permanent reservation on the seabed for the conservation of species.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parc marin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">parque marino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meerespark</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">marien park</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морской парк</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постоянный заповедник на участке моря, предназначенный для сохранения видов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حديقة بحرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10212" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10200">
    <skos:prefLabel xml:lang="en">regional natural park</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A park operated and managed by a region.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parc naturel régional</skos:prefLabel>
    <skos:prefLabel xml:lang="es">parque natural regional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Regionaler Naturpark</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gewestelijk natuurpark</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">региональный природный парк</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Парк, находящийся в ведении региональных властей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حديقة طبيعية إقليمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5513" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2009">
    <skos:prefLabel xml:lang="en">decision process</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">processus de décision</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesos de decisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entscheidungsprozeß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">besluitvormingsproces</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">процесс принятия решения</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">عملية القرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4985" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/500" />
