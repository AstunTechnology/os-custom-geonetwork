  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5927">
    <skos:prefLabel xml:lang="en">organometallic compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Molecules containing carbon-metal linkage; a compound containing an alkyl or aryl radical bonded to a metal.
(Source: MGH)</skos:scopeNote>
