  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7578">
    <skos:prefLabel xml:lang="en">seismic monitoring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The gathering of seismic data from an area.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surveillance des activités sismiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vigilancia sísmica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Seismische Überwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">controle op seismische activiteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сейсмический мониторинг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сбор сейсмических данных в конкретном районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مراقبة الأنشطة الزلزالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5346" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10034" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7579">
    <skos:prefLabel xml:lang="en">seismic sea wave</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large seismically generated sea wave which is capable of considerable destruction in certain coastal areas, especially where submarine earthquakes occur. Although in the open ocean the wave height may be less than one meter it steepens to hights of 15 metres or more on entering shallow coastal water. The wavelength in the open ocean is of the order of 100 to 150 km and the rate of travel of a seismic sea wave is between 640 and 960 km/h.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">raz de marée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marejadas sísmicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Seismische Welle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">door aardbeving veroorzaakte zeegolven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цунами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Большая волна, образованная в результате сейсмических процессов в море, способная нанести серьезные разрушения в прибрежных районах, особенно после сильного землетрясения под водой. В открытом море высота такой волны может быть менее 1 м, однако ближе к берегу над более мелкой водой высота этой волны может достигать 15 м. Длина такой волны в открытом море составляет порядка 100-150 км, а скорость составляет от 640 до 960 км/ч.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موجة تسونامي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9262" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5124">
    <skos:prefLabel xml:lang="en">meat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The edible flesh of animals, especially that of mammals as opposed to that of fish or a nut.
(Source: AMHER /  MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">viande</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carne</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fleisch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vlees</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мясо</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Съедобная плоть животных, особенно млекопитающих, в отличие от рыбы или птицы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">لحم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7581">
    <skos:prefLabel xml:lang="en">seizure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The official or legally authorized act of taking away possessions or property, often for a violation of law or to enforce a judgment imposed by a court of law.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">saisie (droit)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">embargo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beschlagnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inbeslagneming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изъятие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Официальная или предусмотренная законом конфискация личного имущества или собственности, часто в качестве наказания за нарушение закона, а также во исполнение решения суда.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصادرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7582">
    <skos:prefLabel xml:lang="en">seizure of profits</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The official or legally authorized act of taking away monetary gain or surplus resulting from investments or property or from returns, proceeds or revenue in a business or business transaction.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">saisie des bénéfices</skos:prefLabel>
    <skos:prefLabel xml:lang="es">realización de beneficios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewinnabschöpfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beslaglegging op de winst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изъятие прибыли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Официальная или предусмотренная законом конфискация валютной выручки или дохода, полученных в результате инвестирования средств, от собственности или в ходе коммерческой деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصادرة المكاسب (الأرباح)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7581" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7584">
    <skos:prefLabel xml:lang="en">selection of technology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sélection de technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">selección de tecnología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologieauswahl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">keuze van technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выбор технологии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انتقاء التكنولوجيا - اختيار التكنولوجيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7127" />
