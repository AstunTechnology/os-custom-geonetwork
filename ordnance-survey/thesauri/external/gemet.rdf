    <skos:prefLabel xml:lang="es">motor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Motor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">motor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">двигатель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машина, в которой энергия производит работу в результате конверсии различных форм энергии в механическую силу и движение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محرك</skos:prefLabel>
