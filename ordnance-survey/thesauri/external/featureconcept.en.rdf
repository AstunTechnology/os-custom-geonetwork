    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:38 PM CEST</dct:created>
    <dct:title xml:lang="en">WFD Transitional Water</dct:title>
    <skos:prefLabel xml:lang="en">WFD Transitional Water</skos:prefLabel>
    <dct:description xml:lang="en">Bodies of surface water in the vicinity of river mouths which are partly saline in character as a result of their proximity to coastal waters but which are substantially influenced by freshwater flows.</dct:description>
    <skos:definition xml:lang="en">Bodies of surface water in the vicinity of river mouths which are partly saline in character as a result of their proximity to coastal waters but which are substantially influenced by freshwater flows.</skos:definition>
