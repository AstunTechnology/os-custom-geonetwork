  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/415">
    <skos:prefLabel xml:lang="en">animal behaviour</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Behaviour of animals in their normal environment, including all the processes, both internal and external, by which they respond to changes in their environment.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">comportement animal</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comportamiento animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierverhalten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierengedrag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поведение животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поведение животных в их естественной среде, включая все внешние и внутренние процессы, посредством которых они проявляют свою реакцию на изменения в окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلوك الحيوان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/765" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10535" />
