    <skos:prefLabel xml:lang="nl">vraag naar water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребности в воде</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الطلب على الماء</skos:prefLabel>
