    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6859">
    <skos:prefLabel xml:lang="en">quality assurance</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">assurance de qualité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de calidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Qualitätssicherung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kwaliteitswaarborg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гарантия качества</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">ضمان الجودة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6662" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6860">
    <skos:prefLabel xml:lang="en">quality control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The inspection, analysis, and other relevant actions taken to provide control over what is being done, manufactured, or fabricated, so that a desirable level of quality is achieved and maintained.
(Source: HARRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contrôle qualité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de calidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Qualitätskontrolle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kwaliteitsbewaking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">контроль за качеством</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Проверка, анализ и соответствующие действия, предпринимаемые для обеспечения контроля за тем, что происходит, производится или изготавливается в целях обеспечения достижения и поддержания необходимого уровня качества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مراقبة الجودة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5354" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3874">
    <skos:prefLabel xml:lang="en">health legislation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Laws, ordinances, or codes prescribing sanitary, clean air, etc., standards and regulations, designed to promote and preserve the health of the community and working conditions of businesses.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation sanitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación sanitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesundheitsrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gezondheidswetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство в области здравоохранения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Законы, правила, определяющие санитарные нормы, определенный уровень чистоты воздуха и т.д.; стандарты и правила, направленные на поддержание и сохранение здоровья сообщества и условий труда на производстве.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريع صحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6897" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6867">
    <skos:prefLabel xml:lang="en">quarry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An open or surface working or excavation for the extraction of building stone, ore, coal, gravel, or minerals.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">carrière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">canteras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steinbruch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(steen)groeve</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">карьер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Открытая разработка, раскоп для добычи строительного камня, руды, угля, гравия или минералов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محجر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5286" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12656" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6870">
    <skos:prefLabel xml:lang="en">quarrying</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The surface exploitation and removal of stone or mineral deposits from the earth's crust.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploitation de carrière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación de canteras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steinbrucharbeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">een steengroeve ontginnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разработка карьеров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поверхностная эксплуатация и извлечение из земной коры минеральных пород и полезных ископаемых.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أعمال المحاجر - استغلال المحاجر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5529" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2511">
    <skos:prefLabel xml:lang="en">economic trend</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Changes of variables and parameters of an economic system, analysed in statistical calculations.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">conjoncture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tendencia económica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftstendenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">economische trend</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономическая тенденция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изменение переменных и параметров экономической системы, проанализированные в статистических расчетах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوجه الاقتصادي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2490" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6672" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10049">
    <skos:prefLabel xml:lang="en">pollution prevention</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Eliminating the production of hazardous wastes and greenhouse gases at their source, within the production process. This can often be achieved through a variety of relatively simple strategies, including minor changes in manufacturing processes, substitution of non-polluting products for polluting products, and simplification of packaging. Companies practicing waste reduction have saved hundreds of millions of dollars, and used it to catalyze employee involvement and eliminate the need for expensive end-of-the-pipe filtering.
(Source: GLOCHA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">prévention des pollutions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prevención de la contaminación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verhütung von Umweltverschmutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorkomen van milieuverontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предотвращение загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устранение выброса вредных отходов и парниковых газов в источнике их образования в рамках производственного процесса. Это может быть достигнуто в результате реализации разнообразных относительно простых мер, включая небольшие изменения в производственном процессе, замену загрязняющих веществ веществами, не загрязняющими окружающую среду, упрощения вида упаковки. Компании, практикующие принципы снижения отходов, сэкономили сотни миллионов долларов, которые были направлены на создание новых рабочих мест и не были потрачены на установление дорогостоящего оборудования по обезвреживанию и переработке выбрасываемых отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الوقاية من التلوث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9203" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2512">
    <skos:prefLabel xml:lang="en">economic viability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Capability of developing and surviving as a relatively independent social, economic or political unit.
(Source: WEBSTEa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">viabilité économique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">viabilidad económica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftlichkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">economische levensvatbaarheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономическая жизнеспособность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность развиваться и выживать как относительно независимая социальная, экономическая или политическая единица.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قابلية الاقتصاد للحياة والنمو</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2478" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6882">
    <skos:prefLabel xml:lang="en">race relations</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The associations, tensions or harmony between two or more groups of people distinguished by history, culture, religion or physique: distinctions erroneously construed as being based on consistent biological differences and as representing, in effect, species of a human genus.
(Source: SOC / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relation interraciale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">minorías y relaciones raciales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rassenbeziehungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verhoudingen tussen rassen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">расовые взаимоотношения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Связи, напряженность или гармония в отношениях между двумя и более группами людей, различающихся по своей истории, культуре, религии или внешнему виду; различия в прошлом ошибочно основывались на биологических отличиях, представляющих различные биологические виды человеческого рода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العلاقات بين الأعراق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2651" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6883">
    <skos:prefLabel xml:lang="en">radar</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system using beamed and reflected radiofrequency energy for detecting and locating objects, measuring distance or altitude, navigating, homing, bombing and other purposes.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">radar</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radar</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радар</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, использующая лучевую, отраженную радиочастотную энергию для обнаружения и определения местоположения объектов, измерения расстояния или высоты, навигации, указания посадки самолетам, бомбардировки и др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رادار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5349" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6884">
    <skos:prefLabel xml:lang="en">radiation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Emission of any rays from either natural or man-made origins, such as radio waves, the sun's rays, medical X-rays and the fall-out and nuclear wastes produced by nuclear weapons and nuclear energy production. Radiation is usually divided between non-ionizing radiation, such as thermal radiation (heat) and light, and nuclear radiation. Non-ionizing radiation includes ultraviolet radiation from the sun which, although it can damage cells and tissues, does not involve the ionization events of nuclear radiation.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rayonnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radiaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">straling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Излучение из природного или искусственного источника, например, радиоволны, солнечный свет, рентгеновские лучи, ядерные отходы, образовавшиеся в результате применения ядерного оружия и производства ядерной энергии. Излучение обычно подразделяется на неионизирующее, например, термоизлучение (тепло) или свет, и ионизирующее, радиоактивное излучение. К неионизирующему излучению относится также ультрафиолетовое излучение солнца, которое хоть и может повредить клетки и ткани, однако не связано с ионизирующими процессами, вызываемыми радиоактивным излучением.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إشعاع</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/693" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/695" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1814" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4317" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4491" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4698" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4810" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5231" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5674" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6925" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14901" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6226" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6888" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6896" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6911" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6918" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7037" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6887">
    <skos:prefLabel xml:lang="en">radiation damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Somatic and genetic damage to living organisms caused by exposure to ionizing radiation.
(Source: GUNN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dommage dû au rayonnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">daño de radiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenschaden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingsschade</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ущерб от радиации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соматические и генетические повреждения в живых организмах, вызванные воздействием ионизирующего излучения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الضرر الإشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6899" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5708" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6889" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6888">
    <skos:prefLabel xml:lang="en">radiation dose</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The total amount of radiation absorbed by material or tissues, in the sense of absorbed dose, exposure dose, or dose equivalent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dose de radiations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dosis de radiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlendosis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingsdosis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доза радиации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Величина излучения, поглощенная материалом или тканями, в смысле поглощенной дозы, дозы воздействия и эквивалентной дозы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجرعة الإشعاعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2308" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1148">
    <skos:prefLabel xml:lang="en">car</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A four-wheeled motor vehicle used for land transport, usually propelled by a gasoline or diesel internal combustion engine.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">automobile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">coche</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Automobil</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wagen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">автомобиль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Четырехколесное сухопутное средство транспорта, обычно оснащенное двигателем внутреннего сгорания, работающим на бензине или дизельном топливе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سيارة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5390" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6634" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12027" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6890">
    <skos:prefLabel xml:lang="en">radiation exposure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or state of being subjected to electromagnetic energy strong enough to ionize atoms thereby posing a threat to human health or the environment.
(Source: APD / MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exposition aux rayonnements</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exposición de radiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenexposition</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">blootstelling aan straling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">воздействие радиации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или состояние подверженности сильной электромагнитной энергии, способной ионизировать атомы и поэтому представлять угрозу для здоровья человека и окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعرض للإشعاعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12793" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6892">
    <skos:prefLabel xml:lang="en">radiation monitoring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The periodic or continuous surveillance or analysis of the level of radiant energy present in a given area, to determine that its prescribed amount has not been exceeded or that it meets acceptable safety standards.
(Source: TOE / OMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surveillance des radiations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vigilancia de la radiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingsmeting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мониторинг радиации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постоянное или периодическое наблюдение, анализ уровня радиационной энергии, присутствующей в данном районе, с целью выяснения соответствия этого уровня установленной величине или стандартам безопасности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مراقبة الإشعاعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5346" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5685">
    <skos:prefLabel xml:lang="en">non-renewable resource</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A natural resource which, in terms of human time scales, is contained within the Earth in a fixed quantity and therefore can be used once only in the foreseeable future (although it may be recycled after its first use). This includes the fossil fuels and is extended to include mineral resources and sometimes ground water, although water and many minerals are renewed eventually.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ressource non renouvelable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recursos no renovables</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nichterneuerbare Ressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">niet-hernieuwbare hulpbronnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">невозобновляемый ресурс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Природный ресурс, который, с точки зрения продолжительности человеческой  жизни, находится в недрах земли и может быть использован только в обозримом будущем (хотя после использования может быть использован вторично). К таким ресурсам относятся минеральные виды топлива, а также минеральные ресурсы в целом, грунтовая вода, хотя минеральные ресурсы и вода в конечном итоге могут восстанавливаться.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر غير متجدد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7168" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5684" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5274" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6894">
    <skos:prefLabel xml:lang="en">radiation physics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of ionizing radiation and its effects on matter.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">physique des rayonnements</skos:prefLabel>
    <skos:prefLabel xml:lang="es">física de radiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenphysik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingsfysica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиофизика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение ионизирующего излучения и его воздействия на материю.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيزياء الإشعاعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5733" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6896">
    <skos:prefLabel xml:lang="en">radiation protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Precautionary actions, measures or equipment implemented to guard or defend people, property and natural resources from the harmful effects of ionizing energy.
(Source: MHD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">radioprotection</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección radiológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingsbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита от радиации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Профилактические меры, действия или оборудование, реализованные для ограждения или защиты людей, собственности или природных ресурсов от разрушительного воздействия ионизирующей энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحماية من الإشعاعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11662" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6897">
    <skos:prefLabel xml:lang="en">radiation protection law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by  government to establish measures to keep humans and natural resources safe from harmful exposure to energy waves released by nuclear materials, electromagnetic current and other sources.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi relative à la protection contre le rayonnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley de protección contra la radiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenschutzrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingbeschermingswet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законы в области защиты от радиации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, принятых государством и определяющих меры защиты людей и природных ресурсов от разрушительного воздействия энергии, испускаемой ядерными материалами, электромагнитными волнами и др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون الحماية من الإشعاع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3874" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6899">
    <skos:prefLabel xml:lang="en">radiation sickness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The complex of symptoms characterizing the disease known as radiation injury, resulting from excessive exposure of the whole body (or large part) to ionizing radiation. The earliest of these symptoms are nausea, fatigue, vomiting, and diarrhea, which may be followed by loss of hair (epilation), hemorrhage, inflammation of the mouth and throat, and general loss of energy.
(Source: TDH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">maladie due aux radiations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enfermedades de origen radiactivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Strahlenkrankheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stralingsziekte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лучевая болезнь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплекс симптомов заболевания, являющегося результатом воздействия ионизирующего излучения на все тело или его большую часть. Самыми ранними признаками являются тошнота, усталость, рвота, понос, за которыми могут последовать выпадение волос, кровоизлияния, воспаления слизистых рта и носоглотки, общий упадок сил.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرض بسبب الإشعاعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6887" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6901">
    <skos:prefLabel xml:lang="en">radio</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process, equipment or programming involved in transmitting and receiving sound signals by electromagnetic waves.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">radio</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radio</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radio</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радио</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оборудование, используемое для передачи или приема радиосигналов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">راديو - إذاعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5079" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14874" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6904">
    <skos:prefLabel xml:lang="en">radioactive contamination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Contamination of a substance, living organism or site caused by radioactive material.
(Source: FLGISA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contamination radioactive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminacíon radiactiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktive Verseuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve besmetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивное заражение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заражение вещества, живого организма или площадки, вызванное радиоактивными материалами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث إشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1752" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5708" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12793" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2516">
    <skos:prefLabel xml:lang="en">economy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The system of activities and administration through which a society uses its resources to produce wealth.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">economía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">economie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система деятельности и управления, посредством которой общество использует свои ресурсы для производства материальных благ или богатства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاقتصاد</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/193" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1743" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2476" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2478" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2490" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2493" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2498" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2508" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2723" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3149" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3243" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3402" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3440" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4228" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5058" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5064" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8566" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10931" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10940" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11069" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13145" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13148" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13238" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13239" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13242" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14949" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6908">
    <skos:prefLabel xml:lang="en">radioactive decontamination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removal of radioactive contamination which is deposited on surfaces or may have spread throughout a work area. Personnel decontamination is also included. Decontamination methods follow two broad avenues of attack, mechanical and chemical.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décontamination radioactive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">descontaminación radiactiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktive Entseuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve ontsmetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дезактивация радиоактивного загрязнения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление радиоактивного заражения, располагавшегося на поверхности либо распространившегося по рабочей территории. Процесс включает также дезактивацию одежды персонала. Используются механические и химические методы дезактивации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إزالة التلوث الإشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2015" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6909">
    <skos:prefLabel xml:lang="en">radioactive dumping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste generated by the emission of particulate or electromagnetic radiation resulting from the decay of the nuclei of unstable elements.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge de déchêts radioactifs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertidos radiactivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktive Ablagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve afvalstortplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сброс радиоактивных отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, полученные в процессе выброса частиц или электромагнитного излучения вследствие разложения ядер нестабильных элементов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من المخلفات المشعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2367" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6921" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8959">
    <skos:prefLabel xml:lang="en">vibration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A periodic motion of small amplitude and high frequency, characteristic of elastic bodies.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vibration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vibraciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erschütterung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">trillingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вибрация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Периодическое колебание с малыми амплитудами и высокой частотой, характерное для эластичных тел.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اهتزاز</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6912">
    <skos:prefLabel xml:lang="en">radioactive fallout</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The material that descends to the earth or water well beyond the site of a surface or subsurface nuclear explosion.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">retombée radioactive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">polvillo (radiactividad)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fallout (Radioaktivität)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve neerslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивные осадки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, оседающий на поверхности земли или воды далеко за пределами площадки проведения наземного или подземного ядерного взрыва.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترسب إشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3110" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6915" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6915">
    <skos:prefLabel xml:lang="en">radioactive pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance undergoing spontaneous decay or disintegration of atomic nuclei and giving off radiant energy in the form of particles or waves, often associated with an explosion of a nuclear weapon or an accidental release from a nuclear power plant, holding facility or transporting container.
(Source: DEE / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant radioactif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes radiactivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktiver Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve vervuiler</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивное загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, проходящее через спонтанное разложение или распад атомных ядер и испускающее лучистую энергию в форме частиц или волн, часто связанное со взрывом ядерного оружия или аварийным выбросом на атомной электростанции, в хранилище или транспортном контейнере.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوث إشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6918">
    <skos:prefLabel xml:lang="en">radioactive substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any substance that contains one or more radionuclides of which the activity or the concentration cannot be disregarded as far as radiation protection is concerned.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance radioactive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancias radiactivas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktive Substanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивное вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, содержащее один или более радионуклидов, активность или концентрация которых не могут оставаться без внимания в плане осуществления мер радиационной защиты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة مشعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12004" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6919">
    <skos:prefLabel xml:lang="en">radioactive tracer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A radioactive isotope which, when injected into a biological or physical system, can be traced by radiation detection devices, permitting determination of the distribution or location of the substance to which it is attached.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traceur radioactif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trazador radiactivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktiver Tracer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve merkstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивный изотоп</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изотоп, путь которого при попадании в биологическую или физическую систему может быть прослежен с помощью специальных радиационных датчиков, позволяющих определить распределение или местоположение вещества, к которому этот изотоп был прикреплен.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقتفي الإشعاعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5057" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6920">
    <skos:prefLabel xml:lang="en">radioactive tracer technique</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">technique du traceur radioactif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">técnica de traza radiactiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktive Tracermethode</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">opsporingstechniek voor radioactieve straling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технология применения радиоактивного изотопа</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تقنية مقتفي الأثر الإشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5354" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6921">
    <skos:prefLabel xml:lang="en">radioactive waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any waste that emit radiation in excess of normal background level, including the toxic by-products of the nuclear energy industry.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchet radioactif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">residuos radiactivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktiver Abfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactief afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивные отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, испускающие радиоактивное излучение, превышающее фоновый уровень, включая токсичные попутные продукты ядерной энергетики.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نفايات مشعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6909" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7981" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10711">
    <skos:prefLabel xml:lang="en">coppice with standards</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A traditional system of woodland management whereby timber trees are grown above a coppiced woodland. It is used in particular as a method of exploiting oakwoods, in which all the trees except a rather open network of tall, well-formed oaks - the standards at about fifty per hectare - are felled, leaving plenty of space for hazels and other underwood to grow and be coppiced at intervals of ten to fifteen years.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taillis sous futaie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">monte bajo con estándares</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mittelwald</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">middenbos</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выращивание подлеска</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Традиционная практика лесоводства, при которой строительный лес выращивается одновременно с подлеском. Распространена при эксплуатации дубовых лесов, когда все деревья за исключением определенного количества высоких, сформировавшихся дубов - приблизительно пятьдесят деревьев на гектар - вырубаются, оставляя свободное пространство для роста орешника и другого подлеска, который через десять-пятнадцать лет будет вырублен.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أيكة ذات شجيرات عالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1793" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6925">
    <skos:prefLabel xml:lang="en">radioactivity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The property possessed by some atomic nuclei of disintegrating spontaneously, with loss of energy through emission of a charged particle and/or gamma radiation.
(Source: BRACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">radioactivité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radiactividad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radioaktivität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactiviteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радиоактивность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойство, которым обладают некоторые атомные ядра, состоящее в спонтанном распаде с выделением энергии в виде потока заряженных частиц и/или гамма-излучения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشاط إشعاعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5518" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6928">
    <skos:prefLabel xml:lang="en">radionuclide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A nuclide that exhibits radioactivity.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">radionucléide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radionúclido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radionuklid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radionucleïde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радионуклид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нуклид, обладающий радиоактивностью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نويدة مشعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12004" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4523" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4868">
    <skos:prefLabel xml:lang="en">living space</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any room, structure or area used as a residence and associated with subsistence activities, including sleeping, relaxing or eating.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espace vital</skos:prefLabel>
    <skos:prefLabel xml:lang="es">espacio vital</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebensraum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leefruimte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жизненное пространство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Помещение, сооружение или участок, используемые для проживания и связанные с условиями для поддержания жизненной активности, таких как сон, отдых или питание.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مساحة المعيشة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7825" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6935">
    <skos:prefLabel xml:lang="en">radon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A radioactive gaseous element emitted naturally from rocks and minerals where radioactive elements are present. It is released in non-coal mines, e.g. tin, iron, fluorspar, uranium. Radon is an alpha particle emitter as are its decay products and has been indicted as a cause of excessive occurrence of lung cancer in uranium miners. Concern has been expressed at radon levels in some housing usually adjacent to granite rocks or old tin mining regions.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">radon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radon</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radon</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radon</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">радон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Радиоактивный газообразный элемент, испускаемый в естественных условиях горными породами и минералами, содержащими радиоактивные элементы. Образуется в неугольных рудниках, например, при добыче олова, железа, плавикового шпата, урана. Радон испускает альфа-частицы и считается причиной повышенной заболеваемости раком легких у шахтеров. Вызывает озабоченность повышенный уровень радона в жилых кварталах, расположенных в непосредственной близости от природных гранитных массивов или старых рудников, где добывалось олово.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الرادون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2635" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12004" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6937">
    <skos:prefLabel xml:lang="en">rag</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discarded textile waste, either post-consumer waste or pre-consumer waste, such as manufacturing process scraps.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chiffon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trapo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Alttextilien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lomp</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тряпка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Текстильный вид отходов, использованный бытовой материал либо промышленный материал, как, например, обтирочные концы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خرقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6939">
    <skos:prefLabel xml:lang="en">railroad vehicle</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">véhicule ferroviaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vehículo ferroviario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schienenfahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spoorvoertuig</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">железнодорожное транспортное средство</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">عربة سكة حديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4897" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8606" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8760" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6940">
    <skos:prefLabel xml:lang="en">rail traffic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The movement and circulation of vehicles transporting goods and people on railroad systems.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic ferroviaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico ferroviario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schienenverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spoorverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">движение железнодорожного транспорта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение и циркуляция железнодорожного транспорта, перевозящего товары и пассажиров по системе железных дорог.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حركة القطارات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6047" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6942" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11276" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6941">
    <skos:prefLabel xml:lang="en">rail transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transportation of goods and persons by railway.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport ferroviaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte ferroviario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisenbahntransport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spoorvervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">железнодорожный транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перевозка грузов и пассажиров по железным дорогам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل بالسكك الحديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4676" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6942">
    <skos:prefLabel xml:lang="en">railway</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A permanent track composed of a line of parallel metal rails fixed to sleepers, for transport of passengers and goods in trains.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">voie ferrée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ferrocarriles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisenbahn</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spoorweg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">железная дорога</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Железнодорожное полотно, состоящее из параллельно положенных рельсов, закрепленных на шпалах; используется для перевозки пассажиров и товаров железнодорожным транспортом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سكة حديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11276" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3955" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14581" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6940" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6947">
    <skos:prefLabel xml:lang="en">rain</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Precipitation in the form of liquid water drops with diameters greater than 0.5 millimeter.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pluie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lluvia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Regen (Niederschlag)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">regen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дождь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Осадки в виде водяных капель диаметром свыше 0,5 мм.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مطر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/637" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6949">
    <skos:prefLabel xml:lang="en">rain forest</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A forest of broad-leaved, mainly evergreen, trees found in continually moist climates in the tropics, subtropics, and some parts of the temperate zones.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">forêt pluviale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bosque húmedo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Regenwald</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">regenwoud</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дождевой лес</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лес, состоящий из широколиственных, главным образом, вечнозеленых, деревьев во влажных тропиках, субтропиках, а также отдельных регионах умеренных зон.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غابة مطيرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3406" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8688" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6950">
    <skos:prefLabel xml:lang="en">rainout</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Process by which particles in the atmosphere act as centres round which water can form drops which then falls as rain.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">piégeage de particules par des gouttes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suspensión a causa de la lluvia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rainout</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fixatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выпадение дождя</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого частицы в атмосфере выполняют роль центров образования водяных капель, которые выпадают на землю в виде дождя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مطر من تكثف الماء حول جزيئات الجو</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/636" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6951">
    <skos:prefLabel xml:lang="en">rain water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water which falls as rain from clouds.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau pluviale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas pluviales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Niederschlagswasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">regenwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дождевая вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, выпадаемая из облаков в виде дождя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه الأمطار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3485" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6953">
    <skos:prefLabel xml:lang="en">raising a site</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The building up of land by the deposition of allochthonous material, such as rocks, gravel, etc.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surélever un site</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elevación de un sitio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aufschüttung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">een plaats ophogen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">повышение уровня участка земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Повышение уровня земли за счет отложения аллохтонных материалов, например, камней, гравия и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إقامة موقع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9157">
    <skos:prefLabel xml:lang="en">water collection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The catching of water, especially rain water, in a structure such as a basin or reservoir.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">captage d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">captación de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wassergewinnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterwinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сбор воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сбор воды, особенно дождевой, в какую-либо конструкцию, например, бассейн или резервуар.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جمع المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3890">
    <skos:prefLabel xml:lang="en">heat (physics)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A form of energy that is transferred by a difference in temperature: it is equal to the total kinetic energy of the atoms or molecules of a system.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chaleur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wärme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">warmte (fysica)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тепло (физ.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Форма энергии, передаваемая через разницу температур, равна общей кинетической энергии атомов и молекул в системе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حرارة (فيزياء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1556" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6959">
    <skos:prefLabel xml:lang="en">random test</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Tests which do not always yield the same result when repeated under the same conditions.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">test aléatoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prueba aleatoria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stichprobe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">steekproef</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разовое испытание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Испытания, которые не обязательно приводят к одинаковым результатам, даже если проводятся при неизменных условиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار عشوائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8412" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9352">
    <skos:prefLabel xml:lang="en">woodland clearance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The permanent clear-felling of an area of forest or woodland. On steep slopes this can lead to severe soil erosion, especially where heavy seasonal rains or the melting of snow at higher levels cause sudden heavy flows of water. In the humid tropics it may also lead to a release of carbon dioxide from the soil.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déboisement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">claro del bosque</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auslichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kappen van een bos</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рубка леса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вырубка лесного участка. На крутых склонах это может привести к сильной почвенной эрозии, особенно когда сильные сезонные дожди или таящие снега на более высоких уровнях образуют внезапные и широкие потоки воды. В жарких тропиках это также может привести к выделению углекислого газа из почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قطع الأشجار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2036" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6962">
    <skos:prefLabel xml:lang="en">rape (plant)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A Eurasian cruciferous plant, Brassica napus, that is cultivated for its seeds, which yield a useful oil, and as a fodder plant.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">colza</skos:prefLabel>
    <skos:prefLabel xml:lang="es">colza (planta)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Raps</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">raap(zaad)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рапс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Евроазиатское растение семейства крестоцветных, Brassica napus, которое разводят из-за того, что его семена являются источником масла, а сам рапс является также фуражной культурой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السلجم - اللفت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3313" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6963">
    <skos:prefLabel xml:lang="en">rapid transit train</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">train interurbain rapide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tren rápido de tránsito</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schnellbahn</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadstrein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">скоростной поезд, следующий транзитом</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">قطار محافظات سريع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8606" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6965">
    <skos:prefLabel xml:lang="en">rare species</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Species which have a restricted world range.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèce rare</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies raras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Seltene Art</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeldzame soorten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">редкие виды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Виды, которые имеют ограниченное распространение в мире.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنواع نادرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1221" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6967">
    <skos:prefLabel xml:lang="en">raw material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A crude, unprocessed or partially processed material used as feedstock for a processing operation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matière première</skos:prefLabel>
    <skos:prefLabel xml:lang="es">materias primas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rohstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сырье</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сырой, необработанный или частично обработанный материал, используемый в качестве исходного продукта в обрабатывающей операции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة خام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5086" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5503" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5887" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6161" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7084" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7413" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6968">
    <skos:prefLabel xml:lang="en">raw material consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The developed countries depend on a stable supply of raw materials for their industries. Total resource requirements are increasing rapidly over the entire world. In developed countries, although population is increasing slowly, per capita use is increasing rapidly, while the opposite is happening in developing countries. Traditionally raw materials have been classified as non-renewable resources, but a distinction may be important between "loosable" resources, such as oil and coal, and "non-loosable" resources, such as metals, which can be used several times over by recycling processes.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">consommation de matières premières</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consumo de materia prima</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rohstoffverbrauch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondstofverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребление сырья</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Промышленность развитых стран сильно зависит от постоянных поставок сырьевых материалов. Спрос на сырье растет во всем мире. В развитых странах, несмотря на низкий прирост населения, потребление сырья на душу населения растет очень быстрыми темпами, а в развивающихся странах наблюдается обратная картина. Традиционно сырье считается невозобновляемым ресурсом, однако различают "расходуемые" и "нерасходуемые" виды природных ресурсов, например, нефть или уголь являются "расходуемыми", а железо "нерасходуемым", потому что может быть использовано неоднократно в результате процессов утилизации и вторичного использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استهلاك المواد الخام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7172" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3892">
    <skos:prefLabel xml:lang="en">heater</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An apparatus that heats or provides heat.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">appareil de chauffage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calentador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Heizgerät</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verwarmingstoestel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нагревательный прибор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прибор, который производит тепло.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سخان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13225" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3894" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6970">
    <skos:prefLabel xml:lang="en">raw material securing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures used to ensure the provision of or the access to crude, unprocessed or partially processed materials used as feedstock for processing or manufacturing.
(Source: RHWa /  MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection des matières premières</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procura de materia prima</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rohstoffsicherung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zich verzekeren van grondstoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обеспеченность сырьем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Меры, принимаемые для обеспечения поставок или доступа к сырым, необработанным или частично обработанным материалам, используемым в качестве исходного сырья для производственных или обрабатывающих процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تأمين المواد الخام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6975">
    <skos:prefLabel xml:lang="en">reaction kinetics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That branch of physical chemistry concerned with the mechanisms and rates of chemical reactions.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cinétique des réactions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reación cinética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reaktionskinetik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reactiekinetiek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кинетика химических реакций</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль физической химии, изучающая механизмы и скорость химических реакций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حركية التفاعلات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6977">
    <skos:prefLabel xml:lang="en">reactor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A device that introduces either inductive or capacitive reactance into a circuit, such as a coil or capacitor.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réacteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reactor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reaktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reactor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">реактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устройство, которое добавляет индуктивную или емкостную реактивность в систему, например, соленоид или конденсатор.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مفاعل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5742" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6978">
    <skos:prefLabel xml:lang="en">reactor safety</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Those studies and activities that seek to minimise the risk of a nuclear reactor accident.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sûreté des réacteurs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">seguridad de reactor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reaktorsicherheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reactorveiligheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">безопасность реактора</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Научные изыскания и деятельность, направленные на минимизацию риска аварии ядерного реактора.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أمن المفاعلات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5742" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12764" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6979">
    <skos:prefLabel xml:lang="en">reforestation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The planting of trees in forest areas which have been cleared. Reforestation has become increasingly important for preventing or reversing environmental degradation and for helping to maximize economic returns on commercially forested lands.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">reboisement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">repoblación forestal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wiederaufforstung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">herbebossing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лесовосстановление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высадка деревьев в вырубленных лесных районах. Лесовосстановление становится исключительно важной мерой противостояния или предупреждения деградации окружающей среды, а также способствующее максимизировать экономические выгоды от коммерческого лесоводства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعادة التشجير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/167" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6982">
    <skos:prefLabel xml:lang="en">reasonableness</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">acceptabilité (par le voisinage)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carácter razonable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zumutbarkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">redelijkheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разумность</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">معقولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1419" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2529">
    <skos:prefLabel xml:lang="en">ecotoxicological evaluation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Evaluation of the adverse effects of chemicals, physical agents, and natural products on population and communities and plants, animals and human beings.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation écotoxicologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación ecotoxicológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökotoxikologische Bewertung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecotoxicologische evaluatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экотоксикологическая оценка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка отрицательного воздействия химических веществ, физических факторов, природных продуктов на популяции и сообщества растений, животных и человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم السمية الإيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8541" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9356">
    <skos:prefLabel xml:lang="en">wood preservation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of chemicals to prevent or retard the decay of wood, especially by fungi or insects; widely used preservatives include creosote, pitch, sodium fluoride and tar; especially used on wood having contact with the ground.
(Source: HARRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">conservation du bois</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conservación de maderas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Holzschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">houtbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сохранение древесины</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование химикатов для предотвращения или замедления разрушения древесины, особенно под действием грибов или насекомых; к распространенным консервантам древесины относят креозот, вар, фторид натрия и деготь; применяют чаще всего к древесине, имеющей контакт с земной поверхностью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحفاظ على الغابات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6988">
    <skos:prefLabel xml:lang="en">recombinant DNA technology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Techniques and practical applications associated with recombinant DNA (deoxyribonucleic acid artificially introduced into a cell that alters the genotype and phenotype of the cell and is replicated along with the natural DNA).
(Source: DELFIN /  KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technologie de l'ADN recombinant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tecnología de DNA recombinante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">DNS-Rekombinationstechnik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">recombinante DNA technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технология на основе рекомбинантной ДНК</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Технологии и практика, связанные с применением рекомбинантной ДНК (искусственно введенная в состав клетки дезоксирибонуклеиновая кислота изменяет генотип и фенотип клетки и воспроизводится одновременно с ДНК).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكنولوجيا إعادة اتحاد الحمض النووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3624" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6989">
    <skos:prefLabel xml:lang="en">recommendation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Recommendation refers to an action which is advisory in nature rather than one having any binding effect.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">recommandation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recomendaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Empfehlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aanbeveling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рекомендация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рекомендация относится к действию, носящему консультативный, а не обязательный характер.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توصية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6992">
    <skos:prefLabel xml:lang="en">recording of substances</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">répertorier les substances</skos:prefLabel>
    <skos:prefLabel xml:lang="es">grabación de sustancias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stoffverzeichnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">registratie van stoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">учет веществ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تسجيل المواد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6997">
    <skos:prefLabel xml:lang="en">recovery of landscape</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Reclamation measures taken to restore the environmental quality level of a landscape to its predisturbed condition.
(Source: AQDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rétablissement du paysage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recuperación del paisaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landschaftsrückgewinnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landschapsherstel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">восстановление ландшафта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мелиоративные работы, предпринятые для восстановления экологического качества ландшафта до уровня, предшествовавшего его нарушению.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استصلاح المنظر الطبيعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6999">
    <skos:prefLabel xml:lang="en">fauna restoration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of returning wildlife ecosystems and habitats to their original conditions.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">restauration de la vie sauvage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recuperación de la fauna</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wiederherstellung der natürlichen Pflanzen- und Tierwelt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">herstel van in het wild levende planten en dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">восстановление фауны</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс возвращения экосистемы дикой природы и природные условия к их первоначальному состоянию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استعادة الفونا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7093" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7000">
    <skos:prefLabel xml:lang="en">recovery plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A formulated or systematic method for the restoration of natural resources or the reuse of materials and objects.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stratégie de recyclage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planes de recuperación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rückgewinnungsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">herstelplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план восстановления природных ресурсов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сформулированный, системный метод восстановления природных ресурсов или вторичного использования материалов и предметов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة الاسترداد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7001">
    <skos:prefLabel xml:lang="en">recreation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Activities that promote refreshment of health or spirits by relaxation and enjoyment.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">récréation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actividades recreativas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erholung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontspanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отдых</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, способствующая поддержанию здоровья и хорошего настроения в результате расслабления и развлечений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترويح</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4767" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4771" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8008" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2838" />
