  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9178">
    <skos:prefLabel xml:lang="en">water for consumption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Consumptive water use starts with withdrawal, but in this case without any return, e.g. irrigation, steam escaping into the atmosphere, water contained in final products, i.e. it is no longer available directly for subsequent use.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau propre à la consommation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua para consumo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebrauchswasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">water voor (menselijk) gebruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">израсходованная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Расходование воды начинается при ее заборе, однако в этом случае подразумевается, что она не возвращается обратно, как, например, при ирригации, испарении воды в атмосферу, переходе воды в конечный продукт, т.е. в случаях, когда вода не доступна для повторного использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه صالحة للاستهلاك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
