    <dct:title xml:lang="en">Man-made Object</dct:title>
    <skos:prefLabel xml:lang="en">Man-made Object</skos:prefLabel>
    <dct:description xml:lang="en">An artificial object which lies inside a body of water and has one of the following types of function: - Retains the water; - Regulates the quantity of water; - Alters the course of the water; - Allows watercourses to cross each other.</dct:description>
    <skos:definition xml:lang="en">An artificial object which lies inside a body of water and has one of the following types of function: - Retains the water; - Regulates the quantity of water; - Alters the course of the water; - Allows watercourses to cross each other.</skos:definition>
