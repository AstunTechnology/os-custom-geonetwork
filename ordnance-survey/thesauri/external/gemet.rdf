    <skos:prefLabel xml:lang="fr">produit agricole transformé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos agrarios transformados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Verarbeitungserzeugnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verwerkt landbouwproduct</skos:prefLabel>
