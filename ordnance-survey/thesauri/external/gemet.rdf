  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2758">
    <skos:prefLabel xml:lang="en">enriched uranium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Uranium whose concentration of uranium-235, which is able to sustain a nuclear chain reaction, is increased by removing uranium-238.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">uranium enrichi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">uranio enriquecido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Angereichertes Uran</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verrijkt uranium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обогащенный уран</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Урановый материал, в котором концентрация урана-235, способного поддерживать ядерную реакцию, повышается за счет удаления урана-238.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اليورانيوم المخصب</skos:prefLabel>
