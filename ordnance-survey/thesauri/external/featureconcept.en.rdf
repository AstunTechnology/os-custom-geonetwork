    <dct:title xml:lang="en">Road Node</dct:title>
    <skos:prefLabel xml:lang="en">Road Node</skos:prefLabel>
    <dct:description xml:lang="en">A point spatial object that is used to either represent connectivity between two road links or to represent a significant spatial object such as a services station or roundabout.</dct:description>
    <skos:definition xml:lang="en">A point spatial object that is used to either represent connectivity between two road links or to represent a significant spatial object such as a services station or roundabout.</skos:definition>
