  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9051">
    <skos:prefLabel xml:lang="en">type of waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A grouping by type of unusable material left over from any process.
(Source: ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">catégorie de déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">categoría de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallart</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalcategorie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тип отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группирование неиспользуемых материалов, оставшихся в ходе какого-либо процесса, по их типу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوعية النفايات</skos:prefLabel>
