  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4913">
    <skos:prefLabel xml:lang="en">lorry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large motor vehicle designed to carry heavy loads, especially one with a flat platform.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">camion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">camiones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lastkraftwagen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrachtwagen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">грузовой автомобиль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Крупный автомобиль, приспособленный для перевозки тяжелых грузов, особенно автомобиль, оборудованный плоской платформой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">لوري - شاحنة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5390" />
