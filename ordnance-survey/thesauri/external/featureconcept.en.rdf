    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:43 PM CEST</dct:created>
    <dct:title xml:lang="en">Soil Horizon</dct:title>
    <skos:prefLabel xml:lang="en">Soil Horizon</skos:prefLabel>
    <dct:description xml:lang="en">Domain of a soil with a certain vertical extension, more or less parallel to the surface and homogeneous for most morphological and analytical characteristics, developed in a parent material layer through pedogenic processes or made up of in-situ sedimented organic residues of up-growing plants (peat).</dct:description>
    <skos:definition xml:lang="en">Domain of a soil with a certain vertical extension, more or less parallel to the surface and homogeneous for most morphological and analytical characteristics, developed in a parent material layer through pedogenic processes or made up of in-situ sedimented organic residues of up-growing plants (peat).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/so" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
