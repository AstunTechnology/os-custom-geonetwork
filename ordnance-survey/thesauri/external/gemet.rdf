    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10044">
    <skos:prefLabel xml:lang="en">plant production</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">production végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenproduktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantenopbrengst</skos:prefLabel>
