  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/79">
    <skos:prefLabel xml:lang="en">act</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Something done voluntarily by a person, and of such a nature that certain legal consequences attach to it.
2) Documents, decrees, edicts, laws, judgments, etc.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acte législatif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">akten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">акт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Добровольное действие лица, связанное с определенными юридическими последствиями. 2) Документ, декрет, закон, решение и т.д.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فعل (قانوني)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4707" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8272">
    <skos:prefLabel xml:lang="en">synthetic material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Material made artificially by chemical reaction.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matière synthétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material sintético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kunststoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kunststof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">синтетический материал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, изготовленный искусственно в ходе химической реакции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مواد مركبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7161" />
