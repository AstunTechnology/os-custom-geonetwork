  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5728">
    <skos:prefLabel xml:lang="en">nuclear fusion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Combination of two light nuclei to form a heavier nucleus with release of some binding energy.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fusion nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fusión nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernfusion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kernfusie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерный синтез</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение двух легких ядер с образованием более тяжелого ядра и выделением связующей энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انصهار نووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5741" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13921">
    <skos:prefLabel xml:lang="en">deciduous wood</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">arbre à feuilles caduques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">madera perecedera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Laubholz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">loofverliezend bos</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">древесина лиственных пород</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">شجر متساقط الأوراق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9349" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
