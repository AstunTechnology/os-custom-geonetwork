  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14330">
    <skos:prefLabel xml:lang="en">teratogenic substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substances capable of causing abnormal development of the embryo and congenital malformations.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance teratogène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancia teratogénica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teratogener Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">teratogene stoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тератогенное вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, способные вызвать ненормальное развитие эмбриона и врожденные уродства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة ماسِخة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6724" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
