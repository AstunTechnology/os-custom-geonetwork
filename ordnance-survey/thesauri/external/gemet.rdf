    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9078">
    <skos:prefLabel xml:lang="en">waste gas emission</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The direct or indirect discharge of exhaust gas into the atmosphere.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">émission d'effluents gazeux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">emisión de gas de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgasemission</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitstoot van (uitlaat)gassen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброс отходящего газа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прямой или косвенный выброс отходящего газа в атмосферу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انبعاثات الغاز المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2663" />
