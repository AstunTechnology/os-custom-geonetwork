    <skos:prefLabel xml:lang="de">Altmedikament</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgedankt geneeskrachtig medicijn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброшенный медицинский препарат</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">دواء مستبعد</skos:prefLabel>
