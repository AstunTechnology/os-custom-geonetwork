  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5931">
    <skos:prefLabel xml:lang="en">organophosphorous compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pesticides that contain phosphorous; short-lived, but some can be toxic when first applied.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organophosphoré</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos órganofosforados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Phosphorverbindungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische fosforverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фосфорорганическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пестициды, содержащие фосфор; быстро распадаются, но некоторые виды могут быть очень токсичными при первом применении.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب فوسفوري عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5927" />
