  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13102">
    <skos:prefLabel xml:lang="en">land management and planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Operations for preparing and controlling the implementation of plans for organizing human activities on land.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aménagement du territoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión y planificación de tierra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Raumordnung und -planung</skos:prefLabel>
