    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:43 PM CEST</dct:created>
    <dct:title xml:lang="en">ResponsibleAgency</dct:title>
    <skos:prefLabel xml:lang="en">ResponsibleAgency</skos:prefLabel>
    <dct:description xml:lang="en">The agency, organisation or body responsible for selecting, describing and designating the protected site.</dct:description>
    <skos:definition xml:lang="en">The agency, organisation or body responsible for selecting, describing and designating the protected site.</skos:definition>
    <vann:usageNote xml:lang="en">NOTE Responsibility for establishing a protected site  allows all interested parties to know who to liaise with over queries or requests for more detailed information on each Area. The responsible body will vary according to the basis of establishment with national governments ultimately responsible for Natura2000 sites, down to voluntary bodies responsible for local designations or quasi-legislative protected sites.</vann:usageNote>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/ps" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
