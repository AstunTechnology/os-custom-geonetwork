    <skos:prefLabel xml:lang="en">cartography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The making of maps and charts for the purpose of visualizing spatial distributions over various areas of the earth.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cartographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cartografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kartographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kartografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">картография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изготовление карт и графиков с целью изображения пространственного распределение отдельных участков земной поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الخرائط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3646" />
