  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2979">
    <skos:prefLabel xml:lang="en">ether</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A colorless liquid, slightly soluble in water; used as a reagent, intermediate, anesthetic, and solvent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éther</skos:prefLabel>
    <skos:prefLabel xml:lang="es">éter</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ether</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ether</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эфир</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бесцветная жидкость, слабо растворимая в воде, используемая как реагент, промежуточное соединение, анестезирующее вещество или растворитель.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإيثير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5929" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2980">
    <skos:prefLabel xml:lang="en">ethics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The philosophical study of the moral value of human conduct and of the rules and principles that ought to govern it.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éthique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ethik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ethiek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">этика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Философское изучение моральной стороны человеческого поведения, а также правил и принципов, которые должны им руководить.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الأخلاق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/830" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2818" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10054">
    <skos:prefLabel xml:lang="en">safety system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A unified, coordinated assemblage or plan of procedures and devices intended to lower the occurrence or risk of injury, loss and danger to persons, property or the environment.
(Source: OED / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système de sécurité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de seguridad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sicherheitssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beveiligingsstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система безопасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Унифицированный, скоординированный план процедур и устройств, предназначенных снизить вероятность риска или нанесения ущерба, потерь или опасности людям, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام أمان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7362" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6753" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9035" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10106" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2982">
    <skos:prefLabel xml:lang="en">ethnology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science that deals with the study of the origin, distribution, and relations of races or ethnic groups of mankind.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ethnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">etnología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ethnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">volkenkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">этнология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая происхождение, распределение и взаимоотношения между расами или этническими группами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الأعراق - علم الإثنيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10019" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2984">
    <skos:prefLabel xml:lang="en">ethology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of animal behaviour in a natural context.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éthologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">etología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ethologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ethologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">этология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение поведения животных в естественной среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الإيثولوجيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13318" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11177">
    <skos:prefLabel xml:lang="en">forage crop</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cultivation of crops for consumption by livestock.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture fourragère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plantas forrajeras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Futterpflanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedergewas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фуражная культура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растительный корм для скота.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة الأعلاف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13207" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13209" />
