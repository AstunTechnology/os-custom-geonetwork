  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11204">
    <skos:prefLabel xml:lang="en">draining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removal of water from a marshy area by artificial means, e.g. the introduction of drains.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">assèchement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">drenaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entwässern</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwateren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">осушение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление воды с заболоченных участков искусственными средствами, например, с помощью прокладки дренажных труб.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجفيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3013">
    <skos:prefLabel xml:lang="en">evaluation method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode d'évaluation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método de evaluación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewertungsverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">evaluatiemethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод оценки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسلوب التقييم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3011" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4451" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11206">
    <skos:prefLabel xml:lang="en">slash and burn culture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A traditional farming system that has been used by generations of farmers in tropical forests and the savannah of north and east Africa. It is known to be an ecologically sound form of cultivation, and because the soil is poor in tropical rain forests it is a sustainable method of farming. It is still practised today, primarily in the developing countries. Small areas of bush or forests are cleared and the smaller trees burned. This unlocks the nutrients in the vegetation and gives the soil fertilizer that is easily taken up by plants. A few years later the soil is degraded and the farmer moves on to do the same at another site. The original ground is left fallow for anything up to 20 years so that the forest can regenerate. With the growth in population and in the subsequent need for more farming land to produce food, the method is increasingly being used today to clear large areas of tropical forests for cattle ranching, and in most cases the ground is not left fallow for long enough and, with modern mechanized farming systems, not enough tree stumps or suitable habitats for plant life are left to start the regeneration process.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture sur brûlis</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultivo sobre chamizado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Roden und Verbrennen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwerflandbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вырубка и сжигание леса как метод увеличения сельскохозяйственных площадей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Традиционная сельскохозяйственная практика, используемая многими поколениями фермеров в зоне тропических лесов и саванны в Северной и Восточной Африке. Считается экологически безопасной формой культивации земли. Особенно распространена в развивающихся странах. Небольшие участки, покрытые кустарником или лесом, расчищаются, невысокие деревья сжигаются. Через некоторое время плодородие почвы на этом участке падает, и фермер расчищает новый участок, оставляя старый под паром лет на 20, что обеспечивает возможность восстановления леса. С ростом населения и возрастающими потребностями в новых сельскохозяйственных площадях и увеличении объемов производства продуктов питания данный метод обработки земли используется все более широко. Значительно сокращаются сроки нахождения земель под паром, а современные технологии не оставляют на расчищаемых участках достаточного количества пней или других условий, необходимых для восстановления растительной жизни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة القطع والحرق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13207" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1769" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11207">
    <skos:prefLabel xml:lang="en">chalk</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A soft, pure, earthy, fine-textured, usually white to light gray or buff limestone of marine origin, consisting almost wholly (90-99%) of calcite, formed mainly by shallow-water accumulation of calcareous tests of floating microorganisms (chiefly foraminifers) and of comminuted remains of calcareous algae (such as cocoliths and rhabdoliths), set in a structureless matrix of very finely crystalline calcite. The rock is porous, somewhat friable, and only slightly coherent. It may include the remains of bottom-dwelling forms (e.g. ammonites, echinoderms, and pelecypods), and nodules of chert and pyrite. The best known and most widespread chalks are of Cretaceous age, such as those exposed in cliffs on both sides of the English Channel.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">craie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">yeso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kreide</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">krijt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мел</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мягкий, чистый, землистый, мелкозернистый известняк, как правило, белого, серого или желтоватого цвета морского происхождения; практически целиком состоит из кальцита (90-99%), образованного накоплением известковых остатков от плавающих микроорганизмов (фораминифер) и водорослей (например, кокколитов и рабдолитов). Порода пористая, иногда крошащаяся, может включать остатки глубоководных видов (аммониты, иглокожие,), а также вкрапления пирита и сланцев. Наиболее известные месторождения мела находятся в скальных породах по обе стороны пролива Ла-Манш, берега которого образовались в меловой период.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طباشير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5675" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5510" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11209">
    <skos:prefLabel xml:lang="en">nitrogenous fertiliser</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Fertilizer materials, natural or synthesized, containing nitrogen available for fixation by vegetation, such as potassium nitrate or ammonium nitrate.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">engrais azote</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fertilizante nitrogenado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stickstoffdünger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stikstofmest(stof)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">азотное удобрение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удобрения природного или искусственного происхождения, содержащие азот в форме, доступной для поглощения растениями, например, нитрат калия или нитрат аммония.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سماد نيتروجيني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4345" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8695">
    <skos:prefLabel xml:lang="en">troposphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The lowest of the concentric layers of the atmosphere, occurring between the Earth's surface and the tropopause. It is the zone where atmospheric turbulence is at its greatest and where the bulk of the Earth's weather is generated. It contains almost all the water vapour and aerosols and three-quarters of the total gaseous mass of the atmosphere. Throughout the troposphere temperature decreases with height at a mean rate of 6.5°C/km and the whole zone is capped by either an inversion of temperature or an isothermal layer at the tropopause.
(Source: WHIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">troposphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">troposfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Troposphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">troposfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тропосфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Самый низкий из слоев атмосферы, расположенный между земной поверхностью и тропопаузой. В этой зоне наиболее интенсивны турбуленции атмосферы и здесь проходят все процессы, влияющие на погоду на Земле. В тропосфере содержится практически весь объем водяных паров, аэрозолей, а также три четверти всей газовой массы атмосферы. В тропосфере понижение температуры происходит в среднем на 6,5 градусов С/км, а сама тропосфера ограничена либо температурной инверсией либо изотермальным слоем тропопаузы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التروبوسفير - الطبقة السفلى من الغلاف الجوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11212">
    <skos:prefLabel xml:lang="en">potassium fertiliser</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical fertilizer containing potassium. Potassium (K) is required by all plant and animal life. Plants require potassium for photosynthesis, osmotic regulation and the activation of enzyme systems.
(Source: AGRIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">engrais potassique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fertilizante de potasio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kalidünger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">messtof met kalium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">калийное удобрение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое удобрение, содержащее калий. Калий (К) необходим всем растениям и животным. Растениям калий нужен для фотосинтеза, осмотического регулирования и поддержания ферментных систем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سماد البوتاسيوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4345" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3022">
    <skos:prefLabel xml:lang="en">evapotranspiration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discharge of water from the earth's surface to the atmosphere by evaporation from lakes, streams and soil surfaces and by transpiration from plants. Also known as fly-off.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évapotranspiration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evapotranspiración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Evapotranspiration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verdamping(stranspiratie)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">испарение воды в атмосферу</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Попадание воды в атмосферу в результате испарения с поверхности озер, рек и почвы, а также в ходе растительной транспирации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النتح التبخُّري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10043" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/290" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5965">
    <skos:prefLabel xml:lang="en">overpopulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A population density that exceeds the capacity of the environment to supply the health requirements of the individual organism.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surpopulation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">superpoblación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Übervölkerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overbevolking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">перенаселенность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Плотность населения, превышающая способность окружающей среды обеспечивать требования здоровья и гигиены отдельного организма.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الزيادة الهائلة في عدد السكان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2055" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5957" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/504">
    <skos:prefLabel xml:lang="en">aquatic ecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the relationships among aquatic living organisms and between those organisms and their environment.
(Source: ALLa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">hydro-écologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología acuática</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecologie van het water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экология водной среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение взаимоотношений между живыми водными организмами, а также отношений между этими организмами и окружающей их средой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإيكولوجيا المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3026">
    <skos:prefLabel xml:lang="en">evolution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The biological theory or process whereby species of plants and animals change with the passage of time so that their descendants differ from their ancestors, i.e. development from earlier forms by hereditary transmission of slight variations in successive generations.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évolution</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evolución</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Evolution</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">evolutie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эволюция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Биологическая теория или процесс, в ходе которого виды растений и животных изменяются со временем таким образом, что потомки отличаются от предшественников, т.е. развитие от более ранних форм посредством наследственной передачи незначительных изменений в последующих поколениях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التطور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/892" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3460" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3027">
    <skos:prefLabel xml:lang="en">exact science</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Mathematics and other sciences based on calculation.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">science exacte</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciencias exactas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Exakte Wissenschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">exacte wetenschap(pen)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">точная наука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Математика и другие науки, основанные на вычислениях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العلوم البحتة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7472" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3028">
    <skos:prefLabel xml:lang="en">excavated hole</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A pit, cavity, or other uncovered cutting produced by excavation.
(Source: BJGEOa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cavité creusée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agujero excavado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Baggerloch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgraving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выкопанная яма</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Углубление, котлован или какая-либо другая незакрытая полость, полученная в результате земляных работ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجويف محفور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3032" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3029">
    <skos:prefLabel xml:lang="en">excavation (process)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removal of earth from its natural position.
(Source: HARRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">creusement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">excavación (proceso)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgrabung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgraven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">раскопки (процесс)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление земли с ее естественного местоположения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحفر (عملية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3031">
    <skos:prefLabel xml:lang="en">excavation heap</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Residue in form of a heap, consisting of earth or other material, produced by excavation.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tas de déblai</skos:prefLabel>
    <skos:prefLabel xml:lang="es">escombrera de excavación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgrabungshalde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgegraven grond</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отвал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы в виде кучи, состоящей из земли или другого материала, полученного в процессе земляных работ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ركام الحفر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1059" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3032">
    <skos:prefLabel xml:lang="en">excavation site</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The location chosen for an excavation, meaning the act or process of removing soil and/or rock materials by digging, blasting, breaking, loading either at the surface or underground.
(Source: BJGEOa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">terrain de déblayement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sitio de excavación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgrabung (Ort)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgravingplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">площадка для земляных работ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, выбранное для проведения земляных работ, предполагающих действие или процесс по удалению земли и/или твердых материалов в ходе рытья, взрывов, разрушения пород и накопления удаляемых материалов либо под землей, либо на ее поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موقع الحفر أو الحفائر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5286" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3028" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9367" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3033">
    <skos:prefLabel xml:lang="en">excessive height of chimney stacks</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">hauteur excessive des cheminées d'usine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">altura excesiva de pilas de chimenea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schornsteinüberhöhung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overmatige hoogte van schoorstenen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">чрезмерная высота труб</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الارتفاع المفرط للمداخن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1356" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11226">
    <skos:prefLabel xml:lang="en">mineral matter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Inorganic materials having a distinct chemical composition, characteristic crystalline structure, colour, and hardness.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matière minérale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">materia mineral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mineralstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anorganische stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">минеральное вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неорганические материалы, имеющие определенный химический состав, характерную кристаллическую структуру, цвет и твердость.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة معدنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7882" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5277" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11227">
    <skos:prefLabel xml:lang="en">organic matter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plant and animal residue that decomposes and becomes a part of the soil.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matière organique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Substanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">органическое вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растительные и животные остатки, которые разлагаются и становятся частью почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7882" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11231">
    <skos:prefLabel xml:lang="en">drainage system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A surface stream, or a body of impounded surface water, together with all other such streams and water bodies that are tributary to it and by which a region is drained. An artificial drainage system includes also surface and subsurface conduits.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau de drainage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alcantarillado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entwässerungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwateringssyteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водосборная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поверхностный водный поток или водоем вместе с другими потоками и водоемами, образующими его притоки, протекающие по территории конкретного района. Искусственная водосборная система включает также поверхностные и подповерхностные трубопроводы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام صرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2319" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5497" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11232">
    <skos:prefLabel xml:lang="en">irrigation system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system of man-made channels for supplying water to land to allow plants to grow.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau d'irrigation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de irrigación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewässerungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevloeiingssysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ирригационная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система созданных человеком каналов, обеспечивающая подачу воды к сельскохозяйственным землям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام ري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9165" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4509" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11233">
    <skos:prefLabel xml:lang="en">soil salinity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measurement of the quantity of mineral salts found in a soil. Many semi-arid and arid areas are naturally salty. By definition they are areas of substantial water deficit where evapotranspiration exceeds precipitation. Thus, whereas in humid areas there is sufficient water to percolate through the soil and to leach soluble materials from the soil and the rocks into the rivers and hence into the sea, in deserts this is not the case. Salts therefore tend to accumulate.
(Source: PHC /  GOUD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">salinité du sol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salinidad de suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Salzgehalt des Bodens</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoutgehalte van de bodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соленость почвы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Измерение количества минеральных солей, присутствующих в почве. Почвы многих засушливых и полузасушливых районов обладают природной соленостью. По определению они являются районами значительного дефицита воды, в которых испарения превышают объем выпадаемых осадков. Таким образом, если во влажных районах количество воды достаточно для того, чтобы просачиваться через почву, вымывая растворимые соли из почвы и пород в реки и моря, то в условиях пустыни такого не наблюдается. Соли здесь имеют тенденцию к накоплению.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوحة التربة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7843" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7390" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11234">
    <skos:prefLabel xml:lang="en">agronomic value</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The monetary or material worth at which buyers and sellers agree to do business for agricultural goods and services.
(Source: AGP / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">valeur agronomique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">valor agronómico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agronomischer Wert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwwaarde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цена на сельхозпродукцию</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Денежная или материальная стоимость, о которой продавцы и покупатели договариваются при осуществлении сделок с сельскохозяйственными товарами и услугами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القيمة الزراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/193" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11158" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3044">
    <skos:prefLabel xml:lang="en">exhaust device</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) A duct or pipe through which waste material is emitted.
2) A combination of components which provides for enclosed flow of exhaust gas from engine parts to the atmosphere.
(Source: AMHER /  LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dispositif d'évacuation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dispositivo de escape</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auspuffanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitlaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">труба для сброса отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Труба, через которую сбрасываются отходы. 2) Комбинация компонентов, обеспечивающая закрытый отвод потока отработанного газа от двигателя в атмосферу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جهاز خروج العادم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3045">
    <skos:prefLabel xml:lang="en">exhaust gas</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Offgas produced during combustion processes discharged directly or ultimately to the atmosphere.
(Source: LEEa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gaz d'échappement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gas de escape</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auspuffgas</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitlaatgas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выхлопной газ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отработанные газы, полученные в ходе процессов сгорания и выброшенные в атмосферу сразу или постепенно.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غاز عادم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1583" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9077" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8929" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1212" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2072" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4231" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3047">
    <skos:prefLabel xml:lang="en">existing chemical</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical products existing before 18-09-1981.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produits chimiques existant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancias químicas existentes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altstoff (ChemG)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestaande chemicalieën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">известный химикат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химический продукт, существовавший до 18.09.81.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المنتجات الكيماوية القائمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2536" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3048">
    <skos:prefLabel xml:lang="en">exotic species</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plants, animals or microorganisms which are introduced by humans into areas where they are not native. Exotics are often associated with negative ecological consequences for native species and the ecosystems.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèce exotique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies exóticas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Exot</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitheemse soorten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экзотический вид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растения, животные или микроорганизмы, которые заселяются человеком в районы, не являющиеся для них естественными. Экзотические виды часто связываются с отрицательными последствиями, которые они несут аборигенным видам и экосистемам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنواع غريبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7982" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3049">
    <skos:prefLabel xml:lang="en">expenditure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Spending by consumers, investors, or government for goods or services.
(Source: ISEP /  ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dépense</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gasto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausgabe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">besteding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">расходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Трата средств потребителями, инвесторами, государством для приобретения товаров и услуг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصروفات - نفقات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10002" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3716" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11038" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11039" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3050">
    <skos:prefLabel xml:lang="en">experiment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A test under controlled conditions that is made to demonstrate a known truth, examine the validity of a hypothesis, or determine the efficacy of something previously untried.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">expérience scientifique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">experimento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Experiment</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">experiment</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эксперимент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Опыт, проводимый при контролируемых условиях для подтверждения известного факта, выяснения правильности научной гипотезы или определения действенности чего-либо, ранее неиспробованного.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجربة علمية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/898" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3178" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4340" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4571" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7702" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8405" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11243">
    <skos:prefLabel xml:lang="en">rural management and planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The activity or process of overseeing and preparing for the future physical arrangement and condition of any agricultural or pastoral area, which may involve protecting and developing natural and human resources that affect an area's economic vitality.
(Source: RHW / NPH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion et planification rurale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación y gestión rural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ländliche Raumplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plattelandsbeheer en planning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление и планирование сельских районов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность или процесс наблюдения, подготовки будущего месторасположения и состояния сельскохозяйственной или пастбищной земли, которые могут включать охрану и развитие природных и человеческих ресурсов, влияющих на экономическое развитие данного региона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإدارة والتخطيط الريفيين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/213" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11244">
    <skos:prefLabel xml:lang="en">touristic activity management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The administration, promotion, organization and planning for the business or industry of providing information, transportation, entertainment, accommodations and other services to travelers or visitors.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aménagement touristique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de la actividad turística</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Management von Touristenaktivitäten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beheer van toeristische activiteiten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление туристической деятельностью</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление, поддержка, организация и планирование индустрии или предпринимательской деятельности, связанной с предоставлением информации, перевозками, развлечением, размещением и предоставлением других услуг туристам и путешественникам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة النشاط السياحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4985" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8522" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1874">
    <skos:prefLabel xml:lang="en">crop protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The problem of crop protection has changed dramatically since 1945. There is now a whole arsenal of chemicals with which to combat agricultural pests and diseases, but this development has itself many drawbacks. Such sophisticated techniques are available only to a minority of farmers; in most parts of the world the standard of crop protection remains abysmally low. In addition, modern crop protection methods have been criticized for relying too heavily on chemical control. Biological controls, both natural and contrived, have been neglected. In some cases involving misuse of agricultural chemicals, crops must be protected from the very measures intended for their protection. Meanwhile previously localized pests and diseases continue to spread worldwide.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection des cultures</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de cosechas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gewasbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита посевов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">С 1945 года проблема защиты посевов претерпела значительные изменения. В распоряжении специалистов имеется целый арсенал химикатов для борьбы с сельскохозяйственными вредителями и заболеваниями, однако использование этих достижений имеет ряд отрицательных последствий. Передовые сельскохозяйственные технологии доступны ограниченному числу фермеров, в то время как оснащенность большинства фермеров в мире такими средствами оставляет желать много лучшего. Кроме того, современные методы защиты посевов критикуются в силу того, что они сильно зависят от химикатов. Биологические средства, природные или искусственно созданные, неоправданно забыты. В некоторых случаях чрезмерного использования химических средств культурные посадки приходится спасать от средств, которые предназначены их защищать, в то время, как локализованные вредители или заболевания продолжают распространяться по другим регионам земного шара.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمايةالمحاصيل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6139" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6304" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6310" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11187" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3054">
    <skos:prefLabel xml:lang="en">expert system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A computer configuration of hardware and software that simulates the judgment and behavior of a human or an organization with extensive knowledge in a particular field, often by giving answers, solutions or diagnoses.
(Source: RHW / WIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système expert</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema experto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Expertensystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">expertensysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспертная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Компьютерная программа, которая может предложить разумную рекомендацию и принимать разумные решения на основе программы алгоритмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام خبير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13316" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11248">
    <skos:prefLabel xml:lang="en">equipment plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A formulated or systematic method for the supply of material necessities such as tools, gear, provisions or furnishings.
(Source: OED / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">projet d'équipement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan de equipo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausrüstungsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitrustingsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план установки оборудования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сформулированный и систематизированный метод поставки необходимых материалов, например, приборов, узлов, механизмов и оборудования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة التجهيز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3057">
    <skos:prefLabel xml:lang="en">exploration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The search for economic deposits of minerals, ore, gas, oil, or coal by geological surveys, geophysical prospecting, boreholes and trial pits, or surface or underground headings, drifts, or tunnels.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exploración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Exploration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verkenning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">геологическая разведка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поиск коммерческих месторождений минералов, руды, газа, нефти или угля методами геофизического прогнозирования, бурения скважин, закладки пробных шахт, поверхностных или подземных штолен, туннелей или горизонтальных выработок.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استكشاف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3058">
    <skos:prefLabel xml:lang="en">explosion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A violent, sudden release of energy resulting from powders or gases undergoing instantaneous ignition or from some other means of detonation, often accompanied by a force producing great amounts of heat, major structural damages, shock waves and flying shrapnel.
(Source: HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">explosion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explosión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Explosion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ontploffing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взрыв</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Резкий выброс энергии в результате быстрой химической или ядерной реакции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انفجار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2766" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10067">
    <skos:prefLabel xml:lang="en">promotion of trade and industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any activity that encourages or supports the buying, selling or exchanging of goods or services with other countries, which could include marketing, diplomatic pressure or the provision of export incentives such as credits and guarantees, government subsidies, training and consultation or advice.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">promotion du commerce et de l'industrie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">promoción del comercio y de la industria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftsförderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevordering van het zakenleven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поддержка торговли и промышленности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, содействующая или поддерживающая покупку, продажу либо обмен товарами или услугами с другими странами, которая может включать такие средства, как маркетинг, дипломатическое давление, предоставление экспортных стимулов в виде кредитов и гарантий, государственные субсидии, обучение и консультации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترويج  (دفع) التجارة والصناعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8571" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3061">
    <skos:prefLabel xml:lang="en">explosive</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance, such as trinitrotoluene, or a mixture, such as gunpowder, that is characterized by chemical stability but may be made to undergo rapid chemical change without an outside source of oxygen, whereupon it produces a large quantity of energy generally accompanied by the evolution of hot gases.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">explosif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explosivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Explosivstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">springstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взрывчатое вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, как, например, тринитротолуол, или смесь веществ, как, например, порох, характеризуемые химической стабильностью, однако приготовленные для того, чтобы пройти через резкое изменение химического состояния без внешнего источника кислорода, при котором выбрасывается большое количество энергии, сопровождаемое, как правило, выбросом горячих газов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة متفجرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3063">
    <skos:prefLabel xml:lang="en">export</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To send, take or carry an article of trade or commerce out of the country. To transport merchandise from one country to another in the course of trade.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exportation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exportaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausfuhr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitvoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отправление, вывоз или перемещение предметов торговли из страны. Транспортировка товара из одной страны в другую в процессе торговли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصدير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10940" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1968" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9073" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3064">
    <skos:prefLabel xml:lang="en">export licence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Permission from a government to carry or send abroad and sell a product manufactured within its borders.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">permis d'exportation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">licencia de exportación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ausfuhrgenehmigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitvoervergunning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспортная лицензия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разрешение на экспорт, выдаваемое соответствующим государственным органом лицу или организации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رخصة تصدير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6124" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3065">
    <skos:prefLabel xml:lang="en">export of hazardous wastes</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transporting by-products of society that possesses at least one of four characteristics (ignitability, corrosivity, reactivity, or toxicity) to other countries or areas for the conduct of foreign trade.
(Source: TOE /  MGHME)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exportation de déchets dangereux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exportación de residuos peligrosos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sonderabfallausfuhr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitvoer van gevaarlijke afvalstoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспорт опасных отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспортировка отработанных материалов, обладающих хотя бы одним из четырех свойств - воспламеняемость, коррозионность, реактивность и токсичность - в другие страны или районы в процессе торговли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصدير المخلفات الخطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9073" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11259">
    <skos:prefLabel xml:lang="en">approach</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The way or means of entry or access.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abords (agglomération)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enfoque</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Annäherung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">benadering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подход</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Направление или средство доступа или входа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقاربة - أسلوب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8841" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3071">
    <skos:prefLabel xml:lang="en">expropriation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To deprive an owner of property, especially by taking it for public use.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">expropriation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">expropiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Enteignung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onteigening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспроприация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лишать владельца собственности, особенно в случае ее передачи в государственное пользование.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نزع الملكية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5971" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3073">
    <skos:prefLabel xml:lang="en">extensive cattle farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Farming system practiced in very large farms, characterized by low levels of inputs per unit area of land; in such situations the stocking rate, the number of livestock units per area , is low.
(Source: GOODa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élevage extensif de bétail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cría extensiva de ganado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Extensive Viehzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">extensieve veehouderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экстенсивные методы ведения фермерского хозяйства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Методы, применяемые в больших хозяйствах, характеризуемые низким уровнем вложения средств на единицу площадей; при таких методах количество животных на единицу площадей, оборачиваемость земель и др. низки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التربية المكثفة للماشية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11269">
    <skos:prefLabel xml:lang="en">railway station</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place along a route or line at which a train stops to pick up or let off passengers or goods, especially with ancillary buildings and services.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gare ferroviaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estación ferroviaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bahnhof (Eisenbahn)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">treinstation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">железнодорожная станция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место вдоль маршрута следования, где поезд совершает остановку для входа или выхода пассажиров, погрузки-выгрузки  грузов, особенно в комплексе со вспомогательными зданиями и службами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة سكك حديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8073" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7684" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11270">
    <skos:prefLabel xml:lang="en">bus station</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place along a route or line at which a bus stops for fuel or to pick up or let off passengers or goods, especially with ancillary buildings and services.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gare routière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estación de autobús</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Busbahnhof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">busstation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">автобусная остановка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место вдоль маршрута следования, где автобус совершает остановку для дозаправки, а также входа или выхода пассажиров,  погрузки-выгрузки грузов, особенно вместе со вспомогательными зданиями и службами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة حافلات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8073" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3079">
    <skos:prefLabel xml:lang="en">externality</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discrepancies between private costs and social costs or private advantages and social advantages; the basic concept of externality is interdependence without compensation.
(Source: PHC /  GILP96 /  GREENW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">externalité économique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exterioridad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Externalität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uiterlijke kenmerken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">баланс интересов личности и общества</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Несоответствие между личными и общественными расходами или личными и общественными преимуществами; базовым принципом при таком подходе является взаимозависимость без компенсации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأثر الخارجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5476" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11272">
    <skos:prefLabel xml:lang="en">engineering work</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ouvrage d'art</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trabajo de ingeniería</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ingenieurbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">machinefabriek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инженерная работа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أعمال هندسية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3081">
    <skos:prefLabel xml:lang="en">extinction (ecological)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The complete disappearance of a species of plant or animal from the planet.
2) Disappearing of animals and plants from the biota.
(Source: WRIGHT /  GREMES)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">extinction</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extinción (ecológica)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aussterben</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het uitsterven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">исчезновение (экологическое)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Полное исчезновение видов растений или животных с лица земли. 2)  Исчезновение животных и растений из биоты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انقراض (إيكولوجي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13196">
    <skos:prefLabel xml:lang="en">petrochemical</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemicals manufactured from the products of oil refineries, based largely on ethylene, propylene and butylene produced in the cracking of petrol fractions.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit pétrochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">petroquímica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Petrochemie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">petrochemisch</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нефтехимический продукт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химический продукт, произведенный нефтеперерабатывающим заводом на базе этилена, пропилена и бутилена, полученных в результате крекинга нефти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البتروكيماويات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11276">
    <skos:prefLabel xml:lang="en">railway network</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The whole system of railway distribution in a country.

(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau ferroviaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">red ferroviaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisenbahnnetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spoorwegnet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сеть железных дорог</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вся система железнодорожного сообщения страны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبكة سكك حديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6942" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6940" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11277">
    <skos:prefLabel xml:lang="en">road network</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The system of roads through a country.

(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau routier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">red de carreteras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Straßennetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wegennet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сеть автомобильных дорог</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вся система автомобильных дорог страны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبكة طرق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7272" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7293" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3376">
    <skos:prefLabel xml:lang="en">food processing industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A commercial establishment in which food is manufactured or packaged for human consumption.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie alimentaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria alimentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebensmittelindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedingsmiddelenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пищевая обрабатывающая промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Коммерческие предприятия, производящие или пакующие продукты питания для потребления человеком.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصناعات الغذائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3368" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3090">
    <skos:prefLabel xml:lang="en">extractive industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Primary activities involved in the extraction of non-renewable resources.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie minière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria extractiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Extraktivindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">extractieve bedrijfstakken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добывающая промышленность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, связанная с добычей невозобновляемых ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة استخراجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5289" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13212" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4611">
    <skos:prefLabel xml:lang="en">land consolidation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Joining small plots of land together to form larger farms or large fields.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">remembrement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consolidación del suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flurbereinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruilverkaveling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">укрупнение земель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение вместе маленьких участков для образования более крупных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضم الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1881">
    <skos:prefLabel xml:lang="en">crossing place for animals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Bridges and tunnels provided for animals for crossing roads and railways. Railway and road infrastructures represent an hindrance to wildlife migration.
(Source: DOBRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">endroit de passage aménagé pour les animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lugar de cruce para animales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überquerung für Tiere</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenoversteekplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">места для перехода животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мосты и туннели, позволяющие животным переходить дороги и железнодорожное полотно. Дорожная инфраструктура мешает миграции диких животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكان عبور الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1880" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11289">
    <skos:prefLabel xml:lang="en">navigation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science or art of conducting ships or aircraft from one place to another, esp. the method of determining position, course, and distance travelled over the surface of the earth by the principles of geometry and astronomy and by reference to devices (as radar beacons or instruments) designed as aids.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">navigation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">navegación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schiffahrt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stuurmanskunst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">навигация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука или искусство вождения морских или воздушных судов, особенно методы определения положения, курса, пройденного расстояния над земной поверхностью на основе принципов геометрии и астрономии, а также при помощи вспомогательных приборов (радары и пр.).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملاحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8598" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4331" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5052" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11294" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5550" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6261" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3099">
    <skos:prefLabel xml:lang="en">factor market</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Significant elements or reasons for an outcome in the buying, selling, and trading of particular goods or services.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marché des facteurs de production</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mercado de factores</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Faktormarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">markt van productiefactoren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рыночный фактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Значительные элементы или причины, способствующие результату покупки, продажи или обмена конкретных товаров или услуг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سوق العناصر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5058" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11294">
    <skos:prefLabel xml:lang="en">merchant shipping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transportation of persons and goods by means of ships travelling along fixed navigation routes.
(Source: ZINZANa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marine marchande</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marina mercante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Handelsschiffahrt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">koopvaardij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">торговое мореплавание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перевозка товаров и пассажиров судами по установленным навигационным маршрутам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل البحري التجاري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11289" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1594" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8563" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3103">
    <skos:prefLabel xml:lang="en">factory farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The technique of capital intensive animal-raising in an artificial environment, used for chicken, egg, turkey, beef, veal and pork production. Animals are restrained in a controlled indoor environment and their food is brought to them. The building take on the appearance of industrial units.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élevage industriel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cultivo de fábrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarfabrik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">intensieve veehouderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">промышленная ферма</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Приемы капиталоемкого животноводства в искусственной среде, используемые для производства куриного мяса, яиц, мяса индейки, говядины, телятины и свинины. Животные содержатся в контролируемых условиях, а еда им подается. Здания таких ферм похожи на промышленные предприятия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التربية الصناعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11296">
    <skos:prefLabel xml:lang="en">combined transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transport in which more than one carrier is used, e.g. road, rail and sea.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport combiné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte combinado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kombiverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gecombineerd vervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">комбинированные перевозки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспортировка, при которой используются более одного вида транспорта, например, автомобильный, железнодорожный и морской.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقل مختلط الوسائل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12446">
    <skos:prefLabel xml:lang="en">sludge stabilisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Usually anaerobic sludge digestion, a treatment that stabilizes raw sludge. Fully digested sludge has little readily biodegradable organic matter. It is not smelly and about 50% of the solids are inorganic. Sludge can also be digested aerobically.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stabilisation des boues</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estabilización de barro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlammstabilisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slibstabilisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стабилизация ила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обычно анаэробная переработка ила, метод обработки, стабилизирующий необработанный ил. Полностью переработанный ил практически не имеет биологически разлагаемых органических веществ. Он не имеет неприятного запаха и почти на 50% состоит из неорганических компонентов. Ил может также перерабатываться и в аэробных условиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تثبيت الوحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3106">
    <skos:prefLabel xml:lang="en">faecal bacterium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Bacteria contained in human and animal faeces.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bactérie fécale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bacteria fecal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fäkalbakterien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">faecesbacterieën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фекальная бактерия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бактерии, содержащиеся в человеческих или животных фекалиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البكتيريا البرازية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/698" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3110">
    <skos:prefLabel xml:lang="en">fallout</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The descent of airborne solid or liquid particles to the ground, which occurs when the speed at which they fall due to gravity exceeds that of any upward motion of the air surrounding them.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">retombée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">polvillo radiactivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fallout</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">radioactieve neerslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выпадение осадков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Осаждение на землю взвешенных в воздухе твердых или жидких частиц, которое происходит, когда скорость, с которой эти частицы падают под действием силы тяжести, превышает скорость восходящих потоков воздуха, их окружающих.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السَقط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2084" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1306" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2359" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12026" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6923">
    <skos:prefLabel xml:lang="en">radioactive waste management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The total supervision of the production, handling, processing, storage and transport of materials that contain radioactive nuclides and for which use, reuse or recovery are impractical.
(Source: EIS / HMH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion des déchets radioactifs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de residuos radiactivos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewirtschaftung radioaktiver Abfälle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beleid voor radio-actief afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">утилизация радиоактивных отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наблюдение за производством, обращением, обработкой, хранением и транспортировкой материалов, содержащих радиоактивные нуклиды и для которых признано непрактичным их использование, повторное использование или восстановление.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة النفايات المشعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9092" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3113">
    <skos:prefLabel xml:lang="en">fallow area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Land area normally used for crop production but left unsown for one or more growing seasons.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone en friche</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de barbecho</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brachfläche</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">braakliggend gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">участки земли под паром</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участки земли, используемые для выращивания сельскохозяйственных культур, но оставленные незасеянными в течение одного или более сезонов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة مُراحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3115" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3115">
    <skos:prefLabel xml:lang="en">fallow land</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Arable land not under rotation that is set at rest for a period of time ranging from one to five years before it is cultivated again, or land usually under permanent crops, meadows or pastures, which is not being used for that purpose for a period of at least one year. Arable land which is normally used for the cultivation of temporary crops but which is temporarily used for grazing is included.
(Source: ECEST)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">friche agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">terreno de barbecho (UP: terreno baldío)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Brachland</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">braakliggend terrein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">земля под паром</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пахотная земля вне севооборота, которая оставлена для восстановления на период от одного до пяти лет, или земля, обычно используемая для выращивания постоянных культур, луговых или пастбищных трав, но не используемая для этих целей по крайней мере один год. Земля, которая обычно используется для выращивания постоянных культур, но временно используется как пастбище, также включается в эту категорию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أرض مُراحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5667" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3113" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11308">
    <skos:prefLabel xml:lang="en">urban development document</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A written or printed text furnishing proposals or procedures for the improvement of living conditions, especially housing, for the inhabitants of a city or densely populated area.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">document d'urbanisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">documento de desarrollo urbano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtentwicklungsdokument</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stedelijke ontwikkelingsdocument</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">документ городского развития</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Написанный или напечатанный текст с описанием предложений или процедур по улучшению условий жизни, особенно жилищных условий для жителей города или другой плотнозаселенной местности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وثيقة تنمية حضرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11309">
    <skos:prefLabel xml:lang="en">periurban space</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any expanse of land or region located on the outskirts of a city or town.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espace périurbain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">espacio de la periferia urbana</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Stadtrandgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorstedelijk gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пригородная территория</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок или регион, расположенные за чертой города.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مساحة على حافة الحضر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8841" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3119">
    <skos:prefLabel xml:lang="en">family planning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The control of the number of children in a family and of the intervals between them, especially by the use of contraceptives.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">planning familial</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planificación familiar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Familienplanung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gezinsplanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">планирование семьи</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Контроль за количеством детей в семье и периодичностью их рождения, особенно с применением контрацептивов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخطيط الأسرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4056" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13183" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11312">
    <skos:prefLabel xml:lang="en">single family dwelling</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An unattached dwelling unit inhabited by an adult person plus one or more related persons.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">maison individuelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">viviendas unifamiliares</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Einfamilienhaus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eengezinswoning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жилище для одной семьи</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отдельный жилой дом, в котором проживает семья из нескольких человек.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسكن لأسرة واحدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13100" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3122">
    <skos:prefLabel xml:lang="en">farm animal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Animals reared in farms for working and producing food such as meat, eggs and milk.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">animal d'élevage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">animal del campo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vieh</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouw(huis)dier</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">животное, выращиваемое на ферме</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Животные, выращиваемые на ферме для работы и для производства продуктов питания, как, например, мясо, яйца, молоко.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حيوانات الحقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/450" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2324" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4862" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6548" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/429" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3123">
    <skos:prefLabel xml:lang="en">farm building</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The dwelling on a farm as distinguished from utility buildings as a barn, corncrib, milk house.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ferme (bâtiment)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">edificio agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bauernhof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">boerderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жилой дом на ферме</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Дом для проживания на территории фермы в отличие от вспомогательных построек, таких как сараи, загоны для скота, пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسكن المزرعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3130" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8713">
    <skos:prefLabel xml:lang="en">turbine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fluid acceleration machine for generating rotary mechanical power from the energy in a stream of fluid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">turbine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">turbina</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Turbine</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">turbine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">турбина</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Двигатель с вращательным движением рабочего органа - ротора, преобразующий в механическую работу кинетическую энергию падающего потока воды, энергию пара и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توربين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8833">
    <skos:prefLabel xml:lang="en">urban pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollution of highly populated areas mainly deriving from motor vehicles, industrial plants, combustion and heating plants, etc.
(Source: GREMES)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution de la ville</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación urbana</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Städtische Umweltbelastung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadsvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение городскими отходами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязнение районов с высокой плотностью населения выхлопами автомобилей, отходами промышленных заводов, теплостанций и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث حضري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2895" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11321">
    <skos:prefLabel xml:lang="en">land use plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The key element of a comprehensive plan; describes the recommended location and intensity of development for public and private land uses, such as residential, commercial, industrial, recreational and agricultural.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan d'occupation des sols</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan de utilización del suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flächennutzungsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondgebruiksplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план использования земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ключевой элемент комплексного плана развития; описывает рекомендованное местоположение и интенсивность развития государственного и частного землепользования, например, для жилья, для коммерческой, промышленной, сельскохозяйственной деятельности или для отдыха.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة استخدام الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4678" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3130">
    <skos:prefLabel xml:lang="en">farm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any tract of land or building used for agricultural purposes, such as for raising crops and livestock.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ferme (exploitation)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bauernhof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwbedrijf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ферма</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земли или здание, используемое для сельскохозяйственных целей, например, для выращивания культур или разведение скота.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مزرعة - حقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13136" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3123" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13192" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11323">
    <skos:prefLabel xml:lang="en">land use regime</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Relation existing between the landowner and the tenant farmer who cultivates the land.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">régime foncier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">régimen de utilización del suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flächennutzungsverwaltung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondgebruiksregime</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">режим использования земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимоотношения между владельцем земли и арендующим фермером, который эту землю обрабатывает.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام استغلال الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13102" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9077">
    <skos:prefLabel xml:lang="en">waste gas</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any unusable aeriform fluid, or suspension of fine particles in air, given off by a manufacturing process or the burning of a substance in a enclosed area.
(Source: OED / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effluent gazeux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gas residual</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgas</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitlaatgas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходящий газ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая непригодная для использования воздушная смесь или воздушная суспензия мелких частиц, образовавшаяся в ходе промышленного процесса либо сжигания вещества в закрытом пространстве.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غاز مستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1583" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3045" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3763" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4274" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9042" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9043" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3133">
    <skos:prefLabel xml:lang="en">fast traffic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">trafic à grande vitesse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tráfico rápido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schnellverkehr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">snelverkeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">скоростной транспорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حركة مرورية سريعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3138">
    <skos:prefLabel xml:lang="en">fauna</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The entire animal life of a given region, habitat or geological stratum.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">faune</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fauna</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fauna</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fauna</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фауна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Все виды животных, обитающие в данном регионе, среде обитания или геологической страте.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفونا - مجموع حيوانات المنطقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/686" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5034" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13101" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11332">
    <skos:prefLabel xml:lang="en">new town</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of several recent urban developments that constitute small and essentially self-sufficient cities with a planned ordering of residential, industrial, and commercial development.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ville nouvelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nueva ciudad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Neustadt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nieuwe gemeente</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">новый город</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Новое городское образование, представляющее собой небольшой и самодостаточный город с упорядоченным расположением жилых кварталов, промышленных и коммерческих предприятий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بلدة جديدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1421" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11333">
    <skos:prefLabel xml:lang="en">pre-emption zone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Areas that are subject to the pre-emption right which is a privilege accorded by the government to the actual settler upon a certain limited portion of the public domain, to purchase such tract at a fixed price to the exclusion of all other applicants.
(Source: BLACKa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone de préemption</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona de derecho preferente de compra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebiet mit Vorkaufsrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zone die valt onder een recht van voorkoop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">район преимущественного права покупки (земельного участка)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Районы, на которые распространяется действие права, предоставляемого государством поселенцу в отношении ограниченного участка государственной земли, разрешающее исключительно ему приобрести этот участок по фиксированной цене.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة شُفعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4666" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11334">
    <skos:prefLabel xml:lang="en">land-management intervention area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any expanse of land which requires a person or agency with authority to interpose or interfere in how it is used or administrated.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone d'intervention foncière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área de intervención de gestión de tierra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eingriff in die Raumordnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbeheerinterventiegebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">район с правом проведения проверки использования земли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земли, использование или управление которым подлежит проверке со стороны уполномоченного физического лица или органа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة تدخل في إدارة الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4666" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3143">
    <skos:prefLabel xml:lang="en">federal authority</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The power of a central government agency or its administrators to carry out the terms of the law creating the agency as well as to administer and implement regulations, laws and government policies.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">autorité fédérale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autoridad federal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bundesbehörde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">federale overheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">федеральная власть</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Власть и полномочия центрального государственного органа или его руководителей на реализацию положений закона, на базе которого он был создан, а также применять и реализовывать акты, законы и политику государства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السلطة الفدرالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3144">
    <skos:prefLabel xml:lang="en">federal government</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system in which a country or nation formed by a union or confederation of independent states is governed by a central authority or organization.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gouvernement fédéral</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Gobierno federal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bundesregierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">federale regering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">федеральное правительство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, при которой страна существует как союз или конфедерация независимых государств и управляется центральным органом власти.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حكومة فدرالية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3455" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12107">
    <skos:prefLabel xml:lang="en">water catchment protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Precautionary actions, procedures or installations undertaken to prevent or reduce harm to the environmental integrity of drainage areas used to catch water, such as reservoirs or basins.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection de zone de captage de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección de captación de agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schutz des Wassereinzugsbereichs</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bescherming van een stroomgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охрана водосборных бассейнов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Профилактические действия, процедуры и установки, реализованные для предотвращения или снижения ущерба, наносимого экологической целостности водосборных бассейнов, например, водохранилищам или речным бассейнам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية المناطق الحاجزة للماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9206" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12108" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3147">
    <skos:prefLabel xml:lang="en">federal law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules established by a government that has been constituted as a union of independent political units or states.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi fédérale (D)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley federal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bundesrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">federaal recht (D)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">федеральный закон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, установленных государством, существующим как союз независимых политических единиц или государств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون فدرالي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3149">
    <skos:prefLabel xml:lang="en">fee</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A charge fixed by law for services of public officers or for use of a privilege under control of government.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">frais administratifs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">honorario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebühr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">honorarium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">плата</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установленная законом сумма, обмениваемая на услуги государственных чиновников или за использование каких-либо привилегий под государственным контролем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رسوم (مالية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2516" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9022" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13244" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3151">
    <skos:prefLabel xml:lang="en">feeding of animals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act and effect of supplying animals with food.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">alimentation des animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alimentación de los animales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierfütterung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het voeren van dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кормление животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Акт и следствие обеспечения животных кормом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إطعام الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/423" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11344">
    <skos:prefLabel xml:lang="en">rural architecture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">architecture rurale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arquitectura rural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ländliche Architektur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plattelandsarchitectuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельская архитектура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عمارة ريفية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/538" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11345">
    <skos:prefLabel xml:lang="en">traditional architecture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">architecture traditionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arquitectura tradicional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Traditionelle Architektur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">traditionele bouwstijl</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">традиционная архитектура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عمارة تقليدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/538" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3154">
    <skos:prefLabel xml:lang="en">fen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waterlogged, spongy ground containing alkaline decaying vegetation, characterized by reeds, that may develop into peat. It sometimes occurs in the sinkholes of karst region.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fagne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pantano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Niedermoor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фен</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наполненная водой, пружинистая почва, содержащая щелочные разлагающиеся растения, которые могут образовать торф. Иногда в отдельных регионах образуются в карстовых воронках.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستنقع صغير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9297" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3159">
    <skos:prefLabel xml:lang="en">fermentation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any enzymatic transformation of organic substrates, especially carbohydrates, generally accompanied by the evolution of gas; a physiological counterpart of oxidation, permitting certain organisms to live and grow in the absence of air; used in various industrial processes for the manufacture of products, such as alcohols, acids, and cheese by the action of yeasts, molds, and bacteria; alcoholic fermentation is the best-known example. Also known as zymosis.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fermentation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fermentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fermentation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gisting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ферментация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Трансформация под действием энзимов органических соединений, особенно углеводов, обычно сопровождаемая выделением газа; физиологически процесс обратный оксидации, позволяющий многим организмам жить и расти при отсутствии воздуха; используется во многих производственных процессах для получения таких продуктов, как спирта, кислоты, сыра под действием дрожжей, плесени или бактерий; алкогольная ферментация является широко распространенным примером; также используется термин "ферментация".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخمر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/812" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/889" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/898" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2945" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1892">
    <skos:prefLabel xml:lang="en">crystallography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of science that deals with the geometric description of crystals and their internal arrangement.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cristallographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cristalografía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kristallographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kristallografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кристаллография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль науки, занимающаяся геометрическим описанием кристаллов и их внутреннего строения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم البلورات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5270" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3162">
    <skos:prefLabel xml:lang="en">fern</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of a large number of vascular plants composing the division Polypodiophyta, without flowers and fruits.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fougère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">helechos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Farnpflanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">varens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">папоротник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Представитель многочисленной группы сосудистых растений без цветов и плодов, составляющих семейство Polypodiophyta.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السرخس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8559" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11355">
    <skos:prefLabel xml:lang="en">building destruction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The tearing down of buildings by mechanical means.
(Source: MGHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">destruction de bâtiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">destrucción de edificio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebäudezerstörung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afbraak van gebouwen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">снос зданий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разрушение зданий с помощью механических средств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تدمير مبنى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1731" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11359">
    <skos:prefLabel xml:lang="en">municipal engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Branch of engineering dealing with the form and functions of urban areas.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">génie urbain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería municipal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Städtisches Ingenieurwesen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gemeentewerken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">строительство городских сооружений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль строительства, в ведении которой находятся форма и функции городских районов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهندسة البلدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12586" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12816">
    <skos:prefLabel xml:lang="en">nuclear risk</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A risk connected to the functioning of nuclear power plants, by the storage or transportation of radioactive materials and involving the release of potentially dangerous levels of radioactive materials into the environment.
(Source: FEMAa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">risque nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">riesgo nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Atomrisiko</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nucleair gevaar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерный риск</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Риск, связанный с функционированием атомных электростанций, хранением или транспортировкой радиоактивных материалов, сопряженных с выбросом потенциально опасных объемов радиоактивных материалов в окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطر نووي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7233" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5742" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3171">
    <skos:prefLabel xml:lang="en">fertiliser law</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">loi sur les engrais</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley de fertilizantes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Düngemittelgesetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">meststoffenwet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законы в области использования удобрений</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">قانون الأسمدة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/206" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13199">
    <skos:prefLabel xml:lang="en">processed foodstuff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Food which has been treated to improve its appearance or to prevent it going bad.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aliment transformé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alimento transformado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Behandeltes Lebensmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verwerkt voedingsmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обработанный продукт питания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продукт питания, подвергшийся обработке для улучшения его внешнего вида или предотвращения его порчи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أغذية مصنعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13200" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3174">
    <skos:prefLabel xml:lang="en">fibre</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An extremely long, pliable, cohesive natural or manufactured threadlike object from which yarns are spun to be woven into textiles.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fibre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fibra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Faser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vezel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">волокно</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Чрезвычайно длинный, мягкий, однородный нитеобразный предмет природного или промышленного происхождения, из которого изготавливаются текстильные нити, используемые для производства тканей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ألياف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5501" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8275" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8721">
    <skos:prefLabel xml:lang="en">two-stroke engine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An internal combustion engine whose cycle is completed in two strokes of the piston.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">moteur à deux temps</skos:prefLabel>
    <skos:prefLabel xml:lang="es">motor de dos tiempos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zweitaktmotor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tweetaktmotor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">двухтактный двигатель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Двигатель внутреннего сгорания, цикл которого завершается за два хода поршня.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محرك ثنائي الأشواط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3176">
    <skos:prefLabel xml:lang="en">field</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A limited area of land with grass or crops growing on it, which is usually surrounded by fences or closely planted bushes when it is part of a farm.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">champ</skos:prefLabel>
    <skos:prefLabel xml:lang="es">campo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ackerland</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">akker</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поле</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ограниченный участок земли, на котором растут трава или сельскохозяйственные культуры и который, если является частью фермы, обычно окружен забором или кустарниками.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حقل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7345" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3177">
    <skos:prefLabel xml:lang="en">field damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A decline in the productivity of an area of land or in its ability to support natural ecosystems or types of agriculture. Degradation may be caused by a variety of factors, including inappropriate land management techniques, soil erosion, salinity, flooding, clearing, pests, pollution, climatic factors, or progressive urbanization.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">détérioration du terrain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">daño de campo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flurschaden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schade aan akkers</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ущерб, нанесенный полям</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Снижение продуктивности участка земли или его способности поддерживать природные экосистемы, а также конкретные типы сельскохозяйственной деятельности. Такая деградация может быть вызвана широким спектром причин, включая применение неправильных методов землепользования, почвенную эрозию, соленость, затопление, вырубку деревьев, нашествие вредителей, загрязнение, климатические факторы или расширение городских территорий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدهور الحقلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2802" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3178">
    <skos:prefLabel xml:lang="en">field experiment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Experiment carried out on a substance or on an organism in the open air as opposed to in a laboratory.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">expérience de terrain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">experimento de campo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freilandversuch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veldproef</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полевые испытания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Опыты, проводимые на веществе или на организме на открытом воздухе в отличие от условий закрытой лаборатории.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجربة حقلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3050" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3179">
    <skos:prefLabel xml:lang="en">field study</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Scientific study made in the open air to collect information that can not be obtained in a laboratory.
(Source: PHCa /  DUNSTEa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étude de terrain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estudio de campo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Feldstudie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">veldonderzoek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полевое исследование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Научное исследование, проводимое на открытом воздухе в целях сбора информации, которая не может быть получена в условиях лаборатории.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراسة حقلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11148" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/530">
    <skos:prefLabel xml:lang="en">archaeology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The scientific study of the material remains of the cultures of historical or prehistorical peoples.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">archéologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arqueología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Archäologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">archeologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">археология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая материальные остатки исторических или доисторических культур.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الآثار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10019" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3182">
    <skos:prefLabel xml:lang="en">filling station</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place where petrol and other supplies for motorists are sold.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station-service</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gasolineras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tankstelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tankstation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заправочная станция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где продаются бензин и другие материалы для автомобилистов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة تموين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10851" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3183">
    <skos:prefLabel xml:lang="en">film</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A motion picture; a thin flexible strip of cellulose coated with a photographic emission, used to make negatives and transparencies.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">film</skos:prefLabel>
    <skos:prefLabel xml:lang="es">película</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Film</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">film</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кинофильм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Кинокартина; тонкая гибкая целлюлозная лента, покрытая фотографическим слоем и используемая для изготовления негативов или слайдов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيلم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2284" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13000" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13001" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3184">
    <skos:prefLabel xml:lang="en">filter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A porous material for separating suspended particulate matter from liquids by passing the liquid through the pores in the filter and sieving out the solids.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">filtre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">filtros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Filter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">filter</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фильтр</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пористый материал для отделения взвешенных частиц материи от жидкости путем пропускания жидкости через поры этого материала и отсеивания твердых частиц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرشح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/54" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/699" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12280" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3190" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3186">
    <skos:prefLabel xml:lang="en">filter cake</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Accumulated solids, wet or dry, generated by any filtration process, including accumulation on fabric filters in air filtering processes, or accumulation of wet solids in liquid filtering processes.
(Source: EED /  ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gâteau de filtration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto de filtración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Filterrückstand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">filterkoek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">осадок на фильтре</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Накопленные твердые частицы, сухие или влажные, полученные в результате процесса фильтрации, включая накопление на тканевых фильтрах в процессе воздухоочистки или накопление влажных твердых частиц в процессе фильтрации жидкостей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كَسْب الترشيح - كعكة المرشح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3190" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8723">
    <skos:prefLabel xml:lang="en">type of claim</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A class or category of interests or remedies recognized in law or equity that create in the holder a right to the interest or its proceeds, typically taking the form of money, property or privilege.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">type de demande</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tipo de demanda</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Klageart</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">soort aanspraak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тип претензии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Класс либо категория интересов или средств, признанных законом и формирующих у их владельца право на материальный интерес обычно в форме денег, имущества или привилегии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوع الطلب- نوع المطالبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3190">
    <skos:prefLabel xml:lang="en">filtration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Separation of suspended particles from a liquid, gas, etc., by the action of a filter.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">filtration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">filtración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Filtration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">filtratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фильтрация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отделение взвешенных частиц от жидкости, газа и т.д. при помощи фильтра.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الترشيح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5226" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8736" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3184" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3186" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5081" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12576" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3192">
    <skos:prefLabel xml:lang="en">final storage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system where inert materials, which are not to be mobilized by natural processes even for long time periods, are confined by three barriers: the natural impermeable surroundings, an artificial barrier (such as liner) which can be controlled and, most important, the inert material itself. The concept of final storage includes the possibility to mine the materials in the future if such materials are sufficiently "clean" (mono-landfills) and if it becomes economic to mine such ores.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stockage final</skos:prefLabel>
    <skos:prefLabel xml:lang="es">almacenamiento final</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Endlagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eindopslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">захоронение отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система утилизации отходов, при которой инертные материалы, которые не должны подвергаться действию естественных процессов даже в течение длительного времени, ограждаются тремя барьерами: природными непреодолимыми ограждениями, искусственными ограждениями, которые могут контролироваться и самим инертным материалом. Смысл такого хранения состоит в возможности использовать эти материалы в будущем при условии, что они достаточно "чисты" и их переработка выгодна с экономической точки зрения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخزين النهائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3194">
    <skos:prefLabel xml:lang="en">finances</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The monetary resources or revenue of a government, company, organization or individual.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">finances</skos:prefLabel>
    <skos:prefLabel xml:lang="es">finanzas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Finanzen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">financiën</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">финансы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Денежно-кредитная система; часто употребляется в отношении государственных доходов и расходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الماليات</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1025" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1824" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3201" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3205" />
