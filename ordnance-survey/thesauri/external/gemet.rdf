  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14165">
    <skos:prefLabel xml:lang="en">aerial photography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">photographie aérienne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fotografía aérea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Luftbildfotographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">luchtfotografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэрофотосъемка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صورة جوية</skos:prefLabel>
