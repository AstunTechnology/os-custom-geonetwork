  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3432">
    <skos:prefLabel xml:lang="en">forest product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any material afforded by a forest for commercial use, such as tree products and forage.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit forestier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos forestales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Forstwirtschaftliches Erzeugnis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bosproduct</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лесопродукция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продукт леса для коммерческого использования, как, например, древесина.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتجات الغابات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5510" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1800" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9348" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9358" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3517" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7161" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4771">
    <skos:prefLabel xml:lang="en">leisure time</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Time free from work or other duties; spare time.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">temps libre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tiempo libre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freizeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrije tijd</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">время отдыха</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Время, не занятое работой или выполнением другим обязанностей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وقت الفراغ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7001" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8870" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7007" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11583">
    <skos:prefLabel xml:lang="en">justice</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The correct application of law as opposed to arbitrariness.
(Source: CURZON)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">justice</skos:prefLabel>
    <skos:prefLabel xml:lang="es">justicia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Recht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gerechtigheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">правосудие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Четкое применение положений закона в отличие от произвольных действий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عدالة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1860" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11540" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13283" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13284" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13285" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4777">
    <skos:prefLabel xml:lang="en">lepidopteran</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large order of scaly-winged insects, including the butterflies, skippers, and moths; adults are characterized by two pairs of membranous wings and sucking mouthparts, featuring a prominent, coiled proboscis.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lépidoptère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lepidópteros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lepidoptera</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schubvleugeligen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">чешуйчатокрылые</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Многочисленный отряд насекомых, в т.ч. бабочки и мотыльки; взрослые особи имеют два пары мембранных крыльев и сосущие челюсти, включая свернутый спиралью хоботок.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القشريات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1091" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4782">
    <skos:prefLabel xml:lang="en">leukaemia</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A progressive, malignant disease of the blood forming organs; a distorted proliferation and development of leukocytes and their precursors in the blood and bone marrow.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">leucémie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">leucemia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Leukämie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leukemie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лейкемия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прогрессирующее, злокачественное заболевание кроветворных органов; диспропорциональное увеличение числа лейкоцитов и первичных частиц в составе крови и костного мозга.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اللوكيميا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1130" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4784">
    <skos:prefLabel xml:lang="en">levy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A ratable portion of the produce of the property and labor of the individual citizens, taken by the nation, in the exercise of its sovereign rights, for the support of government, for the administration of the laws, and as the means for continuing in operation the various legitimate functions of the state.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">impôt</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgabe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">heffing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сбор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Определенная доля продукции, полученная в результате использования имущества и труда отдельных граждан, отбираемая государством в рамках реализации его суверенных прав для целей поддержки правительства, применения законов, как средство обеспечения непрерывности выполнения разнообразных законных функций государства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فرض الضرائب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8308" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4785">
    <skos:prefLabel xml:lang="en">lexicon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The vocabulary of a particular sphere of activity, region, social class or individual, or the total set of morphemes or meaningful units of a language and its words.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lexique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">léxico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lexikon</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">woordenboek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лексикон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Словарный запас языка, отдельного говорящего лица, комплекта документов, профессиональной группы и др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معجم - قاموس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4787">
    <skos:prefLabel xml:lang="en">liability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Subjection to a legal obligation. Liability is civil or criminal according to whether it is enforced by the civil or criminal courts.
(Source: JCU)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">responsabilité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">responsabilidades</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Haftpflicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aansprakelijkheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ответственность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подверженность юридическому обязательству. Ответственность может быть гражданской или уголовной в зависимости от типа судопроизводства - гражданского или уголовного.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسؤولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1437" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2865" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4788" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4789" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6464" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6658" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6675" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4788">
    <skos:prefLabel xml:lang="en">liability for marine accidents</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Subjection to a legal obligation, such as financial recompense or ecological reparations, for any harm or damage inflicted on persons, property or the environment in the course of commercial or recreational activity in, on or near a sea.
(Source: BLD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">responsabilité pour les accidents en mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">responsabilidad por accidentes marinos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Haftung für maritime Havarien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aansprakelijkheid voor zee-ongevallen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ответственность за морские инциденты</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подверженность юридическому обязательству, например, финансовое возмещение или экологические репарации, за любой вид ущерба, нанесенного лицам, имуществу или окружающей среде в ходе реализации коммерческой или развлекательно-оздоровительной деятельности в, на или около моря.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المسؤولية عن الحوادث البحرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4787" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8990">
    <skos:prefLabel xml:lang="en">vocabulary</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A list of words or phrases of a language, technical field or some specialized area, usually arranged in alphabetical order and often provided with brief definitions and with foreign translations.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vocabulaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vocabulario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vokabular</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">woordenlijst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">словарь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Список слов, часто фраз, организованный в алфавитном порядке, снабженный определениями или переводом на другой язык.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معجم - قائمة مفردات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12982">
    <skos:prefLabel xml:lang="en">press release</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An official statement or announcement distributed to members of the media by a public relations firm, government agency or some other organization, often to supplement or replace an oral presentation.
(Source: WOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">communiqué de presse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comunicado de prensa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pressemitteilung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">persmededeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пресс-релиз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Официальное сообщение или объявление, распространяемое среди представителей средств массовой информации компанией, специализирующейся на работе с общественностью, государственным органом или иной организацией часто для дополнения устного выступления или вместо него.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشرة صحفية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6801" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4793">
    <skos:prefLabel xml:lang="en">library</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Place where books and other literary materials are kept.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bibliothèque</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bibliotecas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bibliothek</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bibliotheek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">библиотека</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где хранятся книги и другие литературные материалы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكتبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4796">
    <skos:prefLabel xml:lang="en">licencing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any process of granting and certifying legal or administrative permission to a person or organization to pursue some occupation or to perform some activity or business.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">délivrance de permis</skos:prefLabel>
    <skos:prefLabel xml:lang="es">licencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Genehmigungsverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergunningen toekennen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лицензирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс выдачи и подтверждения юридических или административных разрешений лицам или организациям для осуществления конкретной профессиональной деятельности, выполнения услуг или ведения бизнеса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منح الترخيص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13284" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4797" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4798" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4797">
    <skos:prefLabel xml:lang="en">licencing procedure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Procedures performed by administrative agencies in conjunction with issuance of various types of licences.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">procédure pour l'obtention d'un permis</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procedimiento de autorización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Genehmigungsverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">procedure bij het verstrekken van vergunningen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">процедура лицензирования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процедуры, которым следуют административные учреждения в связи с выдачей различных типов лицензий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية الترخيص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4796" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4798">
    <skos:prefLabel xml:lang="en">licencing obligation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Obligation to obtain a permit to pursue an occupation or to carry on some business.
(Source: WESTSa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">soumission à autorisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">obligación de licencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Genehmigungspflicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergunningseis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обязательное лицензирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязанность получить разрешение на осуществление профессиональной деятельности или вида бизнеса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التزام بالحصول على الترخيص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4796" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4799">
    <skos:prefLabel xml:lang="en">lichen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Composite organisms formed by the symbiosis between species of fungi and an algae. They are either crusty patches or bushy growths on tree trunks, stone walls, roofs or garden paths. Because they have no actual roots they get their sustenance from the atmosphere and rainwater. Lichens play an important role in the detection and monitoring of pollution, especially sulphur dioxide, as they are highly sensitive to pollution and different species disappear if pollution reaches specific levels.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lichen</skos:prefLabel>
    <skos:prefLabel xml:lang="es">líquenes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flechten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">korstmossen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лишайник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сложный организм, образуемый симбиозом отдельных видов грибов и водорослей. Имеет вид сухих корочек либо пушистых наростов, покрывающих стволы деревьев, стены, крыши или садовые тропинки. В силу отсутствия корневой системы лишайники получают необходимые для существования вещества из атмосферы и дождевой воды. Лишайники играют важную роль в контроле за состоянием окружающей среды, потому что очень чувствительны по отношению к загрязнению, особенно диоксиду серы, некоторые виды лишайников могут просто исчезнуть при особенно неблагоприятных экологических условиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأُشنة - الحزاز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1890" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/800">
    <skos:prefLabel xml:lang="en">bioaccumulative pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollutants that become concentrated in living organisms through the consumption of food or water.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant bioaccumulatif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes bioacumulativos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bioakkumulativer Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bio-accumulatieve verontreinigende stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бионакопительное загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество, содержание которого в живых организмах в результате потребления ими воды или пищи повышается.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوثات التراكم الأحيائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/798" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4802">
    <skos:prefLabel xml:lang="en">life cycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The phases, changes, or stages through which an organism passes throughout its lifetime.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cycle de la vie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclo biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebenszyklus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">levenscyclus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жизненный цикл</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Фазы, изменения, стадии, через которые проходит живой организм в течение своей жизни.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دورة الحياة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13118" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4805">
    <skos:prefLabel xml:lang="en">life science</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A science based on living organisms collectively.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sciences de la vie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciencias de la vida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biowissenschaften</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">levenswetenschappen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">науки о жизни</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, изучающая живые организмы взаимосвязанно.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الحياة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5524" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/971" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1945" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2470" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3633" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8313" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9425" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13000">
    <skos:prefLabel xml:lang="en">cinematographic film</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any motion picture of a story, drama, episode or event, often considered as an art form or used as a medium for entertainment.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">film cinématographique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">película cinematográfica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kinofilm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">cinematografische film</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кинофильм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Кинофильм.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيلم سينمائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3183" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13001">
    <skos:prefLabel xml:lang="en">documentary film</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any motion picture or movie in which an actual event, era or life story is presented factually, with little or no fiction.
(Source: C / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">film documentaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">película documental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dokumentarfilm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">documentaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">документальный фильм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неигровой фильм о действительном событии, конкретном лице и т.д., представляющий факты с небольшой художественной обработкой или без нее.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فيلم وثائقي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3183" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13002">
    <skos:prefLabel xml:lang="en">flora (document)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A work systematically describing the flora of a particular region, listed by species and considered as a whole.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">herbier</skos:prefLabel>
    <skos:prefLabel xml:lang="es">flora (documento)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzenliste</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantenencyclopedie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">реестр флоры</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Систематизированное описание флоры конкретного региона по видам, рассматриваемое  как единое целое.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قائمة النباتات (فلورا) في منطقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4814">
    <skos:prefLabel xml:lang="en">lighting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The supply of illumination in streets or dwellings.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éclairage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">iluminación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beleuchtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verlichting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">освещение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Снабжение светом улиц и жилых домов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إضاءة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6817" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4597" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4815">
    <skos:prefLabel xml:lang="en">separator of light liquids</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mechanical device for separating and removing residues from fuel and lubricating oil from waste water coming from filling stations and industrial plants in order to avoid pollution of water bodies; this system is based on the different specific weights of water and fuel residues that float on the water and can be easily removed.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">séparateur pour liquides légers</skos:prefLabel>
    <skos:prefLabel xml:lang="es">separador de líquidos ligeros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Leichtflüssigkeitsabscheider</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">scheider voor lichte vloeistoffen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сепаратор легких жидкостей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Механический прибор для отделения и удаления примесей из топлива и смазочных масел, поступающих от промышленных предприятий, в целях предотвращения загрязнения водоемов;  прибор основан на различии удельных весов воды и примесей топлива, которые плавают на ее поверхности и могут быть удалены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عازل السوائل الخفيفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7612" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4818">
    <skos:prefLabel xml:lang="en">lignite</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Coal of relatively recent origin consisting of accumulated layers of partially decomposed vegetation, intermediate between peat and bituminous coal; often contains patterns from the wood from which it formed.
(Source: MGH /  CED /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lignite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lignito</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Braunkohle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bruinkool</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лигнит</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Уголь относительно молодого возраста, состоящий из накопленных слоев частично разложившейся растительности в переходном состоянии между торфом и битумным углем; часто содержит включения пород деревьев, из которых был образован.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الليجنيت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3462" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4819" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4819">
    <skos:prefLabel xml:lang="en">lignite mining</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Extraction of brown coal from natural deposits; lignite is a brownish-black solid fuel in the second stage in the development of coal. It has a little over half the heating value of bituminous or anthracite coal.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mine de lignite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación minera de lignito</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Braunkohlenbergbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bruinkoolwinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">добыча лигнита</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Добыча бурого угля из природных месторождений; лигнит представляет собой коричневато-черный вид твердого топлива, соответствующий второй стадии в образовании угля. Лигнит при сгорании выделяет чуть больше половины величины тепла, выделяемой битумным углем или антрацитом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعدين الليجنيت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14837" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4818" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4820">
    <skos:prefLabel xml:lang="en">lime</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various mineral and industrial forms of calcium oxide differing chiefly in water content and percentage of constituent such as silica, alumina and iron.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kalk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kalk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">известь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Различные минеральные и промышленные формы оксида кальция, различающиеся, как правило, содержанием воды, а также долей содержания кремния, железа и глинозема.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4823">
    <skos:prefLabel xml:lang="en">limestone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sedimentary rock consisting chiefly of calcium carbonate, primarily in the form of the mineral calcite and with or without magnesium carbonate. Limestones are formed by either organic or inorganic processes, and may be detrital, chemical, oolitic, earthy, crystalline, or recrystallized; many are highly fossiliferous and clearly represent ancient shell banks or coral reefs.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">calcaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">caliza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kalkstein</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kalksteen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">известняк</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Осадочная порода, состоящая в основном из карбоната кальция, чаще всего в форме минерального кальцита, с добавлением или без карбоната магния. Известняки образуются в ходе органических или неорганических процессов, могут быть детритовыми, химическими, оолитовыми, кристаллическими или рекристаллическими. Многие виды известняка содержат окаменелости, древние остатки коралловых рифов или речных берегов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحجر الجيري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7298" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5529" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13017">
    <skos:prefLabel xml:lang="en">report to the minister</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A written account or statement describing in detail observations or the results of an inquiry into an event or situation and presented to any person appointed or elected to a high-level position within some political entity.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rapport au ministre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">informe para el Ministro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bericht an den Minister</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verslag uitbrengen aan de Minister</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доклад министру</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Письменный отчет или изложение, содержащие детальное описание наблюдений либо результатов расследования события или ситуации, представленные лицу, избранному или назначенному на высший пост конкретного органа политической системы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقرير إلى الوزير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4828">
    <skos:prefLabel xml:lang="en">limit value</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A workplace exposure criterion or standard that determines if a facility or building has a concentration of a substance to which most workers can be exposed without harmful or adverse effects.
(Source: HEG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">valeur limite</skos:prefLabel>
    <skos:prefLabel xml:lang="es">valores límite</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grenzwert</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grenswaarde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предельная величина</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Критерий или стандарт условий труда, определяющий концентрацию вещества на объекте или в помещении, воздействию которого работники могут подвергаться без ущерба или вреда для здоровья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حد القيمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2775" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13021">
    <skos:prefLabel xml:lang="en">parliamentary report</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A written account describing in detail observations or the results of an inquiry into an event or situation and presented to an official, deliberative body with legislative powers.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rapport parlementaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">informe parlamentario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Parlamentarischer Bericht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">parlementair verslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">парламентский доклад</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Письменный отчет или изложение, содержащие детальное описание наблюдений либо результатов расследования события или ситуации, представленные официальному совещательному органу с законодательными полномочиями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقرير برلماني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4830">
    <skos:prefLabel xml:lang="en">limnology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of bodies of fresh water with reference to their plant and animal life, physical properties, geographical features, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">limnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">limnología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Limnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">limnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лимнология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение водоемов с пресной водой с точки зрения обитающих в них растительных и животных видов, физических свойств, географических особенностей и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم المياه العذبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4832">
    <skos:prefLabel xml:lang="en">linear source of sound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Point noise sources placed one after the other one as, for instance, in a row of cars moving on a road.
(Source: VALAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source linéaire de son</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuente linear de sonido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Linienschallquelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lineaire geluidsbron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">линейный источник звука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Точечные источники звука, расположенные один за другим, как, например, ряд движущихся по дороге автомобилей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر صوت خطي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7933" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13025">
    <skos:prefLabel xml:lang="en">statutory text</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A document or a portion thereof expressing an official enactment of a legislative body, with emphasis on the document's precise wording or language.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">texte réglementaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">texto estatutario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzestext</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wettelijk voorschrift</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">официальный текст</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Документ или его часть, излагающие официальное решение законодательного органа с особым акцентом на точный порядок слов или язык документа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نص قانوني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13026">
    <skos:prefLabel xml:lang="en">thesis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A dissertation on a particular subject, in which original research has been done, usually by a candidate for a diploma or degree, or a proposition put forward for consideration, to be discussed and proved or maintained against objections.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">thèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dissertation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">proefschrift</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тезис</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Утверждение или предложение, требующее доказательства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أطروحة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2286" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4835">
    <skos:prefLabel xml:lang="en">line source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Line source means a one-dimensional source. An example of a line source is the particular emissions from a dirt road.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source linéaire (de pollution)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuentes alineadas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Linienquellen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lijnbron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">линейный источник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одномерный источник загрязнения. Примером могут служить характерные выбросы загрязняющих веществ, поступающие с грунтовой дороги.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر خطي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6474" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14931">
    <skos:prefLabel xml:lang="en">sub-national boundary</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The line demarcating a territory located within the limits of a State.
(Source: GOODa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">frontière infranationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">límite subnacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Innerstaatliche Grenze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">binnengrens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внутринациональная граница</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Линия, разделяющая территории, расположенные в пределах государства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحدود الداخلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14930" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14932" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4838">
    <skos:prefLabel xml:lang="en">lipid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of a class of compounds which contain long-chain aliphatic hydrocarbons and their derivatives, such as fatty acids, alcohols, amines, amino alcohols, and aldehydes; includes waxes, fats, and derived compounds.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lipide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lípido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lipid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lipide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">липид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Класс соединений, содержащих длинную цепочку алифатических углеводородов и их производных, например, жирные кислоты, спирты, амины, амино-спирты, альдегиды; включают также воск, жиры и производные соединения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اللبيدات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4839">
    <skos:prefLabel xml:lang="en">lipophilic substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substances having an affinity for lipids.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance lipophile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancia lipofílica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lipophiler Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lipofiele stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">липофильное вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, имеющие сродство с липидами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة منجذبة للدهنيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4840">
    <skos:prefLabel xml:lang="en">liquefied gas</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A gaseous compound or mixture converted to the liquid phase by cooling or compression; examples are liquefied petroleum gas (LPG), liquefied natural gas (LNG), liquid oxygen, and liquid ammonia.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gaz liquéfié</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gas licuado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flüssiggas</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vloeibaar (gemaakt) gas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сжиженный газ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газообразное соединение или смесь, конвертированная в жидкое состояние в результате охлаждения или компрессии; примером может служить сжиженный топливный газ (LPG), сжиженный природный газ (LNG) или  жидкий аммиак.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غاز مسال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3505" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8999">
    <skos:prefLabel xml:lang="en">volcanic eruption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ejection of solid, liquid, or gaseous material from a volcano.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éruption volcanique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">erupciones volcánicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vulkanausbruch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vulkaanuitbarsting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">извержение вулкана</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Исторжение твердого, жидкого или газообразного вещества из вулкана.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثوران بركان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9003" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3647" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4844">
    <skos:prefLabel xml:lang="en">liquid state</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A state of matter intermediate between that of crystalline substances and gases in which a substance has the capacity to flow under extremely small shear stresses and conforms to the shape of a confining vessel, but is relatively incompressible, lacks the capacity to expand without limit, and can posses a free surface.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">état liquide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estado líquido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flüssiger Zustand</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vloeibare toestand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">состояние жидкости</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние материи между газом и кристаллом, при котором вещество способно течь при исключительно незначительном наклоне, приобретая форму принимающего сосуда, относительно некомпрессионно, не имеет способности безгранично расширяться.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحالة السائلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8072" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2691" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11618">
    <skos:prefLabel xml:lang="en">homologation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The approval given by the judge of certain acts and agreements for the purpose of rendering them more binding and executory.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">homologation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">homologación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Billigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bekrachtiging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">признание действительным</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одобрение судьей конкретных действий или соглашений с целью придать им еще большую обязательную силу и исполнение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إجازة (شيء)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11433" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13040">
    <skos:prefLabel xml:lang="en">CD-ROM</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A compact disc on which a large amount of digitalised read-only data can be stored.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">CD ROM</skos:prefLabel>
    <skos:prefLabel xml:lang="es">CD-ROM</skos:prefLabel>
    <skos:prefLabel xml:lang="de">CD-ROM</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Cd-rom</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лазерный диск</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Компакт-диск, на котором может храниться большое количество оцифрованной информации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قرص مدمج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2284" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13041">
    <skos:prefLabel xml:lang="en">information centre</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any facility devoted to the collection, maintenance and distribution of materials or data compiled to convey knowledge on some subject, often with trained staff persons available to answer questions.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">centre d'information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">centro de información</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationszentrum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">informatie-centrum</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">информационный центр</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организация, занимающаяся сбором, поддержанием и распространением материалов или данных, составленных для передачи знаний по какому-либо предмету, в штате которого работают квалифицированные сотрудники, способные ответить на вопросы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركز معلومات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4850">
    <skos:prefLabel xml:lang="en">literature</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Written material such as poetry, novels, essays, especially works of imagination characterized by excellence of style and expression and by themes of general or enduring interest.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">littérature</skos:prefLabel>
    <skos:prefLabel xml:lang="es">literatura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Literatur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">letterkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">литература</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Написанный материал, например, поэзия, новеллы, эссе, особенно художественные произведения, отличающиеся превосходством стиля и формы выражения, а также темами общего и непреходящего интереса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأدب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4852" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4851">
    <skos:prefLabel xml:lang="en">literature data bank</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fund of information on a particular subject or group of related subjects, divided into discrete documents and usually stored in and used with a computer system.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">banque de données bibliographiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">banco de datos bibliográfico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Literaturdatenbank</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">letterkundig gegevensbestand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">литературный банк данных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Фонд информации по конкретному предмету или группе взаимосвязанных тем, разделенный на отдельные документы, обычно хранится и используется в рамках компьютерной системы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بنك بيانات ببليوجرافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2282" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1979" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4852">
    <skos:prefLabel xml:lang="en">literature evaluation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The action of evaluating or judging the quality or character of written materials such as poetry, essays, novels, biographies and historical writings.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">critique littéraire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación de documentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Literaturauswertung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">letterkundige evaluatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка литературы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Анализ, художественная оценка или восприятие художественных литературных произведений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التقييم الأدبي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4850" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4853">
    <skos:prefLabel xml:lang="en">literature study</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The identification, description, analysis and classification of books and other materials used or consulted in the preparation of a work.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">recherche bibliographique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">investigación bibliográfica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Literaturstudie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">letterkundig onderzoek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">исследование литературы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Определение, описание, анализ и классификация книг и других материалов, используемых в работе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراسة أدبيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7127" />
