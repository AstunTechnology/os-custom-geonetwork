    <skos:scopeNote xml:lang="ru">Начало или процесс развития споры или семени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإنبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
