    <skos:prefLabel xml:lang="es">compuestos de organocloro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Chlorverbindungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische chloorverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">хлорсодержащее органическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Органические соединения, содержащие связь C-Cl.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب كلورين عضوي</skos:prefLabel>
