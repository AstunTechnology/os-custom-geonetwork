  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13168">
    <skos:prefLabel xml:lang="en">agri-foodstuff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry dealing with the production, processing, and supply of agricultural food products.
(Source: PHCa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agro-alimentaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria agroalimentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschafts- und Ernährungssektor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">agrovoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство продуктов питания в сельском хозяйстве</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предприятия, занимающиеся производством, переработкой и поставкой сельскохозяйственных продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الغذاء الزراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3368" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4977">
    <skos:prefLabel xml:lang="en">malformation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Permanent structural change that may adversely affect survival, development or function.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">malformation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">malformación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Missbildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">misvorming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">порок развития</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постоянное структурное изменение, которое может отрицательно сказаться на выживании, развитии или функциях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشوه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11762" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13170">
    <skos:prefLabel xml:lang="en">economic geography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The geography of people making a living, dealing with the spatial patterns of production, distribution and consumption of goods and services. The development of economic geography over the past three decades has witnessed the substitution of analysis for description, leading to an identification of the factors and an understanding of the processes affecting the spatial differentiation of economic activities over the earth's surface.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">géographie économique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">geografía económica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftsgeographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">economische geografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономическая география</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">География хозяйственной деятельности людей, в рамках которой изучается пространственное размещение производств товаров и услуг. В экономической географии за последние три десятилетия произошла замена анализа на описание, что привело к определению факторов и пониманию процессов, влияющих на размещение производительных сил в рамках всего мирового хозяйства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجغرافيا الاقتصادية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3646" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4979">
    <skos:prefLabel xml:lang="en">malnutrition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Defective nutrition due to inadequate intake of nutrients or to their faulty digestion, assimilation or metabolism.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">malnutrition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">malnutrición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterernährung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ondervoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">недоедание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неполноценное питание вследствие недостаточного получения питательных веществ, их неправильного переваривания, ассимиляции или метаболизма.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سوء التغذية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3381" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2564" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/830">
    <skos:prefLabel xml:lang="en">bioethics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of ethical problems arising from biological research and its applications in such fields as organ transplantation, genetic engineering, or artificial insemination.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bioéthique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bioética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bioethik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bio-ethiek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоэтика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение этических проблем, возникающих в ходе проведения биологических исследований и их применения в таких областях, как трансплантация органов, генная инженерия или искусственное оплодотворение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أخلاقيات الأبحاث والتطبيقات البيولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2980" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4982">
    <skos:prefLabel xml:lang="en">mammal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any animal of the Mammalia, a large class of warm-blooded vertebrates having mammary glands in the female, a thoracic diaphragm, and a four-chambered heart. The class includes the whales, carnivores, rodents, bats, primates, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mammifère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mamíferos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Säugetier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zoogdieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">млекопитающее</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Животное класса  Mammalia, представители которого являются теплокровными позвоночными с молочными железами у женских особей, грудной диафрагмой и четырехкамерным сердцем. Класс включает китов, плотоядных, грызунов, летучих мышей, приматов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الثدييات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8946" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/508" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1191" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1275" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1362" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4356" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4632" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6621" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7306" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8769" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4984">
    <skos:prefLabel xml:lang="en">man (society)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A member of the human race.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">homme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hombre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mensch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">человек (общество)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Представитель человеческой расы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإنسان (مجتمع)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6527" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4985">
    <skos:prefLabel xml:lang="en">management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Government, control, superintendence, physical or manual handling or guidance; act of managing by direction or regulation, or administration, as management of family, or of household, etc.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Management</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Руководство, контроль, наблюдение, физическое обращение или присмотр; акт управления через направление, регулирование, администрирование, как, например, руководство семьей, ведение домашнего хозяйства и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإدارة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/208" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1280" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2009" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2730" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3238" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4065" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6373" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10256" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11244" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13291" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2877" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13178">
    <skos:prefLabel xml:lang="en">freedom</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The quality or state of being free, especially to enjoy political and civil liberties.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">liberté</skos:prefLabel>
    <skos:prefLabel xml:lang="es">libertades</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freiheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrijheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">свобода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Качество или состояние свободы, особенно в отношении гражданских или политических прав и свобод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13147" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4987">
    <skos:prefLabel xml:lang="en">management contract</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A legal agreement between two or more parties of employers and workers that outlines the administrative or supervisory work that is expected in exchange for certain payments and working conditions.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contrat de gestion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">convenio de gestión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewirtschaftungsvertrag</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestuursovereenkomst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">контракт на управление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقد إدارة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2009" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4988">
    <skos:prefLabel xml:lang="en">management of natural resources</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Planned use of natural resources, in particular of non-renewable resources, in accordance with principles that assure their optimum long-term economic and social benefits.
(Source: MUCKa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion des ressources naturelles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de recursos naturales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Naturpflege</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление природными ресурсами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Плановое использование природных ресурсов, в частности, невозобновляемых ресурсов, в соответствии с принципами, обеспечивающими его оптимальные долгосрочные экономические и социальные выгоды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة الموارد الطبيعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7175" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13182">
    <skos:prefLabel xml:lang="en">stock (trade)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Stored products ready for sale.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stock (commercial)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">existencias (comercio)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vorrat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorraad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">торговые запасы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Товары на складе, готовые к продаже.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخزون (تجارة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8102" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13183">
    <skos:prefLabel xml:lang="en">sterilisation (biological)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Procedure by which a human or other animal is made incapable of reproduction.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stérilisation (biologique)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">esterilización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sterilisation (biologisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sterilisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая стерилизация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процедура, в результате которой человек или другое животное становится неспособным к репродукции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجديب - تعقيم (حيوي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3119" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13184">
    <skos:prefLabel xml:lang="en">environmental economics of firms</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of financial resources for the purpose of incorporating ecological principles in the operations of businesses and companies.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie environnementale des entreprises</skos:prefLabel>
    <skos:prefLabel xml:lang="es">economía ambiental de empresas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltökonomie (betrieblich)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieueconomie van ondernemingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологичная экономика частных компаний</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование финансовых ресурсов с целью включения экологических принципов в деятельность коммерческих организаций и компаний.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاقتصاد البيئي للمؤسسات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2810" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4994">
    <skos:prefLabel xml:lang="en">mandate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A command or authorization to act in a particular way given by an administrator to a subordinate, a court to a lower court or an electorate to its representative.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mandat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mandato</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mandat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mandaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мандат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Согласованные цели в договоре на управление с инвестиционным менеджером, которые ставит инвестор и которые могут включать определение контрольного пакета, а также запрещенные инвестиции. 2) Юридический приказ, направляющий соответствующее лицо на выполнение решения, приговора и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توكيل - تفويض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/103" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13187">
    <skos:prefLabel xml:lang="en">environmental problem solving</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The activity of finding solutions for troublesome or perplexing situations involving ecological or natural resources.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">apport de solution à un problème environnemental</skos:prefLabel>
    <skos:prefLabel xml:lang="es">solución de problemas ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lösung von Umweltproblemen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het oplossen van milieuproblemen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">решение экологических проблем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность по нахождению решений для сложных или запутанных ситуаций, связанных с экологическими или природными ресурсами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حل المشكلات البيئية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
