    <skos:prefLabel xml:lang="en">museum</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place or building where objects of historical, artistic, or scientific interest are exhibited, preserved or studied.
(Source: CED)</skos:scopeNote>
