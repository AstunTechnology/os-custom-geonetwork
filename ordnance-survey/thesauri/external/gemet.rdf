  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6833">
    <skos:prefLabel xml:lang="en">pumping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removal of gases and vapors from a vacuum system.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pompage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bomba</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pumpen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pompen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выкачивание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление газов и паров из вакуумной системы.</skos:scopeNote>
