  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11198">
    <skos:prefLabel xml:lang="en">breeding technique</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Term referring to the systems employed in animal rearing (extensive and intensive).
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technique d'élevage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">técnica de crianza</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zuchttechnik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">foktechniek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">методы животноводства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, используемая при выращивании животных (интенсивная или экстенсивная).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقنية التربية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7586" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11199">
    <skos:prefLabel xml:lang="en">transhumance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The seasonal migration of livestock to suitable grazing grounds.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transhumance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trashumancia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Herdenwanderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het verweiden van de kudde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сезонный перегон скота на новые пастбища</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сезонная миграция животных на новые пастбища.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النُجعة - الانتجاع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8340">
    <skos:prefLabel xml:lang="en">technology acceptance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The approval, favorable reception and ongoing use of newly introduced devices and systems, usually developed from recent advances in the engineering sciences or industrial arts.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acceptation des technologies</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aceptación tecnológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologieakzeptanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologie-aanvaarding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внедрение технологий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одобрение, положительное восприятие и продолженное использование новых приборов и систем, разработанных, как правило, на базе современных достижений в области инженерных наук или производства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قبول التكنولوجيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7804" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11201">
    <skos:prefLabel xml:lang="en">mineral conditioner</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any naturally occurring inorganic substances with a definite chemical composition and usually of crystalline structure, such as rocks, which are used to stabilize soil, improving its resistance to erosion, texture and permeability.
(Source: RHW / SOI)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">amendement minéral</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acondicionador mineral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mineralischer Bodenverbesserer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anorganische conditioneerder</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">минеральная добавка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Природное неорганическое вещество определенного химического состава и, как правило, с кристаллической структурой, которое используется для стабилизации почвы, делая ее более устойчивой по отношению к эрозии, улучшая ее состав и водопропускающие свойства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مكيِّف معدني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3169" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7863" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10193">
    <skos:prefLabel xml:lang="en">abiotic environment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The non-living components of the environment (rocks, minerals, soil, water and climate).
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">milieu abiotique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">abiótico, entorno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abiotische Umwelt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">abiotische omgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">абиотическая среда</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неживые компоненты окружающей среды (камни, минералы, почва, воды и климат).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيئة لاحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10166" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10111" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3011">
    <skos:prefLabel xml:lang="en">evaluation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewertung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">evaluatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم - تقويم</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1632" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1986" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2066" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2117" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2246" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3013" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3014" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3400" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7236" />
