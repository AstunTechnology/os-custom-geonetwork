  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/404">
    <skos:prefLabel xml:lang="en">swans, geese and ducks</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A family of waterfowl, including ducks, gees, mergansers, pochards and swans, in the order Anseriformes.
