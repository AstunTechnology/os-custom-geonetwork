    <dct:title xml:lang="en">Railway Link</dct:title>
    <skos:prefLabel xml:lang="en">Railway Link</skos:prefLabel>
    <dct:description xml:lang="en">A linear spatial object that describes the geometry and connectivity of a railway network between two points in the network.</dct:description>
    <skos:definition xml:lang="en">A linear spatial object that describes the geometry and connectivity of a railway network between two points in the network.</skos:definition>
