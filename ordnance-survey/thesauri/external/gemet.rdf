    <skos:prefLabel xml:lang="en">foodstuff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A substance that can be used or prepared for use as food.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit alimentaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto alimenticio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebensmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voedsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">продукт питания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, которое может быть потреблено в качестве продукта питания или из которого может быть приготовлен продукт питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة غذائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6660" />
