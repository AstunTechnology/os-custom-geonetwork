    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/611">
    <skos:prefLabel xml:lang="en">astronautics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science of space flight.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">astronautique (science)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">astronáutica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Astronautik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ruimtevaartkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">астронавтика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука о космических полетах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الملاحة الفضائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/496" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
