  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6243">
    <skos:prefLabel xml:lang="en">phytomass</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plant biomass; any quantitative estimate of the total mass of plants in a stand, population, or within a given area, at a given time.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phytomasse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fitomasa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phytomasse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fytomassa</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фитомасса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растительная биомасса; количественная оценка общей массы растений в конкретном месте, популяции, районе в данный период времени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الكتلة الحيوية للنبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/883" />
