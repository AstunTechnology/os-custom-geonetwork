  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7588">
    <skos:prefLabel xml:lang="en">selective breeding of plants</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Breeding of plants having desirable characters.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">croisement génétique des plantes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mejoramiento vegetal selectivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Selektive Pflanzenzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">selectieve plantenteelt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">селекция растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение растений, обладающих желаемыми качествами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التربية الانتقائية للنباتات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6298" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3624" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7590">
    <skos:prefLabel xml:lang="en">selenium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A highly toxic, nonmetallic element; used in analytical chemistry, metallurgy, and photoelectric cells.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sélénium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">selenio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Selen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">seleen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">селен</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высокотоксичный, неметаллический элемент; используется в аналитической химии, металлургии, а также в составе фотоэлектрических батарей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيلينيوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2641" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7597" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7600" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7592">
    <skos:prefLabel xml:lang="en">self-help programme</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A series of steps or a system of services or activities designed to enable an individual to help or improve one's self without depending on the aid of others.
(Source: WOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">programme d'auto-aide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">programa de autogestión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Selbsthilfeprogramm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zelfhulpprogramma</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">программа  самопомощи</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Последовательность шагов либо система услуг или деятельности, позволяющие человеку помочь или усовершенствовать себя самостоятельно, без посторонней помощи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">برنامج مساعدة ذاتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6705" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7593">
    <skos:prefLabel xml:lang="en">self-monitoring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">auto-surveillance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autocontrol</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eigenüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zelfcontrole</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">самоконтроль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المراقبة الذاتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5346" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7594">
    <skos:prefLabel xml:lang="en">self-purification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A natural process of organic degradation that produces nutrients utilized by autotrophic organisms.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">autoépuration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autopurificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Selbstreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zelfreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">самоочищение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Естественный процесс органического разложения, продуктом которого являются питательные вещества, потребляемые автотрофичными организмами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التطهر الذاتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6838" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7595">
    <skos:prefLabel xml:lang="en">semi-arid land ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interacting system of a biological community and its non-living environmental surroundings in regions that have between 10 to 20 inches of rainfall and are capable of sustaining some grasses and shrubs but not woodland.
(Source: TOE / DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème des terres semi-arides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistemas semiáridos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystem eines semiariden Gebietes</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecosystemen van halfdroog land</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема полузасушливых земель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимодействующая система биологических сообществ и неживых окружающий условий, в регионах, которые характеризуются ежегодным уровнем осадков в 10-20 дюймов и способны поддерживать травяную и кустарниковую растительность, но не леса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للأراضي شبه القاحلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7597">
    <skos:prefLabel xml:lang="en">semiconductor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A solid crystalline material whose electrical conductivity is intermediate between that of a metal and an insulator and is usually strongly temperature-dependent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">semi-conducteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">semiconductor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Halbleiter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">halfgeleider</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полупроводник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Твердый кристаллических материал, электропроводность которого занимает промежуточное положение между металлом и изолятором и находится в сильной зависимости от температуры.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أشباه الموصلات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2623" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/965" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7590" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7694" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7599">
    <skos:prefLabel xml:lang="en">semimanufactured product</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Product that has undergone a partial processing and is used as raw material in a successive productive step.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit semi-manufacturé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producto semimanufacturado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Halbfabrikat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">halffabricaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полуфабрикат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Продукт, который прошел частичную обработку и используется в качестве исходного материала в последующих стадиях обрабатывающего процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتج نصف مصنع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7600">
    <skos:prefLabel xml:lang="en">semi-metal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An element having some properties characteristic of metals and others of non-metals. Many metalloids give rise to an amphoteric oxide (e.g. arsenic or antimony) and many are semiconductors.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">semi-métal</skos:prefLabel>
    <skos:prefLabel xml:lang="es">semimetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Halbmetall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">halfmetaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">металлоид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Элемент, обладающий некоторыми свойствами металлов и неметаллов. Многие металлоиды способствуют образованию амфотерных оксидов (например, мышьяка или сурьмы), многие являются полупроводниками.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبه فلز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5184" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/965" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7590" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7694" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14920">
    <skos:prefLabel xml:lang="en">line</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Term used in GIS technologies in the vector type of internal data organization: spatial data are divided into point, line and polygon types. In most cases, point entities (nodes) are specified directly as coordinate pairs, with lines (arcs or edges) represented as chains of points. Regions are similarly defined in terms of the lines which form their boundaries. Some vector GIS store information in the form of points, line segments and point pairs; others maintain closed lists of points defining polygon regions. Vector structures are especially suited to storing definitions of spatial objects for which sharp boundaries exist or can be imposed.
(Source: YOUNG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ligne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">línea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Linie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">lijn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">линия вектора</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин, используемый в векторном типе внутренней организации данных: пространственные данные разделяются на точки, линии и типы полигонов. В большинстве случаев точки (узлы) определяются как пары координат, а линии (дуги или углы) представлены в виде цепочек из точек. Некоторые векторные системы ГИС хранят информацию в форме точек, линейных сегментов координат; другие поддерживают закрытые списки точек, определяющих регион полигона. Векторные структуры особенно подходят для хранения описаний пространственных объектов с четкими границами или к которым границы могут быть применены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7603">
    <skos:prefLabel xml:lang="en">sensitive area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Areas of a country where special measures may be given to protect the natural habitats which present a high level of vulnerability.
(Source: BRACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone sensible</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área sensible</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Empfindlicher Bereich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gevoelig gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">район с неустойчивой экологической обстановкой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Районы страны, где необходимо предпринять специальные меры по сохранению природных условий, которые являются исключительно подверженными воздействию неблагоприятных экологических факторов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة حساسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12783" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2461" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10190" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3567">
    <skos:prefLabel xml:lang="en">gas chromatography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A separation technique involving passage of a gaseous moving phase through a column containing a fixed phase; it is used principally as a quantitative analytical technique for volatile compounds.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chromatographie en phase gazeuse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cromatografía de gases</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gaschromatographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gaschromatografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">газовая хроматография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сепарационная технология, включающая пропускание газообразной движущейся фазы через колонну, содержащую фиксированную фазу; используется главным образом для количественного анализа летучих соединений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفصل الكروماتوجرافي الغازي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1400" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5364">
    <skos:prefLabel xml:lang="en">moral persuasion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Appealing to the ethical principles or beliefs of an adversary or the public to convince the adversary to change behavior or attitudes.
(Source: MLK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">persuasion morale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">persuasión moral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Moralische Überredung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">morele overreding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">моральное убеждение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обращение к этическими принципам, убеждениям собеседника или общественности с целью убедить собеседника изменить свое поведение или мнение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إقناع أخلاقي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7793" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7611">
    <skos:prefLabel xml:lang="en">separation at source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Segregating various wastes at the point of generation (e.g. separation of paper, metal and glass from other wastes) to make recycling simpler and more efficient.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tri à la source</skos:prefLabel>
    <skos:prefLabel xml:lang="es">separación en origen</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mülltrennung (an der Abfallquelle)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">scheiding bij de bron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сортировка мусора в месте его сбора</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разделение отходов в местах их сбора (например, отделение бумажных, металлических и стеклянных отходов от другого мусора) в целях облегчения и повышения эффективности вторичного использования материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفصل في المنبع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7609" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7612">
    <skos:prefLabel xml:lang="en">separator</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A machine for separating materials of different specific gravity by means of water or air.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">séparateur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lavadores, separadores y filtros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abscheider</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(af)scheider</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сепаратор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машина для сепарации материалов различного удельного веса с помощью воды или воздуха.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عازل - فاصل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4815" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6055" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5081" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7613">
    <skos:prefLabel xml:lang="en">septic tank</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tank, usually underground, into which sewage flows, the deposited matter being wholly, or partially broken down through anaerobic action. The final effluent may be allowed to soak into the ground through a system of agricultural drains, if the soil is suitable. Alternatively, the tank must be emptied at regular intervals by a special road-tanker.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fosse septique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tanques sépticos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwassertank</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">septische put</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отстойник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Хранилище, обычно подземное, в которое попадают канализационные воды и в котором образующийся осадок полностью или частично разлагается в результате анаэробного воздействия. Конечный жидкий сток может выпускаться в почву через систему труб, если почвенные условия это позволяют. В противном случае такое хранилище периодически опорожняется специальным оборудованием.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خزان مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6841" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13557">
    <skos:prefLabel xml:lang="en">animal excrement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Waste matter discharged from the body of an animal.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déjection animale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">excremento animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierfäkalien</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierlijke uitwerpselen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экскременты животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отходы, выделяемые организмом животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">براز الحيوان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/453" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5007" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7616">
    <skos:prefLabel xml:lang="en">sequestration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) A legal term referring generally to the act of valuable property being taken into custody by an agent of the court and locked away for safekeeping, usually to prevent the property from being disposed of or abused before a dispute over its ownership can be resolved.
2) The taking of someone's property, voluntarily (by deposit) or involuntarily (by seizure), by court officers or into the possession of a third party, awaiting the outcome of a trial in which ownership of that property is at issue.
(Source: DUC /  EMBMO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mise sous sequestre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">confiscación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beschlagnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beslaglegging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">секвест</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Юридический термин, применяемый в случае наложения ареста на часть ценного имущества обычно в целях предотвращения использования этой собственности или причинения ей вреда, пока не будет решен спор о праве собственности на нее. 2) Изъятие чьего-либо имущества добровольно (под залог) или принудительно (в результате конфискации) представителями суда или для передачи в собственность третьей стороне, ожидающей решения судебного разбирательства, предметом которого является вопрос о собственности на данное имущество.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الوضع تحت الحراسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7411" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7617">
    <skos:prefLabel xml:lang="en">snake</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any reptile of the suborder Ophidia, typically having a scaly cylindrical limbless body, fused eyelids, and a jaw modified for swallowing large prey: includes venomous forms such as cobras and rattlesnakes, large nonvenomous constrictors, and small harmless types such as the grass snake.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">serpent</skos:prefLabel>
    <skos:prefLabel xml:lang="es">serpientes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlangen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slangen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">змея</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рептилия подотряда Ophidia; обычно обладает чешуйчатым, цилиндрическим телом, без конечностей; челюсти приспособлены заглатывать крупную добычу; включает ядовитых представителей, как, например, кобры и гремучие змеи, неядовитых удавов, а также мелких безобидных змей, как, например, уж.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثعبان - أفعى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7124" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7768" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7618">
    <skos:prefLabel xml:lang="en">service area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The area served by a particular public facility such as school, library, police station, park, etc.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone de service</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zonas de servicios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Versorgungsbereich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dienstverleningsgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">район обслуживания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Район, который обслуживает конкретная городская служба, например, полицейский участок, библиотека, школа и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة خدمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4666" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7621">
    <skos:prefLabel xml:lang="en">services</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The carrying out of work for which there is a constant public demand by the provision of labor and the utilization of tools.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">secteur des services</skos:prefLabel>
    <skos:prefLabel xml:lang="es">servicios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dienstleistungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">nutsbedrijven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">услуги</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выполнение работы с использованием человеческих ресурсов и инструментов, на которую есть постоянный общественный спрос.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خدمات</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2870" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3881" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4362" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4374" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4702" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6009" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6261" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6810" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6817" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6822" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6824" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7112" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8762" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10898" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12202" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12676" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13722" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14960" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14964" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7816" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7622">
    <skos:prefLabel xml:lang="en">settlement concentration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The distribution or total amount of communities, villages and houses within a specified geographic area.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concentration de peuplement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concentración de asentamientos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Siedlungsverdichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">concentratie van nederzettingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">концентрация населенных пунктов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Распределение поселков, деревень, отдельно стоящих домов по территории конкретного района.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تركز سكني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7781" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4027" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4323" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7795" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8820" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10991" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10993" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11307" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1775" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7625">
    <skos:prefLabel xml:lang="en">urban sprawl</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The physical pattern of low-density expansion of large urban areas under market conditions into the surrounding agricultural areas. Sprawl lies in advance of the principal lines of urban growth and implies little planning control of land subdivision. Development is patchy, scattered and strung out, with a tendency to discontinuity because it leap-frogs over some areas, leaving agricultural enclaves.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">expansion urbaine anarchique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">extensión de asentamientos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zersiedelung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">stadsuitbreiding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разрастание городов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Физическое расширение больших городских районов в сельскохозяйственную местность. Разрастание происходит за пределами основных границ городского развития и практически не использует научных методов планирования отвода новых земель. Новые городские участки часто располагаются неравномерно, далеко друг от друга, с образованием сельскохозяйственных анклавов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوسع الحضري العشوائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8804" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7627">
    <skos:prefLabel xml:lang="en">settling tank</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tank into which a two-phase mixture is fed and the entrained solids settle by gravity during storage.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décanteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">depósito de decantación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sedimentationsbecken</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bezinkingstank</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отстойник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Цистерна, в которую подают двухфазную смесь, а образующиеся твердые осадки постепенно оседают на дно под действием силы тяжести.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مِصفَق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6447" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6508" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7628">
    <skos:prefLabel xml:lang="en">sewage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any liquid-born waste that contains animal or plant matter in suspension or solution, soils and storm water, or chemicals in solution.
(Source: APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau usée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua cloacal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kanalisationswasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сточная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкообразные отходы, содержащие животный либо растительный материал в виде суспензии или раствора, почву, дождевую воду, растворы химикатов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7629">
    <skos:prefLabel xml:lang="en">sewage disposal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">déversement des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">eliminación de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserbeseitigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rioolwaterverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">утилизация сточной воды</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التخلص من مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9130" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/718" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7630">
    <skos:prefLabel xml:lang="en">sewage farm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area of land on which sewage or any other type of waste water is distributed in order to purify it; it is a kind of waste water treatment.
(Source: RRDA /  ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">champ d'épandage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">terreno de decantación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rieselfeld</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vloeivelden met afvalwater als mest</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поля аэрации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земли, на поверхности которой распределяют канализационные и другие сточные воды в целях их очистки; разновидность водоочистного сооружения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حقل مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9144" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9130" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7632">
    <skos:prefLabel xml:lang="en">sewage sludge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A semi-liquid waste with a solid concentration in excess of 2500 parts per million, obtained from the purification of municipal sewage.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">boue d'égout</skos:prefLabel>
    <skos:prefLabel xml:lang="es">barro de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Klärschlamm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rioolslib</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сточный ил</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Полужидкие отходы, концентрация твердых веществ в которых превышает 2500 частей на миллион, полученные в результате очистки городских стоков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وحل مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4268" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9140" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12435" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12436" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12441" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7733" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7636">
    <skos:prefLabel xml:lang="en">sewage treatment system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sewage treatment comes in two stages - primary and secondary treatment. The primary stage involves a process of screening solids from sewage, leaving a sludge and relatively clear water for further treatment or for disposal into rivers, the sea or on to the land. In the secondary stage the sludge is stirred constantly in vast tanks to get more oxygen into the mixture, allowing bacteria to break down the organic matter and leave a harmless residue that falls as a sediment to the bottom of the tank. After processing, the clear water on top of the tank is discharged into rivers and the sediment is used as landfill or discharged at sea.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système d'épuration des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistemas de tratamiento de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserbehandlungssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterverwerkingssysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система обработки стоков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обработка стоков происходит в два этапа - первичная обработка и вторичная. В течение первичной обработки происходит отделение твердых примесей от жидкости, в результате чего образуется ил и относительно прозрачная вода, которая направляется для дальнейшей обработки или сливается в реки, в море или утилизируется в почву. В ходе вторичной обработки образовавшийся ил постоянно перемешивается в больших контейнерах, что обеспечивает приток большого количества кислорода в смесь, в результате чего под воздействием бактерий органические материалы ила разлагаются, образуя безвредные вещества, оседающие на дно. После завершения процесса обработки верхний слой чистой воды выливается в реки, а осадок используют для засыпки мусорных ям либо сбрасывают в море.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام معالجة مياه الصرف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6841" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5369">
    <skos:prefLabel xml:lang="en">morphology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The branch of biology concerned with the form and structure of organisms.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">morphologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">morfología (biológica)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Morphologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">morfologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морфология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль биологии, изучающая форму и структуру организмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المورفولوجيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7641">
    <skos:prefLabel xml:lang="en">sewerage system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">System of pipes, usually underground, for carrying waste water and human waste away from houses and other buildings, to a place where they can be safely get rid of.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau d'égouts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">red de alcantarillado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kanalisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rioolstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">канализационная система</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система труб, проложенных обычно под землей, предназначенная для удаления жидких стоков и отходов жизнедеятельности человека из жилых домов и других зданий в места, где предусмотрена их безопасная утилизация.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام الصرف الصحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12273" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12275" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12276" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9130" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7646">
    <skos:prefLabel xml:lang="en">shellfish</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">coquillage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marisco</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Krustentier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schaal-en schelpdieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">моллюски и ракообразные</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">محار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/503" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14928">
    <skos:prefLabel xml:lang="en">vector to raster</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Methods to convert remotely sensed raster data to vector format. A number of vector-to-raster and raster-to-vector conversion procedures have been developed and introduced to current releases of many GIS packages.
(Source: YOUNG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">vecteur en trame</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vector a la trama</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vektor zu Raster</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">van vector- naar rasterformaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">преобразование векторного изображения в растровое</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Методы по преобразованию данных, полученных в результате дистанционного зондирования из векторного в растровый формат. Существует ряд процедур по конвертации векторного изображения в растровое и наоборот, которые входят в состав многих программ ГИС.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">متجه إلى راستر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14924" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7651">
    <skos:prefLabel xml:lang="en">shielding device</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Barriers devised for keeping away from people harmful substances.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">appareil de protection</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dispositivo de protección</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abschirmeinrichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">scherm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защитное ограждение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Барьер, предназначенный ограждать людей от воздействия вредных веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جهاز حماية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7652">
    <skos:prefLabel xml:lang="en">shifting cultivation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Agricultural practice using the rotation of fields rather than crops, short cropping periods followed by long fallows and the maintenance of fertility by the regeneration of vegetation.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture itinérante</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desplazamiento del cultivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wechselfeldwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwerflandbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подсечно-переложное земледелие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сельскохозяйственная практика, основанная на принципе ротации полей, а не сельскохозяйственных культур; короткие сезоны выращивания урожая сменяются длинными периодами нахождения земель под паром, а плодородие почвы поддерживается регенерацией растительности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زراعة التراحيل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7654">
    <skos:prefLabel xml:lang="en">ship</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A vessel propelled by engines or sails for navigating on the water, especially a large vessel that can not be carried aboard another, as distinguished from a boat.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bateau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">barcos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schiff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schip</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">корабль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Судно, способное двигаться по водной поверхности под действием работающего двигателя или парусов, особенно крупное судно, которое нельзя поместить на борт другого судна, как, например, лодку.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب - سفينة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3266" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5839" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8159" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8285" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8720" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7662" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2641">
    <skos:prefLabel xml:lang="en">element of group VI</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Group VI consists of two subgroups: group VIb, the main group, and group VIa. Group VIa consists of chromium, molybdenum, and tungsten. The main group consists of oxygen, sulphur, selenium, tellurium, and polonium.
(Source: CHSK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éléments du groupe VI</skos:prefLabel>
    <skos:prefLabel xml:lang="es">elemento del grupo VI</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elemente der Gruppe VI</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">elementen uit groep VI</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический элемент группы VI</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа VI состоит из подгрупп VIb, основной, и подгруппы VIa. Подгруппа VIa состоит из хрома, молибдена и вольфрама. Подгруппа VIb состоит из кислорода, серы, селена, теллура и полония.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عنصر في المجموعة 6</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2643" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5982" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8198" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7659">
    <skos:prefLabel xml:lang="en">shipping accident</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An unexpected incident, failure or loss involving a vessel or its contents in the course of commercial transport that poses potential harm to persons, property or the environment.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accident de navigation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">accidente naval</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schiffsunfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">scheepvaartongeluk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">авария на море</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неожиданное событие, отказ в работе или материальный ущерб, нанесенный судну или его грузу в ходе коммерческой транспортировки, представляющие потенциальную угрозу людям, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حادث بحري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8583" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7662">
    <skos:prefLabel xml:lang="en">ship garbage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Domestic and operational wastes, disposed of continuously or periodically, that are generated during the normal operation of a ship; usually excluding fresh fish waste from fishing operations.
(Source: NGT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ordures des navires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">basura de naves</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schiffsabfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">scheepsafval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходы судов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бытовые и производственные отходы, образующиеся в ходе нормальной работы судна, регулярно или периодически выбрасываемые; обычно исключают отходы рыбы, полученные в процессе рыбоперерабатывающих операций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات السفن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7654" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7663" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
