  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11468">
    <skos:prefLabel xml:lang="en">doctrine (law)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A rule, principle, theory, or tenet of the law, as the doctrine of merger, the doctrine of relation, etc.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">doctrine (droit)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">doctrina (ley)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lehrmeinung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leer [wet]</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доктрина</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Правило, теория или принцип права, например, доктрина о слияниях компаний, доктрина о взаимоотношениях и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقيدة (قانون)</skos:prefLabel>
