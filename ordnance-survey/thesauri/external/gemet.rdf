    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6244">
    <skos:prefLabel xml:lang="en">phytopathology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of plant diseases and their control.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phytopathologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">patología vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phytopathologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantenziektekunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фитопатология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение заболеваний растений и методов их контроля.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم أمراض النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6066" />
