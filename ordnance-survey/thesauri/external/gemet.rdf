    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5178">
    <skos:prefLabel xml:lang="en">metal oxide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any binary compound in which oxygen is combined with one or more metal atoms.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oxyde métallique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">óxido metálico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Metalloxid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">metaaloxide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оксид металла</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение из двух веществ, в котором кислород соединен с одним или более атомов металла.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أكسيد معدني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8496" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5179">
    <skos:prefLabel xml:lang="en">metal plating</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Forming a thin, adherent layer of metal on an object.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">revêtement métallique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">chapeado de metales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Metallisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">metaal walsen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гальванотехника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Образование и нанесение тонкой пленки металла на поверхность предмета.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكسية بالمعدن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5187" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1809">
    <skos:prefLabel xml:lang="en">corrosion inhibitor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical agent which slows down or prohibits a corrosion reaction.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produit anti-corrosion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">anticorrosivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Korrosionshemmer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">anticorrosiemiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ингибитор коррозии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое вещество, замедляющее или прекращающее процесс коррозии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مانع التآكل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/478" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5181">
    <skos:prefLabel xml:lang="en">metal products industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry related with the primary metal processing and fabricated metal products manufacturing. The most important end uses of the products of the metals industries are automobiles, machinery, appliances, electrical equipment, structures, furniture, and containers.
(Source: PZ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie des produits métalliques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de productos metálicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Metallwarenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">metaalproductenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство металлических изделий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Промышленные предприятия, осуществляющие первичную обработку металла и изготовление металлопродукции. Наиболее важными областями применения такой продукции являются автомобилестроение, машиностроение, изготовление приборов и электрического оборудования, конструкций, мебели, контейнеров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة المنتجات المعدنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4503" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6325">
    <skos:prefLabel xml:lang="en">plant textile fibre</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Natural textile fibres of vegetal origin.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fibre textile végétale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fibra textil vegetal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pflanzliche Textilfaser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantaardige textielvezels</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">растительное волокно</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Природные текстильные волокна растительного происхождения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ألياف نسيج نباتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5501" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1827" />
