    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5119">
    <skos:prefLabel xml:lang="en">measuring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability of the analytical method or protocol to quantify as well as identify the presence of the substance in question.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure (méthode analytique)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Messung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">meting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">измерение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность аналитического метода количественно оценить, а также определить физическое присутствие конкретного вещества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قياس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5203" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5123" />
