  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12259">
    <skos:prefLabel xml:lang="en">on-site wastewater treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process in which used or spent water is treated at the point of origin or where it was produced, by using a septic tank or some other system to remove or reduce  the impact of constituent wastes on human health and the environment.
(Source: WQL / WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement des eaux usées sur site</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de aguas residuales in situ</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserbehandlung vor Ort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterzuivering ter plekke</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистка стоков "на месте"</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого использованная или отработанная вода перерабатывается в месте образования с использованием отстойников или других систем для удаления или снижения отрицательного воздействия входящих в ее состав отходов на здоровье человека и окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة المياه المستهلكة في الموقع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
