  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6229">
    <skos:prefLabel xml:lang="en">physical property</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Property of a compound that can change without involving a change in chemical composition.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">propriété physique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">propiedad física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physikalische Kenngröße</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysische eigenschappen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физическое свойство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойство соединения, которое может измениться без изменения химического состава.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خاصية فيزيائية</skos:prefLabel>
