    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10670">
    <skos:prefLabel xml:lang="en">protection of animals</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">protection des animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección animal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenbescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита животных</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">حماية الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10064" />
