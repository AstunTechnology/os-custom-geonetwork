    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2665">
    <skos:prefLabel xml:lang="en">emission control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Procedures aiming at reducing or preventing the harm caused by atmospheric emissions.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contrôle des émissions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de emisiones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionsüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissiebeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">регулирование выбросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процедуры, направленные на снижение или предотвращение ущерба, вызываемого выбросами в атмосферу.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيطرة على الانبعاثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2795" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8597" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2670" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2666">
    <skos:prefLabel xml:lang="en">emission data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Data concerning pollutants released into the environment from a permanent or mobile installation or from products.
(Source: AZENP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">donnée sur les émissions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">datos de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionsdaten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissiegegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">данные по выбросам</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Статистические данные по количеству загрязняющих веществ, попавших в окружающую среду из мобильной или стационарной установки, а также из каких-либо продуктов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيانات الانبعاثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5348" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2663" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2672" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2667">
    <skos:prefLabel xml:lang="en">emission factor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The relationship between the amount of pollutants produced to the amount of raw materials processed, or fuel consumed, in any polluting process.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">facteur d'émission</skos:prefLabel>
    <skos:prefLabel xml:lang="es">factor de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionsfaktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissiefactor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фактор выброса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимосвязь между количеством произведенных загрязняющих веществ к величине  сырья или топлива, переработанного или потребленного в ходе загрязняющего процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معامل الانبعاث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2663" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6421" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10860">
    <skos:prefLabel xml:lang="en">cycle path</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Part of the road or a special path for the use of people riding bicycles.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">piste cyclable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">senda cíclica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Radweg</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fietspad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">велосипедная дорожка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть дороги или специальная дорожка, предназначенная для езды на велосипеде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حارة الدراجات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10905" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10861">
    <skos:prefLabel xml:lang="en">ski run</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A trail, slope, or course for skiing.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">piste de ski</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carrera de esquí</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Skipiste</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">skihelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лыжня</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тропа, спуск или маршрут для ходьбы на лыжах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ممر التزلج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8014" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7715" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2670">
    <skos:prefLabel xml:lang="en">emission reduction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or process of limiting or restricting the discharge of pollutants or contaminants, such as by setting emission limits or by modifying the emission source.
(Source: EEN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réduction d'émission</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reducción de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionsminderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissiereductie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">снижение выбросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действе или процесс, направленные на ограничение или предотвращение выбросов загрязняющих или отравляющих веществ, как, например, установление предельных уровней выбросов или  модификация источника выбросов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقليص الانبعاث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6446" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9080" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2665" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2671">
    <skos:prefLabel xml:lang="en">emission reduction banking</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A system for recording qualified air emission reductions for later use in bubble, offset, or netting transactions. Plant complexes that reduce emissions substantially may "bank" their "credits" or sell them to other industries.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mise en réserve de crédits pour la réduction des émissions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">crédito por reducción de emisiones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emission Reduction Banking</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verhandeling van emissiereducties</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">финансовый аспект снижения выбросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система записи снижения разрешенных выбросов в воздух для последующего использования в финансовых процессах зачета уровней выбросов. Заводские предприятия, которые в значительной степени сокращают свои выбросы, могут "записать" себе эти показатели в актив или продать другим предприятиям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حفظ أرصدة تقليص الانبعاثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/716" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2672">
    <skos:prefLabel xml:lang="en">emission register</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A listing, by source, of the amounts of air pollutants discharged in the atmosphere of a community daily.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">registre des émissions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">registro de emisiones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionskataster</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissieregister</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">регистр выбросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перечень загрязняющих веществ, ежедневно попадающих в атмосферу какого-либо сообщества, составленный по источникам загрязнения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سجل الانبعاثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4466" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2666" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2673">
    <skos:prefLabel xml:lang="en">emission situation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">état des émissions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">situación de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionssituation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissietoestand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ситуация с выбросами</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">حالة الانبعاثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2663" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2674">
    <skos:prefLabel xml:lang="en">emission source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A chemical process, building, furnace, plant or other entity responsible for the discharge of pollutants or contaminants into the environment.
(Source: DES / DEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source d'émission</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuentes de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emittent</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissiebron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">источник выбросов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химический процесс, здание, доменная печь, завод или другой источник, ответственный за выброс загрязняющих или отравляющих веществ в окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر انبعاثات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6474" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10129">
    <skos:prefLabel xml:lang="en">scientific ecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the interrelationship among living organisms and between organisms and their environment, utilizing the methods or theories of science.
(Source: DOE / APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écologie scientifique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología científica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaftliche Ökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappelijke ecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экология как наука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение взаимоотношений между живыми организмами, между организмами и окружающими их условиями на основе научных методов и приемов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإيكولوجيا العلمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4805" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/191" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/420" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/494" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/504" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2474" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4047" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4615" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4657" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5030" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6382" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6520" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8910" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10128" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10130" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10135" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4999">
    <skos:prefLabel xml:lang="en">mangrove swamp</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A wet, spongy area of land in tropical climates and along coastal regions that is dominated by mangrove trees and shrubs, particularly red mangroves (Rhizophora), black mangroves (Avicennia) and white mangroves (Laguncularia).
(Source: FFD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marais de mangrove</skos:prefLabel>
    <skos:prefLabel xml:lang="es">manglar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mangrovensumpf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wortelboommoeras</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мангровое болото</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Влажный, топкий участок земли в условиях тропического климата, а также вдоль побережий, где преобладают мангровые деревья и кустарники, особенно красные (Rhizophora),  черные (Avicenia) и белые (Laguncularia) породы мангровых деревьев.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستنقع منجروف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14194" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2677">
    <skos:prefLabel xml:lang="en">emission standard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The maximum amount of discharge legally allowed from a single source, mobile or stationary.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">norme de rejet</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normas de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emissionsnorm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emissienorm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандарт на выбросы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Максимальное значение разрешенного законом выброса вещества из одного источника, мобильного или стационарного.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معيار الانبعاث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8047" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2679">
    <skos:prefLabel xml:lang="en">emission to water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The discharge of solid, liquid or gaseous pollutants or contaminants into a body of water.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rejet dans l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertido al agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Einleitung ins Wasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afscheiding in water</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброс в воду</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Выброс твердых, жидких, газообразных загрязняющих или отравляющих веществ в водоем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الانبعاث في الماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2663" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9202" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2683">
    <skos:prefLabel xml:lang="en">employment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The work or occupation in which a person is employed.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">emploi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">empleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beschäftigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werkgelegenheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">занятость</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Работа или деятельность, в которой профессионально занят человек.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشغيل - توظيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4577" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2684" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2687" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8572" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8768" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13338" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13339" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13340" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9091">
    <skos:prefLabel xml:lang="en">waste legislation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to regulate the disposal of unwanted materials left over from a manufacturing process or the refuse from places of human or animal habitation.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation en matière de déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство, регулирующее обращение с отходами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, принятых государством, регулирующие процесс утилизации ненужных материалов, оставшихся в результате промышленного процесса, либо отходов из мест проживания человека или обитания животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريع المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2226" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7019" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9133" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8583">
    <skos:prefLabel xml:lang="en">traffic accident</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An unexpected incident with potential for harm occurring through the movement or collision of vessels, vehicles or persons along a land, water, air or space route.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accident de la route</skos:prefLabel>
    <skos:prefLabel xml:lang="es">accidentes de tráfico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verkehrsunfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verkeersongeval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">авария на дороге</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неожиданный потенциально опасный инцидент, произошедший в результате движения или столкновения судов, транспортных средств или людей на земле, воде, воздухе или космосе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حادث مروري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/25" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7659" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8582" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2687">
    <skos:prefLabel xml:lang="en">employment level effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The result or impact of a specific policy, action or event upon the number of working-age persons holding jobs in a specific region, nation or sector of the economy.
(Source: ODE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">effet sur le niveau de l'emploi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto de nivel de empleo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beschäftigungseffekt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">werkgelegenheidseffect</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эффект от уровня занятости</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Результат воздействия конкретной политики, действий или мер на количество занятых определенной возрастной группы в данном регионе, стране или секторе экономики.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تأثير مستوى التوظيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2689">
    <skos:prefLabel xml:lang="en">emulsification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of dispersing one liquid in a second immiscible liquid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">émulsification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">emulsificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emulgierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emulgatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">образование эмульсии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс дисперсии одной жидкости в другой несмешивающейся жидкости.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استحلاب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5318" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2691">
    <skos:prefLabel xml:lang="en">emulsion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A stable dispersion of one liquid in a second immiscible liquid, such as milk (oil dispersed in water).
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">émulsion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">emulsión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Emulsion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">emulsie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эмульсия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стабильная дисперсия одной жидкости в другой несмешивающейся жидкости, как, например, молоко (дисперсия жира в молоке).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستحلب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4844" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10884">
    <skos:prefLabel xml:lang="en">touristic route</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An established or selected course for travel consisting, typically, of secondary roads with significant scenic, cultural, historic, geological or natural features and including vistas, rest areas, and interpretive sites matching the scenic characteristics of the course.
(Source: GTT / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">circuit touristique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruta turística</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Touristenstrecke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toeristische route</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">туристический маршрут</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установленное или выбранное направление путешествия, включающее, как правило, второстепенные дороги с интересными историческими, культурными, геологическими или природными достопримечательностями и оборудованное местами для отдыха, справочно-информационными пунктами, комментирующими соответствующие объекты и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مسار سياحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7319" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2693">
    <skos:prefLabel xml:lang="en">encapsulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The enclosure of any polluting product with a material that prevents its release in the environment.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">encapsulation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">encapsulación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kapselung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inkapseling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инкапсуляция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заключение какого-либо загрязняющего вещества в оболочку, которая предотвращает его попадание в окружающую среду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تغليف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8641">
    <skos:prefLabel xml:lang="en">transportation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or means of moving tangible objects (persons or goods) from place to place. Often involves the use of some type of vehicle.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Transport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортировка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или средство передвижения материальных объектов (людей и грузов) из одного места в другое. Сопряжено с использование определенного типа транспортного средства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النقل</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/289" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/975" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3481" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4676" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6059" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7969" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8653" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9245" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13233" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13234" />
