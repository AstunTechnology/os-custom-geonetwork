    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10818" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13231" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7689">
    <skos:prefLabel xml:lang="en">side effects of pharmaceutical drugs</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">effet secondaire des médicaments</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efectos secundarios de medicamentos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nebenwirkungen von Medikamenten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bijwerkingen van geneesmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">побочные эффекты медицинских препаратов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الآثار الجانبية للعقاقير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2564" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7688" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7690">
    <skos:prefLabel xml:lang="en">sieving</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The size distribution of solid particles on a series of standard sieves of decreasing size, expressed as a weight percent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tamisage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cribado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Siebung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zeven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">просеивание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Распределение твердых частиц в стандартных ситах с уменьшающимися размерами ячеек, выраженное в проценте от веса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النَخل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5081" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11809" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14935">
    <skos:prefLabel xml:lang="en">co-ordinate system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A reference system used to measure horizontal and vertical distances on a planimetric map. A coordinate system is usually defined by a map
projection, a spheroid of reference, a datum, one or more standard parallels, a central meridian, and possible shifts in the x- and y-directions to locate x, y positions of point, line, and area features. A common coordinate system is used to spatially register geographic data for the same area.
(Source: ESRI)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système de coordonnées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de coordenadas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Koordinatensystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">coordinatenstelsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система координат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система отсчета, используемая для измерения горизонтальных и вертикальных расстояний на планиметрической карте. Система координат обычно определяется проекцией карты, исходным уровнем, одной или несколькими стандартными параллелями, центральным меридианом, возможными смещениями по направлению осей Х или У для определения координат по осям Х и У точки, линии или отдельных параметров изучаемого участка. Обычная система координат используется для пространственной регистрации географических данных этого участка.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام الإحداثيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14936" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14937" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7692">
    <skos:prefLabel xml:lang="en">silencer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any device designed to reduce noise, especially the device in the exhaust system of a motor vehicle.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">silencieux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">silenciador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schalldämpfer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">knalpot</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">глушитель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устройство, предназначенное снижать шум, особенно устройство в выхлопной системе автомобиля.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كاتم الصوت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6447" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5390" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7694">
    <skos:prefLabel xml:lang="en">silicon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A brittle metalloid element that exists in two allotropic forms; occurs principally in sand, quartz, granite, feldspar, and clay. It is usually a grey crystalline solid but is also found as a brown amorphous powder. It is used in transistors, rectifiers, solar cells, and alloys. Its compounds are widely used in glass manufacture, the building industry, and in the form of silicones.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">silicium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">silicio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Silizium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">silicium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кремний</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ломкий металлоидный элемент, существующий в двух аллотропных формах; встречается главным образом в составе песка, кварца, гранита, полевого шпата и глины. Обычно представляет собой твердое кристаллическое вещество серого цвета, но также встречается в виде аморфного порошка коричневого цвета. Используется в транзисторах, выпрямителях тока, солнечных батареях и сплавах. Его соединения широко используются в производстве стекла, строительной промышленности и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيليكون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2639" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7597" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7600" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7697">
    <skos:prefLabel xml:lang="en">silo</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A large round tower on a farm for storing grain or winter food for cattle.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">silo</skos:prefLabel>
    <skos:prefLabel xml:lang="es">silo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Silo</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">silo</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">силосная башня</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высокая башня круглой формы, используемая для хранения зерна или заготовленного на зиму корма для скота.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السَلوة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/186" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7698">
    <skos:prefLabel xml:lang="en">silt</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The fine mineral material formed from the erosion of rock fragments and deposited by rivers and lakes. Its particles are the intermediate form between sand and clay. The particles can range in size from 0.01-0.05 mm in diameter.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">limon</skos:prefLabel>
    <skos:prefLabel xml:lang="es">légamo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlick</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slib</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">силт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мелкий минеральный материал, образующийся в результате эрозии породы и оседания на дне рек и озер. Частицы занимают промежуточное положение между песчинками и частицами глины. Размер частиц мелкозема может быть от 0,01 до 0,05 мм в диаметре.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غرين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7565" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7699">
    <skos:prefLabel xml:lang="en">silver</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A very ductile malleable brilliant greyish-white element having the highest electrical and thermal conductivity of any metal. It occurs free and in argentite and other ores: used in jewellery, tableware, coinage, electrical contacts, and in electroplating. Its compounds are used in photography.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">argent</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plata</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Silber</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zilver</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">серебро</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Очень мягкий и ковкий блестящий серовато-белый элемент, обладающий самой высокой среди металлов термо- и электропроводностью. Встречается в чистом виде, а также в составе аргентита и других руд; используется в ювелирном деле, изготовлении посуды, монет, электрических контактов и гальванотехнике.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفضة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7702">
    <skos:prefLabel xml:lang="en">simulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A representation of a problem, situation in mathematical terms, especially using a computer.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">simulation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">simulación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Simulation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">simulatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">математическое моделирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Представление проблемы, ситуации в математических терминах, особенно с применением компьютера.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محاكاة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3050" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1473" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5099" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11087" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7707">
    <skos:prefLabel xml:lang="en">sintering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Forming a coherent bonded mass by heating metal powders without melting, used mostly in powder metallurgy.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">frittage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aglutinación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sinterung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sinteren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спекание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Образование однородной связанной массы в процессе нагревания металлического порошка без плавления, используется в порошковой металлургии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التلبيد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8447" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6746">
    <skos:prefLabel xml:lang="en">protected species</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Threatened, vulnerable or endangered species which are protected from extinction by preventive measures.
(Source: RAMADE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèce protégée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies protegidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geschützte Arten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beschermde soorten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охраняемые виды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нестабильные, исчезающие виды или виды, находящиеся под угрозой исчезновения, которые в результате принятия профилактических мер сохраняются от уничтожения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنواع محمية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1221" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7712">
    <skos:prefLabel xml:lang="en">sizing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To fix the cross-section of structural components on the basis of statics and material strength.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">calibrage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">captura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bemessung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">naar grootte sorteren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">определение размера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установление профиля структурного компонента, основываясь на статике и твердости материала.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معايرة - ضبط  العيار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4574" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2779">
    <skos:prefLabel xml:lang="en">environmental balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Final part of the environmental impact study and assessment which compares environmental costs and benefits on the basis of homogeneous criteria.
(Source: AMBPIAa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équilibre écologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltbilanz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieu-evenwicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">баланс окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заключительный раздел доклада об оценке и анализе воздействия на окружающую среду, в котором на базе однородных критериев сравниваются экологические выгоды и расходы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوازن البيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2799" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6747">
    <skos:prefLabel xml:lang="en">water protection area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area surrounding a water recovery plant in which certain forms of soil utilization are restricted or prohibited in order to protect the groundwater.
(Source: AZENP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone protégée de captage d'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona de protección hídrica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserschutzgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beschermd stroomgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">охраняемый участок вокруг подземного источника воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Район, окружающий водозаборную установку, где запрещены определенные виды землепользования в целях охраны подземного источника воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة حماية مائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6740" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2340" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7716">
    <skos:prefLabel xml:lang="en">skin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The tissue forming the outer covering of the vertebrate body: it consists of two layers, the outermost of which may be covered with hair, scales, feathers, etc. It is mainly protective and sensory in function.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">peau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">piel</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Haut</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кожа (анат.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ткань, образующая наружную оболочку тела позвоночных, обычно двухслойная; внешний слой может быть покрыт волосами, чешуями, перьями и пр. Основное назначение - защищать и передавать ощущения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجِلد - البشرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5890" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1286">
    <skos:prefLabel xml:lang="en">change in value</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">changement de valeur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cambio de valor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wertewandel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waardeverandering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изменение стоимости</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تغير القيمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3788" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7718">
    <skos:prefLabel xml:lang="en">skyline destruction</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">dégradation du paysage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">destrucción del horizonte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landschaftsverschandelung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">horizonvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разрушение ландшафта</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تدمير خط الأفق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4650" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7720">
    <skos:prefLabel xml:lang="en">slag</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A nonmetallic product resulting from the interaction of flux and impurities in the smelting and refining of metals.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">scorie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">escoria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlacke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(metaal)slak(ken)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шлак</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неметаллический продукт взаимодействия флюса и примесей в процессе плавления и рафинирования металлов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الخَبَث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/263" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1584" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8562">
    <skos:prefLabel xml:lang="en">tracking plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A formulated or systematic method for following or tracing environmentally related issues or concerns.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">programme de suivi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan de seguimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zielverfolgungsplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">volgplan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план наблюдений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сформулированный или систематизированный метод для отслеживания связанных с проблемами окружающей среды вопросов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة متابعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7724">
    <skos:prefLabel xml:lang="en">slaughterhouse</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place where animals are butchered for food.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abattoir</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mataderos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlachthof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(openbaar)slachthuis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бойня</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Производственное предприятие по убою скота и первичной обработке туш.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المجزر - المسلخ - السلخانة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4267" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7726" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7725">
    <skos:prefLabel xml:lang="en">slaughterhouse waste</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Animal body parts cut off in the preparation of carcasses for use as food. This waste can come from several sources including slaughterhouses, restaurants, stores and farms.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">déchets d'abattoirs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desechos de mataderos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlachtabfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slachtafval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отходы боен</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Части тел животных, отрезанные в ходе подготовки тушь к употреблению в качестве продуктов питания. Эти отходы могут образовываться не только на бойнях, но также в ресторанах, магазинах или фермах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مخلفات المجزر - مخلفات المسلخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/453" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7726">
    <skos:prefLabel xml:lang="en">slaughtering of animals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Killing of animals for food.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abattage des animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sacrificio de animales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierschlachten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het slachten van dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">забой скота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Убийство животных для получения продуктов питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ذبح الحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/233" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/448" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4863" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7724" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7729">
    <skos:prefLabel xml:lang="en">sleep</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A periodic state of physiological rest during which consciousness is suspended and metabolic rate is decreased.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sommeil</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sueño</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlaf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slaap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Периодическое состояния физиологического отдыха, в процессе которого полностью или частично прекращается работа сознания, а скорость обмена веществ замедляется.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7730" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7730">
    <skos:prefLabel xml:lang="en">sleep disturbance</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">trouble du sommeil</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alteración del sueño</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlafstörung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slaapstoornis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нарушение сна</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">اضطرابات النوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7729" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7731">
    <skos:prefLabel xml:lang="en">excavation side</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sloping surface of an excavation.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">talus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lado de excavación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Böschung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afgravingskant</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">склон котлована</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наклоненная поверхность котлована.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منحدر الحفائر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1064" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7733">
    <skos:prefLabel xml:lang="en">sludge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) A soft, soupy, or muddy bottom deposit, such as found on tideland or in a stream bed. 
2) A semifluid, slushy, murky mass of sediment resulting from treatment of water, sewage, or industrial and mining wastes, and often appearing as local bottom deposits in polluted bodies of water.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">boue</skos:prefLabel>
    <skos:prefLabel xml:lang="es">barro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlamm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slib</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ил</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Мягкое, глинистое отложение на дне, какое, например, находят на берегу в зоне прилива или в русле реки. 2) Полужидкая, непрозрачная, глинистая осадочная масса, образовавшаяся в процессе переработки воды, канализационных стоков, промышленных или горных отходов; часто образуется на дне загрязненных водоемов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7565" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7632" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7737">
    <skos:prefLabel xml:lang="en">sludge digestion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A treatment to stabilize raw sludge. The treatment can be either anaerobic process or aerobic process.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">digestion des boues</skos:prefLabel>
    <skos:prefLabel xml:lang="es">digestión de lodos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlammfaulung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slibgisting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая переработка ила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Переработка для стабилизации необработанного ила. Переработка может проходить как в аэробных, так и в анаэробных условиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هضم الوحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7738">
    <skos:prefLabel xml:lang="en">sludge incineration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A method used for drying and reducing sludge volume and weight. Since incineration requires auxiliary fuel to obtain and maintain high temperature and to evaporate the water contained in the incoming sludge, concentration techniques should be applied before incineration. Sludge incineration is a two-step process involving drying and combustion after a preceding dewatering process, such as filters, drying beds, or centrifuges.
(Source: CORBIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">incinération des boues</skos:prefLabel>
    <skos:prefLabel xml:lang="es">incineración de lodos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlammverbrennung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slibverbranding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сжигание ила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Метод, используемый для высушивания и снижения объема ила. Процесс сжигания ила проходит в два этапа: сначала удаляется вода в ходе фильтрования, высушивания или применения центрифуг, затем осуществляется сжигание.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترميد الوحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4183" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7739">
    <skos:prefLabel xml:lang="en">sludge settling pond</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pond for the removal of settleable solids through which wastewater is passed in a treatment works.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bassin d'évacuation des boues de décantation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estanque fangoso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlammteich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slikbezinkingsvijver</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отстойник для осаждения ила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пруд, предназначенный для удаления твердых, способных осаждаться материалов, через который пропускаются жидкие отходы в процессе обработки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حوض ترسيب الوحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6841" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7740">
    <skos:prefLabel xml:lang="en">sludge treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The processing of wastewater sludges to render them innocuous. This may be done by aerobic or anaerobic digestion followed by drying in sand beds, filtering, and incineration, filtering, and drying, or wet air oxidation.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement des boues</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de lodos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schlammbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">slibverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">переработка ила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Переработка сточного ила в безвредные материалы. Это может быть достигнуто в результате аэробной или анаэробной биологической обработки с последующим высушиванием на песчаном слое, в результате фильтрации и сжигания, фильтрации и высушивания или окисления влажным воздухом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة الوحل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/73" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7737" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12444" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12446" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7742">
    <skos:prefLabel xml:lang="en">sluice</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Vertical sliding gate or valve to regulate the flow of water in a channel or lock.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écluse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuerta</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schleuse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sluis</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">шлюз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вертикальные ворота или затвор, регулирующие поток воды в реке, канале и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هويس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9254" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13781" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1291">
    <skos:prefLabel xml:lang="en">negotiable charge</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">charge négociable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carga negociable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">verhandelbare Gebühr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderhandelbare heffingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">договорная цена</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">رسوم قابلة للتفاوض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1824" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4022">
    <skos:prefLabel xml:lang="en">housing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Dwelling-houses collectively and the provision of these.
2) Shelter, lodging.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">logement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vivienda</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterkunft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">huisvesting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дома и жилищное строительство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Жилые дома и их строительство. 2) Кров, проживание.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إسكان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7825" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4030" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7092" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7110" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8367" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4032" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7143" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7144" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13100" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13104" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13120" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13275" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
