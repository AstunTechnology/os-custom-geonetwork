    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3400">
    <skos:prefLabel xml:lang="en">forecast</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An estimate or prediction of a future condition.
(Source: WEBSTE)</skos:scopeNote>
