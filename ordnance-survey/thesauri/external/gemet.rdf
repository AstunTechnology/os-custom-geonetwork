    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4767">
    <skos:prefLabel xml:lang="en">leisure activity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sports and recreational activities carried out in the time free from work or other duties.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loisirs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actividades recreativas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freizeitbereich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vrijetijdsbesteding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отдых</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Занятия спортом, оздоровительно-развлекательная деятельность в свободное от работы или других обязанностей время.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نشاط ترويحي</skos:prefLabel>
