  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12202">
    <skos:prefLabel xml:lang="en">water weed cutting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cutting down by scythe or machine at intervals the vegetation growth and grasses on banks and berms of irrigation and drainage channels or cropped areas.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">faucardage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recorte de hierbas acuáticas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schneiden von Wasserpflanzen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afsnijden van waterplantengroei</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">удаление водяных сорняков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Периодическое удаление растительности по берегам ирригационных или дренажных каналов, вдоль прибрежных сельскохозяйственных участков с помощью косы или специальной машины.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حشُّ النباتات المائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6169">
    <skos:prefLabel xml:lang="en">conservation of petroleum resources</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Controlled utilization, protection and development of  exploited and potentially exploitable sources of crude oil to meet current demand and ensure future requirements.
(Source: MHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">préservation des ressources pétrolières</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conservación de recursos petrolíferos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schutz von Erdölressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bescherming van de aardoliebronnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сохранение ресурсов нефти</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Контролируемое использование, защита, развитие эксплуатируемых и потенциальных ресурсов сырой нефти в целях удовлетворения текущих потребностей и потребностей будущих поколений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحفاظ على الموارد البترولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7679">
    <skos:prefLabel xml:lang="en">show</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A performance, program or exhibition providing entertainment to a group of people, displayed either through some communication media, such as radio or television, or live at a museum or theater.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">spectacle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">espectáculos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Show</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorstelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выставка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где расположены какие-либо предметы для обозрения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1921" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14872" />
