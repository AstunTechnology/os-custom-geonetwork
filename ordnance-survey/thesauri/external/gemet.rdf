  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3278">
    <skos:prefLabel xml:lang="en">fixed schedule of charges</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">plan d'échelonnement des coûts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cargas de baremo fijo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">fester Kostenzeitplan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vaste belastingsschaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фиксированная цена</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">جدول زمني محدَّد للتكاليف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1824" />
