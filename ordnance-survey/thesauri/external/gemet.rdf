    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3678">
    <skos:prefLabel xml:lang="en">glass</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A hard, amorphous, inorganic, usually transparent, brittle substance made by fusing silicates, sometimes borates and phosphates, with certain basic oxides and then rapidly cooling to prevent crystallization.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">verre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vidrio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Glas</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">glas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стекло</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Твердое, аморфное, неорганическое, обычно прозрачное, жесткое вещество, производимое в результате плавления силикатов, иногда баритов или фосфатов, с добавлением известных оксидов металлов и последующего быстрого охлаждения, чтобы не допустить кристаллизации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زجاج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5305" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9082" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3681">
    <skos:prefLabel xml:lang="en">glass industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry for the production of glassware.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie du verre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria del vidrio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Glasindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">glasindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стекольная промышленность</skos:prefLabel>
