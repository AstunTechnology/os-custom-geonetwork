    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4707">
    <skos:prefLabel xml:lang="en">law (individual)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of the rules making up the body of law.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley (individual)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">закон (юридич.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одно из правил, составляющих отрасль права.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/79" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4708">
    <skos:prefLabel xml:lang="en">law amendment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An alteration of or addition to any statute with legal force that, if approved by the appropriate legislative authority, supersedes the original statute.
(Source: LLL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">amendement de loi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enmienda legislativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzesnovellierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetswijziging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изменение закона</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Небольшое изменение или добавление в тексте документа, резолюции и пр., относящихся к закону.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعديل القانون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13290" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4710">
    <skos:prefLabel xml:lang="en">law enforcement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any variety of activities associated with promoting compliance and obedience to the binding rules of a state, especially the prevention, investigation, apprehension or detention of individuals suspected or convicted of violating those rules.
(Source: BLD / LLL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">application de loi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aplicación de ley</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesetzesvollzug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetshandhaving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">приведение в исполнение закона</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие, связанное с вступлением в силу, исполнением нормативного документа, как, например, закон.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إنفاذ القانون - تطبيق القانون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2753" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2860" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12905">
    <skos:prefLabel xml:lang="en">compensation for damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Equivalent in money or other form for a loss sustained for an injury, for property taken, etc.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réparation des dommages</skos:prefLabel>
    <skos:prefLabel xml:lang="es">indemnización por daños</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schadensausgleich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schadevergoeding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компенсация ущерба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Денежный эквивалент или другая форма возмещения понесенного ущерба в результате травмы, потери имущества и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التعويض عن الأضرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12887" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4715">
    <skos:prefLabel xml:lang="en">neighbourhood law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to protect human health and the environment, manage growth and development or enhance the quality of life in small geographical and social areas within cities where residents share values and concerns and interact with one another on a daily basis.
(Source: HUM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi sur le voisinage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley de vecindad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nachbarschaftsrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">buurtwet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">"закон о добрососедстве"</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, установленных государством для защиты здоровья человека, окружающей среды, управления ростом и развитием, повышением качества жизни в небольших географических или социальных районах в рамках городов, жители которых разделяют общие ценности и заботы, а также взаимодействуют между собой ежедневно.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون الجيرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6290" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4719">
    <skos:prefLabel xml:lang="en">law (science)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Complex of rules fixed by law or custom which regulate social relations.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit (science)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho (ciencia)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Rechtswissenschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">recht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">право (научн.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свод правил, принятых в рамках закона или обычая, регулирующий социальные взаимоотношения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القانون (علم)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7472" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12912">
    <skos:prefLabel xml:lang="en">public institution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Institution for the management of public issues.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">établissement public</skos:prefLabel>
    <skos:prefLabel xml:lang="es">institución pública</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Öffentliche Institution</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">openbare instelling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">государственный орган</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Орган для управления государственными делами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مؤسسة عامة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3715" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2551" />
