  </skos:ConceptScheme>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8192">
    <skos:prefLabel xml:lang="en">sulphide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any compound that includes one or more sulfur atoms with a more electropositive element, either carbon, metal or some other nonoxygen atom.
(Source: RHW / MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sulfure</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sulfuro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sulfid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sulfide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сульфид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение, в состав которого входит один или более атомов серы вместе с элементом, обладающим более сильным положительным зарядом, например, углерод, металл или другое вещество, кроме кислорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كبريتيد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4107" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11184">
    <skos:prefLabel xml:lang="en">seed (product)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fertilized ovule containing an embryo which forms a new plant upon germination.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">semence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">semilla (producto)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Saatgut</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zaaizaad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">семя</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оплодотворенная семяпочка, содержащая эмбрион, из которого при прорастании образуется новое растение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بذور (إنتاج)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5305" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5510">
    <skos:prefLabel xml:lang="en">natural material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériaux naturels</skos:prefLabel>
    <skos:prefLabel xml:lang="es">materiales naturales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Naturstoffe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurlijke materiaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">природный материал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة طبيعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5086" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/442" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1649" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3169" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3432" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5418" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5501" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5529" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9242" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/591" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5277" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5521" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11207" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8198">
    <skos:prefLabel xml:lang="en">sulphur</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A nonmetallic element existing in a crystalline or amorphous form and in four stable isotopes; used as a chemical intermediate and fungicide, and in rubber vulcanization. It is deposited from volcanic vents and fumaroles and also is found in sedimentary rocks, particularly with gypsum and limestone, and associated with salt-domes. Native sulphur is the main source of sulphur for the sulphuric acid industry, followed by sour gas (natural gas containing hydrogen sulphide) and pyrite. Sulphur is an essential plant macronutrient.
(Source: MGH /  ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">soufre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">azufre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwefel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwavel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неметаллический элемент, существующий в кристаллической или аморфной форме и в виде четырех стабильных изотопов; используется в качестве промежуточного химического вещества, фунгицида, а также в процессе вулканизации каучука. Отложения серы образуются в ходе выбросов из вулканических отверстий и фумарол, а также в осадочных породах, часто одновременно с известняком или гипсовым камнем. Природная сера является основным сырьевым источником для производства серной кислоты, за ней по значимости следует сернистый газ (природный газ, содержащий сульфид водорода) и пирит.  Сера является важным макропитательным веществом для растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كبريت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7">
    <skos:prefLabel xml:lang="en">abandoned industrial site</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Site that cannot be used for any purpose, being contaminated by pollutants, not necessarily radioactive.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">site abandonné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona industrial abandonada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altstandort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verlaten terrein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заброшенная промышленная площадка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Площадка, которая никоим образом не может быть использована вследствие загрязнения какими-либо загрязняющими, не обязательно радиоактивными, веществами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موقع صناعي مهجور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4666" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2275" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12456" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/14951" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8200">
    <skos:prefLabel xml:lang="en">sulphur concentration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sulphur content in a solution.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">concentration en soufre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">concentración de azufre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwefelkonzentration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwavelgehalte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">концентрация серы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Содержание серы в растворе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تركيز الكبريت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1673" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15020">
    <skos:prefLabel xml:lang="en">insulating material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Material that prevents or reduces the transmission of electricity, heat, or sound to or from a body, device or region.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériau isolant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material aislante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dämmstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">isolerend materiaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изоляционный материал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материалы, препятствующие или снижающие передачу электричества, тепла или звука от объекта, устройства или региона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة عازلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4371" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5267" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8202">
    <skos:prefLabel xml:lang="en">sulphur dioxide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Emissions of the gas given off during the burning of fossil fuels in power stations and other boilers. Sulphur dioxide is created because sulphur is an impurity in most coal and oils. When the fuel is burned the hot sulphur reacts with oxygen in the atmosphere to form sulphur dioxide.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dioxyde de soufre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">dióxido de azufre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwefeldioxid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwaveldioxide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">диоксид серы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газ, образовавшийся в результате сгорания ископаемых видов топлива на электростанциях и других промышленных установках. Диоксид серы образуется в связи с тем, что сера часто присутствует в качестве примеси в составе угля и нефти. При сгорании топлива сера вступает в реакцию с кислородом, находящимся в воздухе, образуя диоксид серы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثاني أكسيد الكبريت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5978" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8204" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3572" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11">
    <skos:prefLabel xml:lang="en">abiotic factor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Physical, chemical and other non-living environmental factors. They are essential for living plants and animals of an ecosystem, providing the essential elements and nutrients that are necessary for growth. The abiotic elements also include the climatic and pedologic components of the ecosystem.
(Source: LBC /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">facteur abiotique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">factor abiótico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abiotischer Faktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">abiotische factor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">абиотический фактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Физические, химические и другие неживые факторы окружающей среды. Эти факторы являются очень важными для живых организмов экосистемы, обеспечивая поступление базовых питательных веществ, необходимых для роста. Абиотические факторы включают также климатические и почвенные компоненты экосистемы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل لاحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/470" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3640" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1462" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8204">
    <skos:prefLabel xml:lang="en">sulphur oxide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An oxide of sulphur, such as sulphur dioxide and sulphur trioxide; they are formed primarily from the combustion of fossil fuels; major air pollutants and cause of damage to the respiratory tract as well as vegetation.
(Source: MGH /  KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oxyde de soufre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oxidos de azufre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwefeloxid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwaveloxide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оксид серы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оксиды серы, например, диоксид или триоксид; образуются главным образом в результате сгорания минеральных видов топлива; являются главными веществами, загрязняющими атмосферу и наносящими ущерб дыхательной системе человека, а также растительному покрову.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أكسيد الكبريت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4350" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8202" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11734" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13">
    <skos:prefLabel xml:lang="en">absorption (exposure)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The taking in of fluids or other substances by cells or tissues.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">absorption (exposition)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">absorción (exposición)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Absorption (biologisch)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">absorptie (blootstelling)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">абсорбция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поглощение жидкости или других веществ тканями или клетками.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">امتصاص( تعرُّض)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6359" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14850">
    <skos:prefLabel xml:lang="en">sediment mobilisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The transport or setting in motion by wind or water of insoluble particulate matter.
(Source: APD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mobilisation de sédiments</skos:prefLabel>
    <skos:prefLabel xml:lang="es">movilización de sedimento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sedimentmobilisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sedimentbeweging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мобилизация отложений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перенос или осаждение в движении под действием ветра или воды нерастворимых частиц материи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحريك الترسيبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3488" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10925">
    <skos:prefLabel xml:lang="en">time allocation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act of assigning various hours of one's day, week or year to particular activities, especially those falling within the categories of work and leisure.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aménagement du temps</skos:prefLabel>
    <skos:prefLabel xml:lang="es">asignación de tiempo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zeitaufteilung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tijdstoewijzing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">распределение времени</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс распределения часов в дне, неделе или году между конкретными видами деятельности, особенно между работой и отдыхом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخصيص الوقت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4808" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8212">
    <skos:prefLabel xml:lang="en">supervision of building works</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The oversight or direction in the construction and maintenance of houses, facilities, offices and other structures.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">supervision de travaux de construction</skos:prefLabel>
    <skos:prefLabel xml:lang="es">supervisión de de trabajos de construcción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bauaufsicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bouwtoezicht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">контроль за строительными работами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наблюдение или руководство процессом строительства и эксплуатации жилья, коммунальных объектов, учреждений и др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإشراف على أعمال البناء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4255" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8213" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/21">
    <skos:prefLabel xml:lang="en">agreement (administrative)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A coming together of minds; a coming together in opinion or determination; the coming together in accord of two minds on a given proposition. In law, a concord of understanding and intention between two or more parties with respect to the effect upon their relative rights and duties, of certain past or future facts or performances. The consent of two or more persons concerning respecting the transmission of some property, right, or benefits, with the view of contracting an obligation, a mutual obligation. The union of two or more minds in a thing done or to be done; a mutual assent to do a thing.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agrément</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acuerdo (administrativo)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsabkommen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overeenkomst (administratieve)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соглашение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объединение идей; согласованность мнений или намерений; единство двух мнений по конкретному предложению. В праве - взаимопонимание и намерение двух или более сторон, с учетом вытекающих из этого взаимных прав и обязанностей, в отношении конкретных фактов или действий настоящего или будущего времени. Согласие двух или более лиц уважать передачу собственности, прав или преимуществ в обмен на какое-либо обязательство или  взаимное обязательство. Единство двух или более намерений по какому-либо вопросу или предполагаемому действию; взаимное согласие предпринять что-либо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8214">
    <skos:prefLabel xml:lang="en">supervisory body</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An appointed or official group given the responsibility of overseeing or managing normal work operations, special projects or other functions of an organization or agency.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">corps de tutelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cuerpo supervisor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überwachungsbehörde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toezichthoudend orgaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">наблюдательный орган</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Назначенная или официальная группа, наделенная полномочиями наблюдать или управлять нормальными рабочими процессами, специальными проектами или реализацией других функций организации или учреждения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيئة إشرافية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/23">
    <skos:prefLabel xml:lang="en">access to culture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability, right and permission to approach and use, or the general availability of resources that transmit the beliefs, customs, artistic activity and knowledge of a people.
(Source: PPP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accès à la culture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acceso a la cultura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zugang zur Kultur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toegankelijkheid van de cultuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доступ к культурным ценностям</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность, право и разрешение иметь доступ и пользоваться либо общая доступность ресурсов, передающих убеждения, обычаи, художественные ценности и знания народа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نفاذ إلى الثقافة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1921" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1909" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3477" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10024" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/24">
    <skos:prefLabel xml:lang="en">access to the sea</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">accès à la mer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acceso al mar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Meereszugang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toegang tot de zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доступ к морю</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">نفاذ إلى البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11527" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/25">
    <skos:prefLabel xml:lang="en">accident</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An unexpected occurrence, failure or loss with the potential for harming human life, property or the environment.
(Source: TOE /  HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accident</skos:prefLabel>
    <skos:prefLabel xml:lang="es">accidente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ongevallen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">авария</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неожиданное событие, неисправность или ущерб, представляющие опасность для человеческой жизни, собственности или окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حادثة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/30" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2766" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4971" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8583" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9366" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12784" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2215" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3872" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8219">
    <skos:prefLabel xml:lang="en">supply (trade)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The willingness and ability to sell a range of quantities of a good at a range of prices, during a given time period. Supply is one half of the market exchange process; the other is demand.
(Source: AMOS2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">offre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">oferta (comercio)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Angebot</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aanbod</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предложение (торговля)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Желание и способность продать ряд товаров по определенным ценам в течение конкретного периода времени. Предложение составляет одну из сторон процесса обмена на рынке; спрос является другой стороной.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توريد (تجارة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10940" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/28">
    <skos:prefLabel xml:lang="en">accidental release of organisms</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Genetically engineered organisms that are released in the environment by mistake; once released they may exhibit some previously unknown pathogenicity, might take over from some naturally occurring bacteria (possibly having other positive functions which thus are lost) or pass on some unwanted trait to such indigenous bacteria. There is also concern that an uncontrolled genetic mutation could produce a form with hazardous consequences for the environment.
(Source: WPRa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rejet accidentel d'organismes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">descarga accidental de organismos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unfallbedingtes Freisetzen von Organismen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het per ongeluk vrijkomen van organismen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброс биоматериала в результате аварий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организмы, полученные методами генной инженерии и по ошибке попавшие в окружающую среду. В результате такого выброса они могут проявить ранее неизвестную патогенность, могут истребить некоторые виды бактерий, встречающиеся в естественной среде и обладающие полезными функциями, которые, таким образом, теряются, либо передать им нежелательные свойства. Существует также опасность, что неконтролируемая генная мутация может привести к такой форме, которая будет представлять угрозу для окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انطلاق غير مقصود لكائنات عضوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7097" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/30">
    <skos:prefLabel xml:lang="en">accident source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The cause or origin of an unexpected occurrence, failure or loss with the potential for harming human life, property or the environment.
(Source: OED /  HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source d'accident</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuente de accidentes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unfallsursache</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oorzaak van een ongeluk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">причина аварии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Причина или первоисточник неожиданного события, неисправности или ущерба, представляющих опасность для человеческой жизни, собственности или окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر طارئ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/25" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5848" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8225">
    <skos:prefLabel xml:lang="en">surface runoff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Water that travels over the soil surface to the nearest surface stream; runoff of a drainage basin that has not passed beneath the surface since precipitation.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ruissellement de surface</skos:prefLabel>
    <skos:prefLabel xml:lang="es">salida de superficie</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Oberflächenabfluß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwatering van de oppervlakte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поверхностный сток воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вода, стекающая по поверхности почвы до ближайшего речного потока; сток дренажного бассейна, который не ушел в землю со времени последнего выпадения осадков.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الانسياب السطحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7340" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8226">
    <skos:prefLabel xml:lang="en">surface tension</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The force acting on the surface of a liquid, tending to minimize the area of the surface; quantitatively, the force that appears to act across a line of unit length on the surface. Also known as interfacial force; interfacial tension; surface intensity.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tension superficielle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tensión superficial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Oberflächenspannung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grensvlakspanning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">напряжение поверхности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сила, действующая на поверхность жидкости, уменьшающая ее площадь; в количественном отношении сила, действующая на единицу длины контура поверхности. Также используются термины "поверхностное натяжение", "напряжение поверхности раздела фаз".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوتر السطحي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8227">
    <skos:prefLabel xml:lang="en">surface treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any method of treating a material (metal, polymer, or wood) so as to alter the surface, rendering it receptive to inks, paints, lacquers, adhesives, and various other treatments, or resistant to weather or chemical attack.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement de surface</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de superficies</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Oberflächenbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oppervlaktebehandeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обработка поверхности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Метод обработки материала (металла, полимера, дерева), изменяющий его поверхность, придающий ей способность поглощать краски, лаки, адгезивы либо делающий эту поверхность устойчивой по отношению к химическому воздействию или воздействию погодных условий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة السطح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/36">
    <skos:prefLabel xml:lang="en">accumulation in body tissues</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">accumulation dans les tissues corporels</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acumulación en tejidos corporales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anreicherung im Körpergewebe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">weefselophoping</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">накопление в тканях тела</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تراكم في أنسجة الجسم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4049" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8229">
    <skos:prefLabel xml:lang="en">surface water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">All waters on the surface of the Earth found in streams, rivers, ponds, lakes, marshes or wetlands, and as ice and snow.
(Source: LANDY /  BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de surface</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas superficiales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Oberflächengewasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oppervlaktewater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">поверхностная вода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Все воды на поверхности Земли, находящиеся в реках, озерах, прудах, ручьях, болотах, а также в составе снега и ледников</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المياه السطحية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/984" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2323" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3485" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4333" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7402" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7574" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8448" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/38">
    <skos:prefLabel xml:lang="en">accumulator</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A rechargeable device for storing electrical energy in the form of chemical energy, consisting of one or more separate secondary cells.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accumulateur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acumulador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Akkumulator</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">accu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аккумуляторная батарея</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заряжаемое устройство для хранения электрической энергии в виде химической, состоящее из одной или нескольких отдельных секций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُجَمِّع - مُراكِم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2588" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2741" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/42">
    <skos:prefLabel xml:lang="en">acid deposition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A type of pollution which washes out of the atmosphere as dilute sulphuric and nitric acids. It tends to be a regional rather than a global phenomenon, linked to particular industrial activities and meteorological conditions. It includes rain, more than normally acidic snow, mist, sleet, fog, gas and dry particles. It upsets the balance of nature, disrupting ecosystems, and destroys forests and woodlands, plants and crops; kills aquatic life by altering the chemical balance of lakes and rivers and corrodes building materials and fabrics. The pollutants are caused principally by discharges from power station chimneys of sulphur dioxide and nitrogen oxides released by burning fossil fuels, coal and oil.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">retombée acide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">deposición ácida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Saure Deposition</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zure neerslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кислотные осадки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющие вещества, которые попадают в окружающую среду из атмосферы в виде разбавленной серной или азотной кислоты. Этот феномен представляется скорее региональным, а не глобальным явлением, связанным с особенностями деятельности промышленности и метеорологическими условиями. Включают дождь, снег повышенной кислотности, туман, смог, газ и твердые частицы. Нарушают природный баланс, разрушают экосистемы, уничтожают леса и растения лесной зоны, а также урожайные культуры. Нарушая водный баланс озер и рек, уничтожают водные организмы. Провоцируют коррозию металлов и разрушение других материалов. Причиной этого типа загрязнения являются выбросы диоксида серы и оксида азота тепловыми электростанциями в результате сжигания угля, нефти и газа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترسيب حمضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2084" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/51" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7844" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/44">
    <skos:prefLabel xml:lang="en">acidification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Addition of an acid to a solution until the pH falls below 7.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acidification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acidificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Versauerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verzuring</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подкисление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс добавления кислоты в раствор, пока значение pH не упадет ниже 7.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحميض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/51" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8237">
    <skos:prefLabel xml:lang="en">surplus</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The extent to which assets exceed liabilities, especially the profits remaining after operating expenses, taxes, interest and insurance costs are subtracted.
(Source: IVW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surplus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">excedentes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Überschuß</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overschot</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">положительный баланс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Остаток активов после вычета стоимости всех обязательств, включая капитал. Превышение доходов над расходами в течение определенного периода времени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فائض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10940" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/47">
    <skos:prefLabel xml:lang="en">acidity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The state of being acid that is of being capable of transferring a hydrogen ion in solution.
(Source: MGHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acidité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acidez</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Acidität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuurtegraad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кислотность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние кислоты, т.е. такое состояние, при котором вещество обладает способностью переносить в растворе ион водорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمضية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/48" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11671" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/48">
    <skos:prefLabel xml:lang="en">acidity degree</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of acid present in a solution, often expressed in terms of pH.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">degré d'acidité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">grado de acidez</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Säuregrad</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuurtegraa</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень кислотности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество кислоты, содержащееся в растворе, часто выражаемое в значении pH.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">درجة الحمضية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1673" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/47" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/731" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14636" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8">
    <skos:prefLabel xml:lang="en">abandoned vehicle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A vehicle that has been discarded in the environment, urban or otherwise, often found wrecked, destroyed, damaged or with a major component part stolen or missing.
(Source: ISEP /  MDM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">véhicule abandonné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vehículos abandonados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgestelltes Fahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verlaten voertuig</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">брошенный автомобиль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Автомобиль, выброшенный в условиях городской или иной среды, часто в поврежденном или испорченном состоянии, с недостающими или украденными основными частями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مَركَبة مهجورة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8926" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15027">
    <skos:prefLabel xml:lang="en">decantation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sizing or classifying particulate matter by suspension in a fluid (liquid or gas), the larger particulates tending to separate by sinking.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décantation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">decantación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dekantieren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">klaring van een vloeistof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">декантация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лабораторный и технический способ промывания осадков, а также извлечения растворимых соединений из твердых веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الصَفق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/52">
    <skos:prefLabel xml:lang="en">acid</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A compound capable of transferring a hydrogen ion in solution.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">acide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acidos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Säure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кислота</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическое вещество, способное переносить в растворе ион водорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2200" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4094" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/54">
    <skos:prefLabel xml:lang="en">acoustic filter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A device employed to reject sound in a particular range of frequencies while passing sound in another range of frequencies.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">filtre acoustique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">filtro acústico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Akustischer Filter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidsfilter</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">акустический фильтр</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Устройство, предназначенное отражать звук определенной частоты и пропускать звук других частот.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُرشِّح صوتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3184" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/55">
    <skos:prefLabel xml:lang="en">acoustic insulation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of preventing the transmission of sound by surrounding with a nonconducting material.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">isolation acoustique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aislamiento acústico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schallisolierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidsisolatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">звукоизоляция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предотвращение передачи звука в результате применения звукоизолирующего материала.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عزل صوتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4518" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5654" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/57">
    <skos:prefLabel xml:lang="en">acoustic level</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Physical quantity of sound measured, usually expressed in decibels.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau acoustique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel acústico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geräuschpegel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidsniveau</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">уровень звука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Физическая величина, полученная в результате замера звука, выражаемая в децибелах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى صوتي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4917" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5644" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7938" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11889" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7933" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7937" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8250">
    <skos:prefLabel xml:lang="en">sustainable use</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use of the environment and its living resources at a rate that does not exceed its capacity for renewal in order to ensure its availability for future generations.
(Source: DUNSTE /  UNUNa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">utilisation durable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">uso continuado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nachhaltige Bewirtschaftung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">duurzaam gebruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">устойчивое использование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование окружающей среды и ее живых ресурсов со скоростью, не превышающей их способности к возобновлению, обеспечивая их наличие для будущих поколений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخدام مستدام</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7172" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/59">
    <skos:prefLabel xml:lang="en">acoustic property</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The characteristics found within a structure that determine the quality of sound in its relevance to hearing.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">propriété acoustique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">propiedad acústica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Akustische Kenngröße</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidseigenschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">акустические свойства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойства структуры, характеризующие качество звука по отношению к его слышимости.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خاصية صوتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/60" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7942" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7945" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8252">
    <skos:prefLabel xml:lang="en">marsh</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An periodically inundated area of low ground having shrubs and trees, with or without the formation of peat.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marais</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pantanos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sumpf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">moeras</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">болото</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Низкий участок земли, периодически затопляемый водой, покрытый кустарниками или отдельными деревьями; не обязательно содержит в составе почв торф.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستنقع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9297" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7396" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10933">
    <skos:prefLabel xml:lang="en">living environment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">External conditions or surroundings in which people live or work.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cadre de vie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ámbito de vida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Belebte Umwelt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leefomgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">жизненная среда</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Внешние условия или окружающая среда, в которой люди живут либо работают.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيئة الحياة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7784" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/66">
    <skos:prefLabel xml:lang="en">actinide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of 15 radioactive elements some of which occur naturally while others are produced in nuclear reactions. They include plutonium, americium and neptunium. The health hazard presented by the actinides, if they are released into the environment, comes from the potency of their radioactive characteristics. They are alpha-emitters, and therefore can cause intense localized damage in tissues if absorbed into the body.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">actinide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actínidos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Actinoid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">actinide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">актиниды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа из 15 радиоактивных химических элементов. Некоторые из них встречаются в естественной природе, в то время как другие получены искусственно в ходе ядерных реакций. Среди этих элементов - плутоний, американий и нептуний. Риск здоровью, который несут актиниды в случае попадания в окружающую среду, связан с их радиоактивными свойствами. Эти вещества являются источниками альфа-излучения, которое в случае поглощения живым организмом может вызвать серьезное повреждение тканей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أكتينيد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/68" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6346" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8791" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12004" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8259">
    <skos:prefLabel xml:lang="en">symbiosis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A close and mutually beneficial association of organisms of different species.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">symbiose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">simbiosis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Symbiose</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">symbiose</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">симбиоз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тесная и взаимовыгодная взаимосвязь организмов различных видов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكافل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/819" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5465" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/68">
    <skos:prefLabel xml:lang="en">actinium</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A radioactive element of the actinide series, occurring as a decay product of uranium. It is used as an alpha particle source and in neutron production.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">actinium</skos:prefLabel>
    <skos:prefLabel xml:lang="es">actinio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Actinium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">actinium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">актиний</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Радиоактивный элемент группы актинидов, представляющий собой продукт разложения урана. Используется как источник альфа-частиц и в процессе производства нейтронов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أكتينيوم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/66" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8262">
    <skos:prefLabel xml:lang="en">synecology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study of the ecology of organisms, populations, communities or systems.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">synécologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sinecología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Synökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">synecologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экология сообществ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение экологии организмов, популяций, сообществ или систем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إيكولوجيا العضويات والسكان والجماعات والأنظمة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2470" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/819" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/901" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1613" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2438" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2519" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2531" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3358" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3808" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6519" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7976" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10495" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/71">
    <skos:prefLabel xml:lang="en">action group</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A collection of persons united to address specific sociopolitical or socioeconomic concerns.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">groupe d'action</skos:prefLabel>
    <skos:prefLabel xml:lang="es">grupo de acción</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bürgerinitiative</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">actiegroep</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">группа активистов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа людей, объединенных для решения конкретных социально-политических или социально-экономических вопросов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مجموعة عمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6594" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/72">
    <skos:prefLabel xml:lang="en">activated carbon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A powdered, granular or pelleted form of amorphous carbon characterized by a very large surface area per unit volume because of an enormous number of fine pores.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">charbon actif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carbón activo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aktivkohle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">actieve kool</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">активированный уголь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Аморфный углерод в порошкообразной, гранулированной или таблетированной форме, характеризующийся большой площадью поверхности по отношению к единице объема, благодаря наличию большого количества пор в своей структуре.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كربون مُنَشَّط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/73">
    <skos:prefLabel xml:lang="en">activated sludge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sludge that has been aerated and subjected to bacterial action; used to speed breakdown of organism matter in raw sewage during secondary waste treatment.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">boue activée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">lodos activados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Belebtschlamm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">actief slib</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">активный ил</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ил, полученный в результате аэрации и подвергшийся обработке бактериями. Используется для ускорения процесса разложения органических веществ в стоках в ходе вторичной переработки отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طين مُنَشَّط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8268">
    <skos:prefLabel xml:lang="en">synthetic detergent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An artificially produced solid or liquid cleansing substance that acts like soap but is stronger, and is capable of dissolving oily materials and dispersing them in water.
(Source: DOE / RIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">détergent synthétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">detergente sintético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Synthetische Reinigungs-/Waschmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">synthetisch detergent</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стиральный порошок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Искусственно созданное жидкое или твердое чистящее вещество, которое действует как мыло, но сильнее и способно разрушать жирные материалы и растворять их в воде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منظف صناعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2131" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8269">
    <skos:prefLabel xml:lang="en">synthetic fibres industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie des fibres synthétiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de fibras sintéticas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kunstfaserindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kunstvezelindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство синтетических волокон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الألياف الصناعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/78">
    <skos:prefLabel xml:lang="en">intervention on land</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Stepping in or participating in problem solving efforts for troublesome or perplexing situations involving ground areas or the earth's surface.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">intervention sur les terres</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intervención en la tierra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltschutzmaßnahmen auf dem Land</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tussenkomst op het land</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вмешательство на суше</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участие в разрешении сложной или конфликтной ситуации, затрагивающей участки суши или земной поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدخل في الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1456" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2015" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4611" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4628" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4641" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4646" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4969" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5295" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5843" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6997" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7091" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7104" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7419" />
