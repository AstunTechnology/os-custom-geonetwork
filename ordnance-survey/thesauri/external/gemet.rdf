    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4354">
    <skos:prefLabel xml:lang="en">insecticide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any chemical agent used to destroy invertebrate pests.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">insecticide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">insecticidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Insektizid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">insecticide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инсектицид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое химическое вещество, используемое для уничтожения беспозвоночных вредителей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مبيد حشري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/816" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1314" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1996" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4356">
    <skos:prefLabel xml:lang="en">insectivore</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any placental mammal of the order Insectivora, being typically small, with simple teeth, and feeding on invertebrates. The group includes shrews, moles, and hedgehogs.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">insectivores</skos:prefLabel>
    <skos:prefLabel xml:lang="es">insectívoros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Insektenfresser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">insecteneters</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">насекомоядное</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель плацентарных млекопитающих отряда  Insectivora, которое, как правило, отличается небольшими размерами, простыми зубами и питается беспозвоночными. Группа включает кротов, ежей и землероек.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آكلات الحشرات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4982" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/726">
    <skos:prefLabel xml:lang="en">baseline monitoring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Monitoring of long-term changes in atmospheric compositions of particular significance to the weather and the climate.
(Source: YOUNG)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station de référence de surveillance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vigilancia básica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grundüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">referentiemeting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">базовый мониторинг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мониторинг долгосрочных изменений в составе атмосферы, имеющих важное значение для изучения погоды и климата.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مراقبة خط الأساس</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5346" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4358">
    <skos:prefLabel xml:lang="en">insect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A class of the Arthropoda typically having a segmented body with an external, chitinous covering, a pair of compound eyes, a pair of antennae, three pairs of mouthparts, and two pairs of wings.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">insecte</skos:prefLabel>
    <skos:prefLabel xml:lang="es">insectos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Insekt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">insecten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">насекомое</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Класс Arthropoda, представители которого имеют сегментированное тело с внешним хитиновым покрытием, пару сложных глаз, пару усиков-антенн, челюсти, состоящие из трех частей, и две пары крыльев.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حشرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/571" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/764" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1028" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2093" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2409" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3288" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4127" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4777" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5802" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5945" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8381" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14507" />
