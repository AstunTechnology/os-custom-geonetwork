    <skos:prefLabel xml:lang="de">Ländliche Wasserversorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plattelandswatervoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельское водоснабжение</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">إمدادات الماء في المناطق الريفية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9244" />
