  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13190">
    <skos:prefLabel xml:lang="en">textile plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plant producing material suitable to be made into cloths.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plante textile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planta textil</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Textilpflanze</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">textielplant</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">текстильная сельскохозяйственная культура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растения, из которых изготавливают материал, пригодный для производства тканей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نباتات نسيجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6323" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10044" />
