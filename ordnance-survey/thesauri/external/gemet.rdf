    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5137">
    <skos:prefLabel xml:lang="en">discarded medicinal drug</skos:prefLabel>
