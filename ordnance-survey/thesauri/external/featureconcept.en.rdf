    <skos:prefLabel xml:lang="en">Traffic Separation Scheme</skos:prefLabel>
    <dct:description xml:lang="en">A scheme which aims at reducing the risk of collision in congested and/or converging areas by separating traffic moving in opposite, or nearly opposite, directions.</dct:description>
