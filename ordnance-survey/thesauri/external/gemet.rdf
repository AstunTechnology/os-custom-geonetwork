  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10707">
    <skos:prefLabel xml:lang="en">natural regeneration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The replacement by an organism of tissues or organs which have been lost or severely injured.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">régénération naturelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">regeneración natural</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Natürliche Regeneration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">natuurlijke regeneratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">естественная регенерация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Восстановление организмом тканей или органов, которые были утеряны или повреждены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التجدد الطبيعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
