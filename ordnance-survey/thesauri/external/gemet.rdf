    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4125" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4126">
    <skos:prefLabel xml:lang="en">hygiene</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science that deals with the principles and practices of good health.
(Source: MGH)</skos:scopeNote>
