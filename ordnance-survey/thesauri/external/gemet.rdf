  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1826">
    <skos:prefLabel xml:lang="en">national economic costs</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of money incurred as a result of the financial management of a nation's financial resources.
(Source: EFP / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie nationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">coste de economía nacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Volkswirtschaftliche Kosten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kosten van de binnenlandse economie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">национальные экономические расходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Расходы, понесенные вследствие менеджмента финансовых ресурсов страны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكاليف الاقتصاد الوطني</skos:prefLabel>
