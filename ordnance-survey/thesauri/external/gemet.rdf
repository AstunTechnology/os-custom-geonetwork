    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10191">
    <skos:prefLabel xml:lang="en">environmental analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étude de milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieuanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологический анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التحليل البيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2851" />
