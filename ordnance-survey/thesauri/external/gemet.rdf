    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/81">
    <skos:prefLabel xml:lang="en">adaptable species</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">espèce capable de s'adapter</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especies adaptables</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anpassungsfähige Art</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">soorten met aanpassingsvermogen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">адаптирующиеся виды</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">أنواع قادرة على التكيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7982" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/83">
    <skos:prefLabel xml:lang="en">adaptation period</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">période d'adaptation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">adaptación, período de</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anpassungsfrist</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aanpassingsperiode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">период адаптации</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">فترة التكيف - الفترة اللازمة للتكيف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/84">
    <skos:prefLabel xml:lang="en">chemical addition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical reaction in which one or more of the double bonds or triple bonds in an unsaturated compound is converted to a single bond by the addition of other atoms or groups.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">addition chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">adición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Addition</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemische toevoeging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">реакция присоединения (хим.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химическая реакция, в ходе которой одна или несколько двойных или тройных связей в ненасыщенном соединении преобразуются в единичную связь вследствие присоединения других атомов или групп.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إضافة كيميائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8278">
    <skos:prefLabel xml:lang="en">systems analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A means of organizing elements into an integrated analytic and/or decisionmaking procedure to achieve the best possible results.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse de système</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis de sistemas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Systemanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">systeemanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">системный анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средство организации элементов в процедуру для проведения интегрированного анализа и /или принятия решения в целях достижения наилучших результатов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل النظم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5097" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/87">
    <skos:prefLabel xml:lang="en">addition polymer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A polymer formed by the chain addition of unsaturated monomer molecules, such as olefins, with one another without the formation of a by-product, as water; examples are polyethylene, polypropylene and polystyrene.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polymère d'addition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">polímero adicional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Additionspolymer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toevoeging van een polymeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полимер, полученный в результате реакции присоединения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Полимер, полученный в результате цепочного соединения ненасыщенных мономерных молекул между собой, как, например, олефины, без образования побочного продукта, например, воды. Примерами являются полиэтилен, полипропилен и полистирол.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بلمرة بالإضافة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6505" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8280">
    <skos:prefLabel xml:lang="en">systems theory</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science concerned with the general study of structures and behaviours of systems which may be applicable in different branches of learning.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">théorie des systèmes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">teoría de sistemas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Systemtheorie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">systeemtheorie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">теория систем</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, посвященная общему изучению структур и поведения систем, применяемых в разных отраслях знаний.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظرية النُظُم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2510" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7604" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/90">
    <skos:prefLabel xml:lang="en">adhesive</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substance used for sticking objects together, such as glue, cement, or paste.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">adhésif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">adhesivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Klebstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kleefstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">адгезивные вещества</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, как, например, клей, цемент или клейстер, используемые для склеивания различных предметов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">لاصق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3695" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8283">
    <skos:prefLabel xml:lang="en">taking of evidence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">In criminal law and torts, the act of laying hold upon an evidence, with or without removing the same.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">instruction (droit)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">obtención de pruebas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beweiserhebung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het verzamelen van bewijzen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сбор доказательств (юридич.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В гражданском и уголовном праве поиск доказательств, необязательно связанный с их физическим сбором.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جمع الأدلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8284">
    <skos:prefLabel xml:lang="en">tanker (truck)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A truck designed for bulk shipment of liquids or gases.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">camion citerne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cisterna</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tankfahrzeug</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tankauto</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">грузовик для перевозки жидких грузов или газов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Грузовой автомобиль, предназначенный для перевозки жидкостей или газов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شاحنة نقل مواد سائلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4913" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2746">
    <skos:prefLabel xml:lang="en">energy supply</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The provision and storage of energy (the capacity to do work or produce a change), or the amount of energy stored, for the use of a municipality, or other energy user.
(Source: ISEP /  FFD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">approvisionnement en énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suministro energético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieversorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energievoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">снабжение энергией</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подача и хранение энергии (способность сделать работу или провести изменения) или величина сохраненной энергии для муниципальных нужд или для другого пользователя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإمداد بالطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6817" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2608" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2744" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8286">
    <skos:prefLabel xml:lang="en">tank farm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Storage space for containers of liquids or gases.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parc de stockage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación agrícola en depósito</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tanklager</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">olie-opslagterrein</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">танкерный склад</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Складская площадь для размещения контейнеров с жидкостями или газами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مجمع حاويات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/95">
    <skos:prefLabel xml:lang="en">administration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The management or direction of the affairs of a public or private office, business or organization.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">administration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">administración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс управления деятельностью организации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/103" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7411" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10833" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13289" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13290" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8289">
    <skos:prefLabel xml:lang="en">tannin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of a group of complex organic chemicals commonly found in leaves, unripe fruits, and the bark of trees. Their function is uncertain though the unpleasant taste may discourage grazing animals. Some tannins have commercial uses, notably in the production of leather and ink; used in tanning, as a mordant in dyeing, and in ink manufacture.
(Source: DICCHE /  UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tannin</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tanino</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gerbstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">looistof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">танин</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Представитель группы сложных органических соединений, широко распространенных в листьях, незрелых плодах, древесной коре. Функция этих веществ не определена, однако неприятный вкус может служить для отпугивания пасущихся животных. Некоторые виды танина имеют промышленное применение, в частности, в кожевенном производстве, производстве красок.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التانين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9358" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/813" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/816">
    <skos:prefLabel xml:lang="en">biocide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A diverse group of poisonous substance including preservatives, insecticides, disinfectants and pesticides used for the control of organisms that are harmful to human or animal health or that cause damage to natural or manufactured products.
(Source: GRAHAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biocide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biocidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biozid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biocide</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоцид</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разнообразная по составу группа ядовитых веществ, включая консерванты, инсектициды, дезинфицирующие вещества и пестициды, которые используются для осуществления контроля над организмами, вредными для человека, здоровья животных либо которые причиняют вред сырьевым и промышленным продуктам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مبيد حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/305" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/700" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3530" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3933" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4354" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6140" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10939">
    <skos:prefLabel xml:lang="en">living standard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A measurement of the development level in a country or community, gauged by factors such as personal income, education, life expectancy, food consumption, health care, technology and the use of natural resources.
(Source: TEX)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau de vie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel de vida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebensstandard</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leefnorm</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стандарт жизни</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Показатель уровня развития страны или общества, измеряемый такими факторами, как личный доход, образование, продолжительность жизни, потребление продуктов питания, уровень развития здравоохранения, технологий и использование природных ресурсов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى المعيشة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7784" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/100">
    <skos:prefLabel xml:lang="en">administrative body</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any governmental agency or organization charged with managing and implementing regulations, laws and government policies.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">code administratif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organos administrativos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsbehörde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestuurslichaam</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">административный орган</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое правительственное ведомство или организация, уполномоченное управлять и исполнять распоряжения, постановления, законы и политику правительства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيئة إدارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13292" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/661" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/103">
    <skos:prefLabel xml:lang="en">administrative competence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The skill, knowledge, qualification, capacity or authority to manage or direct the affairs of a public or private office, business or organization.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compétence administrative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">competencia administrativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungskompetenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestuursbevoegdheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">компетентность административного персонала</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Навыки, знания, профессионализм, способность и полномочия вести и управлять деятельностью государственного или частного органа, коммерческой структуры или организации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كفاءة إدارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/95" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4541" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4760" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4994" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5811" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7184" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10988" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11535" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11548" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8296">
    <skos:prefLabel xml:lang="en">tar</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A viscous material composed of complex, high-molecular-weight, compounds derived from the distillation of petroleum or the destructive distillation of wood or coal.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">goudron</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alquitrán</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">teer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">деготь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вязкий материал, состоящий из сложных соединений с высокой молекулярной массой, полученных в процессе перегонки нефти либо возгонки древесины или угля.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قار - قطران</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1042" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/105">
    <skos:prefLabel xml:lang="en">administrative fiat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An authoritative decree, sanction or order issued from an office with executive or managerial authority, without necessarily having the force of law or its equivalent.
(Source: RHW / BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">autorisation administrative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">autorización administrativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungszwang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestuurlijke goedkeuring</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">административный приказ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Декрет, санкция или приказ органа власти, наделенного исполнительными или управленческими полномочиями, не обязательно обладающий силой закона или эквивалентного акта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أمر إداري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5459">
    <skos:prefLabel xml:lang="en">mutagen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An agent that raises the frequency of mutation above the spontaneous rate. An agent that causes changes to plants and animals, particularly to their genetic material and especially at the time of reproduction. Certain chemicals and forms of radiation are powerful mutagens that damage the DNA, or genetic material in the centre of every cell of a living organism.
(Source: MGH /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substances mutagènes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mutágeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mutagener Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mutagene stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мутаген</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Реагент, повышающий частоту мутаций по сравнению с уровнем спонтанных мутаций. Реагент, вызывающий изменения в организмах растений и животных, особенно в их генетическом материале и особенно в репродуктивный период. Мутагенами являются некоторые виды химикатов и излучения, которые нарушают состав ДНК или генетический материал, находящийся в ядре каждой клетки живого организма.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مطفر - مادة مطفرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/107">
    <skos:prefLabel xml:lang="en">administrative jurisdiction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The extent, power or territory in which an office with executive or managerial authority administers justice or declares judgments.
(Source: RHW / BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">juridiction administrative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">jurisdicción administrativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsgerichtsbarkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">administratief rechtsgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">административная юрисдикция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Степень, сила или территория, на которой орган с исполнительскими или управленческими полномочиями отправляет правосудие или выносит судебные решения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ولاية إدارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4541" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/108">
    <skos:prefLabel xml:lang="en">administrative law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Body of law created by administrative agencies in the form of rules, regulations, orders and decisions to carry out regulatory powers and duties of such agencies.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit administratif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho administrativo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">administratief recht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">административное право</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль права, создаваемая административными органами в форме правил, решений, приказов в целях реализации регулирующих функций и обязанностей этих органов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون إداري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10084" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11497" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8301">
    <skos:prefLabel xml:lang="en">tariff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A classified list or scale of charges made in any private or public business.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tarif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tarifa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tarif</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tarief</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тариф</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Классифицированный список или шкала ставок, применяемых в любом частном или государственном виде бизнеса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعريفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6602" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13241" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/111">
    <skos:prefLabel xml:lang="en">administrative procedure</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">procédure administrative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procedimiento administrativo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsvorgang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">administratieve procedure</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">административная процедура</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">إجراء إداري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/95" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/21" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/105" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/130" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/654" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/662" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1445" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1447" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1663" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2127" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2753" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4262" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4360" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4404" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4741" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6124" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6709" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7082" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7165" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7192" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7217" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7218" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7221" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7581" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10981" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11489" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11490" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11527" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11627" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/112">
    <skos:prefLabel xml:lang="en">administrative sanction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Generally, any formal official imposition of penalty or fine; destruction, taking, seizure, or withholding of property; assessment of damages, reimbursement, restitution, compensation, costs, charges or fees; requirement, revocation or suspension of license; and taking other compulsory or restrictive action by organization, agency or its representative.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sanction administrative</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanciones administrativas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verwaltungsgenehmigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">administratieve sanctie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">административная санкция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Как правило, любое официальное наложение штрафа или наказание; разрушение, овладение, захват или удержание имущества; оценка ущерба, возмещения, реституции: компенсации: затрат, штрафов или сборов; требование, отзыв или приостановление действия лицензии, а также любые другие действия обязательного или ограничительного характера, производимые организацией, агентством или их представителем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عقوبة إدارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7411" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8305">
    <skos:prefLabel xml:lang="en">tar use</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any employment or utilization of dark, heavy, viscous substances or residue derived from the distillation of certain organic materials, often to produce benzene, soap, dyes, cosmetics and other products.
(Source: ENC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">emploi du goudron</skos:prefLabel>
    <skos:prefLabel xml:lang="es">uso de alquitrán</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teernutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">teergebruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">использование дегтя</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение или использование темных, тяжелых, вязких веществ или остатков, получаемых в ходе перегонки или возгонки органических материалов, таких как уголь, нефть или древесина.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخدام القار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7276" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8307">
    <skos:prefLabel xml:lang="en">tax</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An amount of money demanded by a government for its support or for specific facilities or services, most frequently levied upon income, property or sales.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taxe</skos:prefLabel>
    <skos:prefLabel xml:lang="es">impuestos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steuer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Денежный сбор, собираемый для поддержки государства или его специфических служб и взимаемый, как правило, с дохода, имущества или продаж.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضريبة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8308" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13250" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13251" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13252" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14499" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8308">
    <skos:prefLabel xml:lang="en">taxation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act or result of a government requiring money for its support or for specific facilities or services.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">taxation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">impuestos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Besteuerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belasting (heffen op)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налогообложение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательная уплата денег государству физическими лицами и организациями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فرض الضرائب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4784" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8307" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10120" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13253" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13555" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8309">
    <skos:prefLabel xml:lang="en">tax differentiation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">différenciation fiscale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">diferenciación de tasas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Steuerdifferenzierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">heffingsonderscheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дифференциация налогов</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تمييز ضريبي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13253" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/120">
    <skos:prefLabel xml:lang="en">adsorption</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The physical or chemical bonding of molecules of gas, liquid or a dissolved substance to the external surface of a solid or the internal surface, if the material is porous, in a very thin layer.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">adsorption</skos:prefLabel>
    <skos:prefLabel xml:lang="es">captación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Adsorption</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">adsorptie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">адсорбция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Физическая или химическая связь молекул газа, жидкости или растворенного вещества с внешней поверхностью твердого тела или его внутренней поверхностью в случаях, когда материал обладает пористой структурой, с образованием тонкого слоя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">امتصاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7930" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/20">
    <skos:prefLabel xml:lang="en">acceptable risk level</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Level of risk judged to be outweighed by corresponding benefits or one that is of such a degree that it is considered to pose minimal potential for adverse effects.
(Source: EPAGLOa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">niveau de risque acceptable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">nivel de riesgo aceptable</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zulässiges Risikoniveau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toelaatbaar risico</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">приемлемый уровень риска</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Уровень риска, который может быть компенсирован соответствующими преимуществами или при котором отрицательные последствия представляются минимальными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مستوى مخاطرة مقبول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7236" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/122">
    <skos:prefLabel xml:lang="en">adult education</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any instruction or training, informal or formal, which is geared to persons of mature age, regardless of previous education, and typically offered by university extension programs, employers, correspondence courses or community groups.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">formation pour adultes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">educación de adultos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erwachsenenbildung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">volwassenenonderwijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обучение взрослого населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое образование или обучение, формальное или неформальное, предназначенное для взрослых людей, независимо от полученного ими предыдущего образования, которое предлагается, как правило, на вечерних курсах при университетах,  работодателями, на заочных факультетах или общественными организациями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعليم الكبار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13307" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/126">
    <skos:prefLabel xml:lang="en">advertisement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The action of drawing public attention to goods, services or events, often through paid announcements in newspapers, magazines, television or radio.
(Source: C / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">publicité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">publicidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Werbung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aankondiging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">реклама</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие или практика, направленная на привлечение внимания общественности к товарам, услугам, событиям и т.д.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعلان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6801" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8213">
    <skos:prefLabel xml:lang="en">supervision of installation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The oversight or direction over the process of setting up or making adjustments to a building or to a mechanical or electrical system or apparatus.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surveillance d'installations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">supervisión de instalaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anlagenüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toezicht houden op installaties</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">контроль за установкой оборудования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наблюдение или руководство процессом установки или внесения изменений в механическую или электрическую систему, аппарат.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإشراف على التجهيزات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8212" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/129">
    <skos:prefLabel xml:lang="en">product advertising</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The creation and dissemination of paid announcements or public notices to draw attention to goods, services or events offered by some entity, usually for purchase.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">publicité pour un produit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">publicidad de producto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Produktwerbung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">productreklame</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">реклама товаров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Создание и распространение оплаченных или бесплатных объявлений в целях привлечения внимания к товарам, услугам, мероприятиям, предлагаемым конкретными организациями, как правило, для продажи или реализации на коммерческих условиях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعلان عن منتج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/126" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/130">
    <skos:prefLabel xml:lang="en">advice</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An official notice, opinion, counsel or recommendation that is optional or at the receiver's discretion.
(Source: BLD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bon de livraison</skos:prefLabel>
    <skos:prefLabel xml:lang="es">consejo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gutachten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">raad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">совет, консультация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сообщение, мнение или рекомендация, исполнение которых необязательно или находится на усмотрении того, кому они предназначены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إخطار، فتوى، توصية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2769" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/132">
    <skos:prefLabel xml:lang="en">aeration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Exposition to the action of air.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aération</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aeración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Belüftung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beluchting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэрация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс воздействия воздуха на что-либо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تهوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12277" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8940" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/22">
    <skos:prefLabel xml:lang="en">access road</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any street or narrow stretch of paved surface that leads to a specific destination, such as a main highway.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">route d'accès</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carretera de acceso</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zufahrtsstraße</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">toegangsweg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подъездные дороги</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая дорога или узкая полоса земли с твердым покрытием, которая ведет к конкретному пункту назначения, например, к главной дороге.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طريق وصول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7272" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8326">
    <skos:prefLabel xml:lang="en">technical regulation for dangerous substances</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Technical Guideline for Dangerous Substances: technical rules for handling dangerous materials.
(Source: FKTa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">TRGS</skos:prefLabel>
    <skos:prefLabel xml:lang="es">TRGS &lt;D&gt;</skos:prefLabel>
    <skos:prefLabel xml:lang="de">TRGS</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">TRGS</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">техническое руководство по обращению с опасными веществами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Техническое руководство по обращению с опасными веществами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنظيم التقني للمواد الخطرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8047" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/135">
    <skos:prefLabel xml:lang="en">aerial photograph</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An image of the ground surface made on a light-sensitive material and taken at a high altitude from an aircraft, spacecraft or rocket.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">photographie aérienne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fotografía aérea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Luftbild</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">luchtfoto</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэрофотоснимок</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изображение земной поверхности, полученное на светочувствительном материале на большой высоте с борта самолета, космического аппарата или ракеты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صورة جوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6205" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8330">
    <skos:prefLabel xml:lang="en">technological change</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Changing of industrial methods by introducing new technology.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">changement technologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cambio tecnológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologischer Wandel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologische verandering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технологическое изменение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изменение промышленных методов в результате внедрения новой технологии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تغير تكنولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8339" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5585" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8333" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8342" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8333">
    <skos:prefLabel xml:lang="en">technological development</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">développement technologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">desarrollo tecnológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologische Entwicklung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologische ontwikkeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технологическое развитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تطور تكنولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8330" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8334">
    <skos:prefLabel xml:lang="en">technological hazard</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any application of practical or mechanical sciences to industry or commerce capable of harming persons, property or the environment.
(Source: ISEP /  FFD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">risque technologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">peligro tecnológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technische Gefahr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologisch gevaar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технологическая угроза</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение разработок прикладных или технических наук в промышленности или коммерческой деятельности, способных нанести ущерб физическим лицам, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطر تكنولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3852" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7233" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12814" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12784" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12807" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/143">
    <skos:prefLabel xml:lang="en">aerobic condition</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Life common to the majority of animal and plants species requiring the presence of oxygen.
(Source: LAROUSa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aérobiose</skos:prefLabel>
    <skos:prefLabel xml:lang="es">condiciones aeróbicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aerobe Bedingung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aërobe voorwaarden</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэробные условия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жизненные условия, характерные для большинства животных и растительных видов и предполагающие присутствие кислорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الظرف الهوائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8337">
    <skos:prefLabel xml:lang="en">technological process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">procédé technologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso tecnológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologische Prozesse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologisch proces</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технологический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية تكنولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8339" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/146">
    <skos:prefLabel xml:lang="en">aerobic process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A process requiring the presence of oxygen.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus aérobie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso aeróbico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aerober Prozess</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aëroob proces</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэробный процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, требующий присутствия кислорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية هوائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/812" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8339">
    <skos:prefLabel xml:lang="en">technology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Systematic knowledge of and its application to industrial processes; closely related to engineering and science.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tecnología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">технология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Систематизированные знания и их применение в промышленных процессах; тесно связаны с инженерной и научной сферами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكنولوجيا</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/898" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1728" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2707" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2747" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2932" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3391" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4313" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6654" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8330" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8337" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3014" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7584" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/148">
    <skos:prefLabel xml:lang="en">aerobiology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the atmospheric dispersal of airborne fungus spores, pollen grains, and microorganisms; and, more broadly, of airborne propagules of algae and protozoans, minute insects such as aphids, and pollution gases and particles which exert specific biologic effects.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aérobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biología del aire</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aerobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aërobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэробиология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение распространения в атмосфере спор грибов, пыльцы и микроорганизмов; в более широком смысле: находящихся в воздухе частиц водорослей и протозоанов, мельчайших насекомых, таких как растительная тля, загрязняющих газов и частиц, которые обладают специфическим биологическим воздействием.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيولوجيا الهواء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6392" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8341">
    <skos:prefLabel xml:lang="en">technology assessment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The systematic analysis of the anticipated impact of a particular technology in regard to its safety and efficacy as well as its social, political, economic, and ethical consequences.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation des technologies</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación tecnológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technology Assessment</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologiebeoordeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка технологии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Систематизированный анализ предполагаемого воздействия конкретной технологии в плане безопасности, эффективности, а также социальных, политических, экономических и этических последствий ее внедрения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم التكنولوجيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7236" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8342">
    <skos:prefLabel xml:lang="en">technology transfer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The transfer of development and design work: a) from a parent company to a subsidiary, perhaps in another nation where it will be paid for in repatriated profits or royalties; b) from one country to another as a form of aid to help promote development and sustainable growth. Many nations have made great progress on the strength of technology transfer.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transfert de technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transferencia de tecnología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Technologietransfer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">technologie-overdracht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">передача технологии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Передача научно-исследовательских и конструкторских разработок: a) от материнской компании филиалу, возможно, в другой стране, с оплатой в виде фиксированной суммы регулярных отчислений или репатриации прибыли; b) от одной страны другой в виде помощи, содействующей устойчивому развитию. Многие страны достигли больших экономических успехов на основе передачи технологий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقل التكنولوجيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8330" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/151">
    <skos:prefLabel xml:lang="en">aerodynamic noise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Acoustic noise caused by turbulent airflow over the surface of a body.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bruit aérodynamique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruido aerodinámico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aerodynamisches Geräusch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aërodynamisch geluid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэродинамический шум</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Шум, вызванный турбулентным обтеканием поверхности объекта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضجيج بسبب ديناميكا الهواء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5658" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8344">
    <skos:prefLabel xml:lang="en">tectonics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A branch of geology dealing with the broad architecture of the outer part of the Earth, that is, the regional assembling of structural or deformation features, a study of their mutual relations, origin and historical evolution.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tectonique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tectónica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tektonik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tektoniek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тектоника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль геологии, изучающая развитие структуры земной коры и ее изменения под влиянием тектонических движений и деформаций, связанных с развитием Земли в целом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم البنائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3650" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8347">
    <skos:prefLabel xml:lang="en">telecommunications</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The conveyance of images, speech and other sounds, usually over great distances, through technological means, particularly by television, telegraph, telephone or radio.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">télécommunication</skos:prefLabel>
    <skos:prefLabel xml:lang="es">telecomunicaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Telekommunikation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">telecommunicatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">телекоммуникация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука и технология связи по телефону, радио, ТВ и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاتصالات اللاسلكية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1605" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6279">
    <skos:prefLabel xml:lang="en">plan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A scheme of action, a method of proceeding thought out in advance.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">plan</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plan</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Plan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">план</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Последовательность действий, метод, продуманный заранее.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خطة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2889" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/235" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/336" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2161" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2890" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4990" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7000" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7073" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7444" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8151" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8562" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10263" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11248" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11930" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6287" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/157">
    <skos:prefLabel xml:lang="en">aerosol</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A gaseous suspension of ultramicroscopic particles of a liquid or a solid.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aérosol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aerosoles</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aerosol</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aërosol</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэрозоль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газообразная взвесь мельчайших частиц жидкости или твердого вещества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أيروسول</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8072" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/623" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8019" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8350">
    <skos:prefLabel xml:lang="en">telematics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The convergence of computing and communications technologies, thus the use of telephone or radio to link computers and the use of computers to send messages via telephone or radio links.
(Source: NECTAR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">télématique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">telemática</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Telematik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">telematica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">телематика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соединение компьютерных технологий и технологий связи, например, использование телефона или радио для соединения компьютеров, а также использование компьютеров для передачи сообщений через телефонную или радиосвязь.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التيليماتيك - تكنولوجيا الكمبيوتر والاتصالات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6817" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8351">
    <skos:prefLabel xml:lang="en">telemetry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of radio waves, telephone lines, etc., to transmit the readings of measuring instruments to a device on which the readings can be indicated or recorded.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">télémétrie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">telemetría</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Telemetrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">telemetrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">телеметрия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование радиоволн, телефонных линий и пр. для передачи показаний измерительных приборов к устройству, которое способно эти измерения отразить или записать.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القياس عن بعد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5203" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7102" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5346" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8353">
    <skos:prefLabel xml:lang="en">television</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process, equipment or programming involved in converting a succession of audiovisual images into corresponding electrical signals that are transmitted by means of electromagnetic waves to distant receivers or screens, at which the signals can be used to reproduce the original image.
(Source: MHD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">télévision</skos:prefLabel>
    <skos:prefLabel xml:lang="es">televisión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fernsehen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">televisie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">телевидение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система или процесс образования на удаленном экране последовательности визуальных образов, обычно сопровождаемых звуковым сигналом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التليفزيون - التلفاز</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5079" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14875" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/163">
    <skos:prefLabel xml:lang="en">aesthetics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Considerations, values, and judgements pertaining to the quality of the human perceptual experience (including sight, sound, smell, touch, taste, and movement) evoked by phenomena or components of the environment.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">esthétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ästhetik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">esthetica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эстетика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соображения, ценности, суждения, относящиеся к качественной стороне человеческого восприятия (включая зрение, слух, обоняние, осязание и движение), вызванные феноменом или компонентами окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جماليات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6187" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/167">
    <skos:prefLabel xml:lang="en">afforestation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Establishment of a new forest by seeding or planting of nonforested land.
2) The planting of trees on land which was previously used for other uses than forestry.
3) The planting of trees in an area, or the management of an area to allow trees to regenerate or colonize naturally, in order to produce a forest.
(Source: MGH /  WRIGHT /  ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">boisement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">repoblación forestal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aufforstung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bosaanplanting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">облесение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Образование нового леса в результате высадки саженцев на территории, не занятой лесом. 2) Высадка саженцев деревьев на территории, которая в прошлом была занята под другой вид хозяйственной деятельности. 3) Высадка деревьев в районе или такое управление районом, которое позволяет деревьям восстанавливаться и размножаться естественным порядком, образуя новый лес.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشجير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3439" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6979" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10683" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8360">
    <skos:prefLabel xml:lang="en">temperate ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interacting system of a biological community and its non-living environmental surroundings in regions of or related to moderate climates, intermediate between tropical and polar zones and having distinct warm to hot summer seasons and cool to cold winter seasons.
(Source: TOE / DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème des zones tempérées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema templado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ökosystem der gemäßigten Zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gematigd ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема региона с умеренным климатом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимодействующая система биологических сообществ и их неживых окружающих условий в регионах, расположенных или связанных с умеренным климатом, занимающих переходное положение между тропической и полярной зонами и имеющих выраженный летний сезон с характером температуры от теплой до жаркой и зимний сезон с характером температуры от прохладной до холодной.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للمناطق المعتدلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8361">
    <skos:prefLabel xml:lang="en">temperate forest</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Mixed forest of conifers and broad-leaf deciduous trees, or mixed conifer and broad-leaf evergreen trees, or entirely broad-leaf deciduous, or entirely broad-leaf evergreen trees, found in temperate regions across the world; characterized by high rainfall, warm summers, cold winters occasionally subzero, seasonality; typically with dense canopies, understorey saplings and tall shrubs, large animals, carnivores dominant, very rich in bird species.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">forêt des zones tempérées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bosques de zona templada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Temperater Forst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bos in de gematigde klimaatzone</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лес умеренной климатической зоны</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Смешанный лес из хвойных и широколиственных листопадных деревьев либо хвойных и широколиственных вечнозеленых растений, либо только из широколиственных листопадных деревьев, распространенный в умеренных климатических зонах во всем мире; характеризуется высоким уровнем осадков, теплым летом, холодной зимой, иногда с температурой ниже 0 градусов С, сезонностью; отличается плотным лиственным шатром, большим количество молодых деревьев и кустарников на нижних ярусах, наличием крупных животных, среди которых преобладают хищники, большим видовым разнообразием птиц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غابات المناطق المعتدلة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3406" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10695" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8362" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/170">
    <skos:prefLabel xml:lang="en">Africa</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The second largest of the continents, on the Mediterranean in the north, the Atlantic in the west, and the Red Sea, Gulf of Aden, and Indian Ocean in the east. The Sahara desert divides the continent unequally into North Africa and Africa south of Sahara. The largest lake is Lake Victoria and the chief rivers are the Nile, Niger, Congo, and Zambezi. The hottest continent, Africa has vast mineral resources, many of which are still undeveloped.
(Source: CED /  AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Afrique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Africa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Afrika</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Afrika</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Африка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Второй по величине континент, омывается водами Средиземного моря на севере, Атлантического океана на западе, Красного моря, Аденского залива и Индийского океана на востоке. Пустыня Сахара разделяет континент на две неравные части - Северную Африку и Африку, расположенную к югу от Сахары. Крупнейшее озеро - оз.Виктория, главные реки - Нил, Нигер, Конго и Замбези. Континент отличается самым жарким климатом и богатыми природными ресурсами, многие из которых пока еще не разработаны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أفريقيا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9380" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1255" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2411" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5692" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7950" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9293" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/171">
    <skos:prefLabel xml:lang="en">afterburning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An afterburner is a gadget fitted to the exhaust flues of furnaces and also to the exhaust systems of motor vehicles. They remove polluting gases and particles, which are the result of incompletely combusted fuel, by incineration and break down other chemical molecules associated with combustion into inert chemicals.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">post-combustion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">postcombustión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nachverbrennung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">naverbranding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">дожигание</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, осуществляемый дожигателем, который представляет собой устройство, встраиваемое в дымовые трубы печей, а также в выхлопную систему автомобиля. Удаляет загрязняющие газы или частицы, являющиеся результатом неполного сгорания топлива, путем сжигания и разрушения химических соединений с образованием инертных химических веществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ما بعد الاحتراق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12605" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/173">
    <skos:prefLabel xml:lang="en">age</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The period of time that a person, animal or plant has lived or is expected to live.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">âge</skos:prefLabel>
    <skos:prefLabel xml:lang="es">edad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lebensalter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">leeftijd</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">возраст</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Период времени, в течение которого человек, животное или растение жили или должны жить.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العُمر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/846" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9407" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8366">
    <skos:prefLabel xml:lang="en">temperature</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A property that determines the direction of heat flow when an object is brought into thermal contact with other objects: heat flows from regions of higher to those of lower temperatures.
(Source: PITT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">température</skos:prefLabel>
    <skos:prefLabel xml:lang="es">temperatura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Temperatur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">temperatuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">температура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Свойство, определяющее направление потока тепла, когда объект вступает в термический контакт с другими объектами: тепло распространяется из зоны с более высокой температурой в зону более низких температур.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">درجة الحرارة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8367">
    <skos:prefLabel xml:lang="en">temporary housing</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">logement provisoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vivienda temporal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vorübergehende Unterkunft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tijdelijke bewoning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">временное жилище</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">إسكان مؤقت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4022" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10203">
    <skos:prefLabel xml:lang="en">forest biological reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Forest areas which are protected and guarded from deforestation because of the fragility of its ecosystems, and because they provide habitats for hundreds of species of plants and animals.
(Source: TOURISa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve biologique forestière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reserva biológica forestal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologisches Forstreservat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologisch bosreservaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лесной биологический заповедник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лесные районы, охраняемые от разрушения из-за неустойчивости их экосистемы, а также потому, что они обеспечивают условия жизни для сотен видов растений и животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية بيولوجية في غابة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3435" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8369">
    <skos:prefLabel xml:lang="en">temporary shelter</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Simple facilities for asylum or provisional lodgings to individuals or groups in emergencies.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">abri provisoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">albergue temporal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Behelfsunterkunft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tijdelijke schuilplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">временный кров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Простые сооружения, обеспечивающие убежище или временное жилье отдельным лицам или группам в чрезвычайных ситуациях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مأوى مؤقت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8627" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8371">
    <skos:prefLabel xml:lang="en">temporary storage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any deposit or holdings of goods, materials or waste in a facility, container, tank or some other physical location for a brief or short time period.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stockage temporaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">almacenamiento temporal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zwischenlagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tijdelijke opslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">временное хранение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Размещение или хранение товаров, материалов, отходов на объекте, в контейнере, цистерне и пр. в течение короткого периода времени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخزين مؤقت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14976" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12318">
    <skos:prefLabel xml:lang="en">waste sorting unit</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Centralized recycling centres to which waste materials are brought and where they are separated.
(Source: CORBIT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">centre de tri (déchets)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">unidad de clasificación de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallsortierungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalsorteringseenheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">предприятие по сортировке мусора</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Централизованное предприятие по переработке отходов, куда они свозятся и где сортируются.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وحدة فرز المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9116" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/182">
    <skos:prefLabel xml:lang="en">agreement (legal)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The coming together in accord of two minds on a given proposition. In law, a concord of understanding and intention between two or more parties with respect to the effect upon their relative rights and duties, of certain past or future facts or performances. The consent of two or more persons concerning respecting the transmission of some property, right, or benefits, with the view of contracting an obligation, a mutual obligation.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contrat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acuerdos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vertrag</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overeenkomst (wettige/wettelijke)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соглашение (юридич.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Согласованность двух мнений по конкретному вопросу. В праве: взаимопонимание и намерение двух или более сторон, с учетом вытекающих из этого взаимных прав и обязанностей, в отношении конкретных фактов или действий настоящего или будущего времени. Согласие двух или более лиц уважать передачу собственности, прав или преимуществ в обмен на какое-либо обязательство или  взаимное обязательство. Единство двух или более намерений по какому-либо вопросу или предполагаемому действию; взаимное согласие предпринять что-либо.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاق (قانون)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10085" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/183">
    <skos:prefLabel xml:lang="en">agreement (contract)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An agreement, convention, or promise of two or more parties, by deed in writing, signed, and delivered, by which either of the parties pledges himself to the other that something is either done, or shall be done, or shall not be done, or stipulates for the truth of certain facts.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accord</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acuerdo (contrato)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Übereinkommen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">overeenkomst (contract)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">соглашение (контракт)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Договоренность, конвенция или обещание двух или более сторон, совершенные в письменной форме, подписанные и исполненные, в соответствии с которыми одна из сторон берет на себя обязательства перед другой стороной совершать, совершить или не совершить что-либо или подтверждает достоверность каких-либо фактов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاق (عقد)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13242" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1762" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1776" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8376">
    <skos:prefLabel xml:lang="en">teratogenesis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process whereby abnormalities of the offspring are generated, usually as the result of damage to the embryonal structure during the first trimester of pregnancy, producing deformity of the fetus.
(Source: CONFER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tératogenèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">teratogénesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teratogenität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">teratogenese</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тератогенез</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого формируются отклонения от нормы у потомства, обычно в результате повреждения эмбриональной структуры в течение первого триместра беременности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توليد المسوخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6065" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8377">
    <skos:prefLabel xml:lang="en">teratogenesis screening</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">dépistage de la tératogénèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">investigación de teratogénesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teratogenitätsprüfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">controle op teratogenese</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">проверка на тератогенез</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">اقتفاء المسوخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6798" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6600" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/186">
    <skos:prefLabel xml:lang="en">agricultural building</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The buildings and adjacent service areas of a farm.
(Source: WEBSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bâtiment agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">construcción agricola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirtschaftsgebäude</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwgebouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственное строение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Здания фермы и вспомогательные постройки на прилегающих к ферме территориях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منشأة زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13136" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7697" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8037" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8379">
    <skos:prefLabel xml:lang="en">teratogen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substances causing formation of a congenital anomaly or monstrosity in the embryo.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agent tératogène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">teratógenos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teratogener Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">teratogeen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тератоген</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, вызывающие образование врожденной аномалии или уродства эмбриона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل مسخ</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2233" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8380">
    <skos:prefLabel xml:lang="en">terminology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The body of specialized words relating to a particular subject.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">terminologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">terminología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Terminologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">terminologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">терминология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объем специальной лексики, относящейся к конкретному предмету.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصطلحات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4303" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2934" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8381">
    <skos:prefLabel xml:lang="en">termite</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A soft-bodied insect of the order Isoptera; individuals feed on cellulose and live in colonies with a caste system comprising three types of functional individuals: sterile workers and soldiers, and the reproductives. Also known as white ant.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">termites</skos:prefLabel>
    <skos:prefLabel xml:lang="es">termitas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Termite</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">termieten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">термит</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Насекомое с мягким телом отряда Isoptera; взрослые особи питаются целлюлозным материалом и живут колониями, имеющими кастовую структуру с четким выделением трех основных категорий членов сообщества в соответствии с их функциями: бесплодные рабочие и солдаты, а также репродуктивные особи. Также еще называются "белыми муравьями".</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النمل الأبيض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4358" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/191">
    <skos:prefLabel xml:lang="en">agricultural ecology</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">écologie agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecología agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarökologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouw en milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экология сельского хозяйства</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الإيكولوجيا الزراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10129" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/193">
    <skos:prefLabel xml:lang="en">agricultural economics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An applied social science that deals with the production, distribution, and consumption of agricultural or farming goods and services.
(Source: AGP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">economie agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">economía agropecuaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarökonomie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouweconomie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономика сельского хозяйства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Прикладная общественная наука, изучающая производство, распределение и потребление сельскохозяйственной продукции и услуг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الاقتصاد الزراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2516" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4686" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11234" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2501" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8386">
    <skos:prefLabel xml:lang="en">terrestrial area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Subdivisions of the continental surfaces distinguished from one another on the basis of the form, roughness, and surface composition of the land.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">áreas terrestres</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Terrestrische Gebiete</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">terrestrisch gebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">суша</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разновидности поверхности континентов, разделяемые по их форме, типу неровностей и составу поверхностного слоя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة أرضية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5494" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/552" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1020" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3406" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3564" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3673" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3733" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3893" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4545" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4590" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5023" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5405" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6276" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8704" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8997" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9297" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10071" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12145" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/195">
    <skos:prefLabel xml:lang="en">agricultural engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A discipline concerned with developing and improving the means for providing food and fiber for mankind's needs.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">génie agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agraringenieurwesen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwtechniek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">агротехника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Научная дисциплина, изучающая развитие и совершенствование средств производства продуктов питания и технических культур для нужд человека.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهندسة الزراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12586" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8388">
    <skos:prefLabel xml:lang="en">terrestrial ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any terrestrial environment, from small to large, in which plants and animals interact with the chemical and physical features of the environment.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistema terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Terrestrisches Ökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ecosysteem van de bodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема суши</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Природные условия на суше, в которых растения и животные взаимодействуют с химическими и физическими компонентами окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي الأرضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2525" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/551" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1559" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3416" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3734" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3947" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4515" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5224" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5403" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6362" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7595" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8179" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8360" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8685" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8807" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9298" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9353" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10198" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/197">
    <skos:prefLabel xml:lang="en">agricultural equipment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Machines utilized for tillage, planting, cultivation, and harvesting of crops.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">équipement agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">maquinaria agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliches Gerät</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwuitrusting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственное оборудование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машины, используемые для обработки почвы, посадки, культивации или сбора сельскохозяйственных культур.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آلات زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8621">
    <skos:prefLabel xml:lang="en">transboundary pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Polluted air and water, or any other contaminated waste, that is generated in one country and transmitted to others.
(Source: BRACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution transfrontalière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación transfrontera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grenzüberschreitende Schadstoffausbreitung (transnational)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grensoverschrijdende vervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">трансграничное загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязненный воздух, вода или ядовитые отходы, которые образовались в одной стране и переместились в другие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التلوث العابر للحدود</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2895" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/199">
    <skos:prefLabel xml:lang="en">agricultural exploitation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exploitation agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">explotación agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliche Nutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwexploitatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственная эксплуатация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استغلال زراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/219" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/202">
    <skos:prefLabel xml:lang="en">agricultural land</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Land used primarily for the production of plant or animal crops, including arable agriculture, dairying, pasturage, apiaries, horticulture, floriculture, viticulture, animal husbandry and the necessary lands and structures needed for packing, processing, treating, or storing the produce.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">terre agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">suelo agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarraum</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwgrond</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственные угодья</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Земли, используемые в основном для выращивания продуктов питания и фуража, включая производство зерна, а также для производства молочной продукции; занятые пастбищами, пасеками, огородами, цветоводческими хозяйствами, виноградниками, животноводческими хозяйствами, а также земли и постройки, необходимые для упаковки, переработки, обработки или хранения продукции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أرض زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7345" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/204">
    <skos:prefLabel xml:lang="en">agricultural landscape</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">paysage cultivé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">paisaje agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarlandschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwlandschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственный ландшафт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منظر طبيعي زراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4648" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10217" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8398">
    <skos:prefLabel xml:lang="en">territorial policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A course of action adopted and pursued by government, business or some other organization, which determines the present and future use of each parcel of land in an area.
(Source: DOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique territoriale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política territorial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebietspolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">politiek van een grondgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">территориальная политика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Курс действий, принятый и реализуемый государством, коммерческой или другой организацией, определяющий нынешнее и будущее использование каждого участка земли в конкретном районе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة التعامل مع الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13301" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/207">
    <skos:prefLabel xml:lang="en">agricultural machinery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Machines utilized for tillage, planting, cultivation and harvesting of crops. Despite its benefits in increasing yields, mechanisation has clearly had some adverse environmental effects: deep ploughing exposes more soil to wind and water erosion; crop residues can be removed as opposed to ploughing back into the soil; removal of residues can lead to a serious loss of organic content in the soil, which may increase the risk of soil erosion.
(Source: MGH /  DOBRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">machine agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">maquinaria agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landmaschine</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwmachine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственные машины</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Машины, используемые для обработки почвы, посадки, культивации или сбора сельскохозяйственных культур. Несмотря на преимущества, заключающиеся в увеличении урожая, механизация оказывает явное отрицательное воздействие на окружающую среду: глубокая вспашка увеличивает площадь земель, подверженных неблагоприятному воздействию ветровой и водяной эрозий; остатки урожая убираются с земли, а не запахиваются, что приводит к сокращению доли органических компонентов в почве и повышает риск почвенной эрозии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آلات زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13222" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/208">
    <skos:prefLabel xml:lang="en">agricultural management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The administration or handling of soil, crops and livestock.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarmanagement</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление в сельском хозяйстве</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Управление землями, урожаем и поголовьем скота.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2877" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4985" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8401">
    <skos:prefLabel xml:lang="en">territory</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An area that an animal or group of animals defends, mainly against members of the same species.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">territoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">territorio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Territorium</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">grondgebied</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">территория</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Район, который животное или группа животных охраняют, главным образом, от представителей этого же вида.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة - أرض (خاصة بمجموعة معينة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/664" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/210">
    <skos:prefLabel xml:lang="en">agricultural method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Practices and techniques employed in agriculture to improve yields and productivity. Over the last few decades they have undergone big changes: tilling, sowing and harvesting have become increasingly mechanised, and the methods of applying fertilisers and pesticides have become more sophisticated. Many changes within the agricultural system can be summed up by "intensification". The result and aim of intensification has been to achieve increases in production, yields and labour productivity in agriculture.
(Source: DOBRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthodes agricoles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">métodos agrícolas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">агротехнические методы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Практика и приемы, применяемые в сельском хозяйстве для повышения урожайности и продуктивности. За последние десятилетия претерпели значительные изменения. Обработка почвы, посев и сбор урожая в основном механизированы, усложнились методы внесения удобрений и пестицидов. Суть этих изменений в сельском хозяйстве во многом соответствует термину "интенсификация". Целью и задачей интенсификации является увеличение объемов производства, урожайности и повышение производительности труда.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسلوب الزراعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1652" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1769" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1875" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4505" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5009" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5412" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6592" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7652" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7861" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8029" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8877" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9373" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10691" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11178" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11186" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11204" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13164" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13572" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13088" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8403">
    <skos:prefLabel xml:lang="en">tertiary sector</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The part of a country or region's economy that produces services or assets lacking a tangible and storable form.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">secteur tertiaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sector terciario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tertiärer Sektor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tertiaire sector</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сектор торговли и услуг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экономическая деятельность, связанная с обменом и потреблением товаров и услуг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قطاع ثالث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7554" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/212">
    <skos:prefLabel xml:lang="en">agricultural pest</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Insects and mites that damage crops, weeds that compete with field crops for nutrients and water, plants that choke irrigation channels or drainage systems, rodents that eat young plants and grain, and birds that eat seedlings or stored foodstuffs.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">parasites agricoles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plagas agrícolas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarschädling</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwongedierte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственные вредители</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Насекомые, в т.ч. клещи, которые наносят ущерб урожаю; сорняки, соперничающие с культурными растениями за питательные вещества и воду; растения, перекрывающие ирригационные каналы или дренажные системы; грызуны, поедающие молодые растения или урожай, птицы, склевывающие проросшее или собранное зерно.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">آفة زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6138" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9280" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8405">
    <skos:prefLabel xml:lang="en">test</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To carry out an examination on (a substance, material, or system) by applying some chemical or physical procedure designed to indicate the presence of a substance or the possession of a property.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">test</skos:prefLabel>
    <skos:prefLabel xml:lang="es">prueba</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Test</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">test</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тест</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Проведение исследования (вещества, материала или системы) путем выполнения химической или физической процедуры, предназначенной подтвердить наличие какого-либо вещества или каких-либо свойств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3050" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/370" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1181" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1631" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5747" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8412" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11771" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11782" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13077" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/215">
    <skos:prefLabel xml:lang="en">agricultural policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A course of action adopted by government or some other organization that determines how to deal with matters involving the cultivation of land; raising crops; feeding, breeding and raising livestock or poultry; and other farming issues.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarpolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwbeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственная политика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Направление деятельности, принятое правительственной или иной организацией, определяющее порядок решения вопросов, связанных с культивацией земли, выращиванием урожая, разведением, выращиванием или кормлением скота или птицы и др.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة زراعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/216">
    <skos:prefLabel xml:lang="en">agricultural pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The liquid or solid wastes from farming, including: runoff from pesticides, fertilizers, and feedlots; erosion and dust from plowing; animal manure and carcasses, crop residues, and debris.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landwirtschaftliche Verschmutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwvervuiling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственное загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкие или твердые отходы деятельности ферм, включая стоки, содержащие пестициды, удобрения или корм; эрозия и пыль, полученные в результате распашки земель; навоз и трупы животных; остатки урожая; любой другой мусор.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث زراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/219">
    <skos:prefLabel xml:lang="en">agricultural production</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">production agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producción agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Agrarproduktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">landbouwproductie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сельскохозяйственное производство</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">إنتاج زراعي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/232" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/199" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1203" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3849" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4224" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10044" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13165" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13186" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13209" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/220" />
