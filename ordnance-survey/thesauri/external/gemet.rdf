    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4668">
    <skos:prefLabel xml:lang="en">landslide</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Mass-movement landforms and processes involving the downslope transport, under gravitationary influence of soil and rock material en masse.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éboulement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">deslizamiento de tierras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erdrutsch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aardverschuiving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оползень</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение масс земли и процессы, связанные с движением вниз массы земли и камней под действием силы тяжести.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انهيال - انهيار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3652" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/8" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12861">
    <skos:prefLabel xml:lang="en">danger analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of evaluating the scale and probability of harm caused by any hazard to persons, property or the environment.
(Source: ISEP /  DDP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">étude de danger</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis de riesgos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gefahrenanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">risicoanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ опасности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка масштаба и вероятности ущерба, причиной которого является любая опасность для людей, имущества или окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل المخاطر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7236" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11701">
    <skos:prefLabel xml:lang="en">instrumentation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Designing, manufacturing, and utilizing physical instruments or instrument systems for detection, observation, measurement, automatic control, automatic computation, communication, or data processing.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">instrumentation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">instrumentación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Instrumentierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">instrumentatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оснащение контрольно-измерительными приборами и средствами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Проектирование, изготовление, использование физических инструментов или инструментальных систем для обнаружения, наблюдения, измерения, автоматического контроля, автоматической обработки, передачи или обработки данных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصنيع واستخدام الأدوات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
