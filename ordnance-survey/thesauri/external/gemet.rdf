(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dépôt de ferraille</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertedero de chatarra</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schrotthaufen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">schroothoop</skos:prefLabel>
