    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7003" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7781" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10905" />
