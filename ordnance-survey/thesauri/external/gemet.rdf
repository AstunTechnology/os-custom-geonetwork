    <skos:prefLabel xml:lang="nl">plantenkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биология растений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение естественных процессов в растениях.</skos:scopeNote>
