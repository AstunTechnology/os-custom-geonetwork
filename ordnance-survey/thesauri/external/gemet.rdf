    <skos:prefLabel xml:lang="es">cinta magnética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Magnetband</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">magneetband</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">магнитная лента</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пластмассовая, бумажная или металлическая лента, покрытая или пропитанная магнитным слоем частиц оксида железа, используемая для магнитной записи.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شريط ممغنط</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1981" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
