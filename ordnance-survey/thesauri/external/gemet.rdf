    <skos:prefLabel xml:lang="de">Gasgemisch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gasmengsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">газовая смесь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">خليط غازي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3577" />
