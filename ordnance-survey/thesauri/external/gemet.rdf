    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/784">
    <skos:prefLabel xml:lang="en">beverage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any one of various liquids for drinking, usually excluding water.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">boisson</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bebidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Getränk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">drank</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">напиток</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая жидкость, как правило, исключая воду, предназначенная для питья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مشروبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5279" />
