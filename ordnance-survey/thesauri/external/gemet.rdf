    <skos:prefLabel xml:lang="ru">нормативный документ в области воздушных перевозок</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تنظيم الحركة الجوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13272" />
