    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5924">
    <skos:prefLabel xml:lang="en">organohalogen compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Organic compounds containing a C-halogen bond.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organohalogèné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos órganohalogenados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Halogenverbindungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische halogeenverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">галогенсодержащее органическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Органические соединения, содержащие связь C-галоген.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب هالوجين عضوي</skos:prefLabel>
