  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6841">
    <skos:prefLabel xml:lang="en">purification facility</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Equipment for the removal of impurities and unwanted constituents from a medium.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dispositif d'épuration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">instalaciones de depuración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reinigungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuiveringsinstallatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистное оборудование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оборудование для удаления примесей или нежелательных компонентов из среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرفق تنقية</skos:prefLabel>
