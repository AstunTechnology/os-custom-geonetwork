  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/388">
    <skos:prefLabel xml:lang="en">amusement park</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An open-air entertainment area consisting of stalls, side shows etc.
(Source: CED)</skos:scopeNote>
