  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/965">
    <skos:prefLabel xml:lang="en">boron</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A very hard almost colourless crystalline metalloid element that in impure form exists as a brown amorphous powder. It occurs principally in borax and is used in hardening steel.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bore</skos:prefLabel>
    <skos:prefLabel xml:lang="es">boro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">borium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">бор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Очень твердый, практически бесцветный кристаллический металлоид, который в природе существует в виде коричневого аморфного порошка с различными примесями. Чаще всего встречается в форме буры и используется в качестве добавки к стали.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بورون</skos:prefLabel>
