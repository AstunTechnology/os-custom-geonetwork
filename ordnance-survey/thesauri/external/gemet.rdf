    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11178">
    <skos:prefLabel xml:lang="en">market gardening</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The business of growing fruit and vegetables on a commercial scale.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture maraîchère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">horticultura de mercado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hndelsgärtnerei</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beroepsgroenteteelt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство овощей и фруктов для продажи</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Деятельность, связанная с выращиванием овощей и фруктов в промышленных масштабах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البستنة التجارية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
