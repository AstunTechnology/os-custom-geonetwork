    <skos:prefLabel xml:lang="fr">controverse scientifique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disputa científica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wissenschaftlicher Disput</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wetenschappelijke discussie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">научный спор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقاش علمي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11148" />
