  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11779">
    <skos:prefLabel xml:lang="en">total organic carbon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of carbon covalently bound in organic compounds in a water sample.
(Source: WQA)</skos:scopeNote>
