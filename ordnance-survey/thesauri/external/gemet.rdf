    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14717">
    <skos:prefLabel xml:lang="en">environmental sanitation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">hygiène environnementale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sanidad ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltsanierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gezondmaking van het milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экологическая санитария</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">الصحة البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/78" />
