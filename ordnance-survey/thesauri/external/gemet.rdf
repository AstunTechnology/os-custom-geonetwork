    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6498" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6975" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7030" />
