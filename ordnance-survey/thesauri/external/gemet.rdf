  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8595">
    <skos:prefLabel xml:lang="en">traffic monitoring</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The periodic or continuous surveillance or analysis of the movement of persons, objects, vehicles or other conveyances along an area of passage.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">surveillance du trafic</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vigilancia del tráfico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verkehrsüberwachung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verkeersmeting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мониторинг транспорта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Периодическое либо регулярное наблюдение или анализ движения лиц, объектов, транспортных средств по транспортному маршруту.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مراقبة المرور</skos:prefLabel>
