    <skos:prefLabel xml:lang="nl">geluidsspectrum</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спектр звука</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Диапазон звуковых частот, испускаемых источником звука.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طيف الضوضاء</skos:prefLabel>
