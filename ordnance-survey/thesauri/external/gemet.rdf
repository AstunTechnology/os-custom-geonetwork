  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4974">
    <skos:prefLabel xml:lang="en">malaria</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of human febrile diseases with a chronic relapsing course caused by hemosporidian blood parasites of the genus Plasmodium, transmitted by the bite of Anopheles mosquito.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">paludisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">malaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Malaria</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">malaria</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">малярия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа лихорадочных заболеваний человека с регулярным повторяющимся курсом, вызванных попаданием в кровь паразитов рода Plasmodium, передаваемых с укусом комаров Anopheles.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المالاريا</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9426" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
