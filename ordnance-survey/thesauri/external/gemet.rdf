  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9052">
    <skos:prefLabel xml:lang="en">waste charge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Imposed fee, expense, or cost for the management of refuse or unwanted materials left over from a manufacturing process.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">redevance sur les déchêts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carga de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallabgabe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalheffing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог на производимые отходы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установленный сбор, расходы, связанные с распоряжением остатками или ненужными материалами, образовавшимися в ходе промышленного процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رسوم المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9053">
    <skos:prefLabel xml:lang="en">waste classification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The arrangement of unwanted materials left over from manufacturing processes or refuse from places of human or animal habitation into a variety of categories based on chemical and microbiological constituents or other common characteristics.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">classification des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">clasificación de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallklassifizierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalclassificatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">классификация отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Распределение по различным категориям в зависимости от химических, микробиологических или иных общих свойств образовавшихся в ходе промышленных процессов ненужных материалов, отходов из мест проживания человека или обитания животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصنيف النفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1447" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/862">
    <skos:prefLabel xml:lang="en">biological nitrogen fixation</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">fixation biologique de l'azote</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fijación biológica del nitrógeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Stickstoff-Fixierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische stikstoffixatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое связывание азота</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تثبيت حيوي للنيتروجين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10043" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9055">
    <skos:prefLabel xml:lang="en">waste collection at source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The gathering and transporting of refuse from its place of origin.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">collecte des déchets à la source</skos:prefLabel>
    <skos:prefLabel xml:lang="es">colección de residuos en la fuente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Holsystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalinzameling bij de bron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сбор отходов в месте их возникновения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система, при которой отходы, образующиеся в процессе деятельности, собираются непосредственно на месте. Сбор и вывоз отходов непосредственно с места их возникновения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جمع المخلفات في المصدر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9054" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/864">
    <skos:prefLabel xml:lang="en">biological pest control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any living organism applied to or introduced into the environment that is intended to function as a pesticide against another organism declared to be a pest.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode biologique de lutte contre les nuisibles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control biológico de plagas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Schädlingsbekämpfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische bestrijding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологические меры борьбы с вредителями</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой живой организм, помещаемый в условия конкретной среды с целью борьбы с другим организмом, который считается вредителем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيطرة الحيوية على الآفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6139" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/768" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/865">
    <skos:prefLabel xml:lang="en">biological pollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Viruses, bacteria, fungi, and mammal and bird antigens that may be present in the environment and cause many health effects.
(Source: KORENa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">polluant biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminantes biológicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologischer Schadstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische verontreiniger</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое загрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вирусы, бактерии, грибы, антигены животных и птиц, которые присутствуют в окружающей среде и могут представлять угрозу здоровью.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوثات حيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/698" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/866" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/866">
    <skos:prefLabel xml:lang="en">biological pollution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Disturbance of the ecological balance by the accidental or deliberate introduction of a foreign organism, animal or plant species into an environment.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pollution biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">contaminación biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Verunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische verontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое загрязнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Нарушение экологического баланса в результате случайного или преднамеренного привнесения в окружающую среду чужеродного организма, животного или растительного вида.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تلوث حيوي - تلوث بيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10048" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/865" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11675" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/867">
    <skos:prefLabel xml:lang="en">biological process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Processes concerning living organisms.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus bologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologischer Vorgang</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische processen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процессы, касающиеся живых организмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية حيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/892" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/839" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/846" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/890" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2182" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2654" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3663" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4802" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5462" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7120" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7729" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9149" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10003" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10043" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11868" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11869" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/812" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/868">
    <skos:prefLabel xml:lang="en">biological production</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The amount and rate of production which occur in a given ecosystem over a given time period. It may apply to a single organism, a population, or entire communities and ecosystems.
2) The quantity of organic matter or its equivalent in dry matter, carbon, or energy content which is accumulated during a given period of time.
(Source: PARCOR /  MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">production biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">producción biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Produktion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische productie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое производство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Объем и скорость воспроизводства в конкретной экосистеме за определенный период времени. Может применяться к отдельному организму, популяции, всему сообществу или экосистеме. 2) Количество органического вещества или его эквивалента, выраженного в сухом виде, в содержании углерода или энергии, которое накапливается в течение конкретного периода времени.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إنتاج حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9062">
    <skos:prefLabel xml:lang="en">waste disposal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The orderly process of discarding unwanted or useless material.
(Source: GSW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élimination des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">eliminación de desechos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbeseitigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">утилизация отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Упорядоченный процесс избавления от ненужных или бесполезных материалов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/746" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1177" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2254" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2367" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2372" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3192" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4183" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5737" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7921" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9045" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9130" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9118" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9063">
    <skos:prefLabel xml:lang="en">waste disposal act</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Law that settles the rules concerning the disposal, recycling and treatment of wastes.
(Source: DIZAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">loi relative à l'élimination des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ley de disposición de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbeseitigungsgesetz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingswet</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">закон в области утилизации отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Закон, устанавливающий правила в отношении утилизации, повторного использования или обработки отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قانون التخلص من المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10026" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9065">
    <skos:prefLabel xml:lang="en">waste disposal cost</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of money incurred for the action of removing or getting rid of refuse or unwanted materials left over from a manufacturing process.
(Source: EFP / OED / TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">coût de l'élimination des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">coste de disposición de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entsorgungskosten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingkost</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стоимость утилизации отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество денег, потраченное на удаление или избавление от отходов или ненужных материалов, оставшихся после промышленного процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكلفة التخلص من المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2796" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9067">
    <skos:prefLabel xml:lang="en">waste disposal in the ground</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The planned discharge, deposit or burial of refuse or other unserviceable material into the surface of the earth, as in a landfill.
(Source: OED / LIV / CTC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">enfouissement des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">eliminación de residuos en el suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbeseitigung in den Boden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">storten van afval in de bodem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">захоронение отходов в грунт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Плановый сброс, размещение, заделка отходов или других ненужных материалов в грунт, например, в мусорную яму.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من المخلفات في الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2372" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9068">
    <skos:prefLabel xml:lang="en">waste disposal charge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Imposed fee, expense, or cost for the action of removing or getting rid of refuse or unwanted materials left over from a manufacturing process.
(Source: TOE /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">frais d'élimination des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tasa por disposición de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallgebühr</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingsheffing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог на утилизацию отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установленный сбор, расходы по вывозу или утилизации остатков или ненужных материалов, образовавшихся в ходе промышленного процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رسوم التخلص من المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9069">
    <skos:prefLabel xml:lang="en">waste dump</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Area where wastes are deposited and burned.
(Source: ZINZAN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décharge</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertedero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallablagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalstortplaats</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">свалка отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок, где размещаются и сжигаются отходы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقلب نفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/878">
    <skos:prefLabel xml:lang="en">biological waste gas purification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Processes for removing impurities from waste gas based on the employing of microorganisms.
(Source: BIOTGLa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">épuration biologique des effluents gazeux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">purificación biológica de gas de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Abgasreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische zuivering van overtollig gas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая очистка отработанного газа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процессы, связанные с удалением посторонних включений из отработанного газа на основе деятельности микроорганизмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التنقية الحيوية للمخلفات الغازية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9043" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12576" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/612">
    <skos:prefLabel xml:lang="en">astronomy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science concerned with celestial bodies and the observation and interpretation of the radiation received in the vicinity of the earth from the component parts of the universe.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">astronomie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">astronomía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Astronomie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">astronomie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">астрономия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, связанная с изучением небесных тел, наблюдением и интерпретацией полученных в окрестностях Земли излучений или сигналов из других частей Вселенной.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الفلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5524" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/36" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/880">
    <skos:prefLabel xml:lang="en">biological weapon</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Living organisms (or infective material derived from them) which are intended to cause disease or death in animals, plants, or man, and which depend for their effects on their ability to multiply in the person, animal or plant attacked. Various living organisms (for example, rickettsiae, viruses and fungi), as well as bacteria, can be used as weapons.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">arme biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">armas biológicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Kampfmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische wapen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическое оружие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Живые организмы или инфицированный материал, приготовленный на их основе, предназначенные вызывать заболевания у животных, растений, людей и способные размножаться в телах людей, животных и растений. Различные живые организмы, такие как риккетсия, вирусы и грибы, а также бактерии, могут использоваться в качестве такого оружия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلاح بيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9267" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/22" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9073">
    <skos:prefLabel xml:lang="en">waste export</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transporting unwanted materials, including those leftover from a manufacturing processes, refuse, or trash to other countries or areas for the conduct of foreign trade.
(Source: TOE / MGHME)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">exportation de déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">exportación de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallexport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitvoer van afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экспорт отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Перевозка ненужных материалов, включая остатки, образовавшиеся в ходе промышленных процессов, отходы или мусор, в другие страны или регионы в рамках внешней торговли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصدير المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3063" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3065" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9088" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9092" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9119" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/882">
    <skos:prefLabel xml:lang="en">bioluminescence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The production of light of various colors by living organisms (e.g. some bacteria and fungi, glow-worms and many marine animals). Luminescence is produced by a biochemical reaction, which is catalyzed by an enzyme. In some animals the light is used as a mating signal; in others it may be a protective device. In deep-sea forms luminous organs may serve as lanterns.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bioluminescence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bioluminescencia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biolumineszenz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioluminiscentie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биолюминесценция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Окрашивание живых организмов в различные цвета солнечного спектра (некоторые виды бактерий и грибов, светлячки и многие морские животные). Люминесценция является результатом биохимической реакции, катализатором которой выступают энзимы. У некоторых животных это явление используется в брачных играх, у других - как средство устрашения и защиты. У глубоководных видов это явление служит для освещения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإضاءة الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5161" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/883">
    <skos:prefLabel xml:lang="en">biomass</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Biomass refers strictly speaking to the total weight of all the living things in an ecosystem. However, it has come to refer to the amount of plant and crop material that could be produced in an ecosystem for making biofuels and other raw materials used in industry, for example.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biomasse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biomasa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biomasse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biomassa</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биомасса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Биомасса, строго говоря, означает общую массу живых существ в конкретной экосистеме. Однако, в последние годы этот термин используют для определения количества растительного материала или урожая, который может быть произведен в биосистеме для изготовления биотоплива и другого промышленного сырья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الكتلة الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6243" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9076">
    <skos:prefLabel xml:lang="en">waste-fed power station</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Power station that functions with refuse-derived fuel.

(Source: PARCORa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">centrale électrique alimentée par des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">central eléctrica residuo-alimentada</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Müllkraftwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">krachtcentrale op basis van afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">электростанция, работающая на отходах</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Электростанция, работающая на топливе, полученном из отходов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة طاقة تعمل بالنفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9074" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/885">
    <skos:prefLabel xml:lang="en">biomass energy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A renewable energy source that makes use of such biofuels as methane (biogas) generated by sewage, farm, industrial, or household organic waste materials. Other biofuels include trees grown in so-called "energy forests" or other plants, such as sugar cane, grown for their energy potential. Biomass energy relies on combustion and therefore produces carbon dioxide; its use would not, therefore, alleviate the greenhouse effect.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">energie de la biomasse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">energía de la biomasa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energie aus Biomasse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biomassa-energie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергия биомассы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Возобновляемый источник энергии, который использует такие виды биотоплива, как метан (биогаз), производимый на основе канализационных стоков, промышленных, сельскохозяйственных, бытовых органических отходов. Другие виды биотоплива включают деревья, выращенные в т.н. "энергетических лесах" или другие растения, как, например, сахарный тростник, который также выращивается для использования его энергетического потенциала. Энергия биомассы высвобождается в процессах сгорания, которые сопровождаются выделением углекислого газа. Ее использование, таким образом, не будет способствовать уменьшению парникового эффекта.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طاقة الكتلة الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5668" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1113">
    <skos:prefLabel xml:lang="en">calculation method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode de calcul</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método de cálculo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Berechnungsverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">berekeningsmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод калькуляции</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طريقة الحساب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13088" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5097" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9079">
    <skos:prefLabel xml:lang="en">waste gas examination</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Qualitative and quantitative analysis of exhaust gases emitted from vehicles, industrial plants, etc. in order to asses their composition.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse des effluents gazeux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">examen de gas de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abgasuntersuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderzoek aan uitgestoten gassen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ отходящего газа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количественный и качественный анализ выхлопных газов автомобильных двигателей, отработанного газа на промышленных предприятиях и т.д. в целях оценки его состава.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فحص الغاز المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9044" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/888">
    <skos:prefLabel xml:lang="en">biophysics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The hybrid science involving the application of physical principles and methods to study and explain the structures of living organisms and the mechanics of life processes.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biophysique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biofísica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biophysik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biofysica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биофизика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Гибрид нескольких научных дисциплин, связанных с применением физических принципов и методов в изучении и объяснении строения живых организмов и механизмов жизненных процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفيزياء الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6235" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/889">
    <skos:prefLabel xml:lang="en">bioreactor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A container, such as a large fermentation chamber, for growing living organisms that are used in the industrial production of substances such as pharmaceuticals, antibodies, or vaccines.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bioréacteur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biorreactor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bioreaktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioreactor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биореактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Контейнер, к примеру, большая ферментационная камера, для выращивания живых организмов, используемых в промышленном производстве таких веществ, как лекарства, антитела или вакцины.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مفاعل حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6977" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3159" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/890">
    <skos:prefLabel xml:lang="en">biorhythm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A cyclically recurring pattern of physiological states in an organism or organ, such as alpha rhythm or circadian rhythm; believed by some to affect physical and mental states and behaviour.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biorythme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ritmos biológicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biorhythmus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioritme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биоритм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Циклический, повторяющийся алгоритм физиологического состояния организма или отдельного органа, как, например, альфа-ритм или циркадный ритм; считается, что некоторые из них влияют на физическое и умственное состояние, а также поведение.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإيقاع الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8487" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/891">
    <skos:prefLabel xml:lang="en">biosafety</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The combination of knowledge, techniques and equipment used to manage or contain potentially infectious materials or biohazards in the laboratory environment, to reduce or prevent harm to laboratory workers, other persons and the environment.
(Source: BIOSAF / OHS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biosécurité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bioseguridad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biosicherheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bioveiligheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биобезопасность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Одновременное применение знаний, технологий или оборудования при управлении или хранении потенциально инфекционных материалов или био-опасных веществ в лабораторных условиях, в целях снижения или предотвращения вреда здоровью сотрудников лаборатории, других лиц или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأمان الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3624" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/892">
    <skos:prefLabel xml:lang="en">biosphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">That part of the Earth and atmosphere capable of supporting living organisms.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biosphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биосфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть Земли и атмосферы, способная поддерживать живые организмы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المحيط الحيوي</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/406" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2470" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3026" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8976" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9085">
    <skos:prefLabel xml:lang="en">waste heat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Heat derived from the cooling process of electric power generating plants and which can cause thermal pollution of water courses, promoting algal bloom.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chaleur résiduelle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calor de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwärme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwarmte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отработанное тепло</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тепло, получаемое в ходе охладительных процессов на электростанциях и которое может привести к термальному загрязнению естественных водных потоков, способствуя росту водорослей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حرارة المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/263" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8442" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9086" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/894">
    <skos:prefLabel xml:lang="en">biosphere reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Protected land and coastal areas that are approved under the Man and Biosphere programme (MAB) in conjunction with the Convention on International Trade in Endangered Species (CITES). Each reserve has to have an ecosystem that is recognized for its diversity and usefulness as a conservation unit. The reserves have at least one core area where there can be no interference with the natural ecosystem. A transition zone surrounds this and within it scientific research is allowed. Beyond this is a buffer zone which protects the whole reserve from agricultural, industrial and urban development. Biosphere reserves and buffer zones were regarded as examples of a new generation of conservation techniques.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve de biosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reservas de la biosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biosphärenreservat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">reserve van de biosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биосферный заповедник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Охраняемая территория суши и прибрежной полосы, которая получила признание в рамках международной программы "Человек и биосфера" в соответствии с Конвенцией о международной торговле редкими видами (CITES). Каждый заповедник должен иметь в своей основе экосистему, признанную благодаря видовому разнообразию и своей полезности в качестве сохраняемой единицы. Биосферный заповедник должен иметь по меньшей мере одну закрытую территорию, на которую природная экосистема не может оказывать влияния. Эту закрытую территорию окружает переходная зона, где разрешается проведение научных экспериментов. За этой зоной находится буферная зона, которая охраняет заповедник от воздействия промышленного, сельскохозяйственного или городского развития. Биосферные заповедники и буферные зоны являются примерами нового поколения методов и приемов в области сохранения природы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية محيط حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6740" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7137" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/895">
    <skos:prefLabel xml:lang="en">biosynthesis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Production, by synthesis or degradation, of a chemical compound by a living organism.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biosynthèse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biosíntesis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biosynthese</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biosynthese</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биосинтез</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Производство химического соединения живым организмом в процессе синтеза или разложения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخليق الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5161" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6184" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/812" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9088">
    <skos:prefLabel xml:lang="en">waste importation permit</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An authorization, license or equivalent control document issued by a government agency that approves bringing in refuse or unwanted materials left over from a manufacturing process from foreign countries.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">permis d'importation des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">permiso de importación de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfalleinfuhrgenehmigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalinvoervergunning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разрешение на импорт отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разрешение, лицензия или эквивалентный документ, изданный государственным органом и одобряющий ввоз из-за рубежа отходов или ненужных материалов, оставшихся после промышленных процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تصريح باستيراد المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4169" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9073" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9090">
    <skos:prefLabel xml:lang="en">waste incinerator</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Establishment where waste is burnt.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">incinérateur de déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">incineradora de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallverbrennungsofen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverbrandingsinstallatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">печь для сжигания отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Промышленная установка, в которой сжигаются отходы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ترميد النفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4184" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4183" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/899">
    <skos:prefLabel xml:lang="en">biotic factor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The influence upon the environment of organisms owing to the presence and activities of other organisms, as distinct from a physical, abiotic, environmental factor.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">facteur biotique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">factor biótico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotischer Faktor</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biotische factor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биотический фактор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В отличие от физических, абиотических факторов, биотический фактор означает такое влияние на окружающую среду организмов, которое является результатом присутствия и активности других живых организмов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2457" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9092">
    <skos:prefLabel xml:lang="en">waste management</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The total supervision of waste production, handling, processing, storage, and transport from its point of generation to its final acceptable disposal.
(Source: HMD / ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">gestion des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">gestión de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalbeheer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">управление отходами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общее наблюдение за процессом образования, обращения, переработки, хранения и транспортировки отходов от места их возникновения до пункта их окончательной приемлемой утилизации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إدارة المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2877" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2365" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6923" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7018" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9072" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9073" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/901">
    <skos:prefLabel xml:lang="en">biotope</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A region of relatively uniform environmental conditions, occupied by a given plant community and its associated animal community.
(Source: PAENS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biotope</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biotopo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotop</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biotoop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биотоп</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Регион относительно одинаковых экологических условий, занятый конкретным сообществом  растительных видов и связанного с ними сообщества животных.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الموطن الحيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/902" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7541" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/903" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10189" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/902">
    <skos:prefLabel xml:lang="en">biotope network</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Intersection of corridors connecting patchy ecological communities. Species survival tends to be higher in patches that have higher connectivity.
(Source: PARCORa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réseau de biotope</skos:prefLabel>
    <skos:prefLabel xml:lang="es">red de biotopo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biotopvernetzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biotoopnetwerk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система биотопов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Взаимопересечение коридоров, соединяющих экологические сообщества. Выживаемость видов выше в тех районах, где отмечается больше связей с соседними участками.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شبكة المواطن الحيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/901" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2881">
    <skos:prefLabel xml:lang="en">environmental misconduct</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">méfait écologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mala conducta ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltvergehen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wangedrag ten opzichte van het milieu</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нарушение норм в отношении окружающей среды</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">سوء سلوك بيئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11540" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9096">
    <skos:prefLabel xml:lang="en">waste minimisation potential</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The capability of measures or techniques that reduce the amount of refuse or unwanted materials that is generated, particularly during industrial production processes.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">potentiel de minimisation des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">potencial de minimización de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Minderungspotential</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">mogelijkheid tot afvalvermindering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потенциал минимизации отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إمكانية تقليص المخلفات إلى أقل حد ممكن</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9095" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3340">
    <skos:prefLabel xml:lang="en">fluvial resource</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any source of supply derived from a river, particularly its water, which is collected, stored and treated, then distributed for domestic, industrial, farm and other uses.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ressources fluviales</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recursos fluviales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fluvialressourcen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">rivier hulpbronnen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">речной ресурс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ресурс, получаемый из реки, в частности, вода, которая может быть собрана, сохранена, обработана, а затем распределена для бытового, промышленного, сельскохозяйственного и иного потребления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر نهري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3494" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10118" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9098">
    <skos:prefLabel xml:lang="en">waste oil</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Oil arising as a waste product of the use of oils in a wide range of industrial and commercial activities, such as engineering, power generation and vehicle maintenance and should be properly disposed of, or treated in order to be reused.
(Source: GRAHAW /  DEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">huile usagée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aceite residual</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altöl</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalolie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отработанное масло</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Масло, образовавшееся в качестве отхода при различных промышленных или коммерческих процессах, использующих масло, например,  в машиностроении, производстве электричества, эксплуатации автотранспорта, и которое должно быть сброшено в специально отведенных местах или переработано для повторного использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">زيت مستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/794" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6161" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9099">
    <skos:prefLabel xml:lang="en">waste paper</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Newspapers, magazines, cartons and other paper separated from solid waste for the purpose of recycling.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">papier usagé</skos:prefLabel>
    <skos:prefLabel xml:lang="es">papel residual</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Altpapier</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">oud papier</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">макулатура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Газеты, журналы, картон и другие виды бумаги, отобранные из других твердых отходов в целях вторичной переработки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ورق مستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6001" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6023" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9103">
    <skos:prefLabel xml:lang="en">waste processing industry</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">industrie de traitement des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria del tratamiento de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbeseitigungsunternehmen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingsindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">переработка отходов (отрасль промышленности)</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">صناعة تشغيل المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2849" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/912">
    <skos:prefLabel xml:lang="en">bird</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of the warm-blooded vertebrates which make up the class Aves.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oiseau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aves</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vogel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vogels</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">птица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель теплокровных позвоночных, составляющих класс Aves.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طائر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8946" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/404" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/995" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3548" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5238" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7927" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9183" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/913">
    <skos:prefLabel xml:lang="en">bird sanctuary</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Special area where birds are protected.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">refuge des oiseaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">santuario para pájaros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vogelschutzgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vogelreservaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">заповедник для птиц</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специальная территория, где осуществляется охрана птиц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مأوى الطائر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9321" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/914">
    <skos:prefLabel xml:lang="en">bird of prey</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any of various carnivorous bird of the orders Falconiformes and Strigiformes which feed on meat taken by hunting.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rapace</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aves de presa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Raubvogel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">roofvogel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">хищная птица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой представитель плотоядных птиц отрядов Falconiformes и Strigiformes, которые питаются мясом, добываемым во время охоты.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طير جارح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/915">
    <skos:prefLabel xml:lang="en">bird species</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any species of the warm-blooded vertebrates which make up the class Aves.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">espèce d'avifaune</skos:prefLabel>
    <skos:prefLabel xml:lang="es">especie ornitológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vogelart</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vogelsoorten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">виды птиц</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любой вид теплокровных позвоночных, составляющих класс Aves.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أنوع الطيور</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10073" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9108">
    <skos:prefLabel xml:lang="en">waste reduction</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Practices that reduce the amount of waste generated by a specific source through the redesigning of products or patterns of production or consumption.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réduction des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reducción de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallminderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalbeperking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">снижение отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Практика снижения объема отходов, образующихся в конкретном источнике в результате изменения конструкции изделий, схемы производства или потребления.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقليص المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9008" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7198" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/917">
    <skos:prefLabel xml:lang="en">birth control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Limitation of the number of children born by preventing or reducing the frequency of impregnation.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">régulation des naissances</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de natalidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geburtenregelung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geboortebeperking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">контроль за рождаемостью</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ограничение количества рожденных детей в результате предотвращения или сокращения частоты зачатий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحديد النسل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2056" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9110">
    <skos:prefLabel xml:lang="en">waste removal industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The aggregate of commercial enterprises primarily concerned with eliminating or getting rid of refuse from places of human or animal habitation or of unwanted materials left over from a manufacturing process.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie d'enlèvement des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria de traslado de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Entsorgungswirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwijderingsindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">удаление отходов (отрасль промышленности)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة رفع المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4249">
    <skos:prefLabel xml:lang="en">industrial material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériau industriel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos industriales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Industrieller Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">industrieel materiaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">промышленный материал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة صناعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/921">
    <skos:prefLabel xml:lang="en">bitumen</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A generic term applied to natural inflammable substances of variable colour, hardness, and volatility, composed principally of a mixture of hydrocarbons substantially free from oxygenated bodies. Bitumens are sometimes associated with mineral matter, the nonmineral constituents being fusible and largely soluble in carbon disulfide, yielding water-insoluble sulfonation products. Petroleum, asphalts, natural mineral waxes, and asphaltites are all considered bitumens.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bitume</skos:prefLabel>
    <skos:prefLabel xml:lang="es">betún</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bitumen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bitumen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">битум</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Общий термин, применяемый к природным горючим веществам различных цветовых оттенков, плотности и летучести, состоящих из смеси углеводородов, в состав которых не входят окисленные группы. Битумы часто ассоциируют с минеральными веществами, а их неминеральные компоненты являются горючими и растворимыми в дисульфиде углерода, выделяя нерастворимые  продукты сульфонации. Нефть, природный минеральный воск и твердый битум относятся к веществам этого вида.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بيتومين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7298" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4856" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9116">
    <skos:prefLabel xml:lang="en">waste sorting</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Separating waste into different materials, such as glass, metal, paper, plastic, etc.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">tri des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">clasificación de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallsortierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalsortering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сортировка отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разделение отходов по различным типам материалов, например, стекло, металл, бумага, пластмасса и т.д.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فرز المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9125" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14098" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12318" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9118">
    <skos:prefLabel xml:lang="en">waste storage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Temporary holding of waste pending treatment or disposal. Storage methods include containers, tanks, waste piles, and surface impoundments.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stockage des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">almacenamiento de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallagerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalopslag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">хранение отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Временное содержание отходов, ожидающих переработки или утилизации. Хранение может осуществляться в контейнерах, танкерах, в виде штабелей, внутри ограждений на поверхности земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تخزين المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14976" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9119">
    <skos:prefLabel xml:lang="en">waste transport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Transportation of wastes by means of special vehicles.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">transport de déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">transporte de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfalltransport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvaltranvervoer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">транспортировка отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Транспортировка отходов на специальных транспортных средствах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقل المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3481" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9073" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8603" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9121">
    <skos:prefLabel xml:lang="en">waste treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any process or combination of processes that changes the chemical, physical or biological composition or character of any waste or reduces or removes its harmful properties or characteristics for any purpose.
(Source: HMD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">переработка отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс или комбинация процессов, изменяющие химический, физический или биологический состав либо характер отходов, снижающие либо устраняющие их вредные свойства с любыми целями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5956" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/879" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1337" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1625" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2190" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6838" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7740" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9058" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9059" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12289" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1652" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7680" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8452" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9092" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9123" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12611" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/930">
    <skos:prefLabel xml:lang="en">blast furnace</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tall, cylindrical smelting furnace for reducing iron ore to pig iron; the blast of air blown through solid fuel increases the combustion rate.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">haut fourneau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">altos hornos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hochofen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">blaasoven</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">доменная печь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Высокое, цилиндрическое строение, предназначенное для выплавления чугуна из железной руды; воздух, продуваемый через твердое топливо, увеличивает скорость сгорания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفرن العالي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3538" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9123">
    <skos:prefLabel xml:lang="en">waste treatment plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Place where waste material is treated to make it reusable or so it may be disposed of safely.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">usine de traitement des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plantas de tratamiento de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallbehandlungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalverwerkingsfabriek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">завод по переработке отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место, где перерабатываются отходы для вторичного использования либо для их безопасной утилизации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصنع معالجة المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/932">
    <skos:prefLabel xml:lang="en">bleaching agent</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) A chemical, such as an aromatic acyl peroxide or monoperoxiphthalic acid, used to bleach flour, fats, oils and other edibles. 
2) An oxidizing or reducing chemical such as sodium hypochlorite, sulfur dioxide, sodium acid sulfite, or hydrogen peroxide.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agent de blanchiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agente blanqueador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bleichmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bleekmiddel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">отбеливающий реагент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Химическое вещество, как, например, ароматический  ацилпероксид или монопероксифталевая кислота, используемое для отбеливания муки, жиров, масел и других пищевых продуктов. 2) Окислитель или восстановитель, такой как гипохлорит натрия, диоксид серы, гидросульфит натрия и перекись водорода.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عامل تبييض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/933" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/934" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9125">
    <skos:prefLabel xml:lang="en">waste use</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The incorporation of wastes into natural or artificial cycles, mainly in order to recover secondary raw materials or energy.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">utilisation des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">uso de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abfallverwertung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalgebruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">применение отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Включение отходов в природные либо искусственные циклы, главным образом для вторичного использования сырьевых материалов или энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استخدام المخلفات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9106" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9105" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9116" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12341" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12342" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/934">
    <skos:prefLabel xml:lang="en">bleaching process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Removing colored components from a textile. Common bleaches are hydrogen peroxide, sodium hypochloride, and sodium chlorite. 
2) The brightening and delignification of pulp by the addition of oxidizing chemicals such as chlorine or reducing chemicals such as sodium hypochloride.
(Source: LEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus de blanchiment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso de blanqueo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bleichverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bleekproces</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">процесс отбеливания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Устранение красящих компонентов ткани. Распространенным отбеливателем является перекись водорода, гипохлорид натрия и хлорит натрия. 2) Осветление и делигнификация целлюлозы в результате добавления окисляющих реагентов, как, например, хлор или каких-либо восстановителей, к примеру, гипохлорида натрия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية التبييض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12605" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/932" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/935">
    <skos:prefLabel xml:lang="en">blood (tissue)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A fluid connective tissue consisting of the plasma and cells that circulate in the blood vessels.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sang</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sangre</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Blut</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bloed</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кровь (ткань)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкая соединительная ткань, состоящая из плазмы и клеток и циркулирующая по кровеносным сосудам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دم</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8494" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9128">
    <skos:prefLabel xml:lang="en">waste water charge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Imposed fee, expense, or cost for the management of spent or used water that contains dissolved or suspended matter from a home, community farm, or industry.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">redevance sur les eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tasa por aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserabgabe</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterheffing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">налог на сточные воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установленный сбор, расходы, связанные с распоряжением отработанной или использованной воды, содержащей растворенные или взвешенные вещества промышленного, сельскохозяйственного или бытового происхождения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رسوم على الماء المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3757" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9129">
    <skos:prefLabel xml:lang="en">waste water discharge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The flow of treated effluent from any wastewater treatment process.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rejet d'eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">descarga de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwassereinleitung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitstoot van afvalwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">выброс сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поток обработанных стоков, образовавшийся после процесса обработки сточной воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من الماء المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9130" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9130">
    <skos:prefLabel xml:lang="en">waste water disposal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Collection and removal of wastewater deriving from industrial and urban settlements by means of a system of pipes and treatment plants.
(Source: MANCOS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évacuation des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disposición de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserentsorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">утилизация сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сбор и удаление сточных вод из промышленных или городских районов через систему труб и очистных сооружений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طرد الماء المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7629" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9129" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7630" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7641" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7756" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/939">
    <skos:prefLabel xml:lang="en">blue-green alga</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Microorganisms, formerly classified as algae but now regarded as bacteria, including nostoc, which contain a blue pigment in addition to chlorophyll.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">algue bleue</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alga verde-azul</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Blaualgen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">blauwwieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сине-зеленые водоросли</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Микроорганизмы, в прошлом относились к классу водорослей, но теперь считаются бактериями, включают также представителей семейства Nostoc, содержащие голубой пигмент, наряду с хлорофиллом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طحالب خضراء مزرقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6646" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9132">
    <skos:prefLabel xml:lang="en">wastewater from trade</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Liquid or waterborne wastes polluted or fouled by commercial operations.
(Source: ISEP /  DEE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eaux usées résiduaires industrielles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aguas residuales comerciales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gewerbliches Abwasser</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">industrieel afvalwater</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вода, загрязненная в результате хозяйственной деятельности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Жидкие или взвешенные в воде отходы, образовавшиеся в ходе хозяйственной деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الماء المستهلك الناجم عن التجارة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9133">
    <skos:prefLabel xml:lang="en">waste water legislation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to regulate the outflow and disposal of spent or used water from a home, community, farm or industry that contains dissolved or suspended matter.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">législation en matière d'eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">legislación de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserrecht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterwetgeving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">законодательство, регулирующее обращение со сточными водами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обязательное правило или свод таких правил, принятых государством, регулирующие процесс сброса и утилизации отработанной или использованной воды, образовавшейся в ходе промышленной, сельскохозяйственной, городской, бытовой деятельности и содержащей растворенные или взвешенные материалы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريع المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9091" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2759">
    <skos:prefLabel xml:lang="en">enrichment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of increasing the abundance of a specified isotope in a mixture of isotopes. It is usually applied to an increase in the proportion of U-235, or the addition of Pu-239 to natural uranium for use in a nuclear reactor or weapon.
(Source: DICCHE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">enrichissement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">enriquecimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anreicherung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verrijken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обогащение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс увеличения количества конкретного изотопа в смеси изотопов. Обычно применяется в отношении увеличения доли U-235 или добавления Pu-239 к природном урану для использования в ядерном реакторе или оружии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخصيب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6228" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9135">
    <skos:prefLabel xml:lang="en">waste water load</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of spent or used water, often containing dissolved and suspended matter, that is found in a stream or some other body of water.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">charge en eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">carga de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserlast</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterbelasting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">загрязнение сточными водами</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество использованной или отработанной воды, часто содержащей растворенные или взвешенные материалы, которая попадает в реку или другой водоем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حمل المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6465" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3842" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9136">
    <skos:prefLabel xml:lang="en">waste water purification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Processing of waste water for reuse.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">épuration des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">depuración de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterzuivering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистка сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обработка сточной воды для вторичного использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنقية المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6838" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/945">
    <skos:prefLabel xml:lang="en">boating</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To travel or go in a boat as a form of recreation.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">navigation de plaisance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">navegación de portiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bootsfahrt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">(bootje)varen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лодочный спорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Путешествовать или плавать на лодке в целях отдыха.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإبحار الترفيهي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4767" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7007" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9138">
    <skos:prefLabel xml:lang="en">waste water quality</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The state or condition of spent or used water that contains dissolved or suspended matter from a home, community farm or industry.
(Source: TOE / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">qualité des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">calidad de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserbeschaffenheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterkwaliteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">качество сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Состояние использованной или отработанной воды, содержащей растворенные или взвешенные вещества, образовавшиеся в процессе промышленной, сельскохозяйственной или бытовой деятельности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوعية المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9127" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/947">
    <skos:prefLabel xml:lang="en">biochemical oxygen demand</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of oxygen used for biochemical oxidation by a unit volume of water at a given temperature and for a given time. BOD is an index of the degree of organic pollution in water.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">demande biochimique en oxygène</skos:prefLabel>
    <skos:prefLabel xml:lang="es">demanda bioquímica de oxígeno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biochemischer Sauerstoffbedarf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biochemische zuurstofverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биохимическое потребление кислорода</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество кислорода, используемого для биохимического окисления единицей объема воды при данной температуре в течение определенного времени. БПК является показателем степени органического загрязнения воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأكسجين الكيميائي الحيوي المطلوب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1322" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9140">
    <skos:prefLabel xml:lang="en">waste water sludge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removed materials resulting from physical, biological and chemical treatment of waste water.
(Source: WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">boues résiduaires de traitement des eaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">barro de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserschlamm</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterslib</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сточный ил</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещества, полученные в результате физической, биологической или химической переработки сточных вод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وحل الماء المستهلك</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7632" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9141">
    <skos:prefLabel xml:lang="en">waste water statistics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">statistiques sur les eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estadísticas de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserstatistik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterstatistieken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">статистические данные о сбросе сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إحصائيات المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8077" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9143">
    <skos:prefLabel xml:lang="en">waste water treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any process to which wastewater is subjected which would remove, or otherwise render harmless to human health and the environment, its constituent wastes.
(Source: WWC / WQA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterverwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">переработка сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, которому подвергается сточная вода, в ходе которого все отходы, входящие в ее состав, удаляются либо делаются безвредными для здоровья человека и окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9136" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9139" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12259" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12277" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12278" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12287" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12293" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7613" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7636" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7739" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8036" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9144" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9246" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12599" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12600" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12601" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9144">
    <skos:prefLabel xml:lang="en">waste water treatment plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plant where, through physical-chemical and biological processes, organic matter, bacteria, viruses and solids are removed from residential, commercial and industrial wastewaters before they are discharged in rivers, lakes and seas.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station d'épuration des eaux usées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">depuradora de aguas residuales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Abwasserbehandlungsanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afvalwaterverwerkingsfabriek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">завод по переработке сточных вод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Завод, на котором из бытовых, коммерческих и промышленных стоков до их сброса в реки, озера и моря удаляются органические материалы, бактерии, вирусы и твердые вещества в результате серии физико-химических и биологических процессов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محطة معالجة المياه المستهلكة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7630" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/953">
    <skos:prefLabel xml:lang="en">boiler</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An enclosed vessel in which water is heated and circulated, either as hot water or as steam, for heating or power.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">chaudière</skos:prefLabel>
    <skos:prefLabel xml:lang="es">caldera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kessel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">warmwaterketel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">котел</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Закрытый резервуар, в котором вода нагревается и циркулирует (в виде горячей воды или в виде пара) для получения тепла или другой энергии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">غلاية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13225" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/954">
    <skos:prefLabel xml:lang="en">boiling point</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The temperature at which the transition from the liquid to the gaseous phase occurs in a pure substance at fixed pressure.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">point d'ébullition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">punto de ebullición</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Siedepunkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kookpunt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">точка кипения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Температура, при которой происходит переход чистого вещества из жидкого состояния в газообразное при неизменном давлении.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نقطة الغليان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9147">
    <skos:prefLabel xml:lang="en">water analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Study of the chemical, physical and biological properties of water.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse de l'eau</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasseruntersuchung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wateranalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение химических, физических и биологических свойств воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل المياه</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9214" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9149">
    <skos:prefLabel xml:lang="en">biological water balance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The amount of ingoing and outgoing water in a system, which are assumed to be equal in the long term so that the water budget will balance.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bilan hydrologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equilibrio hidrico biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wasserhaushalt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische waterbalans</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологический баланс воды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество входящей и исходящей воды в системе, которое должно быть одинаковым в долгосрочном плане с целью равновесия баланса воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التوازن الحيوي للماء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/867" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5088" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
