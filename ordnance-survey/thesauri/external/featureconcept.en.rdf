    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:40 PM CEST</dct:created>
    <dct:title xml:lang="en">Natural Geomorphologic Feature</dct:title>
    <skos:prefLabel xml:lang="en">Natural Geomorphologic Feature</skos:prefLabel>
    <dct:description xml:lang="en">A geomorphologic feature (i.e. landform) that has been created by natural Earth processes.</dct:description>
    <skos:definition xml:lang="en">A geomorphologic feature (i.e. landform) that has been created by natural Earth processes.</skos:definition>
