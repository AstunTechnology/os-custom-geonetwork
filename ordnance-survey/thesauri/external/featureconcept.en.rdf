    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:39 PM CEST</dct:created>
    <dct:title xml:lang="en">Environmental Monitoring Activity</dct:title>
    <skos:prefLabel xml:lang="en">Environmental Monitoring Activity</skos:prefLabel>
    <dct:description xml:lang="en">Specific set of AbstractMonitoringFeatures used for a given domain in a coherent and concise timeframe, area and purpose. Usually the information collected is treated as one time step in a long term monitoring programme. It is a concrete realisation of a given EnvironmentalMonitoringProgramme.</dct:description>
    <skos:definition xml:lang="en">Specific set of AbstractMonitoringFeatures used for a given domain in a coherent and concise timeframe, area and purpose. Usually the information collected is treated as one time step in a long term monitoring programme. It is a concrete realisation of a given EnvironmentalMonitoringProgramme.</skos:definition>
