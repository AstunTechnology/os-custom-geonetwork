    <dct:title xml:lang="en">PumpingStation</dct:title>
    <skos:prefLabel xml:lang="en">PumpingStation</skos:prefLabel>
    <dct:description xml:lang="en">A facility to move solids, liquids or gases by means of pressure or suction.</dct:description>
    <skos:definition xml:lang="en">A facility to move solids, liquids or gases by means of pressure or suction.</skos:definition>
    <vann:usageNote xml:lang="en">SOURCE [EuroRegionalMap]. NOTE Regarded as a candidate spatial object in Annex III theme 'Utility and governmental services' due to its role in water supply/waste management/etc., which are mentioned in the definition 2007/2/EC Ann III. 6. This type is a candidate type to be considered by the spatial data theme Utility and governmental services in Annex III to Directive 2007/2/EC.</vann:usageNote>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/us" />
