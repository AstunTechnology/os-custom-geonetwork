  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5199">
    <skos:prefLabel xml:lang="en">methane</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A colourless, odourless, and tasteless gas, lighter than air and reacting violently with chlorine and bromine in sunlight, a chief component of natural gas; used as a source of methanol, acetylene, and carbon monoxide. Also known as methyl hydride.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthane</skos:prefLabel>
    <skos:prefLabel xml:lang="es">metano</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Methan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">moerasgas</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метан</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Бесцветный, безвкусный газ без запаха, легче воздуха, быстро реагирующий с хлором и бромом на свету, главный компонент природных газов; источник метанола, ацетилена моноксида углерода. Также известен под названием метилгидрид.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الميثين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/322" />
