  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7283">
    <skos:prefLabel xml:lang="en">road salt</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Salt used against the formation of ice on roads; when excess salt washes off the roads, it can poison roadside vegetation or raise salt concentrations in streams and reserves of underground water. It also accelerates the deterioration of concrete and metal.
(Source: WPR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sel d'épandage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sal para deshielo de carreteras</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Streusalz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">weg(en)zout</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">техническая соль</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Соль, применяемая для предотвращения образования льда на дорогах; когда излишнее количество соли смывается с дорожного покрытия, это может отравить придорожную растительность, повысить содержание солей в расположенных рядом водоемах или грунтовых водах. Также способствует разрушению бетона и металла.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملح الطُرُق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11813" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8136" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5733">
    <skos:prefLabel xml:lang="en">nuclear physics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of the characteristics, behaviour and internal structures of the atomic nucleus.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">physique nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">la física nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernphysik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kernfysica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ядерная физика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение свойств, поведения и внутренней структуры атомных ядер.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الفيزياء النووية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6235" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6894" />
