    <dct:title xml:lang="en">habitat distribution unit</dct:title>
    <skos:prefLabel xml:lang="en">habitat distribution unit</skos:prefLabel>
    <dct:description xml:lang="en">Represents individual features (units) in a distribution of habitats.</dct:description>
    <skos:definition xml:lang="en">Represents individual features (units) in a distribution of habitats.</skos:definition>
    <vann:usageNote xml:lang="en">The habitat distribution unit is part of the geographical distribution of a certain habitat (habitat type). It indicates the occurrence (presence or absence) of a habitat.</vann:usageNote>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/hb" />
