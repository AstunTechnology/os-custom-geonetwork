    <dct:title xml:lang="en">Aquitard</dct:title>
    <skos:prefLabel xml:lang="en">Aquitard</skos:prefLabel>
    <dct:description xml:lang="en">A saturated, but poorly permeable bed that impedes groundwater movement.</dct:description>
