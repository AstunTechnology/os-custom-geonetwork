    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8014">
    <skos:prefLabel xml:lang="en">sports facility</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Buildings, constructions, installations, organized areas and equipment for indoor and outdoor sport activities.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">infrastructure sportive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">equipamiento deportivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sportanlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sportvoorziening</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спортивное сооружение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Здания, сооружения, установки, организованные площадки и оборудование для занятия спортом внутри помещений или на открытом воздухе.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مرفق رياضي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/516" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10861" />
