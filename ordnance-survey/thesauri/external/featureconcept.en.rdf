    <dct:title xml:lang="en">Waterway Link</dct:title>
    <skos:prefLabel xml:lang="en">Waterway Link</skos:prefLabel>
    <dct:description xml:lang="en">A linear spatial object that describes the geometry or connectivity of the water transport network between two consecutive waterway or watercourse nodes. It represents a linear section across a body of water which is used for shipping.</dct:description>
    <skos:definition xml:lang="en">A linear spatial object that describes the geometry or connectivity of the water transport network between two consecutive waterway or watercourse nodes. It represents a linear section across a body of water which is used for shipping.</skos:definition>
