    <skos:prefLabel xml:lang="fr">méthode culturale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método de cultivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anbautechnik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">teeltmethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод культивации</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">طريقة الزراعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13164" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8175" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1899" />
