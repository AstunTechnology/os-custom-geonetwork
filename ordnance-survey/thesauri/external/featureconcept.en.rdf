    <dct:title xml:lang="en">Intertidal Area</dct:title>
    <skos:prefLabel xml:lang="en">Intertidal Area</skos:prefLabel>
    <dct:description xml:lang="en">The part of the marine environment that is exposed (not covered in water) during a normal tidal cycle; defined as the difference between any high and any low water level.</dct:description>
    <skos:definition xml:lang="en">The part of the marine environment that is exposed (not covered in water) during a normal tidal cycle; defined as the difference between any high and any low water level.</skos:definition>
