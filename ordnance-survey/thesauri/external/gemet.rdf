    <skos:prefLabel xml:lang="nl">mosselteelt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">разведение моллюсков</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение моллюсков для продажи в качестве продукта питания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تربية بلح البحر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/501" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10753" />
