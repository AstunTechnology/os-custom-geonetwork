    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11692">
    <skos:prefLabel xml:lang="en">solid particle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any tiny or very small mass of material that has a definite volume and shape and resists forces that would alter its volume or shape.
(Source: OMD / MHD / APD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">particule solide</skos:prefLabel>
    <skos:prefLabel xml:lang="es">partícula sólida</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Feststoffteilchen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vast deeltje</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">твердая частица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мельчайшая частица или очень маленькая масса материала, обладающая определенными объемом и формой и которая сопротивляется действию сил, стремящихся их изменить.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جزيء صلب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6052" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11693">
    <skos:prefLabel xml:lang="en">purifying power</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Regenerative capacity of a system, of soils, water, etc.
(Source: ECHO2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pouvoir épurateur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">poder de purificación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Reinigungskraft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zuiverend vermogen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">очистительная способность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Регенеративная способность системы, почвы, воды и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القدرة التطهيرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
