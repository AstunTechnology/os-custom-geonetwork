    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:46 PM CEST</dct:created>
    <dct:title xml:lang="en">Railway Node</dct:title>
    <skos:prefLabel xml:lang="en">Railway Node</skos:prefLabel>
    <dct:description xml:lang="en">A point spatial object which represents a significant point along the railway network or defines an intersection of railway tracks used to describe its connectivity.</dct:description>
    <skos:definition xml:lang="en">A point spatial object which represents a significant point along the railway network or defines an intersection of railway tracks used to describe its connectivity.</skos:definition>
