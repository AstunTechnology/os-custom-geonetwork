    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4359">
    <skos:prefLabel xml:lang="en">in situ</skos:prefLabel>
    <skos:scopeNote xml:lang="en">In the natural or normal place.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">in situ</skos:prefLabel>
    <skos:prefLabel xml:lang="es">in situ</skos:prefLabel>
    <skos:prefLabel xml:lang="de">in-situ</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ter plaatse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">"на месте"</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">В естественном или нормальном местоположении.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">في الموقع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/14848" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/14980" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4360">
    <skos:prefLabel xml:lang="en">inspection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An official examination and evaluation of the extent to which specified goals, objectives, standards, policies or procedures of an agency, organization, department or unit have been met properly.
(Source: DAM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">inspection</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inspección</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Inspektion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inspectie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инспекция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучать внимательно и критически, исследовать и официально тестировать.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تفتيش - فحص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4361" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8931" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4361">
    <skos:prefLabel xml:lang="en">inspection of records</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">inspection des registres</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inspección de registros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Akteneinsicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inspectie van de boeken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">проверка записей</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">فحص السجلات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4360" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4362">
    <skos:prefLabel xml:lang="en">inspection service</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An organization designated to look into, supervise and report upon, the staff members and workings of some institution or department, or the conforming to laws and regulations by a segment of society or other group.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">service d'inspection</skos:prefLabel>
    <skos:prefLabel xml:lang="es">servicio de inspección</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Prüfdienst</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">keuringsdienst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инспекционная служба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Организация, предназначенная контролировать, отслеживать и докладывать о деятельности организаций и их сотрудников, о выполнении положений законов и правил частью общества или социальной группой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هيئة التفتيش</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4363">
    <skos:prefLabel xml:lang="en">installation requiring approval</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The official authorization needed to assemble and place into position any apparatus, facility, military post or machinery.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">installation nécessitant une habilitation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">instalación que precisa autorización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Genehmigungsbedürftige Anlage</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">installatie die goedgekeurd vereist</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">установка, требующая специального разрешения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Официальное разрешение, требуемое для монтажа и установки любого прибора, объекта, военного поста или оборудования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجهيزات تتطلب الحصول على موافقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11504" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4365">
    <skos:prefLabel xml:lang="en">institutionalisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The establishment and normalization of a law, custom, usage, practice, system or regulative principle in the activity or purpose of a group or organization.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">institutionnalisation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">institucionalización</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Institutionalisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">institutionalisering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">институционализация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установление и принятие закона, обычая, практики, системы или руководящего принципа в деятельности группы или организации.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مأسسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13289" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4369">
    <skos:prefLabel xml:lang="en">instrument manufacture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">No definition needed.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie d'appareillage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fábrica de instrumentos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Instrumentenherstellung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">instrumentenvervaardiging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство инструментов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Не требует толкования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الأدوات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5005" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4371">
    <skos:prefLabel xml:lang="en">sound insulation material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Material used to reduce the transmission of sound to or from a body, device, room, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matériau isolant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material para aislamiento acústico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dämmstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">isolatiemateriaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">звукоизолирующий материал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Материал, используемый для снижения передачи звука от или по направлению к какому-либо объекту, прибору, помещению и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة عازلة للصوت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/15020" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4374">
    <skos:prefLabel xml:lang="en">insurance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The act, system, or business of providing financial protection contingencies, such as death, loss or damage and involving payment of regular premiums in return for a policy guaranteeing such protection.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">assurance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">seguros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Versicherung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verzekering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">страхование</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие, система или деловая практика, состоящие в обеспечении финансовой защиты  от неожиданных случаев, таких как смерть, потеря или ущерб имуществу, подразумевающие регулярную выплату страховых премий в обмен на страховой полис, гарантирующий такую защиту.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تأمين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4375" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4376" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12887" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12889" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4375">
    <skos:prefLabel xml:lang="en">insurance business</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A commercial service which provides a guarantee against most losses or harm to a person, property or a firm in return for premiums paid.
(Source: RHW /  ISEP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compagnie d'assurance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compañía de seguros</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Versicherungswirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verzekeringsmaatschappij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">страховой бизнес</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Коммерческая служба, представляющая гарантии от большинства видов ущерба или урона людям, имуществу или коммерческой структуре в обмен на выплачиваемые страховые премии.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أعمال التأمين</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4374" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4376">
    <skos:prefLabel xml:lang="en">insurance coverage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The protection provided against risks or a risk, often as specified by the type of protection or the item being protected.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">couverture d'assurance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cobertura de seguro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Versicherungsschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dekking (door een verzekering)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">действие страховки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Защита, предоставленная против риска или рисков, часто в соответствии с конкретным типом защиты или объекта страхования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التغطية التأمينية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4374" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4378">
    <skos:prefLabel xml:lang="en">integral natural reserve</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Areas allocated to preserve and protect certain animals and plants, or both. They differ from national parks, which are largely a place for public recreation, because they are provided exclusively to protect species for their own sake. Endangered species are increasingly being kept in nature reserves to prevent them from extinction. Nature reserves also serve as a place for more plentiful species to rest, breed or winter.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">réserve naturelle intégrale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">reserva natural integral</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Integrales Naturreservat</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">integraal natuurreservaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">комплексный природный заповедник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Территория, предназначенная для охраны конкретных видов растений или животных или и тех и других. Отличаются от национальных парков, которые, в основном, являются местами для отдыха и развлечений, тем, что созданы именно для защиты видов живой природы. Виды, находящиеся под угрозой, сохраняются именно в таких заповедниках. Природные заповедники также предоставляют более благополучным видам возможность для отдыха, гнездования и зимовки.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محمية طبيعية متكاملة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5545" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/730">
    <skos:prefLabel xml:lang="en">basic food requirement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The minimum nutriments deemed necessary for a person of a particular age, gender, physiological condition and activity level to sustain life, health and growth.
(Source: PAJ)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">besoins alimentaires de base</skos:prefLabel>
    <skos:prefLabel xml:lang="es">necesidades alimenticias básicas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grundnahrungsmittelbedarf</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">basisbehoefte aan voedsel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потребности в основных продуктах питания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Минимальное количество питательных веществ, которое необходимо для поддержания жизни, здоровья и роста человеку конкретного пола, возраста, физического состояния и активности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المتطلبات الغذائية الأساسية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3381" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4382">
    <skos:prefLabel xml:lang="en">integrated environmental protection technology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Technologies that meet environmental objectives by incorporating pollution prevention concepts in their design. Integrated environmental control strategies introduced in the early design stages of a process, rather than an end-of-pipe control option introduced in the later stages, improve the technical and economic performance of a process.
(Source: ENVAR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">technologie de protection environnementale intégrée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tecnología integrada de protección del medio ambiente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Integrierte Umweltschutztechnik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geïntegreerde milieubeschermingstechnologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">интегрированная природоохранная технология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Технологии, которые отвечают целям охраны природы вследствие того, что в своей конструкции учитывают экологические принципы. Интегрированные стратегии контроля за окружающей средой, реализуемые на ранних технологических стадиях в отличие от технологий, нацеленных на устранение уже нанесенного экологического ущерба, в конечном итоге улучшают технические и экономические характеристики процесса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تكنولوجيا حماية البيئة المتكاملة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2932" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4383">
    <skos:prefLabel xml:lang="en">integrated pest control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A systematic, comprehensive approach to pest control that uses the insect's or rodent's own biology and behaviour to find the least toxic control methods at the lowest cost.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">lutte intégrée contre les nuisibles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control integrado de plagas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Integrierte Schädlingsbekämpfung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geïntegreerde ongediertebestrijding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">интегрированная система контроля за вредителями</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Систематизированный, всеобъемлющий подход к вопросам борьбы с вредителями, использующий биологические особенности того или иного насекомого или грызуна для того, чтобы найти наименее токсичные и наиболее экономичные меры контроля.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيطرة المتكاملة على الحشرات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6139" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12576">
    <skos:prefLabel xml:lang="en">biofiltration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The distribution of settled sewage on a bed of inert granular material through which it is allowed to percolate. In doing so, the effluent is aerated thus allowing aerobic bacteria and fungi to reduce its biochemical oxygen demand.
(Source: PORT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biofiltration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">biofiltrado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tropfkörperbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biofiltratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биофильтрация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Распределение осажденного сточного материала на слое инертного гранулированного материала, через который он может просачиваться. В ходе этого процесса жидкие стоки подвергаются аэрации, что позволяет аэробным бактериям и грибам снижать его потребности в биохимическом кислороде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تشريح حيوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12601" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/878" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3190" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4386">
    <skos:prefLabel xml:lang="en">integrated pollution control</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A procedure whereby all major emissions to land, air, and water are considered simultaneously and not in isolation to avoid situations in which one control measure for one medium adversely affects another.
(Source: GILP96)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">contrôle intégré de la pollution</skos:prefLabel>
    <skos:prefLabel xml:lang="es">control de contaminación integrado</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Integrierter Umweltschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geïntegreerde vervuilingsbeheersing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">интегрированная система контроля за загрязнением окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Подход, при котором все масштабные выбросы загрязняющих веществ в почву, воздух и воду рассматриваются одновременно, а не изолированно друг от друга для того, чтобы избежать ситуации, когда реализация одной меры контроля для одной среды может отрицательно сказаться на других средах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السيطرة المتكاملة على التلوث</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6451" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5056">
    <skos:prefLabel xml:lang="en">marker</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Small amount of an easily detected substance that can be used to follow and quantify the flow of materials or movement of organisms not otherwise visible or detectable by ordinary means.
2) An isotope of an element, a small amount of which may be incorporated into a sample of material in order to follow the course of that element through a chemical, biological, or physical process, and thus also follow the larger sample. The tracer may be radioactive, in which case observations are made by measuring the radioactivity.
(Source: ECHO1)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marqueur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marcador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Markierungsstoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">merkstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">индикатор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Небольшое количество легко обнаружаемого вещества, которое может быть использовано для отслеживания и количественного анализа потока материала, движения организмов, которые при других условиях невидимы или не поддаются обнаружению. 2) Изотоп элемента, который может быть добавлен к небольшому количеству материала образца для того, чтобы отследить движение этого элемента в химическом, физическом или биологическом процессе, а также отследить движение самого образца. Индикатор может быть радиоактивным, в этом случае наблюдения основываются на измерении радиоактивности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المعلِّم (من العلامة)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/861" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11672" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9071">
    <skos:prefLabel xml:lang="en">waste dumping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The disposal of solid wastes without environmental controls.
(Source: LANDYa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mise en décharge des déchets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">vertido de residuos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Lagerung von Abfall</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">storten van afval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сваливание отходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Утилизация отходов при отсутствии экологического контроля.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التخلص من النفايات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2367" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4390">
    <skos:prefLabel xml:lang="en">intensive animal husbandry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Specialized system of breeding animals where the livestock are kept indoors and fed on concentrated foodstuffs, with frequent use of drugs to control diseases which are a constant threat under these conditions.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élevage intensif</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ganadería intensiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Intensivtierhaltung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">intensieve veehouderij</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">интенсивное животноводство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специализированная система разведения животных, при которой животные содержатся в закрытых помещениях и питаются концентрированными кормами с частым применением медицинских препаратов для профилактики болезней, являющихся при таких условиях содержания постоянной угрозой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التربية المكثفة للحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/994" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4391">
    <skos:prefLabel xml:lang="en">intensive farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Farming in which as much use is made of the land as possible by growing crops close together or by growing several crops in a year or by using large amounts of fertilizers.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">agriculture intensive</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agricultura intensiva</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Intensivlandwirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">intensieve landbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">интенсивное фермерское хозяйство</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Хозяйство, в котором земля используется в максимально возможной степени: засевают культуры очень близко друг от друга, выращивают несколько урожаев за один год или используют большое количество удобрений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الزراعة الكثيفة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12586">
    <skos:prefLabel xml:lang="en">engineering</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science by which the properties of matter and the sources of power in nature are made useful to humans in structures, machines, and products.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ingéniérie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ingeniería</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ingenieurwesen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">techniek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инжиниринг</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наука, с помощью которой свойства материи и источники природной энергии используются с пользой для человека в составе конструкций, машин или продуктов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">هندسة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/496" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5093" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/195" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1305" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1434" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2586" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4084" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5032" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5128" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5287" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8589" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10055" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10133" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11359" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13218" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4395">
    <skos:prefLabel xml:lang="en">interaction of pesticides</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The enhancement of activity of pesticides when they are used in combination with others.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">interaction des pesticides</skos:prefLabel>
    <skos:prefLabel xml:lang="es">interacción de plaguicidas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pestizidwechselwirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wisselwerking van bestrijdingsmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">взаимодействие пестицидов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Усиление активности пестицидов, когда они используются в комбинации с другими.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تفاعل المبيدات الحشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/766" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4398">
    <skos:prefLabel xml:lang="en">interchange of electronic data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A transference of binary coded information items between two or more computers across any communications channel capable of carrying electromagnetic signals.
(Source: WIC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">échange de données informatisées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intercambio de datos electrónicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elektronischer Datenaustausch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">uitwisseling van elektronische gegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">обмен электронными данными</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Передача элементов информации в двоичной кодировке между двумя и более компьютерами по коммуникационным каналам, способным пропускать электромагнитные сигналы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تبادل البيانات الإلكترونية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1984" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1922" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8925">
    <skos:prefLabel xml:lang="en">vegetation type</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A community of plants or plant life that share distinguishable characteristics.
(Source: PEM)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">type de végétation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tipo de vegetación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vegetationstyp</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">soort plantegroei</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">тип растительности</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сообщество растений или растительная жизнь, которые обладают общими чертами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نوعية الزراعات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8922" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10593" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4400">
    <skos:prefLabel xml:lang="en">interdisciplinary research</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The utilisation, combination and coordination of two or more appropriate disciplines, technologies and humanities in an integrated approach toward environmental problems.
(Source: UNUN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">recherche interdisciplinaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">investigación interdisciplinaria</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Interdisziplinäre Forschung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">interdisciplinair onderzoek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">междисциплинарные исследования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование, комбинация и координация двух и более соответствующих дисциплин, технологий или гуманитарных наук в ходе реализации интегрированного подхода к решению экологических проблем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بحث بيني التخصصات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11148" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4401">
    <skos:prefLabel xml:lang="en">interest</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sum paid or charged for the use of money or for borrowing money over a given time period.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">intérêts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">interés</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zins</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belang</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">банковский процент</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ставка за заем средств или платеж, получаемый за предоставленную ссуду.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فائدة  (مالي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13177" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4402">
    <skos:prefLabel xml:lang="en">interest group</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A group of people who share common traits, attitudes, beliefs or objectives and who have formed a formal organization to serve specific concerns of the membership.
(Source: AUB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">groupe d'intérêt</skos:prefLabel>
    <skos:prefLabel xml:lang="es">grupo de interés</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Interessenverband</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">belangengroep</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">группа по интересам</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа лиц, объединенных общими чертами, мнениями, представлениями, которые образовали формальную организацию для реализации конкретных целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جماعة مصالح</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6594" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4404">
    <skos:prefLabel xml:lang="en">interim decision</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">décision provisoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">decisión provisional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Teilbescheid</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tussentijds besluit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">промежуточное решение</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">قرار مؤقت</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10785">
    <skos:prefLabel xml:lang="en">pedagogy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The principles, practice, or profession of teaching.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pédagogie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pedagogía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pädagogik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pedagogie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">педагогика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Принципы, практика преподавания или преподавательская профессия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم التربية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10019" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12599">
    <skos:prefLabel xml:lang="en">aerobic treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The introduction of air into sewage so as to provide aerobic biochemical stabilization during a detention period.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement aérobie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento aeróbico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aerobe Behandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">aërobe behandeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэробная обработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Доступ воздуха к стокам для аэробной биохимической стабилизации в течение определенного периода их удержания.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة حيوية هوائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/879" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4408">
    <skos:prefLabel xml:lang="en">interlaboratory comparison</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Tests performed at the same time in different laboratories to validate the quality of the results.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">comparaison interlaboratoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comparación entre laboratorios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ringversuch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vergelijking tussen laboratoria</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внутрилабораторные сравнения результатов исследований</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Опыты, проводимые одновременно в разных лабораториях с целью проверки результатов исследований.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مقارنة النتائج بين عدة معامل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8412" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12601">
    <skos:prefLabel xml:lang="en">biological treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Process that uses microorganisms to decompose organic wastes either into water, carbon dioxide, and simple inorganic substances, or into simpler organic substances, such as aldehydes and acids. The purpose of a biological treatment system is to control the environment for microorganisms so that their growth and activity are enhanced, and provide a means for maintaining high concentration of the microorganisms in contact with the wastes.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Biologische Behandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">biologische verwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">биологическая обработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование микроорганизмов для разложения органических отходов либо на воду, углекислый газ и простые неорганические вещества, либо на более простые органические вещества, например, альдегиды или кислоты. Системы биологической обработки осуществляют контроль за окружающей средой микроорганизмов в целях обеспечения благоприятных условий для их роста и жизнедеятельности, а также поддержания высокой концентрации микроорганизмов, находящихся в контакте с отходами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة حيوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12576" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9143" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4410">
    <skos:prefLabel xml:lang="en">intermediate goods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Partly finished goods or products that re-enter into production elsewhere.
(Source: ISEP /  MGHME)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">produits intermédiaires</skos:prefLabel>
    <skos:prefLabel xml:lang="es">productos intermedios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zwischenprodukt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tussenproducten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">полуфабрикаты</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Товары, подвергшиеся частичной обработке или продукты, поступающие в дальнейшую переработку в другом месте.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلع وسيطة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10930" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4412">
    <skos:prefLabel xml:lang="en">intermittent noise</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Noise occurring at regular or irregular intervals.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bruit intermittent</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ruido intermitente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Intermittierendes Geräusch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">afwisselend geluid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">прерывистый звук</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Звук, производимый через регулярные или нерегулярные интервалы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ضوضاء متقطعة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5658" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12605">
    <skos:prefLabel xml:lang="en">physicochemical treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any processing of wastewater, toxic substances or other materials involving a combination of physical and chemical methods, such as physical processes including air-stripping or filtration and chemical processes including coagulation, chlorination or ozonation.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement physicochimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento fisicoquímico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physikalisch-chemische Behandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysico-chemische behandeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физико-химическая обработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая переработка сточных вод, токсичных веществ или иных материалов, предполагающая комбинацию физических и химических методов, например, таких физических процессов, как фильтрация, с такими химическими процессами, как коагуляция, хлорирование или озонирование.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة فيزيائية - كيميائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/171" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/934" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1506" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1509" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2048" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2098" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3229" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3324" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3550" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4173" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5841" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6855" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/39" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4414">
    <skos:prefLabel xml:lang="en">internal European market</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">marché intérieur européen</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mercado interior europeo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Europäischer Binnenmarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Europese binnenmarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внутренний европейский рынок</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">السوق الأوروبية الداخلية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5058" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4415">
    <skos:prefLabel xml:lang="en">internalisation of environmental costs</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">internalisation des coûts environnementaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">internalización de costes ambientales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internalisierung der Umweltkosten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">interne aanrekening van milieukosten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">внутренний экономический учет природоохранных затрат</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التوجيه الداخلي للتكاليف البيئية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2796" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12608">
    <skos:prefLabel xml:lang="en">secondary treatment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Stage of the process of waste water treatment: following primary treatment by sedimentation, the second step in most wastewater systems in which biological organisms decompose most of the organic matter into a innocuous, stable form.
(Source: CORBIT /  WQA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traitement secondaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">tratamiento secundario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sekundärbehandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">secundaire behandeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вторичная обработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Этап обработки жидких отходов. После первичной обработки, состоящей в осаждении взвешенных твердых материалов, второй этап в большинстве систем обработки стоков заключается в разложении органических материалов под действием биологических организмов и превращение их в безвредные, стабильные формы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معالجة ثانوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6650" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4417">
    <skos:prefLabel xml:lang="en">international agreement</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Cooperation in international efforts to support global environmental goals. Solutions to environmental problems such as trans-boundary airborne and waterborne pollution, ozone depletion and climate change require action by all responsible countries.
(Source: WRES)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">accord international</skos:prefLabel>
    <skos:prefLabel xml:lang="es">acuerdo internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Vereinbarung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale overeenkomst</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международное соглашение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Объединение международных усилий для достижения решения международных экологических задач. Решение таких проблем, как трансграничный перенос загрязняющих веществ в воздухе и воде, разрушение озонового слоя, изменение климата требуют действий всех ответственных государств.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اتفاقية دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4438" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5419" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4420" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5057">
    <skos:prefLabel xml:lang="en">tracer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A minute quantity of radioactive isotope used in medicine or biology to study the chemical changes within living tissues.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">traceur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trazador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tracer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">merkstof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">меченый атом</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Небольшое количество радиоактивного изотопа, используемое в биологии или медицине для изучения химических изменений в живых тканях.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مُقتَف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/861" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6919" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4419">
    <skos:prefLabel xml:lang="en">international competitiveness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The ability of firms to strive with rivals in the production and sale of commodities in worldwide markets.
(Source: ODE / OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">compétitivité internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">competitividad internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Wettbewerbsfähigkeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale concurrentie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная конкурентоспособность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Способность компаний выживать в борьбе с конкурентами в области производства и торговли на мировых рынках.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنافسية دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13262" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4420">
    <skos:prefLabel xml:lang="en">international convention</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Treaties and other agreements of a contractual character between different countries or organizations of states creating legal rights and obligations between the parties.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">convention internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">convenio internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Übereinkommen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale conventie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная конвенция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Договора или другие соглашения обязательного характера между разными странами, организациями или государствами, предусматривающие права и обязанности между участвующими сторонами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">معاهدة دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1776" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3687" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4417" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4421">
    <skos:prefLabel xml:lang="en">international co-operation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The collaboration between governments, businesses or individuals in which it is agreed to work together on similar objectives or strategies, particularly in research or in setting industrial standards.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">coopération internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cooperación internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Zusammenarbeit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale samenwerking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международное сотрудничество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сотрудничество между правительствами, коммерческими структурами или физическими лицами, в рамках которого участники договариваются работать совместно для достижения конкретных целей, особенно в области научных исследований или разработки стандартов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تعاون دولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4438" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4422">
    <skos:prefLabel xml:lang="en">International Court of Justice</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Judicial arm of the United Nations. It has jurisdiction to give advisory opinions on matters of law and treaty construction when requested by the General Assembly, Security Council or any other international agency authorised by the General Assembly to petition for such opinion. It has jurisdiction, also, to settle legal disputes between nations when voluntarily submitted to it.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Cour internationale de justice</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tribunal internacional de Justicia</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationaler Gerichtshof</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Internationaal Gerechtshof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Международный Суд</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Юридический орган Организации Объединенных Наций. Обладает юрисдикцией давать рекомендации по вопросам права и толкования договоров при запросе Генеральной Ассамблеи, Совета Безопасности или любого другого международного агентства, уполномоченного ГА давать такие запросы. В его юрисдикцию входит также решение переданных ему на рассмотрение юридических споров между государствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محكمة العدل الدولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4434" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4423">
    <skos:prefLabel xml:lang="en">international distribution</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The worldwide allocating of resources or dispersing of goods.
(Source: ISEP /  RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">distribution internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">distribución internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Verteilung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale verdeling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международное распределение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Международное распределение ресурсов или товаров.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">توزيع دولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13148" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4424">
    <skos:prefLabel xml:lang="en">international division of labour</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">division internationale du travail</skos:prefLabel>
    <skos:prefLabel xml:lang="es">división internacional de trabajo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Arbeitsteilung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale verdeling van werk</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международное разделение труда</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">التقسيم الدولي للعمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4584" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4427">
    <skos:prefLabel xml:lang="en">international environmental relations</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The political or diplomatic interaction or dealings between independent nations that pertain to ecological concerns.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relations internationales pour l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relaciones ambientales internacionales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Umwelbeziehungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale milieuverhoudingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международные отношения по вопросам окружающей среды</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политическое или дипломатическое взаимодействие между независимыми государствами, имеющее отношение к вопросам окружающей среды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العلاقات البيئية الدولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4438" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2892" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4429">
    <skos:prefLabel xml:lang="en">international harmonisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Harmonisation of the interrelationship of sovereign states by the application of general principles recognized by civilized nations.
(Source: DICLAWa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">harmonisation internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">armonización internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Harmonisierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale harmonisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная гармонизация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Гармонизация взаимодействия суверенных государств в результате применения общих принципов, признанных всеми цивилизованными государствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التناغم الدولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4438" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4430">
    <skos:prefLabel xml:lang="en">international law</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The system of law regulating the interrelationship of sovereign states and their rights and duties with regard to one another.
(Source: DICLAW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">droit international</skos:prefLabel>
    <skos:prefLabel xml:lang="es">derecho internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationales Recht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationaal recht</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международное право</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система права, регулирующая взаимоотношения между суверенными государствами, их права и обязанности в отношении друг друга.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">القانون الدولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10084" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13264" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13265" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13266" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11661">
    <skos:prefLabel xml:lang="en">prevention measure</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Measures taken in advance to prevent the occurrence of disasters or similar emergencies.
(Source: GUNNa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">mesure de prévention</skos:prefLabel>
    <skos:prefLabel xml:lang="es">medida de prevención</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vorbeugungsmaßnahme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voorkomingsmaatregel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">профилактическая мера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предупредительные меры, предпринимаемые для предотвращения наступления бедствия или аналогичных чрезвычайных ситуаций.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إجراء وقائي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7364" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1959" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2221" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3218" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10034" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12866" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5311" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5785" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6600" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10049" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4432">
    <skos:prefLabel xml:lang="en">internationally important ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Ecosystems whose importance is recognised at international level and which are, in some cases, protected by international conventions.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème d'importance internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistemas de importancia internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">International wichtiges Ökosstem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationaal belangrijk ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экосистема международного значения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экосистемы, чья важность признана на международном уровне и которые в некоторых случаях охраняются международными конвенциями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام إيكولوجي ذو أهمية دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4434">
    <skos:prefLabel xml:lang="en">international organisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An association of independent states, whose representatives gather for the promotion of common interests including defense and trade.
(Source: GT2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisation internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organizaciones internacionales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Organisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale organisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная организация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ассоциация независимых государств, признанных в качестве юридических лиц, содействующая общим интересам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منظمة دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13292" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/595" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3006" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4422" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7752" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8776" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11046" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4438" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4436">
    <skos:prefLabel xml:lang="en">international politics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The use of methods, strategy, intrigue, decision making and power by governments and their representatives to achieve goals in policy making or governmental affairs in a worldwide or international arena.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Politik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale politiek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная политика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение методов, стратегий, интриг, принятия решений, власти государствами и их представителями для достижения конкретных политических или государственных целей на международной арене.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6371" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2755" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4438">
    <skos:prefLabel xml:lang="en">international relations</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The political or diplomatic interaction or dealings between independent nations.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">relation internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">relaciones internacionales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Beziehungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale betrekkingen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международные отношения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Политическое или дипломатическое взаимодействие между независимыми государствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علاقات دولية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2031" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2414" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4417" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4421" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4427" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4429" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11031" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13143" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14971" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3405" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4434" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4440">
    <skos:prefLabel xml:lang="en">international river basin</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Land area drained by a river and its tributaries whose waters are situated in and utilized by two or more countries.
(Source: TOE / EWP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bassin fluvial international</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cuenca fluvial internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Grenzüberschreitendes Flußeinzugsgebiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationaal rivierbekken</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международный речной бассейн</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Земля, по которой протекают река и ее притоки, находящиеся на территории нескольких государств или используемые ими.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حوض نهر دولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/963" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12145" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4441">
    <skos:prefLabel xml:lang="en">international safety</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Freedom from danger or the quality of averting risk of harm to persons, property or the environment shared across one or more national boundaries; consequently, the combined efforts of more than one nation to achieve or preserve that state.
(Source: OED / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sécurité internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">seguridad internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Sicherheit</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale veiligheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная безопасность</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отсутствие опасности или способность предотвращать угрозу ущерба людям, имуществу или окружающей среде, действие которого выходит за пределы одной или нескольких государственных границ; также комбинированные усилия нескольких государств по достижению или сохранению этого состояния.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأمن الدولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7362" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/557" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4442">
    <skos:prefLabel xml:lang="en">international standardisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of establishing or conforming something to a norm or measure that is recognized beyond the boundaries of a single country or nation.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">normalisation internationale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">normas internacionales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Normierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale standaardisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная стандартизация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс установления или приведения чего-либо в соответствие с нормами или мерами, признание которых выходит за границы одного государства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">وضع معايير دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8048" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4444">
    <skos:prefLabel xml:lang="en">international trade</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The flow of commodities and goods between nations.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">commerce international</skos:prefLabel>
    <skos:prefLabel xml:lang="es">comercio internacional</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationaler Handel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale handel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международная торговля</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Поток товаров между государствами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تجارة دولية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3405" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2415" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4448">
    <skos:prefLabel xml:lang="en">international watercourse</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Portions of a geographical area which constitutes a hydrogeological unit as the catchment area for a single river which are under the jurisdiction of two or more countries.
(Source: WPRa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cours d'eau international</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cursos de agua internacionales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Wasserstraße</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">internationale waterweg</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">международный водный путь</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Часть географического региона, составляющая гидрогеологическую единицу, как, например, водосборная площадь реки, находящаяся под юрисдикцией двух и более государств</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مجرى مائي دولي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/963" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9161" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4451">
    <skos:prefLabel xml:lang="en">interpretation method</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Method employed in the assessment of the meaning and significance of data, results, facts, etc.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">méthode d'interprétation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">método de interpretación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Auswertungsverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">interpretatiemethode</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метод интерпретации</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Метод, используемый при оценке значения и важности данных, результатов, фактов и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أسلوب التفسير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3013" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4454">
    <skos:prefLabel xml:lang="en">intertidal zone</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) The area between land and sea which is regularly exposed to the air by the tidal movement of the sea. Marine organisms that inhabit the intertidal zones have to adapt to periods of exposure to air and to the waves created by wind, which makes it the most physically demanding of the marine habitats. 
2) The shore zone between the highest and lowest tides.
(Source: WRIGHT /  LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">zone intertidale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">zona entre mareas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tidebereich</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gebied tussen de hoog- en de laagwaterlijn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">зона приливов и отливов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Территория между сушей и морем, которая регулярно обнажается движением морских приливов. Морские животные, которые обитают в этой зоне, должны приспособиться к условиям жизни на открытом воздухе и среди морских волн, что делает эту зону одной из самых сложных по условиям выживания. 2) Участок побережья между самой высокой и самой низкой отметкой прилива.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة المد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1513" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8480" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4455">
    <skos:prefLabel xml:lang="en">intervention in nature and landscape</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Stepping in or participating in problem solving efforts for troublesome or perplexing situations involving the natural world or scenery.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">intervention au niveau de la nature et des paysages</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intervención en la naturaleza y el paisaje</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eingriff in Natur und Landschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tussenkomst in natuur en landschap</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вмешательство в природный ландшафт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участие в решении сложных проблем, касающихся природной среды и окружающих условий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التدخل في الطبيعة وفي المناظر الطبيعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13187" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7093" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9236" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13123">
    <skos:prefLabel xml:lang="en">photography</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of forming visible images directly or indirectly by the action of light or other forms of radiation on sensitive surfaces.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">photographie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fotografiar</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Photographie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fotografie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фотография</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс образования видимых образов в результате прямого или косвенного воздействия света или других форм излучения на чувствительные поверхности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التصوير الفوتوغرافي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/14165" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6200" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12656">
    <skos:prefLabel xml:lang="en">underground quarry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Quarry located below the surface of the earth.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">carrière souterraine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cantera subterránea</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unterirdischer Steinbruch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ondergrondse groeve</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">подземная каменоломня</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Шахта, расположенная под землей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">محجر تحت الأرض</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6867" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/35" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4466">
    <skos:prefLabel xml:lang="en">inventory</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A detailed list of articles, goods, property, etc.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">inventaire (environnement)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inventario</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Inventar</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inventaris</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">опись</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Детальный список предметов, товаров, имущества и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قائمة جرد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2803" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2672" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4468" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12151">
    <skos:prefLabel xml:lang="en">bathing freshwater</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Freshwater in which bathing is explicitly authorised or in which bathing is not prohibited and is traditionally practised by a large number of bathers. Water in such areas must meet specified quality standards relating to chemical, microbiological and physical parameters.
(Source: GILP96a)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau de baignade douce</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua dulce de baño</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Badegewässer (Süßwasser)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">zwemwater (zoet)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пресная вода, пригодная для купания</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Пресная вода, в которой открыто разрешено или не запрещено купаться и в которой традиционно купается большое количество людей. Вода в таких районах должна соответствовать определенным качественным стандартам по химическим, микробиологическим и физическим параметрам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ماء الاستحمام العذب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4468">
    <skos:prefLabel xml:lang="en">inventory of forest damage</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Survey of a forest area to determine forest depletion. The aim of the inventory is to give an overview of the forest conditions. Especially should the inventory aim to detect any changes in the forest conditions, but it should also provide the distribution of the forest damages and find out any relation with site and stand conditions.
(Source: DUNSTEa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">inventaire des dégâts forestiers</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inventario de daño forestal</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Waldschadensinventur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inventarisatie van bosschade</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инвентаризация ущерба, нанесенного лесам</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обследование лесного участка для того, чтобы определить размер сокращения лесных площадей. Целью такой инвентаризации является составление общей картины состояния леса. При том, что инвентаризация ориентирована на обнаружение каких-либо изменений в состоянии леса, она также должна дать картину ущерба, нанесенного лесным площадям и установить возможные причины этого.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قائمة بأضرار الغابات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4466" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3439" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4473">
    <skos:prefLabel xml:lang="en">inversion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A reversal in the usual direction of a process, as in the change of density of water at 4° C.
(Source: PITT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">inversion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inversión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Inversion</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inversie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инверсия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Движение, обратное нормальному ходу процесса, как, например, изменение плотности воды при 4 градусах С.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انقلاب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/627" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4474" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4474">
    <skos:prefLabel xml:lang="en">inversion layer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The atmosphere layer through which an inversion occurs.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">couche d'inversion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">capa de inversión</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Inversionsschicht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">omkeringslaag</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инверсионный слой</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Слой атмосферы, в котором происходит инверсия.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طبقة الانقلاب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/627" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4473" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4475">
    <skos:prefLabel xml:lang="en">invertebrate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any animal lacking a backbone, including all species not classified as vertebrates.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">invertébré</skos:prefLabel>
    <skos:prefLabel xml:lang="es">invertebrados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Invertebraten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ongewervelde dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">беспозвоночное</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любое животное, лишенное позвоночника, включая также все виды, не классифицированные как позвоночные.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اللافقاريات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/450" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/572" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1548" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2428" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5339" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5565" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6759" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8006" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4478">
    <skos:prefLabel xml:lang="en">investment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any item of value purchased for profitable return, as income, interest or capital appreciation.
(Source: IVW / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">investissement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">inversiones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Investition</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">investering</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">инвестиция</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Использование денег для приобретения какого-либо имущества, от которого ожидается какой-то доход или процент и которое приобретается с целью удержания в собственности ради дохода, который оно должно дать.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استثمار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3194" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4480">
    <skos:prefLabel xml:lang="en">in vitro assay</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Assay taking place in an artificial environment.
(Source: KOREN)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">test in vitro</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis in vitro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">in vitro-Test</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">in vitro proef</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">испытание в искусственной среде</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Исследование, проводимое в искусственной среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار معملي - اختبار في الأنابيب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4574" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4481">
    <skos:prefLabel xml:lang="en">in vivo assay</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Experiments that are carried out in the living organism.
(Source: UVAROV)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">test in vivo</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis in vivo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">in vivo-Test</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">in vivo proef</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">испытание на живом организме</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Эксперименты, проводимые на живом организме.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اختبار في مادة حية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4574" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4483">
    <skos:prefLabel xml:lang="en">iodine</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A nonmetallic halogen element; the poisonous, corrosive dark plates or granules are readily sublimed; insoluble in water, soluble in common solvents; used as germicide and antiseptic, in dyes, tinctures, and pharmaceuticals, in engraving lithography, and as a catalyst and analytical reagent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">iode</skos:prefLabel>
    <skos:prefLabel xml:lang="es">yodo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Jod</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">jodium</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">йод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Неметаллический галоген; ядовитые, коррозионные темные пластины или гранулы легко сублимируются; нерастворим в воде, растворим в известных растворителях; используется для уничтожения микробов и в качестве антисептика, в красках, в фармацевтике, при гравировании, в качестве катализатора и аналитического реагента.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اليود</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2642" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12676">
    <skos:prefLabel xml:lang="en">bush clearing</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The removal of brush using mechanical means, either by cutting manually or by using machinery for crushing, rolling, flailing, or chipping it, or by chemical means or a combination of these.
(Source: DUNSTE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">débroussaillement</skos:prefLabel>
    <skos:prefLabel xml:lang="es">eliminación de matorrales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Buschlichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">het kappen van kreupelhout</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вырубка кустарников</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Удаление кустарников либо путем ручного срезания, либо с применением специальных машин по вырубке, срезке, волочению, а также с применением химических средств или с комбинацией всех указанных методов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اقتلاع دَغل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/8575" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4485">
    <skos:prefLabel xml:lang="en">ion exchange</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process in which ions are exchanged between a solution and an insoluble solid, usually a resin.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">échange d'ions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intercambio iónico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ionenaustausch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ionen(uit)wisseling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ионный обмен</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого происходит обмен ионами между раствором и нерастворимым твердым телом, обычно смолой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تبادل الأيونات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6233" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4487" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7839" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4487">
    <skos:prefLabel xml:lang="en">ion exchanger</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A permanent insoluble material (usually a synthetic resin) which contains ions that will exchange reversibly with other ions in a surrounding solution. Both cation and anion exchangers are used in water conditioning. The volume of an ion exchanger is measured in cubic liters of exchanger after the exchanger bed has been backwashed and drained, and has settled into place.
(Source: WQA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">échangeur d'ions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">intercambiador iónico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ionenaustauscher</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ionen(uit)wisselaar</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ионообменник</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постоянный нерастворимый материал (обычно синтетическая смола), содержащая ионы, которые будут обмениваться с другими ионами в окружающем растворе. При обработке используются как анионовые, так и катионовые ионообменники. Объем ионообменника измеряется в кубических литрах обменного объема после того, как обменный слой был промыт, высушен и расположен на прежнем месте.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مبادل الأيونات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4485" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4491">
    <skos:prefLabel xml:lang="en">ionising radiation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Radiation that is capable of energizing atoms sufficiently to remove electrons from them. In this state atoms become more reactive, so that ionizing radiation increases chemical activity and in this way produces biological effects, including effects that involve alterations induced in DNA. X-rays and gamma-rays are the only electromagnetic waves that cause ionization in biological material.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">rayonnement ionisant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">radiación ionizante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ionisierende Strahlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ioniserende straling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ионизирующее излучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Излучение, способное возбудить атомы до степени, достаточной для того, чтобы сорвать электроны со своих орбит. В таком состоянии атомы становятся очень реактивными, поэтому ионизирующее излучение увеличивает степень химической активности и таким образом производит биологический эффект, включая изменение в составе ДНК. Рентгеновские и гамма-лучи являются единственными видами электромагнитных волн, способных ионизировать биологический материал.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أشعة مؤينة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/342" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/782" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3554" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8742" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9398" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5741" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4492">
    <skos:prefLabel xml:lang="en">ionosphere</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A region of the earth's atmosphere, extending from about 60 to 1000 kilometers above the earth's surface, in which there is a high concentration of free electrons formed as a result of ionizing radiation entering the atmosphere from space.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ionosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ionosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ionosphäre</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ionosfeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ионосфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок земной атмосферы, расположенный на высоте от 60 до 1000 км над поверхностью Земли, в которой содержится высокая концентрация свободных электронов, образованных в результате ионизирующего излучения, проникшего в атмосферу из космоса.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الغلاف الأيوني</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/641" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/3" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4493">
    <skos:prefLabel xml:lang="en">ion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An electrically charged atom or group of atoms formed by the loss or gain of one or more electrons.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ion</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ion</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ionen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ionen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ион</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Атом или группа атомов, обладающие электронным зарядом в результате потери или приобретения одного и более электронов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">أيون</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/454" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1224" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12687">
    <skos:prefLabel xml:lang="en">flood protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Precautionary measures, equipment or structures implemented to guard or defend people, property and lands from an unusual accumulation of water above the ground.
(Source: ALL / WWC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection contre les crues</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección contra inundaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hochwasserschutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bescherming tegen overstroming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">защита от наводнений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Профилактические действия, меры и установки, реализованные для защиты людей, имущества или земель от необычного скопления воды на поверхности почвы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الحماية من مخاطر الفيضان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11662" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/12263" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/32" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7243" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12152">
    <skos:prefLabel xml:lang="en">demesnial water</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A body of water that is owned and maintained by a national governmental body or agency.
(Source: OED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">eau domaniale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agua demesnial</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Privatgewässer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">waterbezit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">водоем, находящийся в собственности государства</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Водоем, принадлежащий и поддерживаемый национальным государственным органом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مياه الدولة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/963" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/1" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4498">
    <skos:prefLabel xml:lang="en">iron</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A malleable ductile silvery-white ferromagnetic metallic element occurring principally in haematite and magnetite. It is widely used for structural and engineering purposes.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">fer</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hierro</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijzer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">железо</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Ковкий, серебристо-белый ферромагнитный металлический элемент, встречающийся в составе гематита и магнетита. Широко используется в строительстве и машиностроении.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حديد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3915" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4501">
    <skos:prefLabel xml:lang="en">iron industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of commercial enterprises is engaged in the extraction and refinement of iron ore to produce cast iron, wrought iron and steel.
(Source: RHW / ENC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie sidérurgique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria metalúrgica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijzerindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">черная металлургия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отрасль промышленности, предприятия которой осуществляют добычу и переработку железной руды, производство чугуна и стали.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة الحديد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13098" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4503">
    <skos:prefLabel xml:lang="en">ironwork industry</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Industry for the production of iron articles.
(Source: WEBSTEa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">industrie sidérurgique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">industria siderúrgica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eisenhüttenindustrie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijzergieterij(sector)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">производство чугуна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Предприятия, производящие чугун.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">صناعة المنتجات الحديدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5181" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4504">
    <skos:prefLabel xml:lang="en">irradiation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">To subject to or treat with light or other electromagnetic radiation or with beams of particles.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">irradiation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">irradiación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bestrahlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bestraling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">облучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Воздействие света, электромагнитного излучения или потоков частиц.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التشعيع - الإشعاع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12606" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4505">
    <skos:prefLabel xml:lang="en">irrigation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) To supply land with water so that crops and plants will grow or grow stronger.
(Source: CAMB /  WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">irrigation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">riego</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewässerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevloeiing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ирригация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Снабжение земель водой для обеспечения роста и развития растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/210" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8675" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9160" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6007">
    <skos:prefLabel xml:lang="en">paint</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mixture of pigment and a vehicle, such as oil or water, that together form a liquid or paste that can be applied to a surface to provide an adherent coating that imparts colour to and often protects the surface.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">peinture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pinturas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anstrichmittel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">краска</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Смесь пигмента и растворителя, как, например, вода или масло, образующая жидкую или пастообразную массу, которую можно накладывать на поверхность. Образовавшееся покрытие придает цвет поверхности, а также часто выполняет защитные функции.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دهان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8899" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4507">
    <skos:prefLabel xml:lang="en">irrigation canal</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A permanent irrigation conduit constructed to convey water from the source of supply to one or more farms.
(Source: NALMS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">canal d'irrigation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">canal de riego</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewässerungskanal</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevloeiingskanaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ирригационный канал</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постоянно действующее ирригационное сооружение для передачи воды от ее источника к потребляющим (одному или нескольким) сельскохозяйственным предприятиям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قناة ري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1126" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4509">
    <skos:prefLabel xml:lang="en">irrigation farming</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Farming based on the artificial distribution and application of water to arable land to initiate and maintain plant growth.
(Source: GOODa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">culture irriguée</skos:prefLabel>
    <skos:prefLabel xml:lang="es">agricultura de riego</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bewässerungslandbau</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevloeiingslandbouw</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ирригационное земледелие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Сельскохозяйственная деятельность, основанная на искусственном распределении и применении воды на пахотных землях для обеспечения роста и развития растений.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الزراعة بالري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11170" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9176" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11232" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/234" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13287">
    <skos:prefLabel xml:lang="en">legal profession</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A body of persons whose occupation is concerned with advising clients in matters of law, representing them in court or assisting them through the judicial process, including, in the first instance, lawyers and, by extension, judges, legal assistants and court employees.
(Source: OCT / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">profession judiciaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">profesión jurídica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organ der Rechtspflege</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">juridische stand</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">юрист как профессия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Лица, чьей профессией является консультирование граждан по вопросам права, представления их интересов в суде или оказания им помощи в ходе судебного процесса, включая адвокатов, судей, юрисконсультов и сотрудников суда.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مهنة قضائية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13146" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4514">
    <skos:prefLabel xml:lang="en">island</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A land mass, especially one smaller than a continent, entirely surrounded by water.
(Source: AMHER)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">île</skos:prefLabel>
    <skos:prefLabel xml:lang="es">islas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Insel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eiland</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">остров</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Участок суши, особенно меньших размеров, чем континент, полностью окруженный водой.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جزيرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5494" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/531" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4515">
    <skos:prefLabel xml:lang="en">island ecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Unique but fragile and vulnerable ecosystems due to the fact that the evolution of their flora and fauna has taken place in relative isolation. Many remote islands have some of the most unique flora in the world; some have species of plants and animals that are not found anywhere else, which have evolved in a specialized way, sheltered from the fierce competition that species face on mainland.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écosystème insulaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ecosistemas insulares</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Inselökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">eilandecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">островная экосистема</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Уникальная экосистема, исключительно хрупкая в силу того, что эволюция ее флоры и фауны произошла в относительной изоляции. Некоторые удаленные острова располагают самыми уникальными видами флоры в мире; на некоторых островах существуют виды растений и животных, которые нельзя найти больше нигде и которые развились особым образом благодаря отсутствию жесткой видовой конкуренции, характерной для континентальных экосистем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي للجزر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/423">
    <skos:prefLabel xml:lang="en">animal foodstuff</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any crops or other food substances for animal consumption.
(Source: MGHa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">aliment pour animaux</skos:prefLabel>
    <skos:prefLabel xml:lang="es">alimento para animales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierfutter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">dierenvoeder</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">корм для животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любые кормовые культуры или другие продукты питания, потребляемые животными.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة غذائية حيوانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3345" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3151" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/13" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/18" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4518">
    <skos:prefLabel xml:lang="en">insulation (process)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of preventing or reducing the transmission of electricity, heat, or sound to or from a body, device, or region by surrounding it with a nonconducting material.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">isolation (procédé)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aislamiento (proceso)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Isolierung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">isolatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изоляция (процесс)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс предохранения или снижения передачи электричества, тепла, звука от или по направлению к объекту, прибору, региону в результате окружения его непроводящим материалом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عزل (عملية)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12606" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/55" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8440" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4519">
    <skos:prefLabel xml:lang="en">isomer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">1) Two or more compounds having the same molecular formula, but a different arrangement of atoms within the molecule.
2) One of two or more chemical substances having the same elementary percentage composition and molecular weight but differing in structure, and therefore in properties; there are many ways in which such structural differences occur.
(Source: CED /  MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">isomère</skos:prefLabel>
    <skos:prefLabel xml:lang="es">isómero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Isomer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">isomeer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изомер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">1) Два и более соединений, обладающих одинаковой молекулярной формулой, однако различающихся расположением атомов в молекулах. 2) Два или более химических веществ, у которых одинаковый процентный состав элементов и молекулярная масса, однако различаются структуры и, таким образом, свойства; эти структурные различия могут проявляться разными способами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الأيسومرات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4523">
    <skos:prefLabel xml:lang="en">isotope</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One or two or more atoms with the same atomic number that contain different numbers of neutrons.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">isotope</skos:prefLabel>
    <skos:prefLabel xml:lang="es">isótopo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Isotop</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">isotoop</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">изотоп</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Один, два и более атомов с одинаковым атомным числом, однако содержащие разное количество нейтронов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظير</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6928" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4524">
    <skos:prefLabel xml:lang="en">ivory</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The fine-grained creamy-white dentine forming the tusks of elephants, and the teeth or tusks of certain other large animals such as the walrus; it has long been esteemed for a wide variety of ornamental articles.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">ivoire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">marfil</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Elfenbein</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ivoor</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">слоновая кость</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Мелкозернистый, кремово-белый дентин, образующий бивни слонов, а также зубы и клыки других животных, например, моржей; длительное время пользуется большим спросом, благодаря своим декоративным свойствам.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العاج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/442" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12717">
    <skos:prefLabel xml:lang="en">soil stability</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Soil stability depends on its shear strength, its compressibility and its tendency to absorb water. Stabilization methods include physical compaction and treatment with cement, lime, and bitumen.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">stabilité du sol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">estabilidad de suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bodenstabilität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bodemstabiliteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">стабильность почвы</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Стабильность почвы зависит от ее твердости, способности к сжатию и водопоглотительных свойств. Методы стабилизации включают физическую утрамбовку, обработку цементом, известняком, битумом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ثبات التربة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7848" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7894" />
