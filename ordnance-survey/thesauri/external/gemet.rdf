  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5737">
    <skos:prefLabel xml:lang="en">nuclear power plant disposal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">démantèlement de centrale nucléaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disposición de central nuclear</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kernkraftwerksentsorgung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">opbergen kernafval</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">утилизация отходов атомной электростанции</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">تفكيك محطة طاقة نووية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
