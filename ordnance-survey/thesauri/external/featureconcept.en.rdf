    <skos:inScheme rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <skos:topConceptOf rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:42 PM CEST</dct:created>
    <dct:title xml:lang="en">Zoning Element</dct:title>
    <skos:prefLabel xml:lang="en">Zoning Element</skos:prefLabel>
    <dct:description xml:lang="en">A spatial object which is homogeneous regarding the permitted uses of land based on zoning which separate one set of land uses from another.</dct:description>
    <skos:definition xml:lang="en">A spatial object which is homogeneous regarding the permitted uses of land based on zoning which separate one set of land uses from another.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/lu" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
