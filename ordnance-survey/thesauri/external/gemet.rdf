    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4049" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5459" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6063" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6358" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7765" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8379" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8549" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11852" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/3875" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13156">
    <skos:prefLabel xml:lang="en">social protection</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The monies and programs a society enacts through either public or private entities to provide economic security and general welfare for its members, often on account of old age, unemployment, health, disability or death of a spouse, parent or other benefactor.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protection sociale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">protección social</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sozialer Schutz</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sociale bescherming</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">социальная защита</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Средства и программы, реализуемые обществом через государственные или частные структуры для обеспечения экономической стабильности и общего благосостояния его членов в связи с престарелым возрастом, безработицей, состоянием здоровья, увечьем или смертью супруга, родителя или другого благотворителя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حماية اجتماعية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7823" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1740" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5210">
    <skos:prefLabel xml:lang="en">metropolis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A term applied loosely to any large city, but specifically to that city in a country which is the seat of government, of ecclesiastical authority, or of commercial activity.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">métropole</skos:prefLabel>
    <skos:prefLabel xml:lang="es">metrópolis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Metropole</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wereldstad</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">метрополия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин, применяемый в отношении любого крупного города, особенно в отношении города, где расположено правительство страны, верховное духовенство, или города, являющегося центром деловой активности.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المتروبول - مدينة كبرى</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8797" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5629">
    <skos:prefLabel xml:lang="en">noise analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Determination of the frequency components that make up a particular noise being studied.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse de bruit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis de ruido</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geräuschanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">geluidsanalyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">анализ шума</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Установление частоты колебаний компонентов, производящих конкретный вид изучаемого шума.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل الضوضاء</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/397" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5646" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11909" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/24" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4965">
    <skos:prefLabel xml:lang="en">magnetism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A class of physical phenomena associated with moving electricity, including the mutual mechanical forces among magnets and electric currents.
(Source: BJGEO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">magnétisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">magnetismo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Magnetismus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">magnetisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">магнетизм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Класс физических явлений, связанных с движением электричества, включая общие механические силы магнитов и электрических токов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المغناطيسية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6229" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5216">
    <skos:prefLabel xml:lang="en">microbiological analysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Analysis for the identification of viruses, bacteria, fungi and parasites.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">analyse microbiologique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">análisis microbiológico</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Microbiologische Analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microbiologische analyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микробиологический анализ</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Анализ с целью установления вирусов, бактерий, грибов или паразитов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحليل ميكروبيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/841" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11792">
    <skos:prefLabel xml:lang="en">non-volatile substance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Substance that is not capable of changing from a solid or liquid form to a vapour.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">substance non volatile</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sustancia permanente</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Nicht flüchtiger Stoff</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">niet-vluchtige stof</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">нелетучее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вещество, неспособное перейти из твердого или жидкого состояния в газообразное.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة غير متطايرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1327" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8995" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5218">
    <skos:prefLabel xml:lang="en">microbiology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The science and study of microorganisms, including protozoans, algae, fungi, bacteria, viruses, and rickettsiae.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microbiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microbiología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikrobiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microbiologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микробиология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Система знаний и изучение микроорганизмов, включая простейшие, водоросли, бактерии, вирусы и риккетсию.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم الميكروبيولوجي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/881" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5219">
    <skos:prefLabel xml:lang="en">microclimate</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The local, rather uniform climate of a specific place or habitat, compared with the climate of the entire area of which it is a part.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microclimat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microclima</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikroklima</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microklimaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроклимат</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Местный климат в конкретном районе или среде обитания в сравнении с климатом всего региона, частью которого он является.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المناخ الخاص - المناخ المحلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1462" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/618" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5220">
    <skos:prefLabel xml:lang="en">microclimate effect</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">effet de microclimat</skos:prefLabel>
    <skos:prefLabel xml:lang="es">efecto microclimático</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikroklimatische Wirkung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">effect op het microklimaat</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроклиматический эффект</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">أثر المناخ الخاص (المحلي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1464" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10114" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5221">
    <skos:prefLabel xml:lang="en">microclimatology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of a microclimate, including the study of profiles of temperature, moisture and wind in the lowest stratum of air, the effects of the vegetation and of shelterbelts, and the modifying effects of towns and buildings.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microclimatologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microclimatología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikroklimatologie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microklimatologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроклиматология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение микроклимата, включая температуру, влажность и ветер в нижних слоях, влияние растительности и зеленой зоны, воздействие городов и зданий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">علم المناخ الخاص</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1479" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5222">
    <skos:prefLabel xml:lang="en">microcomputer</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A microprocessor combined with input/output interface devices, some type of external memory, and the other elements required to form a working computer system; it is smaller, lower in cost, and usually slower than a minicomputer.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">micro-ordinateur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microordenador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikrocomputer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microcomputer</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микрокомпьютер</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Микропроцессор, соединенный с вводным/выводным устройством, с определенным типом памяти и другими элементами, необходимыми для работы компьютерной системы; отличается меньшими размерами, более низкими стоимостью и скоростью работы, чем мини-компьютер.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المايكرو كمبيوتر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2633" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/20" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4281" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5224">
    <skos:prefLabel xml:lang="en">microecosystem</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A small-scale, simplified, experimental ecosystem, laboratory- or field- based, which may be: a) derived directly from nature (e.g. when samples of pond water are maintained subsequently by the input of artificial light and gas-exchange); or b) built up from axenic cultures (a culture of an organism that consists of one type of organism only, i.e. that is free from any contaminating organism) until the required conditions of organisms and environment are achieved. Also known as microcosm.
(Source: ALL2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microécosystème</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microecosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Modellökosystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">micro-ecosysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроэкосистема</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Небольшая, упрощенная, экспериментальная экосистема, созданная в лабораторных или полевых условиях, которая может быть: a) получена непосредственно из естественных условий (например, образцы воды, взятые из пруда, могут в дальнейшем поддерживаться при искусственном свете и газообмене; b) создана на базе аксенических культур (организмов, состоящих только из одного типа, т.е. свободных от каких-либо загрязняющих организмов) с последующим развитием до достижения необходимого уровня в состоянии организмов и условий среды. Также используется термин микрокосм.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">النظام الإيكولوجي الخاص (المحلي)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8388" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5225">
    <skos:prefLabel xml:lang="en">microelectronics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The technology of constructing circuits and devices in extremely small packages by various techniques. Also known as microminiaturization; microsystem electronics.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microélectronique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microelectrónica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikroelektronik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">micro-elektronica</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроэлектроника</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Технология создания микропроцессоров и приборов исключительно маленьких размеров. Также используются термины микроминиатюризация; электроника микросистем.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإلكترونيات متناهية الصغر - الميكرو إلكترونيات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2624" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5226">
    <skos:prefLabel xml:lang="en">microfiltration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The separation or removal from a liquid of particulates and microorganisms in the size range of 0.1 to 0.2 microns in diameter.
(Source: WQA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microfiltration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microfiltración</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikrofiltration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microfiltratie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микрофильтрация</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Отделение или удаление из жидкости частиц и микроорганизмов, диаметром в пределах от 0,1 до 0,2 микрон.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الترشيح الدقيق</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3190" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13159">
    <skos:prefLabel xml:lang="en">business organisation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A particular legal arrangement for owning a firm, the principal forms are sale trades, partnerships and companies/corporations; 
collective term for the system, function, process of planning, providing, coordinating, directing all efforts and resources in a business in order to achieve its goals.</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">organisation de l'entreprise</skos:prefLabel>
    <skos:prefLabel xml:lang="es">organización de la empresa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Unternehmensorganisation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bedrijfsorganisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">организация бизнеса</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Специальный юридический документ, определяющий организационно-правовую форму коммерческой структуры; основными формами являются индивидуальные торговцы, товарищества и компании/корпорации; коллективный термин, применяемый в отношении системы, функций, процесса планирования, обеспечения, координации, направления всех усилий и ресурсов коммерческого предприятия в целях достижения его целей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تنظيم الأعمال</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1084" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8100" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13258" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13259" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/13193" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5228">
    <skos:prefLabel xml:lang="en">micro-organism</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A microscopic organism, including bacteria, protozoans, yeast, viruses, and algae.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">micro-organisme</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microorganismos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikroorganismen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">micro-organisme</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроорганизм</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Микроскопический организм, включая бактерии, простейшие, дрожжи, вирусы и водоросли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كائنات عضوية مجهرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5914" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/510" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/698" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/301" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5229">
    <skos:prefLabel xml:lang="en">micropollutant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pollutant which exists in very small traces in water.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">micropolluant</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microcontaminante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Spurenstoffverunreinigung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microverontreiniging</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микрозагрязняющее вещество</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Загрязняющее вещество, которое присутствует в воде в слабых следовых количествах.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ملوثات مجهرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/26" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/9117" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5230">
    <skos:prefLabel xml:lang="en">microscopy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The interpretative application of microscope magnification to the study of materials that cannot be properly seen by the unaided eye.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">microscopie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microscopía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikroskopie</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microscopie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроскопия</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Применение микроскопического увеличения для изучения материалов, которые не видны невооруженным глазом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراسة ميكروسكوبية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5203" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5231">
    <skos:prefLabel xml:lang="en">microwave</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An electromagnetic wave which has a wavelength between about 0.3 and 30 centimeters, corresponding to frequencies of 1-100 gigahertz; however there are no sharp boundaries between microwaves and infrared and radio waves.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">onde à hyperfréquences</skos:prefLabel>
    <skos:prefLabel xml:lang="es">microondas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Mikrowellen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">microgolf</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">микроволна</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Электромагнитная волна с длиной от 0,3 до 30 см и соответствующей частотой от 1 до 100 гигагерц; тем не менее не существует четких границ между микроволнами, инфракрасными и радиоволнами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">موجات صغرى - مايكروويف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5674" />
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6884" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/28" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/6237" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5234">
    <skos:prefLabel xml:lang="en">migrant labour</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Temporary employment performed by persons who move from place to place, such as agricultural workers following crop seasons.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">migration des travailleurs</skos:prefLabel>
    <skos:prefLabel xml:lang="es">trabajo emigrante</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wanderarbeitskräfte</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gastarbeid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мигрирующая рабочая сила</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Временная работа, выполняемая рабочими, которые перемещаются из одного места в другое, например, сельскохозяйственные рабочие.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العمالة المهاجرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4581" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5236">
    <skos:prefLabel xml:lang="en">human migration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The permanent or semipermanent change of a person's place of residence.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">migration humaine</skos:prefLabel>
    <skos:prefLabel xml:lang="es">migraciones humanas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bevölkerungsmigration</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">volksverhuizing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">миграция людей</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Постоянное или временное изменение места жительства лица.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهجرة البشرية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6525" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7531" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13325" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5237">
    <skos:prefLabel xml:lang="en">animal migration</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Movements that particular animals carry out regularly often between breeding places and winter feeding grounds.
(Source: ALL)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">migration animale</skos:prefLabel>
    <skos:prefLabel xml:lang="es">migración (animal)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tierwanderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">trek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">миграция животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Регулярное перемещение отдельных видов животных, которое часто происходит между местами зимовки и местами выведения детенышей.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الهجرة الحيوانية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/767" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5238" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10305" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5238">
    <skos:prefLabel xml:lang="en">migratory bird</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Birds which migrate in a body.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">oiseau migrateur</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aves migratorias</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zugvogel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">trekvogel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">мигрирующая птица</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Птицы, которые мигрируют.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طير مهاجر</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/912" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5237" />
