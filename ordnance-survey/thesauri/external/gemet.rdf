  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1316">
    <skos:prefLabel xml:lang="en">chemical plant</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Plants where basic raw materials are chemically converted into a variety of products.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">usine chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">planta química</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Chemiewerk</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">chemische fabriek</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">химический завод</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Заводы, где основные сырьевые материалы в результате химических процессов перерабатываются в широкую гамму готовых изделий.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصنع كيماوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1310" />
