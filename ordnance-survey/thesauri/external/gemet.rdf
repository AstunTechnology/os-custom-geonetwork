  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8006">
    <skos:prefLabel xml:lang="en">poriferan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The sponges, a phylum of the animal kingdom characterized by the presence of canal systems and chambers through which water is drawn in and released; tissues and organs are absent.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">éponge</skos:prefLabel>
    <skos:prefLabel xml:lang="es">esponjas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schwämme</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sponzen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">губки</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тип животных, представители которого характеризуются наличием системы протоков и полостей, через которые всасывается и выпускается вода; ткани и органы отсутствуют.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الإسفنج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4475" />
