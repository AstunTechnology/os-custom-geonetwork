    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8008">
    <skos:prefLabel xml:lang="en">sport</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The complex of individual or group activities pursued for exercise or pleasure, often taking a competitive form.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sport</skos:prefLabel>
    <skos:prefLabel xml:lang="es">deportes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sport</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">спорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Комплекс индивидуальных или групповых занятий, осуществляемый для физической подготовки или развлечения, часто в форме соревнований.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رياضة بدنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7001" />
