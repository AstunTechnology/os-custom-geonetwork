    <dct:title xml:lang="en">Air Route</dct:title>
    <skos:prefLabel xml:lang="en">Air Route</skos:prefLabel>
    <dct:description xml:lang="en">A specified route designed for channelling the flow of traffic as necessary for the provision of air traffic services, from the end of the take-off and initial climb phase to the commencement of the approach and landing phase.</dct:description>
    <skos:definition xml:lang="en">A specified route designed for channelling the flow of traffic as necessary for the provision of air traffic services, from the end of the take-off and initial climb phase to the commencement of the approach and landing phase.</skos:definition>
