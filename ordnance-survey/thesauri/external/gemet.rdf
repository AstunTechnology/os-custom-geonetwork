    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5935">
    <skos:prefLabel xml:lang="en">organosilicon compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any natural substance composed of two or more unlike atoms held together by chemical bonds and containing silicon, a non-metallic element often found in rocks or minerals.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organosilicié</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuesto organosilicio</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Silikonverbindung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische silicoonverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кремнийорганическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Природное вещество, состоящее из двух и более разных, химически связанных атомов, а также кремния; неметаллический элемент, часто встречается в составе минералов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب سيليكون عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5927" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5936">
    <skos:prefLabel xml:lang="en">organosulphur compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">One of a group of substances which contain both carbon and sulfur.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organosulfuré</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos organosulfurados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Schwefelverbindung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische zwavelverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">сероорганическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Группа веществ, в состав которых входит углерод и сера.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب كبريتي عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5912" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/6" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1349" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5937">
    <skos:prefLabel xml:lang="en">organotin compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Chemical compounds used in anti-foulant paints to protect the hulls of boats and ships, buoys and pilings from marine organisms such as barnacles.
(Source: EPAGLO)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organostannique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos organoestánnicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Zinnverbindung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische tinverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оловоорганическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Химические соединения, используемые в составе специальных красок и покрытий, наносимых на корпуса катеров, судов, плавающих знаков для предотвращения их обрастания ракушками и водорослями.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب قصدير عضوي</skos:prefLabel>
