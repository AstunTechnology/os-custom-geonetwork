    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12898">
    <skos:prefLabel xml:lang="en">damage assessment</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The evaluation or determination of losses, harm and injuries to persons, property or the environment.
(Source: TOE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">évaluation des dommages</skos:prefLabel>
    <skos:prefLabel xml:lang="es">evaluación de daños</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schadensbewertung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">raming van de schade</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">оценка ущерба</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Оценка или определение ущерба, урона, повреждений, нанесенных физическим лицам, имуществу или окружающей среде.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تقييم الأضرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7362" />
