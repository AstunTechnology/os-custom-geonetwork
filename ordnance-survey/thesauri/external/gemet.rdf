  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5929">
    <skos:prefLabel xml:lang="en">organooxygen compound</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Compounds, both aliphatic and aromatic, which have a C-O bond, including alcohols, aldehydes, etc.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">composé organique oxygéné</skos:prefLabel>
    <skos:prefLabel xml:lang="es">compuestos organo-oxigenados</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Organische Sauerstoffverbindungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">organische zuurstofverbinding</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кислородсодержащее органическое соединение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Алифатические и ароматические соединения, имеющие связь С-О, включая спирты, альдегиды и т.д.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مركب أوكسجيني عضوي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5912" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/298" />
