    <skos:prefLabel xml:lang="es">parque de atracciones</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freizeitpark</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pretpark</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">парк развлечений</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Площадка на открытом воздухе для развлечений и отдыха, занятая киосками, аттракционами и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">حديقة ترفيهية</skos:prefLabel>
