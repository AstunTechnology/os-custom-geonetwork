    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13552">
    <skos:prefLabel xml:lang="en">bank (land)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The sloping side of any hollow in the ground, especially when bordering a river.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">berge</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ribera</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Ufer</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bank</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">берег</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Край земли около воды.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">شاطئ (أرض)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4629" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/16" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7586">
    <skos:prefLabel xml:lang="en">selective breeding of animals</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Breeding of animals having desirable characters.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">élevage de races animalières sélectionnées</skos:prefLabel>
    <skos:prefLabel xml:lang="es">cría selectiva de animales</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Selektive Tierzucht</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">selectief fokken van dieren</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">селекция животных</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разведение животных, обладающих требуемыми качествами.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">التربية الانتقائية للحيوانات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11198" />
