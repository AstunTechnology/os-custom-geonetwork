    <skos:prefLabel xml:lang="ru">бытовой прибор</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Механизм или устройство, особенно с электроприводом, используемое в быту.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جهاز منزلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2956" />
