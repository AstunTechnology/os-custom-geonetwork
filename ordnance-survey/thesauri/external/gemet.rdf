    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10906">
    <skos:prefLabel xml:lang="en">seaside footpath</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A route or track running along the coast.

(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sentier littoral</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sendero de playa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Küstenwanderung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">voetpad langs de kust</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пешеходная тропа вдоль побережья</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Путь вдоль побережья.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ممشى ساحلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10905" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10907">
    <skos:prefLabel xml:lang="en">educational path</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A guided trail, designed to explain to children a piece of countryside, the type of soil, flora, fauna, etc. Such trails may be self-guiding, using either explanatory notices set up at intervals or numbered boards referring to a printed leaflet: in other cases parties may be led by a demonstrator or warden.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">sentier pédagogique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">senda educativa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bildungsweg</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">gevolgd onderwijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">учебная тропа</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тропа, предназначенная для прогулок школьников с целью изучения конкретной сельской местности, отдельных типов почвы, флоры, фауны и пр. По таким тропам можно гулять самостоятельно, получая информацию из расположенных вдоль них информационных щитов, либо в сопровождении экскурсовода или хранителя.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">المسار التعليمي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10905" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/37" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2716">
    <skos:prefLabel xml:lang="en">energy conversion</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The process of changing energy from one form to another.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">conversion de l'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">conversión energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieumwandlung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energieomzetting</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">преобразование энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс перевода энергии из одной формы в другую.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تحويل الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2734" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/25" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10909">
    <skos:prefLabel xml:lang="en">seaside resort</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place near the sea where people spend their holidays and enjoy themselves.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station balnéaire</skos:prefLabel>
    <skos:prefLabel xml:lang="es">centro turístico de playa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Badeort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">badplaats (aan zee)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">морской курорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место возле моря, где люди проводят свой отпуск и отдыхают.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتجع شاطئي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10910">
    <skos:prefLabel xml:lang="en">mountain resort</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A place in the mountains where people spend their holidays and enjoy themselves.
(Source: CAMB)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station de montagne</skos:prefLabel>
    <skos:prefLabel xml:lang="es">centro turístico de montaña</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gebirgsort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">vakantieoord in de bergen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">горный курорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Место в горах, где люди проводят свой отпуск и отдыхают.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتجع جبلي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10911">
    <skos:prefLabel xml:lang="en">winter sports resort</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Resort where sports held in the open air on snow or ice, especially skiing are practiced.
(Source: CEDa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">station de sports d'hiver</skos:prefLabel>
    <skos:prefLabel xml:lang="es">centro turístico de deportes de invierno</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wintersportort</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">wintersportoord</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лыжный курорт</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Курорт, где на открытом воздухе люди занимаются зимними видами спорта, особенно лыжным спортом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منتجع رياضات شتوية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8525" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/29" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/38" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2720">
    <skos:prefLabel xml:lang="en">energy dissipation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any loss of energy, generally by conversion into heat.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">dissipation d'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">disipación energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energievernichtung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energieverpilling</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">потеря энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая потеря  энергии, обычно в процессе превращения в тепло.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">تبدد الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2722">
    <skos:prefLabel xml:lang="en">energy distribution system</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any publicly or privately organized setup in which usable power such as electricity is delivered to homes and businesses.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">système de distribution énergétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">sistema de distribución energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieverteilungssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">systeem voor de verdeling van energie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">система распределения энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Любая государственная или частная организованная структура, которая поставляет энергию в приемлемой форме, например, в виде электричества, в жилые дома и производственные помещения.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">نظام توزيع الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4321" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2599" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6561" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/5" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2723">
    <skos:prefLabel xml:lang="en">energy economics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The production, distribution, and consumption of usable power such as fossil fuel, electricity, or solar radiation.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">économie de l'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">economía energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energiewirtschaft</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spaarzaam energieverbruik</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергетика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Производство, распределение и потребление используемой энергии в таком виде, как минеральное топливо, электричество или солнечный свет.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">اقتصاد الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2516" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2724">
    <skos:prefLabel xml:lang="en">energy efficiency</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Refers to actions to save fuels by better building design, the modification of production processes, better selection of road vehicles and transport policies, the adoption of district heating schemes in conjunction with electrical power generation, and the use of domestic insulation and double glazing in homes.
(Source: WRIGHT)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">efficacité énergétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">rendimiento energético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieausnutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energierendement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">эффективность использования энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Относится к мерам, направленным на экономию топлива в результате улучшения строительных технологий, модификации производственных процессов, улучшенной транспортной политики, принятия местных планов подачи тепла одновременно с производством электрической энергии, использования термоизоляции и двойного остекления в быту.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">فعلية الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10918">
    <skos:prefLabel xml:lang="en">population density</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The number of people relative to the space occupied by them.
(Source: GOOD)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">densité de population</skos:prefLabel>
    <skos:prefLabel xml:lang="es">densidad de población</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Bevölkerungsdichte</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">bevolkingsdichtheid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">плотность населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество людей по отношению к площади, на которой они расселены.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">كثافة السكان</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4056" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10919">
    <skos:prefLabel xml:lang="en">young</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">jeune</skos:prefLabel>
    <skos:prefLabel xml:lang="es">joven</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Junge(s)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">jong</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">молодежь</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">شاب</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6527" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/17" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1820">
    <skos:prefLabel xml:lang="en">cost increase</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The augmentation or rise in the amount of money incurred or asked for in the exchange of goods and services.
(Source: ISEP /  EFP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">augmentation des coûts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aumento de costes</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kostensteigerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kostentoename</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">увеличение расходов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Рост размера денежной суммы, потраченной или запрашиваемой в обмен на товары или услуги.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">رفع التكاليف</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13261" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10922">
    <skos:prefLabel xml:lang="en">active population</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The number of people available and eligible for employment within a given enterprise, region or nation.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">population active</skos:prefLabel>
    <skos:prefLabel xml:lang="es">población activa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Erwerbstätige Bevölkerung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">actieve populatie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экономически активное население</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Количество людей, готовых и пригодных для трудоустройства в рамках предприятия, региона или страны.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السكان القادرين على العمل</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5004" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7779" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2731">
    <skos:prefLabel xml:lang="en">energy market</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The trade or traffic of energy sources treated as a commodity (such as fossil fuel, electricity, or solar radiation).
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">marché de l'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mercado de la energía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energiemarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiemarkt</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">рынок энергоресурсов</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Торговля или обмен энергетическими источниками, которые рассматриваются как товары (например, минеральное топливо, электричество или солнечный свет).</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سوق الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5058" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2733">
    <skos:prefLabel xml:lang="en">energy policy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A statement of a country's intentions in the energy sector.
(Source: BRACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">politique énergétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">política energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energiepolitik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiebeleid</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергетическая политика</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изложение планов государства в секторе энергетики.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سياسة الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6370" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2714" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2730" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2734">
    <skos:prefLabel xml:lang="en">energy process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Any natural phenomenon or series of actions by which energy is converted or made more usable.
(Source: MES)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus énergétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">proceso energético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieverfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energieprocessen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергетический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Явление природы или мера, посредством которых энергия превращается в другую форму или делается более приемлемой для использования.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية تعتمد على الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2712" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2716" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10927">
    <skos:prefLabel xml:lang="en">durable goods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Goods which have a reasonably long life and which are not generally consumed in use: e.g. refrigerator.
(Source: WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biens durables</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bien duradero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Langlebiges Gebrauchtsgut</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">duurzame goederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">товары длительного пользования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Товары, которые имеют относительно долгий срок эксплуатации и которые, как правило, не расходуются при использовании, например, холодильник.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلع معمرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10930" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2736">
    <skos:prefLabel xml:lang="en">energy recovery</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A form of resource recovery in which the organic fraction of waste is converted to some form of usable energy. Recovery may be achieved through the combustion of processed or raw refuse to produce steam through the pyrolysis of refuse to produce oil or gas; and through the anaerobic digestion of organic wastes to produce methane gas.
(Source: LANDY)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">valorisation énergétique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">recuperación de la energía</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energierueckgewinnung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energie-herwinning</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">вторичное использование энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Форма вторичного использования ресурсов, в рамках которого органическая часть отходов конвертируется в какую-либо форму энергии. Это может быть достигнуто в процессе сжигания отходов для производства, в процессе пиролиза отходов в целях получения нефти или газа, а также биологической переработки отходов для производства метана.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">استرداد الطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2749" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10929">
    <skos:prefLabel xml:lang="en">non-durable goods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A good bought by consumers that tends to last for less than a year. Common examples are food and clothing. The notable thing about nondurable goods is that consumers tend to continue buying them regardless of the ups and downs of the business cycle.
(Source: AMOS2)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bien non durable</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bien no duradero</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Kurzlebige Güter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">verbruiksgoederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">товары с коротким сроком использования</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Товары, приобретаемые покупателем, срок эксплуатации которых составляет менее года. Распространенным примером являются продукты питания и одежда. Отличительной чертой товаров этой категории является тот факт, что потребитель покупает их независимо от состояния делового цикла экономики.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلع غير معمرة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10930" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10930">
    <skos:prefLabel xml:lang="en">goods</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A term of variable content and meaning. It may include every species of personal chattels or property. Items of merchandise, supplies, raw materials, or finished goods. Land is excluded.
(Source: DICLAW /  WESTS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biens</skos:prefLabel>
    <skos:prefLabel xml:lang="es">mercancías</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Güter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">goederen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">товары</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Термин, имеющий различные толкования и значения. Может включать все предметы, находящиеся в личном пользовании или собственности. Готовые изделия, запасы, сырье, за исключением земли.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سلع</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10931" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1737" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1969" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4410" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7551" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10927" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10929" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10931">
    <skos:prefLabel xml:lang="en">goods and services</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The total of economic assets, including both physical or storable objects and intangible acts of human assistance.
(Source: ODE)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">biens et services</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bienes y servicios</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Güter und Dienstleistungen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">goederen en diensten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">товары и услуги</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вся номенклатура, материальная и нематериальная, экономического производства.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">السلع والخدمات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2516" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10930" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/15" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/33" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10932">
    <skos:prefLabel xml:lang="en">time budget</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Determining or planning for allotment of time in hours, days, weeks, etc.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">budget temps</skos:prefLabel>
    <skos:prefLabel xml:lang="es">presupuesto de tiempo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zeitbudget</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">tijdsbudget</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">временной ресурс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Определение или планирование времени в часах, днях, неделях и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">ميزانية زمنية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1743" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/34" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2504" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2741">
    <skos:prefLabel xml:lang="en">energy source</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Potential supplies of energy including fossil and nuclear fuels as well as solar, water, wind, tidal and geothermal power.
(Source: PHC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">source d'énergie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fuente energética</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energiequelle</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiebron</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">источник энергии</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Потенциальные запасы энергии, включая минеральное и ядерное топливо, а также энергию солнца, воды, ветра, приливов и геотермальных вод.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مصدر طاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2712" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2742" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5677" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7107" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7908" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/38" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2738" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7904" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2742">
    <skos:prefLabel xml:lang="en">energy source material</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Sources from which energy can be obtained to provide heat, light, and power. Energy resources, including fossil and nuclear fuels as well as solar, water, tidal and geothermal energy, may be captured or recovered and converted into other energy forms for a variety of household, commercial, transportation, and industrial applications.
(Source: PARCOR)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">matières brutes énergétiques</skos:prefLabel>
    <skos:prefLabel xml:lang="es">material de origen energético</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Energieträger</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">energiebronmateriaal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">энергоноситель</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Источник, из которого может быть получена энергия для производства тепла, света или мощности. Энергетические ресурсы, включая минеральное и ядерное топливо, а также энергию солнца, воды, ветра, приливов и геотермальных вод, могут быть извлечены и превращены в другие формы энергии для разнообразного применения в быту, производстве, транспорте и пр.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مادة مصدر للطاقة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2741" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3505" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/10" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/31" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/2711" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10935">
    <skos:prefLabel xml:lang="en">product life cycle</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A product life cycle includes the following phases: acquisition of raw materials, production, packaging, distribution, use, recyling, and disposal.
(Source: HELIOSa)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cycle de vie d'un produit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ciclo de vida de producto</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Produktlebenszyklus</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">levenscyclus van een product</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">цикл жизни продукта</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Цикл жизни продукта включает следующие стадии: приобретение сырья, производство, упаковка, распределение, потребление, вторичное использование и окончательная утилизация.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دورة حياة المنتَج</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5090" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/27" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10936">
    <skos:prefLabel xml:lang="en">ecolabel</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A mark, seal or written identification attached or affixed to products that provides specific ecological information allowing consumers to make comparisons with other similar products, or instructions on how to safely use or properly recycle or dispose of both products and packaging.
(Source: OPP)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">écolabel</skos:prefLabel>
    <skos:prefLabel xml:lang="es">etiqueta ecológica</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Umweltzeichen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">milieukeur(merk)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">экоэтикетка</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Экоэтикетка представляет собой маркировку ЕС, которую разрешают наносить производителям, если они могут доказать, что их продукция менее вредна для окружающей среды, чем аналоги.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بطاقة تعريف إيكولوجية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6663" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2427" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2435" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/9" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/11" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/19" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/96" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10938">
    <skos:prefLabel xml:lang="en">quality certification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The formal assertion in writing that a commodity, service or other product has attained a recognized and relatively high grade or level of excellence.
(Source: BLD / RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">certification qualité</skos:prefLabel>
