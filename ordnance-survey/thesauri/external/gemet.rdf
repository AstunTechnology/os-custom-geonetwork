    <skos:prefLabel xml:lang="en">germ plasm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The hereditary material transmitted to the offspring via the gametes.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">protoplasme des germes</skos:prefLabel>
    <skos:prefLabel xml:lang="es">plasma de germen</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Keimplasma</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">kiemplasma</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">зародышевая плазма</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Наследственный материал, передаваемый молодым особям через гаметы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">البلازما الجرثومية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3628" />
