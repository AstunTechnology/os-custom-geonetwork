    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/1062" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8019">
    <skos:prefLabel xml:lang="en">spray can</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An aerosol can for applying paint, deodorant, etc., as a fine spray.
(Source: SHOOX)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">bombe aérosol</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pulverizador</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Sprühdose</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">spuitbus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">аэрозольный баллончик</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Баллончик для распыления краски, дезодоранта и пр. в виде мелких брызг.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">بخاخة</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260" />
