  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/538">
    <skos:prefLabel xml:lang="en">architecture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The art and science of designing and building structures, or large groups of structures, in keeping with aesthetic and functional criteria.
(Source: HARRIS)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">architecture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">arquitectura</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Architektur</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">architectuur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">архитектура</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Искусство и наука проектирования и строительства зданий и сооружений в соответствии с эстетическими и функциональными критериями.</skos:scopeNote>
