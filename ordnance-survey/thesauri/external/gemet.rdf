    <skos:prefLabel xml:lang="de">Entenvögel</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Anatidae</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лебеди, гуси и утки</skos:prefLabel>
