    <skos:topConceptOf rdf:resource="http://inspire.ec.europa.eu/featureconcept" />
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-08-18 20:46 PM CEST</dct:created>
    <dct:title xml:lang="en">Road Link</dct:title>
    <skos:prefLabel xml:lang="en">Road Link</skos:prefLabel>
    <dct:description xml:lang="en">A linear spatial object that describes the geometry and connectivity of a road network between two points in the network. Road links can represent paths, bicycle roads, single carriageways, multiple carriageway roads and even fictitious trajectories across traffic squares.</dct:description>
    <skos:definition xml:lang="en">A linear spatial object that describes the geometry and connectivity of a road network between two points in the network. Road links can represent paths, bicycle roads, single carriageways, multiple carriageway roads and even fictitious trajectories across traffic squares.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/theme/tn" />
    <rdfs:isDefinedBy rdf:resource="http://inspire.ec.europa.eu/registry/governance-level/eu-legal" />
    <adms:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid" />
  </rdf:Description>
