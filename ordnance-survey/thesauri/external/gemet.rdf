    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/10112" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11909">
    <skos:prefLabel xml:lang="en">noise spectrum</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The range of frequencies occurring in the noise emitted by a source.
(Source: UVAROV)</skos:scopeNote>
