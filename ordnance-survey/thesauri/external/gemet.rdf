    <skos:prefLabel xml:lang="es">aplicación</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Inkraftsetzen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">handhaving</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">приведение в исполнение</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Действие, направленное на вступление в силу чего-либо, например, закона; реализация права или приказа.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إنفاذ - تطبيق</skos:prefLabel>
