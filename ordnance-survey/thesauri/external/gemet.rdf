    <dc:title>GEMET - Concepts, version 2.4</dc:title>
    <dc:description>GEMET thesaurus for GeoNetwork opensource.</dc:description>
    <dc:creator>
      <foaf:Organization>
        <foaf:name>EEA</foaf:name>
      </foaf:Organization>
    </dc:creator>
