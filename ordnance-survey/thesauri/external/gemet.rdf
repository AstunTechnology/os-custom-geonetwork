  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4077">
    <skos:prefLabel xml:lang="en">hurricane</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tropical cyclone of great intensity; any wind reaching a speed of more than 73 miles per hour (117 kilometers per hour) is said to have hurricane force.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">cyclone</skos:prefLabel>
    <skos:prefLabel xml:lang="es">huracán</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Hurrikan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">orkaan</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">ураган</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Тропический циклон высокой интенсивности; ветер, достигающий силы более 73 милей в час (117 км в час) считается ураганным.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">إعصار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5196" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
