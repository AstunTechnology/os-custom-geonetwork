    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/14" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6247">
    <skos:prefLabel xml:lang="en">phytoplankton</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Planktonic plant life.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phytoplancton</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fitoplancton</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phytoplankton</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fytoplankton</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фитопланктон</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Растительная жизнь планктона.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">العوالق النباتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6282" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/893" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6248">
    <skos:prefLabel xml:lang="en">phytosociology</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The study of vegetation, including the organization, interdependence, development, geographical distribution and classification of plant communities.
(Source: LBC)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">phytosociologie</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fitosociología</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vegetationskunde</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">plantensociologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фитосоциология</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Изучение растений, включая организацию, взаимосвязи, развитие, географическое распространение и классификацию растительных сообществ.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">سوسيولوجيا النبات</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/971" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/4" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6250">
    <skos:prefLabel xml:lang="en">phytotoxicity</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">phytotoxicité</skos:prefLabel>
    <skos:prefLabel xml:lang="es">fitotoxicidad</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Phytotoxizität</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fytotoxiciteit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">фитотоксичность</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">السمية النباتية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8538" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/2" />
