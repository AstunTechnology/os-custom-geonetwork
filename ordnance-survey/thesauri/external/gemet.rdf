  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4133">
    <skos:prefLabel xml:lang="en">ice pack</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Large areas of floating ice, usually occurring in polar seas, consisting of separate pieces that have become massed together.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">banquise</skos:prefLabel>
    <skos:prefLabel xml:lang="es">bolsa de hielo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Packeis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pakijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">паковый лед</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Большие участки плавающего льда, часто встречающиеся в полярных морях, состоящие из отдельных кусков и груд льда.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">طافية جليدية</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4629" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4132" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3673" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/7" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/23" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/40" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4630" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6233">
    <skos:prefLabel xml:lang="en">physicochemical process</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Processes involving changes in the physical properties and chemical structure of substances.
(Source: CED)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">processus physico-chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="es">procesos fisicoquímicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Physikalisch-chemische Verfahren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">fysico-chemische processen</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">физико-химический процесс</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Процесс, затрагивающий изменения физических свойств и химической структуры вещества.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">عملية فيزيائية - كيميائية</skos:prefLabel>
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/766" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1674" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1808" />
