    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2245" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2257" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2260" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2618" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2689" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3190" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3295" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3308" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4485" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4722" />
