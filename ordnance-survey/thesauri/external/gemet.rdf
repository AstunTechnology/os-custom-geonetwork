  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2568">
    <skos:prefLabel xml:lang="en">research of the effects</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Investigation carried out to assess the results deriving from an action or condition; general term applying to many different fields.
(Source: RRDA)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">recherche des effets</skos:prefLabel>
    <skos:prefLabel xml:lang="es">investigación de los efectos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Wirkungsforschung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">onderzoek naar de effecten</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">исследование последствий</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Исследования, проводимые для оценки последствий каких-либо действий или условий; общий термин, применимый к нескольким областям.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">دراسة الآثار (التأثير)</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11148" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/30" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/7136" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/77">
    <skos:prefLabel xml:lang="en">active participation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The involvement, either by an individual or a group of individuals, in their own governance or other activities, with the purpose of exerting influence.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">participation active</skos:prefLabel>
    <skos:prefLabel xml:lang="es">participación activa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Aktive Beteiligung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">inspraak</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">активное участие</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Вовлечение отдельного лица или группы лиц в процесс самоуправления или другую деятельность с целью оказать влияние на эти процессы.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">مشاركة نشطة</skos:prefLabel>
