  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4131">
    <skos:prefLabel xml:lang="en">ice</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The dense substance formed by the freezing of water to the solid state; it commonly occurs in the form of hexagonal crystals.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">glace</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hielo</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Eis</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ijs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">лед</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Плотное вещество, образующееся при переходе воды в твердое состояние. Обычно встречается в форме шестиугольных кристаллов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">الجليد</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3485" />
