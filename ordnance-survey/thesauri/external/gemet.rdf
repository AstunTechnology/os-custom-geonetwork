  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1190">
    <skos:prefLabel xml:lang="en">Caribbean Area</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A geographical region bordered on the south by South America and Panama, and on the west by Central America, and consisting of the West Indian, and nearby, islands and the Caribbean Sea, a part of the western Atlantic Ocean.
(Source: RHW)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">Caraïbes (les)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">área del Caribe</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Karibik</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Caraïbische Zee</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Карибский регион</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Географический регион, ограниченный с юга территорией Южной Америки и Панамы, с запада - Центральной Америкой и состоящий из Вест-Индии и близлежащих островов, вод Карибского моря, западной части Атлантического океана.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">منطقة الكاريبي</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/367" />
