  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13100">
    <skos:prefLabel xml:lang="en">urban habitat</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The resulting effects and interrelationships of human population concentrations, the built environment, and the biophysical environment.
(Source: UNUN)</skos:scopeNote>
