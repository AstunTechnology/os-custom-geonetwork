    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/13109" />
  </skos:Concept>
  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6855">
    <skos:prefLabel xml:lang="en">pyrolysis</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The breaking apart of complex molecules into simpler units by the use of heat.
(Source: MGH)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">pyrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="es">pirólisis</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pyrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">pyrolyse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">пиролиз</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Разделение сложных молекул на более простые звенья под действием тепла.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">انحلال حراري</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/12605" />
    <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2040" />
