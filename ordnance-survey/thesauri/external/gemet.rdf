    <skos:prefLabel xml:lang="nl">leder</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">кожа (техн.)</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Обработанная или окрашенная шкура животного, обычно с удаленным волосяным покровом.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">جلد</skos:prefLabel>
