  <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2020">
    <skos:prefLabel xml:lang="en">decree</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A declaration of the court announcing the legal consequences of the facts found.
(Source: BLACK)</skos:scopeNote>
    <skos:prefLabel xml:lang="fr">décret</skos:prefLabel>
    <skos:prefLabel xml:lang="es">decretos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verfügung</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">beschikking</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">декрет</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Решение суда, объявляющее о правовых последствиях установленных фактов.</skos:scopeNote>
    <skos:prefLabel xml:lang="ar">قرار</skos:prefLabel>
    <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11499" />
    <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5298" />
    <gemet:theme rdf:resource="http://www.eionet.europa.eu/gemet/theme/21" />
    <gemet:group rdf:resource="http://www.eionet.europa.eu/gemet/group/4750" />
